{
  "name": "ac-combat-shields-direct-hit",
  "description": "Live pbd161 regression: space combat at 308 (pbd60 save 122). Muaat plays Shields Holding and every other seat holds a Sabotage, so all three must pass in the engine window (action_card.sabotage pass). Then mentak plays Direct Hit and muaat, ghost and crimson pass. The original code has no Direct Hit target step (playAC posts only a reminder text), so the scenario ends at the window.",
  "base": { "recording": "pbd60", "index": 122 },
  "setup": [
    { "command": "ac draw_specific_ac", "options": { "ac_id": "sh1", "faction_or_color": "muaat" } },
    { "command": "ac draw_specific_ac", "options": { "ac_id": "dh1", "faction_or_color": "mentak" } },
    { "command": "ac draw_specific_ac", "options": { "ac_id": "sabo1", "faction_or_color": "mentak" } },
    { "command": "ac draw_specific_ac", "options": { "ac_id": "sabo2", "faction_or_color": "muaat" } },
    { "command": "ac draw_specific_ac", "options": { "ac_id": "sabo3", "faction_or_color": "ghost" } },
    { "command": "ac draw_specific_ac", "options": { "ac_id": "sabo4", "faction_or_color": "crimson" } }
  ],
  "steps": [
    { "answer": { "kind": "action_card.play", "value": { "actionCard": "sh1" } }, "as": "muaat" },
    { "answer": { "kind": "action_card.sabotage", "option": "^no_sabotage$" }, "as": "mentak" },
    { "answer": { "kind": "action_card.sabotage", "option": "^no_sabotage$" }, "as": "ghost" },
    { "answer": { "kind": "action_card.sabotage", "option": "^no_sabotage$" }, "as": "crimson" },
    { "answer": { "kind": "action_card.play", "value": { "actionCard": "dh1" } }, "as": "mentak" },
    { "answer": { "kind": "action_card.sabotage", "option": "^no_sabotage$" }, "as": "muaat" },
    { "answer": { "kind": "action_card.sabotage", "option": "^no_sabotage$" }, "as": "ghost" },
    { "answer": { "kind": "action_card.sabotage", "option": "^no_sabotage$" }, "as": "crimson" }
  ],
  "expect": {
    "invariants": true,
    "state": [
      { "path": "players[faction=muaat].actionCards", "excludes": "sh1" },
      { "path": "players[faction=mentak].actionCards", "excludes": "dh1" }
    ]
  }
}
