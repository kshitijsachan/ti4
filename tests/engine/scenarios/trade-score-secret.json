{
  "name": "trade-score-secret",
  "description": "pbd42 r3 status scoring prompt: Argent draws Strengthen Bonds (sb) and receives L1Z1X's Support for the Throne (play area), then scores it through status.score (Score A Secret Objective) and status.score_secret; the engine's met-check (1/1) must accept like the button.",
  "base": {
    "recording": "pbd42",
    "index": 255
  },
  "setup": [
    {
      "command": "so draw_specific_so",
      "options": {
        "so_id": "sb"
      },
      "as": "argent"
    },
    "/pn send promissory_note_id:orca_sftt target_faction_or_color:argent faction_or_color:l1z1x"
  ],
  "steps": [
    {
      "answer": {
        "kind": "status.score",
        "option": "get_so_score_buttons"
      },
      "as": "argent"
    },
    {
      "answer": {
        "kind": "status.score_secret",
        "value": {
          "secretObjective": "sb"
        }
      },
      "as": "argent"
    },
    {
      "wait": 1500
    }
  ],
  "expect": {
    "invariants": true,
    "save": [
      {
        "key": "player[argent].secret_objectives_scored",
        "includes": "sb"
      }
    ]
  }
}