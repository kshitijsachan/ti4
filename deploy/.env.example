# Copy to deploy/.env (deploy.sh writes one for you).

# The address your friends open. Used for the admin link and for attachment URLs.
#   plain IP:      PUBLIC_URL=http://203.0.113.10:8090
#   with a domain: PUBLIC_URL=https://ti4.example.com   (and DOMAIN=ti4.example.com, --profile https)
PUBLIC_URL=

# Only needed with `--profile https` (Caddy gets a Let's Encrypt cert; ports 80+443 must be open).
DOMAIN=

# Internal only (postgres is never published). Set once before the first start; changing it later
# requires changing it inside postgres too.
POSTGRES_PASSWORD=change-me

# Where the site listens on the host. With the https profile use SHIM_BIND=127.0.0.1.
SHIM_BIND=0.0.0.0
SHIM_PORT=8090

# Memory limits. The bot needs ~2-3 GB; raise BOT_MEMORY on a big box (e.g. 6g on Oracle A1).
BOT_MEMORY=3g
BOT_HEAP_PERCENT=75
SHIM_MEMORY=768m
POSTGRES_MEMORY=512m

# Only with `--profile tunnel` (Cloudflare Zero Trust > Networks > Tunnels > your tunnel > token).
# Also set PUBLIC_URL=https://<the public hostname you routed to http://shim:8090>.
CLOUDFLARE_TUNNEL_TOKEN=
