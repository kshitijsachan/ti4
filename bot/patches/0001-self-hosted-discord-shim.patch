@@ -0,0 +1,67 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.selfhost.engine.EngineModels.Decision;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * Strategic action: play your strategy card (strategicAction_&lt;n&gt;). These buttons normally sit in the start-of-turn
+ * menu, which the turn kind (G3) owns; this kind has a low priority so it only types a message that offers nothing
+ * else, and {@link #actionValue} / {@link #validateAction} are public so the turn kind can type and check its
+ * strategicAction_ options the same way. value: {action:"strategic", strategyCard, name, card}.
+ */
+public class StrategicActionKind implements KindSpec {
+
+    @Override
+    public String kind() {
+        return "strategy_card.strategic_action";
+    }
+
+    @Override
+    public int priority() {
+        return 10;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return handlerId.matches("strategicAction_\\d+");
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        return actionValue(handlerId, ctx.game());
+    }
+
+    public static Map<String, Object> actionValue(String handlerId, Game game) {
+        if (!handlerId.matches("strategicAction_\\d+")) return null;
+        int sc = Integer.parseInt(handlerId.substring("strategicAction_".length()));
+        Map<String, Object> v = new LinkedHashMap<>();
+        v.put("action", "strategic");
+        v.put("strategyCard", sc);
+        v.put("name", StrategyCards.name(game, sc));
+        v.put("card", StrategyCards.automation(game, sc));
+        return v;
+    }
+
+    @Override
+    public String scope(CaptureContext ctx) {
+        return "player";
+    }
+
+    @Override
+    public String validate(Game game, Player answering, Decision decision, String optionId) {
+        return validateAction(game, answering, StrategyCards.optionValue(decision, optionId));
+    }
+
+    public static String validateAction(Game game, Player answering, Map<String, Object> v) {
+        if (v == null || !(v.get("strategyCard") instanceof Number n)) return null;
+        int sc = n.intValue();
+        if (game.getActivePlayer() != null && game.getActivePlayer() != answering) return "It is not your turn.";
+        if (answering.getSCs() == null || !answering.getSCs().contains(sc)) return "You do not hold that strategy card.";
+        if (game.getPlayedSCs().contains(sc)) return "That strategy card has already been played.";
+        return null;
+    }
+}
