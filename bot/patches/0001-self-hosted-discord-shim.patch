--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/FactionStepsYin.java
@@ -0,0 +1,50 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.List;
+
+/**
+ * Yin Brotherhood. Indoctrination initialIndoctrination_&lt;planet&gt; (start-of-ground-combat button) then
+ * indoctrinate_&lt;planet&gt;_&lt;infantry|mech&gt; + Decline; Devotion startDevotion_&lt;pos&gt; then
+ * resolveDevote_&lt;pos&gt;_&lt;unit&gt;_&lt;devote|...&gt; (destroy own cruiser/destroyer; the hit itself is hitOpponent_, combat);
+ * Impulse Core startImpulseCore_&lt;pos&gt; / resolveImpulseCore_&lt;pos&gt;_&lt;unit&gt; + Cancel; agent yinagent_ (then the
+ * leader.use target picker); hero yinHeroStart → yinHeroTarget_&lt;faction|unowned&gt; → yinHeroPlanet_&lt;planet&gt; →
+ * yinHeroInfantry_&lt;planet&gt;_&lt;n&gt;; commander (pay for research by removing infantry) yinCommanderStep1_ →
+ * yinCommanderRemoval_&lt;pos&gt;_&lt;holder&gt;; Greyfire Mutagen greyfire_&lt;planet&gt;. The start buttons usually sit on the
+ * combat controls (combat.round); they are typed here only on a message of their own. Yin Spinner is on the
+ * production prompt.
+ */
+public class FactionStepsYin extends FactionStepsRegex {
+    private static final List<Rule> RULES = List.of(
+            ability("ability", "indoctrination", "yin", "use", true, "initialIndoctrination_(?<planet>.+)"),
+            ability("ability", "indoctrination", "yin", "target", true,
+                    "indoctrinate_(?<planet>[^_]+)_(?<unit>[^_]+)"),
+            ability("ability", "devotion", "yin", "use", true, "startDevotion_(?<tile>[^_]+).*"),
+            ability("ability", "devotion", "yin", "target", true,
+                    "resolveDevote_(?<tile>[^_]+)_(?<unit>[^_]+)_(?<mode>.+)"),
+            // The hit Devotion / Impulse Core (Miltymod) / similar abilities produce: pick the opposing ship.
+            ability("ability", "hit_opponent", null, "target", false,
+                            "hitOpponent_(?<tile>[^_]+)_(?<unitState>[^_]+)_(?<target>[^_]+)_?(?<exo>exo)?")
+                    .extra((m, ctx, f) -> {
+                        String u = m.group("unitState");
+                        f.remove("unitState");
+                        f.put("damaged", u.contains("damaged"));
+                        f.put("galvanized", u.contains("galvanized"));
+                        f.put("unit", unitId(u.replace("damaged", "").replace("galvanized", "")));
+                        f.put("exo", m.group("exo") != null);
+                    }),
+            ability("tech", "ic", "yin", "use", true, "startImpulseCore_(?<tile>.+)"),
+            ability("tech", "ic", "yin", "target", true, "resolveImpulseCore_(?<tile>[^_]+)_(?<unit>.+)"),
+            leader("yinagent", "use", true, "yinagent_.*"),
+            leader("yinhero", "use", false, "yinHeroStart"),
+            leader("yinhero", "target", false, "yinHeroTarget_(?<target>.+)"),
+            leader("yinhero", "target", false, "yinHeroPlanet_(?<planet>.+)"),
+            leader("yinhero", "target", false, "yinHeroInfantry_(?<planet>[^_]+)_(?<amount>\\d+)"),
+            leader("yincommander", "use", true, "yinCommanderStep1_.*"),
+            leader("yincommander", "target", true, "yinCommanderRemoval_(?<tile>[^_]+)_(?<holder>.+)"),
+            ability("promissory", "greyfire", "yin", "target", false, "greyfire_(?<planet>.+)"));
+
+    @Override
+    protected List<Rule> rules() {
+        return RULES;
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/FactionStepsYssaril.java b/src/main/java/ti4/selfhost/engine/kinds/FactionStepsYssaril.java
