+package ti4.selfhost.engine.kinds;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+import ti4.selfhost.engine.EngineModels.Target;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * Using a relic outside the component-action menu (RelicButtonHandler, ButtonHelperRelics, ...). value
+ * {relic, relicName, relicText, effect}:
+ *
+ * <pre>
+ * exhaustRelic_&lt;relic&gt;            {effect:"exhaust"}        (Heart of Ixth, Luxarch Treatise, ...)
+ * useRelic_&lt;relic&gt;                {effect:"use"}            (Boon of the Cerulean God, ...)
+ * prophetsTears_AC / _TechSkip    {relic:"prophetstears", effect:"draw_action_card" | "tech_skip"}
+ * explore_look_All                {relic:"scepterofdominion"?, effect:"look_explore_decks"}  (peek, no relic id)
+ * relic_look_top                  {effect:"look_relic_deck"}
+ * dominusOrb                      {relic:"dominusorb", effect:"move_from_command_token_systems"}
+ * eyeOfVogul                      {relic:"eyeofvogul", effect:"use"}
+ * resolveMaw                      {relic:"mawofworlds", effect:"purge_for_technology"}  (exhausts all your planets)
+ * resolveCrownOfE                 {relic:"emphidia", effect:"purge_for_point"}
+ * </pre>
+ *
+ * Temporal Command Suite (exhaustTCS_&lt;agent&gt;_&lt;faction&gt;) is the Nomad faction tech: faction.ability (FactionStepsNomad).
+ *
+ * Declines on the same message ("deleteButtons", "No") have value null.
+ */
+public class RelicUseKind implements KindSpec {
+
+    @Override
+    public String kind() {
+        return "relic.use";
+    }
+
+    @Override
+    public int priority() {
+        return 45;
+    }
+
+    @Override
+    public boolean matches(String h) {
+        return h.startsWith("exhaustRelic_")
+                || h.startsWith("useRelic_")
+                || h.startsWith("prophetsTears_")
+                || h.equals("explore_look_All")
+                || h.equals("relic_look_top")
+                || h.equals("dominusOrb")
+                || h.equals("eyeOfVogul")
+                || h.equals("resolveMaw")
+                || h.equals("resolveCrownOfE");
+    }
+
+    /** Only relic messages (plus dismiss/decline/undo): mixed "optional abilities" menus stay with their area. */
+    @Override
+    public boolean classifies(java.util.List<String> handlerIds) {
+        return ChooseSupport.onlyOurs(handlerIds, this::matches);
+    }
+
+    @Override
+    public Map<String, Object> value(String h, CaptureContext ctx) {
+        Map<String, Object> v = new LinkedHashMap<>();
+        if (h.startsWith("exhaustRelic_")) {
+            v.putAll(ExploreSupport.relic(h.substring("exhaustRelic_".length())));
+            v.put("effect", "exhaust");
+        } else if (h.startsWith("useRelic_")) {
+            v.putAll(ExploreSupport.relic(h.substring("useRelic_".length())));
+            v.put("effect", "use");
+        } else if (h.startsWith("prophetsTears_")) {
+            v.putAll(ExploreSupport.relic("prophetstears"));
+            v.put("effect", h.contains("AC") ? "draw_action_card" : "tech_skip");
+        } else if (h.equals("explore_look_All")) {
+            v.put("relic", null);
+            v.put("effect", "look_explore_decks");
+        } else if (h.equals("relic_look_top")) {
+            v.put("relic", null);
+            v.put("effect", "look_relic_deck");
+        } else if (h.equals("dominusOrb")) {
+            v.putAll(ExploreSupport.relic("dominusorb"));
+            v.put("effect", "move_from_command_token_systems");
+        } else if (h.equals("eyeOfVogul")) {
+            v.putAll(ExploreSupport.relic("eyeofvogul"));
+            v.put("effect", "use");
+        } else if (h.equals("resolveMaw")) {
+            v.putAll(ExploreSupport.relic("mawofworlds"));
+            v.put("effect", "purge_for_technology");
+        } else if (h.equals("resolveCrownOfE")) {
+            v.putAll(ExploreSupport.relic("emphidia"));
+            v.put("effect", "purge_for_point");
+        } else {
+            return null;
+        }
+        return v;
+    }
+
+    @Override
+    public Target target(CaptureContext ctx, Target resolved) {
+        return ExploreSupport.explorer(ctx, resolved);
+    }
+}
