@@ -0,0 +1,79 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.List;
+import javax.annotation.Nullable;
+import ti4.selfhost.engine.KindSpec.CaptureContext;
+
+/**
+ * Arborec: Mitosis (status phase: mitosisInf / mitosisMech, then mitoMechPlacement_&lt;pos&gt;_&lt;holder&gt;_mitosis),
+ * agent Letani Ospha (arboAgentIn_&lt;pos&gt; -&gt; arboAgentOn_&lt;pos&gt;_&lt;unit&gt;[damaged] -&gt;
+ * arboAgentPutShip_&lt;unit&gt;_&lt;pos&gt;), commander (arboCommanderBuild_&lt;pos&gt;), flagship build (arboHeroBuild_&lt;pos&gt;:
+ * "Build 5 units with the Arborec flagship"), Stymie (stymiePlayerStep1_&lt;active faction&gt;,
+ * stymiePlayerStep2_&lt;faction&gt;_&lt;pos&gt;; played by whoever holds the note).
+ */
+public class FactionStepsArborec implements FactionSteps {
+    private static final String F = "arborec";
+
+    @Override
+    @Nullable
+    public Step step(String h, @Nullable CaptureContext ctx) {
+        if (h.equals("mitosisInf")) return Step.ability("ability", "mitosis", F, "mitosis", "use", false, "unit", "gf");
+        if (h.equals("mitosisMech"))
+            return Step.ability("ability", "mitosis", F, "mitosis", "use", false, "unit", "mf");
+        if (h.startsWith("mitoMechPlacement_") && h.endsWith("_mitosis")) {
+            List<String> a = FactionSteps.args(h, "mitoMechPlacement_");
+            String holder = FactionSteps.at(a, 1);
+            return Step.ability(
+                    "ability", "mitosis", F, "mitoMechPlacement", "target", false,
+                    "tile", FactionSteps.at(a, 0),
+                    "planet", "space".equals(holder) ? null : holder,
+                    "holder", holder,
+                    "unit", "mf");
+        }
+        if (h.startsWith("arboAgentIn_"))
+            return Step.leader(
+                    "arborecagent", "arboAgentIn", "target", true, "tile", h.substring("arboAgentIn_".length()));
+        if (h.startsWith("arboAgentOn_")) {
+            List<String> a = FactionSteps.args(h, "arboAgentOn_");
+            String unit = FactionSteps.at(a, 1);
+            boolean damaged = unit != null && unit.endsWith("damaged");
+            return Step.leader(
+                    "arborecagent", "arboAgentOn", "target", true,
+                    "tile", FactionSteps.at(a, 0),
+                    "unit", unit == null ? null : FactionStepsRegex.unitId(damaged ? unit.substring(0, unit.length() - "damaged".length()) : unit),
+                    "damaged", damaged);
+        }
+        if (h.startsWith("arboAgentPutShip_")) {
+            List<String> a = FactionSteps.args(h, "arboAgentPutShip_");
+            return Step.leader(
+                    "arborecagent", "arboAgentPutShip", "target", false,
+                    "unit", a.isEmpty() ? null : FactionStepsRegex.unitId(a.get(0)),
+                    "tile", FactionSteps.at(a, 1));
+        }
+        if (h.startsWith("arboCommanderBuild_"))
+            return Step.leader(
+                    "arboreccommander", "arboCommanderBuild", "use", true,
+                    "tile", h.substring("arboCommanderBuild_".length()));
+        if (h.startsWith("arboFlagshipBuild_"))
+            return Step.ability(
+                    "flagship", "arborec_flagship", F, "arboFlagshipBuild", "use", true,
+                    "tile", FactionSteps.at(FactionSteps.args(h, "arboFlagshipBuild_"), 0),
+                    "maxUnits", 5);
+        if (h.startsWith("arboHeroBuild_"))
+            return Step.ability(
+                    "flagship", "arborec_flagship", F, "arboHeroBuild", "use", true,
+                    "tile", FactionSteps.at(FactionSteps.args(h, "arboHeroBuild_"), 0));
+        if (h.startsWith("stymiePlayerStep1_"))
+            return Step.ability(
+                    "promissory", "stymie", F, "stymiePlayerStep1", "use", true,
+                    "target", FactionSteps.faction(h.substring("stymiePlayerStep1_".length()), ctx));
+        if (h.startsWith("stymiePlayerStep2_")) {
+            List<String> a = FactionSteps.args(h, "stymiePlayerStep2_");
+            return Step.ability(
+                    "promissory", "stymie", F, "stymiePlayerStep2", "target", false,
+                    "target", FactionSteps.faction(FactionSteps.at(a, 0), ctx),
+                    "tile", FactionSteps.at(a, 1));
+        }
+        return null;
+    }
+}
