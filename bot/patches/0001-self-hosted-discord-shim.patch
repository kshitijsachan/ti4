+package ti4.selfhost.engine.kinds;
+
+import java.util.List;
+
+/**
+ * Yssaril Tribes. Commander (So Ata: when another player activates a system with your units, look at their hand)
+ * yssarilcommander_&lt;ac|pn|so&gt;_&lt;faction&gt; + Decline; Spy Net (to the note's player) spyNetPlayerChooses /
+ * spyNetYssarilChooses; taking an action card from another hand (Spy Net, Mageon Implants, Yssaril hero)
+ * takeAC_&lt;handle&gt;_&lt;faction&gt; (value adds actionCard/cardName from that hand); hero (Kyver: every other player offers
+ * an action card) yssarilHeroInitialOffering_&lt;handle&gt;_&lt;yssaril&gt; (to each other player) and
+ * yssarilHeroRejection_&lt;faction&gt;; Scheming with Minister of Policy yssarilMinisterOfPolicy; agent as JR-XS455-O
+ * yssarilAgentAsJr. Scheming / Stall Tactics discards are action_card.discard; Crafty and Transparasteel passive.
+ */
+public class FactionStepsYssaril extends FactionStepsRegex {
+    private static final List<Rule> RULES = List.of(
+            leader("yssarilcommander", "use", true, "yssarilcommander_(?<what>ac|pn|so)_(?<target>.+)"),
+            ability("promissory", "spynet", "yssaril", "target", false, "spyNet(?<who>Player|Yssaril)Chooses")
+                    .extra((m, ctx, f) -> f.put("who", "Player".equals(m.group("who")) ? "self" : "yssaril")),
+            ability("ability", "take_ac", "yssaril", "target", false, "takeAC_(?<handle>\\d+)_(?<target>.+)")
+                    .extra((m, ctx, f) -> actionCard(
+                            f,
+                            ctx == null || ctx.game() == null
+                                    ? null
+                                    : ctx.game().getPlayerFromColorOrFaction(m.group("target")))),
+            leader("yssarilhero", "target", false, "yssarilHeroInitialOffering_(?<handle>\\d+)_(?<target>.+)")
+                    .extra((m, ctx, f) -> actionCard(f, ctx == null ? null : ctx.player())),
+            leader("yssarilhero", "target", false, "yssarilHeroRejection_(?<target>.+)"),
+            ability("ability", "scheming", "yssaril", "use", true, "yssarilMinisterOfPolicy"),
+            leader("yssarilagent", "use", true, "yssarilAgentAsJr"));
+
+    @Override
+    protected List<Rule> rules() {
+        return RULES;
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/GameSettingsKind.java b/src/main/java/ti4/selfhost/engine/kinds/GameSettingsKind.java
new file mode 100644
index 0000000..c35596b
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/GameSettingsKind.java
@@ -0,0 +1,92 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.Map;
+import java.util.regex.Pattern;
+import ti4.selfhost.engine.EngineModels.Target;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * Game creation prompts in the new game's actions channel, before any draft: expansion choice (chooseExp_&lt;x&gt;,
+ * setupBaseGameMode[_confirm]), alternate modes / homebrew menus (offerGameOptionButtons, getHomebrewButtons,
+ * offerTEOptionButtons, startTFGame, frankenSetup, setupHomebrew_…), starting a draft (miltySetup, startDraftSystem)
+ * and the Milty settings pages (jmf&lt;N|A|…&gt;_&lt;menu&gt;_&lt;item&gt;: navigate / act). Any seated player may press
+ * (table). value: {setting: which control family ("expansion"|"base_game"|"game_modes"|"draft_start"|"draft_settings"),
+ * choice: the specific item (expansion id, menu path, "milty", "startMilty", …)}.
+ */
+public class GameSettingsKind implements KindSpec {
+    private static final Pattern MODES = Pattern.compile(
+            "offerGameOptionButtons|getHomebrewButtons|offerTEOptionButtons|startTFGame|frankenSetup|setupHomebrewNone|setupHomebrew_.*");
+    private static final Pattern JMF = Pattern.compile("jmf[A-Za-z]_.*");
+
+    @Override
+    public String kind() {
+        return "setup.game_settings";
+    }
+
+    @Override
+    public int priority() {
+        return 30;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return handlerId.startsWith("chooseExp_")
+                || handlerId.startsWith("setupBaseGameMode")
+                || "miltySetup".equals(handlerId)
+                || "startDraftSystem".equals(handlerId)
+                || MODES.matcher(handlerId).matches()
+                || JMF.matcher(handlerId).matches();
+    }
+
+    /** Official-only (web) games: homebrew / alternate-mode controls are not typed options and are refused. */
+    @Override
+    public boolean typesOption(String handlerId) {
+        return matches(handlerId) && !ti4.selfhost.engine.WebContent.refuses(handlerId);
+    }
+
+    @Override
+    public String validate(
+            ti4.game.Game game,
+            ti4.game.Player answering,
+            ti4.selfhost.engine.EngineModels.Decision decision,
+            String optionId) {
+        return ti4.selfhost.engine.WebContent.refuses(optionId)
+                ? "homebrew and alternate game modes are off on this server (official rules only)"
+                : null;
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        if (!matches(handlerId) || ti4.selfhost.engine.WebContent.refuses(handlerId)) return null;
+        if (handlerId.startsWith("chooseExp_"))
+            return v("expansion", handlerId.substring("chooseExp_".length()));
+        if (handlerId.startsWith("setupBaseGameMode"))
+            return v("base_game", handlerId.endsWith("_confirm") ? "confirm" : "ask");
+        if ("miltySetup".equals(handlerId)) return v("draft_start", "milty");
+        if ("startDraftSystem".equals(handlerId)) return v("draft_start", "draft_system");
+        if (JMF.matcher(handlerId).matches()) return v("draft_settings", handlerId.substring(5));
+        return v("game_modes", handlerId);
+    }
+
+    private static Map<String, Object> v(String setting, String choice) {
+        return SetupKindSupport.map("setting", setting, "choice", choice);
+    }
+
+    @Override
+    public Target target(CaptureContext ctx, Target resolved) {
+        return "cards_thread".equals(resolved == null ? null : resolved.resolvedBy())
+                ? SetupKindSupport.refresh(ctx, resolved)
+                : null;
+    }
+
+    @Override
+    public boolean dynamic() {
+        return true;
+    }
+
+    /** Past setup this prompt is a leftover nobody needs (live: hundreds open across games, flooding the web queue). */
+    @Override
+    public boolean obsolete(CaptureContext ctx) {
+        return ti4.selfhost.engine.SetupStateBuilder.pastSetup(ctx.game());
+    }
+}
