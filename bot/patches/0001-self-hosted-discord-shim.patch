+package ti4.selfhost.engine.kinds;
+
+import java.util.List;
+import java.util.Map;
+import ti4.selfhost.engine.EngineModels.Progress;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * The manual hit-assignment menu (ButtonHelper.getButtonsForRemovingAllUnitsInSystem): one option per unit type and
+ * state, "Sustain" (assignDamage_) or "Destroy"/"Remove" (assignHits_), plus remove-all and "Done" (deleteButtons).
+ * Each press edits the menu in place. Owner = FFCC_ on the unit buttons.
+ */
+public class CombatAssignUnitsKind implements KindSpec {
+
+    @Override
+    public String kind() {
+        return "combat.assign_units";
+    }
+
+    @Override
+    public int priority() {
+        return 100;
+    }
+
+    @Override
+    public boolean classifies(List<String> handlerIds) {
+        for (String h : handlerIds) {
+            if (h != null && (h.startsWith("assignHits_") || h.startsWith("assignDamage_"))) return true;
+        }
+        return false;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return handlerId.startsWith("assignHits_")
+                || handlerId.startsWith("assignDamage_")
+                || handlerId.equals("deleteButtons");
+    }
+
+    /** Hits owed and assigned so far, from the units on the board (recomputed after every save). */
+    @Override
+    public Progress progress(CaptureContext ctx) {
+        return CombatSupport.assignProgress(ctx.game(), ctx.player());
+    }
+
+    @Override
+    public boolean dynamic() {
+        return true;
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        Map<String, Object> v = CombatSupport.value(handlerId, ctx.game());
+        if (v != null && ctx.player() != null) {
+            String type = ctx.game().getStoredValue(ctx.player().getFaction() + "latestAssignHits");
+            v.put("assignType", type == null || type.isBlank() ? "combat" : type.toLowerCase());
+        }
+        return v;
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/CombatHitsKind.java b/src/main/java/ti4/selfhost/engine/kinds/CombatHitsKind.java
new file mode 100644
