diff --git a/src/main/java/ti4/helpers/ScOffer.java b/src/main/java/ti4/helpers/ScOffer.java
new file mode 100644
index 0000000..9168ab5
--- /dev/null
+++ b/src/main/java/ti4/helpers/ScOffer.java
@@ -0,0 +1,122 @@
+package ti4.helpers;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.regex.Pattern;
+import javax.annotation.Nullable;
+import net.dv8tion.jda.api.components.buttons.Button;
+import ti4.discord.interactions.routing.ComponentIdEnvelope;
+import ti4.game.Game;
+import ti4.game.Player;
+
+/**
+ * Which strategy-card secondary "offer" a pressed button belongs to, so the "this player already used this offer"
+ * flags (no second command token, no second draw) are kept by offer in the game instead of by the Discord message the
+ * buttons sit on.
+ *
+ * <ul>
+ *   <li>A strategy card play: the card's message keeps its plain ids (sc_draw_so, sc_ac_draw, sc_follow_8 …); when it
+ *       is posted, each of those ids is recorded in the game as belonging to this play ({@link #recordPlay}). Every
+ *       play is a new offer, so the next play (next round, Winnu hero …) starts clean.
+ *   <li>Any other offer of the same buttons (Grace, Crisis, heroes, action cards …): the ids carry the offer, as a
+ *       trailing {@code ~o<n>} that {@link ComponentIdEnvelope} keeps out of the handler id ({@link #tag}).
+ * </ul>
+ *
+ * A pressed id that is neither (a prompt posted before offers existed) keeps the old per-message flags.
+ */
+public final class ScOffer {
+
+    private static final String SEQ = "scOfferSeq";
+    private static final String PLAY_OF = "scOfferOf_";
+    private static final String REACTS = "SCReacts";
+
+    /** Handlers that record "already used on this offer" (ButtonHelperSCs.addUsedSCPlayer). */
+    private static final Pattern TRACKED = Pattern.compile("^(sc_follow_\\d+|sc_no_follow_\\d+|sc_trade_follow|sc_follow_trade"
+            + "|sc_refresh|sc_refresh_and_wash|sc_ac_draw|lumiACdraw|sc_draw_so|score_imperial|diploRefresh2"
+            + "|construction_[A-Za-z]+|warfareBuild|warfareTeBuild|nekroFollowTech|acquireATechWithSC(_first)?"
+            + "|titansConstructionMechDeployStep1|drawParadigm|resolveSacrificeSecondary)$");
+
+    private ScOffer() {}
+
+    static boolean tracked(String handlerId) {
+        return handlerId != null && TRACKED.matcher(handlerId).matches();
+    }
+
+    private static String nextOffer(Game game) {
+        int n;
+        try {
+            n = Integer.parseInt(game.getStoredValue(SEQ));
+        } catch (NumberFormatException e) {
+            n = 0;
+        }
+        n++;
+        game.setStoredValue(SEQ, Integer.toString(n));
+        return Integer.toString(n);
+    }
+
+    /** A strategy card's message is being posted: its secondary ids now belong to this (new) play. */
+    public static void recordPlay(Game game, List<Button> buttons) {
+        String offer = null;
+        for (Button button : buttons) {
+            String handlerId = ComponentIdEnvelope.decode(button.getCustomId()).handlerId();
+            if (!tracked(handlerId)) continue;
+            if (offer == null) offer = nextOffer(game);
+            game.setStoredValue(PLAY_OF + handlerId, offer);
+        }
+    }
+
+    /** These buttons (another offer of strategy card secondaries) carry a fresh offer in their ids. */
+    public static List<Button> tag(Game game, List<Button> buttons) {
+        String offer = null;
+        List<Button> tagged = new ArrayList<>(buttons.size());
+        for (Button button : buttons) {
+            String id = button.getCustomId();
+            String handlerId = ComponentIdEnvelope.decode(id).handlerId();
+            if (tracked(handlerId) && ComponentIdEnvelope.offerOf(id) == null) {
+                if (offer == null) offer = nextOffer(game);
+                tagged.add(button.withCustomId(id + ComponentIdEnvelope.OFFER_MARKER + offer));
+            } else {
+                tagged.add(button);
+            }
+        }
+        return tagged;
+    }
+
+    /** The offer a pressed id belongs to, or null for a prompt posted before offers existed. */
+    @Nullable
+    public static String of(Game game, @Nullable String rawId) {
+        if (rawId == null) return null;
+        String offer = ComponentIdEnvelope.offerOf(rawId);
+        if (offer == null) {
+            String handlerId = ComponentIdEnvelope.decode(rawId).handlerId();
+            if (tracked(handlerId)) offer = game.getStoredValue(PLAY_OF + handlerId);
+        }
+        return offer == null || offer.isEmpty() ? null : "scOffer" + offer;
+    }
+
+    /**
+     * Marks that player used the offer the pressed button belongs to ({@code part} distinguishes separate one-time
+     * parts of one offer, e.g. "so" for Imperial's draw); true if they already had.
+     *
+     * @param legacyPromptId the message the button sits on — used only for a prompt posted before offers existed,
+     *     and to honour flags such a prompt recorded before this change.
+     */
+    public static boolean markUsed(
+            Game game, Player player, @Nullable String rawId, @Nullable String legacyPromptId, String part) {
+        String offer = of(game, rawId);
+        if (offer == null) return ButtonHelperSCs.addUsedSCPlayer(legacyPromptId + part, game, player);
+        boolean usedBefore = legacyPromptId != null
+                && game.getStoredValue(legacyPromptId + part + REACTS).contains(player.getFaction());
+        return ButtonHelperSCs.addUsedSCPlayer(offer + part, game, player) || usedBefore;
+    }
+
+    /** "Not following": forget that player used the offer. */
+    public static void unmarkUsed(Game game, Player player, @Nullable String rawId, @Nullable String legacyPromptId) {
+        String offer = of(game, rawId);
+        for (String key : new String[] {offer, legacyPromptId}) {
+            if (key == null) continue;
+            String players = game.getStoredValue(key + REACTS);
+            if (!players.isEmpty()) game.setStoredValue(key + REACTS, players.replace(player.getFaction(), ""));
+        }
+    }
+}
