--- /dev/null
+++ b/src/main/java/ti4/spring/api/selfhost/TradeService.java
@@ -0,0 +1,692 @@
+package ti4.spring.api.selfhost;
+
+import java.lang.reflect.Method;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.TimeUnit;
+import net.dv8tion.jda.api.components.buttons.Button;
+import net.dv8tion.jda.api.entities.Message;
+import net.dv8tion.jda.api.entities.MessageHistory;
+import net.dv8tion.jda.api.entities.channel.concrete.ThreadChannel;
+import org.springframework.stereotype.Service;
+import ti4.discord.JdaService;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.helpers.ButtonHelper;
+import ti4.helpers.ButtonHelperExplore;
+import ti4.helpers.Constants;
+import ti4.helpers.TransactionHelper;
+import ti4.image.Mapper;
+import ti4.model.ActionCardModel;
+import ti4.model.PromissoryNoteModel;
+import ti4.model.RelicModel;
+import ti4.service.agenda.IsPlayerElectedService;
+import ti4.spring.api.selfhost.TradeModels.ButtonRef;
+import ti4.spring.api.selfhost.TradeModels.CardRef;
+import ti4.spring.api.selfhost.TradeModels.PendingOffer;
+import ti4.spring.api.selfhost.TradeModels.PendingResponse;
+import ti4.spring.api.selfhost.TradeModels.ProposeRequest;
+import ti4.spring.api.selfhost.TradeModels.ProposeResponse;
+import ti4.spring.api.selfhost.TradeModels.TradeCounterparty;
+import ti4.spring.api.selfhost.TradeModels.TradeItem;
+import ti4.spring.api.selfhost.TradeModels.TradeOptions;
+import ti4.spring.api.selfhost.TradeModels.TradeSelf;
+import ti4.spring.api.selfhost.TradeModels.TradeSide;
+
+/**
+ * Builds the web trade panel's view of the bot's transaction system and proposes offers through it. Proposing
+ * writes the same transaction items the {@code offerToTransact_} buttons write, then calls the bot's own
+ * {@link TransactionHelper#sendOffer} so the receiver gets the usual Accept / Reject / Counter buttons.
+ */
+@Service
+public class TradeService {
+
+    /** Thrown for a request the bot's transaction rules don't allow; mapped to HTTP 400. */
+    public static class TradeException extends RuntimeException {
+        public TradeException(String message) {
+            super(message);
+        }
+    }
+
+    private static final List<String> FRAGMENT_TRAITS =
+            List.of(Constants.CULTURAL, Constants.INDUSTRIAL, Constants.HAZARDOUS, Constants.FRONTIER);
+    private static final int MAX_GENERIC = 7;
+    private static final int MAX_DIGIT = 9;
+    private static final long HISTORY_TTL_MS = 3000;
+
+    private record HistoryEntry(long at, long version, List<Message> messages) {}
+
+    private final Map<String, HistoryEntry> historyCache = new ConcurrentHashMap<>();
+
+    // ---------------------------------------------------------------- options
+
+    public TradeOptions options(Game game, Player me) {
+        List<TradeCounterparty> others = new ArrayList<>();
+        for (Player p : game.getRealPlayers()) {
+            if (p == me || p.getFaction().equalsIgnoreCase(me.getFaction())) continue;
+            if (!Mapper.isValidFaction(p.getFaction())) continue;
+            others.add(counterparty(game, me, p));
+        }
+        return new TradeOptions(
+                game.getName(),
+                game.getPhaseOfGame(),
+                game.getRound(),
+                TransactionHelper.useNewTransactionModel(game),
+                blockedReason(game, me),
+                game.getLastModifiedDate(),
+                self(game, me),
+                others);
+    }
+
+    private static String blockedReason(Game game, Player me) {
+        if (game.isFowMode()) return "Trading from the web panel isn't available in fog of war games.";
+        if (!TransactionHelper.useNewTransactionModel(game))
+            return "This game uses the old transaction method (direct sends), which has no offers.";
+        String phase = game.getPhaseOfGame() == null ? "" : game.getPhaseOfGame().toLowerCase(Locale.ROOT);
+        if (game.isHiddenAgendaMode()
+                && phase.contains("agenda")
+                && game.getStoredValue("executiveOrder").isEmpty())
+            return "Hidden Agenda mode doesn't allow transactions in the agenda phase.";
+        if (me.hasAbility("policy_the_people_control") && !"action".equals(phase))
+            return "Policy - The People: Control prevents you from transacting outside the action phase.";
+        return null;
+    }
+
+    private static TradeSelf self(Game game, Player me) {
+        List<CardRef> pns = new ArrayList<>();
+        for (String id : me.getPromissoryNotes().keySet()) {
+            if (me.getPromissoryNotesInPlayArea().contains(id)) continue;
+            pns.add(pnRef(game, id));
+        }
+        List<CardRef> acs = new ArrayList<>();
+        for (String id : me.getActionCards().keySet()) {
+            ActionCardModel ac = Mapper.getActionCard(id);
+            acs.add(new CardRef(id, ac == null ? id : ac.getName(), ac == null ? null : ac.getText(), null, null));
+        }
+        return new TradeSelf(
+                me.getUserID(),
+                me.getUserName(),
+                me.getFaction(),
+                me.getColor(),
+                me.getTg(),
+                me.getCommodities(),
+                me.getCommoditiesTotal(),
+                !me.hasAbility("military_industrial_complex"),
+                pns,
+                acs,
+                fragments(me),
+                relics(me),
+                emojiUrl(me));
+    }
+
+    private static TradeCounterparty counterparty(Game game, Player me, Player p) {
+        boolean canTrade = canTheseTwoTransact(game, me, p);
+        String reason = null;
+        if (!canTrade) {
+            reason = IsPlayerElectedService.isPlayerElected(game, me, "tf-censure")
+                            || IsPlayerElectedService.isPlayerElected(game, p, "tf-censure")
+                    ? "Censured"
+                    : "Not neighbors (action phase)";
+        } else if (p.hasAbility("policy_the_people_control") && !"action".equalsIgnoreCase(game.getPhaseOfGame())) {
+            canTrade = false;
+            reason = "Their Policy - The People: Control forbids it outside the action phase";
+        }
+        boolean hubris = me.hasAbility("hubris");
+        List<CardRef> requestable = new ArrayList<>();
+        for (String id : p.getPromissoryNotesOwned()) {
+            if (ButtonHelper.anyoneHaveInPlayArea(game, id)) continue;
+            if (hubris && id.endsWith("_an")) continue;
+            if (Mapper.getPromissoryNote(id) == null) continue;
+            requestable.add(pnRef(game, id));
+        }
+        List<String> excludedGive = new ArrayList<>();
+        if (p.hasAbility("hubris")) {
+            for (String id : me.getPromissoryNotes().keySet()) {
+                if (id.endsWith("_an")) excludedGive.add(id);
+            }
+        }
+        return new TradeCounterparty(
+                p.getUserID(),
+                p.getUserName(),
+                p.getFaction(),
+                p.getColor(),
+                canTrade,
+                me.isNeighboursWith(p),
+                reason,
+                p.getTg(),
+                p.getCommodities(),
+                p.getCommoditiesTotal(),
+                !p.hasAbility("military_industrial_complex"),
+                p.getPnCount(),
+                p.getAcCount(),
+                fragments(p),
+                requestable,
+                relics(p),
+                canTradeActionCards(me, p),
+                me.getDebtTokenCount(p.getColor()),
+                p.getDebtTokenCount(me.getColor()),
+                excludedGive,
+                emojiUrl(p));
+    }
+
+    private static CardRef pnRef(Game game, String id) {
+        PromissoryNoteModel pn = Mapper.getPromissoryNote(id);
+        Player owner = game.getPNOwner(id);
+        return new CardRef(
+                id,
+                pn == null ? id : pn.getName(),
+                pn == null || pn.getText() == null ? null : pn.getText().replaceAll("<([A-Za-z0-9_]+)>", "$1"),
+                owner == null ? null : owner.getFaction(),
+                owner == null ? null : owner.getColor());
+    }
+
+    private static Map<String, Integer> fragments(Player p) {
+        Map<String, Integer> out = new LinkedHashMap<>();
+        for (String trait : FRAGMENT_TRAITS) out.put(trait, ButtonHelperExplore.getNormalFragmentCount(p, trait));
+        return out;
+    }
+
+    private static List<CardRef> relics(Player p) {
+        List<CardRef> out = new ArrayList<>();
+        for (String id : p.getTradableRelics()) {
+            RelicModel r = Mapper.getRelic(id);
+            out.add(new CardRef(id, r == null ? id : r.getName(), r == null ? null : r.getText(), null, null));
+        }
+        return out;
+    }
+
+    private static boolean canTradeActionCards(Player a, Player b) {
+        return hasActionCardTrading(a) || hasActionCardTrading(b);
+    }
+
+    private static boolean hasActionCardTrading(Player p) {
+        return p.hasAbility("arbiters") || p.hasTech("tf-guildships");
+    }
+
+    // ---------------------------------------------------------------- propose
+
+    public ProposeResponse propose(Game game, Player me, ProposeRequest req) {
+        String blocked = blockedReason(game, me);
+        if (blocked != null) throw new TradeException(blocked);
+        if (req == null || req.to() == null || req.to().isBlank()) throw new TradeException("Missing 'to'.");
+        Player them = findPlayer(game, req.to());
+        if (them == null || them == me || !them.isRealPlayer())
+            throw new TradeException("Unknown trade partner: " + req.to());
+        TradeCounterparty cp = counterparty(game, me, them);
+        List<String> warnings = new ArrayList<>();
+        if (!cp.canTrade()) throw new TradeException("You can't trade with " + them.getUserName() + ": " + cp.reason());
+
+        List<String> items = new ArrayList<>();
+        addGive(game, me, them, cp, req.give(), items);
+        addReceive(game, me, them, cp, req.receive(), items);
+        if (req.note() != null && !req.note().isBlank()) {
+            String note = req.note().trim();
+            if (note.length() > 400) note = note.substring(0, 400);
+            items.add(prefix(me, them) + "details_"
+                    + note.replace("_", "").replace(",", "").replace("\n", " ").replace(" ", "fin777"));
+        }
+        if (items.isEmpty()) throw new TradeException("The offer is empty.");
+
+        me.clearTransactionItemsWithPlayer(them);
+        for (String item : items) me.addTransactionItem(item);
+        TransactionHelper.sendOffer(game, me, "sendOffer_" + them.getColor(), null);
+        retireStaleOffers(game, me, them);
+
+        String key = "offerFrom" + me.getFaction() + "To" + them.getFaction();
+        int offerNumber = parseInt(game.getStoredValue(key), 0);
+        return new ProposeResponse(
+                true,
+                offerNumber,
+                them.getFaction(),
+                decode(game, me.getTransactionItemsWithPlayer(them)),
+                offerText(game, me, them),
+                warnings);
+    }
+
+    private static void addGive(Game game, Player me, Player them, TradeCounterparty cp, TradeSide s, List<String> out) {
+        if (s == null) return;
+        String pre = prefix(me, them);
+        int tg = nz(s.tg());
+        if (tg < 0 || tg > me.getTg()) throw new TradeException("You have " + me.getTg() + " trade goods.");
+        if (tg > 0) out.add(pre + "TGs_" + tg);
+        int comms = nz(s.commodities());
+        if (comms < 0 || comms > me.getCommodities())
+            throw new TradeException("You have " + me.getCommodities() + " commodities.");
+        if (comms > 0 && me.hasAbility("military_industrial_complex"))
+            throw new TradeException("Military Industrial Complex: you can't trade commodities.");
+        if (comms > 0) out.add(pre + "Comms_" + comms);
+
+        List<String> pns = list(s.promissoryNotes());
+        if (pns.size() > 1) throw new TradeException("You may only send 1 promissory note per transaction.");
+        for (String id : pns) {
+            Integer num = me.getPromissoryNotes().get(id);
+            if (num == null) throw new TradeException("You don't hold promissory note " + id + ".");
+            if (me.getPromissoryNotesInPlayArea().contains(id))
+                throw new TradeException(id + " is in your play area.");
+            if (cp.excludedGivePromissoryNotes().contains(id))
+                throw new TradeException("They have Hubris and can't receive an Alliance.");
+            out.add(pre + "PNs_" + num);
+        }
+        List<String> acs = list(s.actionCards());
+        if (!acs.isEmpty() && !cp.canTradeActionCards())
+            throw new TradeException("Neither of you can trade action cards.");
+        for (String id : acs) {
+            Integer num = me.getActionCards().get(id);
+            if (num == null) throw new TradeException("You don't hold action card " + id + ".");
+            out.add(pre + "ACs_" + num);
+        }
+        addFragments(pre, s.fragments(), me, "You", out);
+        for (String id : list(s.relics())) {
+            if (!me.getTradableRelics().contains(id)) throw new TradeException(id + " isn't a tradable relic of yours.");
+            out.add(pre + "Relics_" + id);
+        }
+        int send = nz(s.sendDebt());
+        if (send < 0 || send > MAX_DIGIT) throw new TradeException("Debt must be 0-" + MAX_DIGIT + ".");
+        if (send > 0) out.add(pre + "SendDebt_" + send);
+        int clear = nz(s.clearDebt());
+        if (clear < 0 || clear > cp.debtIHold())
+            throw new TradeException("You hold " + cp.debtIHold() + " of their debt tokens.");
+        if (clear > 0) out.add(pre + "ClearDebt_" + clear);
+    }
+
+    private static void addReceive(
+            Game game, Player me, Player them, TradeCounterparty cp, TradeSide s, List<String> out) {
+        if (s == null) return;
+        String pre = prefix(them, me);
+        int tg = nz(s.tg());
+        if (tg < 0 || tg > them.getTg()) throw new TradeException("They have " + them.getTg() + " trade goods.");
+        if (tg > 0) out.add(pre + "TGs_" + tg);
+        int comms = nz(s.commodities());
+        if (comms < 0 || comms > them.getCommodities())
+            throw new TradeException("They have " + them.getCommodities() + " commodities.");
+        if (comms > 0 && them.hasAbility("military_industrial_complex"))
+            throw new TradeException("Military Industrial Complex: they can't trade commodities.");
+        if (comms > 0) out.add(pre + "Comms_" + comms);
+
+        List<String> pns = list(s.promissoryNotes());
+        if (pns.size() > 1) throw new TradeException("They may only send 1 promissory note per transaction.");
+        for (String id : pns) {
+            if ("any".equalsIgnoreCase(id)) {
+                out.add(pre + "PNs_generic1");
+                continue;
+            }
+            boolean requestable =
+                    cp.requestablePromissoryNotes().stream().anyMatch(r -> r.id().equals(id));
+            if (!requestable) throw new TradeException(id + " can't be requested from them.");
+            Integer num = them.getPromissoryNotes().get(id);
+            out.add(pre + "PNs_" + (num != null ? String.valueOf(num) : id.replace("_", "fin9")));
+        }
+        int acCount = nz(s.actionCardCount());
+        if (acCount > 0 && !cp.canTradeActionCards())
+            throw new TradeException("Neither of you can trade action cards.");
+        if (acCount < 0 || acCount > Math.min(MAX_GENERIC, them.getAcCount()))
+            throw new TradeException("They hold " + them.getAcCount() + " action cards.");
+        if (acCount > 0) out.add(pre + "ACs_generic" + acCount);
+        addFragments(pre, s.fragments(), them, "They", out);
+        for (String id : list(s.relics())) {
+            if (!them.getTradableRelics().contains(id))
+                throw new TradeException(id + " isn't a tradable relic of theirs.");
+            out.add(pre + "Relics_" + id);
+        }
+        int send = nz(s.sendDebt());
+        if (send < 0 || send > MAX_DIGIT) throw new TradeException("Debt must be 0-" + MAX_DIGIT + ".");
+        if (send > 0) out.add(pre + "SendDebt_" + send);
+        int clear = nz(s.clearDebt());
+        if (clear < 0 || clear > cp.debtTheyHold())
+            throw new TradeException("They hold " + cp.debtTheyHold() + " of your debt tokens.");
+        if (clear > 0) out.add(pre + "ClearDebt_" + clear);
+    }
+
+    private static void addFragments(
+            String pre, Map<String, Integer> frags, Player holder, String who, List<String> out) {
+        if (frags == null) return;
+        for (Map.Entry<String, Integer> e : frags.entrySet()) {
+            int n = nz(e.getValue());
+            if (n == 0) continue;
+            String trait = e.getKey().toLowerCase(Locale.ROOT);
+            String code =
+                    switch (trait) {
+                        case Constants.CULTURAL -> "CRF";
+                        case Constants.INDUSTRIAL -> "IRF";
+                        case Constants.HAZARDOUS -> "HRF";
+                        case Constants.FRONTIER, "unknown" -> "URF";
+                        default -> throw new TradeException("Unknown fragment type " + e.getKey() + ".");
+                    };
+            String canon = "URF".equals(code) ? Constants.FRONTIER : trait;
+            int held = ButtonHelperExplore.getNormalFragmentCount(holder, canon);
+            if (n < 0 || n > held || n > MAX_DIGIT)
+                throw new TradeException(who + " hold " + held + " " + canon + " fragments.");
+            out.add(pre + "Frags_" + code + n);
+        }
+    }
+
+    // ---------------------------------------------------------------- pending
+
+    public PendingResponse pending(Game game, Player me) {
+        List<PendingOffer> incoming = new ArrayList<>();
+        List<PendingOffer> outgoing = new ArrayList<>();
+        ThreadChannel myThread = me.getCardsInfoThread();
+        if (myThread == null) return new PendingResponse(incoming, outgoing);
+        List<Message> mine = history(myThread, game);
+
+        Map<String, Boolean> seenRescind = new LinkedHashMap<>();
+        for (Message m : mine) {
+            ButtonRef accept = null, reject = null, counter = null, rescind = null;
+            for (Button b : m.getComponentTree().findAll(Button.class)) {
+                String id = b.getCustomId();
+                if (id == null) continue;
+                ButtonRef ref = new ButtonRef(myThread.getId(), m.getId(), id, b.getLabel());
+                if (id.startsWith("acceptOffer_")) accept = ref;
+                else if (id.startsWith("rejectOffer_")) reject = ref;
+                else if (id.startsWith("resetOffer_")) counter = ref;
+                else if (id.startsWith("rescindOffer_")) rescind = ref;
+            }
+            if (accept != null) {
+                PendingOffer offer = incomingOffer(game, me, m, accept, reject, counter);
+                if (offer != null) incoming.add(offer);
+            }
+            if (rescind != null) {
+                String color = rescind.customId().split("_")[1];
+                if (seenRescind.putIfAbsent(color, true) != null) continue; // newest first
+                PendingOffer offer = outgoingOffer(game, me, m, color, rescind);
+                if (offer != null) outgoing.add(offer);
+            }
+        }
+        return new PendingResponse(incoming, outgoing);
+    }
+
+    private PendingOffer incomingOffer(
+            Game game, Player me, Message m, ButtonRef accept, ButtonRef reject, ButtonRef counter) {
+        String[] parts = accept.customId().split("_");
+        Player from = game.getPlayerFromColorOrFaction(parts[1]);
+        if (from == null) return null;
+        int num = parts.length > 2 ? parseInt(parts[2], -1) : -1;
+        int latest = parseInt(game.getStoredValue("offerFrom" + from.getFaction() + "To" + me.getFaction()), -1);
+        List<String> items = from.getTransactionItemsWithPlayer(me);
+        boolean current = (num == -1 || num == latest) && !items.isEmpty();
+        return new PendingOffer(
+                "incoming",
+                from.getFaction(),
+                from.getUserID(),
+                from.getUserName(),
+                from.getColor(),
+                num,
+                current,
+                m.getContentRaw(),
+                current ? decode(game, items) : List.of(),
+                accept,
+                reject,
+                counter,
+                null,
+                m.getTimeCreated().toString(),
+                emojiUrl(from));
+    }
+
+    private PendingOffer outgoingOffer(Game game, Player me, Message m, String color, ButtonRef rescind) {
+        Player to = game.getPlayerFromColorOrFaction(color);
+        if (to == null) return null;
+        List<String> items = me.getTransactionItemsWithPlayer(to);
+        if (items.isEmpty()) return null;
+        int latest = parseInt(game.getStoredValue("offerFrom" + me.getFaction() + "To" + to.getFaction()), -1);
+        ThreadChannel theirs = to.getCardsInfoThread();
+        if (theirs == null) return null;
+        boolean open = false;
+        for (Message tm : history(theirs, game)) {
+            for (Button b : tm.getComponentTree().findAll(Button.class)) {
+                String id = b.getCustomId();
+                if (id != null && id.startsWith("acceptOffer_" + me.getColor() + "_" + latest)) open = true;
+            }
+            if (open) break;
+        }
+        if (!open) return null;
+        return new PendingOffer(
+                "outgoing",
+                to.getFaction(),
+                to.getUserID(),
+                to.getUserName(),
+                to.getColor(),
+                latest,
+                true,
+                m.getContentRaw(),
+                decode(game, items),
+                null,
+                null,
+                null,
+                rescind,
+                m.getTimeCreated().toString(),
+                emojiUrl(to));
+    }
+
+    /**
+     * Strips the Accept / Reject / Counter buttons of {@code sender}'s offers in {@code receiver}'s cards-info thread
+     * that the bot would refuse anyway: replaced by a newer offer, or rescinded (the bot only deletes the rescinder's
+     * own message). Otherwise they stay pressable and show up in the web client as an open trade decision.
+     */
+    public static void retireStaleOffers(Game game, Player sender, Player receiver) {
+        java.util.concurrent.CompletableFuture.runAsync(() -> {
+            try {
+                ThreadChannel thread = receiver.getCardsInfoThread();
+                if (thread == null) return;
+                // Give a just-sent offer time to land, so it is seen (and kept) as the newest one.
+                Thread.sleep(1500);
+                int latest = parseInt(game.getStoredValue("offerFrom" + sender.getFaction() + "To" + receiver.getFaction()), -1);
+                boolean live = !sender.getTransactionItemsWithPlayer(receiver).isEmpty();
+                String prefix = "acceptOffer_" + sender.getColor();
+                String botId = JdaService.getBotId();
+                for (Message m : thread.getHistory().retrievePast(100).timeout(5, TimeUnit.SECONDS).complete()) {
+                    if (botId != null && !botId.equals(m.getAuthor().getId())) continue;
+                    for (Button b : m.getComponentTree().findAll(Button.class)) {
+                        String id = b.getCustomId();
+                        if (id == null || !(id.equals(prefix) || id.startsWith(prefix + "_"))) continue;
+                        String[] parts = id.split("_");
+                        int num = parts.length > 2 ? parseInt(parts[2], -1) : -1;
+                        if (live && (num == -1 || num == latest)) break;
+                        m.editMessageComponents(java.util.Collections.emptyList()).queue(ok -> {}, e -> {});
+                        break;
+                    }
+                }
+            } catch (Exception e) {
+                ti4.logging.BotLogger.error("Could not retire stale trade offers in " + game.getName(), e);
+            }
+        });
+    }
+
+    private List<Message> history(ThreadChannel channel, Game game) {
+        long now = System.currentTimeMillis();
+        HistoryEntry hit = historyCache.get(channel.getId());
+        if (hit != null && hit.version == game.getLastModifiedDate() && now - hit.at < HISTORY_TTL_MS)
+            return hit.messages;
+        try {
+            MessageHistory mh = channel.getHistory();
+            List<Message> got = mh.retrievePast(100).timeout(5, TimeUnit.SECONDS).complete();
+            String botId = JdaService.getBotId();
+            List<Message> fromBot = got.stream()
+                    .filter(msg -> botId == null || botId.equals(msg.getAuthor().getId()))
+                    .toList();
+            historyCache.put(channel.getId(), new HistoryEntry(now, game.getLastModifiedDate(), fromBot));
+            return fromBot;
+        } catch (Exception e) {
+            return hit != null ? hit.messages : List.of();
+        }
+    }
+
+    // ---------------------------------------------------------------- decoding
+
+    /** Decodes bot transaction items into display lines. */
+    public static List<TradeItem> decode(Game game, List<String> items) {
+        List<TradeItem> out = new ArrayList<>();
+        for (String raw : items) {
+            String[] parts = raw.split("_", 4);
+            if (parts.length < 4) continue;
+            Player from = game.getPlayerFromColorOrFaction(parts[0].replaceFirst("^sending", ""));
+            Player to = game.getPlayerFromColorOrFaction(parts[1].replaceFirst("^receiving", ""));
+            String fromF = from == null ? parts[0].replaceFirst("^sending", "") : from.getFaction();
+            String toF = to == null ? parts[1].replaceFirst("^receiving", "") : to.getFaction();
+            out.add(decodeOne(game, from, fromF, toF, parts[2], parts[3], raw));
+        }
+        return out;
+    }
+
+    private static TradeItem decodeOne(
+            Game game, Player from, String fromF, String toF, String thing, String detail, String raw) {
+        switch (thing) {
+            case "TGs" -> {
+                int n = parseInt(detail, 0);
+                return new TradeItem(fromF, toF, "tg", n, null, n + " trade good" + (n == 1 ? "" : "s"), raw);
+            }
+            case "Comms" -> {
+                int n = parseInt(detail, 0);
+                return new TradeItem(fromF, toF, "commodities", n, null, n + " commodit" + (n == 1 ? "y" : "ies"), raw);
+            }
+            case "SendDebt" -> {
+                int n = parseInt(detail, 0);
+                return new TradeItem(fromF, toF, "sendDebt", n, null, "Send " + n + " debt", raw);
+            }
+            case "ClearDebt" -> {
+                int n = parseInt(detail, 0);
+                return new TradeItem(fromF, toF, "clearDebt", n, null, "Clear " + n + " debt", raw);
+            }
+            case "PNs" -> {
+                if (detail.startsWith("generic"))
+                    return new TradeItem(fromF, toF, "pnAny", 1, null, "A promissory note of their choice", raw);
+                String id = detail.contains("fin9") ? detail.replace("fin9", "_") : pnIdFromNumber(from, detail);
+                PromissoryNoteModel pn = id == null ? null : Mapper.getPromissoryNote(id);
+                return new TradeItem(fromF, toF, "pn", 1, id, pn == null ? "Promissory note" : pn.getName(), raw);
+            }
+            case "ACs" -> {
+                if (detail.startsWith("generic")) {
+                    int n = parseInt(detail.substring("generic".length()), 1);
+                    return new TradeItem(
+                            fromF, toF, "acAny", n, null, n + " action card" + (n == 1 ? "" : "s") + " (their pick)", raw);
+                }
+                String id = acIdFromNumber(from, detail);
+                ActionCardModel ac = id == null ? null : Mapper.getActionCard(id);
+                return new TradeItem(fromF, toF, "ac", 1, id, ac == null ? "Action card" : ac.getName(), raw);
+            }
+            case "Frags" -> {
+                if (detail.startsWith("supermassive"))
+                    return new TradeItem(fromF, toF, "fragment", 1, detail, "Supermassive fragment", raw);
+                String trait =
+                        switch (detail.substring(0, Math.min(3, detail.length())).toUpperCase(Locale.ROOT)) {
+                            case "CRF" -> Constants.CULTURAL;
+                            case "IRF" -> Constants.INDUSTRIAL;
+                            case "HRF" -> Constants.HAZARDOUS;
+                            default -> Constants.FRONTIER;
+                        };
+                int n = parseInt(detail.substring(Math.min(3, detail.length())), 1);
+                return new TradeItem(fromF, toF, "fragment", n, trait, n + " " + trait + " fragment" + (n == 1 ? "" : "s"), raw);
+            }
+            case "Relics" -> {
+                RelicModel r = Mapper.getRelic(detail);
+                return new TradeItem(fromF, toF, "relic", 1, detail, r == null ? detail : r.getName(), raw);
+            }
+            case "details" -> {
+                return new TradeItem(fromF, toF, "note", 0, null, detail.replace("fin777", " "), raw);
+            }
+            default -> {
+                return new TradeItem(fromF, toF, "other", 0, detail, thing + " " + detail, raw);
+            }
+        }
+    }
+
+    private static String pnIdFromNumber(Player holder, String num) {
+        if (holder == null) return null;
+        int n = parseInt(num, -1);
+        return holder.getPromissoryNotes().entrySet().stream()
+                .filter(e -> e.getValue() == n)
+                .map(Map.Entry::getKey)
+                .findFirst()
+                .orElse(null);
+    }
+
+    private static String acIdFromNumber(Player holder, String num) {
+        if (holder == null) return null;
+        int n = parseInt(num, -1);
+        return holder.getActionCards().entrySet().stream()
+                .filter(e -> e.getValue() == n)
+                .map(Map.Entry::getKey)
+                .findFirst()
+                .orElse(null);
+    }
+
+    // ---------------------------------------------------------------- helpers
+
+    private static Player findPlayer(Game game, String to) {
+        Player p = game.getPlayer(to);
+        if (p != null) return p;
+        p = game.getPlayerFromColorOrFaction(to.toLowerCase(Locale.ROOT));
+        if (p != null) return p;
+        return game.getRealPlayers().stream()
+                .filter(x -> to.equalsIgnoreCase(x.getUserName()))
+                .findFirst()
+                .orElse(null);
+    }
+
+    private static final java.util.regex.Pattern EMOJI_ID = java.util.regex.Pattern.compile("<a?:\\w+:(\\d+)>");
+
+    private static String emojiUrl(Player p) {
+        try {
+            java.util.regex.Matcher m = EMOJI_ID.matcher(String.valueOf(p.getFactionEmoji()));
+            return m.find() ? "/emojis/" + m.group(1) : null;
+        } catch (Exception e) {
+            return null;
+        }
+    }
+
+    private static String prefix(Player from, Player to) {
+        return "sending" + from.getFaction() + "_receiving" + to.getFaction() + "_";
+    }
+
+    private static int nz(Integer v) {
+        return v == null ? 0 : v;
+    }
+
+    private static List<String> list(List<String> v) {
+        return v == null ? List.of() : v.stream().filter(s -> s != null && !s.isBlank()).toList();
+    }
+
+    private static int parseInt(String s, int dflt) {
+        try {
+            return Integer.parseInt(s);
+        } catch (Exception e) {
+            return dflt;
+        }
+    }
+
+    // The bot keeps these private; call them reflectively instead of duplicating its rules.
+
+    private static Method canTransact;
+    private static Method buildOffer;
+
+    private static boolean canTheseTwoTransact(Game game, Player a, Player b) {
+        try {
+            if (canTransact == null) {
+                Method m = TransactionHelper.class.getDeclaredMethod(
+                        "canTheseTwoTransact", Game.class, Player.class, Player.class);
+                m.setAccessible(true);
+                canTransact = m;
+            }
+            return (boolean) canTransact.invoke(null, game, a, b);
+        } catch (ReflectiveOperationException e) {
+            return a.isNeighboursWith(b) || !"action".equalsIgnoreCase(game.getPhaseOfGame());
+        }
+    }
+
+    private static String offerText(Game game, Player a, Player b) {
+        try {
+            if (buildOffer == null) {
+                Method m = TransactionHelper.class.getDeclaredMethod(
+                        "buildTransactionOffer", Player.class, Player.class, Game.class, boolean.class);
+                m.setAccessible(true);
+                buildOffer = m;
+            }
+            return (String) buildOffer.invoke(null, a, b, game, false);
+        } catch (ReflectiveOperationException e) {
+            return null;
+        }
+    }
+}
