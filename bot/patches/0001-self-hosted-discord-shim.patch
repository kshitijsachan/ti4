+package ti4.selfhost.engine.kinds;
+
+import java.util.List;
+
+/**
+ * Ghosts of Creuss. Mech (Iconoclast: DEPLOY-like wormhole placement) creussMechStep1_ (use) → creussMechStep2_&lt;tile&gt;
+ * (which mech's system) → creussMechStep3_&lt;tile&gt;_&lt;alpha|beta|gamma&gt; (which wormhole); Creuss IFF (promissory "iff")
+ * creussIFFStart_&lt;wormhole&gt; → creussIFFResolve_&lt;wormhole&gt;_&lt;tile&gt;; hero Riftwalker Meian (swap two systems)
+ * creussHeroStep1_&lt;tile&gt; → creussHeroStep2_&lt;tile&gt;_&lt;tile2&gt;; commander Sai Seravus placeGhostCommanderFF_&lt;tile&gt;
+ * (a fighter after moving through a wormhole). Agent: leader.use exhaustAgent_ghostagent (FactionStepsLeaders).
+ * Quantum Entanglement, Slipstream, Creuss Gate, Dimensional Splicer, Wormhole Generator (component action) and the
+ * flagship Hil Colish are passive or ride on other areas' prompts. Thunder's Edge Red Creuss / TF cruiser ids are the
+ * TE area's.
+ */
+public class FactionStepsCreuss extends FactionStepsRegex {
+    private static final String F = "ghost";
+    private static final String WH = "(?<wormhole>alpha|beta|gamma)";
+
+    private static final List<Rule> RULES = List.of(
+            ability("mech", "ghost_mech", F, "use", true, "creussMechStep1_?"),
+            ability("mech", "ghost_mech", F, "target", false, "creussMechStep2_(?<tile>[^_]+)"),
+            ability("mech", "ghost_mech", F, "target", false, "creussMechStep3_(?<tile>[^_]+)_" + WH),
+            ability("promissory", "iff", F, "target", false, "creussIFFStart_" + WH),
+            ability("promissory", "iff", F, "target", false, "creussIFFResolve_" + WH + "_(?<tile>[^_]+)"),
+            leader("ghosthero", "target", false, "creussHeroStep1_(?<tile>[^_]+)"),
+            leader("ghosthero", "target", false, "creussHeroStep2_(?<from>[^_]+)_(?<tile>[^_]+)"),
+            leader("ghostcommander", "use", true, "placeGhostCommanderFF_(?<tile>[^_]+)"));
+
+    @Override
+    protected List<Rule> rules() {
+        return RULES;
+    }
+}
