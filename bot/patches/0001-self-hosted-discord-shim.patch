diff --git a/src/main/java/ti4/selfhost/engine/kinds/TeGalvanizeKind.java b/src/main/java/ti4/selfhost/engine/kinds/TeGalvanizeKind.java
new file mode 100644
index 0000000..c6f4a01
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/TeGalvanizeKind.java
@@ -0,0 +1,107 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.Arrays;
+import java.util.LinkedHashMap;
+import java.util.Map;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.game.Tile;
+import ti4.selfhost.engine.EngineModels.Decision;
+import ti4.selfhost.engine.EngineModels.Progress;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * Thunder's Edge galvanize (GalvanizeService). One menu per system, edited in place after each press:
+ * FFCC_&lt;f&gt;_galvanize_&lt;pos&gt;_&lt;unit&gt;_&lt;holder&gt; / ungalvanize_… plus "Done Galvanizing Units"
+ * (deleteButtons). The system picker before it is toggleGalvanize_&lt;pos&gt; (Cards Info "Galvanize Units", or the
+ * Mentak "Claim a bounty" reminder).
+ *
+ * <p>progress.required.mandatory: the Bastion agent (Dame Briar) chose this player and they must galvanize one unit;
+ * otherwise the menu is an optional bookkeeping tool. progress.accumulated.galvanized: net units of the target
+ * galvanized in this system since the menu was first seen, so a policy answers a required prompt exactly once and
+ * never toggles back and forth.
+ */
+public class TeGalvanizeKind implements KindSpec {
+
+    static final String REQUIRED_TEXT = "should be galvanized";
+
+    @Override
+    public String kind() {
+        return "te.galvanize";
+    }
+
+    @Override
+    public int priority() {
+        return 100;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return handlerId.startsWith("galvanize_")
+                || handlerId.startsWith("ungalvanize_")
+                || handlerId.startsWith("toggleGalvanize_");
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        if (!matches(handlerId)) return null;
+        Map<String, Object> v = new LinkedHashMap<>();
+        if (handlerId.startsWith("toggleGalvanize_")) {
+            v.put("action", "system");
+            v.put("position", handlerId.substring("toggleGalvanize_".length()));
+            return v;
+        }
+        boolean add = handlerId.startsWith("galvanize_");
+        String[] parts = handlerId.substring(handlerId.indexOf('_') + 1).split("_");
+        if (parts.length < 3) return null;
+        String pos = parts[0];
+        Tile tile = ctx.game().getTileByPosition(pos);
+        TeKinds.remember(ctx.messageId(), "galvanizeBaseline", TeKinds.galvanizedIn(tile, ctx.player()));
+        TeKinds.remember(ctx.messageId(), "galvanizePos", pos);
+        v.put("action", add ? "galvanize" : "ungalvanize");
+        v.put("position", pos);
+        v.put("unit", parts[1]);
+        v.put("holder", String.join("_", Arrays.copyOfRange(parts, 2, parts.length)));
+        return v;
+    }
+
+    /**
+     * Required = the Bastion agent's forced prompt. The only engine-side signal is the engine's own fixed prompt text
+     * (ButtonHelperAgents "bastionagent": "please choose the unit that should be galvanized"); it is read here, inside
+     * the JVM, so no consumer has to.
+     */
+    static boolean required(CaptureContext ctx) {
+        return ctx.content() != null && ctx.content().contains(REQUIRED_TEXT);
+    }
+
+    /** accumulated.galvanized: net units of the target galvanized in this system since the menu was first seen. */
+    @Override
+    public Progress progress(CaptureContext ctx) {
+        String pos = TeKinds.remember(ctx.messageId(), "galvanizePos", "");
+        if (pos.isEmpty()) return null; // a system picker (toggleGalvanize_)
+        int baseline = TeKinds.remember(ctx.messageId(), "galvanizeBaseline", 0);
+        int net = TeKinds.galvanizedIn(ctx.game().getTileByPosition(pos), ctx.player()) - baseline;
+        boolean req = required(ctx);
+        return new Progress(
+                "galvanize",
+                req && net < 1 ? "select_unit" : "confirm",
+                Map.of("galvanized", net, "position", pos),
+                Map.of("units", req ? Math.max(0, 1 - net) : 0, "mandatory", req),
+                !req || net >= 1);
+    }
+
+    @Override
+    public boolean dynamic() {
+        return true;
+    }
+
+    @Override
+    public String scope(CaptureContext ctx) {
+        return "player";
+    }
+
+    @Override
+    public String validate(Game game, Player answering, Decision decision, String optionId) {
+        return TeKinds.ownerLockError(answering, optionId);
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/TeKinds.java b/src/main/java/ti4/selfhost/engine/kinds/TeKinds.java
new file mode 100644
index 0000000..a30be02
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/TeKinds.java
@@ -0,0 +1,93 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.ConcurrentHashMap;
+import javax.annotation.Nullable;
+import ti4.discord.interactions.routing.ComponentIdEnvelope;
+import ti4.game.Game;
+import ti4.game.Planet;
+import ti4.game.Player;
+import ti4.game.Tile;
+import ti4.game.UnitHolder;
+import ti4.selfhost.engine.EngineModels.Target;
+
+/**
+ * Shared helpers for the Thunder's Edge kinds (G10). Not a KindSpec: the kind scan ignores it.
+ *
+ * <p>Owner lock: most TE prompts carry FFCC_&lt;faction&gt;_ and the bot refuses a press by anyone else ("these
+ * buttons are for someone else"). TE kinds refuse such answers up front ({@link #ownerLockError}) so a seat can never
+ * press another faction's locked TE button through the engine, whatever its policy thinks.
+ */
+public final class TeKinds {
+    private TeKinds() {}
+
+    /** Per-message memory used to tell "how much of this prompt is already done" across in-place edits. */
+    private static final Map<String, Map<String, Object>> perMessage = new ConcurrentHashMap<>();
+
+    @SuppressWarnings("unchecked")
+    static <T> T remember(String messageId, String key, T initial) {
+        if (messageId == null) return initial;
+        if (perMessage.size() > 4000) perMessage.clear();
+        Map<String, Object> m = perMessage.computeIfAbsent(messageId, k -> new ConcurrentHashMap<>());
+        return (T) m.computeIfAbsent(key, k -> initial);
+    }
+
+    /** Error text when optionId is locked (FFCC_) to a faction other than the answering player's, else null. */
+    @Nullable
+    static String ownerLockError(Player answering, String optionId) {
+        ComponentIdEnvelope env = ComponentIdEnvelope.decode(optionId);
+        String owner = env.ownerFaction();
+        if (owner == null || answering == null) return null;
+        String f = answering.getFaction();
+        if (owner.equals(f)) return null;
+        if ("firmament".equals(owner) && f != null && f.contains("obsidian")) return null;
+        return "That button belongs to " + owner + ".";
+    }
+
+    static Target target(Player p, String how) {
+        return new Target(p.getUserID(), p.getFaction(), p.getColor(), how);
+    }
+
+    /** Technology specialties ("propulsion", "biotic", ...) of the tile's planets, distinct, in order. */
+    static List<String> skips(Tile tile) {
+        List<String> out = new ArrayList<>();
+        if (tile == null) return out;
+        for (Planet p : tile.getPlanetUnitHolders()) {
+            for (String s : p.getTechSpecialities()) {
+                String t = s.toLowerCase();
+                if (!out.contains(t)) out.add(t);
+            }
+        }
+        return out;
+    }
+
+    /** Galvanized units of this player in the tile (all holders). */
+    static int galvanizedIn(Tile tile, Player p) {
+        if (tile == null || p == null) return 0;
+        int n = 0;
+        for (UnitHolder uh : tile.getUnitHolders().values()) n += uh.getGalvanizedUnitCount(p.getColorID());
+        return n;
+    }
+
+    static int readyPlanetValue(Game game, Player p, boolean resources) {
+        int sum = 0;
+        for (String name : p.getPlanets()) {
+            if (p.getExhaustedPlanets().contains(name)) continue;
+            Planet planet = game.getPlanetsInfo().get(name);
+            if (planet == null) continue;
+            sum += resources ? planet.getResources() : planet.getInfluence();
+        }
+        return sum;
+    }
+
+    static boolean hasReadySkipPlanet(Game game, Player p) {
+        for (String name : p.getPlanets()) {
+            if (p.getExhaustedPlanets().contains(name)) continue;
+            Planet planet = game.getPlanetsInfo().get(name);
+            if (planet != null && !planet.getTechSpecialities().isEmpty()) return true;
+        }
+        return false;
+    }
+}
