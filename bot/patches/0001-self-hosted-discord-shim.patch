@@ -0,0 +1,75 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.Map;
+import java.util.regex.Pattern;
+import ti4.selfhost.engine.EngineModels.Target;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * Game creation prompts in the new game's actions channel, before any draft: expansion choice (chooseExp_&lt;x&gt;,
+ * setupBaseGameMode[_confirm]), alternate modes / homebrew menus (offerGameOptionButtons, getHomebrewButtons,
+ * offerTEOptionButtons, startTFGame, frankenSetup, setupHomebrew_…), starting a draft (miltySetup, startDraftSystem)
+ * and the Milty settings pages (jmf&lt;N|A|…&gt;_&lt;menu&gt;_&lt;item&gt;: navigate / act). Any seated player may press
+ * (table). value: {setting: which control family ("expansion"|"base_game"|"game_modes"|"draft_start"|"draft_settings"),
+ * choice: the specific item (expansion id, menu path, "milty", "startMilty", …)}.
+ */
+public class GameSettingsKind implements KindSpec {
+    private static final Pattern MODES = Pattern.compile(
+            "offerGameOptionButtons|getHomebrewButtons|offerTEOptionButtons|startTFGame|frankenSetup|setupHomebrewNone|setupHomebrew_.*");
+    private static final Pattern JMF = Pattern.compile("jmf[A-Za-z]_.*");
+
+    @Override
+    public String kind() {
+        return "setup.game_settings";
+    }
+
+    @Override
+    public int priority() {
+        return 30;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return handlerId.startsWith("chooseExp_")
+                || handlerId.startsWith("setupBaseGameMode")
+                || "miltySetup".equals(handlerId)
+                || "startDraftSystem".equals(handlerId)
+                || MODES.matcher(handlerId).matches()
+                || JMF.matcher(handlerId).matches();
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        if (!matches(handlerId)) return null;
+        if (handlerId.startsWith("chooseExp_"))
+            return v("expansion", handlerId.substring("chooseExp_".length()));
+        if (handlerId.startsWith("setupBaseGameMode"))
+            return v("base_game", handlerId.endsWith("_confirm") ? "confirm" : "ask");
+        if ("miltySetup".equals(handlerId)) return v("draft_start", "milty");
+        if ("startDraftSystem".equals(handlerId)) return v("draft_start", "draft_system");
+        if (JMF.matcher(handlerId).matches()) return v("draft_settings", handlerId.substring(5));
+        return v("game_modes", handlerId);
+    }
+
+    private static Map<String, Object> v(String setting, String choice) {
+        return SetupKindSupport.map("setting", setting, "choice", choice);
+    }
+
+    @Override
+    public Target target(CaptureContext ctx, Target resolved) {
+        return "cards_thread".equals(resolved == null ? null : resolved.resolvedBy())
+                ? SetupKindSupport.refresh(ctx, resolved)
+                : null;
+    }
+
+    @Override
+    public boolean dynamic() {
+        return true;
+    }
+
+    /** Past setup this prompt is a leftover nobody needs (live: hundreds open across games, flooding the web queue). */
+    @Override
+    public boolean obsolete(CaptureContext ctx) {
+        return ti4.selfhost.engine.SetupStateBuilder.pastSetup(ctx.game());
+    }
+}
