+/**
+ * JDA-shaped view of an {@link EngineInteraction}, so unmodified handlers (which take {@code ButtonInteractionEvent}
+ * etc.) run for an engine answer. The JDA event classes are public API with public constructors taking an interaction
+ * <em>interface</em>; we pass a {@link Proxy} of that interface whose methods map onto the EngineInteraction:
+ *
+ * <ul>
+ *   <li>identity / context (user, member, guild, channel, message, component, values) — read from the engine;
+ *   <li>token operations (reply, deferEdit, editMessage, getHook().sendMessage / editOriginal / deleteOriginal,
+ *       replyModal) — {@link NativeAction}s that call EngineInteraction ops;
+ *   <li>everything else — the interface's default method, which is built on the above.
+ * </ul>
+ *
+ * Nothing here touches JDA internals ({@code JDAImpl}, {@code *InteractionImpl}) or needs the shim to mint a payload.
+ * {@link NativeCoverage} statically checks which handlers only use what this view supports.
+ */
+public final class NativeEvents {
+    private NativeEvents() {}
+
+    public static ButtonInteractionEvent button(EngineInteraction ix) {
+        return new ButtonInteractionEvent(JdaService.jda, -1, view(ButtonInteraction.class, ix));
+    }
+
+    public static StringSelectInteractionEvent select(EngineInteraction ix) {
+        return new StringSelectInteractionEvent(JdaService.jda, -1, view(StringSelectInteraction.class, ix));
+    }
+
+    public static ModalInteractionEvent modal(EngineInteraction ix) {
+        return new ModalInteractionEvent(JdaService.jda, -1, view(ModalInteraction.class, ix));
+    }
+
+    /** The EngineInteraction behind an event (or interaction) if it is an engine answer, else null. */
+    @Nullable
+    public static EngineInteraction engineInteraction(@Nullable Object eventOrInteraction) {
+        Object i = eventOrInteraction instanceof GenericInteractionCreateEvent e ? e.getInteraction() : eventOrInteraction;
+        if (i != null && Proxy.isProxyClass(i.getClass()) && Proxy.getInvocationHandler(i) instanceof View v) return v.ix;
+        return null;
+    }
+
+    static <T> T view(Class<T> iface, EngineInteraction ix) {
+        View v = new View(ix);
+        T proxy = iface.cast(Proxy.newProxyInstance(NativeEvents.class.getClassLoader(), new Class<?>[] {iface}, v));
+        v.self = proxy;
+        return proxy;
+    }
+
+    // ------------------------------------------------------------------ the interaction
+
+    private static final class View implements InvocationHandler {
+        final EngineInteraction ix;
+        Object self;
+        InteractionHook hook;
+
