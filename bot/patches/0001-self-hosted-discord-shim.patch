@@ -0,0 +1,49 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * Discard a secret objective (setup: "keep one of two" = discard the other). discardSecret_&lt;n&gt;[redraw] /
+ * SODISCARD_&lt;n&gt; where n is the player's numeric handle for the card (Player.getSecrets()).
+ */
+public class SecretObjectiveDiscardKind implements KindSpec {
+
+    @Override
+    public String kind() {
+        return "secret_objective.discard";
+    }
+
+    @Override
+    public int priority() {
+        return 50;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return handlerId.startsWith("discardSecret_") || handlerId.startsWith("SODISCARD_");
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        if (!matches(handlerId)) return null;
+        String rest = handlerId.replace("discardSecret_", "").replace("SODISCARD_", "");
+        boolean redraw = rest.endsWith("redraw");
+        rest = rest.replace("redraw", "");
+        Map<String, Object> v = new LinkedHashMap<>();
+        try {
+            int handle = Integer.parseInt(rest);
+            v.put("handle", handle);
+            if (ctx.player() != null) {
+                for (Map.Entry<String, Integer> e : ctx.player().getSecrets().entrySet()) {
+                    if (e.getValue() == handle) v.put("secretObjective", e.getKey());
+                }
+            }
+        } catch (NumberFormatException e) {
+            return null;
+        }
+        v.put("redraw", redraw);
+        return v;
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/SetupKindSupport.java b/src/main/java/ti4/selfhost/engine/kinds/SetupKindSupport.java
new file mode 100644
index 0000000..f89d2c3
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/SetupKindSupport.java
@@ -0,0 +1,47 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+import javax.annotation.Nullable;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.selfhost.engine.EngineModels.Decision;
+import ti4.selfhost.engine.EngineModels.Option;
+import ti4.selfhost.engine.EngineModels.Target;
+
+/** Small helpers shared by the setup / draft kinds (not a kind itself). */
+final class SetupKindSupport {
+    private SetupKindSupport() {}
+
+    /** The handler id of the answered option (custom id without owner prefix), or "" if unknown. */
+    static String handlerOf(Decision d, String optionId) {
+        for (Option o : d.options()) if (o.id().equals(optionId)) return o.handler() == null ? "" : o.handler();
+        return "";
+    }
+
+    /** Insertion-ordered map that, unlike Map.of, accepts null values. */
+    static Map<String, Object> map(Object... kv) {
+        Map<String, Object> m = new LinkedHashMap<>();
+        for (int i = 0; i + 1 < kv.length; i += 2) m.put((String) kv[i], kv[i + 1]);
+        return m;
+    }
+
+    /**
+     * The resolved target with faction / colour re-read from the game: they are picked during setup, so a target
+     * captured earlier has faction null (setup kinds are dynamic() and call this on every state change).
+     */
+    @Nullable
+    static Target refresh(ti4.selfhost.engine.KindSpec.CaptureContext ctx, @Nullable Target resolved) {
+        if (resolved == null || resolved.userId() == null) return resolved;
+        Player p = ctx.game().getPlayer(resolved.userId());
+        return p == null ? resolved : ti4.selfhost.engine.DecisionCapture.target(p, resolved.resolvedBy());
+    }
+
+    @Nullable
+    static Target targetOf(Game game, @Nullable String userId, String how) {
+        Player p = userId == null ? null : game.getPlayer(userId);
+        if (p == null) return null;
+        String f = p.getFaction();
+        return new Target(p.getUserID(), f == null || "null".equals(f) ? null : f, p.getColor(), how);
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/SetupPreferenceKind.java b/src/main/java/ti4/selfhost/engine/kinds/SetupPreferenceKind.java
