+package ti4.selfhost.engine.kinds;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+import ti4.game.Planet;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * Ready exhausted planets: refresh_&lt;planet&gt; (one button per exhausted planet; each press readies one and removes its
+ * button) and the Diplomacy "Done Readying Planets" (deleteButtons_diplomacy). Diplomacy (primary and secondary)
+ * readies up to 2: value.limit on the done option. value: {planet, resources, influence} | {done:true, source, limit}.
+ */
+public class PlanetReadyKind implements KindSpec {
+
+    @Override
+    public String kind() {
+        return "planet.ready";
+    }
+
+    @Override
+    public int priority() {
+        return 40;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return handlerId.matches("refresh_[^_]+") || "deleteButtons_diplomacy".equals(handlerId);
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        Map<String, Object> v = new LinkedHashMap<>();
+        if ("deleteButtons_diplomacy".equals(handlerId)) {
+            v.put("done", true);
+            v.put("source", "diplomacy");
+            v.put("limit", 2);
+            return v;
+        }
+        String planet = handlerId.substring("refresh_".length());
+        Planet p = ctx.game().getUnitHolderFromPlanet(planet);
+        v.put("planet", planet);
+        v.put("resources", p == null ? 0 : p.getResources());
+        v.put("influence", p == null ? 0 : p.getInfluence());
+        return v;
+    }
+
+    @Override
+    public String scope(CaptureContext ctx) {
+        return "player";
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/PlayerSetupKind.java b/src/main/java/ti4/selfhost/engine/kinds/PlayerSetupKind.java
new file mode 100644
index 0000000..0cebb2a
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/PlayerSetupKind.java
@@ -0,0 +1,98 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.Map;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * Manual player setup (instead of a draft): startPlayerSetup → setupStep1_&lt;uid&gt; (which user) → setupStep2_
+ * &lt;uid&gt;_&lt;faction&gt; (faction; "&lt;n&gt;!" pages) → setupStep3_&lt;uid&gt;_&lt;faction&gt;_&lt;color&gt; (colour)
+ * → setupStep4_…_&lt;pos&gt; (home system) → setupStep5_…_&lt;yes|no&gt; (speaker). The Keleres flavour step after a
+ * draft is {@link KeleresFlavorKind} (higher priority).
+ *
+ * <p>value: {step: "start"|"user"|"faction"|"color"|"home"|"speaker", userId, faction, color, position, speaker,
+ * page} — fields not yet known are null; page is the paging marker for "Get More …" buttons (then the step's own
+ * value is null).
+ */
+public class PlayerSetupKind implements KindSpec {
+
+    @Override
+    public String kind() {
+        return "setup.player";
+    }
+
+    @Override
+    public int priority() {
+        return 60;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return "startPlayerSetup".equals(handlerId) || handlerId.matches("setupStep[1-5]_.*");
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        if ("startPlayerSetup".equals(handlerId)) return v("start", null, null, null, null, null, null);
+        if (!matches(handlerId)) return null;
+        int step = handlerId.charAt("setupStep".length()) - '0';
+        String[] t = handlerId.split("_");
+        String uid = part(t, 1);
+        String faction = step >= 2 ? part(t, 2) : null;
+        String color = step >= 3 ? part(t, 3) : null;
+        String pos = step >= 4 ? part(t, 4) : null;
+        String page = null;
+        if (step == 2 && faction != null && faction.endsWith("!")) {
+            page = faction;
+            faction = null;
+        }
+        if (step == 3 && color != null && color.endsWith("!")) {
+            page = color;
+            color = null;
+        }
+        if ("null".equals(color)) color = null;
+        Boolean speaker = step == 5 ? "yes".equalsIgnoreCase(part(t, 5)) : null;
+        String name =
+                switch (step) {
+                    case 1 -> "user";
+                    case 2 -> "faction";
+                    case 3 -> "color";
+                    case 4 -> "home";
+                    default -> "speaker";
+                };
+        return v(name, uid, faction, color, pos, speaker, page);
+    }
+
+    private static Map<String, Object> v(
+            String step, String uid, String faction, String color, String pos, Boolean speaker, String page) {
+        return SetupKindSupport.map(
+                "step", step,
+                "userId", uid,
+                "faction", faction,
+                "color", color,
+                "position", pos,
+                "speaker", speaker,
+                "page", page);
+    }
+
+    private static String part(String[] t, int i) {
+        return t.length > i ? t[i] : null;
+    }
+
+    /** Setup: faction / colour are picked after capture; re-resolve the target on every state change. */
+    @Override
+    public boolean dynamic() {
+        return true;
+    }
+
+    @Override
+    public ti4.selfhost.engine.EngineModels.Target target(
+            CaptureContext ctx, ti4.selfhost.engine.EngineModels.Target resolved) {
+        return SetupKindSupport.refresh(ctx, resolved);
+    }
+
+    /** Past setup this prompt is a leftover nobody needs (live: hundreds open across games, flooding the web queue). */
+    @Override
+    public boolean obsolete(CaptureContext ctx) {
+        return ti4.selfhost.engine.SetupStateBuilder.pastSetup(ctx.game());
+    }
+}
