+import java.util.List;
+
+/**
+ * Titans of Ul (PoK): Terragenesis / Awaken sleepers, Ouranos (flagship), Terraform (PN), Hecatoncheires
+ * (mech via Construction), Ul the Progenitor (hero, Geoform). Handler ids: docs/engine-catalog.json.
+ */
+public class FactionStepsTitans extends FactionStepsRegexPok {
+    @Override
+    protected List<R> rules() {
+        return List.of(
+                // Terragenesis: after exploring one of your planets, place a sleeper token there.
+                ability("putSleeperOnPlanet_(?<planet>.+)", "ability", "terragenesis", "titans", "putSleeperOnPlanet", "use", true),
+                // More than 5 sleepers on the board: remove one (forced).
+                ability("removeSleeperFromPlanet_(?<planet>.+)", "ability", "terragenesis", "titans", "removeSleeperFromPlanet", "target", false),
+                // Awaken: on activation, replace a sleeper with 1 PDS or 1 mech + 1 infantry.
+                ability("replaceSleeperWith_(?<unit>pds|mech)_(?<planet>.+)", "ability", "awaken", "titans", "replaceSleeperWith", "use", true),
+                // Ouranos: replace a PDS in the active system with the flagship.
+                ability("replacePDSWithFS_(?<planet>.+)", "flagship", "titans_flagship", "titans", "replacePDSWithFS", "use", true),
+                // Terraform (Titans PN, played by its holder): the planet to attach it to.
+                ability("terraformPlanet_(?<planet>.+)", "promissory", "terraform", null, "terraformPlanet", "target", false),
+                // Hecatoncheires via Construction: DEPLOY 1 mech + 1 infantry on a planet.
+                ability("titansConstructionMechDeployStep2_(?<planet>.+)", "mech", "titans_mech", "titans", "titansConstructionMechDeployStep2", "target", false),
+                // Ul the Progenitor (hero): attach Geoform.
+                leader("titansHeroPlanet_(?<planet>.+)", "titanshero", "titansHeroPlanet", "target", false));
+    }
+}
