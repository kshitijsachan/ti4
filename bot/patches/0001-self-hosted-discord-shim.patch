diff --git a/src/main/java/ti4/selfhost/engine/kinds/ExploreLog.java b/src/main/java/ti4/selfhost/engine/kinds/ExploreLog.java
new file mode 100644
index 0000000..9fc5830
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/ExploreLog.java
@@ -0,0 +1,119 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+import javax.annotation.Nullable;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.game.Tile;
+import ti4.image.Mapper;
+import ti4.model.ExploreModel;
+import ti4.model.PlanetModel;
+import ti4.model.RelicModel;
+import ti4.selfhost.engine.EngineModels.ExploreEvent;
+
+/**
+ * The last few exploration results and relic draws, so clients can show "what was just explored" from state instead
+ * of from chat. Kept in a game stored value: it is saved with the game and rolled back by undo like everything else.
+ * Called from two one-line hooks (ExploreService.resolveExplore, RelicHelper.drawRelicAndNotify); never throws.
+ */
+public final class ExploreLog {
+    private ExploreLog() {}
+
+    static final String KEY = "engineExploreLog";
+    private static final int MAX = 15;
+
+    public static void explored(Game game, Player player, String cardId, @Nullable String planet, @Nullable Tile tile) {
+        String pos = tile != null ? tile.getPosition() : null;
+        if (pos == null && planet != null) {
+            Tile t = game.getTileFromPlanet(planet);
+            pos = t == null ? null : t.getPosition();
+        }
+        add(game, player, "explore", cardId, planet, pos);
+    }
+
+    public static void relicDrawn(Game game, Player player, String relicId) {
+        add(game, player, "relic", relicId, null, null);
+    }
+
+    private static void add(Game game, Player player, String type, String id, String planet, String tile) {
+        try {
+            if (game == null || player == null || id == null) return;
+            String entry = String.join(
+                    "|",
+                    String.valueOf(game.getRound()),
+                    nz(player.getUserID()),
+                    nz(player.getFaction()),
+                    type,
+                    id.replace("extra1", "").replace("extra2", ""),
+                    nz(planet),
+                    nz(tile),
+                    String.valueOf(System.currentTimeMillis()));
+            List<String> all = entries(game);
+            all.add(entry);
+            while (all.size() > MAX) all.removeFirst();
+            game.setStoredValue(KEY, String.join(";", all));
+        } catch (Exception ignored) {
+            // display aid only
+        }
+    }
+
+    private static List<String> entries(Game game) {
+        String raw = game.getStoredValue(KEY);
+        if (raw == null || raw.isBlank()) return new ArrayList<>();
+        return new ArrayList<>(Arrays.asList(raw.split(";")));
+    }
+
+    /** Oldest first. In fog of war only the viewer's own entries. */
+    public static List<ExploreEvent> recent(Game game, @Nullable String viewerUserId) {
+        List<ExploreEvent> out = new ArrayList<>();
+        try {
+            for (String e : entries(game)) {
+                String[] f = e.split("\\|", -1);
+                if (f.length < 8) continue;
+                if (game.isFowMode() && (viewerUserId == null || !viewerUserId.equals(f[1]))) continue;
+                String type = f[3], id = f[4];
+                String name = null, trait = null, resolution = null, text = null;
+                if ("explore".equals(type)) {
+                    ExploreModel m = Mapper.getExplore(id);
+                    if (m != null) {
+                        name = m.getName();
+                        trait = m.getType() == null ? null : m.getType().toLowerCase();
+                        resolution = m.getResolution() == null ? null : m.getResolution().toLowerCase();
+                        text = m.getText();
+                    }
+                } else {
+                    RelicModel m = Mapper.getRelic(id);
+                    if (m != null) {
+                        name = m.getName();
+                        text = m.getText();
+                    }
+                }
+                String planet = f[5].isEmpty() ? null : f[5];
+                PlanetModel pm = planet == null ? null : Mapper.getPlanet(planet);
+                out.add(new ExploreEvent(
+                        Integer.parseInt(f[0]),
+                        f[1],
+                        f[2].isEmpty() ? null : f[2],
+                        type,
+                        id,
+                        name,
+                        trait,
+                        resolution,
+                        text,
+                        planet,
+                        pm == null ? planet : pm.getName(),
+                        f[6].isEmpty() ? null : f[6],
+                        Long.parseLong(f[7])));
+            }
+        } catch (Exception ignored) {
+            // malformed entry: show what parsed
+        }
+        return out;
+    }
+
+    private static String nz(String s) {
+        return s == null ? "" : s.replace("|", "").replace(";", "");
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/ExploreOutcomeKind.java b/src/main/java/ti4/selfhost/engine/kinds/ExploreOutcomeKind.java
new file mode 100644
index 0000000..720191b
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/ExploreOutcomeKind.java
@@ -0,0 +1,178 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+import ti4.selfhost.engine.EngineModels.Target;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * How to resolve an exploration card that offers a choice (ExploreService.resolveExplore and the abilities that
+ * replace an explore). One message = one card; every option is typed:
+ *
+ * <pre>
+ * decline_explore                                   {effect:"decline"}
+ * resolve{Expedition,CoreMine,Volatile}{Mech,Inf}_P {card, effect: ready_planet | gain_trade_good | gain_command_token, cost, planet}
+ * resolveScorchedDepot_{Mech,Inf}_P                 {card:"scorcheddepot", effect:"remove_command_token", cost, planet}
+ * resolveRuins{Mech,Inf}_P_{mech,2inf}              {card:"warforgeruins", effect:"place_units", units, cost, planet}
+ * resolveSeedySpace{Mech,Inf}_{agentId|AC}_P        {card:"seedyspaceport", effect: ready_agent | draw_action_card, leader, cost, planet}
+ * resolveImmediateAssembly{Mech,Inf}_P_{production|mech}  {card:"immediateassembly", effect: produce | place_units, cost, planet}
+ * freelancersBuild_P                                {card:"freelancers", effect:"produce", planet}
+ * resolveLocalFab_P                                 {card:"localfabricators", effect:"place_mech", cost:"commodity_or_tg", planet}
+ * comm_for_AC                                       {card:"functioningbase", effect:"draw_action_card", cost:"commodity_or_tg"}
+ * mallice_convert_comm / resolveHarness             {card:"merchantstation", effect: convert_commodities | replenish_commodities}
+ * addIonStorm_{alpha,beta}_T                        {card:"ionstorm", effect:"place_ion_storm", side, tile}
+ * deep_mining_accept / deep_mining_decline_P_trait  {effect: gain_trade_good_instead | explore, planet, trait}  (Deep Mining)
+ * distant_suns_{accept,decline}_P_trait             {effect: draw_two_choose_one | explore, planet, trait} (Distant Suns)
+ * </pre>
+ *
+ * cost: "mech_present" (a mech of yours is on the planet; nothing is lost), "remove_infantry" (remove 1 of your
+ * infantry there), "commodity_or_tg" (spend 1 commodity, else 1 trade good).
+ *
+ * <p>Generic commodity buttons on the same message (gain_1_comms, gain_2_comms, convert_2_comms: Functioning Base,
+ * Abandoned Warehouses, Local Fabricators) are typed too ({effect:"gain_commodities"|"convert_commodities",
+ * amount}) but do not by themselves make a message an explore outcome (they are used by many other abilities).
+ */
+public class ExploreOutcomeKind implements KindSpec {
+
+    private static final Pattern UNIT_COST =
+            Pattern.compile("resolve(Expedition|CoreMine|Volatile)(Mech|Inf)_(.+)");
+    private static final Pattern DEPOT = Pattern.compile("resolveScorchedDepot_(Mech|Inf)_(.+)");
+    private static final Pattern RUINS = Pattern.compile("resolveRuins(Mech|Inf)_(.+)_(mech|2inf)");
+    private static final Pattern SEEDY = Pattern.compile("resolveSeedySpace(Mech|Inf)_(.+?)_(.+)");
+    private static final Pattern ASSEMBLY = Pattern.compile("resolveImmediateAssembly(Mech|Inf)_(.+)_(production|mech)");
+    private static final Pattern ION = Pattern.compile("addIonStorm_(alpha|beta)_(.+)");
+    private static final Pattern ABILITY = Pattern.compile("(deep_mining|distant_suns)_(accept|decline)(?:_(.+)_([a-z]+))?");
+    private static final Pattern GENERIC = Pattern.compile("(gain|convert)_(\\d)_comms");
+
+    @Override
+    public String kind() {
+        return "explore.outcome";
+    }
+
+    @Override
+    public int priority() {
+        return 60;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return handlerId.equals("decline_explore")
+                || UNIT_COST.matcher(handlerId).matches()
+                || DEPOT.matcher(handlerId).matches()
+                || RUINS.matcher(handlerId).matches()
+                || SEEDY.matcher(handlerId).matches()
+                || ASSEMBLY.matcher(handlerId).matches()
+                || handlerId.startsWith("freelancersBuild_")
+                || handlerId.startsWith("resolveLocalFab_")
+                || handlerId.equals("comm_for_AC")
+                || handlerId.equals("mallice_convert_comm")
+                || handlerId.equals("resolveHarness")
+                || ION.matcher(handlerId).matches()
+                || ABILITY.matcher(handlerId).matches();
+    }
+
+    @Override
+    public boolean typesOption(String handlerId) {
+        return matches(handlerId) || GENERIC.matcher(handlerId).matches();
+    }
+
+    @Override
+    public Map<String, Object> value(String h, CaptureContext ctx) {
+        Map<String, Object> v = new LinkedHashMap<>();
+        Matcher m;
+        if (h.equals("decline_explore")) {
+            v.put("effect", "decline");
+        } else if ((m = UNIT_COST.matcher(h)).matches()) {
+            switch (m.group(1)) {
+                case "Expedition" -> {
+                    v.put("card", "expedition");
+                    v.put("effect", "ready_planet");
+                }
+                case "CoreMine" -> {
+                    v.put("card", "coremine");
+                    v.put("effect", "gain_trade_good");
+                }
+                default -> {
+                    v.put("card", "volatilefuelsource");
+                    v.put("effect", "gain_command_token");
+                }
+            }
+            v.put("cost", cost(m.group(2)));
+            ExploreSupport.putPlanet(v, ctx.game(), m.group(3));
+        } else if ((m = DEPOT.matcher(h)).matches()) {
+            v.put("card", "scorcheddepot");
+            v.put("effect", "remove_command_token");
+            v.put("cost", cost(m.group(1)));
+            ExploreSupport.putPlanet(v, ctx.game(), m.group(2));
+        } else if ((m = RUINS.matcher(h)).matches()) {
+            v.put("card", "warforgeruins");
+            v.put("effect", "place_units");
+            v.put("units", "mech".equals(m.group(3)) ? "1 mech" : "2 infantry");
+            v.put("cost", cost(m.group(1)));
+            ExploreSupport.putPlanet(v, ctx.game(), m.group(2));
+        } else if ((m = SEEDY.matcher(h)).matches()) {
+            v.put("card", "seedyspaceport");
+            boolean ac = "AC".equals(m.group(2));
+            v.put("effect", ac ? "draw_action_card" : "ready_agent");
+            v.put("leader", ac ? null : m.group(2));
+            v.put("cost", cost(m.group(1)));
+            ExploreSupport.putPlanet(v, ctx.game(), m.group(3));
+        } else if ((m = ASSEMBLY.matcher(h)).matches()) {
+            v.put("card", "immediateassembly");
+            v.put("effect", "production".equals(m.group(3)) ? "produce" : "place_units");
+            v.put("units", "production".equals(m.group(3)) ? null : "1 mech");
+            v.put("cost", cost(m.group(1)));
+            ExploreSupport.putPlanet(v, ctx.game(), m.group(2));
+        } else if (h.startsWith("freelancersBuild_")) {
+            v.put("card", "freelancers");
+            v.put("effect", "produce");
+            ExploreSupport.putPlanet(v, ctx.game(), h.substring("freelancersBuild_".length()));
+        } else if (h.startsWith("resolveLocalFab_")) {
+            v.put("card", "localfabricators");
+            v.put("effect", "place_mech");
+            v.put("cost", "commodity_or_tg");
+            ExploreSupport.putPlanet(v, ctx.game(), h.split("_")[1]);
+        } else if (h.equals("comm_for_AC")) {
+            v.put("card", "functioningbase");
+            v.put("effect", "draw_action_card");
+            v.put("cost", "commodity_or_tg");
+        } else if (h.equals("mallice_convert_comm")) {
+            v.put("card", "merchantstation");
+            v.put("effect", "convert_commodities");
+        } else if (h.equals("resolveHarness")) {
+            v.put("card", "merchantstation");
+            v.put("effect", "replenish_commodities");
+        } else if ((m = ION.matcher(h)).matches()) {
+            v.put("card", "ionstorm");
+            v.put("effect", "place_ion_storm");
+            v.put("side", m.group(1));
+            v.put("tile", m.group(2));
+        } else if ((m = ABILITY.matcher(h)).matches()) {
+            boolean accept = "accept".equals(m.group(2));
+            boolean deep = "deep_mining".equals(m.group(1));
+            v.put("ability", deep ? "deep_mining" : "distant_suns");
+            v.put("effect", accept ? (deep ? "gain_trade_good_instead" : "draw_two_choose_one") : "explore");
+            if (m.group(3) != null) {
+                ExploreSupport.putPlanet(v, ctx.game(), m.group(3));
+                v.put("trait", m.group(4));
+            }
+        } else if ((m = GENERIC.matcher(h)).matches()) {
+            v.put("effect", "gain".equals(m.group(1)) ? "gain_commodities" : "convert_commodities");
+            v.put("amount", Integer.parseInt(m.group(2)));
+        } else {
+            return null;
+        }
+        return v;
+    }
+
+    private static String cost(String unit) {
+        return "Mech".equalsIgnoreCase(unit) ? "mech_present" : "remove_infantry";
+    }
+
+    @Override
+    public Target target(CaptureContext ctx, Target resolved) {
+        return ExploreSupport.explorer(ctx, resolved);
+    }
+}
