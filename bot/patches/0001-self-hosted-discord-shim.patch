@@ -0,0 +1,66 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+import javax.annotation.Nullable;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.image.Mapper;
+import ti4.model.ActionCardModel;
+
+/** Shared lookups for the action-card / promissory-note kinds (G8). Not a kind itself. */
+final class CardKinds {
+    private CardKinds() {}
+
+    /** The action card id behind a player's numeric hand handle, or null. */
+    @Nullable
+    static String acIdForHandle(@Nullable Player player, int handle) {
+        if (player == null) return null;
+        for (Map.Entry<String, Integer> e : player.getActionCards().entrySet()) {
+            if (e.getValue() == handle) return e.getKey();
+        }
+        return null;
+    }
+
+    /** The player (if any) whose hand holds this action card handle. Handles are unique within a game. */
+    @Nullable
+    static Player holderOfHandle(Game game, int handle) {
+        for (Player p : game.getRealPlayers()) {
+            if (p.getActionCards().containsValue(handle)) return p;
+        }
+        return null;
+    }
+
+    /**
+     * The id of an action card known only by its display name (the sabotage window carries the title): the most
+     * recently discarded card with that name, else any card with that name.
+     */
+    @Nullable
+    static String acIdByName(Game game, String name) {
+        if (name == null) return null;
+        List<String> discard = new ArrayList<>(game.getDiscardActionCards().keySet());
+        for (int i = discard.size() - 1; i >= 0; i--) {
+            ActionCardModel m = Mapper.getActionCard(discard.get(i));
+            if (m != null && name.equalsIgnoreCase(m.getName())) return discard.get(i);
+        }
+        for (ActionCardModel m : Mapper.getActionCards().values()) {
+            if (name.equalsIgnoreCase(m.getName())) return m.getAlias();
+        }
+        return null;
+    }
+
+    @Nullable
+    static String window(@Nullable String acId) {
+        ActionCardModel m = acId == null ? null : Mapper.getActionCard(acId);
+        return m == null ? null : m.getWindow();
+    }
+
+    static int parseInt(String s, int dflt) {
+        try {
+            return Integer.parseInt(s);
+        } catch (NumberFormatException e) {
+            return dflt;
+        }
+    }
+}
