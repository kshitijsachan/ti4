+package ti4.selfhost.engine.kinds;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.selfhost.engine.EngineModels.Decision;
+import ti4.selfhost.engine.KindSpec;
+
+/** Strategy phase: pick a strategy card. Buttons: FFCC_&lt;faction&gt;_scPick_&lt;n&gt; (Helper.getRemainingSCButtons). */
+public class StrategyCardPickKind implements KindSpec {
+
+    @Override
+    public String kind() {
+        return "strategy_card.pick";
+    }
+
+    @Override
+    public int priority() {
+        return 100;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return handlerId.matches("scPick_\\d+");
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        if (!matches(handlerId)) return null;
+        int sc = Integer.parseInt(handlerId.substring("scPick_".length()));
+        Map<String, Object> v = new LinkedHashMap<>();
+        v.put("strategyCard", sc);
+        Integer tg = ctx.game().getScTradeGoods().get(sc);
+        v.put("tradeGoods", tg == null ? 0 : tg);
+        v.put("name", StrategyCards.name(ctx.game(), sc));
+        v.put("card", StrategyCards.automation(ctx.game(), sc));
+        return v;
+    }
+
+    @Override
+    public String validate(Game game, Player answering, Decision decision, String optionId) {
+        Player active = game.getActivePlayer();
+        if (active != null && active != answering) return "It is not your turn to pick a strategy card.";
+        Map<String, Object> v = StrategyCards.optionValue(decision, optionId);
+        if (v != null && v.get("strategyCard") instanceof Number n) {
+            for (Player p : game.getRealPlayers())
+                if (p.getSCs() != null && p.getSCs().contains(n.intValue())) return "That strategy card is already taken.";
+        }
+        return null;
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/StrategyCardQueuePickKind.java b/src/main/java/ti4/selfhost/engine/kinds/StrategyCardQueuePickKind.java
