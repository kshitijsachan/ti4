@@ -0,0 +1,46 @@
+package ti4.selfhost;
+
+import java.util.Map;
+import ti4.game.Game;
+import ti4.game.Planet;
+import ti4.game.Player;
+import ti4.helpers.Helper;
+
+/**
+ * Self-hosted: the end-of-turn / pass "Do an Expedition" offer only when the player can pay for an expedition that is
+ * still open. Upstream offers it every turn regardless, which at a live table is a prompt to wave away each turn.
+ */
+public final class ExpeditionGate {
+    private ExpeditionGate() {}
+
+    public static boolean offer(Player player, Game game) {
+        if (!SelfHosted.isEnabled()) return true;
+        for (Map.Entry<String, String> exp :
+                game.getExpeditions().getExpeditionFactions().entrySet()) {
+            if (exp.getValue() == null && canPay(exp.getKey(), player, game)) return true;
+        }
+        return false;
+    }
+
+    private static boolean canPay(String expedition, Player player, Game game) {
+        int tg = player.getTg();
+        return switch (expedition) {
+            case "techSkip" -> player.getReadiedPlanets().stream().anyMatch(p -> hasSpecialty(p, game));
+            case "tradeGoods" -> tg >= 3;
+            case "fiveRes" -> orZero(Helper.getPlayerResourcesAvailable(player, game)) + tg >= 5;
+            case "fiveInf" -> orZero(Helper.getPlayerInfluenceAvailable(player, game)) + tg >= 5;
+            case "secret" -> !player.getSecretsUnscored().isEmpty();
+            case "actionCards" -> player.getAcCount() >= 2;
+            default -> true;
+        };
+    }
+
+    private static boolean hasSpecialty(String planet, Game game) {
+        Planet p = game.getPlanetsInfo().get(planet);
+        return p != null && !p.getTechSpecialities().isEmpty();
+    }
+
+    private static int orZero(Integer n) {
+        return n == null ? 0 : n;
+    }
+}
diff --git a/src/main/java/ti4/selfhost/SelfHosted.java b/src/main/java/ti4/selfhost/SelfHosted.java
new file mode 100644
index 0000000..ebde53c
--- /dev/null
+++ b/src/main/java/ti4/selfhost/SelfHosted.java
@@ -0,0 +1,45 @@
+package ti4.selfhost;
+
+import java.util.Map;
+import java.util.concurrent.ConcurrentHashMap;
+
+/** True when the bot runs against the ti4 web shim instead of real Discord. */
+public final class SelfHosted {
+    private static final boolean ENABLED = System.getenv("DISCORD_API_BASE") != null;
+
+    private SelfHosted() {}
+
+    public static boolean isEnabled() {
+        return ENABLED;
+    }
+
+    /** Base URL of the shim (DISCORD_API_BASE without the /api/vN suffix), e.g. http://127.0.0.1:8090 */
+    public static String shimBaseUrl() {
+        String api = System.getenv("DISCORD_API_BASE");
+        return api == null ? "" : api.replaceFirst("/api/v\\d+/?$", "");
+    }
+
+    /**
+     * Discord CDN URLs (emoji images, attachments) are served by the shim; relative shim URLs are made absolute.
+     */
+    public static String localizeCdnUrl(String url) {
+        if (url == null || !ENABLED) return url;
+        if (url.startsWith("https://cdn.discordapp.com/")) return shimBaseUrl() + url.substring("https://cdn.discordapp.com".length());
+        if (url.startsWith("https://media.discordapp.net/")) return shimBaseUrl() + url.substring("https://media.discordapp.net".length());
+        if (url.startsWith("/")) return shimBaseUrl() + url;
+        return url;
+    }
+
+    private static final Map<Long, Long> REOPENED = new ConcurrentHashMap<>();
+
+    /** Records that the bot just reopened (unarchived) a thread. */
+    public static void markReopened(long threadId) {
+        REOPENED.put(threadId, System.currentTimeMillis());
+    }
+
+    /** The bot reopened this thread in the last 10 seconds: do not reopen it again. */
+    public static boolean reopenedRecently(long threadId) {
+        Long at = REOPENED.get(threadId);
+        return at != null && System.currentTimeMillis() - at < 10_000;
+    }
+}
diff --git a/src/main/java/ti4/selfhost/ShimRetryInterceptor.java b/src/main/java/ti4/selfhost/ShimRetryInterceptor.java
new file mode 100644
index 0000000..35c108f
--- /dev/null
+++ b/src/main/java/ti4/selfhost/ShimRetryInterceptor.java
@@ -0,0 +1,39 @@
+package ti4.selfhost;
+
+import java.io.IOException;
+import java.net.ConnectException;
+import okhttp3.Interceptor;
+import okhttp3.Response;
+import ti4.logging.BotLogger;
+
+/**
+ * Self-hosted only: the shim restarts on deploys. A REST call that cannot connect at all (nothing was sent, so it is
+ * safe to repeat) is retried with backoff for up to ~60s instead of being dropped, so the game's messages stay in sync.
+ */
+public final class ShimRetryInterceptor implements Interceptor {
+    private static final long MAX_WAIT_MS = 60_000;
+
+    @Override
+    public Response intercept(Chain chain) throws IOException {
+        long start = System.currentTimeMillis();
+        long delay = 250;
+        for (int attempt = 1; ; attempt++) {
+            try {
+                return chain.proceed(chain.request());
+            } catch (ConnectException e) {
+                if (System.currentTimeMillis() - start + delay > MAX_WAIT_MS) throw e;
+                if (attempt == 1) {
+                    BotLogger.info("Shim unreachable (" + e.getMessage() + "); retrying "
+                            + chain.request().method() + " " + chain.request().url().encodedPath());
+                }
+                try {
+                    Thread.sleep(delay);
+                } catch (InterruptedException ie) {
+                    Thread.currentThread().interrupt();
+                    throw e;
+                }
+                delay = Math.min(delay * 2, 4_000);
+            }
+        }
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/ActionInvoker.java b/src/main/java/ti4/selfhost/engine/ActionInvoker.java
new file mode 100644
index 0000000..6d0c8d6
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/ActionInvoker.java
@@ -0,0 +1,138 @@
+package ti4.selfhost.engine;
+
+import java.util.Collections;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.TimeUnit;
+import net.dv8tion.jda.api.events.interaction.component.ButtonInteractionEvent;
+import net.dv8tion.jda.api.utils.data.DataObject;
+import net.dv8tion.jda.internal.JDAImpl;
+import net.dv8tion.jda.internal.interactions.components.buttons.ButtonInteractionImpl;
+import okhttp3.MediaType;
+import okhttp3.OkHttpClient;
+import okhttp3.Request;
+import okhttp3.RequestBody;
+import okhttp3.Response;
+import org.apache.commons.lang3.function.Consumers;
+import ti4.discord.JdaService;
+import ti4.discord.interactions.buttons.ButtonProcessor;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.game.persistence.GameManager;
+import ti4.game.persistence.ManagedGame;
+import ti4.logging.BotLogger;
+import ti4.selfhost.engine.EngineModels.AnswerRequest;
+import ti4.selfhost.engine.EngineModels.AnswerResult;
+import ti4.selfhost.engine.EngineModels.Decision;
+import ti4.selfhost.engine.EngineModels.Option;
+
+/**
+ * "Player P picks option O of decision D". Validates against the decision registry (open, seq, target, option) and
+ * the kind's own check, then runs the option's handler synchronously on this thread through the normal
+ * ButtonProcessor pipeline (game lock, ListenerContext ownership check, save, undo snapshot), using an interaction
+ * the shim mints for the player — no browser, no gateway round trip. Returns after the handler finished, with the
+ * decisions it opened.
+ *
+ * <p>Phase-1 limitation (see ENGINE.md): handlers still take a JDA ButtonInteractionEvent (2,274 of 2,323 handler
+ * methods do), so we synthesise a real one. Select menus and modal buttons are not answerable here yet.
+ */
+public final class ActionInvoker {
+    private static final MediaType JSON = MediaType.get("application/json");
+    private static final Set<String> inFlight = ConcurrentHashMap.newKeySet();
+    private static final Map<String, AnswerResult> byRequestId =
+            Collections.synchronizedMap(new LinkedHashMap<>(256, 0.75f, true) {
+                @Override
+                protected boolean removeEldestEntry(Map.Entry<String, AnswerResult> e) {
+                    return size() > 2000;
+                }
+            });
+
+    private ActionInvoker() {}
+
+    public static AnswerResult answer(String gameName, String decisionId, String userId, AnswerRequest req) {
+        if (req.requestId() != null) {
+            AnswerResult prev = byRequestId.get(userId + ":" + req.requestId());
+            if (prev != null) return prev;
+        }
+        AnswerResult r = doAnswer(gameName, decisionId, userId, req);
+        if (req.requestId() != null && !"busy".equals(r.status()))
+            byRequestId.put(userId + ":" + req.requestId(), r);
+        return r;
+    }
+
+    private static AnswerResult doAnswer(String gameName, String decisionId, String userId, AnswerRequest req) {
+        Decision d = DecisionRegistry.get(decisionId);
+        if (d == null || !d.game().equals(gameName)) return fail("stale", "That decision is no longer open.", decisionId);
+        if (req.expectedSeq() != null && req.expectedSeq() != d.seq())
+            return fail("stale", "That decision changed; re-read it.", decisionId);
+        ManagedGame mg = GameManager.getManagedGame(gameName);
+        Game game = mg == null ? null : mg.getGame();
+        if (game == null) return fail("not_found", "No such game.", decisionId);
+        Player player = game.getPlayer(userId);
+        if (player == null) return fail("forbidden", "You are not a player of this game.", decisionId);
+        if ("player".equals(d.scope()) && d.target() != null && d.target().userId() != null
+                && !d.target().userId().equals(userId))
+            return fail("forbidden", "That decision is for someone else.", decisionId);
+        Option opt = null;
+        for (Option o : d.options()) if (o.id().equals(req.optionId())) opt = o;
+        if (opt == null) return fail("bad_option", "No such option.", decisionId);
+        if (opt.disabled()) return fail("bad_option", "That option is disabled.", decisionId);
+        if (opt.needsInput()) return fail("needs_input", "That option needs input; not supported yet.", decisionId);
+        if (opt.id().contains("#")) return fail("unsupported", "Select menus are not answerable yet.", decisionId);
+        KindSpec spec = DecisionKinds.byKind(d.kind());
+        if (spec != null) {
+            String err = spec.validate(game, player, d, opt.id());
+            if (err != null) return fail("refused", err, decisionId);
+        }
+        if (!inFlight.add(decisionId)) return fail("busy", "An answer to this decision is in progress.", decisionId);
+        long before = DecisionRegistry.currentSeq();
+        try {
+            DataObject interaction = mint(userId, d.source().channelId(), d.source().messageId(), opt.id());
+            JDAImpl jda = (JDAImpl) JdaService.jda;
+            ButtonInteractionEvent event = new ButtonInteractionEvent(jda, -1, new ButtonInteractionImpl(jda, interaction));
+            InteractionTracker.record(event);
+            if (!opt.id().contains("~MDL")) event.deferEdit().queue(Consumers.nop(), BotLogger::catchRestError);
+            ButtonProcessor.processNow(event);
+        } catch (Exception e) {
+            BotLogger.error("engine: answer " + decisionId + " / " + opt.id() + " by " + userId + " failed", e);
+            return fail("error", String.valueOf(e.getMessage()), decisionId);
+        } finally {
+            inFlight.remove(decisionId);
+        }
+        List<Decision> opened = DecisionRegistry.openedAfter(gameName, before);
+        return new AnswerResult(
+                true, "done", null, decisionId, DecisionRegistry.currentSeq(), game.getLastModifiedDate(), opened);
+    }
+
+    private static AnswerResult fail(String status, String error, String decisionId) {
+        return new AnswerResult(false, status, error, decisionId, DecisionRegistry.currentSeq(), 0, List.of());
+    }
+
+    /** Asks the shim to register an interaction for this user on this message; returns the INTERACTION_CREATE d. */
+    static DataObject mint(String userId, String channelId, String messageId, String customId) throws Exception {
+        String base = System.getenv("DISCORD_API_BASE");
+        if (base == null) throw new IllegalStateException("not self-hosted");
+        String token = JdaService.jda.getToken();
+        if (!token.startsWith("Bot ")) token = "Bot " + token;
+        DataObject body = DataObject.empty()
+                .put("user_id", userId)
+                .put("channel_id", channelId)
+                .put("message_id", messageId)
+                .put("custom_id", customId)
+                .put("component_type", 2);
+        OkHttpClient http = JdaService.jda.getHttpClient().newBuilder().callTimeout(10, TimeUnit.SECONDS).build();
+        Request request = new Request.Builder()
+                .url(base.replaceAll("/+$", "") + "/selfhost/interactions")
+                .header("Authorization", token)
+                .post(RequestBody.create(body.toString(), JSON))
+                .build();
+        try (Response res = http.newCall(request).execute()) {
+            String text = res.body() == null ? "" : res.body().string();
+            if (!res.isSuccessful()) throw new IllegalStateException("shim refused interaction: " + res.code() + " " + text);
+            return DataObject.fromJson(text);
+        }
+    }
+}
