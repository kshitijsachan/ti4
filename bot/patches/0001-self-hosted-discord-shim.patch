@@ -0,0 +1,58 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.List;
+import java.util.Map;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * Retreat destination (retreatUnitsFrom_&lt;from&gt;_&lt;to&gt;[skilled]) and, after it, which ground forces follow
+ * (retreatGroundUnits_&lt;from&gt;_&lt;to&gt;_&lt;n&gt;_&lt;unit&gt;_&lt;planet&gt;). Owner = FFCC_.
+ */
+public class CombatRetreatKind implements KindSpec {
+
+    @Override
+    public String kind() {
+        return "combat.retreat";
+    }
+
+    @Override
+    public int priority() {
+        return 100;
+    }
+
+    @Override
+    public boolean classifies(List<String> handlerIds) {
+        for (String h : handlerIds) {
+            if (h != null && (h.startsWith("retreatUnitsFrom_") || h.startsWith("retreatGroundUnits_"))) return true;
+        }
+        return false;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return handlerId.startsWith("retreatUnitsFrom_")
+                || handlerId.startsWith("retreatGroundUnits_")
+                || handlerId.equals("deleteButtons");
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        return CombatSupport.value(handlerId, ctx.game());
+    }
+
+    /**
+     * Airo Shir Aur (Mahact hero): "neither player can retreat" from the space combat it starts (rules audit,
+     * leaders A–M; a deliberate improvement mirrored in RetreatButtonHandler / getRetreatSystemButtons).
+     */
+    @Override
+    public String validate(
+            ti4.game.Game game,
+            ti4.game.Player answering,
+            ti4.selfhost.engine.EngineModels.Decision decision,
+            String optionId) {
+        if (game == null || decision == null) return null;
+        Map<String, Object> v = StrategyCards.optionValue(decision, optionId);
+        if (v == null || !"retreat_to".equals(v.get("action")) || !(v.get("tile") instanceof String tile)) return null;
+        return ti4.service.leader.LeaderRuleChecks.benedictionRetreat(game, tile);
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/CombatRoundKind.java b/src/main/java/ti4/selfhost/engine/kinds/CombatRoundKind.java
new file mode 100644
index 0000000..9288217
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/CombatRoundKind.java
@@ -0,0 +1,148 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.List;
+import java.util.Map;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.selfhost.engine.EngineModels.Decision;
+import ti4.selfhost.engine.EngineModels.ReactionWindow;
+import ti4.selfhost.engine.EngineModels.Target;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * The combat controls the engine posts for both sides: roll buttons (combat round, anti-fighter barrage,
+ * bombardment, space cannon offence/defence), "Decline SPACE CANNON", "Assign Hits" (manual), announce a retreat /
+ * retreat, ready for dice, repair, and the combat action-card window (checkCombatACs; the cards themselves belong to
+ * the action-card kinds). Each combatant answers for themself (the roller is whoever presses), so this is a table
+ * decision with no target; who should roll what comes from GameState.combat (rounds rolled per side, units,
+ * abilities), never from this message. Other ability buttons on the same message stay untyped (value null).
+ */
+public class CombatRoundKind implements KindSpec {
+
+    @Override
+    public String kind() {
+        return "combat.round";
+    }
+
+    @Override
+    public int priority() {
+        return 90;
+    }
+
+    @Override
+    public boolean classifies(List<String> handlerIds) {
+        // A landing prompt carries a bombardment roll too: that message belongs to the landing kind (G3).
+        for (String h : handlerIds) if (h != null && h.startsWith("landUnits_")) return false;
+        for (String h : handlerIds) {
+            if (h == null) continue;
+            if (h.startsWith("combatRoll_")
+                    || h.startsWith("bombardConfirm_combatRoll_")
+                    || h.startsWith("declinePDS_")
+                    || h.equals("checkCombatACs")
+                    || h.equals("announceARetreat")
+                    || h.startsWith("retreat_")
+                    || h.startsWith("getRepairButtons_")) return true;
+        }
+        return false;
+    }
+
+    @Override
+    public boolean matches(String h) {
+        return h.startsWith("combatRoll_")
+                || h.startsWith("bombardConfirm_combatRoll_")
+                || h.startsWith("declinePDS_")
+                || h.equals("checkCombatACs")
+                || h.equals("announceARetreat")
+                || h.startsWith("retreat_")
+                || h.startsWith("getRepairButtons_")
+                || h.startsWith("getDamageButtons_")
+                || h.startsWith("announceReadyForDice_")
+                || h.startsWith("automateGroundCombat_")
+                || h.startsWith("applytempcombatmod__");
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        if (handlerId.startsWith("applytempcombatmod__")) {
+            // Supercharge (and other temporary modifiers) offered on the controls: applies to the presser's next roll.
+            Map<String, Object> mod = CombatModifierKind.value(handlerId);
+            if (mod == null) return null;
+            Map<String, Object> v = new java.util.LinkedHashMap<>();
+            v.put("action", "temp_mod");
+            String a = ctx.game() == null ? null : ctx.game().getActiveSystem();
+            v.put("tile", a == null || a.isBlank() ? null : a);
+            v.putAll(mod);
+            return v;
+        }
+        Map<String, Object> v = CombatSupport.value(handlerId, ctx.game());
+        if (v != null && "roll".equals(v.get("action"))) CombatSupport.noteRollMessage(ctx.messageId(), v);
+        return v;
+    }
+
+    /**
+     * Who rolls here and who already did, from engine state: for a combat round, both combatants, "responded" = the
+     * side that has rolled more rounds than the other (waiting for its opponent); for anti-fighter barrage / space
+     * cannon offence, the players who can fire, "responded" = those whose roll the engine recorded since the prompt.
+     */
+    @Override
+    public ReactionWindow window(CaptureContext ctx) {
+        return CombatSupport.rollWindow(ctx.game(), ctx.messageId());
+    }
+
+    /**
+     * The window only advises (autopilots read eligible/responded); it never gates a player who has units there. The original buttons accept a press
+     * from anyone at the table at any time: a combatant without ANTI-FIGHTER BARRAGE units rolling barrage, the same
+     * side rolling again, a player rolling space cannon from a prompt opened for someone else (pbd60 168-195).
+     */
+    @Override
+    public boolean answersOutsideWindow(Game game, Player answering, Decision decision) {
+        // ...but only for a player with units in that system: with two combats at once, the other combat's prompt is
+        // not theirs (pbd203: the human's "roll" went to 314's prompt).
+        Object tile = decision.window() == null ? null : decision.window().subject().get("tile");
+        if (tile == null) return true;
+        return CombatSupport.hasUnitsIn(answering, game.getTileByPosition(String.valueOf(tile)));
+    }
+
+    /** A combat round may not be rolled while hits are owed there or before anti-fighter barrage (pbd203). */
+    @Override
+    public String validate(Game game, Player answering, Decision decision, String optionId) {
+        String h = optionId == null ? null : ti4.discord.interactions.routing.ComponentIdEnvelope.decode(optionId).handlerId();
+        String why = CombatSupport.rollBlocked(game, h);
+        if (why != null) return "Not yet: " + why + ".";
+        // Rules audit (factions): L4 Disruptors / the Argent flagship forbid these SPACE CANNON rolls.
+        String forbidden = ti4.service.combat.SpaceCannonRestrictions.blocked(game, answering, h);
+        if (forbidden == null) {
+            String shielded = ti4.service.combat.PlanetaryShieldRules.rollRefusal(game, answering, h);
+            if (shielded != null) forbidden = "no planet can be bombarded (" + shielded + ")";
+        }
+        return forbidden == null ? null : "You cannot roll that: " + forbidden + ".";
+    }
+
+    /** A roll prompt whose fights are all over (see CombatSupport.combatPromptOver) closes. */
+    @Override
+    public boolean obsolete(CaptureContext ctx) {
+        List<String> ids = ctx.handlerIds();
+        if (ids == null && ctx.messageId() != null) {
+            String id = ti4.selfhost.engine.DecisionRegistry.decisionIdForMessage(ctx.messageId());
+            Decision d = id == null ? null : ti4.selfhost.engine.DecisionRegistry.get(id);
+            if (d != null) ids = d.options().stream()
+                    .map(o -> ti4.discord.interactions.routing.ComponentIdEnvelope.decode(o.id().split("#")[0]).handlerId())
+                    .toList();
+        }
+        return CombatSupport.combatPromptOver(ctx.game(), ids);
+    }
+
+    @Override
+    public boolean dynamic() {
+        return true;
+    }
+
+    /**
+     * Both combatants (and, for space cannon, anyone in range) answer here: never "the one mentioned player", nor the
+     * owner of the one faction ability that happens to sit on the same message (e.g. Supercharge).
+     */
+    @Override
+    public Target target(CaptureContext ctx, Target resolved) {
+        return new Target(null, null, null, "none");
+    }
+}
