@@ -0,0 +1,71 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.selfhost.engine.EngineModels.Decision;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * Ahead-of-time agenda choices in the cards-info thread: pre-pass on shenanigans (Bribery, Deadly Plot, Legal Texts),
+ * pass on all whens/afters for the phase, pre-vote / pre-abstain / erase a pre-vote. "Decline" (deleteButtons) has
+ * value null. A pre-vote prompt takes the same structured answer as agenda.vote ({outcome, planets[], ...}).
+ */
+public class AgendaPreassignKind implements KindSpec {
+
+    @Override
+    public String kind() {
+        return "agenda.preassign";
+    }
+
+    @Override
+    public int priority() {
+        return 95;
+    }
+
+    @Override
+    public boolean matches(String h) {
+        return h.equals("resolvePreassignment_Pass On Shenanigans")
+                || h.equals("resolvePreassignment_Abstain On Agenda")
+                || h.equals("preVote")
+                || h.equals("erasePreVote")
+                || h.equals("passOnEverythingWhensNAfters")
+                || h.equals("undoPassOnAllWhensNAfters");
+    }
+
+    @Override
+    public Map<String, Object> value(String h, CaptureContext ctx) {
+        Map<String, Object> v = new LinkedHashMap<>();
+        switch (h) {
+            case "resolvePreassignment_Pass On Shenanigans" -> v.put("preset", "pass_shenanigans");
+            case "resolvePreassignment_Abstain On Agenda" -> v.put("preset", "abstain");
+            case "preVote" -> {
+                v.put("preset", "prevote");
+                v.putAll(AgendaVoteKind.ballot(ctx.game(), ctx.player()));
+            }
+            case "erasePreVote" -> v.put("preset", "erase_prevote");
+            case "passOnEverythingWhensNAfters" -> v.put("preset", "pass_whens_afters");
+            case "undoPassOnAllWhensNAfters" -> v.put("preset", "undo_pass_whens_afters");
+            default -> {
+                return null;
+            }
+        }
+        return v;
+    }
+
+    @Override
+    public boolean acceptsPayload() {
+        return true;
+    }
+
+    @Override
+    public String answerPayload(PayloadAnswer steps, Map<String, Object> payload) throws Exception {
+        Game game = steps.game();
+        Player answering = steps.player();
+        Decision d = steps.decision();
+        if (game == null || answering == null || d == null) return "That decision is no longer open.";
+        if (AgendaVoteKind.option(d, "preVote"::equals) == null) return "This prompt does not offer a pre-vote.";
+        return AgendaVoteKind.castVote(game, answering, d, "preVote", payload, steps);
+    }
+}
