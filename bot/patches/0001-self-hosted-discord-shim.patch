+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+import ti4.spring.api.selfhost.UndoModels.RewindRequest;
+import ti4.spring.api.selfhost.UndoModels.RewindResponse;
+import ti4.spring.api.selfhost.UndoModels.UndoPointsResponse;
+import ti4.spring.api.selfhost.UndoModels.UndoRequest;
+import ti4.spring.context.RequestContext;
+import ti4.spring.context.SetupRequestContext;
+
+/**
+ * Undo / rewind for the self-hosted web client. Auth: {@code Authorization: Bearer <seat token>}; the caller must
+ * be a player in the game.
+ * <ul>
+ *   <li>{@code GET  /api/game/{gameName}/undo-points} — saved states, newest first, plus the roll-back journal</li>
+ *   <li>{@code POST /api/game/{gameName}/rewind {index}} — restore save {@code index}; announced, and undoable</li>
+ *   <li>{@code POST /api/game/{gameName}/undo {force?}} — one step back, like the UNDO button</li>
+ * </ul>
+ * The mutations do their own locking and saving ({@code @SetupRequestContext(false)}): the request-context save
+ * would otherwise write the stale pre-undo game back over the restored one.
+ */
+@RestController
+@RequiredArgsConstructor
+@RequestMapping("/api/game/{gameName}")
+public class UndoController {
+
+    private final UndoService undoService;
+
+    @GetMapping("/undo-points")
+    @SetupRequestContext(false)
+    @PreAuthorize("@security.canAccessGame(#gameName)")
+    public ResponseEntity<UndoPointsResponse> points(@PathVariable String gameName) {
+        return ResponseEntity.ok().cacheControl(CacheControl.noStore()).body(undoService.list(gameName));
+    }
+
+    @PostMapping("/rewind")
+    @SetupRequestContext(false)
+    @PreAuthorize("@security.canAccessGame(#gameName)")
+    public RewindResponse rewind(@PathVariable String gameName, @RequestBody RewindRequest request) {
+        if (request == null || request.index() == null) throw new UndoService.UndoException(400, "index is required");
+        return undoService.rewind(gameName, RequestContext.getUserId(), request.index());
+    }
+
+    @PostMapping("/undo")
+    @SetupRequestContext(false)
+    @PreAuthorize("@security.canAccessGame(#gameName)")
+    public RewindResponse undo(@PathVariable String gameName, @RequestBody(required = false) UndoRequest request) {
+        boolean force = request != null && Boolean.TRUE.equals(request.force());
+        return undoService.undo(gameName, RequestContext.getUserId(), force);
+    }
+
+    @ExceptionHandler(UndoService.UndoException.class)
+    public ResponseEntity<Map<String, Object>> undoError(UndoService.UndoException e) {
+        Map<String, Object> body = new LinkedHashMap<>();
+        body.put("error", e.getMessage());
+        if (e.needsForce) body.put("needsForce", true);
+        return ResponseEntity.status(e.status).body(body);
+    }
+}
diff --git a/src/main/java/ti4/spring/api/selfhost/UndoJournal.java b/src/main/java/ti4/spring/api/selfhost/UndoJournal.java
new file mode 100644
index 0000000..4f512c6
--- /dev/null
+++ b/src/main/java/ti4/spring/api/selfhost/UndoJournal.java
@@ -0,0 +1,167 @@
+package ti4.spring.api.selfhost;
+
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.StandardOpenOption;
+import java.util.ArrayList;
+import java.util.List;
+import ti4.helpers.Storage;
+import ti4.logging.BotLogger;
+
+/**
+ * Self-hosted: a small append-only journal of every roll-back of a game (the UNDO button, {@code /game undo} and the
+ * web rewind / undo endpoints all go through {@code GameUndoService.undo}, which calls {@link #recordUndo}).
+ *
+ * <p>The bot never deletes the Discord messages of undone actions, so the web game log uses this journal to work out
+ * which messages belong to the live history: at time {@code at} the game went back to the state saved at
+ * {@code toSavedAt}. Stored as tab-separated lines in {@code <undo dir>/selfhost-rewinds.tsv} (outside the
+ * {@code <game>_N.txt} pattern the undo code lists and prunes).
+ */
+public final class UndoJournal {
+
+    public record Entry(
+            long at,
+            int fromIndex,
+            int toIndex,
+            long fromSavedAt,
+            long toSavedAt,
+            String kind,
+            String byUserId,
+            String byName,
+            String label,
+            List<Long> lostSavedAt) {}
+
+    private record Context(String kind, String byUserId, String byName, String label) {}
+
+    private static final ThreadLocal<Context> context = new ThreadLocal<>();
+    private static final Object fileLock = new Object();
+    private static final int MAX_ENTRIES = 500;
+
+    private UndoJournal() {}
+
+    /** Attribute roll-backs made on this thread while {@code task} runs (the web endpoints know who and why). */
+    public static <T> T withContext(
+            String kind, String byUserId, String byName, String label, java.util.function.Supplier<T> task) {
+        context.set(new Context(kind, byUserId, byName, label));
+        try {
+            return task.get();
+        } finally {
+            context.remove();
+        }
+    }
+
+    /** Called by {@code GameUndoService} after it restored save {@code toIndex} (replacing {@code fromIndex}). */
+    public static void recordUndo(String gameName, int fromIndex, int toIndex, long fromSavedAt, long toSavedAt) {
+        try {
+            Context c = context.get();
+            String line = String.join(
+                    "\t",
+                    Long.toString(System.currentTimeMillis()),
+                    Integer.toString(fromIndex),
+                    Integer.toString(toIndex),
+                    Long.toString(fromSavedAt),
+                    Long.toString(toSavedAt),
+                    clean(c == null ? "undo" : c.kind()),
+                    clean(c == null ? "" : c.byUserId()),
+                    clean(c == null ? "" : c.byName()),
+                    clean(c == null ? "" : c.label()),
+                    lostSaves(gameName, toIndex, fromIndex));
+            synchronized (fileLock) {
+                Path file = file(gameName);
+                Files.writeString(
+                        file,
+                        line + "\n",
+                        StandardCharsets.UTF_8,
+                        StandardOpenOption.CREATE,
+                        StandardOpenOption.APPEND);
+                List<String> lines = Files.readAllLines(file, StandardCharsets.UTF_8);
+                if (lines.size() > MAX_ENTRIES * 2) {
+                    Files.write(file, lines.subList(lines.size() - MAX_ENTRIES, lines.size()), StandardCharsets.UTF_8);
+                }
+            }
+        } catch (Exception e) {
+            BotLogger.error("Could not record undo for " + gameName, e);
+        }
+    }
+
+    public static List<Entry> read(String gameName) {
+        List<Entry> out = new ArrayList<>();
+        try {
+            Path file = file(gameName);
+            if (!Files.exists(file)) return out;
+            List<String> lines;
+            synchronized (fileLock) {
+                lines = Files.readAllLines(file, StandardCharsets.UTF_8);
+            }
+            for (String line : lines) {
+                String[] p = line.split("\t", -1);
+                if (p.length < 9) continue;
+                try {
+                    out.add(new Entry(
+                            Long.parseLong(p[0]),
+                            Integer.parseInt(p[1]),
+                            Integer.parseInt(p[2]),
+                            Long.parseLong(p[3]),
+                            Long.parseLong(p[4]),
+                            p[5],
+                            p[6],
+                            p[7],
+                            p[8],
+                            parseLongs(p.length > 9 ? p[9] : "")));
+                } catch (NumberFormatException ignored) {
+                    // skip a damaged line
+                }
+            }
+        } catch (Exception e) {
+            BotLogger.error("Could not read undo journal for " + gameName, e);
+        }
+        return out;
+    }
+
+    /** Save times of the undo copies this roll-back is about to delete (after {@code toIndex}). */
+    private static String lostSaves(String gameName, int toIndex, int fromIndex) {
+        StringBuilder sb = new StringBuilder();
+        for (int i = toIndex + 1; i <= fromIndex && i - toIndex <= 200; i++) {
+            Path undo = Storage.getGameUndo(gameName, gameName + "_" + i + ".txt");
+            long t = savedAt(undo);
+            if (t <= 0) continue;
+            if (!sb.isEmpty()) sb.append(',');
+            sb.append(t);
+        }
+        return sb.toString();
+    }
+
+    private static long savedAt(Path undoFile) {
+        if (!Files.exists(undoFile)) return 0;
+        try (var lines = Files.lines(undoFile, StandardCharsets.UTF_8)) {
+            return lines.limit(400)
+                    .filter(l -> l.startsWith("last_modified_date "))
+                    .findFirst()
+                    .map(l -> Long.parseLong(l.substring("last_modified_date ".length()).trim()))
+                    .orElse(0L);
+        } catch (Exception e) {
+            return 0;
+        }
+    }
+
+    private static List<Long> parseLongs(String csv) {
+        List<Long> out = new ArrayList<>();
+        for (String s : csv.split(",")) {
+            try {
+                if (!s.isBlank()) out.add(Long.parseLong(s.trim()));
+            } catch (NumberFormatException ignored) {
+                // skip
+            }
+        }
+        return out;
+    }
+
+    private static Path file(String gameName) {
+        return Storage.getGameUndoDirectory(gameName).resolve("selfhost-rewinds.tsv");
+    }
+
+    private static String clean(String s) {
+        return s == null ? "" : s.replace('\t', ' ').replace('\n', ' ').replace('\r', ' ');
+    }
+}
