+    protected List<R> rules() {
+        return List.of(
+                // Imperia: lose a fleet token - your own or another player's token in your fleet pool.
+                ability("loseMahactCC_(?<color>[^_]+)(?<keep>_keep)?", "ability", "imperia", "mahact", "loseMahactCC", "target", false),
