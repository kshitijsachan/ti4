diff --git a/src/main/java/ti4/service/objectives/ObjectiveSpendService.java b/src/main/java/ti4/service/objectives/ObjectiveSpendService.java
new file mode 100644
index 0000000..6350adf
--- /dev/null
+++ b/src/main/java/ti4/service/objectives/ObjectiveSpendService.java
@@ -0,0 +1,310 @@
+package ti4.service.objectives;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+import lombok.experimental.UtilityClass;
+import net.dv8tion.jda.api.components.buttons.Button;
+import net.dv8tion.jda.api.events.interaction.component.ButtonInteractionEvent;
+import ti4.discord.interactions.buttons.Buttons;
+import ti4.discord.interactions.routing.ButtonHandler;
+import ti4.game.Game;
+import ti4.game.Planet;
+import ti4.game.Player;
+import ti4.helpers.AliasHandler;
+import ti4.helpers.ButtonHelper;
+import ti4.helpers.Helper;
+import ti4.image.Mapper;
+import ti4.message.MessageHelper;
+import ti4.model.PublicObjectiveModel;
+
+/**
+ * Public objectives whose condition is a spend (Erect a Monument, Sway the Council, Amass Wealth, Found a Golden Age,
+ * Manipulate Galactic Law, Hold Vast Reserves): the player pays first, the objective is scored by the payment's own
+ * "Score" button once what was spent covers the cost. The original scored at once and asked for the payment
+ * afterwards, so a score could stay unpaid — and a game could end on it (playtest: Amass Wealth).
+ *
+ * <p>Prompt: the usual exhaust buttons (ButtonHelper.getExhaustButtonsWithTG), then {@code poPayScore_<n>} ("Score
+ * <objective>", refused until paid) and {@code poPayCancel_<n>} (readies what was spent, nothing scored). Lead From
+ * the Front / Galvanize the People: the pool split ({@link ObjectiveTokenSpendService}) comes first the same way.
+ */
+@UtilityClass
+public class ObjectiveSpendService {
+
+    public static final String SCORE = "poPayScore_";
+    public static final String CANCEL = "poPayCancel_";
+
+    /** objective -> {resources, influence, trade goods} to spend. */
+    private static final Map<String, int[]> COST = Map.of(
+            "monument", new int[] {8, 0, 0},
+            "golden_age", new int[] {16, 0, 0},
+            "sway_council", new int[] {0, 8, 0},
+            "manipulate_law", new int[] {0, 16, 0},
+            "amass_wealth", new int[] {3, 3, 3},
+            "vast_reserves", new int[] {6, 6, 6});
+
+    /** {resources, influence, trade goods} the objective asks to spend, or null when it is not paid in planets. */
+    public static int[] cost(String objectiveId) {
+        int[] c = objectiveId == null ? null : COST.get(objectiveId);
+        return c == null ? null : c.clone();
+    }
+
+    private static String pendingKey(Player player) {
+        return "poPayScore" + player.getFaction();
+    }
+
+    /** Whether the player has an open payment prompt for the objective they are paying for (engine registry). */
+    public static boolean paying(Game game, Player player, int poID) {
+        return poID >= 0 && pending(game, player) == poID && !openPrompts(game, player, poID).isEmpty();
+    }
+
+    /** The objective number this player is paying for, or -1. */
+    public static int pending(Game game, Player player) {
+        String v = game.getStoredValue(pendingKey(player));
+        try {
+            return v == null || v.isEmpty() ? -1 : Integer.parseInt(v);
+        } catch (NumberFormatException e) {
+            return -1;
+        }
+    }
+
+    private static String idOf(Game game, int poID) {
+        for (Map.Entry<String, Integer> e : game.getRevealedPublicObjectives().entrySet())
+            if (e.getValue() != null && e.getValue() == poID) return e.getKey();
+        return null;
+    }
+
+    private static String nameOf(String id) {
+        PublicObjectiveModel m = Mapper.getPublicObjective(id);
+        return m == null ? id : m.getName();
+    }
+
+    /**
+     * Before scoring: asks for the payment (planets / trade goods, or the command token pools when they can share it
+     * more than one way) and returns true; false when the objective is not paid that way (score it now).
+     */
+    public static boolean payFirst(Game game, Player player, int poID) {
+        return payFirst(game, player, poID, null);
+    }
+
+    private static String fromKey(Player player) {
+        return "poPayFrom" + player.getFaction();
+    }
+
+    /**
+     * imperialChannel: the channel of Imperial's "Score A Public" list the press came from (action phase), so that
+     * giving the payment up (Don't Score It) posts the list there again: the player keeps Imperial's score.
+     */
+    public static boolean payFirst(Game game, Player player, int poID, String imperialChannel) {
+        if (game.isOmegaPhaseMode()) return false; // Omega Phase: have, not spend
+        String id = idOf(game, poID);
+        if (id == null) return false;
+        // Pressed again while its payment is open (live pbd526: Imperial's list pressed 4 times, a payment window
+        // each): the open payment stands, nothing is posted or refunded.
+        if (pending(game, player) == poID && !openPrompts(game, player, poID).isEmpty()) return true;
+        // Paying for another objective: its prompts go (their Score is refused anyway) before the refund below.
+        int was = pending(game, player);
+        if (was >= 0 && was != poID) deletePrompts(game, player, was);
+        if ("lead".equals(id) || "galvanize".equals(id)) {
+            boolean emelpar = player.hasRelicReady("emelpar");
+            int required = ("lead".equals(id) ? 3 : 6) - (emelpar ? 1 : 0);
+            String key = "lead".equals(id) ? "lead" : "galvanize";
+            if (!ObjectiveTokenSpendService.offerSplit(game, player, key, required, emelpar, poID)) return false;
+            if (pending(game, player) >= 0) Helper.refreshPlanetsOnTheRespend(player, game);
+            game.setStoredValue(pendingKey(player), String.valueOf(poID));
+            game.setStoredValue(fromKey(player), imperialChannel == null ? "" : imperialChannel);
+            return true;
+        }
+        int[] c = COST.get(id);
+        if (c == null) return false;
+        String whatFor = c[1] == 0 ? "res" : c[0] == 0 ? "inf" : "both";
+        // Paying for another objective before: give that back first (its prompt's Score is refused from now on).
+        if (pending(game, player) >= 0) Helper.refreshPlanetsOnTheRespend(player, game);
+        game.setStoredValue(pendingKey(player), String.valueOf(poID));
+        game.setStoredValue(fromKey(player), imperialChannel == null ? "" : imperialChannel);
+        StringBuilder msg = new StringBuilder(player.getRepresentationUnfogged())
+                .append(", pay for _")
+                .append(nameOf(id))
+                .append("_ first: ")
+                .append(describe(c))
+                .append(". Exhaust planets / spend trade goods, then press Score.");
+        if (c[2] == 0) msg.append(" Required ").append(c[0] + c[1]).append(".");
+        if (player.hasLeaderUnlocked("xxchahero") && c[0] > 0 && c[1] > 0)
+            msg.append("\n"
+                    + "-# Xxekir Grom, the Xxcha hero: each planet's combined value counts for either the resource"
+                    + " or the influence part, not both.");
+        List<Button> buttons = new ArrayList<>(ButtonHelper.getExhaustButtonsWithTG(game, player, whatFor));
+        buttons.add(Buttons.green(SCORE + poID, "Score " + nameOf(id)));
+        buttons.add(Buttons.gray(CANCEL + poID, "Don't Score It"));
+        MessageHelper.sendMessageToChannelWithButtons(player.getCorrectChannel(), msg.toString(), buttons);
+        return true;
+    }
+
+    /** Open decisions (message ids by channel) of this player's payment prompts for objective poID. */
+    public static List<String[]> openPrompts(Game game, Player player, int poID) {
+        List<String[]> out = new ArrayList<>();
+        String score = SCORE + poID;
+        String split = ObjectiveTokenSpendService.PREFIX;
+        for (ti4.selfhost.engine.EngineModels.Decision d :
+                ti4.selfhost.engine.DecisionRegistry.openDecisions(game.getName())) {
+            if (d.target() != null && d.target().userId() != null && !player.getUserID().equals(d.target().userId()))
+                continue;
+            boolean mine = d.options().stream().anyMatch(o -> {
+                String h = o.handler();
+                return h != null && (h.equals(score) || (h.startsWith(split) && h.endsWith("_" + poID)));
+            });
+            if (mine) out.add(new String[] {d.source().channelId(), d.source().messageId()});
+        }
+        return out;
+    }
+
+    private static void deletePrompts(Game game, Player player, int poID) {
+        for (String[] m : openPrompts(game, player, poID)) {
+            try {
+                net.dv8tion.jda.api.entities.channel.middleman.MessageChannel ch = ti4.discord.JdaService.jda
+                        .getChannelById(net.dv8tion.jda.api.entities.channel.middleman.MessageChannel.class, m[0]);
+                if (ch != null) ch.deleteMessageById(m[1]).queue(null, e -> {});
+            } catch (Exception e) {
+                // gone already
+            }
+        }
+    }
+
+    static String describe(int[] c) {
+        List<String> parts = new ArrayList<>();
+        if (c[1] > 0) parts.add("spend " + c[1] + " influence");
+        if (c[0] > 0) parts.add((parts.isEmpty() ? "spend " : "") + c[0] + " resources");
+        if (c[2] > 0) parts.add(c[2] + " trade goods");
+        return String.join(parts.size() > 2 ? ", " : " and ", parts);
+    }
+
+    /**
+     * Why these planets and trade goods do not pay the objective, or null when they do. Each planet counts its
+     * resources or its influence (the Xxcha hero: their sum for either); trade goods beyond the ones the objective
+     * asks for count as resources or influence (2 each with Mirror Computing).
+     */
+    public static String shortfall(Game game, Player player, String objectiveId, List<String> planets, int tg) {
+        int[] c = COST.get(objectiveId);
+        if (c == null) return null;
+        if (tg < c[2]) return "That spends " + tg + " of the " + c[2] + " trade goods.";
+        int tgv = player.hasTech("mc") ? 2 : 1;
+        int extra = (tg - c[2]) * tgv;
+        boolean either = player.hasLeaderUnlocked("xxchahero");
+        int R = c[0];
+        int I = c[1];
+        boolean[][] can = new boolean[R + 1][I + 1];
+        can[0][0] = true;
+        for (String name : planets) {
+            Planet p = game.getPlanetsInfo().get(AliasHandler.resolvePlanet(name));
+            if (p == null) continue;
+            int r = either ? p.getResources() + p.getInfluence() : p.getResources();
+            int i = either ? p.getResources() + p.getInfluence() : p.getInfluence();
+            boolean[][] next = new boolean[R + 1][I + 1];
+            for (int a = 0; a <= R; a++)
+                for (int b = 0; b <= I; b++) {
+                    if (!can[a][b]) continue;
+                    next[a][b] = true;
+                    next[Math.min(R, a + r)][b] = true;
+                    next[a][Math.min(I, b + i)] = true;
+                }
+            can = next;
+        }
+        int best = Integer.MAX_VALUE;
+        for (int a = 0; a <= R; a++)
+            for (int b = 0; b <= I; b++) if (can[a][b]) best = Math.min(best, (R - a) + (I - b));
+        if (best <= extra) return null;
+        return "That pays " + (R + I - best + extra) + " of " + (R + I) + " (" + describe(c) + ").";
+    }
+
+    /** Planets and trade goods spent in the player's current payment window. */
+    static List<String> spentPlanets(Game game, Player player) {
+        List<String> out = new ArrayList<>();
+        for (String t : player.getSpentThingsThisWindow())
+            if (game.getPlanetsInfo().containsKey(AliasHandler.resolvePlanet(t)) && !out.contains(t)) out.add(t);
+        return out;
+    }
+
+    @ButtonHandler(SCORE)
+    public static void score(ButtonInteractionEvent event, Game game, Player player, String buttonID) {
+        int poID;
+        try {
+            poID = Integer.parseInt(buttonID.substring(SCORE.length()));
+        } catch (NumberFormatException e) {
+            return;
+        }
+        if (pending(game, player) != poID) {
+            // A stale prompt (scored meanwhile, or replaced by another objective's payment): gone, nothing scored.
+            MessageHelper.sendEphemeralMessageToEventChannel(event, "You are not paying for that objective any more.");
+            ButtonHelper.deleteMessage(event);
+            return;
+        }
+        String id = idOf(game, poID);
+        if (id == null || game.didPlayerScoreThisAlready(player.getUserID(), id)) {
+            game.removeStoredValue(pendingKey(player));
+            ButtonHelper.deleteMessage(event);
+            return;
+        }
+        String why = shortfall(game, player, id, spentPlanets(game, player), player.getSpentTgsThisWindow());
+        if (why != null) {
+            MessageHelper.sendEphemeralMessageToEventChannel(event, why + " Spend more, then press Score.");
+            return;
+        }
+        int[] c = COST.get(id);
+        String whatFor = c[1] == 0 ? "res" : c[0] == 0 ? "inf" : "both";
+        MessageHelper.sendMessageToChannel(
+                player.getCorrectChannel(),
+                Helper.buildSpentThingsMessage(player, game, whatFor) + "\nPaid for _" + nameOf(id) + "_.");
+        player.resetSpentThings();
+        game.removeStoredValue(pendingKey(player));
+        game.removeStoredValue(fromKey(player));
+        ButtonHelper.deleteMessage(event);
+        ScorePublicObjectiveService.scorePO(event, game, player, poID, true);
+    }
+
+    @ButtonHandler(CANCEL)
+    public static void cancel(ButtonInteractionEvent event, Game game, Player player, String buttonID) {
+        int poID;
+        try {
+            poID = Integer.parseInt(buttonID.substring(CANCEL.length()));
+        } catch (NumberFormatException e) {
+            poID = -2;
+        }
+        if (pending(game, player) != poID) {
+            ButtonHelper.deleteMessage(event); // stale: refunds nothing of the payment in progress
+            return;
+        }
+        Helper.refreshPlanetsOnTheRespend(player, game);
+        player.resetSpentThings();
+        game.removeStoredValue(pendingKey(player));
+        MessageHelper.sendMessageToChannel(
+                player.getCorrectChannel(),
+                player.getRepresentation()
+                        + " did not pay, and so did not score, that objective; what was spent was refunded.");
+        ButtonHelper.deleteMessage(event);
+        // Started from Imperial's list: the list again, so another objective can be scored (Imperial's score is
+        // not lost by giving one payment up).
+        String from = game.getStoredValue(fromKey(player));
+        game.removeStoredValue(fromKey(player));
+        if (from != null && !from.isEmpty() && "action".equalsIgnoreCase(game.getPhaseOfGame()))
+            repostImperialList(game, player, from);
+    }
+
+    private static void repostImperialList(Game game, Player player, String channelId) {
+        List<Button> buttons = ti4.helpers.StatusHelper.getScoreObjectiveButtons(game, player.factionButtonChecker());
+        buttons.add(Buttons.red("deleteButtons", "Delete These Buttons"));
+        net.dv8tion.jda.api.entities.channel.middleman.MessageChannel ch = game.isFowMode()
+                ? player.getPrivateChannel()
+                : ti4.discord.JdaService.jda.getChannelById(
+                        net.dv8tion.jda.api.entities.channel.middleman.MessageChannel.class, channelId);
+        if (ch == null) ch = player.getCorrectChannel();
+        MessageHelper.sendMessageToChannelWithButtons(
+                ch, player.getRepresentation() + ", use buttons to score an objective (Imperial)", buttons);
+    }
+
+    /** The token split answered for an objective scored after it ({@link ObjectiveTokenSpendService}). */
+    static void paidByTokens(ButtonInteractionEvent event, Game game, Player player, int poID) {
+        if (pending(game, player) != poID) return;
+        game.removeStoredValue(pendingKey(player));
+        ScorePublicObjectiveService.scorePO(event, game, player, poID, true);
+    }
+}
diff --git a/src/main/java/ti4/service/objectives/ObjectiveTokenSpendService.java b/src/main/java/ti4/service/objectives/ObjectiveTokenSpendService.java
new file mode 100644
index 0000000..a9b42f3
--- /dev/null
+++ b/src/main/java/ti4/service/objectives/ObjectiveTokenSpendService.java
@@ -0,0 +1,115 @@
+package ti4.service.objectives;
+
+import java.util.ArrayList;
+import java.util.List;
+import lombok.experimental.UtilityClass;
+import net.dv8tion.jda.api.components.buttons.Button;
+import net.dv8tion.jda.api.events.interaction.component.ButtonInteractionEvent;
+import ti4.discord.interactions.buttons.Buttons;
+import ti4.discord.interactions.routing.ButtonHandler;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.helpers.ButtonHelper;
+import ti4.helpers.ButtonHelperCommanders;
+import ti4.message.MessageHelper;
+import ti4.service.emoji.CardEmojis;
+
+/**
+ * Public objectives paid in command tokens (Lead From the Front: 3, Galvanize the People: 6, one less with a readied
+ * Scepter of Emelpar). When the strategy and tactic pools can share the cost more than one way, the player chooses
+ * the split instead of the bot taking strategy tokens first: one button per split,
+ * {@code FFCC_<faction>_poTokenSpend_<lead|galvanize>_<strategy>_<tactic>[_<objective number>]}. With the number the
+ * choice comes before scoring and the answer scores it (ObjectiveSpendService: pay first); without it (prompts posted
+ * before) the objective was already scored. With only one way to pay the bot still deducts it at once
+ * (ScorePublicObjectiveService).
+ */
+@UtilityClass
+public class ObjectiveTokenSpendService {
+
+    static final String PREFIX = "poTokenSpend_";
+
+    private static String objectiveName(String key) {
+        return "galvanize".equals(key) ? "Galvanize the People" : "Lead From the Front";
+    }
+
+    /** Posts the choice when there is one; false when the cost can be paid only one way (or not at all). */
+    public static boolean offerSplit(Game game, Player player, String key, int required, boolean emelpar) {
+        return offerSplit(game, player, key, required, emelpar, -1);
+    }
+
+    /** Same, for an objective scored once paid (poID >= 0: the answer scores it). */
+    public static boolean offerSplit(Game game, Player player, String key, int required, boolean emelpar, int poID) {
+        int strat = player.getStrategicCC();
+        int tact = player.getTacticalCC();
+        if (strat + tact < required) return false;
+        int minStrat = Math.max(0, required - tact);
+        int maxStrat = Math.min(strat, required);
+        if (minStrat >= maxStrat) return false;
+        List<Button> buttons = new ArrayList<>();
+        for (int s = maxStrat; s >= minStrat; s--) {
+            int t = required - s;
+            String label = s == 0
+                    ? t + " from tactic"
+                    : t == 0 ? s + " from strategy" : s + " from strategy, " + t + " from tactic";
+            buttons.add(Buttons.green(
+                    player.factionButtonChecker() + PREFIX + key + "_" + s + "_" + t + (poID >= 0 ? "_" + poID : ""),
+                    label));
+        }
+        String msg = player.getRepresentationUnfogged() + ", choose which pools pay the " + required
+                + " command tokens for _" + objectiveName(key) + "_ (strategy " + strat + ", tactic " + tact + ")."
+                + (emelpar ? " The Scepter of Emelpar saves 1." : "");
+        MessageHelper.sendMessageToChannelWithButtons(player.getCorrectChannel(), msg, buttons);
+        return true;
+    }
+
+    @ButtonHandler(PREFIX)
+    public static void spend(ButtonInteractionEvent event, Game game, Player player, String buttonID) {
+        String[] parts = buttonID.substring(PREFIX.length()).split("_");
+        if (parts.length != 3 && parts.length != 4) return;
+        int poID = -1;
+        if (parts.length == 4) {
+            try {
+                poID = Integer.parseInt(parts[3]);
+            } catch (NumberFormatException e) {
+                return;
+            }
+            if (ObjectiveSpendService.pending(game, player) != poID) {
+                ButtonHelper.deleteMessage(event); // no longer paying for it (scored, or another objective chosen)
+                return;
+            }
+        }
+        String key = parts[0];
+        int s;
+        int t;
+        try {
+            s = Integer.parseInt(parts[1]);
+            t = Integer.parseInt(parts[2]);
+        } catch (NumberFormatException e) {
+            return;
+        }
+        int strat = player.getStrategicCC();
+        int tact = player.getTacticalCC();
+        if (s > strat || t > tact) {
+            MessageHelper.sendMessageToChannel(
+                    player.getCorrectChannel(),
+                    player.getRepresentation() + ", your pools no longer hold " + s + " strategy and " + t
+                            + " tactic tokens (strategy " + strat + ", tactic " + tact + "). Choose again.");
+            return;
+        }
+        String card = ("galvanize".equals(key) ? CardEmojis.Public2 : CardEmojis.Public1) + " _"
+                + objectiveName(key) + "_.";
+        for (int x = 0; x < s; x++) {
+            ButtonHelperCommanders.resolveMuaatCommanderCheck(player, game, event, "scored " + card);
+        }
+        String before = player.getCCRepresentation();
+        player.setStrategicCC(strat - s);
+        player.setTacticalCC(tact - t);
+        MessageHelper.sendMessageToChannel(
+                player.getCorrectChannel(),
+                player.getRepresentation() + " spent " + s + " strategy and " + t + " tactic command token"
+                        + (s + t == 1 ? "" : "s") + " for _" + objectiveName(key) + "_ (" + before + " -> "
+                        + player.getCCRepresentation() + ").");
+        ButtonHelper.deleteMessage(event);
+        if (poID >= 0) ObjectiveSpendService.paidByTokens(event, game, player, poID);
+    }
+}
