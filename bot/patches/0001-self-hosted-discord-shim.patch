@@ -0,0 +1,56 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+import ti4.game.Player;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * Place a rider (or a rider-like ability: Galactic Threat, Keleres hero, ...) on an outcome
+ * (AgendaRiderHelper.getAgendaButtons): FFCC_&lt;f&gt;_rider_&lt;fa|player|planet|law|so|sc&gt;;&lt;outcome&gt;_&lt;rider name&gt;,
+ * or for Elect Planet first the owner: FFCC_&lt;f&gt;_planetRider_&lt;owner&gt;_&lt;rider name&gt;.
+ */
+public class AgendaRiderKind implements KindSpec {
+
+    @Override
+    public String kind() {
+        return "agenda.rider";
+    }
+
+    @Override
+    public int priority() {
+        return 100;
+    }
+
+    @Override
+    public boolean matches(String h) {
+        return (h.startsWith("rider_") && h.contains(";")) || h.startsWith("planetRider_");
+    }
+
+    @Override
+    public Map<String, Object> value(String h, CaptureContext ctx) {
+        Map<String, Object> v = new LinkedHashMap<>();
+        if (h.startsWith("planetRider_")) {
+            String rest = h.substring("planetRider_".length());
+            int us = rest.indexOf('_');
+            if (us < 0) return null;
+            String who = rest.substring(0, us);
+            Player p = ctx.game().getPlayerFromColorOrFaction(who);
+            v.put("rider", rest.substring(us + 1).replaceAll("page\\d+$", ""));
+            v.put("planetOwner", p == null ? who : p.getFaction());
+            v.put("userId", p == null ? null : p.getUserID());
+            return v;
+        }
+        // rider_<type>;<outcome>_<rider>, parsed like AgendaRiderHelper.placeRider
+        int first = h.indexOf('_');
+        int last = h.lastIndexOf('_');
+        if (last <= first) return null;
+        String[] params = h.substring(first + 1, last).split(";");
+        if (params.length < 2) return null;
+        v.put("rider", h.substring(last + 1));
+        v.put("outcomeKind", params[0]);
+        v.put("outcome", params[1]);
+        v.put("name", AgendaSupport.outcomeName(ctx.game(), params[1]));
+        return v;
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/AgendaShenanigansKind.java b/src/main/java/ti4/selfhost/engine/kinds/AgendaShenanigansKind.java
new file mode 100644
index 0000000..7964164
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/AgendaShenanigansKind.java
@@ -0,0 +1,97 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.helpers.AgendaHelper;
+import ti4.message.GameMessage;
+import ti4.message.GameMessageManager;
+import ti4.selfhost.engine.EngineModels.ReactionWindow;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * After the votes, before resolution: the table confirms it will not play shenanigans (AgendaHelper.handleShenanigans
+ * / autoResolve): generic_button_id_1 "No Deadly Plot", _2 "No Bribery", _3 "Refuse Confounding/Legal Text(s)",
+ * genericReact4 "Refuse Confusing Legal Text". Persistent-react message: every player answers for themself.
+ */
+public class AgendaShenanigansKind implements KindSpec {
+
+    @Override
+    public String kind() {
+        return "agenda.shenanigans";
+    }
+
+    @Override
+    public int priority() {
+        return 100;
+    }
+
+    @Override
+    public boolean matches(String h) {
+        return h.equals("generic_button_id_1")
+                || h.equals("generic_button_id_2")
+                || h.equals("generic_button_id_3")
+                || h.equals("genericReact4");
+    }
+
+    @Override
+    public Map<String, Object> value(String h, CaptureContext ctx) {
+        return switch (h) {
+            case "generic_button_id_1" -> Map.of("decline", "deadly_plot");
+            case "generic_button_id_2" -> Map.of("decline", "bribery");
+            case "generic_button_id_3" -> Map.of("decline", "legal_text");
+            case "genericReact4" -> Map.of("decline", "confusing_legal_text");
+            default -> null;
+        };
+    }
+
+    @Override
+    public String scope(CaptureContext ctx) {
+        return "table";
+    }
+
+    @Override
+    public boolean dynamic() {
+        return true;
+    }
+
+    /** One decline per player; the persistent-react record is not always kept (live: pbd36 answer loop). */
+    @Override
+    public boolean recordsResponses() {
+        return true;
+    }
+
+    /** Everyone may decline; who has is the persistent-react record of this message (GameMessageManager). */
+    @Override
+    public ReactionWindow window(CaptureContext ctx) {
+        Game game = ctx.game();
+        Set<String> reacted = GameMessageManager.getOne(game.getName(), ctx.messageId())
+                .map(GameMessage::factionsThatReacted)
+                .map(s -> (Set<String>) new LinkedHashSet<>(s))
+                .orElse(Set.of());
+        List<String> eligible = new ArrayList<>();
+        List<String> responded = new ArrayList<>();
+        Map<String, String> responses = new LinkedHashMap<>();
+        for (Player p : game.getRealPlayers()) {
+            eligible.add(p.getUserID());
+            if (reacted.contains(p.getFaction())) {
+                responded.add(p.getUserID());
+                responses.put(p.getUserID(), "declined");
+            }
+        }
+        Map<String, Object> subject = new LinkedHashMap<>();
+        String id = AgendaHelper.getCurrentAgendaId(game);
+        if (id != null) subject.put("agenda", id);
+        return new ReactionWindow("shenanigans", subject, eligible, responded, responses);
+    }
+
+    @Override
+    public ti4.selfhost.engine.EngineModels.Target target(CaptureContext ctx, ti4.selfhost.engine.EngineModels.Target resolved) {
+        return null;
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/AgendaSupport.java b/src/main/java/ti4/selfhost/engine/kinds/AgendaSupport.java
