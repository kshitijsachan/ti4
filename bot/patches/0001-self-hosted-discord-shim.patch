+package ti4.selfhost.engine.kinds;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.selfhost.engine.EngineModels.Decision;
+import ti4.selfhost.engine.EngineModels.Option;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * Play an action card from hand: ac_play_from_hand_&lt;handle&gt; (ActionCardHelper hand tray in the cards-info
+ * thread, and the action-window / combat subsets offered as replies). Value: {handle, actionCard, window}. The
+ * same hand-tray message also carries "Discard an Action Card" / "Pre-Assign" (value null).
+ */
+public class ActionCardPlayKind implements KindSpec {
+    static final String PREFIX = "ac_play_from_hand_";
+
+    @Override
+    public String kind() {
+        return "action_card.play";
+    }
+
+    @Override
+    public int priority() {
+        return 90;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return handlerId.startsWith(PREFIX);
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        int handle = CardKinds.parseInt(handlerId.substring(PREFIX.length()), -1);
+        if (handle < 0) return null;
+        Player holder = ctx.player() != null ? ctx.player() : CardKinds.holderOfHandle(ctx.game(), handle);
+        String ac = CardKinds.acIdForHandle(holder, handle);
+        if (ac == null) {
+            // Garbozia (Dok 'N Pic's Salvage Yard): cards played from the discard pile use the pile's handle.
+            for (Map.Entry<String, Integer> e : ctx.game().getDiscardActionCards().entrySet()) {
+                if (e.getValue() == handle) ac = e.getKey();
+            }
+        }
+        if (ac == null) return null;
+        Map<String, Object> v = new LinkedHashMap<>();
+        v.put("handle", handle);
+        v.put("actionCard", ac);
+        v.put("window", CardKinds.window(ac));
+        return v;
+    }
+
+    @Override
+    public String validate(Game game, Player answering, Decision decision, String optionId) {
+        for (Option o : decision.options()) {
+            if (!o.id().equals(optionId) || o.value() == null) continue;
+            Object h = o.value().get("handle");
+            if (h instanceof Integer handle
+                    && !answering.getActionCards().containsValue(handle)
+                    && !game.getDiscardActionCards().containsValue(handle))
+                return "That action card is not in your hand.";
+        }
+        return null;
+    }
+}
