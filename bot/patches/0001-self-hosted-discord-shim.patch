@@ -0,0 +1,75 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+import ti4.game.Game;
+import ti4.game.Planet;
+import ti4.game.Player;
+import ti4.selfhost.engine.EngineModels.Decision;
+import ti4.selfhost.engine.EngineModels.Option;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * Ready exhausted planets: refresh_&lt;planet&gt; (one button per exhausted planet; each press readies one and removes its
+ * button) and the Diplomacy "Done Readying Planets" (deleteButtons_diplomacy). Diplomacy (primary and secondary)
+ * readies up to 2: value.limit on the done option. value: {planet, resources, influence} | {done:true, source, limit}.
+ */
+public class PlanetReadyKind implements KindSpec {
+
+    @Override
+    public String kind() {
+        return "planet.ready";
+    }
+
+    @Override
+    public int priority() {
+        return 40;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return handlerId.matches("refresh_[^_]+") || "deleteButtons_diplomacy".equals(handlerId);
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        Map<String, Object> v = new LinkedHashMap<>();
+        if ("deleteButtons_diplomacy".equals(handlerId)) {
+            v.put("done", true);
+            v.put("source", "diplomacy");
+            v.put("limit", 2);
+            return v;
+        }
+        String planet = handlerId.substring("refresh_".length());
+        Planet p = ctx.game().getUnitHolderFromPlanet(planet);
+        v.put("planet", planet);
+        v.put("resources", p == null ? 0 : p.getResources());
+        v.put("influence", p == null ? 0 : p.getInfluence());
+        return v;
+    }
+
+    /**
+     * Diplomacy readies "up to 2" planets (value.limit on its Done option): a third refresh_ is refused. The original
+     * readied every planet pressed; the cap is a deliberate rules improvement (rules audit), mirrored in the bot's
+     * refresh_ handler.
+     */
+    @Override
+    public String validate(Game game, Player answering, Decision decision, String optionId) {
+        Map<String, Object> v = StrategyCards.optionValue(decision, optionId);
+        if (v == null || v.get("planet") == null || decision.source() == null) return null;
+        int limit = -1;
+        for (Option o : decision.options()) {
+            if (o.value() != null && Boolean.TRUE.equals(o.value().get("done")) && o.value().get("limit") instanceof Number n)
+                limit = n.intValue();
+        }
+        if (limit < 0) return null;
+        if (ti4.helpers.Helper.readiedPlanetsCount(answering, decision.source().messageId()) >= limit)
+            return "You may ready at most " + limit + " planets with this ability.";
+        return null;
+    }
+
+    @Override
+    public String scope(CaptureContext ctx) {
+        return "player";
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/PlayerPreferenceKind.java b/src/main/java/ti4/selfhost/engine/kinds/PlayerPreferenceKind.java
new file mode 100644
index 0000000..8f0220c
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/PlayerPreferenceKind.java
@@ -0,0 +1,85 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.Map;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * Per-player preferences the engine asks about at any time of the game (cards-info thread): the "welcome to async"
+ * survey (answerSurvey_&lt;answer&gt;_&lt;question#&gt;), auto-pass on secret scoring (sandbagPref_bot|manual), auto-pass
+ * on Sabotage after N hours (setAutoPassMedian_&lt;n&gt;), toggles such as auto-react on agendas or distance-based
+ * tile lists (playerPrefDecision_&lt;true|false&gt;_&lt;pref&gt;), pillaging own transactions
+ * (setwillPillageOwnTransactions_&lt;yes|no&gt;), and the statistics opt-in
+ * (setOptInSinglePreference_&lt;key&gt;_&lt;yes|no&gt;, setOptInStats_&lt;acceptAll|declineAll|some&gt;).
+ *
+ * <p>Private and non-blocking: never "your move" for a person (web: background prompt), but a bot answers it with
+ * the defaults the legacy rule table used (auto-pass secret scoring and Sabotage, auto-react on agendas, no stats).
+ * Replaces G1's setup.preference, which was obsolete past setup and so left these prompts legacy for the rest of the
+ * game (stored: sandbagPref_ 74, playerPrefDecision_ 22, setOptIn* 78).
+ *
+ * <p>value: {preference: "survey"|"sandbag"|"auto_pass_sabotage"|&lt;pref&gt;|"pillage_own_transactions"|"stats"|
+ * "stats:&lt;key&gt;", question: survey question number or null, choice: the answer as the engine names it}.
+ */
+public class PlayerPreferenceKind implements KindSpec {
+
+    public static final String KIND = "player.preference";
+
+    @Override
+    public String kind() {
+        return KIND;
+    }
+
+    @Override
+    public int priority() {
+        return 36;
+    }
+
+    @Override
+    public boolean matches(String h) {
+        return h.startsWith("answerSurvey_")
+                || h.startsWith("sandbagPref_")
+                || h.startsWith("setAutoPassMedian_")
+                || h.startsWith("playerPrefDecision_")
+                || h.startsWith("setwillPillageOwnTransactions_")
+                || h.startsWith("setOptInSinglePreference_")
+                || h.startsWith("setOptInStats_");
+    }
+
+    @Override
+    public Map<String, Object> value(String h, CaptureContext ctx) {
+        if (!matches(h)) return null;
+        String rest = h.substring(h.indexOf('_') + 1);
+        if (h.startsWith("answerSurvey_")) {
+            int last = rest.lastIndexOf('_');
+            String q = last < 0 ? null : rest.substring(last + 1);
+            return v("survey", q, last < 0 ? rest : rest.substring(0, last));
+        }
+        if (h.startsWith("sandbagPref_")) return v("sandbag", null, rest);
+        if (h.startsWith("setAutoPassMedian_")) return v("auto_pass_sabotage", null, rest);
+        if (h.startsWith("setwillPillageOwnTransactions_")) return v("pillage_own_transactions", null, rest);
+        if (h.startsWith("setOptInStats_")) return v("stats", null, rest);
+        if (h.startsWith("setOptInSinglePreference_")) {
+            int last = rest.lastIndexOf('_');
+            return last < 0
+                    ? v("stats", null, rest)
+                    : v("stats:" + rest.substring(0, last), null, rest.substring(last + 1));
+        }
+        int us = rest.indexOf('_');
+        return us < 0 ? v(rest, null, null) : v(rest.substring(us + 1), null, rest.substring(0, us));
+    }
+
+    private static Map<String, Object> v(String pref, String question, String choice) {
+        return SetupKindSupport.map("preference", pref, "question", question, "choice", choice);
+    }
+
+    /** Asked around setup too: faction / colour are picked after capture; re-resolve the target on state changes. */
+    @Override
+    public boolean dynamic() {
+        return true;
+    }
+
+    @Override
+    public ti4.selfhost.engine.EngineModels.Target target(
+            CaptureContext ctx, ti4.selfhost.engine.EngineModels.Target resolved) {
+        return SetupKindSupport.refresh(ctx, resolved);
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/PlayerSetupKind.java b/src/main/java/ti4/selfhost/engine/kinds/PlayerSetupKind.java
new file mode 100644
index 0000000..41a6723
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/PlayerSetupKind.java
@@ -0,0 +1,150 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.Map;
+import ti4.game.Player;
+import ti4.selfhost.engine.EngineModels.Decision;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * Manual player setup (instead of a draft): startPlayerSetup → setupStep1_&lt;uid&gt; (which user) → setupStep2_
+ * &lt;uid&gt;_&lt;faction&gt; (faction; "&lt;n&gt;!" pages) → setupStep3_&lt;uid&gt;_&lt;faction&gt;_&lt;color&gt; (colour)
+ * → setupStep4_…_&lt;pos&gt; (home system) → setupStep5_…_&lt;yes|no&gt; (speaker). The Keleres flavour step after a
+ * draft is {@link KeleresFlavorKind} (higher priority).
+ *
+ * <p>value: {step: "start"|"user"|"faction"|"color"|"home"|"speaker", userId, faction, color, position, speaker,
+ * page} — fields not yet known are null; page is the paging marker for "Get More …" buttons (then the step's own
+ * value is null).
+ */
+public class PlayerSetupKind implements KindSpec {
+
+    @Override
+    public String kind() {
+        return "setup.player";
+    }
+
+    @Override
+    public int priority() {
+        return 60;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return "startPlayerSetup".equals(handlerId) || handlerId.matches("setupStep[1-5]_.*");
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        if ("startPlayerSetup".equals(handlerId)) return v("start", null, null, null, null, null, null);
+        if (!matches(handlerId)) return null;
+        int step = handlerId.charAt("setupStep".length()) - '0';
+        String[] t = handlerId.split("_");
+        String uid = part(t, 1);
+        String faction = step >= 2 ? part(t, 2) : null;
+        String color = step >= 3 ? part(t, 3) : null;
+        String pos = step >= 4 ? part(t, 4) : null;
+        String page = null;
+        if (step == 2 && faction != null && faction.endsWith("!")) {
+            page = faction;
+            faction = null;
+        }
+        if (step == 3 && color != null && color.endsWith("!")) {
+            page = color;
+            color = null;
+        }
+        if ("null".equals(color)) color = null;
+        Boolean speaker = step == 5 ? "yes".equalsIgnoreCase(part(t, 5)) : null;
+        String name =
+                switch (step) {
+                    case 1 -> "user";
+                    case 2 -> "faction";
+                    case 3 -> "color";
+                    case 4 -> "home";
+                    default -> "speaker";
+                };
+        return v(name, uid, faction, color, pos, speaker, page);
+    }
+
+    private static Map<String, Object> v(
+            String step, String uid, String faction, String color, String pos, Boolean speaker, String page) {
+        return SetupKindSupport.map(
+                "step", step,
+                "userId", uid,
+                "faction", faction,
+                "color", color,
+                "position", pos,
+                "speaker", speaker,
+                "page", page);
+    }
+
+    private static String part(String[] t, int i) {
+        return t.length > i ? t[i] : null;
+    }
+
+    /** Setup: faction / colour are picked after capture; re-resolve the target on every state change. */
+    @Override
+    public boolean dynamic() {
+        return true;
+    }
+
+    @Override
+    public ti4.selfhost.engine.EngineModels.Target target(
+            CaptureContext ctx, ti4.selfhost.engine.EngineModels.Target resolved) {
+        return SetupKindSupport.refresh(ctx, resolved);
+    }
+
+    /** Past setup this prompt is a leftover nobody needs (live: hundreds open across games, flooding the web queue). */
+    @Override
+    public boolean obsolete(CaptureContext ctx) {
+        if (ti4.selfhost.engine.SetupStateBuilder.pastSetup(ctx.game())) return true;
+        // While a milty draft runs, the draft seats the players: manual player setup is a leftover menu (live pbd108:
+        // the web showed it before the draft pick and it was pressed over and over).
+        ti4.selfhost.engine.EngineModels.SetupState s = ti4.selfhost.engine.SetupStateBuilder.build(ctx.game());
+        if (s != null && "draft".equals(s.stage())) return true;
+        // The seat(s) this prompt sets up are already set up (faction + colour chosen): a leftover (live pbd257: two
+        // "Setup a Player" prompts stayed at the front of a seated player's queue, ahead of "Keep a secret objective").
+        // "Setup a Player" (startPlayerSetup, posted to every seat's cards-info thread) targets the thread's owner;
+        // setupStepN_<uid>_… target <uid> (step 1 lists every seat still to set up: obsolete once all of them are).
+        java.util.Set<String> seats = seatsOf(ctx);
+        if (seats.isEmpty()) return false;
+        for (String uid : seats) {
+            Player p = ctx.game().getPlayer(uid);
+            if (p == null || !seated(p)) return false;
+        }
+        return true;
+    }
+
+    private static boolean seated(Player p) {
+        return p.isRealPlayer() && !"null".equals(p.getFaction());
+    }
+
+    /** User ids of the seats the prompt's options set up (empty when unknown). */
+    private static java.util.Set<String> seatsOf(CaptureContext ctx) {
+        java.util.List<String> ids = ctx.handlerIds();
+        if (ids == null && ctx.messageId() != null) {
+            String id = ti4.selfhost.engine.DecisionRegistry.decisionIdForMessage(ctx.messageId());
+            Decision d = id == null ? null : ti4.selfhost.engine.DecisionRegistry.get(id);
+            if (d != null) ids = d.options().stream()
+                    .map(o -> o.handler() != null
+                            ? o.handler()
+                            : ti4.discord.interactions.routing.ComponentIdEnvelope.decode(o.id().split("#")[0])
+                                    .handlerId())
+                    .toList();
+        }
+        java.util.Set<String> seats = new java.util.LinkedHashSet<>();
+        if (ids == null) return seats;
+        for (String h : ids) {
+            if (h == null) continue;
+            if ("startPlayerSetup".equals(h)) {
+                Player owner = ctx.player();
+                if (owner == null && ctx.target() != null && ctx.target().userId() != null)
+                    owner = ctx.game().getPlayer(ctx.target().userId());
+                if (owner == null) return new java.util.LinkedHashSet<>(); // whose thread unknown: keep it
+                seats.add(owner.getUserID());
+            } else if (h.matches("setupStep[1-5]_.*")) {
+                String uid = part(h.split("_"), 1);
+                if (uid != null && !uid.isEmpty()) seats.add(uid);
+            }
+        }
+        return seats;
+    }
+}
