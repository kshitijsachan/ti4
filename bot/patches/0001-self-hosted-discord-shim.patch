+
+/** Strategy phase: pick a strategy card. Buttons: FFCC_&lt;faction&gt;_scPick_&lt;n&gt; (Helper.getRemainingSCButtons). */
+public class StrategyCardPickKind implements KindSpec {
+
+    @Override
+    public String kind() {
+        return "strategy_card.pick";
+    }
+
+    @Override
+    public int priority() {
+        return 100;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return handlerId.matches("scPick_\\d+");
