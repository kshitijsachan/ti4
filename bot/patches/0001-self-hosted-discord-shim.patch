@@ -0,0 +1,93 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.List;
+import javax.annotation.Nullable;
+import ti4.selfhost.engine.KindSpec.CaptureContext;
+
+/**
+ * Emirates of Hacan: agent Carth (hacanAgentRefresh_&lt;faction&gt;), hero Harrugh Gefhara (purgeHacanHero), Production
+ * Biomes (useProductionBiomes -&gt; productionBiomes_&lt;faction&gt; who gains 2 TG), Quantum Datahub Node (startQDN -&gt;
+ * selectBeforeSwapSCs_&lt;faction&gt;_qdn / swapSCs_&lt;faction&gt;_qdn_&lt;theirSC&gt;_&lt;mySC&gt;), mech trade
+ * (hacanMechTradeStepOne_&lt;planet&gt;_&lt;receiver&gt; -&gt; hacanMechTradeStepTwo_&lt;planet&gt;_&lt;receiver&gt;_&lt;relocateTo&gt;),
+ * flagship Arvicon Rex (hacanFlagship_*, hacanFlagshipThalnos_*, hacanFlagshipFinish_&lt;pos&gt;_&lt;hits&gt;).
+ */
+public class FactionStepsHacan implements FactionSteps {
+    private static final String F = "hacan";
+
+    @Override
+    @Nullable
+    public Step step(String h, @Nullable CaptureContext ctx) {
+        if (h.startsWith("hacanAgentRefresh_"))
+            return Step.leader(
+                    "hacanagent", "hacanAgentRefresh", "target", false,
+                    "target", FactionSteps.faction(h.substring("hacanAgentRefresh_".length()), ctx));
+        if (h.equals("purgeHacanHero")) return Step.leader("hacanhero", "purgeHacanHero", "use", true);
+        if (h.equals("useProductionBiomes")) return Step.ability("tech", "pm", F, "useProductionBiomes", "use", true);
+        if (h.startsWith("productionBiomes_"))
+            return Step.ability(
+                    "tech", "pm", F, "productionBiomes", "target", false,
+                    "target", FactionSteps.faction(h.substring("productionBiomes_".length()), ctx),
+                    "amount", 2);
+        if (h.equals("startQDN")) return Step.ability("tech", "qdn", F, "startQDN", "use", true);
+        if (h.startsWith("selectBeforeSwapSCs_") && h.endsWith("_qdn"))
+            return Step.ability(
+                    "tech", "qdn", F, "selectBeforeSwapSCs", "target", false,
+                    "target", FactionSteps.faction(FactionSteps.at(FactionSteps.args(h, "selectBeforeSwapSCs_"), 0), ctx));
+        if (h.startsWith("swapSCs_") && h.contains("_qdn_")) {
+            List<String> a = FactionSteps.args(h, "swapSCs_");
+            return Step.ability(
+                    "tech", "qdn", F, "swapSCs", "target", false,
+                    "target", FactionSteps.faction(FactionSteps.at(a, 0), ctx),
+                    "strategyCard", FactionSteps.num(FactionSteps.at(a, 2)),
+                    "ownStrategyCard", FactionSteps.num(FactionSteps.at(a, 3)));
+        }
+        if (h.startsWith("hacanMechTradeStepOne_")) {
+            List<String> a = FactionSteps.args(h, "hacanMechTradeStepOne_");
+            return Step.ability(
+                    "mech", "hacan_mech", F, "hacanMechTradeStepOne", "use", true,
+                    "planet", FactionSteps.at(a, 0),
+                    "target", FactionSteps.faction(FactionSteps.at(a, 1), ctx));
+        }
+        if (h.startsWith("hacanMechTradeStepTwo_")) {
+            List<String> a = FactionSteps.args(h, "hacanMechTradeStepTwo_");
+            return Step.ability(
+                    "mech", "hacan_mech", F, "hacanMechTradeStepTwo", "target", false,
+                    "from", FactionSteps.at(a, 0),
+                    "target", FactionSteps.faction(FactionSteps.at(a, 1), ctx),
+                    "planet", FactionSteps.at(a, 2));
+        }
+        if (h.startsWith("hacanFlagshipFinish_")) {
+            List<String> a = FactionSteps.args(h, "hacanFlagshipFinish_");
+            return Step.ability(
+                    "flagship", "hacan_flagship", F, "hacanFlagshipFinish", "skip", false,
+                    "tile", FactionSteps.at(a, 0),
+                    "hits", FactionSteps.num(FactionSteps.at(a, 1)));
+        }
+        if (h.startsWith("hacanFlagshipThalnos_"))
+            return Step.ability(
+                    "flagship", "hacan_flagship", F, "hacanFlagshipThalnos", "use", true,
+                    "args", FactionSteps.args(h, "hacanFlagshipThalnos_"));
+        if (h.startsWith("hacanFlagship_")) {
+            List<String> a = FactionSteps.args(h, "hacanFlagship_");
+            Integer x = FactionSteps.num(FactionSteps.at(a, 1));
+            Integer hits = FactionSteps.num(FactionSteps.at(a, 2));
+            if (a.size() == 3 && x != null && hits != null) {
+                // Wrath of Kenara (HacanFlagshipService): hacanFlagship_<pos>_<eligible dice left>_<hits so far>;
+                // hits 0 = "Start over".
+                return Step.ability(
+                        "flagship", "hacan_flagship", F, "hacanFlagship", "use", true,
+                        "reset", hits == 0,
+                        "tile", a.get(0),
+                        "remaining", x,
+                        "hits", hits,
+                        "cost", hits);
+            }
+            // Thalnos reroll offer (CombatRollService): hacanFlagship_<unit type>_<eligible dice>
+            return Step.ability(
+                    "flagship", "hacan_flagship", F, "hacanFlagship", "use", true,
+                    "unit", FactionSteps.at(a, 0),
+                    "count", x);
+        }
+        return null;
+    }
+}
