--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/MiltyDraftInfoKind.java
@@ -0,0 +1,58 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.Map;
+import ti4.selfhost.engine.EngineModels.Target;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * "&lt;player&gt; is up to draft!" with read-only views: showMiltyDraft (repost the board), miltyFactionInfo_&lt;all|
+ * picked|remaining&gt; (faction overviews into the presser's cards thread). Anyone may press (table); the target is the
+ * drafter on the clock so a client can say "your pick". value: {view: "board"|"all"|"picked"|"remaining"}.
+ */
+public class MiltyDraftInfoKind implements KindSpec {
+
+    @Override
+    public String kind() {
+        return "draft.milty.info";
+    }
+
+    @Override
+    public int priority() {
+        return 40;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return "showMiltyDraft".equals(handlerId) || handlerId.startsWith("miltyFactionInfo_");
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        if ("showMiltyDraft".equals(handlerId)) return SetupKindSupport.map("view", "board");
+        if (!matches(handlerId)) return null;
+        return SetupKindSupport.map("view", handlerId.substring("miltyFactionInfo_".length()));
+    }
+
+    @Override
+    public Target target(CaptureContext ctx, Target resolved) {
+        return MiltyDraftPickKind.currentDrafter(ctx.game());
+    }
+
+    @Override
+    public boolean dynamic() {
+        return true;
+    }
+
+    @Override
+    public String scope(CaptureContext ctx) {
+        return "table";
+    }
+
+    /** Once the draft is over this prompt is a leftover (live: hundreds open across games). */
+    @Override
+    public boolean obsolete(CaptureContext ctx) {
+        return ti4.selfhost.engine.SetupStateBuilder.pastSetup(ctx.game())
+                || ti4.selfhost.engine.SetupStateBuilder.draftFinished(
+                        ctx.game(), ctx.game().getMiltyDraftManager());
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/MiltyDraftPickKind.java b/src/main/java/ti4/selfhost/engine/kinds/MiltyDraftPickKind.java
new file mode 100644
index 0000000..8c755a8
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/MiltyDraftPickKind.java
@@ -0,0 +1,100 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.Map;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.selfhost.engine.EngineModels.Decision;
+import ti4.selfhost.engine.EngineModels.DraftState;
+import ti4.selfhost.engine.EngineModels.Target;
+import ti4.selfhost.engine.KindSpec;
+import ti4.selfhost.engine.SetupStateBuilder;
+import ti4.service.milty.MiltyDraftManager;
+
+/**
+ * Milty draft pick: milty_&lt;category&gt;_&lt;value&gt; on the shared draft board in the main channel (three
+ * messages: slices, factions, speaker order). The board is not addressed to anyone; the target is the draft's
+ * current player (re-resolved on every state change).
+ *
+ * <p>value: {category: "slice"|"faction"|"order", pick: slice name | faction id | position as text}. validate refuses
+ * a pick out of turn, a second pick of a category the player already holds, an option no longer on the board, and any
+ * pick once the draft is over (a doubled last pick would run the draft's finish twice).
+ */
+public class MiltyDraftPickKind implements KindSpec {
+
+    @Override
+    public String kind() {
+        return "draft.milty.pick";
+    }
+
+    @Override
+    public int priority() {
+        return 100;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return handlerId.matches("milty_(slice|faction|order)_.+");
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        if (!matches(handlerId)) return null;
+        String rest = handlerId.substring("milty_".length());
+        int us = rest.indexOf('_');
+        return SetupKindSupport.map("category", rest.substring(0, us), "pick", rest.substring(us + 1));
+    }
+
+    @Override
+    public Target target(CaptureContext ctx, Target resolved) {
+        return currentDrafter(ctx.game());
+    }
+
+    @Override
+    public boolean dynamic() {
+        return true;
+    }
+
+    @Override
+    public String scope(CaptureContext ctx) {
+        return "player";
+    }
+
+    @Override
+    public String validate(Game game, Player answering, Decision decision, String optionId) {
+        MiltyDraftManager m = game.getMiltyDraftManager();
+        if (m == null || m.isFinished() || m.getDraftIndex() >= m.getDraftOrder().size())
+            return "The draft is over.";
+        Player cur = m.getCurrentDraftPlayer(game);
+        if (cur == null || cur != answering) return "It is not your turn to draft.";
+        String h = SetupKindSupport.handlerOf(decision, optionId);
+        if (!matches(h)) return null;
+        String rest = h.substring("milty_".length());
+        String category = rest.substring(0, rest.indexOf('_'));
+        String pick = rest.substring(rest.indexOf('_') + 1);
+        if (SetupStateBuilder.hasPicked(game, answering, category))
+            return "You already drafted a " + ("order".equals(category) ? "speaker position" : category) + ".";
+        DraftState ds = SetupStateBuilder.draft(game);
+        if (ds != null && !available(ds, category, pick)) return "That pick has already been taken.";
+        return null;
+    }
+
+    private static boolean available(DraftState ds, String category, String pick) {
+        return switch (category) {
+            case "slice" -> ds.available().slices().contains(pick);
+            case "faction" -> ds.available().factions().contains(pick);
+            case "order" -> ds.available().speakerOrders().stream().anyMatch(o -> String.valueOf(o).equals(pick));
+            default -> true;
+        };
+    }
+
+    public static Target currentDrafter(Game game) {
+        try {
+            MiltyDraftManager m = game.getMiltyDraftManager();
+            Player p = m == null || m.isFinished() ? null : m.getCurrentDraftPlayer(game);
+            if (p == null) return new Target(null, null, null, "draft_turn");
+            return ti4.selfhost.engine.DecisionCapture.target(p, "draft_turn");
+        } catch (Exception e) {
+            return new Target(null, null, null, "draft_turn");
+        }
+    }
+}
