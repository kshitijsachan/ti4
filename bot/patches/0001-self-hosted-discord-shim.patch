+package ti4.selfhost.engine;
+
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import javax.annotation.Nullable;
+import ti4.game.Game;
+import ti4.game.Leader;
+import ti4.game.Player;
+import ti4.game.Tile;
+import ti4.game.UnitHolder;
+import ti4.helpers.Units.UnitKey;
+import ti4.selfhost.engine.EngineModels.CommandTokens;
+import ti4.selfhost.engine.EngineModels.DraftState;
+import ti4.selfhost.engine.EngineModels.GameState;
+import ti4.selfhost.engine.EngineModels.Hand;
+import ti4.selfhost.engine.EngineModels.HolderState;
+import ti4.selfhost.engine.EngineModels.PlayerState;
+import ti4.selfhost.engine.EngineModels.StrategyCardState;
+import ti4.selfhost.engine.EngineModels.TileState;
+import ti4.selfhost.engine.EngineModels.UnitStack;
+import ti4.service.milty.MiltyDraftManager;
+
+/**
+ * Builds the authoritative structured state straight from Game/Player (no text, no image pipeline). Callers hold
+ * the game's read lock or accept a racy read (the web-data endpoint does the same). Grow it per area: add fields to
+ * EngineModels + types.ts together.
+ */
+public final class StateSnapshotBuilder {
+    private StateSnapshotBuilder() {}
+
+    public static GameState build(Game game, @Nullable String viewerUserId) {
+        List<PlayerState> players = new ArrayList<>();
+        Player active = game.getActivePlayer();
+        Player speaker = game.getSpeaker();
+        for (Player p : game.getPlayers().values()) {
+            if (p == null) continue;
+            players.add(player(game, p, p.getUserID().equals(viewerUserId), p == active, p == speaker));
+        }
+        List<StrategyCardState> scs = new ArrayList<>();
+        for (Integer sc : game.getSCList()) {
+            if (sc == null || sc <= 0) continue;
+            String holder = null;
+            for (Player p : game.getPlayers().values()) {
+                if (p != null && p.getSCs() != null && p.getSCs().contains(sc)) holder = p.getUserID();
+            }
+            Integer tg = game.getScTradeGoods().get(sc);
+            Boolean played = game.getScPlayed().get(sc);
+            scs.add(new StrategyCardState(sc, holder, tg == null ? 0 : tg, played != null && played));
+        }
+        List<TileState> tiles = new ArrayList<>();
+        for (Map.Entry<String, Tile> e : game.getTileMap().entrySet()) {
+            Tile t = e.getValue();
+            List<HolderState> holders = new ArrayList<>();
+            for (Map.Entry<String, UnitHolder> he : t.getUnitHolders().entrySet()) {
+                UnitHolder uh = he.getValue();
+                List<UnitStack> units = new ArrayList<>();
+                for (Map.Entry<UnitKey, List<Integer>> ue : uh.getUnitsByState().entrySet()) {
+                    List<Integer> st = ue.getValue();
+                    int total = 0;
+                    for (Integer n : st) total += n == null ? 0 : n;
+                    if (total == 0) continue;
+                    UnitKey k = ue.getKey();
+                    Player owner = game.getPlayerFromColorOrFaction(k.getColor());
+                    int dmg = st.size() > 1 ? nz(st.get(1)) + (st.size() > 3 ? nz(st.get(3)) : 0) : 0;
+                    int glv = st.size() > 2 ? nz(st.get(2)) + (st.size() > 3 ? nz(st.get(3)) : 0) : 0;
+                    units.add(new UnitStack(
+                            owner == null ? null : owner.getFaction(),
+                            k.getColor(),
+                            k.asyncID(),
+                            total,
+                            dmg,
+                            glv));
+                }
+                holders.add(new HolderState(
+                        he.getKey(),
+                        units,
+                        new ArrayList<>(uh.getTokenList()),
+                        new ArrayList<>(uh.getControlList())));
+            }
+            tiles.add(new TileState(e.getKey(), t.getTileID(), holders));
+        }
+        Map<String, List<String>> objectives = new LinkedHashMap<>();
+        for (String po : game.getRevealedPublicObjectives().keySet()) {
+            List<String> scorers = game.getScoredPublicObjectives().get(po);
+            objectives.put(po, scorers == null ? List.of() : List.copyOf(scorers));
+        }
+        return new GameState(
+                EngineModels.CONTRACT_VERSION,
+                game.getName(),
+                game.getLastModifiedDate(),
+                DecisionRegistry.currentSeq(),
+                game.getPhaseOfGame(),
+                game.getRound(),
+                active == null ? null : active.getUserID(),
+                speaker == null ? null : speaker.getUserID(),
+                players,
+                scs,
+                tiles,
+                objectives,
+                new ArrayList<>(game.getLaws().keySet()),
+                draft(game));
+    }
+
+    private static int nz(Integer i) {
+        return i == null ? 0 : i;
+    }
+
+    private static PlayerState player(Game game, Player p, boolean self, boolean active, boolean speaker) {
+        List<String> leaders = new ArrayList<>();
+        for (Leader l : p.getLeaders()) {
+            leaders.add(l.getId() + (l.isLocked() ? ":locked" : l.isExhausted() ? ":exhausted" : ""));
+        }
+        Hand hand = self
+                ? new Hand(
+                        new LinkedHashMap<>(p.getActionCards()),
+                        new LinkedHashMap<>(p.getSecrets()),
+                        new LinkedHashMap<>(p.getPromissoryNotes()))
+                : null;
+        return new PlayerState(
+                p.getUserID(),
+                p.getUserName(),
+                normalize(p.getFaction()),
+                normalize(p.getColor()),
+                self,
+                p.isRealPlayer(),
+                p.isPassed(),
+                p.isEliminated(),
+                speaker,
+                active,
+                safeVp(p),
+                p.getTg(),
+                p.getCommodities(),
+                p.getCommoditiesTotal(),
+                new CommandTokens(p.getTacticalCC(), p.getFleetCC(), p.getStrategicCC()),
+                new ArrayList<>(p.getSCs()),
+                new ArrayList<>(p.getTechs()),
+                new ArrayList<>(p.getExhaustedTechs()),
+                new ArrayList<>(p.getPlanets()),
+                new ArrayList<>(p.getExhaustedPlanets()),
+                new ArrayList<>(p.getRelics()),
+                new ArrayList<>(p.getFragments()),
+                leaders,
+                new ArrayList<>(p.getPromissoryNotesInPlayArea()),
+                new LinkedHashMap<>(p.getSecretsScored()),
+                p.getActionCards().size(),
+                p.getSecrets().size(),
+                p.getPromissoryNotes().size(),
+                hand);
+    }
+
+    private static int safeVp(Player p) {
+        try {
+            return p.getTotalVictoryPoints();
+        } catch (Exception e) {
+            return 0;
+        }
+    }
+
+    private static String normalize(String s) {
+        return s == null || "null".equals(s) || s.isBlank() ? null : s;
+    }
+
+    private static DraftState draft(Game game) {
+        try {
+            MiltyDraftManager m = game.getMiltyDraftManager();
+            if (m == null || m.getDraftOrder() == null || m.getDraftOrder().isEmpty()) return null;
+            Player cur = m.getCurrentDraftPlayer(game);
+            return new DraftState("milty", cur == null ? null : cur.getUserID(), List.copyOf(m.getDraftOrder()));
+        } catch (Exception e) {
+            return null;
+        }
+    }
+}
