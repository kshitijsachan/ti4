+package ti4.selfhost.engine;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.TimeUnit;
+import java.util.function.Predicate;
+import javax.annotation.Nullable;
+import net.dv8tion.jda.api.events.interaction.component.ButtonInteractionEvent;
+import net.dv8tion.jda.api.utils.data.DataArray;
+import net.dv8tion.jda.api.utils.data.DataObject;
+import net.dv8tion.jda.internal.JDAImpl;
+import net.dv8tion.jda.internal.interactions.components.buttons.ButtonInteractionImpl;
+import okhttp3.MediaType;
+import okhttp3.OkHttpClient;
+import okhttp3.Request;
+import okhttp3.RequestBody;
+import okhttp3.Response;
+import org.apache.commons.lang3.function.Consumers;
+import ti4.discord.JdaService;
+import ti4.discord.interactions.buttons.ButtonProcessor;
+import ti4.discord.interactions.listeners.ModalListener;
+import ti4.discord.interactions.routing.ComponentIdEnvelope;
+import ti4.discord.interactions.selections.SelectionMenuProcessor;
+import ti4.executors.ExecutionLockManager;
+import ti4.executors.ExecutionLockType;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.game.persistence.GameManager;
+import ti4.game.persistence.ManagedGame;
+import ti4.logging.BotLogger;
+import ti4.selfhost.engine.EngineModels.AnswerRequest;
+import ti4.selfhost.engine.EngineModels.AnswerResult;
+import ti4.selfhost.engine.EngineModels.Decision;
+import ti4.selfhost.engine.EngineModels.InputSchema;
+import ti4.selfhost.engine.EngineModels.Option;
+import ti4.selfhost.engine.interaction.EngineInteraction;
+import ti4.selfhost.engine.interaction.Forms;
+import ti4.selfhost.engine.interaction.MessageSink;
+import ti4.selfhost.engine.interaction.NativeCoverage;
+import ti4.selfhost.engine.interaction.NativeEvents;
+
+/**
+ * "Player P picks option O of decision D". Validates against the decision registry (open, seq, target, option) and
+ * the kind's own check, then runs the option's handler synchronously on this thread through the normal processor
+ * pipeline (game lock, ListenerContext ownership check, save, undo snapshot). Returns after the handler finished, with
+ * the decisions it opened.
+ *
+ * <p>Two paths (result.path):
+ *
+ * <ul>
+ *   <li><b>engine</b> — an {@link EngineInteraction} (no Discord interaction, no shim mint, no JDA internals) for
+ *       handlers {@link NativeCoverage} proves only use what the engine interaction supports, on non-ephemeral
+ *       prompts. Also the only path for select menus and forms (modal buttons → "input.form" decisions).
+ *   <li><b>synthetic</b> — fallback: the shim mints an interaction and we build a real JDA click event from it.
+ * </ul>
+ *
+ * {@code TI4_ENGINE_NATIVE=off} forces the synthetic path for buttons (selects/forms then become unanswerable).
+ */
+public final class ActionInvoker {
+    private static final MediaType JSON = MediaType.get("application/json");
+    private static final boolean NATIVE =
+            !"off".equalsIgnoreCase(System.getenv().getOrDefault("TI4_ENGINE_NATIVE", "on"));
+    private static final Set<String> inFlight = ConcurrentHashMap.newKeySet();
+    /** A payload answer's waits for the next prompt are capped at this (it holds the game lock meanwhile). */
+    private static final long PAYLOAD_WAIT_CAP_MS = 10_000;
+    /** And the whole payload answer at this: presses after it fail, the lock is released. */
+    private static final long PAYLOAD_DEADLINE_MS = 60_000;
+    private static final Map<String, AnswerResult> byRequestId =
+            Collections.synchronizedMap(new LinkedHashMap<>(256, 0.75f, true) {
+                @Override
+                protected boolean removeEldestEntry(Map.Entry<String, AnswerResult> e) {
+                    return size() > 2000;
+                }
+            });
+
+    private ActionInvoker() {}
+
+    public static AnswerResult answer(String gameName, String decisionId, String userId, AnswerRequest req) {
+        if (req.requestId() != null) {
+            AnswerResult prev = byRequestId.get(userId + ":" + req.requestId());
+            if (prev != null) return prev;
+        }
+        long t0 = System.nanoTime();
+        AnswerResult r = doAnswer(gameName, decisionId, userId, req);
+        EngineMetrics.answer(r.status(), System.nanoTime() - t0);
+        if (req.requestId() != null && !"busy".equals(r.status()))
+            byRequestId.put(userId + ":" + req.requestId(), r);
+        return r;
+    }
+
+    /** What an answer runs: a button press, a select (custom id + values) or a form submit/cancel. */
+    private record Plan(String type, String componentId, List<String> values, @Nullable Option option) {}
+
+    private static AnswerResult doAnswer(String gameName, String decisionId, String userId, AnswerRequest req) {
+        Decision d = DecisionRegistry.get(decisionId);
+        if (d == null || !d.game().equals(gameName)) return fail("stale", "That decision is no longer open.", decisionId);
+        if (req.expectedSeq() != null && req.expectedSeq() != d.seq())
+            return fail("stale", "That decision changed; re-read it.", decisionId);
+        ManagedGame mg = GameManager.getManagedGame(gameName);
+        Game game = mg == null ? null : mg.getGame();
+        if (game == null) return fail("not_found", "No such game.", decisionId);
+        Player player = game.getPlayer(userId);
+        if (player == null) return fail("forbidden", "You are not a player of this game.", decisionId);
+        if ("player".equals(d.scope()) && d.target() != null && d.target().userId() != null
+                && !d.target().userId().equals(userId))
+            return fail("forbidden", "That decision is for someone else.", decisionId);
+        if (d.window() != null) {
+            KindSpec ws = DecisionKinds.byKind(d.kind());
+            boolean outside = ws != null && ws.answersOutsideWindow(game, player, d);
+            if (!outside && !d.window().eligible().contains(userId))
+                return fail("forbidden", "You are not part of this reaction window.", decisionId);
+            if (!outside && d.window().responded().contains(userId))
+                return fail("stale", "You already responded to this window.", decisionId);
+        }
+
+        KindSpec payloadSpec = DecisionKinds.byKind(d.kind());
+        // Structured answers (payment, production, agenda vote, status tokens…): optionId, if given, is ignored.
+        if (req.payload() != null) return answerPayload(gameName, userId, player, d, payloadSpec, req.payload());
+
+        Plan plan;
+        if (Forms.KIND.equals(d.kind())) {
+            if (!Forms.SUBMIT.equals(req.optionId()) && !Forms.CANCEL.equals(req.optionId()))
+                return fail("bad_option", "Answer a form with submit or cancel.", decisionId);
+            if (Forms.get(decisionId) == null) return fail("stale", "That form is no longer open.", decisionId);
+            if (Forms.SUBMIT.equals(req.optionId())) {
+                String err = Forms.validate(d.inputs().getFirst(), req.inputs());
+                if (err != null) return fail("bad_input", err, decisionId);
+            }
+            plan = new Plan("form", req.optionId(), List.of(), null);
+        } else {
+            Option opt = null;
+            for (Option o : d.options()) if (o.id().equals(req.optionId())) opt = o;
+            InputSchema select = selectSchema(d, req.optionId());
+            if (opt == null && select != null && req.values() != null) {
+                String err = Forms.validateChoice(select.fields().getFirst(), req.values());
+                if (err != null) return fail("bad_input", err, decisionId);
+                plan = new Plan("select", select.id(), List.copyOf(req.values()), null);
+            } else {
+                if (opt == null) return fail("bad_option", "No such option.", decisionId);
+                if (opt.disabled()) return fail("bad_option", "That option is disabled.", decisionId);
+                if (opt.owner() != null && opt.owner().userId() != null && !opt.owner().userId().equals(userId))
+                    return fail("forbidden", "That option is for someone else.", decisionId);
+                int hash = opt.id().indexOf('#');
+                plan = hash >= 0
+                        ? new Plan("select", opt.id().substring(0, hash), List.of(opt.id().substring(hash + 1)), opt)
+                        : new Plan("button", opt.id(), List.of(), opt);
+            }
+            KindSpec spec = DecisionKinds.byKind(d.kind());
+            if (spec != null) {
+                String err = spec.validate(game, player, d, req.optionId());
+                if (err != null) return fail("refused", err, decisionId);
+            }
+        }
+
+        boolean nativePath = !"button".equals(plan.type()) || canRunNatively(d, plan);
+        if (!nativePath && plan.option() != null && plan.option().needsInput())
+            return fail("needs_input", "That option opens a form, which this handler cannot do as an engine answer.",
+                    decisionId);
+        if (!NATIVE && !"button".equals(plan.type()))
+            return fail("unsupported", "Selects and forms need TI4_ENGINE_NATIVE=on.", decisionId);
+
+        String flightKey = "table".equals(d.scope()) ? decisionId + "|" + userId : decisionId;
+        if (!inFlight.add(flightKey)) return fail("busy", "An answer to this decision is in progress.", decisionId);
+        long before = DecisionRegistry.currentSeq();
+        Decision form = null;
+        try {
+            if (nativePath) form = runNative(d, plan, game, player, userId, req);
+            else runSynthetic(d, plan.componentId(), userId);
+        } catch (MessageGone e) {
+            // The prompt's message no longer exists (a delete capture missed): close it so nobody answers it again.
+            EngineMetrics.count("answer.message_gone");
+            DecisionRegistry.close(decisionId, "deleted");
+            return fail("stale", "That prompt is gone.", decisionId);
+        } catch (ShimUnsupported e) {
+            return fail("unsupported", e.getMessage(), decisionId);
+        } catch (Exception e) {
+            BotLogger.error("engine: answer " + decisionId + " / " + plan.componentId() + " by " + userId + " failed", e);
+            return fail("error", String.valueOf(e.getMessage()), decisionId);
+        } finally {
+            inFlight.remove(flightKey);
+        }
+        recordWindowResponse(d, userId, plan.componentId());
+        List<Decision> opened = DecisionRegistry.openedAfter(gameName, before);
+        return new AnswerResult(
+                true,
+                form != null ? "needs_input" : "done",
+                null,
+                decisionId,
+                DecisionRegistry.currentSeq(),
+                game.getLastModifiedDate(),
+                opened,
+                nativePath ? "engine" : "synthetic");
+    }
+
+    /**
+     * A structured answer (KindSpec.answerPayload): the kind validates, then drives one or more presses as this player.
+     * Runs with the game's WRITE lock held for the whole sequence (reentrant: ButtonProcessor takes it again on this
+     * thread), so nobody else's click interleaves. Message capture and the registry do not take the game lock, so
+     * awaiting the next prompt under it is safe.
+     */
+    private static AnswerResult answerPayload(
+            String gameName, String userId, Player player, Decision d, KindSpec spec, Map<String, Object> payload) {
+        if (spec == null || !spec.acceptsPayload())
+            return fail("unsupported", "This decision does not take a structured answer.", d.id());
+        String flightKey = "table".equals(d.scope()) ? d.id() + "|" + userId : d.id();
+        if (!inFlight.add(flightKey)) return fail("busy", "An answer to this decision is in progress.", d.id());
+        long before = DecisionRegistry.currentSeq();
+        String messageId = d.source().messageId();
+        long deadline = System.currentTimeMillis() + PAYLOAD_DEADLINE_MS;
+        KindSpec.PayloadAnswer answer = new KindSpec.PayloadAnswer() {
+            private void checkDeadline() {
+                if (System.currentTimeMillis() > deadline)
+                    throw new IllegalStateException("payload answer exceeded " + PAYLOAD_DEADLINE_MS / 1000 + " s");
+            }
+
+            @Override
+            public String gameName() {
+                return gameName;
+            }
+
+            @Override
+            public Game game() {
+                ManagedGame mg = GameManager.getManagedGame(gameName);
+                return mg == null ? null : mg.getGame();
+            }
+
+            @Override
+            public Player player() {
+                Game g = game();
+                return g == null ? player : g.getPlayer(userId);
+            }
+
+            @Override
+            public String userId() {
+                return userId;
+            }
+
+            @Override
+            public Decision decision() {
+                String id = DecisionRegistry.decisionIdForMessage(messageId);
+                return id == null ? null : DecisionRegistry.get(id);
+            }
+
+            @Override
+            public void press(String optionId) throws Exception {
+                Decision latest = decision();
+                if (latest == null) throw new IllegalStateException("decision " + d.id() + " closed before the next step");
+                press(latest, optionId);
+            }
+
+            @Override
+            public void press(Decision decision, String optionId) throws Exception {
+                checkDeadline();
+                if (DecisionRegistry.get(decision.id()) == null)
+                    throw new IllegalStateException("decision " + decision.id() + " closed before the next step");
+                boolean known = decision.options().stream().anyMatch(o -> o.id().equals(optionId));
+                if (!known) throw new IllegalArgumentException("no option " + optionId + " on " + decision.id());
+                ActionInvoker.press(userId, decision, optionId);
+            }
+
+            @Override
+            public void pressEngine(Decision decision, String customId) throws Exception {
+                checkDeadline();
+                if (DecisionRegistry.get(decision.id()) == null)
+                    throw new IllegalStateException("decision " + decision.id() + " closed before the next step");
+                ActionInvoker.press(userId, decision, customId);
+            }
+
+            @Override
+            public long seq() {
+                return DecisionRegistry.currentSeq();
+            }
+
+            @Override
+            public Decision await(long afterSeq, Predicate<Decision> match, long timeoutMs) {
+                // Hard cap per wait and for the whole answer: we hold the game's WRITE lock while waiting. The prompt
+                // we wait for comes from message capture (JDA REST threads) and the registry, neither of which takes
+                // the game lock, so a wait can only time out, never deadlock; on timeout the kind refuses and the
+                // finally below releases the lock.
+                long end = Math.min(System.currentTimeMillis() + Math.min(timeoutMs, PAYLOAD_WAIT_CAP_MS), deadline);
+                while (true) {
+                    for (Decision x : DecisionRegistry.openedAfter(gameName, afterSeq)) if (match.test(x)) return x;
+                    if (System.currentTimeMillis() >= end) {
+                        BotLogger.error("engine: payload answer " + d.id() + " (" + d.kind() + ") by " + userId
+                                + " timed out waiting for the next prompt");
+                        EngineMetrics.count("answer.payload_wait_timeout");
+                        return null;
+                    }
+                    try {
+                        Thread.sleep(40);
+                    } catch (InterruptedException e) {
+                        Thread.currentThread().interrupt();
+                        return null;
+                    }
+                }
+            }
+        };
+        String err;
+        ExecutionLockManager.lock(gameName, ExecutionLockType.WRITE);
+        int undoBefore = UndoGroup.latest(gameName);
+        try {
+            err = spec.answerPayload(answer, payload);
+        } catch (Exception e) {
+            BotLogger.error("engine: payload answer " + d.id() + " by " + userId + " failed", e);
+            return fail("error", String.valueOf(e.getMessage()), d.id());
+        } finally {
+            // One undo step for the whole answer (also a partial one: undo then takes back what it did press).
+            UndoGroup.collapse(gameName, undoBefore, player.getUserName(), d.kind());
+            ExecutionLockManager.unlock(gameName, ExecutionLockType.WRITE);
+            inFlight.remove(flightKey);
+        }
+        if (err != null) return fail("refused", err, d.id());
+        Game now = answer.game();
+        return new AnswerResult(
+                true,
+                "done",
+                null,
+                d.id(),
+                DecisionRegistry.currentSeq(),
+                now == null ? 0 : now.getLastModifiedDate(),
+                DecisionRegistry.openedAfter(gameName, before),
+                "payload");
+    }
+
+    /**
+     * Runs a multi-press engine action (direct actions such as tactical move/land or a combat plan) as one undo step:
+     * under the game's WRITE lock (reentrant), collapsing the undo snapshots its presses made into one.
+     */
+    public static <T> T asOneUndoStep(String gameName, String userId, String label, java.util.function.Supplier<T> body) {
+        ExecutionLockManager.lock(gameName, ExecutionLockType.WRITE);
+        int undoBefore = UndoGroup.latest(gameName);
+        try {
+            return body.get();
+        } finally {
+            ManagedGame mg = GameManager.getManagedGame(gameName);
+            Player p = mg == null || mg.getGame() == null ? null : mg.getGame().getPlayer(userId);
+            UndoGroup.collapse(gameName, undoBefore, p == null ? userId : p.getUserName(), label);
+            ExecutionLockManager.unlock(gameName, ExecutionLockType.WRITE);
+        }
+    }
+
+    /**
+     * Presses one component of a decision's message as this user (payload answers): the engine path when the handler
+     * is covered (see {@link #canRunNatively}), else the synthetic click. An engine-owned custom id that is not an
+     * option of the message (KindSpec.Steps.pressEngine) is added to the synthesised message only.
+     */
+    static void press(String userId, Decision d, String customId) throws Exception {
+        Option opt = null;
+        for (Option o : d.options()) if (o.id().equals(customId)) opt = o;
+        Plan plan = new Plan("button", customId, List.of(), opt);
+        if (canRunNatively(d, plan)) {
+            ManagedGame mg = GameManager.getManagedGame(d.game());
+            Game game = mg == null ? null : mg.getGame();
+            Player player = game == null ? null : game.getPlayer(userId);
+            if (game == null || player == null) throw new IllegalStateException("no game or player for " + d.id());
+            runNative(d, plan, game, player, userId, null);
+        } else {
+            runSynthetic(d, customId, userId);
+        }
+    }
+
+    /** Kinds with recordsResponses(): mark this player responded on the window now (see WindowResponses). */
+    private static void recordWindowResponse(Decision d, String userId, String componentId) {
+        if (d.window() == null || !d.window().eligible().contains(userId)) return;
+        KindSpec spec = DecisionKinds.byKind(d.kind());
+        if (spec == null || !spec.recordsResponses()) return;
+        String handler = null;
+        for (Option o : d.options()) if (o.id().equals(componentId)) handler = o.handler();
+        if (handler == null || !spec.countsAsResponse(handler)) return;
+        WindowResponses.record(d.source().messageId(), userId);
+        String id = DecisionRegistry.decisionIdForMessage(d.source().messageId());
+        Decision cur = id == null ? null : DecisionRegistry.get(id);
+        if (cur == null || cur.window() == null) return;
+        EngineModels.ReactionWindow merged = WindowResponses.merge(cur.source().messageId(), cur.window());
+        if (merged != cur.window()) DecisionRegistry.update(cur.withDynamic(cur.stateVersion(), cur.target(), merged, cur.progress()));
+    }
+
+    @Nullable
+    private static InputSchema selectSchema(Decision d, String id) {
+        if (d.inputs() == null || id == null) return null;
+        for (InputSchema s : d.inputs()) if ("select".equals(s.kind()) && s.id().equals(id)) return s;
+        return null;
+    }
+
+    /** Engine path for a button: enabled, handler proven covered, prompt fetchable (not ephemeral), channel known. */
+    private static boolean canRunNatively(Decision d, Plan plan) {
+        if (!NATIVE || d.source().ephemeral()) return false;
+        String handlerId = ComponentIdEnvelope.decode(plan.componentId()).handlerId();
+        NativeCoverage.HandlerCoverage c = NativeCoverage.forHandlerIfReady("button", handlerId);
+        if (c == null || !c.nativeOk()) return false;
+        try {
+            MessageSink.jda().channel(d.source().channelId());
+            return true;
+        } catch (Exception e) {
+            return false;
+        }
+    }
+
+    /** Runs the plan as an engine answer; returns the form decision when a button's handler opened a modal. */
+    @Nullable
+    private static Decision runNative(Decision d, Plan plan, Game game, Player player, String userId, AnswerRequest req) {
+        MessageSink sink = MessageSink.jda();
+        switch (plan.type()) {
+            case "button" -> {
+                EngineInteraction ix = new EngineInteraction(
+                        EngineInteraction.Type.BUTTON, game, player, userId, d.source().channelId(),
+                        d.source().messageId(), plan.componentId(), null, null, sink);
+                ButtonProcessor.processNow(NativeEvents.button(ix));
+                log(d, ix);
+                return ix.getOpenedModal() != null ? Forms.open(d, ix, game, player) : null;
+            }
+            case "select" -> {
+                EngineInteraction ix = new EngineInteraction(
+                        EngineInteraction.Type.SELECT, game, player, userId, d.source().channelId(),
+                        d.source().messageId(), plan.componentId(), plan.values(), null, sink);
+                SelectionMenuProcessor.processNow(NativeEvents.select(ix));
+                log(d, ix);
+                return null;
+            }
+            case "form" -> {
+                Forms.Form f = Forms.get(d.id());
+                if (Forms.CANCEL.equals(plan.componentId()) || f == null) {
+                    Forms.close(d.id(), "cancelled");
+                    return null;
+                }
+                EngineInteraction ix = new EngineInteraction(
+                        EngineInteraction.Type.MODAL, game, player, userId, f.channelId(), f.messageId(),
+                        f.modal().getId(), null, req.inputs(), sink);
+                ix.openModal(f.modal());
+                Forms.close(d.id(), "answered");
+                ModalListener.processNow(NativeEvents.modal(ix));
+                log(d, ix);
+                return null;
+            }
+            default -> throw new IllegalStateException(plan.type());
+        }
+    }
+
+    private static void log(Decision d, EngineInteraction ix) {
+        BotLogger.info("engine: native answer " + d.id() + " " + ix.componentId() + " by " + ix.userId() + " -> "
+                + new ArrayList<>(ix.getTrace()));
+    }
+
+    private static void runSynthetic(Decision d, String customId, String userId) throws Exception {
+        DataObject interaction = mint(userId, d.source().channelId(), d.source().messageId(), customId);
+        if (d.options().stream().noneMatch(o -> o.id().equals(customId))) withButton(interaction, customId);
+        JDAImpl jda = (JDAImpl) JdaService.jda;
+        ButtonInteractionEvent event = new ButtonInteractionEvent(jda, -1, new ButtonInteractionImpl(jda, interaction));
+        InteractionTracker.record(event);
+        if (!customId.contains("~MDL")) event.deferEdit().queue(Consumers.nop(), BotLogger::catchRestError);
+        ButtonProcessor.processNow(event);
+    }
+
+    /**
+     * An engine-owned custom id is not on the message; JDA resolves event.getButton() from the message's components,
+     * so add it there (only in this synthesised interaction, never on the real message).
+     */
+    private static void withButton(DataObject interaction, String customId) {
+        if (!interaction.hasKey("message") || interaction.isNull("message")) return;
+        DataObject msg = interaction.getObject("message");
+        DataArray rows = msg.hasKey("components") && !msg.isNull("components") ? msg.getArray("components") : DataArray.empty();
+        DataObject button = DataObject.empty()
+                .put("type", 2)
+                .put("style", 2)
+                .put("label", "Engine answer")
+                .put("custom_id", customId);
+        rows.add(DataObject.empty().put("type", 1).put("components", DataArray.empty().add(button)));
+        msg.put("components", rows);
+    }
+
+    private static AnswerResult fail(String status, String error, String decisionId) {
+        return new AnswerResult(false, status, error, decisionId, DecisionRegistry.currentSeq(), 0, List.of(), null);
+    }
+
+    /** Asks the shim to register an interaction for this user on this message; returns the INTERACTION_CREATE d. */
+    static DataObject mint(String userId, String channelId, String messageId, String customId) throws Exception {
+        String base = System.getenv("DISCORD_API_BASE");
+        if (base == null) throw new IllegalStateException("not self-hosted");
+        String token = JdaService.jda.getToken();
+        if (!token.startsWith("Bot ")) token = "Bot " + token;
+        DataObject body = DataObject.empty()
+                .put("user_id", userId)
+                .put("channel_id", channelId)
+                .put("message_id", messageId)
+                .put("custom_id", customId)
+                .put("component_type", 2);
+        OkHttpClient http = JdaService.jda.getHttpClient().newBuilder().callTimeout(10, TimeUnit.SECONDS).build();
+        Request request = new Request.Builder()
+                .url(base.replaceAll("/+$", "") + "/selfhost/interactions")
+                .header("Authorization", token)
+                .post(RequestBody.create(body.toString(), JSON))
+                .build();
+        try (Response res = http.newCall(request).execute()) {
+            String text = res.body() == null ? "" : res.body().string();
+            if (res.code() == 404 && text.contains("no route"))
+                throw new ShimUnsupported("The running shim cannot mint interactions (POST /api/v10/selfhost/interactions"
+                        + " is missing): deploy the engine shim to answer through the engine.");
+            if (res.code() == 404 && text.contains("10008")) throw new MessageGone();
+            if (!res.isSuccessful()) throw new IllegalStateException("shim refused interaction: " + res.code() + " " + text);
+            return DataObject.fromJson(text);
+        }
+    }
+
+    static final class ShimUnsupported extends Exception {
+        ShimUnsupported(String message) {
+            super(message);
+        }
+    }
+
+    static final class MessageGone extends Exception {}
+}
