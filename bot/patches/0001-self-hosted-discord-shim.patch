+package ti4.selfhost.engine.kinds;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.selfhost.engine.EngineModels.Decision;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * Politics primary, part 1: give the speaker token to a player (sc_3_assign_speaker_to_&lt;faction&gt;, owner = the
+ * Politics holder; assignSpeaker_&lt;faction&gt; elsewhere). Must happen before the agendas are drawn.
+ * value: {faction, color, self}.
+ */
+public class PoliticsSpeakerKind implements KindSpec {
+    private static final String SC3 = "sc_3_assign_speaker_to_";
+
+    @Override
+    public String kind() {
+        return "strategy_card.politics_speaker";
+    }
+
+    @Override
+    public int priority() {
+        return 90;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return handlerId.startsWith(SC3) || handlerId.startsWith("assignSpeaker_");
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        String faction = handlerId.startsWith(SC3)
+                ? handlerId.substring(SC3.length())
+                : handlerId.substring("assignSpeaker_".length());
+        Player p = ctx.game().getPlayerFromColorOrFaction(faction);
+        Map<String, Object> v = new LinkedHashMap<>();
+        v.put("faction", p == null ? faction : p.getFaction());
+        v.put("color", p == null ? null : p.getColor());
+        v.put("self", p != null && p == ctx.player());
+        return v;
+    }
+
+    @Override
+    public String scope(CaptureContext ctx) {
+        return "player";
+    }
+
+    @Override
+    public String validate(Game game, Player answering, Decision decision, String optionId) {
+        Map<String, Object> v = StrategyCards.optionValue(decision, optionId);
+        if (v == null) return null;
+        Player p = game.getPlayerFromColorOrFaction(String.valueOf(v.get("faction")));
+        if (p == null) return "No such player.";
+        return null;
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/ProductionProduceKind.java b/src/main/java/ti4/selfhost/engine/kinds/ProductionProduceKind.java
new file mode 100644
index 0000000..3ceb82d
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/ProductionProduceKind.java
@@ -0,0 +1,254 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import javax.annotation.Nullable;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.game.Tile;
+import ti4.helpers.AliasHandler;
+import ti4.helpers.Helper;
+import ti4.model.UnitModel;
+import ti4.selfhost.engine.EngineModels.Decision;
+import ti4.selfhost.engine.DecisionRegistry;
+import ti4.selfhost.engine.EngineModels.Option;
+import ti4.selfhost.engine.EngineModels.Progress;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * Producing units: the engine's "Produce Units" message (Helper.getPlaceUnitButtons): place_&lt;unit&gt;_&lt;where&gt;
+ * (where = tile position for ships, planet id for ground forces, "space&lt;pos&gt;" for ground forces in space; 2gf/2ff
+ * = two at once), "Done Producing Units" (deleteButtons_&lt;context&gt;_&lt;pos&gt;) and "Reset Build"
+ * (resetProducedThings).
+ *
+ * <p>Answered in ONE action with a payload {units: [{unit, holder?, tile?, count}]} (empty list = build nothing):
+ * checked against the offered options and the production limit when the engine knows it (tactical action, Warfare,
+ * Bellum Gloriosum), then executed as the place presses + Done. Done opens the payment decision (payment.spend),
+ * returned in the answer's {@code opened}.
+ */
+public class ProductionProduceKind implements KindSpec {
+
+    @Override
+    public String kind() {
+        return "production.produce";
+    }
+
+    @Override
+    public int priority() {
+        return 100;
+    }
+
+    /** Classification: any option of the message claims it (Done buttons never do). */
+    @Override
+    public boolean classifies(List<String> handlerIds) {
+        for (String h : handlerIds) if (h != null && claims(h)) return true;
+        return false;
+    }
+
+    static boolean claims(String h) {
+        return h.startsWith("place_") && !h.startsWith("place_parturitionMonument_");
+    }
+
+    @Override
+    public boolean matches(String h) {
+        // Done Producing Units is deleteButtons_<context>_<pos>; only typed inside a production message.
+        return claims(h) || h.equals("resetProducedThings") || h.matches("deleteButtons_[A-Za-z0-9]+_[A-Za-z0-9]+");
+    }
+
+    @Override
+    public Map<String, Object> value(String h, CaptureContext ctx) {
+        Game game = ctx.game();
+        Player player = ctx.player();
+        Map<String, Object> v = new LinkedHashMap<>();
+        if (h.equals("resetProducedThings")) {
+            v.put("action", "reset");
+            return v;
+        }
+        if (h.startsWith("deleteButtons")) {
+            String rest = h.startsWith("deleteButtons_") ? h.substring("deleteButtons_".length()) : "";
+            String context = rest;
+            String pos = null;
+            int us = rest.lastIndexOf('_');
+            if (us > 0 && game.getTileByPosition(rest.substring(us + 1)) != null) {
+                context = rest.substring(0, us);
+                pos = rest.substring(us + 1);
+            }
+            v.put("action", "done");
+            v.put("context", context);
+            v.put("tile", pos);
+            if (player != null) {
+                Map<String, Integer> produced = new LinkedHashMap<>();
+                for (Map.Entry<String, Integer> e : player.getCurrentProducedUnits().entrySet())
+                    produced.merge(e.getKey().split("_")[0], e.getValue(), Integer::sum);
+                v.put("produced", produced);
+                v.put("unitCount", Helper.calculateCostOfProducedUnits(player, game, false));
+                v.put("cost", Helper.calculateCostOfProducedUnits(player, game, true));
+                v.put("productionLimit", productionLimit(game, player, context, pos));
+            }
+            return v;
+        }
+        Placement p = parse(h, game);
+        if (p == null) return null;
+        v.put("unit", p.unit);
+        v.put("count", p.count);
+        v.put("holder", p.holder);
+        v.put("tile", p.tile);
+        Float cost = unitCost(player, p.unit);
+        v.put("cost", cost);
+        return v;
+    }
+
+    record Placement(String unit, int count, String holder, String tile) {}
+
+    /** place_&lt;unitLong&gt;_&lt;where&gt; → async unit id, count, holder ("space" or planet id), tile position. */
+    @Nullable
+    static Placement parse(String h, Game game) {
+        String rest = h.substring(h.indexOf("place_") + "place_".length());
+        int us = rest.indexOf('_');
+        if (us <= 0) return null;
+        String unitLong = rest.substring(0, us);
+        String where = rest.substring(us + 1);
+        int count = unitLong.startsWith("2") ? 2 : 1;
+        String unit = AliasHandler.resolveUnit(unitLong.replace("2", ""));
+        if (where.startsWith("space")) return new Placement(unit, count, "space", where.substring("space".length()));
+        if (game.getTileByPosition(where) != null) return new Placement(unit, count, "space", where);
+        Tile t = game.getTileFromPlanet(where);
+        return new Placement(unit, count, where, t == null ? null : t.getPosition());
+    }
+
+    @Nullable
+    private static Float unitCost(@Nullable Player player, String asyncId) {
+        if (player == null) return null;
+        try {
+            List<UnitModel> models = player.getUnitsByAsyncID(asyncId);
+            return models.isEmpty() ? null : models.getFirst().getCost();
+        } catch (Exception e) {
+            return null;
+        }
+    }
+
+    /** The PRODUCTION limit the engine applies in this context; null where it does not know one. */
+    @Nullable
+    static Integer productionLimit(Game game, Player player, String context, @Nullable String pos) {
+        if ("solBtBuild".equalsIgnoreCase(context)) { // Bellum Gloriosum
+            for (String s : player.getSpentThingsThisWindow()) {
+                String[] a = s.split("_");
+                if (a.length > 2 && "solBtBuild".equalsIgnoreCase(a[0]) && a[2].matches("\\d+"))
+                    return Integer.parseInt(a[2]);
+            }
+            return null;
+        }
+        if (pos == null) return null;
+        Tile tile = game.getTileByPosition(pos);
+        if (tile == null) return null;
+        if ("tacticalAction".equals(context)) return Helper.getProductionValue(player, game, tile, false);
+        if ("warfare".equals(context)) return Helper.getProductionValue(player, game, tile, true);
+        return null;
+    }
+
+    @Override
+    public boolean dynamic() {
+        return true;
+    }
+
+    /**
+     * flow "production": accumulated = units produced so far in this window ({unit: count}, unitCount, cost) from the
+     * player's produced-units record; required = {productionLimit, context, tile}. canCommit always (build nothing is
+     * legal).
+     */
+    @Override
+    public Progress progress(CaptureContext ctx) {
+        Player player = ctx.player();
+        if (player == null) return null;
+        List<String> handlers = ctx.handlerIds();
+        if (handlers == null) {
+            String id = DecisionRegistry.decisionIdForMessage(ctx.messageId());
+            Decision d = id == null ? null : DecisionRegistry.get(id);
+            handlers = d == null ? List.of() : d.options().stream().map(Option::handler).toList();
+        }
+        String doneId = null;
+        for (String h : handlers) if (h != null && h.startsWith("deleteButtons_") && matches(h)) doneId = h;
+        Map<String, Object> done = doneId == null ? Map.of() : value(doneId, ctx);
+        Map<String, Object> acc = new LinkedHashMap<>();
+        acc.put("produced", done.get("produced"));
+        acc.put("unitCount", done.get("unitCount"));
+        acc.put("cost", done.get("cost"));
+        Map<String, Object> req = new LinkedHashMap<>();
+        req.put("productionLimit", done.get("productionLimit"));
+        req.put("context", done.get("context"));
+        req.put("tile", done.get("tile"));
+        return new Progress("production", "select_units", acc, req, true);
+    }
+
+    // ------------------------------------------------------------------ atomic production
+
+    @Override
+    public boolean acceptsPayload() {
+        return true;
+    }
+
+    @Override
+    public String answerPayload(PayloadAnswer a, Map<String, Object> payload) throws Exception {
+        Decision d = a.decision();
+        Game game = a.game();
+        Player player = a.player();
+        if (d == null || game == null || player == null) return "That production is no longer open.";
+        Option done = PaymentSupport.firstWith(d, "action", "done");
+        if (done == null) return "This production has no Done button.";
+
+        List<String> presses = new ArrayList<>();
+        int units = 0;
+        for (Object o : PaymentSupport.listOf(payload.get("units"))) {
+            if (!(o instanceof Map<?, ?> req)) return "Bad unit entry.";
+            String unit = AliasHandler.resolveUnit(String.valueOf(req.get("unit")));
+            Object holder = req.get("holder");
+            Object tile = req.get("tile");
+            int count = PaymentSupport.intOf(req.get("count"), 1);
+            if (count < 1 || count > 20) return "Bad count for " + unit + ".";
+            Option one = find(d, unit, 1, holder, tile);
+            Option two = find(d, unit, 2, holder, tile);
+            int left = count;
+            while (left > 0) {
+                if (left >= 2 && two != null) {
+                    presses.add(two.id());
+                    left -= 2;
+                } else if (one != null) {
+                    presses.add(one.id());
+                    left -= 1;
+                } else {
+                    return "Cannot produce " + (left == count ? "" : "that many ") + unit
+                            + (holder == null ? "" : " on " + holder) + " here.";
+                }
+            }
+            units += count;
+        }
+        Object limit = done.value().get("productionLimit");
+        int already = PaymentSupport.intOf(done.value().get("unitCount"), 0);
+        if (limit instanceof Number n && already + units > n.intValue())
+            return "That is " + (already + units) + " units; the production limit here is " + n.intValue() + ".";
+
+        for (String id : presses) a.press(id);
+        Player after = a.player();
+        Game g = a.game();
+        Decision latest = a.decision();
+        if (after != null && g != null && latest != null && !presses.isEmpty())
+            PaymentSupport.syncContent(latest, Helper.buildProducedUnitsMessage(after, g));
+        a.press(done.id());
+        return null;
+    }
+
+    @Nullable
+    private static Option find(Decision d, String unit, int count, Object holder, Object tile) {
+        for (Option o : d.options()) {
+            Map<String, Object> v = o.value();
+            if (v == null || o.disabled() || v.get("unit") == null) continue;
+            if (!unit.equals(v.get("unit")) || PaymentSupport.intOf(v.get("count"), 1) != count) continue;
+            if (holder != null && !String.valueOf(holder).equals(v.get("holder"))) continue;
+            if (tile != null && !String.valueOf(tile).equals(v.get("tile"))) continue;
+            return o;
+        }
+        return null;
+    }
+}
