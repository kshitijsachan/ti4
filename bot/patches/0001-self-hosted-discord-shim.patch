+package ti4.selfhost.engine.kinds;
+
+import java.util.List;
+import javax.annotation.Nullable;
+import ti4.selfhost.engine.KindSpec.CaptureContext;
+
+/**
+ * Clan of Saar: mech (saarMechRes_&lt;planet&gt;: pay 1 TG to place a mech after gaining a planet), hero Gurno Aggero
+ * (saarHeroResolution_&lt;pos&gt;), Ragh's Call (raghsCallStepOne_&lt;planet&gt; -&gt; raghsCallStepTwo_&lt;from&gt;_&lt;to&gt;;
+ * played by the holder), Chaos Mapping (startChaosMapping, on the turn menu). Agent: generic exhaustAgent_saaragent.
+ */
+public class FactionStepsSaar implements FactionSteps {
+    private static final String F = "saar";
+
+    @Override
+    @Nullable
+    public Step step(String h, @Nullable CaptureContext ctx) {
+        if (h.startsWith("saarMechRes_"))
+            return Step.ability(
+                    "mech", "saar_mech", F, "saarMechRes", "use", true,
+                    "planet", FactionSteps.at(FactionSteps.args(h, "saarMechRes_"), 0),
+                    "unit", "mf",
+                    "cost", 1);
+        if (h.startsWith("saarHeroResolution_"))
+            return Step.leader(
+                    "saarhero", "saarHeroResolution", "target", true,
+                    "tile", FactionSteps.at(FactionSteps.args(h, "saarHeroResolution_"), 0));
+        if (h.startsWith("raghsCallStepOne_"))
+            return Step.ability(
+                    "promissory", "ragh", F, "raghsCallStepOne", "use", true,
+                    "planet", FactionSteps.at(FactionSteps.args(h, "raghsCallStepOne_"), 0));
+        if (h.startsWith("raghsCallStepTwo_") && !h.contains("page")) {
+            List<String> a = FactionSteps.args(h, "raghsCallStepTwo_");
+            return Step.ability(
