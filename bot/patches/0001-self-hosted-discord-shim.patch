@@ -0,0 +1,67 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.List;
+import java.util.Map;
+import javax.annotation.Nullable;
+import ti4.game.Player;
+
+/**
+ * te.plot — the Firmament / Obsidian plot cards (Plots Within Plots, Marionettes). The cards-info plot panel
+ * (ActionCardHelper.getPlotCardButtons: addFactionTokenToPlot_&lt;plot&gt;, removeFactionTokenFromPlot_&lt;plot&gt;,
+ * scoreOtherPlayersSecrets) is a bookkeeping menu: its options carry panel=true and it is a background prompt (no
+ * one is waiting on it). Pressing a plot opens the faction picker addFactionTokenToPlot_&lt;plot&gt;_&lt;faction&gt; /
+ * removeFactionTokenFromPlot_&lt;plot&gt;_&lt;faction&gt; (panel=false). Obsidian plot reveals: Seethe
+ * (revealSeethe_&lt;faction&gt; → resolveSeethe_&lt;planet&gt;: eradicate a non-home planet of the puppet), Extract
+ * (revealExtract_&lt;faction&gt;: gain a technology of theirs).
+ *
+ * <p>Value {plot?, faction (firmament|obsidian), step, action, optional, target? (faction), planet?, panel,
+ * puppets? (factions already on that plot)}.
+ */
+public class TePlotKind extends TeTableKind {
+
+    public TePlotKind() {
+        ability("addFactionTokenToPlot_", "ability", "plotsplots", "firmament", "use", true, "plot", "target");
+        ability("removeFactionTokenFromPlot_", "ability", "plotsplots", "firmament", "use", true, "plot", "target");
+        ability("scoreOtherPlayersSecrets", "ability", "plotsplots", "firmament", "use", true);
+        ability("revealSeethe_", "ability", "marionettes", "obsidian", "target", false, "target");
+        ability("resolveSeethe_", "ability", "marionettes", "obsidian", "target", false, "planet");
+        ability("revealExtract_", "ability", "marionettes", "obsidian", "target", false, "target");
+    }
+
+    @Override
+    public String kind() {
+        return "te.plot";
+    }
+
+    @Override
+    protected String idKey() {
+        return "ability";
+    }
+
+    /** An option of the bookkeeping panel (not a picker step). */
+    static boolean panel(String handlerId) {
+        if (handlerId.equals("scoreOtherPlayersSecrets")) return true;
+        if (!handlerId.startsWith("addFactionTokenToPlot_") && !handlerId.startsWith("removeFactionTokenFromPlot_"))
+            return false;
+        return handlerId.indexOf('_', handlerId.indexOf('_') + 1) < 0;
+    }
+
+    @Override
+    @Nullable
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        Map<String, Object> v = super.value(handlerId, ctx);
+        if (v == null) return null;
+        v.put("panel", panel(handlerId));
+        Object plot = v.get("plot");
+        Player p = ctx.player();
+        if (plot instanceof String id && p != null) {
+            List<String> puppets = p.getPuppetedFactionsForPlot(id);
+            v.put("puppets", puppets == null ? List.of() : List.copyOf(puppets));
+        }
+        if (v.get("planet") instanceof String s && s.startsWith("page")) {
+            v.remove("planet");
+            v.put("page", s);
+        }
+        return v;
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/TeStepTable.java b/src/main/java/ti4/selfhost/engine/kinds/TeStepTable.java
new file mode 100644
index 0000000..4e3e8bb
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/TeStepTable.java
@@ -0,0 +1,144 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import javax.annotation.Nullable;
+import ti4.selfhost.engine.KindSpec.CaptureContext;
+
+/**
+ * Table-driven typing of Thunder's Edge prompts (c5): the TE factions' FactionSteps providers (c1's shared
+ * leader.use / faction.ability kinds) and the TE-specific kinds (te.breakthrough, te.breach). Not a KindSpec and not a
+ * FactionSteps itself.
+ *
+ * <p>A row: handler prefix (longest match wins), leader id (leader.use) or source + component id (faction.ability),
+ * the faction, action (use / target / skip), optional, and the id's '_'-separated fields after the prefix. Field
+ * names: tile / from / to (tile positions), planet, holder ("space" or a planet id), unit (async id), target (a
+ * faction or colour → faction id), amount / count (numbers), card, tech, choice, dir. A name ending in '*' takes the
+ * rest of the id (joined with '_'). The step name is the prefix without its trailing '_'. Action "undo" marks the
+ * take-back buttons of the TE move-units flows (undoSurvival_ / undoForerunner_ / undoOjzRetreatS1_): neither a
+ * choice nor a way to finish, so a policy never loops on them. (te.plot is TePlotKind, on the same table.)
+ */
+abstract class TeStepTable {
+
+    /** One typed option: leader (component = leader id) or ability (source + component id). */
+    record TeStep(
+            boolean leader,
+            String source,
+            String component,
+            @Nullable String faction,
+            String step,
+            String action,
+            boolean optional,
+            Map<String, Object> fields) {
+
+        /** Value map of a TE-specific kind: {&lt;idKey&gt;: component, faction, step, action, optional, fields...}. */
+        Map<String, Object> value(String idKey) {
+            Map<String, Object> v = new LinkedHashMap<>();
+            v.put(idKey, component);
+            v.put("faction", faction);
+            v.put("step", step);
+            v.put("action", action);
+            v.put("optional", optional);
+            v.putAll(fields);
+            return v;
+        }
+    }
+
+    record Row(
+            String prefix,
+            boolean leader,
+            String source,
+            String component,
+            @Nullable String faction,
+            String action,
+            boolean optional,
+            String[] fields) {}
+
+    private final List<Row> rows = new ArrayList<>();
+    private boolean sorted;
+
+    /** A leader row. */
+    protected final void leader(String prefix, String leaderId, String action, boolean optional, String... fields) {
+        rows.add(new Row(prefix, true, "leader", leaderId, null, action, optional, fields));
+    }
+
+    /** A faction.ability row (source: ability | tech | promissory | mech | flagship | breakthrough | unit). */
+    protected final void ability(
+            String prefix,
+            String source,
+            String component,
+            @Nullable String faction,
+            String action,
+            boolean optional,
+            String... fields) {
+        rows.add(new Row(prefix, false, source, component, faction, action, optional, fields));
+    }
+
+    private List<Row> rows() {
+        if (!sorted) {
+            synchronized (this) {
+                rows.sort(Comparator.comparingInt((Row r) -> r.prefix().length()).reversed());
+                sorted = true;
+            }
+        }
+        return rows;
+    }
+
+    @Nullable
+    TeStep teStep(String h, @Nullable CaptureContext ctx) {
+        for (Row r : rows()) {
+            if (!h.startsWith(r.prefix())) continue;
+            String rest = h.substring(r.prefix().length());
+            // An exact-name prefix ("useTheIcon") must not swallow a longer unrelated id ("useTheIconography").
+            String px = r.prefix();
+            if (!rest.isEmpty()
+                    && Character.isLetterOrDigit(px.charAt(px.length() - 1))
+                    && Character.isLetterOrDigit(rest.charAt(0))) continue;
+            String step = r.prefix().replaceAll("[_;]+$", "");
+            return new TeStep(
+                    r.leader(), r.source(), r.component(), r.faction(), step, r.action(), r.optional(),
+                    fields(r, rest, ctx));
+        }
+        return null;
+    }
+
+    private static Map<String, Object> fields(Row r, String rest, @Nullable CaptureContext ctx) {
+        if (rest.startsWith("_") || rest.startsWith(";")) rest = rest.substring(1);
+        List<String> a = rest.isEmpty() ? List.of() : List.of(rest.split("_"));
+        Map<String, Object> m = new LinkedHashMap<>();
+        String[] f = r.fields();
+        for (int i = 0; i < f.length && i < a.size(); i++) {
+            String name = f[i];
+            String seg = a.get(i);
+            if (name.endsWith("*")) {
+                name = name.substring(0, name.length() - 1);
+                seg = String.join("_", a.subList(i, a.size()));
+            }
+            if (seg.isEmpty()) continue;
+            m.put(name, typed(name, seg, ctx));
+        }
+        if (a.size() > f.length && (f.length == 0 || !f[f.length - 1].endsWith("*"))) m.put("args", a);
+        return m;
+    }
+
+    private static Object typed(String name, String seg, @Nullable CaptureContext ctx) {
+        return switch (name) {
+            case "target" -> {
+                if (ctx == null || ctx.game() == null) yield seg;
+                ti4.game.Player p = ctx.game().getPlayerFromColorOrFaction(seg);
+                yield p == null ? seg : p.getFaction();
+            }
+            case "amount", "count", "strategyCard" -> {
+                try {
+                    yield Integer.parseInt(seg);
+                } catch (NumberFormatException e) {
+                    yield seg;
+                }
+            }
+            default -> seg;
+        };
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/TeTableKind.java b/src/main/java/ti4/selfhost/engine/kinds/TeTableKind.java
new file mode 100644
index 0000000..d6678ec
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/TeTableKind.java
@@ -0,0 +1,95 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.List;
+import java.util.Map;
+import javax.annotation.Nullable;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.selfhost.engine.EngineModels.Decision;
+import ti4.selfhost.engine.EngineModels.Target;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * Base of the table-driven Thunder's Edge kinds (te.breakthrough, te.breach, te.plot). Abstract: the kind scan skips
+ * it. A message is the kind only when EVERY option is one of its rows or chrome (Decline / Done = deleteButtons*,
+ * UNDO, pagination), so shortcuts that ride on other areas' menus (turn menu, tactical menus, cards-info menu) stay
+ * with those kinds. Owner-locked (FFCC_) options of another faction are refused ({@link TeKinds#ownerLockError}).
+ */
+abstract class TeTableKind extends TeStepTable implements KindSpec {
+
+    /** The value key that names the component (e.g. "breakthrough"). */
+    protected abstract String idKey();
+
+    @Override
+    public int priority() {
+        return 90;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return teStep(handlerId, null) != null;
+    }
+
+    static boolean chrome(String h) {
+        return h.startsWith("deleteButtons")
+                || h.startsWith("ultimateUndo")
+                || h.startsWith("deleteThis")
+                || h.equals("deleteMessage")
+                || h.contains("page");
+    }
+
+    @Override
+    public boolean classifies(List<String> handlerIds) {
+        boolean any = false;
+        for (String h : handlerIds) {
+            if (h == null) return false;
+            if (matches(h)) {
+                any = true;
+                continue;
+            }
+            if (!chrome(h)) return false;
+        }
+        return any;
+    }
+
+    @Override
+    @Nullable
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        TeStep s = teStep(handlerId, ctx);
+        return s == null ? null : s.value(idKey());
+    }
+
+    /** Who owns the component when the generic resolver found nobody (no FFCC_, actions channel). */
+    @Nullable
+    protected Player owner(Game game, TeStep s) {
+        if (s.faction() == null) return null;
+        Player p = game.getPlayerFromColorOrFaction(s.faction());
+        return p != null && p.isRealPlayer() ? p : null;
+    }
+
+    @Override
+    @Nullable
+    public Target target(CaptureContext ctx, @Nullable Target resolved) {
+        if (resolved != null && resolved.userId() != null && !"mention".equals(resolved.resolvedBy())) return resolved;
+        List<String> hs = ctx.handlerIds();
+        if (hs == null || ctx.game() == null) return resolved;
+        for (String h : hs) {
+            TeStep s = h == null ? null : teStep(h, null);
+            if (s == null) continue;
+            Player p = owner(ctx.game(), s);
+            if (p != null) return TeKinds.target(p, "faction_component");
+        }
+        return resolved;
+    }
+
+    @Override
+    public String scope(CaptureContext ctx) {
+        return "player";
+    }
+
+    @Override
+    @Nullable
+    public String validate(Game game, Player answering, Decision decision, String optionId) {
+        return TeKinds.ownerLockError(answering, optionId);
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/TeVisionariaKind.java b/src/main/java/ti4/selfhost/engine/kinds/TeVisionariaKind.java
new file mode 100644
index 0000000..51c7727
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/TeVisionariaKind.java
@@ -0,0 +1,119 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.selfhost.engine.EngineModels.Decision;
+import ti4.selfhost.engine.EngineModels.ReactionWindow;
+import ti4.selfhost.engine.EngineModels.Target;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * Thunder's Edge, Deepwrought breakthrough Visionaria Select (VisionariaSelectService.postInitialButtons): a table
+ * window in the main channel. Every other player answers once: acquireATechWithDwsBt (research for 3 trade goods and
+ * give Deepwrought a promissory note), giveVisionariaPN, or declineVisionaria; the active (Deepwrought) player may
+ * preset FFCC_&lt;f&gt;_fleetLogAfterVisionaria / endTurnAfterVisionaria. The game moves on only when everyone has
+ * responded, so an unanswered window stalls the turn.
+ *
+ * <p>value.respondent: whether the option is a response (vs the owner's preset). Who still has to answer is
+ * {@code window}.
+ */
+public class TeVisionariaKind implements KindSpec {
+
+    @Override
+    public String kind() {
+        return "te.visionaria.respond";
+    }
+
+    @Override
+    public int priority() {
+        return 100;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return handlerId.startsWith("acquireATechWithDwsBt")
+                || handlerId.equals("giveVisionariaPN")
+                || handlerId.equals("declineVisionaria")
+                || handlerId.equals("fleetLogAfterVisionaria")
+                || handlerId.equals("endTurnAfterVisionaria");
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        if (!matches(handlerId)) return null;
+        Map<String, Object> v = new LinkedHashMap<>();
+        String choice = handlerId.startsWith("acquireATechWithDwsBt")
+                ? "research"
+                : switch (handlerId) {
+                    case "giveVisionariaPN" -> "give_promissory";
+                    case "declineVisionaria" -> "decline";
+                    case "fleetLogAfterVisionaria" -> "wait_for_all";
+                    default -> "end_turn_after_all";
+                };
+        v.put("choice", choice);
+        v.put("respondent", !handlerId.endsWith("AfterVisionaria"));
+        return v;
+    }
+
+    static List<String> responded(Game game) {
+        List<String> out = new ArrayList<>();
+        for (String f : game.getStoredValue("VisionariaResponded").split("\\|")) if (!f.isBlank()) out.add(f);
+        return out;
+    }
+
+    /** Everyone answers for themself; no single target. */
+    @Override
+    public Target target(CaptureContext ctx, Target resolved) {
+        return new Target(null, null, null, "none");
+    }
+
+    /**
+     * Every real player is eligible; Deepwrought (the owner) answers with a "move along" preset, the others with a
+     * response. responded: players whose faction the engine recorded as responded (VisionariaResponded), except
+     * Deepwrought, which the engine records up front.
+     */
+    @Override
+    public ReactionWindow window(CaptureContext ctx) {
+        Game game = ctx.game();
+        List<String> factions = responded(game);
+        List<String> eligible = new ArrayList<>();
+        List<String> done = new ArrayList<>();
+        String owner = null;
+        for (Player p : game.getRealPlayers()) {
+            eligible.add(p.getUserID());
+            if (p.hasBreakthrough("deepwroughtbt")) owner = p.getUserID();
+            else if (factions.contains(p.getFaction())) done.add(p.getUserID());
+        }
+        // The engine clears the record once everyone has answered: the window is over.
+        if (factions.isEmpty()) done = new ArrayList<>(eligible);
+        Map<String, Object> subject = new LinkedHashMap<>();
+        subject.put("breakthrough", "deepwroughtbt");
+        subject.put("owner", owner);
+        return new ReactionWindow("visionaria", subject, eligible, done, Map.of());
+    }
+
+    @Override
+    public boolean dynamic() {
+        return true;
+    }
+
+    @Override
+    public String scope(CaptureContext ctx) {
+        return "table";
+    }
+
+    @Override
+    public String validate(Game game, Player answering, Decision decision, String optionId) {
+        String err = TeKinds.ownerLockError(answering, optionId);
+        if (err != null) return err;
+        if (optionId.endsWith("AfterVisionaria")) return null;
+        if (game.getStoredValue("VisionariaResponded").isEmpty()) return "Visionaria Select is over.";
+        if (answering.hasBreakthrough("deepwroughtbt")) return "Visionaria Select is yours; the others respond.";
+        if (responded(game).contains(answering.getFaction())) return "You already responded to Visionaria Select.";
+        return null;
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/TechGainKind.java b/src/main/java/ti4/selfhost/engine/kinds/TechGainKind.java
new file mode 100644
index 0000000..b780c32
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/TechGainKind.java
@@ -0,0 +1,100 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.selfhost.engine.EngineModels.SetupPlayer;
+import ti4.selfhost.engine.EngineModels.SetupState;
+import ti4.selfhost.engine.EngineModels.Target;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * Gain a technology: getTech_&lt;alias&gt;[__&lt;payment&gt;][__comp][__noPay]... (PlayerTechService.getTech). The setup
+ * "choose your starting technology" prompt is this kind with free=true in round 1 (value.starting).
+ */
+public class TechGainKind implements KindSpec {
+
+    @Override
+    public String kind() {
+        return "tech.gain";
+    }
+
+    @Override
+    public int priority() {
+        return 50;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return handlerId.startsWith("getTech_");
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        if (!matches(handlerId)) return null;
+        List<String> parts = new ArrayList<>(Arrays.asList(handlerId.substring("getTech_".length()).split("__")));
+        String tech = parts.removeFirst();
+        boolean free = parts.contains("noPay") || parts.contains("shareKnowledge");
+        Map<String, Object> v = new LinkedHashMap<>();
+        v.put("tech", tech);
+        v.put("free", free);
+        v.put("starting", free && ctx.game().getRound() <= 1 && !"action".equals(ctx.game().getPhaseOfGame()));
+        v.put("flags", parts);
+        // G2: what the technology is (type: PROPULSION/BIOTIC/CYBERNETIC/WARFARE/UNITUPGRADE; requirements e.g. "GG").
+        try {
+            ti4.model.TechnologyModel m = ti4.image.Mapper.getTech(tech);
+            v.put("type", m == null || m.getType() == null ? null : m.getType().toString());
+            v.put("requirements", m == null ? null : m.getRequirements().orElse(""));
+            v.put("factionTech", m != null && m.getFaction().isPresent());
+        } catch (Exception e) {
+            v.put("type", null);
+        }
+        return v;
+    }
+
+    /** Faction / colour are picked during setup, and a prompt without owner prefix may name its player only in text. */
+    @Override
+    public boolean dynamic() {
+        return true;
+    }
+
+    /**
+     * The generic target (refreshed: faction / colour may have been picked since capture). Without one (live: setup
+     * starting-tech prompts in the actions channel resolved "none"): the one player the prompt text names by faction
+     * emoji / colour, else, during setup, the one player still owing starting technologies.
+     */
+    @Override
+    public Target target(CaptureContext ctx, Target resolved) {
+        if (resolved != null && resolved.userId() != null) return SetupKindSupport.refresh(ctx, resolved);
+        Game game = ctx.game();
+        String text = ctx.content() == null ? "" : ctx.content().toLowerCase(java.util.Locale.ROOT);
+        Player named = null;
+        int hits = 0;
+        for (Player p : game.getPlayers().values()) {
+            if (p == null || p.isDummy()) continue;
+            String f = p.getFaction() == null ? "" : p.getFaction().toLowerCase(java.util.Locale.ROOT);
+            String c = p.getColor() == null ? "" : p.getColor().toLowerCase(java.util.Locale.ROOT);
+            boolean byFaction = !f.isBlank() && !"null".equals(f) && text.contains("<:" + f + ":");
+            boolean byColor = !c.isBlank() && !"null".equals(c) && text.contains("**" + c + "**");
+            if (byFaction || byColor) {
+                named = p;
+                hits++;
+            }
+        }
+        if (hits == 1) return ti4.selfhost.engine.DecisionCapture.target(named, "prompt_text");
+        SetupState setup = ti4.selfhost.engine.SetupStateBuilder.build(game);
+        if (setup != null) {
+            List<String> owing = new ArrayList<>();
+            for (SetupPlayer sp : setup.players()) if (sp.startingTechsNeeded() > 0) owing.add(sp.userId());
+            if (owing.size() == 1) {
+                Player p = game.getPlayer(owing.getFirst());
+                if (p != null) return ti4.selfhost.engine.DecisionCapture.target(p, "setup_state");
+            }
+        }
+        return resolved;
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/TechStepKind.java b/src/main/java/ti4/selfhost/engine/kinds/TechStepKind.java
new file mode 100644
index 0000000..1f4a464
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/TechStepKind.java
@@ -0,0 +1,95 @@
+package ti4.selfhost.engine.kinds;
+
+import static ti4.selfhost.engine.kinds.ChooseSupport.rule;
+
+import java.util.List;
+import java.util.Map;
+import java.util.function.BiConsumer;
+import ti4.image.Mapper;
+import ti4.model.TechnologyModel;
+import ti4.selfhost.engine.KindSpec.CaptureContext;
+
+/**
+ * The follow-up prompts of generic (non-faction) technologies: what a tech asks after it is exhausted / triggered
+ * (PlayerTechService.exhaustTechAndResolve and the tech-specific handlers). Built on the choose.* machinery
+ * ({@link ChooseSupport}): one rule per handler-id shape, value {source: tech alias, techName, step, ...groups}.
+ *
+ * <pre>
+ * exhaustTech_&lt;tech&gt;                    {step:"exhaust", source:tech}   a standalone "exhaust X" offer (Graviton before
+ *                                           SPACE CANNON, end-of-turn offers posted alone); menus mixing it with other
+ *                                           things stay with their kind (payment, turn, combat, component action)
+ * biostimsReady_tech_&lt;t&gt; / _planet_&lt;p&gt;  {source:"bs", step:"ready", tech | planet}       Bio-Stims
+ * transitDiodes_&lt;planet&gt;               {source:"td", step:"destination", planet}           Transit Diodes
+ * produceOneUnitInTile_&lt;pos&gt;_sling      {source:"sr", step:"system", tile}                  Sling Relay (+ cards
+ *                                           that reuse its "produce 1 ship in a space dock system" step)
+ * sarMechStep2_&lt;planet&gt;_&lt;ctx&gt;          {source:"sar", step:"planet", planet}               Self-Assembly Routines
+ * integratedBuild_&lt;planet&gt;             {source:"ie", step:"use", planet}                   Integrated Economy offer
+ * magenHit_&lt;planet&gt;                    {source:"md", step:"use", planet}                   Magen Defense Grid offer
+ * hitOpponentGround_&lt;planet&gt;_&lt;unit&gt;_&lt;color&gt;_&lt;src&gt;  {source:"ground_hit", step:"target", planet, unit, color,
+ *                                           choice:src}  the unit Magen / Ruthless / Stealth Corps hits
+ * dacxive_&lt;planet&gt;                     {source:"dxa", step:"use", planet}                  Dacxive Animators offer
+ * getPsychoButtons                       {source:"pa", step:"open"}                          Psychoarchaeology
+ * psychoExhaust_&lt;planet&gt;               {source:"pa", step:"exhaust_planet", planet}        (exhaust for 1 TG)
+ * acquireATech[_deleteThisMessage] / acquireATechWithSC_second / acquireAUnitTechWithInf
+ *                                        {source:"research", step:"research", unitUpgradeOnly}  "Get a Technology"
+ * entropicScar_&lt;tech&gt;                  {source:"entropicscar", step:"gain", tech}          Entropic Scar (status)
+ * </pre>
+ *
+ * Declines (deleteButtons / "No ..." / Done) have value null. Faction technologies' own steps belong to the faction
+ * kinds; homebrew (Absol, Discordant Stars, Twilight's Fall) is not typed here.
+ */
+public class TechStepKind extends ChooseKindBase {
+
+    /** Adds techName for the source tech and the tech named in the id (group {@code tech}). */
+    private static final BiConsumer<Map<String, Object>, CaptureContext> NAMES = (v, ctx) -> {
+        TechnologyModel src = Mapper.getTech(String.valueOf(v.get("source")));
+        if (src != null) v.put("techName", src.getName());
+        if (v.get("tech") instanceof String t) {
+            TechnologyModel tm = Mapper.getTech(t);
+            v.put("targetTechName", tm == null ? t : tm.getName());
+        }
+    };
+
+    /** exhaustTech_: the source is the tech in the id. */
+    private static final BiConsumer<Map<String, Object>, CaptureContext> EXHAUSTED = (v, ctx) -> {
+        v.put("source", v.get("tech"));
+        TechnologyModel tm = Mapper.getTech(String.valueOf(v.get("tech")));
+        v.put("techName", tm == null ? v.get("tech") : tm.getName());
+        v.remove("targetTechName");
+    };
+
+    public static final List<ChooseSupport.Rule> RULES = List.of(
+            // c9b: AI Development Algorithm's production discount is exhaustTech_aida_discount (same tech, discount use)
+            rule("tech", "exhaustTech_(?<tech>.+)_discount", Map.of("step", "exhaust", "use", "discount"), EXHAUSTED),
+            rule("tech", "exhaustTech_(?<tech>.+)", Map.of("step", "exhaust"), EXHAUSTED),
+            rule("bs", "biostimsReady_tech_(?<tech>.+)", Map.of("step", "ready", "target", "tech"), NAMES),
+            rule("bs", "biostimsReady_planet_(?<planet>.+)", Map.of("step", "ready", "target", "planet"), NAMES),
+            rule("td", "transitDiodes_(?<planet>.+)", Map.of("step", "destination"), NAMES),
+            rule("sr", "produceOneUnitInTile_(?<tile>[^_]+)_sling", Map.of("step", "system"), NAMES),
+            rule("sar", "sarMechStep2_(?<planet>[^_]+)_.*", Map.of("step", "planet"), NAMES),
+            rule("ie", "integratedBuild_(?<planet>.+)", Map.of("step", "use"), NAMES),
+            rule("md", "magenHit_(?<planet>.+)", Map.of("step", "use"), NAMES),
+            rule(
+                    "ground_hit",
+                    "hitOpponentGround_(?<planet>[^_]+)_(?<unit>[^_]+)_(?<color>[^_]+)_(?<choice>.+)",
+                    Map.of("step", "target")),
+            rule("dxa", "dacxive_(?<planet>.+)", Map.of("step", "use"), NAMES),
+            rule("pa", "getPsychoButtons", Map.of("step", "open"), NAMES),
+            rule("pa", "psychoExhaust_(?<planet>.+)", Map.of("step", "exhaust_planet"), NAMES),
+            rule(
+                    "research",
+                    "acquireATech(?:_|_deleteThisMessage)?|acquireATechWithSC_second",
+                    Map.of("step", "research", "unitUpgradeOnly", false)),
+            rule("research", "acquireAUnitTechWithInf", Map.of("step", "research", "unitUpgradeOnly", true)),
+            rule("entropicscar", "entropicScar_(?<tech>.+)", Map.of("step", "gain"), NAMES));
+
+    @Override
+    public String kind() {
+        return "tech.step";
+    }
+
+    @Override
+    protected List<ChooseSupport.Rule> rules() {
+        return RULES;
+    }
+}
