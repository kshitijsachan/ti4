+        ModalListener self = getInstance();
+        String gameName = GameNameService.getGameNameFromChannel(event);
+        HandlerRegistry.Route<ModalContext> route = self.registry.resolve(event.getModalId());
+        if (gameName == null) {
+            self.handleModal(event, route);
