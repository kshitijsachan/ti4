@@ -0,0 +1,67 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.selfhost.engine.EngineModels.Decision;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * Imperial primary scoring options on the Imperial strategy card prompt: score_imperial (1 VP for controlling Mecatol
+ * Rex) and scoreAnObjective (opens a "score a public objective" list, typed as status.score with an owner). Low
+ * priority on purpose: when the strategy-card area types that prompt (sc_follow_8 …) it owns the message and these
+ * stay untyped there; this kind only applies when no higher kind claims it.
+ *
+ * <p>value {action: "score_imperial", controlsMecatol: [userId]} | {action: "score_public_list"}.
+ */
+public class ImperialScoreKind implements KindSpec {
+
+    @Override
+    public String kind() {
+        return "status.imperial";
+    }
+
+    @Override
+    public int priority() {
+        return 20;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return "score_imperial".equals(handlerId) || "scoreAnObjective".equals(handlerId);
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        Map<String, Object> v = new LinkedHashMap<>();
+        if ("scoreAnObjective".equals(handlerId)) {
+            v.put("action", "score_public_list");
+            return v;
+        }
+        v.put("action", "score_imperial");
+        java.util.List<String> who = new java.util.ArrayList<>();
+        for (Player p : ctx.game().getRealPlayers()) {
+            try {
+                if (p.controlsMecatol(true)) who.add(p.getUserID());
+            } catch (Exception ignored) {
+                // best effort
+            }
+        }
+        v.put("controlsMecatol", who);
+        return v;
+    }
+
+    @Override
+    public String scope(CaptureContext ctx) {
+        return "table";
+    }
+
+    @Override
+    public String validate(Game game, Player answering, Decision decision, String optionId) {
+        String h = StatusScoreKind.handlerOf(decision, optionId);
+        if ("score_imperial".equals(h) && !answering.controlsMecatol(true))
+            return "Only the player who controls Mecatol Rex may score the Imperial point.";
+        return null;
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/InfoMenuSplit.java b/src/main/java/ti4/selfhost/engine/kinds/InfoMenuSplit.java
new file mode 100644
index 0000000..d931638
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/InfoMenuSplit.java
@@ -0,0 +1,104 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.List;
+import java.util.Map;
+import javax.annotation.Nullable;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * The player's perpetual info menu ("You may use these buttons to do various things": cards info, map view, notepad,
+ * transaction, modify units, player settings…) is not a decision (DecisionCapture.isInfoMenu). It stopped counting as
+ * info as soon as ONE action shortcut rode on it — "Use Nekro Agent" (exhaustAgent_), "Use Keleres Agent on someone
+ * else" (getAgentSelection_), "Galvanize Units" (getToggleGalvanizeTiles), "Convert Commodities With Space Station"
+ * (startTradeStationConvert), "Use Law's Order" (useLawsOrder), Mentak's pillage preference
+ * (setwillPillageOwnTransactions_) — and the whole menu became a legacy decision.
+ *
+ * <p>Split: the menu stays a non-decision ({@code ui.info_menu}: never "waiting on me", never awaited, bots ignore
+ * it), and each shortcut is an optional typed option {@code {action: "shortcut", shortcut, ref}} the player may
+ * press. What a shortcut then asks (e.g. the agent's target) is the component-action owner's kind (leader.use, c6);
+ * this kind only claims the menu message, and only when it carries at least one read-only info option, so the
+ * shortcut's own prompts are never claimed here.
+ */
+public class InfoMenuSplit implements KindSpec {
+
+    public static final String KIND = "ui.info_menu";
+
+    @Override
+    public String kind() {
+        return KIND;
+    }
+
+    /** Above the component-action kinds: a menu with an agent shortcut is still the menu, not an agent prompt. */
+    @Override
+    public int priority() {
+        return 95;
+    }
+
+    @Override
+    public boolean matches(String h) {
+        return shortcut(h) != null;
+    }
+
+    /**
+     * Info menu with shortcuts: every option is read-only, a menu companion (getModifyTiles, purgeOverrule, round
+     * summaries, presets, player setup, dismiss, undo) or a shortcut; at least one read-only option and one shortcut.
+     */
+    @Override
+    public boolean classifies(List<String> handlerIds) {
+        boolean info = false, shortcut = false;
+        for (String h : handlerIds) {
+            if (h == null) return false;
+            if (shortcut(h) != null) {
+                shortcut = true;
+                continue;
+            }
+            if (companion(h)) continue;
+            if (!UiAffordanceKind.readOnly(h)) return false;
+            info = true;
+        }
+        return info && shortcut;
+    }
+
+    @Override
+    public boolean typesOption(String h) {
+        return shortcut(h) != null || UiOptionalKind.action(h) != null;
+    }
+
+    @Override
+    @Nullable
+    public Map<String, Object> value(String h, CaptureContext ctx) {
+        String s = shortcut(h);
+        if (s != null) {
+            Map<String, Object> v = UiAffordanceKind.v("shortcut", null, UiAffordanceKind.ref(h));
+            v.put("shortcut", s);
+            return v;
+        }
+        String a = UiOptionalKind.action(h);
+        return a == null ? null : UiAffordanceKind.v(a, null, UiAffordanceKind.ref(h));
+    }
+
+    /** The action shortcuts that ride on the info menu, null for anything else. */
+    @Nullable
+    static String shortcut(String h) {
+        if (h.startsWith("exhaustAgent_")) return "exhaust_agent";
+        if (h.startsWith("getAgentSelection_")) return "agent_selection";
+        if (h.equals("getToggleGalvanizeTiles")) return "galvanize";
+        if (h.startsWith("startTradeStationConvert")) return "trade_station_convert";
+        if (h.equals("useLawsOrder")) return "laws_order";
+        // Mentak's pillage preference rides on the menu all game: a setting, not a question (player.preference
+        // types it when it is posted on its own).
+        if (h.startsWith("setwillPillageOwnTransactions_")) return "pillage_preference";
+        return null;
+    }
+
+    private static boolean companion(String h) {
+        return h.equals("getModifyTiles")
+                || h.equals("purgeOverrule")
+                || h.startsWith("editRoundSummary_")
+                || h.equals("editEndOfRoundSummaries")
+                || h.startsWith("startPlayerSetup")
+                || h.startsWith("removePreset_")
+                || UiAffordanceKind.isDismiss(h)
+                || h.startsWith("ultimateUndo_");
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/KeleresFlavorKind.java b/src/main/java/ti4/selfhost/engine/kinds/KeleresFlavorKind.java
new file mode 100644
index 0000000..cb3ff89
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/KeleresFlavorKind.java
@@ -0,0 +1,136 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.Map;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.selfhost.engine.EngineModels.Decision;
+import ti4.selfhost.engine.KindSpec;
+import ti4.service.milty.MiltyDraftManager;
+
+/**
+ * Which Keleres to play (Mentak / Xxcha / Argent flavour). Two prompts, both in the Keleres drafter's cards-info
+ * thread and without an owner prefix:
+ *
+ * <ul>
+ *   <li>during the draft: draftPresetKeleres_&lt;flavor&gt; (preset; can be changed; gray "🛑" when that faction is
+ *       still in the draft) — value.preset = true;
+ *   <li>after the draft, when no valid preset exists: setupStep5_&lt;uid&gt;_keleres&lt;m|x|a&gt;_null_&lt;pos&gt;_&lt;yes|no&gt;
+ *       (sets the player up) — value.preset = false.
+ * </ul>
+ *
+ * value: {flavor: "mentak"|"xxcha"|"argent", faction: "keleresm"|…, preset, contested (that faction is drafted or
+ * still on the draft board), homePosition, speaker}. Target: the cards-info thread's owner; validate also checks
+ * the user the setupStep5 id names (the handler sets up that user, whoever presses).
+ */
+public class KeleresFlavorKind implements KindSpec {
+    private static final Pattern SETUP =
+            Pattern.compile("setupStep5_(\\d+)_keleres([mxa])_null_([^_]+)_(yes|no)");
+    private static final Pattern PRESET = Pattern.compile("draftPresetKeleres_(mentak|xxcha|argent)");
+
+    @Override
+    public String kind() {
+        return "setup.keleres_flavor";
+    }
+
+    @Override
+    public int priority() {
+        return 110;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return SETUP.matcher(handlerId).matches() || PRESET.matcher(handlerId).matches();
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        Matcher s = SETUP.matcher(handlerId);
+        if (s.matches()) {
+            String flavor = flavorOf(s.group(2));
+            return SetupKindSupport.map(
+                    "flavor", flavor,
+                    "faction", "keleres" + s.group(2),
+                    "preset", false,
+                    "contested", contested(ctx.game(), flavor),
+                    "homePosition", s.group(3),
+                    "speaker", "yes".equals(s.group(4)));
+        }
+        Matcher p = PRESET.matcher(handlerId);
+        if (!p.matches()) return null;
+        String flavor = p.group(1);
+        return SetupKindSupport.map(
+                "flavor", flavor,
+                "faction", "keleres" + flavor.charAt(0),
+                "preset", true,
+                "contested", contested(ctx.game(), flavor),
+                "homePosition", null,
+                "speaker", null);
+    }
+
+    @Override
+    public String scope(CaptureContext ctx) {
+        return "player";
+    }
+
+    @Override
+    public String validate(Game game, Player answering, Decision decision, String optionId) {
+        Matcher s = SETUP.matcher(SetupKindSupport.handlerOf(decision, optionId));
+        if (s.matches() && !s.group(1).equals(answering.getUserID())) return "That choice is for another player.";
+        return null;
+    }
+
+    private static String flavorOf(String letter) {
+        return switch (letter) {
+            case "m" -> "mentak";
+            case "x" -> "xxcha";
+            default -> "argent";
+        };
+    }
+
+    /** That flavour's faction is drafted by someone, or still on the draft board. */
+    private static boolean contested(Game game, String flavor) {
+        MiltyDraftManager m = game.getMiltyDraftManager();
+        if (m == null) return false;
+        return m.isFactionTaken(flavor) || (!m.isFinished() && m.getFactionDraft().contains(flavor));
+    }
+
+    /** Setup: faction / colour are picked after capture; re-resolve the target on every state change. */
+    @Override
+    public boolean dynamic() {
+        return true;
+    }
+
+    @Override
+    public ti4.selfhost.engine.EngineModels.Target target(
+            CaptureContext ctx, ti4.selfhost.engine.EngineModels.Target resolved) {
+        if (resolved != null && resolved.userId() != null) return SetupKindSupport.refresh(ctx, resolved);
+        // setupStep5_<user id>_keleres…: the id names the player it sets up.
+        java.util.List<String> ids = SetupKindSupport.handlerIds(ctx);
+        if (ids != null && ctx.game() != null) {
+            for (String h : ids) {
+                Matcher s = h == null ? null : SETUP.matcher(h);
+                if (s == null || !s.matches()) continue;
+                Player p = ctx.game().getPlayer(s.group(1));
+                if (p != null) return ti4.selfhost.engine.DecisionCapture.target(p, "handler_id");
+            }
+        }
+        return resolved;
+    }
+
+    /** Past setup this prompt is a leftover nobody needs (live: hundreds open across games, flooding the web queue). */
+    @Override
+    public boolean obsolete(CaptureContext ctx) {
+        if (ti4.selfhost.engine.SetupStateBuilder.pastSetup(ctx.game())) return true;
+        // The draft-time preset once a Keleres seat plays its flavour: nothing left to pre-select (live pbd175: the
+        // preset stayed open after the draft and the seat's watchdog reported it as a stall).
+        java.util.List<String> ids = SetupKindSupport.handlerIds(ctx);
+        if (ids == null || ctx.game() == null || ids.stream().noneMatch(h -> h != null && PRESET.matcher(h).matches())) return false;
+        for (Player p : ctx.game().getRealPlayers()) {
+            String f = p.getFaction();
+            if (f != null && f.startsWith("keleres") && !"keleres".equals(f)) return true;
+        }
+        return false;
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/KeleresTechOptionsKind.java b/src/main/java/ti4/selfhost/engine/kinds/KeleresTechOptionsKind.java
new file mode 100644
index 0000000..614c24c
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/KeleresTechOptionsKind.java
@@ -0,0 +1,73 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.List;
+import java.util.Map;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.selfhost.engine.EngineModels.Decision;
+import ti4.selfhost.engine.KindSpec;
+import ti4.selfhost.engine.SetupStateBuilder;
+
+/**
+ * Keleres starting technologies: FFCC_keleres*_getKeleresTechOptions. Keleres chooses two technologies other players
+ * own, so the options it is offered are computed when it presses. Pressed before every other player chose their
+ * starting technologies, Keleres would be offered too little (or nothing) and the button is gone. validate therefore
+ * refuses until nobody else is still choosing. value: {waitingOn: user ids still choosing at capture time} — read the
+ * live answer from GameState.setup.
+ */
+public class KeleresTechOptionsKind implements KindSpec {
+
+    @Override
+    public String kind() {
+        return "setup.keleres_tech";
+    }
+
+    @Override
+    public int priority() {
+        return 100;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return "getKeleresTechOptions".equals(handlerId);
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        if (!matches(handlerId)) return null;
+        Player p = ctx.target() == null ? null : ctx.game().getPlayer(ctx.target().userId());
+        List<String> waiting = SetupStateBuilder.othersChoosingStartingTech(ctx.game(), p);
+        return SetupKindSupport.map("waitingOn", waiting);
+    }
+
+    @Override
+    public String validate(Game game, Player answering, Decision decision, String optionId) {
+        if (!matches(SetupKindSupport.handlerOf(decision, optionId))) return null;
+        List<String> waiting = SetupStateBuilder.othersChoosingStartingTech(game, answering);
+        if (waiting.isEmpty()) return null;
+        return "Wait until every other player has chosen their starting technologies (" + waiting.size()
+                + " still choosing): Keleres chooses from theirs.";
+    }
+
+    /** Setup: faction / colour are picked after capture; re-resolve the target on every state change. */
+    @Override
+    public boolean dynamic() {
+        return true;
+    }
+
+    @Override
+    public ti4.selfhost.engine.EngineModels.Target target(
+            CaptureContext ctx, ti4.selfhost.engine.EngineModels.Target resolved) {
+        if (resolved != null && resolved.userId() != null) return SetupKindSupport.refresh(ctx, resolved);
+        // FFCC_keleresx_getKeleresTechOptions is posted while the seat's faction is being set up: the owner prefix
+        // named no player yet at capture (target null, so nobody was asked). It is always the Keleres seat's.
+        Player p = SetupKindSupport.keleresSeat(ctx.game());
+        return p == null ? resolved : ti4.selfhost.engine.DecisionCapture.target(p, "owner_prefix");
+    }
+
+    /** Past setup this prompt is a leftover nobody needs (live: hundreds open across games, flooding the web queue). */
+    @Override
+    public boolean obsolete(CaptureContext ctx) {
+        return ti4.selfhost.engine.SetupStateBuilder.pastSetup(ctx.game());
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/LeaderUseKind.java b/src/main/java/ti4/selfhost/engine/kinds/LeaderUseKind.java
new file mode 100644
index 0000000..dd73896
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/LeaderUseKind.java
@@ -0,0 +1,149 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.List;
+import java.util.Map;
+import javax.annotation.Nullable;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.selfhost.engine.EngineModels.Decision;
+import ti4.selfhost.engine.EngineModels.Target;
+import ti4.selfhost.engine.KindSpec;
+import ti4.service.leader.LeaderRuleChecks;
+
+/**
+ * leader.use — every faction's agents / commanders / heroes (shared kind; per-faction steps come from
+ * {@link FactionSteps} providers, e.g. FactionStepsArborec). Generic leader ids are typed here for all factions:
+ * {@code exhaustAgent_<agent>[_<arg>...]} (use the agent; the first arg naming a seated player = target),
+ * {@code getAgentSelection_<agent>} (use the agent, a target picker follows), {@code hacanAgentRefresh_<faction>}.
+ *
+ * <p>Value: {leader, leaderType (agent|commander|hero), faction (the leader's), step, action (use|target|skip),
+ * optional, + typed fields: target (faction), tile, planet, unit, damaged, amount, args}.
+ */
+public class LeaderUseKind implements KindSpec {
+    static final String KIND = "leader.use";
+
+    @Override
+    public String kind() {
+        return KIND;
+    }
+
+    @Override
+    public int priority() {
+        return 40;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        FactionSteps.Step s = FactionSteps.Registry.find(handlerId, null);
+        return s != null && KIND.equals(s.kind());
+    }
+
+    @Override
+    public boolean classifies(List<String> handlerIds) {
+        return KIND.equals(FactionSteps.Registry.kindOf(handlerIds));
+    }
+
+    @Override
+    @Nullable
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        FactionSteps.Step s = FactionSteps.Registry.find(handlerId, ctx);
+        return s == null || !KIND.equals(s.kind()) ? null : s.value();
+    }
+
+    /**
+     * An agent prompt (exhaustAgent_&lt;agent&gt;[_…]) whose agent is already exhausted can no longer be used: pressing it
+     * again re-runs the agent's effect without the readied card (live pbd31: the Winnu agent's "use on" buttons
+     * stayed on the payment summary after the agent was spent; a bot pressed "Hacan" 783 times, each press posting
+     * "has exhausted Berekar Berekon … on Hacan" and adding the agent to Hacan's spent things). Every option must be
+     * such an agent prompt (Decline / UNDO aside).
+     */
+    @Override
+    public boolean obsolete(CaptureContext ctx) {
+        ti4.game.Game game = ctx.game();
+        if (game == null) return false;
+        List<String> ids = ctx.handlerIds();
+        if (ids == null && ctx.messageId() != null) {
+            String id = ti4.selfhost.engine.DecisionRegistry.decisionIdForMessage(ctx.messageId());
+            ti4.selfhost.engine.EngineModels.Decision d = id == null ? null : ti4.selfhost.engine.DecisionRegistry.get(id);
+            if (d != null) ids = d.options().stream()
+                    .map(o -> ti4.discord.interactions.routing.ComponentIdEnvelope.decode(o.id().split("#")[0]).handlerId())
+                    .toList();
+        }
+        if (ids == null) return false;
+        boolean any = false;
+        for (String raw : ids) {
+            if (raw == null) continue;
+            String h = raw.replaceFirst("^FFCC_[^_]+_", "");
+            if (FactionSteps.Registry.chrome(h)) continue;
+            if (!h.startsWith("exhaustAgent_")) return false;
+            FactionSteps.Step s = FactionSteps.Registry.find(h, null);
+            if (s == null || !KIND.equals(s.kind()) || s.faction() == null) return false;
+            ti4.game.Player owner = game.getPlayerFromColorOrFaction(s.faction());
+            if (owner == null) return false;
+            ti4.game.Leader leader = owner.getLeader(s.component()).orElse(null);
+            if (leader == null || !leader.isExhausted()) return false;
+            any = true;
+        }
+        return any;
+    }
+
+    /**
+     * Card-text checks the original handlers left to their button lists (rules audit, leaders A–M; deliberate
+     * improvements over the original code, mirrored in the bot handlers through {@link LeaderRuleChecks}): a readied
+     * agent for exhaustAgent_ / getAgentSelection_, the Sol / Letnev agent target in the active system, the Hacan agent
+     * in the action phase, the L1Z1X agent's infantry in the active system, Riftwalker Meian's excluded systems, Mirik Aun Sissiri's destinations, Adjudicator Ba'al
+     * still unlocked, S'ula Mentarion only after a won space combat, Sai Seravus only with unused capacity.
+     * Leaders N–Z (rules audit): the card-text limits of {@link ti4.service.leader.LeaderLimitService} first (Suffi An's
+     * unlock costs 1 trade good, Dannel of the Tenth up to 3 infantry, Field Marshal Mercer up to 2 ground forces,
+     * G'hom Sek'kus up to 1 ground force per planet), refused the same way by the bot handlers.
+     */
+    @Override
+    public String validate(Game game, Player answering, Decision decision, String optionId) {
+        if (game == null || answering == null || decision == null) return null;
+        String h = SetupKindSupport.handlerOf(decision, optionId).replaceFirst("^FFCC_[^_]+_", "");
+        if (!h.isEmpty()) {
+            String limit = ti4.service.leader.LeaderLimitService.refusal(game, answering, h);
+            if (limit != null) return limit;
+        }
+        Map<String, Object> v = StrategyCards.optionValue(decision, optionId);
+        if (v == null || !(v.get("step") instanceof String step)) return null;
+        String leader = v.get("leader") instanceof String l ? l : null;
+        String tile = v.get("tile") instanceof String t ? t : null;
+        String target = v.get("target") instanceof String t ? t : null;
+        return switch (step) {
+            case "exhaustAgent", "getAgentSelection" -> {
+                String err = LeaderRuleChecks.agentNotReady(answering, leader);
+                if (err == null && "exhaustAgent".equals(step) && target != null)
+                    err = LeaderRuleChecks.agentTargetInActiveSystem(
+                            game, leader, game.getPlayerFromColorOrFaction(target));
+                if (err == null && "hacanagent".equals(leader)) err = LeaderRuleChecks.hacanAgentPhase(game);
+                yield err;
+            }
+            case "creussHeroStep1" -> LeaderRuleChecks.creussHeroTile(game, answering, tile);
+            case "creussHeroStep2" -> {
+                String from = v.get("from") instanceof String f ? f : null;
+                String err = LeaderRuleChecks.creussHeroTile(game, answering, from);
+                yield err != null ? err : LeaderRuleChecks.creussHeroTile(game, answering, tile);
+            }
+            case "argentHeroStep2", "argentHeroStep4" -> LeaderRuleChecks.argentHeroDestination(game, answering, tile);
+            case "novaSeed" -> LeaderRuleChecks.novaSeed(game, answering, tile);
+            case "mitoMechPlacement" -> "l1z1xagent".equals(leader) ? LeaderRuleChecks.l1z1xAgentTile(game, tile) : null;
+            case "mentakCommander" ->
+                LeaderRuleChecks.mentakCommanderWon(
+                        game, answering, target == null ? null : game.getPlayerFromColorOrFaction(target));
+            case "placeGhostCommanderFF" -> LeaderRuleChecks.ghostCommanderCapacity(game, answering, tile);
+            default -> null;
+        };
+    }
+
+    @Override
+    public boolean dynamic() {
+        return true;
+    }
+
+    @Override
+    @Nullable
+    public Target target(CaptureContext ctx, @Nullable Target resolved) {
+        return FactionSteps.Registry.target(ctx, resolved);
+    }
+}
