+package ti4.spring.api.selfhost;
+
+import java.util.Map;
+import lombok.RequiredArgsConstructor;
+import org.springframework.http.CacheControl;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.security.access.prepost.PreAuthorize;
+import org.springframework.web.bind.annotation.ExceptionHandler;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.spring.api.selfhost.TradeModels.PendingResponse;
+import ti4.spring.api.selfhost.TradeModels.ProposeRequest;
+import ti4.spring.api.selfhost.TradeModels.ProposeResponse;
+import ti4.spring.api.selfhost.TradeModels.TradeOptions;
+import ti4.spring.context.RequestContext;
+import ti4.spring.context.SetupRequestContext;
+
+/**
+ * Per-player trade endpoints for the self-hosted web trade panel. Auth: {@code Authorization: Bearer <seat token>}
+ * (the shim forwards it; non-GET is allowed under /api/game/**).
+ * <ul>
+ *   <li>{@code GET  /api/game/{gameName}/trade/options} — what I can offer, who I can trade with, what they have</li>
+ *   <li>{@code POST /api/game/{gameName}/trade/propose} — build the bot transaction and send the offer</li>
+ *   <li>{@code GET  /api/game/{gameName}/trade/pending} — open offers to / from me, with the bot's buttons</li>
+ * </ul>
+ */
+@RestController
+@RequiredArgsConstructor
+@RequestMapping("/api/game/{gameName}/trade")
+public class TradeController {
+
+    private final TradeService tradeService;
+
+    @GetMapping("/options")
+    @PreAuthorize("@security.canAccessGame(#gameName)")
+    public ResponseEntity<TradeOptions> options(@PathVariable String gameName) {
+        Game game = RequestContext.getGame();
+        Player me = RequestContext.getPlayer();
+        return ResponseEntity.ok().cacheControl(CacheControl.noStore()).body(tradeService.options(game, me));
+    }
+
+    @PostMapping("/propose")
+    @SetupRequestContext
+    @PreAuthorize("@security.canAccessGame(#gameName)")
+    public ProposeResponse propose(@PathVariable String gameName, @RequestBody ProposeRequest request) {
+        return tradeService.propose(RequestContext.getGame(), RequestContext.getPlayer(), request);
+    }
+
+    @GetMapping("/pending")
+    @PreAuthorize("@security.canAccessGame(#gameName)")
+    public ResponseEntity<PendingResponse> pending(@PathVariable String gameName) {
+        Game game = RequestContext.getGame();
+        Player me = RequestContext.getPlayer();
+        return ResponseEntity.ok().cacheControl(CacheControl.noStore()).body(tradeService.pending(game, me));
+    }
+
+    @ExceptionHandler(TradeService.TradeException.class)
+    public ResponseEntity<Map<String, String>> tradeError(TradeService.TradeException e) {
+        return ResponseEntity.status(HttpStatus.BAD_REQUEST).body(Map.of("error", e.getMessage()));
+    }
+}
diff --git a/src/main/java/ti4/spring/api/selfhost/TradeModels.java b/src/main/java/ti4/spring/api/selfhost/TradeModels.java
