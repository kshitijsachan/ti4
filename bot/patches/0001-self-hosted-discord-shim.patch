@@ -0,0 +1,77 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.image.Mapper;
+import ti4.model.PromissoryNoteModel;
+import ti4.selfhost.engine.EngineModels.Decision;
+import ti4.selfhost.engine.EngineModels.Option;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * Play a promissory note: resolvePNPlay_&lt;pnId&gt; (PromissoryNoteHelper hand tray in the cards-info thread; the
+ * "reminder: this is the window to play X" offers with a Decline). Special ids: bmfNotHand (Black Market Forgery
+ * from a component action, not from hand), ra_&lt;tech&gt; (Research Agreement for a technology).
+ *
+ * <p>Value: {promissoryNote, owner, playArea, fromHand, tech?}. owner = faction that owns the note (gets it back
+ * unless it goes to the player's play area). Other options (Decline / delete) are untyped.
+ */
+public class PromissoryNotePlayKind implements KindSpec {
+    static final String PREFIX = "resolvePNPlay_";
+
+    @Override
+    public String kind() {
+        return "promissory_note.play";
+    }
+
+    @Override
+    public int priority() {
+        return 85;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return handlerId.startsWith(PREFIX);
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        String id = handlerId.substring(PREFIX.length());
+        Map<String, Object> v = new LinkedHashMap<>();
+        boolean fromHand = true;
+        String tech = null;
+        if ("bmfNotHand".equals(id)) {
+            id = "bmf";
+            fromHand = false;
+        } else if (id.contains("ra_") && Mapper.getPromissoryNote(id) == null) {
+            int at = id.lastIndexOf("ra_");
+            tech = id.substring(at + 3);
+            id = id.substring(0, at + 2);
+        } else if (id.startsWith("dspnflor")) {
+            id = "dspnflor";
+        }
+        PromissoryNoteModel pn = Mapper.getPromissoryNote(id);
+        if (pn == null) return null;
+        Player owner = ctx.game().getPNOwner(id);
+        v.put("promissoryNote", id);
+        v.put("owner", owner == null ? null : owner.getFaction());
+        v.put("playArea", pn.getPlayArea());
+        v.put("fromHand", fromHand);
+        if (tech != null) v.put("tech", tech);
+        return v;
+    }
+
+    @Override
+    public String validate(Game game, Player answering, Decision decision, String optionId) {
+        for (Option o : decision.options()) {
+            if (!o.id().equals(optionId) || o.value() == null) continue;
+            if (Boolean.TRUE.equals(o.value().get("fromHand"))
+                    && o.value().get("promissoryNote") instanceof String pn
+                    && !answering.getPromissoryNotes().containsKey(pn))
+                return "That promissory note is not in your hand.";
+        }
+        return null;
+    }
+}
