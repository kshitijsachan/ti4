--- /dev/null
+++ b/src/test/java/ti4/selfhost/engine/GameRewindPlanTest.java
@@ -0,0 +1,62 @@
+package ti4.selfhost.engine;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Set;
+import org.junit.jupiter.api.Test;
+import ti4.selfhost.engine.DecisionRegistry.ClosedControl;
+import ti4.selfhost.engine.DecisionRegistry.Version;
+import ti4.selfhost.engine.EngineModels.Source;
+
+/**
+ * Live pbd273: rewound to "Bot Mu pressed Ring #3". The turn message had walked turn menu -> ring menu -> system list
+ * (the restored step) -> move (undone, 1 s after the save); the restore re-posted the move step and a start-of-turn
+ * menu let the bot start a second tactical action. A roll-back puts each message back at its step at the save.
+ */
+class GameRewindPlanTest {
+    private static final long S = 10_000, B = 10_900, R = 60_000; // save, first undone press, roll-back
+
+    private static Version v(String msg, long created, long at, String reason, String... ids) {
+        List<ClosedControl> cs = new ArrayList<>();
+        for (String id : ids) cs.add(new ClosedControl(id, id, "secondary", null, false));
+        return new Version("d" + msg, "tactical.activate", new Source("ch", msg, null, false), "p", cs, created, reason, at);
+    }
+
+    private static final List<Version> HISTORY = List.of(
+            v("M", 1_000, 1_000, null, "tacticalAction", "passForRound"),
+            v("M", 1_000, 5_000, null, "ring_1", "ring_2", "ring_3"),
+            v("M", 1_000, 9_900, null, "ringTile_301", "ringTile_302"),
+            v("M", 1_000, 11_000, null, "move_1", "doneMove"),
+            v("M", 1_000, 13_000, "no_options"),
+            v("N", 10_950, 10_950, null, "land_1"),
+            v("T", 2_000, 2_000, null, "turnEnd"),
+            v("T", 2_000, 10_500, "deleted"),
+            v("U", 500, 500, null, "x"));
+
+    private static List<GameRewind.Plan> plans() {
+        return GameRewind.plans(HISTORY, S, B, R, 0, id -> id.equals("T") ? 9_000 : id.equals("M") ? 10_900 : 0);
+    }
+
+    @Test
+    void eachWalkedMessageGetsItsStepAtTheSave() {
+        List<GameRewind.Plan> p = plans();
+        assertThat(p).extracting(GameRewind.Plan::messageId).containsExactly("M");
+        assertThat(GameRewind.ids(p.getFirst().atBoundary().controls())).containsExactlyInAnyOrder("ringTile_301", "ringTile_302");
+    }
+
+    @Test
+    void repostsOfAnotherStepAreRetired() {
+        List<GameRewind.Plan> p = plans();
+        assertThat(GameRewind.repeatsOtherStep(Set.of("tacticalAction", "passForRound"), p)).isTrue();
+        assertThat(GameRewind.repeatsOtherStep(Set.of("ringTile_301", "ringTile_302"), p)).isFalse();
+        assertThat(GameRewind.repeatsOtherStep(Set.of("sc_follow_1"), p)).isFalse();
+    }
+
+    @Test
+    void unknownStateAtTheSaveIsLeftAlone() {
+        List<Version> late = HISTORY.stream().filter(x -> x.at() >= 11_000).toList();
+        assertThat(GameRewind.plans(late, S, B, R, 11_000, id -> 0)).extracting(GameRewind.Plan::messageId).doesNotContain("M");
+    }
+}
