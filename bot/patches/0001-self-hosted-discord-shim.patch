+package ti4.selfhost.engine.kinds;
+
+import java.util.List;
+import java.util.Map;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * Retreat destination (retreatUnitsFrom_&lt;from&gt;_&lt;to&gt;[skilled]) and, after it, which ground forces follow
+ * (retreatGroundUnits_&lt;from&gt;_&lt;to&gt;_&lt;n&gt;_&lt;unit&gt;_&lt;planet&gt;). Owner = FFCC_.
+ */
+public class CombatRetreatKind implements KindSpec {
+
+    @Override
+    public String kind() {
+        return "combat.retreat";
+    }
+
+    @Override
+    public int priority() {
+        return 100;
+    }
+
+    @Override
+    public boolean classifies(List<String> handlerIds) {
+        for (String h : handlerIds) {
+            if (h != null && (h.startsWith("retreatUnitsFrom_") || h.startsWith("retreatGroundUnits_"))) return true;
+        }
+        return false;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return handlerId.startsWith("retreatUnitsFrom_")
+                || handlerId.startsWith("retreatGroundUnits_")
+                || handlerId.equals("deleteButtons");
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        return CombatSupport.value(handlerId, ctx.game());
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/CombatRoundKind.java b/src/main/java/ti4/selfhost/engine/kinds/CombatRoundKind.java
new file mode 100644
