new file mode 100644
index 0000000..19401c4
--- /dev/null
+++ b/src/main/java/ti4/spring/api/selfhost/DraftButtonLocator.java
@@ -0,0 +1,71 @@
+package ti4.spring.api.selfhost;
+
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.TimeUnit;
+import net.dv8tion.jda.api.components.buttons.Button;
+import net.dv8tion.jda.api.entities.Message;
+import net.dv8tion.jda.api.entities.MessageHistory;
+import net.dv8tion.jda.api.entities.channel.concrete.TextChannel;
+import org.springframework.stereotype.Component;
+import ti4.discord.JdaService;
+import ti4.game.Game;
+
+/**
+ * Finds which message in the game's main channel currently carries each draft button, so the web client can
+ * "press" it through the shim. Reads the latest 200 messages through JDA (i.e. the shim's REST API) and caches
+ * the result briefly per channel + game version.
+ */
+@Component
+public class DraftButtonLocator {
+
+    /** Interactions that move buttons usually save the game (new version); the TTL covers the ones that do not. */
+    private static final long TTL_MS = 4000;
+    private static final int PAGES = 2;
+
+    private record Entry(long at, long version, Map<String, String> buttons) {}
+
+    private final Map<String, Entry> cache = new ConcurrentHashMap<>();
+
+    /** custom_id -> message id (newest message wins). */
+    public Map<String, String> locate(Game game) {
+        TextChannel channel;
+        try {
+            channel = game.getMainGameChannel();
+        } catch (Exception e) {
+            return Map.of();
+        }
+        if (channel == null) return Map.of();
+        String key = channel.getId();
+        long now = System.currentTimeMillis();
+        Entry hit = cache.get(key);
+        if (hit != null && hit.version == game.getLastModifiedDate() && now - hit.at < TTL_MS) return hit.buttons;
+
+        Map<String, String> found = new HashMap<>();
+        try {
+            MessageHistory mh = channel.getHistory();
+            List<Message> history = new java.util.ArrayList<>();
+            for (int page = 0; page < PAGES; page++) {
+                List<Message> got = mh.retrievePast(100).timeout(5, TimeUnit.SECONDS).complete();
+                history.addAll(got);
+                if (got.size() < 100) break;
+            }
+            // History is newest first; keep the first (newest) message seen for each button.
+            String botId = JdaService.getBotId();
+            for (Message m : history) {
+                if (botId != null && !botId.equals(m.getAuthor().getId())) continue;
+                for (Button b : m.getComponentTree().findAll(Button.class)) {
+                    if (b.getCustomId() == null || b.isDisabled()) continue;
+                    found.putIfAbsent(b.getCustomId(), m.getId());
+                }
+            }
+        } catch (Exception e) {
+            if (hit != null) return hit.buttons;
+            return Map.of();
+        }
+        cache.put(key, new Entry(now, game.getLastModifiedDate(), found));
+        return found;
+    }
+}
diff --git a/src/main/java/ti4/spring/api/selfhost/DraftViewController.java b/src/main/java/ti4/spring/api/selfhost/DraftViewController.java
