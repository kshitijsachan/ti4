+package ti4.selfhost.engine.kinds;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * Promissory-note steps outside the hand tray (C7). Generic notes (Alliance, Ceasefire, Political Secret, Support
+ * for the Throne, Trade Agreement, ...) resolve inside PromissoryNoteHelper.resolvePNPlay with no prompt of their own
+ * (their play is promissory_note.play); the notes that do ask something:
+ * winnuPNPlay_&lt;sc&gt; (Acquiescence offered when a strategy card is played: follow it for free),
+ * passMalevolencyTo_&lt;faction&gt; (Malevolency: the neighbour to pass it to), bentorPNPlanet_&lt;planet&gt;
+ * (Bentor note: the planet), pharadnPNUse (Pharadn note).
+ *
+ * <p>Value: {promissoryNote, step, strategyCard?, player?, planet?}.
+ */
+public class PromissoryNoteResolveKind implements KindSpec {
+
+    @Override
+    public String kind() {
+        return "promissory_note.resolve";
+    }
+
+    @Override
+    public int priority() {
+        return 80;
+    }
+
+    @Override
+    public boolean matches(String h) {
+        return h.matches("winnuPNPlay_\\d+")
+                || h.startsWith("passMalevolencyTo_")
+                || h.startsWith("bentorPNPlanet_")
+                || h.equals("pharadnPNUse");
+    }
+
+    @Override
+    public Map<String, Object> value(String h, CaptureContext ctx) {
+        Map<String, Object> v = new LinkedHashMap<>();
+        if (h.startsWith("winnuPNPlay_")) {
+            v.put("promissoryNote", "acq");
+            v.put("step", "acquiescence");
+            v.put("strategyCard", CardKinds.parseInt(h.substring("winnuPNPlay_".length()), -1));
+        } else if (h.startsWith("passMalevolencyTo_")) {
+            v.put("promissoryNote", "malevolency");
+            v.put("step", "pass_to");
+            CardSteps.typeTokens(ctx.game(), h.substring("passMalevolencyTo_".length()), v);
+        } else if (h.startsWith("bentorPNPlanet_")) {
+            v.put("promissoryNote", "dspnbent");
+            v.put("step", "planet");
+            v.put("planet", h.substring("bentorPNPlanet_".length()));
+        } else {
+            v.put("promissoryNote", "dspnphar");
+            v.put("step", "use");
+        }
+        return v;
+    }
+}
