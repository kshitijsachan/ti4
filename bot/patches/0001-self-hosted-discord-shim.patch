@@ -0,0 +1,43 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.Map;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * "When" queue window in the player's cards-info thread (AgendaWhensAftersHelper, queued agenda mode):
+ * queueAWhen (open the list of playable whens), declineToQueueAWhen (pass), queueWhen_&lt;ac|pn|ability&gt;_&lt;id&gt;
+ * (queue that card). Target: the thread owner.
+ */
+public class AgendaWhenKind implements KindSpec {
+
+    @Override
+    public String kind() {
+        return "agenda.when";
+    }
+
+    @Override
+    public int priority() {
+        return 100;
+    }
+
+    @Override
+    public boolean matches(String h) {
+        return h.equals("queueAWhen") || h.equals("declineToQueueAWhen") || h.startsWith("queueWhen_");
+    }
+
+    @Override
+    public Map<String, Object> value(String h, CaptureContext ctx) {
+        return window(h, "queueAWhen", "declineToQueueAWhen", "queueWhen_");
+    }
+
+    /** {action: open|pass|queue, cardType?, card?} for the when/after queue buttons. */
+    static Map<String, Object> window(String h, String open, String pass, String queuePrefix) {
+        if (h.equals(open)) return Map.of("action", "open");
+        if (h.equals(pass)) return Map.of("action", "pass");
+        if (!h.startsWith(queuePrefix)) return null;
+        String rest = h.substring(queuePrefix.length());
+        int us = rest.indexOf('_');
+        if (us < 0) return Map.of("action", "queue", "cardType", rest, "card", "");
+        return Map.of("action", "queue", "cardType", rest.substring(0, us), "card", rest.substring(us + 1));
+    }
+}
