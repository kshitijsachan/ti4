+package ti4.selfhost.engine.interaction;
+
+import java.util.Map;
+
+public class NativeCoverageReport {
+    public static void main(String[] a) {
+        NativeCoverage.Report r = NativeCoverage.report();
+        System.out.println("handlers " + r.handlers() + " native " + r.nativeHandlers() + " = " + r.nativePercent() + "%; direct (no token ops) " + r.directHandlers() + " = " + r.directPercent() + "%");
+        r.byKind().forEach((k, v) -> System.out.println("  " + k + ": " + v[1] + "/" + v[0]));
+        System.out.println("pipeline unsupported: " + r.pipelineUnsupported());
+        System.out.println("-- unsupported ops (handlers affected):");
+        int i = 0;
+        for (Map.Entry<String, Integer> e : r.unsupportedOps().entrySet()) {
+            if (i++ > 40) break;
+            System.out.println("  " + e.getValue() + "  " + e.getKey());
+        }
+        System.out.println("-- op usage (top 40):");
+        i = 0;
+        for (Map.Entry<String, Integer> e : r.opUsage().entrySet()) {
+            if (i++ > 40) break;
+            System.out.println("  " + e.getValue() + "  " + e.getKey());
+        }
+        if (a.length > 0)
+            for (var c : r.nonNative())
+                System.out.println("NON " + c.kind() + " " + c.key() + " " + c.method() + " " + c.unsupported());
+        System.exit(0);
+    }
+}
