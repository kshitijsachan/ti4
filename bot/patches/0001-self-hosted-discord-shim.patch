+package ti4.helpers;
+
+import java.util.List;
+import java.util.Map;
+import javax.annotation.Nullable;
+import lombok.experimental.UtilityClass;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.game.Tile;
+import ti4.model.UnitModel;
+
+/**
+ * Productions that an effect caps (number of units, cost of each unit or of all of them, unit type, one system):
+ * Umbat (Muaat agent) and the Production / Armament Riders (2 units costing 4 or less each), the Maximus (Dih-Mohn
+ * flagship: 2 units of combined cost 4 or less), Superweapon Availyn (3 fighters), Flaah Hyphae (2 units per hyphae).
+ *
+ * <p>These all open the shared "muaatagent" production (Helper.getPlaceUnitButtons), whose buttons alone could not
+ * hold the cap: every place_ button stays until Done, so a player could produce any number of units. The entry point
+ * records the cap here right after opening the buttons (opening any production clears it); place_ presses beyond it
+ * are refused (ButtonHelperModifyUnits.genericPlaceUnit) and Done clears it. The engine's production.produce kind
+ * reports and validates the same cap. Deliberate rules fix over the original bot, which enforced none of these
+ * counts.
+ */
+@UtilityClass
+public class ProductionCapHelper {
+
+    /**
+     * @param tile the one system the units may be produced in
+     * @param maxUnits units in all (each fighter / infantry counts as one)
+     * @param maxEachCost the most one unit may cost, or null
+     * @param maxTotalCost the most all of them may cost together, or null
+     * @param onlyUnit the only unit (async id) that may be produced, or null
+     * @param source what grants it: umbat, rider, maximus, availyn, flaah
+     */
+    public record Cap(
+            String tile,
+            int maxUnits,
+            @Nullable Float maxEachCost,
+            @Nullable Float maxTotalCost,
+            @Nullable String onlyUnit,
+            String source) {
+
+        public String label() {
+            String who =
+                    switch (source) {
+                        case "umbat" -> "Umbat";
+                        case "rider" -> "Rider";
+                        case "maximus" -> "Maximus";
+                        case "availyn" -> "Superweapon Availyn";
+                        case "flaah" -> "Flaah Hyphae";
+                        case "arborecflagship" -> "Duha Menaimon";
+                        default -> source;
+                    };
+            StringBuilder sb = new StringBuilder(who).append(": up to ").append(maxUnits);
+            sb.append("ff".equals(onlyUnit) ? " fighter" : " unit").append(maxUnits == 1 ? "" : "s");
+            if (maxEachCost != null) sb.append(", each cost ≤").append(fmt(maxEachCost));
+            if (maxTotalCost != null) sb.append(", combined cost ≤").append(fmt(maxTotalCost));
+            return sb.toString();
+        }
+    }
+
+    public static Cap umbat(String tile) {
+        return new Cap(tile, 2, 4f, null, null, "umbat");
+    }
+
+    public static Cap rider(String tile) {
+        return new Cap(tile, 2, 4f, null, null, "rider");
+    }
+
+    public static Cap maximus(String tile) {
+        return new Cap(tile, 2, null, 4f, null, "maximus");
+    }
+
+    public static Cap availyn(String tile) {
+        return new Cap(tile, 3, null, null, "ff", "availyn");
+    }
+
+    /** Duha Menaimon (Arborec flagship): up to 5 units in its system. */
+    public static Cap arborecFlagship(String tile) {
+        return new Cap(tile, 5, null, null, null, "arborecflagship");
+    }
+
+    public static Cap flaah(String tile, int units) {
+        return new Cap(tile, units, null, null, null, "flaah");
+    }
+
+    private static String key(Player player) {
+        return "productionCap_" + player.getFaction();
+    }
+
+    public static void set(Game game, Player player, Cap cap) {
+        game.setStoredValue(
+                key(player),
+                String.join(
+                        ";",
+                        cap.tile(),
+                        String.valueOf(cap.maxUnits()),
+                        cap.maxEachCost() == null ? "-" : String.valueOf(cap.maxEachCost()),
+                        cap.maxTotalCost() == null ? "-" : String.valueOf(cap.maxTotalCost()),
+                        cap.onlyUnit() == null ? "-" : cap.onlyUnit(),
+                        cap.source()));
+    }
+
+    public static void clear(Game game, Player player) {
+        if (player != null) game.removeStoredValue(key(player));
+    }
+
+    @Nullable
+    public static Cap get(Game game, @Nullable Player player) {
+        if (game == null || player == null) return null;
+        String v = game.getStoredValue(key(player));
+        if (v == null || v.isEmpty()) return null;
+        String[] a = v.split(";");
+        if (a.length < 6) return null;
+        try {
+            return new Cap(
+                    a[0],
+                    Integer.parseInt(a[1]),
+                    "-".equals(a[2]) ? null : Float.parseFloat(a[2]),
+                    "-".equals(a[3]) ? null : Float.parseFloat(a[3]),
+                    "-".equals(a[4]) ? null : a[4],
+                    a[5]);
+        } catch (NumberFormatException e) {
+            return null;
+        }
+    }
+
+    /** Cost of one unit of this async id for this player (0.5 for fighters / infantry); null if unknown. */
+    @Nullable
+    public static Float unitCost(Player player, String asyncId) {
+        try {
+            List<UnitModel> models = player.getUnitsByAsyncID(asyncId);
+            return models.isEmpty() ? null : models.getFirst().getCost();
+        } catch (RuntimeException e) {
+            return null;
+        }
+    }
+
+    /** Units produced so far in this production (produced-units record: unit_tile_holder → count). */
+    public static int producedCount(Player player) {
+        int n = 0;
+        for (int c : player.getCurrentProducedUnits().values()) n += c;
+        return n;
+    }
+
+    public static float producedCost(Player player) {
+        float total = 0;
+        for (Map.Entry<String, Integer> e : player.getCurrentProducedUnits().entrySet()) {
+            Float c = unitCost(player, e.getKey().split("_")[0]);
+            if (c != null) total += c * e.getValue();
+        }
+        return total;
+    }
+
+    /**
+     * Why producing {@code count} more {@code asyncId} in {@code tilePos} (on top of what was produced already)
+     * breaks the cap; null when it fits or no cap applies.
+     */
+    @Nullable
+    public static String refusal(Game game, Player player, @Nullable String tilePos, String asyncId, int count) {
+        Cap cap = get(game, player);
+        if (cap == null) return null;
+        return refusal(cap, player, tilePos, asyncId, count, producedCount(player), producedCost(player));
+    }
+
+    /** The same check against an explicit count / cost already produced (the engine sums a whole payload). */
+    @Nullable
+    public static String refusal(
+            Cap cap, Player player, @Nullable String tilePos, String asyncId, int count, int already, float spent) {
+        String label = cap.label();
+        if (tilePos != null && !tilePos.equals(cap.tile()))
+            return label + " — only in system " + cap.tile() + ".";
+        if (cap.onlyUnit() != null && !cap.onlyUnit().equals(asyncId))
+            return label + " — that unit cannot be produced with it.";
+        if (already + count > cap.maxUnits())
+            return label + " — " + already + " already produced, cannot produce " + count + " more.";
+        Float each = unitCost(player, asyncId);
+        if (cap.maxEachCost() != null && each != null && each > cap.maxEachCost())
+            return label + " — that unit costs " + fmt(each) + ".";
+        if (cap.maxTotalCost() != null && each != null && spent + each * count > cap.maxTotalCost() + 1e-6)
+            return label + " — that would cost " + fmt(spent + each * count) + " in all.";
+        return null;
+    }
+
+    /** Position of the system a place_ target names: a tile position, "space&lt;pos&gt;" or a planet. */
+    @Nullable
+    public static String tileOf(Game game, String where) {
+        if (where == null) return null;
+        if (where.startsWith("space")) where = where.substring("space".length());
+        if (game.getTileByPosition(where) != null) return where;
+        Tile t = game.getTileFromPlanet(where);
+        return t == null ? null : t.getPosition();
+    }
+
+    private static String fmt(float f) {
+        return f == Math.floor(f) ? String.valueOf((int) f) : String.valueOf(f);
+    }
+}
