+package ti4.selfhost.engine.kinds;
+
+import java.util.List;
+
+/**
+ * Universities of Jol-Nar. Hero (Rin, the Master's Legacy: swap technologies) jnHeroSwapOut_&lt;tech&gt; then
+ * swapTechs__&lt;out&gt;__&lt;in&gt;; agent (Doctor Sucaban, after exhaustAgent_jolnaragent) jolNarAgentRemoval_&lt;pos&gt;_&lt;holder&gt;
