+
+        @Override
+        @SuppressWarnings("unchecked")
+        public Object invoke(Object proxy, Method m, Object[] args) throws Throwable {
+            Object[] a = args == null ? new Object[0] : args;
+            EngineInteraction ix = view.ix;
+            switch (m.getName()) {
+                case "getJDA":
+                    return JdaService.jda;
+                case "getInteraction":
+                    return view.self;
+                case "getToken":
+                    return "engine-" + ix.getId();
+                case "getIdLong":
+                    return JdaService.jda == null ? 0L : JdaService.jda.getSelfUser().getIdLong();
+                case "getExpirationTimestamp":
+                    return System.currentTimeMillis() + 15 * 60 * 1000L;
+                case "hasCallbackResponse":
+                    return false;
+                case "getCallbackResponse":
+                    return null;
+                case "setEphemeral":
+                    ephemeral = (Boolean) a[0];
+                    return proxy;
+                case "sendMessage":
+                case "sendMessageEmbeds":
+                case "sendMessageComponents":
+                case "sendFiles":
+                case "sendMessagePoll":
+                    if (a.length == 1 && !m.isDefault()) return send(m.getName(), a[0]);
+                    break;
+                case "editMessageById":
+                case "editMessageEmbedsById":
+                case "editMessageComponentsById":
+                case "editMessageAttachmentsById":
+                    if (a.length == 2 && !m.isDefault()) return edit(m.getName(), (String) a[0], a[1]);
+                    break;
+                case "deleteMessageById":
+                    if (a.length == 1 && a[0] instanceof String id) {
+                        String t = target(id);
+                        return NativeAction.of(WebhookMessageDeleteAction.class, null, false, act -> {
+                            if (t != null) ix.delete(t, 0);
+                            return null;
+                        });
+                    }
+                    break;
+                case "retrieveMessageById":
+                    if (a.length == 1 && a[0] instanceof String id) {
+                        String t = target(id);
+                        return NativeAction.of(WebhookMessageRetrieveAction.class, null, false, act -> t == null ? null : ix.fetch(t));
+                    }
+                    break;
+                case "toString":
+                    return "EngineHook[" + ix.componentId() + "]";
+                case "hashCode":
+                    return System.identityHashCode(proxy);
+                case "equals":
+                    return proxy == a[0];
+                default:
+                    break;
+            }
+            if (m.isDefault()) {
+                try {
+                    return InvocationHandler.invokeDefault(proxy, m, args);
+                } catch (InvocationTargetException e) {
+                    throw e.getCause();
+                }
+            }
+            throw new UnsupportedOperationException("engine answer: InteractionHook." + m.getName() + " is not supported");
+        }
+
+        @SuppressWarnings("unchecked")
+        private Object send(String how, Object arg) {
+            MessageCreateBuilder b = new MessageCreateBuilder();
+            switch (how) {
+                case "sendMessage" -> {
+                    if (arg instanceof MessageCreateData d) b.applyData(d);
+                    else b.setContent(String.valueOf(arg));
+                }
+                case "sendMessageEmbeds" -> b.setEmbeds((Collection<? extends MessageEmbed>) arg);
+                case "sendMessageComponents" -> b.setComponents((Collection<? extends MessageTopLevelComponent>) arg);
+                case "sendFiles" -> b.setFiles((Collection<? extends FileUpload>) arg);
+                default -> throw new UnsupportedOperationException("engine answer: InteractionHook." + how);
+            }
+            return NativeAction.of(WebhookMessageCreateAction.class, b, ephemeral, act -> view.ix.send(b.build(), act.ephemeral));
+        }
+
+        @SuppressWarnings("unchecked")
+        private Object edit(String how, String id, Object arg) {
+            MessageEditBuilder b = new MessageEditBuilder();
+            switch (how) {
+                case "editMessageById" -> {
+                    if (arg instanceof MessageEditData d) b.applyData(d);
+                    else b.setContent(String.valueOf(arg));
+                }
+                case "editMessageEmbedsById" -> b.setEmbeds((Collection<? extends MessageEmbed>) arg);
+                case "editMessageComponentsById" -> b.setComponents((Collection<? extends MessageTopLevelComponent>) arg);
+                case "editMessageAttachmentsById" -> b.setAttachments((Collection<? extends AttachedFile>) arg);
+                default -> throw new UnsupportedOperationException("engine answer: InteractionHook." + how);
+            }
+            String t = target(id);
+            return NativeAction.of(WebhookMessageEditAction.class, b, false, act -> t == null ? null : view.ix.edit(t, b.build()));
+        }
+    }
+
+    // ------------------------------------------------------------------ modal values
+
+    /** Field values of a native modal submit as JDA ModalMappings (text inputs and string selects). */
+    private static List<ModalMapping> modalMappings(EngineInteraction ix) {
+        List<ModalMapping> out = new ArrayList<>();
+        Modal modal = ix.getOpenedModal();
+        Map<String, String> inputs = ix.getInputs();
+        int uid = 1;
+        for (Map.Entry<String, String> e : inputs.entrySet()) {
+            boolean select = modal != null
+                    && modal.getComponentTree().findAll(StringSelectMenu.class).stream()
+                            .anyMatch(s -> e.getKey().equals(s.getCustomId()));
+            DataObject d = DataObject.empty().put("id", uid++).put("custom_id", e.getKey());
+            if (select) {
+                d.put("type", Component.Type.STRING_SELECT.getKey())
+                        .put("values", net.dv8tion.jda.api.utils.data.DataArray.fromCollection(
+                                List.of(e.getValue().split("\n"))));
+            } else {
+                d.put("type", Component.Type.TEXT_INPUT.getKey()).put("value", e.getValue());
+            }
+            out.add(new ModalMapping(null, DataObject.empty(), d)); // (interaction, resolved, component)
+        }
+        return out;
+    }
+
+}
