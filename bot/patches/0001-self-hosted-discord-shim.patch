diff --git a/src/main/java/ti4/helpers/UnitComponentLimit.java b/src/main/java/ti4/helpers/UnitComponentLimit.java
new file mode 100644
index 0000000..0f0ae3d
--- /dev/null
+++ b/src/main/java/ti4/helpers/UnitComponentLimit.java
@@ -0,0 +1,56 @@
+package ti4.helpers;
+
+import javax.annotation.Nullable;
+import lombok.experimental.UtilityClass;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.helpers.Units.UnitKey;
+import ti4.image.Mapper;
+
+/**
+ * Component limits of ships and mechs (rules: Producing Units / Reinforcements): a player cannot produce or place a
+ * unit with none left in their reinforcements. The production buttons always showed what is left ("Produce Flagship
+ * (0)") but never refused it, so a second flagship could be placed (fuzz pbd297: the Nomad starts with its
+ * flagship and produced another through Warfare's build). Fighters and infantry are not limited; structures keep
+ * their own checks.
+ */
+@UtilityClass
+public class UnitComponentLimit {
+
+    /** Units left in the player's reinforcements, or null when the unit type has no component limit checked here. */
+    @Nullable
+    public static Integer remaining(Game game, Player player, String asyncId) {
+        if (game == null || player == null || asyncId == null) return null;
+        UnitKey key;
+        try {
+            key = Mapper.getUnitKey(asyncId, player.getColorID());
+        } catch (Exception e) {
+            return null;
+        }
+        if (key == null || key.unitType() == null) return null;
+        switch (key.unitType()) {
+            case Flagship, Warsun, Dreadnought, Carrier, Cruiser, Destroyer, Mech -> {}
+            default -> {
+                return null;
+            }
+        }
+        return Math.max(0, ButtonHelperFactionSpecific.remainingUnitsOfType(game, key));
+    }
+
+    /** Why placing `count` more of the unit is refused (none left in reinforcements), or null when it fits. */
+    @Nullable
+    public static String refusal(Game game, Player player, String asyncId, int count) {
+        Integer left = remaining(game, player, asyncId);
+        if (left == null || left >= count) return null;
+        String name = asyncId;
+        try {
+            name = player.getUnitsByAsyncID(asyncId).getFirst().getName();
+        } catch (Exception ignored) {
+            // keep the id
+        }
+        return left == 0
