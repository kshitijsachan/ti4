+    // ------------------------------------------------------------------------------------------
+    // New draft system (DraftManager + draftables + orchestrator)
+    // ------------------------------------------------------------------------------------------
+
+    private DraftView buildNewSystem(Game game, DraftManager dm) {
+        String channelId = channelId(game);
+        Map<String, PlayerDraftState> states = dm.getPlayerStates();
+
+        List<String> order = dm.getOrchestrator() instanceof PublicSnakeDraftOrchestrator
+                ? PublicSnakeDraftOrchestrator.getDraftOrder(dm)
+                : new ArrayList<>(states.keySet());
+        int rounds = 0;
+        for (Draftable d : dm.getDraftables()) {
+            if (d instanceof ti4.service.draft.draftables.FixedNumberDraftable f) rounds += f.getNumPicksPerPlayer();
+            else rounds++;
+        }
+        List<String> pickOrder = new ArrayList<>();
+        for (int r = 0; r < rounds; r++) {
+            List<String> round = new ArrayList<>(order);
+            if (r % 2 == 1) Collections.reverse(round);
+            pickOrder.addAll(round);
+        }
+        int pickIndex = 0;
+        for (PlayerDraftState s : states.values())
+            for (List<DraftChoice> l : s.getPicks().values()) pickIndex += l.size();
+        boolean finished = pickIndex >= pickOrder.size();
+        String current = null;
+        if (!finished && dm.getOrchestrator() instanceof PublicSnakeDraftOrchestrator psd && !order.isEmpty()) {
+            current = order.get(Math.max(0, Math.min(order.size() - 1, psd.getCurrentPlayerIndex())));
+        } else if (!finished) {
+            current = pickIndex < pickOrder.size() ? pickOrder.get(pickIndex) : null;
+        }
+        String next = !finished && pickIndex + 1 < pickOrder.size() ? pickOrder.get(pickIndex + 1) : null;
+        Map<String, String> buttonMessages = finished ? Map.of() : buttonLocator.locate(game);
+
+        Map<String, String> owner = new HashMap<>();
+        for (Map.Entry<String, PlayerDraftState> e : states.entrySet())
+            for (List<DraftChoice> l : e.getValue().getPicks().values())
+                for (DraftChoice c : l) owner.put(c.type() + "|" + c.choiceKey(), e.getKey());
+
+        List<SliceView> slices = new ArrayList<>();
+        List<FactionView> factions = new ArrayList<>();
+        List<OrderView> speaker = new ArrayList<>();
+        List<OrderView> seats = new ArrayList<>();
+        List<CategoryView> other = new ArrayList<>();
+        for (Draftable d : dm.getDraftables()) {
+            for (DraftChoice c : d.getAllDraftChoices()) {
+                String customId = c.button() == null ? null : c.button().getCustomId();
+                ChoiceView cv = new ChoiceView(
+                        c.choiceKey(),
+                        c.unformattedName(),
+                        customId,
+                        channelId,
+                        customId == null ? null : buttonMessages.get(customId),
+                        owner.get(c.type() + "|" + c.choiceKey()));
+                if (d instanceof SliceDraftable sd) {
+                    MiltyDraftSlice slice = sd.getSliceByName(c.choiceKey());
+                    if (slice != null) slices.add(sliceView(slice, cv));
+                } else if (d instanceof FactionDraftable) {
+                    FactionModel model = Mapper.getFaction(c.choiceKey());
+                    if (model != null) factions.add(factionView(model, c.unformattedName(), cv));
+                } else if (d instanceof SpeakerOrderDraftable) {
+                    int n = parseTrailingInt(c.choiceKey());
+                    speaker.add(new OrderView(n, c.unformattedName(), emojiUrl(c.identifyingEmoji()), cv));
+                } else if (d instanceof SeatDraftable) {
+                    int n = parseTrailingInt(c.choiceKey());
+                    seats.add(new OrderView(n, c.unformattedName(), emojiUrl(c.identifyingEmoji()), cv));
+                }
+            }
+            if (!(d instanceof SliceDraftable
+                    || d instanceof FactionDraftable
+                    || d instanceof SpeakerOrderDraftable
+                    || d instanceof SeatDraftable)) {
+                List<ChoiceView> choices = new ArrayList<>();
+                for (DraftChoice c : d.getAllDraftChoices()) {
+                    String customId = c.button() == null ? null : c.button().getCustomId();
+                    choices.add(new ChoiceView(
+                            c.choiceKey(),
+                            c.unformattedName(),
+                            customId,
+                            channelId,
+                            customId == null ? null : buttonMessages.get(customId),
+                            owner.get(c.type() + "|" + c.choiceKey())));
+                }
+                other.add(new CategoryView(d.getType().toString(), d.getDisplayName(), choices));
+            }
+        }
+
+        List<DraftPlayer> players = new ArrayList<>();
+        int draftPosition = 1;
+        for (String userId : order) {
+            PlayerDraftState s = states.get(userId);
+            List<PickView> picks = new ArrayList<>();
+            String faction = null, slice = null;
+            Integer speakerPos = null, seat = null;
+            for (Map.Entry<ti4.service.draft.DraftableType, List<DraftChoice>> e :
+                    s.getPicks().entrySet()) {
+                for (DraftChoice c : e.getValue()) {
+                    String type = typeKey(e.getKey().toString());
+                    picks.add(new PickView(type, c.choiceKey(), c.unformattedName()));
+                    switch (type) {
+                        case "faction" -> faction = c.choiceKey();
+                        case "slice" -> slice = c.choiceKey();
+                        case "speakerOrder" -> speakerPos = parseTrailingInt(c.choiceKey());
+                        case "seat" -> seat = parseTrailingInt(c.choiceKey());
+                        default -> {}
+                    }
+                }
+            }
+            players.add(playerView(
+                    game,
+                    userId,
+                    draftPosition++,
+                    faction,
+                    slice,
+                    speakerPos,
+                    seat,
+                    picks,
+                    userId.equals(current),
+                    userId.equals(next)));
+        }
+
+        return new DraftView(
+                game.getName(),
+                "draft",
+                finished ? "finished" : "drafting",
+                game.getPhaseOfGame(),
+                game.getLastModifiedDate(),
+                channelId,
+                players,
+                pickOrder,
+                pickIndex,
+                current,
+                next,
+                slices,
+                factions,
+                speaker,
+                seats,
+                other,
+                templateView(game, game.getMapTemplateID()),
+                icons());
+    }
+
+    private static String typeKey(String type) {
+        return switch (type) {
+            case "Slice" -> "slice";
+            case "Faction" -> "faction";
+            case "SpeakerOrder" -> "speakerOrder";
+            case "Seat" -> "seat";
+            default -> type;
+        };
+    }
+
+    // ------------------------------------------------------------------------------------------
+    // Shared pieces
+    // ------------------------------------------------------------------------------------------
+
+    private static String channelId(Game game) {
+        try {
+            var ch = game.getMainGameChannel();
+            return ch == null ? null : ch.getId();
+        } catch (Exception e) {
+            return null;
+        }
+    }
+
+    private static DraftPlayer playerView(
+            Game game,
+            String userId,
+            int draftPosition,
+            String faction,
+            String slice,
+            Integer speakerOrder,
+            Integer seat,
+            List<PickView> picks,
+            boolean current,
+            boolean next) {
+        Player p = game.getPlayer(userId);
+        String name = p == null ? userId : p.getUserName();
+        String color = p == null ? null : p.getColor();
+        if ("null".equals(color)) color = null;
+        return new DraftPlayer(
+                userId, name, color, draftPosition, faction, slice, speakerOrder, seat, picks, current, next);
+    }
+
+    private static int parseTrailingInt(String s) {
+        Matcher m = Pattern.compile("(\\d+)$").matcher(s == null ? "" : s);
+        return m.find() ? Integer.parseInt(m.group(1)) : 0;
+    }
+
+    private static String factionName(String alias) {
+        FactionModel model = Mapper.getFaction(alias);
+        if (model == null) return alias;
+        return alias.startsWith("keleres") ? "The Council Keleres" : model.getFactionName();
+    }
+
+    private static SliceView sliceView(MiltyDraftSlice slice, ChoiceView choice) {
+        List<TileView> tiles = new ArrayList<>();
+        Set<String> skips = new LinkedHashSet<>();
+        List<String> skipList = new ArrayList<>();
+        List<String> wormholes = new ArrayList<>();
+        int planets = 0, legendaries = 0, anomalies = 0;
+        for (MiltyDraftTile dt : slice.getTiles()) {
+            TileView tv = tileView(dt);
+            tiles.add(tv);
+            planets += (int) tv.planets().stream().filter(p -> !p.station()).count();
+            legendaries += (int) tv.planets().stream().filter(PlanetView::legendary).count();
+            if (!tv.anomalies().isEmpty()) anomalies++;
+            wormholes.addAll(tv.wormholes());
+            for (PlanetView p : tv.planets()) {
+                skipList.addAll(p.techSpecialties());
+                skips.addAll(p.techSpecialties());
+            }
+        }
+        SliceTotals totals = new SliceTotals(
+                slice.getTotalRes(),
+                slice.getTotalInf(),
+                slice.getOptimalRes(),
+                slice.getOptimalInf(),
+                slice.getOptimalFlex(),
+                slice.getOptimalTotalValue(),
+                planets,
+                legendaries,
+                anomalies,
+                skipList,
+                wormholes);
+        return new SliceView(slice.getName(), tiles, totals, choice);
+    }
+
+    private static TileView tileView(MiltyDraftTile dt) {
+        Tile tile = dt.getTile();
+        TileModel model = tile.getTileModel();
+        List<String> wormholes = new ArrayList<>();
+        if (model != null && model.getWormholes() != null) {
+            for (WormholeModel.Wormhole wh : model.getWormholes()) wormholes.add(wh.toString().toLowerCase());
+        }
+        if (wormholes.isEmpty()) {
+            if (dt.isHasAlphaWH()) wormholes.add("alpha");
+            if (dt.isHasBetaWH()) wormholes.add("beta");
+            if (dt.isHasOtherWH()) wormholes.add("gamma");
+        }
+        List<String> anomalies = new ArrayList<>();
+        if (model != null) {
+            if (model.isAsteroidField()) anomalies.add("asteroid");
+            if (model.isSupernova()) anomalies.add("supernova");
+            if (model.isNebula()) anomalies.add("nebula");
+            if (model.isGravityRift()) anomalies.add("rift");
+            if (model.isScar()) anomalies.add("scar");
+        }
+        List<PlanetView> planets = new ArrayList<>();
+        for (Planet p : tile.getPlanetUnitHolders()) planets.add(planetView(p));
+        return new TileView(
+                tile.getTileID(),
+                model == null ? tile.getTileID() : model.getNameNullSafe(),
+                dt.getTierList() == null ? null : dt.getTierList().toString(),
+                TILE_IMAGE_BASE + tile.getTileID(),
+                dt.getResources(),
+                dt.getInfluence(),
+                wormholes,
+                anomalies,
+                planets);
+    }
+
+    private static PlanetView planetView(Planet p) {
+        PlanetModel model = p.getPlanetModel();
+        List<String> traits = new ArrayList<>();
+        for (String t : p.getPlanetTypes()) {
+            if (t != null && !t.isBlank() && !"none".equalsIgnoreCase(t)) traits.add(t.toLowerCase());
+        }
+        List<String> skips = new ArrayList<>();
+        for (String s : p.getTechSpecialities()) if (s != null && !s.isBlank()) skips.add(s.toLowerCase());
+        String legendaryAbility = model == null ? null : model.getLegendaryAbilityName();
+        String legendaryText = model == null ? null : model.getLegendaryAbilityText();
+        return new PlanetView(
+                p.getName(),
+                model == null ? p.getName() : model.getName(),
+                p.getResources(),
+                p.getInfluence(),
+                traits,
+                skips,
+                p.isLegendary(),
+                legendaryAbility,
+                legendaryText,
+                p.isSpaceStation());
+    }
+
+    private static PlanetView planetModelView(PlanetModel model) {
+        List<String> traits = new ArrayList<>();
+        if (model.getPlanetTypes() != null)
+            for (var t : model.getPlanetTypes()) traits.add(t.toString().toLowerCase());
+        List<String> skips = new ArrayList<>();
+        if (model.getTechSpecialties() != null)
+            for (var s : model.getTechSpecialties()) skips.add(s.toString().toLowerCase());
+        return new PlanetView(
+                model.getId(),
+                model.getName(),
+                model.getResources(),
+                model.getInfluence(),
+                traits,
+                skips,
+                model.getLegendaryAbilityName() != null,
+                model.getLegendaryAbilityName(),
+                model.getLegendaryAbilityText(),
+                false);
+    }
+
+    private static FactionView factionView(FactionModel model, String displayName, ChoiceView choice) {
+        List<PlanetView> homePlanets = new ArrayList<>();
+        if (model.getHomePlanets() != null) {
+            for (String id : model.getHomePlanets()) {
+                PlanetModel pm = Mapper.getPlanet(id);
+                if (pm != null) homePlanets.add(planetModelView(pm));
+            }
+        }
+        List<String> abilities = new ArrayList<>();
+        if (model.getAbilities() != null) {
+            for (String id : model.getAbilities()) {
+                AbilityModel am = Mapper.getAbility(id);
+                abilities.add(am == null ? id : am.getName());
+            }
+        }
+        List<String> factionTech = techNames(model.getFactionTech());
+        List<String> startingTech = techNames(model.getStartingTech());
+        String home = model.getHomeSystem();
+        String homeImage = null;
+        if (home != null && TileHelper.getTileById(home) != null) homeImage = TILE_IMAGE_BASE + home;
+        return new FactionView(
+                model.getAlias(),
+                displayName,
+                model.getShortName(),
+                emojiUrl(model.getFactionEmoji()),
+                model.getSource() == null ? null : model.getSource().toString(),
+                model.getCommodities(),
+                model.getComplexity(),
+                home,
+                homeImage,
+                homePlanets,
+                abilities,
+                factionTech,
+                startingTech,
+                choice);
+    }
+
+    private static List<String> techNames(List<String> ids) {
+        List<String> out = new ArrayList<>();
+        if (ids == null) return out;
+        for (String id : ids) {
+            TechnologyModel tm = Mapper.getTech(id);
+            out.add(tm == null ? id : tm.getName());
+        }
+        return out;
+    }
+
+    private static MapTemplateView templateView(Game game, String alias) {
+        MapTemplateModel template = alias == null ? null : Mapper.getMapTemplate(alias);
+        if (template == null) return null;
+        List<DraftViewModels.Point> layout = new ArrayList<>();
+        try {
+            for (java.awt.Point p : template.tileDisplayCoords()) layout.add(new DraftViewModels.Point(p.x, p.y));
+        } catch (Exception ignored) {
+            // leave empty
+        }
+        Map<String, TemplatePosition> positions = new LinkedHashMap<>();
+        if (template.getTemplateTiles() != null) {
+            for (MapTemplateTile t : template.getTemplateTiles()) {
+                if (t.getPos() == null) continue;
+                positions.put(t.getPos(), position(game, t.getPos(), t));
+            }
+        }
+        for (String pos : game.getTileMap().keySet()) {
+            if (!positions.containsKey(pos)) positions.put(pos, position(game, pos, null));
+        }
+        List<TemplatePosition> list = positions.values().stream()
+                .filter(Objects::nonNull)
+                .toList();
+        return new MapTemplateView(
+                template.getAlias(),
+                template.getDescr(),
+                template.getPlayerCount(),
+                TILE_W,
+                TILE_H,
+                layout,
+                list);
+    }
+
+    private static TemplatePosition position(Game game, String pos, MapTemplateTile t) {
+        java.awt.Point p = PositionMapper.getTilePosition(pos);
+        if (p == null) return null;
+        Tile tile = game.getTileByPosition(pos);
+        String tileId = tile == null ? null : tile.getTileID();
+        String image = tileId == null ? null : TILE_IMAGE_BASE + tileId;
+        return new TemplatePosition(
+                pos,
+                p.x,
+                p.y,
+                t == null ? null : t.getPlayerNumber(),
+                t == null ? null : t.getMiltyTileIndex(),
+                t != null && Boolean.TRUE.equals(t.getHome()),
+                t == null ? null : t.getStaticTileId(),
+                tileId,
+                image);
+    }
+
+    private static Icons icons() {
+        Map<String, String> g = new LinkedHashMap<>();
+        put(g, "propulsion", TechEmojis.PropulsionTech);
+        put(g, "biotic", TechEmojis.BioticTech);
+        put(g, "cybernetic", TechEmojis.CyberneticTech);
+        put(g, "warfare", TechEmojis.WarfareTech);
+        put(g, "alpha", MiscEmojis.WHalpha);
+        put(g, "beta", MiscEmojis.WHbeta);
+        put(g, "gamma", MiscEmojis.WHgamma);
+        put(g, "legendary", MiscEmojis.LegendaryPlanet);
+        put(g, "speaker", MiscEmojis.SpeakerToken);
+        put(g, "resources", MiscEmojis.resources);
+        put(g, "influence", MiscEmojis.influence);
+        put(g, "cultural", ExploreEmojis.Cultural);
+        put(g, "industrial", ExploreEmojis.Industrial);
+        put(g, "hazardous", ExploreEmojis.Hazardous);
+        put(g, "frontier", ExploreEmojis.Frontier);
+        return new Icons(g);
+    }
+
+    private static void put(Map<String, String> map, String key, TI4Emoji emoji) {
+        String url = emojiUrl(emoji);
+        if (url != null) map.put(key, url);
+    }
+
+    private static String emojiUrl(TI4Emoji emoji) {
+        try {
+            return emoji == null ? null : emojiUrl(emoji.emojiString());
+        } catch (Exception e) {
+            return null;
+        }
+    }
+
+    static String emojiUrl(String formatted) {
+        if (formatted == null) return null;
+        Matcher m = EMOJI.matcher(formatted);
+        if (!m.find()) return null;
+        return "/emojis/" + m.group(2) + ("a".equals(m.group(1)) ? ".gif" : ".png");
+    }
+}
diff --git a/src/main/java/ti4/spring/api/selfhost/TradeController.java b/src/main/java/ti4/spring/api/selfhost/TradeController.java
new file mode 100644
