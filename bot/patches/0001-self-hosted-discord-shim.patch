--- /dev/null
+++ b/src/test/java/ti4/selfhost/engine/interaction/NativeCoverageReport.java
@@ -0,0 +1,28 @@
+package ti4.selfhost.engine.interaction;
+
+import java.util.Map;
+
+public class NativeCoverageReport {
+    public static void main(String[] a) {
+        NativeCoverage.Report r = NativeCoverage.report();
+        System.out.println("handlers " + r.handlers() + " native " + r.nativeHandlers() + " = " + r.nativePercent() + "%; direct (no token ops) " + r.directHandlers() + " = " + r.directPercent() + "%");
+        r.byKind().forEach((k, v) -> System.out.println("  " + k + ": " + v[1] + "/" + v[0]));
+        System.out.println("pipeline unsupported: " + r.pipelineUnsupported());
+        System.out.println("-- unsupported ops (handlers affected):");
+        int i = 0;
+        for (Map.Entry<String, Integer> e : r.unsupportedOps().entrySet()) {
+            if (i++ > 40) break;
+            System.out.println("  " + e.getValue() + "  " + e.getKey());
+        }
+        System.out.println("-- op usage (top 40):");
+        i = 0;
+        for (Map.Entry<String, Integer> e : r.opUsage().entrySet()) {
+            if (i++ > 40) break;
+            System.out.println("  " + e.getValue() + "  " + e.getKey());
+        }
+        if (a.length > 0)
+            for (var c : r.nonNative())
+                System.out.println("NON " + c.kind() + " " + c.key() + " " + c.method() + " " + c.unsupported());
+        System.exit(0);
+    }
+}
diff --git a/src/test/java/ti4/selfhost/engine/kinds/MsgStateSuffixesTest.java b/src/test/java/ti4/selfhost/engine/kinds/MsgStateSuffixesTest.java
new file mode 100644
index 0000000..268ffef
--- /dev/null
+++ b/src/test/java/ti4/selfhost/engine/kinds/MsgStateSuffixesTest.java
@@ -0,0 +1,55 @@
+package ti4.selfhost.engine.kinds;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import java.util.List;
+import java.util.Map;
+import org.junit.jupiter.api.Test;
+import ti4.game.Game;
+import ti4.helpers.DoneRole;
+import ti4.selfhost.engine.KindSpec.CaptureContext;
+
+/** c9b id suffixes (~pick, _discount, DoneRole tags) keep the c-kinds' typing (cov-batch1). */
+class MsgStateSuffixesTest {
+
+    private static CaptureContext ctx(String... handlerIds) {
+        Game game = new Game();
+        game.setName("pbd0");
+        return new CaptureContext(game, "c", "m", "", false, null, null, List.of(handlerIds));
+    }
+
+    @Test
+    void agentTargetPickerMarkerIsNotPartOfTheTarget() {
+        FactionSteps.Step trailing = FactionSteps.Registry.find("exhaustAgent_mentakagent_sol~pick", null);
+        assertThat(trailing).isNotNull();
+        assertThat(trailing.kind()).isEqualTo("leader.use");
+        assertThat(trailing.fields().get("target")).isEqualTo("sol");
+
+        // getButtonsForAgentSelection: "exhaustAgent_<agent>~pick" + "_<faction>"
+        FactionSteps.Step picker = FactionSteps.Registry.find("exhaustAgent_keleresagent~pick_hacan", null);
+        assertThat(picker).isNotNull();
+        assertThat(picker.kind()).isEqualTo("leader.use");
+        assertThat(picker.component()).isEqualTo("keleresagent");
+        assertThat(picker.fields().get("target")).isEqualTo("hacan");
+    }
+
+    @Test
+    void aidaDiscountIsTheAidaTech() {
+        String h = "exhaustTech_aida_discount";
+        Map<String, Object> step = new TechStepKind().value(h, ctx(h, "deleteButtons"));
+        assertThat(step).containsEntry("source", "aida").containsEntry("use", "discount");
+
+        Map<String, Object> menu = new ComponentActionKind().value(h, ctx(h));
+        assertThat(menu).containsEntry("id", "aida").containsEntry("use", "discount");
+    }
+
+    @Test
+    void taggedDoneButtonsCloseTheirOwnKindOnly() {
+        assertThat(PaymentSpendKind.isDone(DoneRole.pay("deleteButtons_spitItOut"))).isTrue();
+        assertThat(PaymentSpendKind.isDone(DoneRole.produce("deleteButtons_warfare_37"))).isFalse();
+        assertThat(ProductionProduceKind.isDone(DoneRole.produce("deleteButtons_warfare_37"))).isTrue();
+        assertThat(ProductionProduceKind.isDone(DoneRole.pay("deleteButtons"))).isFalse();
+        // Chrome detection (generic choose.* / faction kinds) still treats tagged closers as Done.
+        assertThat(ChooseSupport.isChrome(DoneRole.ccGain("deleteButtons"))).isTrue();
+    }
+}
