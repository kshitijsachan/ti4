@@ -0,0 +1,55 @@
+package ti4.spring.api.selfhost;
+
+import java.util.List;
+
+/** JSON shapes for {@link UndoController}. */
+public final class UndoModels {
+
+    private UndoModels() {}
+
+    /**
+     * One saved state of the game. {@code index} restores it via rewind. {@code savedAt} is the game's own save time
+     * (epoch ms, {@code last_modified_date} in the file); {@code label} is a readable version of {@code command}, the
+     * bot's {@code latest_command} (the action that produced this state).
+     */
+    public record UndoPoint(
+            int index,
+            long savedAt,
+            long fileTime,
+            String command,
+            String actor,
+            String label,
+            int round,
+            String phase,
+            boolean current,
+            /* faction or color of the player whose button press made this save (the bot's saved_buttons) */
+            String actorFaction,
+            /* that player's user id, resolved against the game */
+            String actorUserId) {}
+
+    /**
+     * A roll-back from the bot's own undo code (any path). See {@link UndoJournal}. {@code lostSavedAt}: save times of
+     * the undo copies it deleted (the bot keeps only one linear history).
+     */
+    public record Rewind(
+            long at,
+            int fromIndex,
+            int toIndex,
+            long fromSavedAt,
+            long toSavedAt,
+            String kind,
+            String byUserId,
+            String byName,
+            String label,
+            List<Long> lostSavedAt) {}
+
+    public record UndoPointsResponse(
+            String gameName, int latestIndex, boolean canUndo, List<UndoPoint> points, List<Rewind> rewinds) {}
+
+    public record RewindRequest(Integer index) {}
+
+    public record UndoRequest(Boolean force) {}
+
+    /** Result of a rewind / undo: the save now in effect and the label of what was undone. */
+    public record RewindResponse(boolean ok, int restoredIndex, String restoredLabel, String undoneLabel, int latestIndex) {}
+}
diff --git a/src/main/java/ti4/spring/api/selfhost/UndoService.java b/src/main/java/ti4/spring/api/selfhost/UndoService.java
new file mode 100644
index 0000000..6a3ff03
--- /dev/null
+++ b/src/main/java/ti4/spring/api/selfhost/UndoService.java
@@ -0,0 +1,450 @@
+package ti4.spring.api.selfhost;
+
+import java.io.BufferedReader;
+import java.io.File;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+import org.springframework.stereotype.Service;
+import ti4.executors.ExecutionLockManager;
+import ti4.executors.ExecutionLockType;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.game.persistence.GameManager;
+import ti4.game.persistence.ManagedGame;
+import ti4.helpers.Constants;
+import ti4.helpers.Storage;
+import ti4.logging.BotLogger;
+import ti4.message.MessageHelper;
+import ti4.service.game.GameUndoNameService;
+import ti4.spring.api.selfhost.UndoModels.Rewind;
+import ti4.spring.api.selfhost.UndoModels.RewindResponse;
+import ti4.spring.api.selfhost.UndoModels.UndoPoint;
+import ti4.spring.api.selfhost.UndoModels.UndoPointsResponse;
+
+/**
+ * Undo / rewind for the self-hosted web client, on top of the bot's own undo files ({@code <game>_N.txt}, one per
+ * save) and its own undo code path ({@link GameManager#undo}): same file locks, the same undo-log thread entry, the same
+ * re-posted buttons and cards-info refresh. Additionally: a rewind is announced in the actions channel and is itself
+ * undoable (the pre-rewind state is kept as the save just below the rewound one).
+ */
+@Service
+public class UndoService {
+
+    public static class UndoException extends RuntimeException {
+        final int status;
+        final boolean needsForce;
+
+        UndoException(int status, String message) {
+            this(status, message, false);
+        }
+
+        UndoException(int status, String message, boolean needsForce) {
+            super(message);
+            this.status = status;
+            this.needsForce = needsForce;
+        }
+    }
+
+    public static final String REWIND_MARK = "⏪";
+
+    private record CachedPoint(long fileTime, long size, UndoPoint point) {}
+
+    private final Map<String, CachedPoint> cache = new ConcurrentHashMap<>();
+
+    public UndoPointsResponse list(String gameName) {
+        List<Integer> numbers = GameUndoNameService.getSortedUndoNumbers(gameName);
+        int latest = numbers.isEmpty() ? -1 : numbers.getLast();
+        ManagedGame managed = GameManager.getManagedGame(gameName);
+        Names names = managed == null || managed.getGame() == null ? null : names(managed.getGame());
+        List<UndoPoint> points = new ArrayList<>();
+        for (int i = numbers.size() - 1; i >= 0; i--) {
+            int index = numbers.get(i);
+            UndoPoint p = readPoint(gameName, index, index == latest);
+            if (p != null) points.add(humanize(p, names));
+        }
+        List<Rewind> rewinds = UndoJournal.read(gameName).stream()
+                .map(e -> new Rewind(e.at(), e.fromIndex(), e.toIndex(), e.fromSavedAt(), e.toSavedAt(), e.kind(),
+                        e.byUserId(), e.byName(), e.label(), e.lostSavedAt()))
+                .toList();
+        boolean canUndo = latest > 1 && numbers.contains(latest - 1);
+        return new UndoPointsResponse(gameName, latest, canUndo, points, rewinds);
+    }
+
+    /** Rewind to the state saved as {@code index} (the state just after that save's action). */
+    public RewindResponse rewind(String gameName, String userId, int index) {
+        return locked(gameName, () -> {
+            Game game = loadGame(gameName);
+            Player me = requirePlayer(game, userId);
+            if (game.isFowMode()) throw new UndoException(403, "Rewind is not available in fog-of-war games.");
+
+            List<Integer> numbers = GameUndoNameService.getSortedUndoNumbers(gameName);
+            if (numbers.isEmpty()) throw new UndoException(409, "This game has no saved states.");
+            int latest = numbers.getLast();
+            if (index == latest) throw new UndoException(409, "That is already the current state.");
+            if (!numbers.contains(index) || index <= 0 || index > latest)
+                throw new UndoException(404, "Save " + index + " no longer exists (only the last ~100 are kept).");
+
+            Names names = names(game);
+            UndoPoint target = humanize(readPoint(gameName, index, false), names);
+            UndoPoint undone = humanize(readPoint(gameName, latest, true), names);
+            String targetLabel = target == null ? "save " + index : target.label();
+            String who = displayName(me);
+
+            Path gameFile = Storage.getGameFile(gameName + Constants.TXT).toPath();
+            byte[] beforeRewind;
+            try {
+                beforeRewind = Files.readAllBytes(gameFile);
+            } catch (Exception e) {
+                throw new UndoException(500, "Could not read the current game file.");
+            }
+
+            long rollbackStart = System.currentTimeMillis();
+            Game restored = UndoJournal.withContext(
+                    "rewind", userId, who, targetLabel, () -> GameManager.undo(game, index));
+            if (restored == null) throw new UndoException(500, "The bot failed to roll back to save " + index + ".");
+            retirePrompts(restored, target != null ? target.savedAt() : rollbackStart, rollbackStart);
+
+            // Keep the pre-rewind state as the next save, then save the rewound state on top of it: one undo step
+            // (the UNDO button, /game undo or POST /undo) then brings back everything the rewind threw away.
+            try {
+                Files.write(Storage.getGameUndo(gameName, gameName + "_" + (index + 1) + Constants.TXT), beforeRewind);
+            } catch (Exception e) {
+                BotLogger.error("Could not keep the pre-rewind state of " + gameName, e);
+            }
+            // Undoing the rewind must not re-post the restored state's old prompt (the bot re-posts the "saved
+            // buttons" of the state being undone); the pre-rewind prompts are still in the channel.
+            restored.setSavedButtons(new ArrayList<>());
+            String reason = REWIND_MARK + " " + who + " rewound the game to: " + targetLabel;
+            GameManager.save(restored, reason);
+            MessageHelper.sendMessageToChannel(
+                    restored.getActionsChannel(),
+                    REWIND_MARK + " " + me.getRepresentationNoPing() + " rewound the game to just after: **"
+                            + targetLabel + "** (save " + index + "). Everything after it was undone. Undo once to"
+                            + " bring it back.");
+            int newLatest = GameUndoNameService.getLatestUndoNumber(gameName);
+            return new RewindResponse(true, index, targetLabel, undone == null ? "" : undone.label(), newLatest);
+        });
+    }
+
+    /** One step back, like the UNDO button: restores the save before the latest one. */
+    public RewindResponse undo(String gameName, String userId, boolean force) {
+        return locked(gameName, () -> {
+            Game game = loadGame(gameName);
+            Player me = requirePlayer(game, userId);
+            if (game.isFowMode()) throw new UndoException(403, "Undo from the web is not available in fog-of-war games.");
+
+            List<Integer> numbers = GameUndoNameService.getSortedUndoNumbers(gameName);
+            int latest = numbers.isEmpty() ? -1 : numbers.getLast();
+            if (latest <= 1 || !numbers.contains(latest - 1)) throw new UndoException(409, "There is nothing to undo.");
+            Names names = names(game);
+            UndoPoint undone = humanize(readPoint(gameName, latest, true), names);
+            UndoPoint previous = humanize(readPoint(gameName, latest - 1, false), names);
+            String undoneLabel = undone == null ? "the last action" : undone.label();
+            boolean lastWasRewind = undone != null && undone.command().startsWith(REWIND_MARK);
+
+            // Same rule as the UNDO button: only the player who pressed the latest button may undo it.
+            if (!force && !lastWasRewind && !game.getSavedButtons().isEmpty()) {
+                String colorOrFaction = game.getSavedButtons().getFirst().split(";")[0];
+                Player p = game.getPlayerFromColorOrFaction(colorOrFaction);
+                if (p != null && p != me && !"null".equals(colorOrFaction)) {
+                    throw new UndoException(
+                            409,
+                            "The latest button was pressed by " + displayName(p) + ", not you: " + undoneLabel + ".",
+                            true);
+                }
+            }
+
+            String who = displayName(me);
+            long rollbackStart = System.currentTimeMillis();
+            Game restored = UndoJournal.withContext("undo", userId, who, undoneLabel, () -> GameManager.undo(game));
+            if (restored == null) throw new UndoException(500, "The bot failed to undo.");
+            retirePrompts(restored, previous != null ? previous.savedAt() : rollbackStart, rollbackStart);
+            MessageHelper.sendMessageToChannel(
+                    restored.getActionsChannel(),
+                    REWIND_MARK + " " + me.getRepresentationNoPing() + " undid: **" + undoneLabel + "**.");
+            return new RewindResponse(
+                    true,
+                    latest - 1,
+                    previous == null ? "" : previous.label(),
+                    undoneLabel,
+                    GameUndoNameService.getLatestUndoNumber(gameName));
+        });
+    }
+
+    /** A prompt posted up to this long after a save belongs to that save's action (and is still valid). */
+    private static final long PROMPT_SLACK_MS = 1500;
+
+    /**
+     * The Discord UNDO button deletes the prompt it was pressed on; a web undo / rewind has no such message, so the
+     * prompts of the undone actions would stay pressable (and show up as decisions) although the game state they were
+     * made for is gone. Strip the buttons of every bot message posted after the restored save and before the roll-back
+     * (the bot re-posts the restored state's own prompt after that) in the game's actions channel, table-talk channel
+     * and the players' cards-info threads. The text stays, so the game log can still show what was undone.
+     */
+    private static void retirePrompts(Game game, long restoredSavedAt, long rollbackStart) {
+        long from = restoredSavedAt + PROMPT_SLACK_MS;
+        java.util.concurrent.CompletableFuture.runAsync(() -> {
+          try {
+            List<net.dv8tion.jda.api.entities.channel.middleman.MessageChannel> channels = new ArrayList<>();
+            try {
+                if (game.getActionsChannel() != null) channels.add(game.getActionsChannel());
+                if (game.getMainGameChannel() != null) channels.add(game.getMainGameChannel());
+                for (Player p : game.getRealPlayers()) {
+                    try {
+                        if (p.getCardsInfoThread() != null) channels.add(p.getCardsInfoThread());
+                    } catch (Exception ignored) {
+                        // a player without a cards-info thread has no prompts there
+                    }
+                }
+            } catch (Exception e) {
+                BotLogger.error("Could not list the channels of " + game.getName() + " to retire undone prompts", e);
+                return;
+            }
+            Player active = activeTurnPlayer(game);
+            String turnPrefix = active == null ? null : "FFCC_" + active.getFaction() + "_";
+            long turnStart = game.getLastActivePlayerChange() == null ? 0 : game.getLastActivePlayerChange().getTime();
+            boolean activeHasPrompt = false;
+            for (var channel : channels) {
+                try {
+                    long self = channel.getJDA().getSelfUser().getIdLong();
+                    List<net.dv8tion.jda.api.entities.Message> recent =
+                            channel.getHistory().retrievePast(100).complete();
+                    for (var m : recent) {
+                        if (m.getAuthor().getIdLong() != self || m.getComponents().isEmpty()) continue;
+                        long created = m.getTimeCreated().toInstant().toEpochMilli();
+                        if (created >= from && created < rollbackStart) {
+                            m.editMessageComponents(java.util.Collections.emptyList())
+                                    .queue(ok -> {}, BotLogger::catchRestError);
+                            continue;
+                        }
+                        if (turnPrefix != null && created >= turnStart && hasButton(m, turnPrefix)) activeHasPrompt = true;
+                    }
+                } catch (Exception e) {
+                    BotLogger.error("Could not retire undone prompts in " + channel.getName(), e);
+                }
+            }
+            if (active != null && !activeHasPrompt) restoreTurnPrompt(game, active);
+          } catch (Throwable t) {
+            BotLogger.error("Could not tidy prompts after a roll-back in " + game.getName(), t);
+          }
+        });
+    }
+
+    private static boolean hasButton(net.dv8tion.jda.api.entities.Message m, String idPrefix) {
+        for (var b : m.getComponentTree().findAll(net.dv8tion.jda.api.components.buttons.Button.class)) {
+            String id = b.getCustomId();
+            if (id != null && id.startsWith(idPrefix)) return true;
+        }
+        return false;
+    }
+
+    /** The player whose action-phase turn it is, when no tactical action is under way (that has its own prompts). */
+    private static Player activeTurnPlayer(Game game) {
+        if (game.isFowMode() || !"action".equalsIgnoreCase(game.getPhaseOfGame())) return null;
+        // getActiveSystem() falls back to the last activated system; the current one is blank between actions.
+        String system = game.getCurrentActiveSystem();
+        if (system != null && !system.isBlank() && !"null".equals(system)) return null;
+        Player p = game.getActivePlayer();
+        return p == null || !p.isRealPlayer() || p.isPassed() ? null : p;
+    }
+
+    /**
+     * A roll-back can land in the middle of a turn whose prompt the bot already deleted (it deletes a prompt once it
+     * is pressed), leaving the active player with nothing to press. Re-post the bot's own turn buttons: the start-of-
+     * turn menu, or "end turn / do another action" when an action was already taken this turn.
+     */
+    private static void restoreTurnPrompt(Game game, Player player) {
+        try {
+            boolean acted = !game.getStoredValue("currentActionSummary" + player.getFaction()).isBlank();
+            var buttons = ti4.service.turn.StartTurnService.getStartOfTurnButtons(player, game, acted, null);
+            if (buttons == null || buttons.isEmpty()) return;
+            String text = player.getRepresentationUnfogged()
+                    + (acted ? ", use buttons to end turn, or do another action." : ", use buttons to do your turn.");
+            var channel = game.getMainGameChannel() != null ? game.getMainGameChannel() : game.getActionsChannel();
+            MessageHelper.sendMessageToChannelWithButtons(channel, text, buttons);
+        } catch (Exception e) {
+            BotLogger.error("Could not restore the turn prompt of " + game.getName(), e);
+        }
+    }
+
+    private static <T> T locked(String gameName, java.util.function.Supplier<T> task) {
+        ExecutionLockManager.lock(gameName, ExecutionLockType.WRITE);
+        try {
+            return task.get();
+        } finally {
+            ExecutionLockManager.unlock(gameName, ExecutionLockType.WRITE);
+        }
+    }
+
+    private static Game loadGame(String gameName) {
+        ManagedGame managed = GameManager.getManagedGame(gameName);
+        Game game = managed == null ? null : managed.getGame();
+        if (game == null) throw new UndoException(404, "Unknown game " + gameName + ".");
+        return game;
+    }
+
+    private static Player requirePlayer(Game game, String userId) {
+        Player p = game.getPlayer(userId);
+        if (p == null) throw new UndoException(403, "You are not a player in this game.");
+        return p;
+    }
+
+    /** The game, for naming the players in saves (by user name, display name or faction). */
+    private record Names(Game game, Map<String, Player> byName) {}
+
+    /**
+     * Saved commands name the Discord user ("traderann pressed …"); the web shows players by their display name.
+     * Maps each player's user name (and its lower-case, space-free form, for a user JDA no longer caches) to them.
+     */
+    private static Names names(Game game) {
+        Map<String, Player> out = new java.util.HashMap<>();
+        for (Player p : game.getPlayers().values()) {
+            String shown = displayName(p);
+            if (shown == null || shown.isBlank()) continue;
+            out.putIfAbsent(shown.toLowerCase().replaceAll("\\s+", ""), p);
+            try {
+                net.dv8tion.jda.api.entities.User u = p.getUser();
+                if (u != null) out.put(u.getName(), p);
+            } catch (Exception ignored) {
+                // no JDA user: the normalised name above still applies
+            }
+        }
+        return new Names(game, out);
+    }
+
+    /**
+     * Names the player who made a save by display name, with their user id. A hidden press ("someone pressed button:
+     * [CLASSIFIED]", e.g. anything in a hand thread) is attributed through the save's saved_buttons, which start with
+     * the presser's faction, so a player can still find their own last action.
+     */
+    private static UndoPoint humanize(UndoPoint p, Names names) {
+        if (p == null || names == null || p.command().startsWith(REWIND_MARK)) return p;
+        Player who = null;
+        String actor = p.actor() == null ? "" : p.actor();
+        if (!actor.isBlank() && !"someone".equals(actor)) {
+            who = names.byName().get(actor);
+            if (who == null) who = names.byName().get(actor.toLowerCase().replaceAll("\\s+", ""));
+        }
+        if (who == null && p.actorFaction() != null && !p.actorFaction().isBlank() && !"-".equals(p.actorFaction())) {
+            Player byFaction = names.game().getPlayerFromColorOrFaction(p.actorFaction());
+            // saved_buttons can belong to another player's prompt only when the actor is unknown; trust it then
+            if (byFaction != null && (actor.isBlank() || "someone".equals(actor))) who = byFaction;
+        }
+        if (who == null) return p;
+        String shown = displayName(who);
+        String label = p.label();
+        if ("someone".equals(actor) && label.startsWith("someone took a hidden action"))
+            label = shown + " made a private choice";
+        else if (!actor.isBlank() && label.startsWith(actor + " ")) label = shown + label.substring(actor.length());
+        return new UndoPoint(p.index(), p.savedAt(), p.fileTime(), p.command(), shown, label, p.round(), p.phase(),
+                p.current(), p.actorFaction(), who.getUserID());
+    }
+
+    private static String displayName(Player p) {
+        String n = p.getUserName();
+        return n == null || n.isBlank() ? p.getColor() : n;
+    }
+
+    private UndoPoint readPoint(String gameName, int index, boolean current) {
+        Path path = Storage.getGameUndo(gameName, gameName + "_" + index + Constants.TXT);
+        File f = path.toFile();
+        if (!f.exists()) return null;
+        String key = path.toString();
+        CachedPoint hit = cache.get(key);
+        if (hit != null && hit.fileTime() == f.lastModified() && hit.size() == f.length()) {
+            UndoPoint p = hit.point();
+            return p.current() == current ? p : withCurrent(p, current);
+        }
+        String command = "";
+        long savedAt = 0;
+        int round = 0;
+        String phase = "";
+        String actorFaction = "";
+        try (BufferedReader r = Files.newBufferedReader(path, StandardCharsets.UTF_8)) {
+            String line;
+            int found = 0;
+            while ((line = r.readLine()) != null && found < 5) {
+                if (line.startsWith("saved_buttons ") && actorFaction.isEmpty()) {
+                    String first = line.substring("saved_buttons ".length()).split(";", 2)[0].trim();
+                    actorFaction = "null".equals(first) ? "-" : first.isEmpty() ? "-" : first;
+                    found++;
+                    continue;
+                }
+                if (line.startsWith("latest_command ") && command.isEmpty()) {
+                    command = line.substring("latest_command ".length());
+                    found++;
+                } else if (line.startsWith("last_modified_date ") && savedAt == 0) {
+                    savedAt = parseLong(line.substring("last_modified_date ".length()));
+                    found++;
+                } else if (line.startsWith("round ") && round == 0) {
+                    round = (int) parseLong(line.substring("round ".length()));
+                    found++;
+                } else if (line.startsWith("phase_of_game ") && phase.isEmpty()) {
+                    phase = line.substring("phase_of_game ".length()).trim();
+                    found++;
+                }
+            }
+        } catch (Exception e) {
+            BotLogger.error("Could not read undo file " + path, e);
+            return null;
+        }
+        if (savedAt == 0) savedAt = f.lastModified();
+        String[] label = describe(command);
+        UndoPoint p = new UndoPoint(
+                index, savedAt, f.lastModified(), command, label[0], label[1], round, phase, current, actorFaction, null);
+        cache.put(key, new CachedPoint(f.lastModified(), f.length(), p));
+        if (cache.size() > 5000) cache.clear();
+        return p;
+    }
+
+    private static UndoPoint withCurrent(UndoPoint p, boolean current) {
+        return new UndoPoint(p.index(), p.savedAt(), p.fileTime(), p.command(), p.actor(), p.label(), p.round(),
+                p.phase(), current, p.actorFaction(), p.actorUserId());
+    }
+
+    private static long parseLong(String s) {
+        try {
+            return Long.parseLong(s.trim());
+        } catch (NumberFormatException e) {
+            return 0;
+        }
+    }
+
+    private static final Pattern PRESSED = Pattern.compile("^(.+?) pressed button: (.*?)(?: \\(([^()]*)\\))?$");
+    private static final Pattern USED = Pattern.compile("^(.+?) used: /?(.*)$");
+    private static final Pattern USED_KIND = Pattern.compile("^(.+?) used (string selection|modal): (.*)$");
+    private static final Pattern CALLED = Pattern.compile("^(.+?) called /api/game/[^/]+/(.*)$");
+
+    /** {actor, readable label} for a {@code latest_command}. */
+    static String[] describe(String command) {
+        if (command == null || command.isBlank()) return new String[] {"", "Unknown action"};
+        if (command.startsWith(REWIND_MARK)) return new String[] {"", command};
+        Matcher m = PRESSED.matcher(command);
+        if (m.matches()) {
+            String what = m.group(2).trim().replaceAll("\\s*\\[[^\\]]*\\]$", "");
+            if (m.group(2).trim().equals("[CLASSIFIED]")) return new String[] {m.group(1), m.group(1) + " took a hidden action"};
+            return new String[] {m.group(1), m.group(1) + " pressed “" + what + "”"};
+        }
+        m = USED_KIND.matcher(command);
+        if (m.matches()) {
+            String verb = m.group(2).equals("modal") ? " filled in a form" : " chose an option";
+            return new String[] {m.group(1), m.group(1) + verb};
+        }
+        m = USED.matcher(command);
+        if (m.matches()) return new String[] {m.group(1), m.group(1) + " used /" + m.group(2)};
+        m = CALLED.matcher(command);
+        if (m.matches()) {
+            String path = m.group(2);
+            String what = path.startsWith("trade/") ? "proposed a trade" : "used the web (" + path + ")";
+            return new String[] {m.group(1), m.group(1) + " " + what};
+        }
+        return new String[] {"", command};
+    }
+}
