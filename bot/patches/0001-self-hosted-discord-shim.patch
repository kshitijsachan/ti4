diff --git a/src/main/java/ti4/selfhost/engine/kinds/RelicFragmentsKind.java b/src/main/java/ti4/selfhost/engine/kinds/RelicFragmentsKind.java
new file mode 100644
index 0000000..05cde67
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/RelicFragmentsKind.java
@@ -0,0 +1,116 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+import java.util.concurrent.ConcurrentHashMap;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.image.Mapper;
+import ti4.model.ExploreModel;
+import ti4.selfhost.engine.EngineModels.Progress;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * Purge relic fragments (and then draw a relic). One message, several presses (ComponentActionHelper "getRelic",
+ * Fabrication, Lanefir mech, promissory notes, secret objectives):
+ *
+ * <pre>
+ * purge_Frags_{CRF,IRF,HRF,URF}_n     {action:"purge", trait, count:n, fragmentsAtStart, setSize}
+ * purgeSupermassiveFrag_&lt;id&gt;          {action:"purge", trait, count:1, fragment:id, supermassive:true, ...}
+ * drawRelicFromFrag                   {action:"draw", fragmentsAtStart, setSize, explore (A New Edifice explores instead)}
+ * </pre>
+ *
+ * The message stays up between presses (a purge button only disappears once that trait is used up), so the decision
+ * is dynamic and carries progress: {flow:"relic_fragments", step:"purge", accumulated:{purged, byTrait}, required:
+ * {setSize}, canCommit: purged at least setSize}, recomputed after every save from the player's fragments versus the
+ * counts when this menu was first seen ({@code fragmentsAtStart} on each option). setSize = fragments needed for a
+ * relic (3, minus Age of Exploration / Fabrication / Black Market Forgery); frontier fragments are wild.
+ */
+public class RelicFragmentsKind implements KindSpec {
+
+    /** messageId → counts at first capture (edits keep the first). Bounded; menus are short-lived. */
+    private static final Map<String, Map<String, Object>> BASELINE = new ConcurrentHashMap<>();
+
+    @Override
+    public String kind() {
+        return "relic.fragments";
+    }
+
+    @Override
+    public int priority() {
+        return 100;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return handlerId.matches("purge_Frags_(CRF|IRF|HRF|URF)_\\d+")
+                || handlerId.startsWith("purgeSupermassiveFrag_")
+                || handlerId.equals("drawRelicFromFrag");
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        if (!matches(handlerId)) return null;
+        Player p = ctx.player();
+        Map<String, Object> v = new LinkedHashMap<>();
+        if (handlerId.equals("drawRelicFromFrag")) {
+            v.put("action", "draw");
+            v.put("explore", p != null && p.hasAbility("a_new_edifice"));
+        } else if (handlerId.startsWith("purgeSupermassiveFrag_")) {
+            String id = handlerId.substring("purgeSupermassiveFrag_".length());
+            ExploreModel m = Mapper.getExplore(id);
+            v.put("action", "purge");
+            v.put("trait", m == null || m.getType() == null ? null : m.getType().toLowerCase());
+            v.put("count", 1);
+            v.put("fragment", id);
+            v.put("supermassive", true);
+        } else {
+            String[] parts = handlerId.split("_");
+            v.put("action", "purge");
+            v.put("trait", ExploreSupport.fragTrait(parts[2]));
+            v.put("count", Integer.parseInt(parts[3]));
+            v.put("supermassive", false);
+        }
+        v.put("fragmentsAtStart", baseline(ctx.messageId(), p));
+        v.put("setSize", setSize(ctx.game(), p));
+        return v;
+    }
+
+    private static Map<String, Object> baseline(String messageId, Player p) {
+        if (messageId == null) return ExploreSupport.fragmentCounts(p);
+        if (BASELINE.size() > 500) BASELINE.clear();
+        return BASELINE.computeIfAbsent(messageId, k -> ExploreSupport.fragmentCounts(p));
+    }
+
+    @Override
+    public boolean dynamic() {
+        return true;
+    }
+
+    @Override
+    public Progress progress(CaptureContext ctx) {
+        Player p = ctx.player();
+        if (p == null) return null;
+        Map<String, Object> start = baseline(ctx.messageId(), p);
+        Map<String, Object> now = ExploreSupport.fragmentCounts(p);
+        Map<String, Object> byTrait = new LinkedHashMap<>();
+        int purged = 0;
+        for (Map.Entry<String, Object> e : start.entrySet()) {
+            int d = Math.max(0, (Integer) e.getValue() - (Integer) now.getOrDefault(e.getKey(), 0));
+            byTrait.put(e.getKey(), d);
+            purged += d;
+        }
+        int size = setSize(ctx.game(), p);
+        Map<String, Object> acc = new LinkedHashMap<>();
+        acc.put("purged", purged);
+        acc.put("byTrait", byTrait);
+        return new Progress("relic_fragments", "purge", acc, Map.of("setSize", size), purged >= size);
+    }
+
+    static int setSize(Game game, Player p) {
+        int n = 3;
+        if (game.isAgeOfExplorationMode()) n--;
+        if (p != null && (p.hasAbility("fabrication") || p.getPromissoryNotes().containsKey("bmf"))) n--;
+        return n;
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/RelicUseKind.java b/src/main/java/ti4/selfhost/engine/kinds/RelicUseKind.java
new file mode 100644
index 0000000..19fbb48
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/RelicUseKind.java
@@ -0,0 +1,203 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+import ti4.game.Player;
+import javax.annotation.Nullable;
+import ti4.selfhost.engine.EngineModels.Target;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * Using a relic outside the component-action menu (RelicButtonHandler, ButtonHelperRelics, ...). value
+ * {relic, relicName, relicText, effect}:
+ *
+ * <pre>
+ * exhaustRelic_&lt;relic&gt;            {effect:"exhaust"}        (Heart of Ixth, Luxarch Treatise, ...)
+ * useRelic_&lt;relic&gt;                {effect:"use"}            (Boon of the Cerulean God, ...)
+ * prophetsTears_AC / _TechSkip    {relic:"prophetstears", effect:"draw_action_card" | "tech_skip"}
+ * explore_look_All                {relic:"scepterofdominion"?, effect:"look_explore_decks"}  (peek, no relic id)
+ * relic_look_top                  {effect:"look_relic_deck"}
+ * dominusOrb                      {relic:"dominusorb", effect:"move_from_command_token_systems"}
+ * eyeOfVogul                      {relic:"eyeofvogul", effect:"use"}
+ * resolveMaw                      {relic:"mawofworlds", effect:"purge_for_technology"}  (exhausts all your planets)
+ * resolveCrownOfE                 {relic:"emphidia", effect:"purge_for_point"}
+ * </pre>
+ *
+ * Temporal Command Suite (exhaustTCS_&lt;agent&gt;_&lt;faction&gt;) is the Nomad faction tech: faction.ability (FactionStepsNomad).
+ *
+ * Declines on the same message ("deleteButtons", "No") have value null.
+ */
+public class RelicUseKind implements KindSpec {
+
+    @Override
+    public String kind() {
+        return "relic.use";
+    }
+
+    @Override
+    public int priority() {
+        return 45;
+    }
+
+    @Override
+    public boolean matches(String h) {
+        return h.startsWith("exhaustRelic_")
+                || h.startsWith("useRelic_")
+                || h.startsWith("prophetsTears_")
+                || h.equals("explore_look_All")
+                || h.equals("relic_look_top")
+                || h.equals("dominusOrb")
+                || h.equals("eyeOfVogul")
+                || h.equals("resolveMaw")
+                || h.equals("resolveCrownOfE");
+    }
+
+    /** Only relic messages (plus dismiss/decline/undo): mixed "optional abilities" menus stay with their area. */
+    @Override
+    public boolean classifies(java.util.List<String> handlerIds) {
+        return ChooseSupport.onlyOurs(handlerIds, this::matches);
+    }
+
+    @Override
+    public Map<String, Object> value(String h, CaptureContext ctx) {
+        Map<String, Object> v = new LinkedHashMap<>();
+        if (h.startsWith("exhaustRelic_")) {
+            v.putAll(ExploreSupport.relic(h.substring("exhaustRelic_".length())));
+            v.put("effect", "exhaust");
+        } else if (h.startsWith("useRelic_")) {
+            v.putAll(ExploreSupport.relic(h.substring("useRelic_".length())));
+            v.put("effect", "use");
+        } else if (h.startsWith("prophetsTears_")) {
+            v.putAll(ExploreSupport.relic("prophetstears"));
+            v.put("effect", h.contains("AC") ? "draw_action_card" : "tech_skip");
+        } else if (h.equals("explore_look_All")) {
+            v.put("relic", null);
+            v.put("effect", "look_explore_decks");
+        } else if (h.equals("relic_look_top")) {
+            v.put("relic", null);
+            v.put("effect", "look_relic_deck");
+        } else if (h.equals("dominusOrb")) {
+            v.putAll(ExploreSupport.relic("dominusorb"));
+            v.put("effect", "move_from_command_token_systems");
+        } else if (h.equals("eyeOfVogul")) {
+            v.putAll(ExploreSupport.relic("eyeofvogul"));
+            v.put("effect", "use");
+        } else if (h.equals("resolveMaw")) {
+            v.putAll(ExploreSupport.relic("mawofworlds"));
+            v.put("effect", "purge_for_technology");
+        } else if (h.equals("resolveCrownOfE")) {
+            v.putAll(ExploreSupport.relic("emphidia"));
+            v.put("effect", "purge_for_point");
+        } else {
+            return null;
+        }
+        if (costed(h)) v.put("unavailable", unavailable(ctx.game(), Affordability.player(ctx), h));
+        return v;
+    }
+
+    /** Uses that need the relic held (purge) or held and ready (exhaust). Rules audit. */
+    static boolean costed(String h) {
+        return h.startsWith("exhaustRelic_")
+                || h.startsWith("prophetsTears_")
+                || h.equals("dominusOrb")
+                || h.equals("resolveMaw")
+                || h.equals("resolveCrownOfE");
+    }
+
+    /**
+     * Why this relic use cannot be made now (null = it can): an exhaust needs the relic ready, a purge needs it held;
+     * The Crown of Emphidia's point also needs the Tomb of Emphidia under your control. The handlers refuse the same
+     * (deliberate improvement: the original resolved any press, also stale / repeated ones).
+     */
+    @Nullable
+    static String unavailable(ti4.game.Game game, @Nullable Player p, String h) {
+        if (game == null || p == null || !costed(h)) return null;
+        String relic = relicOf(h);
+        if (relic == null) return null;
+        String name = relicName(relic);
+        if ("resolveCrownOfE".equals(h)) {
+            if (!p.hasRelic("emphidia") && !p.hasRelic("absol_emphidia")) return "You do not have " + name;
+            if (!Affordability.controlsTombOfEmphidia(game, p))
+                return "You must control the Tomb of Emphidia";
+            return null;
+        }
+        if (!p.hasRelic(relic)) return "You do not have " + name;
+        boolean exhaust = h.startsWith("exhaustRelic_") || h.startsWith("prophetsTears_");
+        if (exhaust && !p.hasRelicReady(relic)) return name + " is exhausted";
+        return null;
+    }
+
+    private static String relicName(String relic) {
+        try {
+            ti4.model.RelicModel m = ti4.image.Mapper.getRelic(relic);
+            return m == null ? relic : m.getName();
+        } catch (Exception e) {
+            return relic;
+        }
+    }
+
+    @Override
+    public boolean dynamicValues() {
+        return true;
+    }
+
+    @Override
+    public String validate(
+            ti4.game.Game game,
+            Player answering,
+            ti4.selfhost.engine.EngineModels.Decision decision,
+            String optionId) {
+        for (ti4.selfhost.engine.EngineModels.Option o : decision.options()) {
+            if (!o.id().equals(optionId) || o.handler() == null || !costed(o.handler())) continue;
+            return unavailable(game, answering, o.handler());
+        }
+        return null;
+    }
+
+    @Override
+    public Target target(CaptureContext ctx, Target resolved) {
+        if (resolved != null && resolved.userId() != null && !"none".equals(resolved.resolvedBy())
+                && !"mixed_owners".equals(resolved.resolvedBy())) {
+            // owner prefix / mention / cards thread etc.: as resolved (explorer() keeps those too)
+            Target t = ExploreSupport.explorer(ctx, resolved);
+            if (t != null && !"recent_press".equals(t.resolvedBy()) && !"active_player".equals(t.resolvedBy()))
+                return t;
+        }
+        // Unowned relic buttons (prophetsTears_, resolveMaw, dominusOrb, exhaustRelic_x, ...): the relic's holder is
+        // the one who may use it -- not whoever last pressed or typed in the channel.
+        Player holder = holder(ctx);
+        if (holder != null) return ExploreSupport.target(holder, "relic_holder");
+        return ExploreSupport.explorer(ctx, resolved);
+    }
+
+    @Nullable
+    private static Player holder(CaptureContext ctx) {
+        if (ctx.handlerIds() == null || ctx.game() == null) return null;
+        for (String h : ctx.handlerIds()) {
+            String relic = relicOf(h);
+            if (relic == null) continue;
+            Player found = null;
+            for (Player p : ctx.game().getRealPlayers()) {
+                if (p.getRelics().contains(relic)) {
+                    if (found != null) return null; // ambiguous
+                    found = p;
+                }
+            }
+            if (found != null) return found;
+        }
+        return null;
+    }
+
+    @Nullable
+    static String relicOf(String h) {
+        if (h == null) return null;
+        if (h.startsWith("exhaustRelic_")) return h.substring("exhaustRelic_".length());
+        if (h.startsWith("useRelic_")) return h.substring("useRelic_".length());
+        if (h.startsWith("prophetsTears_")) return "prophetstears";
+        if (h.equals("dominusOrb")) return "dominusorb";
+        if (h.equals("eyeOfVogul")) return "eyeofvogul";
+        if (h.equals("resolveMaw")) return "mawofworlds";
+        if (h.equals("resolveCrownOfE")) return "emphidia";
+        return null;
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/RevealObjectivesKind.java b/src/main/java/ti4/selfhost/engine/kinds/RevealObjectivesKind.java
