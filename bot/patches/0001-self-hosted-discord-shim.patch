+package ti4.selfhost.engine.kinds;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+import java.util.Set;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * Every remaining follow-up step of an action card's resolution (C7): base/PoK/Codex steps in
+ * ButtonHelperActionCards (scuttle / lucky shot / counterstroke / reverse engineer / twinning / repeal law ...),
+ * Thunder's Edge (TeHelperActionCards), Twilight's Fall, and the homebrew decks (Acd2 / LL / Tk / Theodisi /
+ * Monuments). The listed ids are the handler prefixes (ids ending in '_' carry parameters; the others are exact or
+ * followed by '_' / '@' parameters). Steps that pick a player / planet / system with the G8 grammar stay
+ * action_card.target; the first "Resolve X" button stays action_card.resolve.
+ *
+ * <p>Value: {step, actionCard, role, player?, players?, planet?, system?, holder?, unit?, damaged?, tech?,
+ * actionCardRef?, promissoryNote?, count?, args?}. step = handler prefix without the trailing '_'; actionCard = the
+ * card being resolved (CardSteps.cardFor); role = "done" for finish/done/cancel/decline steps, else "choose"; the
+ * other fields are the typed id tokens (CardSteps.typeTokens), args = the remaining raw id tokens.
+ */
+public class ActionCardStepKind implements KindSpec {
+
+    static final Set<String> STEPS = Set.of(
+            "abductionTake_", "allianceRiderGainAlly", "allianceRiderPurgeAlly", "amendmentChooseObjective_",
+            "amendmentRevealStage1", "amendmentRevealStage2", "ancientTradeRoutesStep2_",
+            "arbitrationInfantry_", "arbitrationOwner_", "arbitrationPlace_", "arcExp_", "armsDealStep2_",
+            "artifactHuntersPurge_", "artifactHuntersRelic", "artifactResearchDiscard_", "beginTkConscript",
