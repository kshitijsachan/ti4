@@ -0,0 +1,68 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.game.Tile;
+import ti4.helpers.Helper;
+import ti4.selfhost.engine.KindSpec;
+import ti4.selfhost.engine.tactical.TacticalFacts;
+
+/**
+ * After movement / landing: produce in the active system, roll for gravity rifts, or conclude the tactical action
+ * (TacticalActionService.getBuildButtons). tacticalActionBuild_&lt;pos&gt; → {action:"produce", position, production};
+ * getRiftButtons_&lt;pos&gt; → {action:"rift", position}; doneWithTacticalAction → {action:"conclude", position,
+ * frontierExplore} where frontierExplore says concluding will explore the system's frontier token (Dark Energy Tap,
+ * ButtonHelper.exploreDET). Priority 90: production-area kinds may claim a message that is mostly about building.
+ */
+public class TacticalConcludeKind implements KindSpec {
+
+    @Override
+    public String kind() {
+        return "tactical.conclude";
+    }
+
+    @Override
+    public int priority() {
+        return 90;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return handlerId.equals("doneWithTacticalAction")
+                || handlerId.startsWith("tacticalActionBuild_")
+                || handlerId.startsWith("getRiftButtons_");
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        Map<String, Object> v = new LinkedHashMap<>();
+        Game game = ctx.game();
+        Player player = ctx.player();
+        if (handlerId.startsWith("tacticalActionBuild_")) {
+            String pos = handlerId.substring("tacticalActionBuild_".length());
+            v.put("action", "produce");
+            v.put("position", pos);
+            Tile tile = game.getTileByPosition(pos);
+            int production = 0;
+            try {
+                if (tile != null && player != null) production = Helper.getProductionValue(player, game, tile, false);
+            } catch (Exception ignored) {
+                // leave 0
+            }
+            v.put("production", production);
+            return v;
+        }
+        if (handlerId.startsWith("getRiftButtons_")) {
+            v.put("action", "rift");
+            v.put("position", handlerId.substring("getRiftButtons_".length()));
+            return v;
+        }
+        String pos = game.getActiveSystem();
+        v.put("action", "conclude");
+        v.put("position", pos);
+        v.put("frontierExplore", TacticalFacts.frontierExplore(game, player, pos == null ? null : game.getTileByPosition(pos)));
+        return v;
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/TacticalLandKind.java b/src/main/java/ti4/selfhost/engine/kinds/TacticalLandKind.java
new file mode 100644
index 0000000..494a82e
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/TacticalLandKind.java
@@ -0,0 +1,104 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+import ti4.game.Planet;
+import ti4.game.Player;
+import ti4.game.Tile;
+import ti4.game.UnitHolder;
+import ti4.helpers.Units.UnitType;
+import ti4.selfhost.engine.EngineModels.Progress;
+import ti4.selfhost.engine.KindSpec;
+import ti4.selfhost.engine.tactical.TacticalFacts;
+
+/**
+ * Landing ground forces after movement (TacticalActionService.getLandingTroopsButtons, edited in place per press):
+ * landUnits_&lt;pos&gt;_&lt;n&gt;&lt;unit&gt;[damaged]_&lt;planet&gt;_&lt;color&gt; → {op:"land", position, planet, unit,
+ * count, damaged, color, owner}; spaceUnits_… → {op:"unland", …}; doneLanding[_&lt;pos&gt;] → {op:"done", position}.
+ * The direct action {@code POST …/decisions/{id}/land} lands a whole plan (and finishes) in one call.
+ */
+public class TacticalLandKind implements KindSpec {
+    private static final Pattern UNIT =
+            Pattern.compile("^(landUnits|spaceUnits)_([^_]+)_(\\d+)([a-z]{2,3}?)(damaged)?_(.+)_([^_]+)$");
+
+    @Override
+    public String kind() {
+        return "tactical.land";
+    }
+
+    @Override
+    public int priority() {
+        return 100;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return handlerId.startsWith("landUnits_")
+                || handlerId.startsWith("spaceUnits_")
+                || handlerId.equals("doneLanding")
+                || handlerId.startsWith("doneLanding_");
+    }
+
+    @Override
+    public boolean dynamic() {
+        return true;
+    }
+
+    /**
+     * The player's ground forces in the active system: still in space (could land) and on each planet, from the
+     * board after every save.
+     */
+    @Override
+    public Progress progress(CaptureContext ctx) {
+        Player p = ctx.player();
+        String pos = ctx.game().getActiveSystem();
+        Tile tile = pos == null ? null : ctx.game().getTileByPosition(pos);
+        if (p == null || tile == null) return null;
+        List<Map<String, Object>> inSpace = new ArrayList<>();
+        List<Map<String, Object>> onPlanets = new ArrayList<>();
+        for (UnitHolder uh : tile.getUnitHolders().values()) {
+            boolean space = !(uh instanceof Planet);
+            for (UnitType t : List.of(UnitType.Infantry, UnitType.Mech)) {
+                int n = uh.getUnitCount(t, p);
+                if (n < 1) continue;
+                Map<String, Object> m = new LinkedHashMap<>();
+                if (!space) m.put("planet", uh.getName());
+                m.put("unit", t.getValue());
+                m.put("count", n);
+                (space ? inSpace : onPlanets).add(m);
+            }
+        }
+        Map<String, Object> acc = new LinkedHashMap<>();
+        acc.put("position", pos);
+        acc.put("inSpace", inSpace);
+        acc.put("onPlanets", onPlanets);
+        return new Progress(TacticalFacts.flow(ctx.game(), ctx.player()), "select_planets", acc, Map.of(), true);
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        Map<String, Object> v = new LinkedHashMap<>();
+        if (handlerId.startsWith("doneLanding")) {
+            v.put("op", "done");
+            String pos = handlerId.startsWith("doneLanding_") ? handlerId.substring("doneLanding_".length()) : null;
+            v.put("position", pos != null ? pos : ctx.game().getActiveSystem());
+            return v;
+        }
+        Matcher m = UNIT.matcher(handlerId);
+        if (!m.matches()) return null;
+        v.put("op", "landUnits".equals(m.group(1)) ? "land" : "unland");
+        v.put("position", m.group(2));
+        v.put("planet", m.group(6));
+        v.put("unit", m.group(4));
+        v.put("count", Integer.parseInt(m.group(3)));
+        v.put("damaged", m.group(5) != null);
+        v.put("color", m.group(7));
+        Player owner = ctx.game().getPlayerFromColorOrFaction(m.group(7));
+        v.put("owner", owner == null ? null : owner.getFaction());
+        return v;
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/TacticalMoveKind.java b/src/main/java/ti4/selfhost/engine/kinds/TacticalMoveKind.java
new file mode 100644
index 0000000..9895afe
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/TacticalMoveKind.java
@@ -0,0 +1,130 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.game.Tile;
+import ti4.selfhost.engine.EngineModels.Progress;
+import ti4.selfhost.engine.KindSpec;
+import ti4.selfhost.engine.tactical.TacticalFacts;
+
+/**
+ * Movement of a tactical action: the "Tactical Action in system X" prompt (TacticalActionOutputService) and its
+ * per-system sub-step (same message, edited in place).
+ *
+ * <p>Option values:
+ * <ul>
+ *   <li>concludeMove_&lt;pos&gt; → {action:"done", position, origins, bonuses} (staged units: progress.accumulated)
+ *   — every system the player could move from (distance, rift-aware distance, movable units
+ *   with move/capacity), and the movement bonuses in play. A client moves units in one step with the direct action
+ *   {@code POST …/decisions/{id}/move} (see TacticalController) instead of walking the per-unit buttons.</li>
+ *   <li>tacticalMoveFrom_&lt;pos&gt; → {action:"from", position}; doneWithOneSystem_ → {action:"back"};
+ *   moveFromTilePage_page&lt;n&gt; → {action:"page", page}</li>
+ *   <li>unitTacticalMove_… → {action:"unit", position, count, unit, reverse} or {action:"all", position, op}</li>
+ *   <li>ChooseDifferentDestination → {action:"change_destination"}; resetTacticalMovement → {action:"reset"}</li>
+ * </ul>
+ */
+public class TacticalMoveKind implements KindSpec {
+    private static final Pattern UNIT =
+            Pattern.compile("^unitTactical(Move|Remove)_([^_]+)_(\\d+)_([a-z]+)(?:_.*)?$");
+    private static final Pattern ALL =
+            Pattern.compile("^unitTactical(Move|Remove)_([^_]+)_(moveAll|reverseAll|removeAllShips|removeAll)$");
+
+    @Override
+    public String kind() {
+        return "tactical.move";
+    }
+
+    @Override
+    public int priority() {
+        return 100;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return handlerId.startsWith("tacticalMoveFrom_")
+                || handlerId.startsWith("concludeMove_")
+                || handlerId.startsWith("unitTacticalMove_")
+                || handlerId.startsWith("doneWithOneSystem_")
+                || handlerId.startsWith("moveFromTilePage_page")
+                || handlerId.equals("ChooseDifferentDestination")
+                || handlerId.equals("resetTacticalMovement");
+    }
+
+    @Override
+    public boolean dynamic() {
+        return true;
+    }
+
+    /** Movement staged so far (Game.tacticalActionDisplacement), recomputed after every save. */
+    @Override
+    public Progress progress(CaptureContext ctx) {
+        Map<String, Object> acc = new LinkedHashMap<>();
+        acc.put("position", ctx.game().getActiveSystem());
+        acc.put("staged", TacticalFacts.staged(ctx.game()));
+        return new Progress(TacticalFacts.flow(ctx.game(), ctx.player()), "select_units", acc, Map.of(), true);
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        Map<String, Object> v = new LinkedHashMap<>();
+        Game game = ctx.game();
+        if (handlerId.startsWith("concludeMove_")) {
+            String pos = handlerId.substring("concludeMove_".length());
+            v.put("action", "done");
+            v.put("position", pos);
+            Tile tile = game.getTileByPosition(pos);
+            v.put("tileId", tile == null ? null : tile.getTileID());
+            Player p = ctx.player();
+            if (p != null) {
+                v.put("origins", TacticalFacts.origins(game, p));
+                v.put("bonuses", TacticalFacts.bonuses(game, p));
+            }
+            return v;
+        }
+        if (handlerId.startsWith("tacticalMoveFrom_")) {
+            v.put("action", "from");
+            v.put("position", handlerId.substring("tacticalMoveFrom_".length()));
+            return v;
+        }
+        if (handlerId.startsWith("doneWithOneSystem_")) {
+            v.put("action", "back");
+            return v;
+        }
+        if (handlerId.startsWith("moveFromTilePage_page")) {
+            v.put("action", "page");
+            try {
+                v.put("page", Integer.parseInt(handlerId.substring("moveFromTilePage_page".length())));
+            } catch (NumberFormatException e) {
+                return null;
+            }
+            return v;
+        }
+        if (handlerId.equals("ChooseDifferentDestination")) {
+            v.put("action", "change_destination");
+            return v;
+        }
+        if (handlerId.equals("resetTacticalMovement")) {
+            v.put("action", "reset");
+            return v;
+        }
+        Matcher all = ALL.matcher(handlerId);
+        if (all.matches()) {
+            v.put("action", "all");
+            v.put("position", all.group(2));
+            v.put("op", all.group(3));
+            return v;
+        }
+        Matcher m = UNIT.matcher(handlerId);
+        if (!m.matches()) return null;
+        v.put("action", "unit");
+        v.put("position", m.group(2));
+        v.put("count", Integer.parseInt(m.group(3)));
+        v.put("unit", m.group(4));
+        v.put("reverse", handlerId.endsWith("_reverse"));
+        return v;
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/TacticalRiftKind.java b/src/main/java/ti4/selfhost/engine/kinds/TacticalRiftKind.java
