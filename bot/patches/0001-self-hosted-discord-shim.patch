+    private static final Set<String> UNITS = Set.of(
+            "gf", "infantry", "mf", "mech", "ff", "fighter", "dd", "destroyer", "ca", "cruiser", "cv", "carrier",
+            "dn", "dreadnought", "fs", "flagship", "ws", "warsun", "pd", "pds", "sd", "spacedock");
+
+    /** The RESOLVE_AUTOMATION key a resolve handler id is (exact, or a '_' prefix), or null. */
+    @Nullable
+    static String resolveKey(String handlerId) {
+        if (RESOLVE_AUTOMATION.containsKey(handlerId)) return handlerId;
+        for (String k : RESOLVE_AUTOMATION.keySet()) {
+            if (k.endsWith("_") && handlerId.startsWith(k)) return k;
+        }
+        return null;
+    }
+
+    static String family(String step) {
+        String f = step.replaceAll("_+$", "");
+        f = f.replaceAll("^(resolve|start|begin|getTo|get)", "");
+        f = f.replaceAll("(?i)(step\\d+|buttons|part\\d+)$", "");
+        f = f.replaceAll("(?i)step\\d+", "");
+        return f.toLowerCase(Locale.ROOT);
+    }
+
+    /** Automation ids of the card a step (first or follow-up) belongs to; empty when unknown. */
+    static List<String> automationFor(String step) {
+        String key = resolveKey(step);
+        if (key != null) return RESOLVE_AUTOMATION.get(key);
+        String fam = family(step);
+        if (fam.length() < 4) return List.of();
+        String best = null;
+        for (String k : RESOLVE_AUTOMATION.keySet()) {
+            String kf = family(k);
+            if (kf.length() < 4) continue;
+            if (fam.startsWith(kf) || kf.startsWith(fam)) {
+                if (best == null || kf.length() > family(best).length()) best = k;
+            }
+        }
+        return best == null ? List.of() : RESOLVE_AUTOMATION.get(best);
+    }
+
+    /** Steps of cards without an automationID (Thunder's Edge) or outside playAC: step -> card alias prefix. */
+    static final Map<String, String> STEP_CARDS = Map.ofEntries(
+            Map.entry("courageousFire", "courageous"),
+            Map.entry("endScuttle", "scuttle"),
+            Map.entry("scuttleIn", "scuttle"),
+            Map.entry("scuttleOn", "scuttle"),
+            Map.entry("luckyShotIn", "lucky"),
+            Map.entry("luckyShotOn", "lucky"),
+            Map.entry("resolveCounterStroke", "counterstroke"),
+            Map.entry("arcExp", "arch_expedition"),
+            Map.entry("resolveReverse", "reverse_engineer"),
+            Map.entry("lieInWait", "lieinwait"),
+            Map.entry("exchangeProgramStart", "exchangeprogram"),
+            Map.entry("exchangeProgramPart2", "exchangeprogram"),
+            Map.entry("exchangeProgramPart3", "exchangeprogram"),
+            Map.entry("extremeDuressStart", "extremeduress"),
+            Map.entry("extremeDuressTarget", "extremeduress"),
+            Map.entry("concedeToED", "extremeduress"),
+            Map.entry("teMercenaryContract", "mercenarycontract"),
+            Map.entry("resolveTeMercenaryContract", "mercenarycontract"),
+            Map.entry("strategize", "strategize"),
+            Map.entry("startRescue", "rescue"),
+            Map.entry("rescuePart2", "rescue"),
+            Map.entry("pirateFleet", "piratefleet"),
+            Map.entry("resolvePirateFleet", "piratefleet"),
+            Map.entry("brilliance", "brilliance"),
+            Map.entry("resolveBrillianceUnlock", "brilliance"),
+            Map.entry("pirateContract", "piratecontract"),
+            Map.entry("resolvePirateContract", "piratecontract"),
+            Map.entry("crashLandingStart", "crashlanding"),
+            Map.entry("crashLandOn", "crashlanding"),
+            Map.entry("crisisSabotaged", "crisis"),
+            Map.entry("overruleStart", "overrule"));
+
+    /** The action card id a step belongs to in this game, or null. */
+    @Nullable
+    static String cardFor(Game game, String step) {
+        List<String> autos = automationFor(step);
+        List<String> discard = new ArrayList<>(game.getDiscardActionCards().keySet());
+        String prefix = STEP_CARDS.get(step);
+        if (prefix != null) {
+            for (int i = discard.size() - 1; i >= 0; i--) {
+                if (discard.get(i).startsWith(prefix)) return discard.get(i);
+            }
+            if (Mapper.isValidActionCard(prefix)) return prefix;
+            for (String id : Mapper.getActionCards().keySet()) {
+                if (id.startsWith(prefix)) return id;
+            }
+            return prefix;
+        }
+        if (!autos.isEmpty()) {
+            for (int i = discard.size() - 1; i >= 0; i--) {
+                ActionCardModel m = Mapper.getActionCard(discard.get(i));
+                if (m != null && autos.contains(m.getAutomationID())) return discard.get(i);
+            }
+            for (ActionCardModel m : Mapper.getActionCards().values()) {
+                if (autos.contains(m.getAutomationID())) return m.getAlias();
+            }
+        }
+        return discard.isEmpty() ? null : discard.getLast();
+    }
+
+    /**
+     * Types the '_'-separated tokens after a step prefix: player (faction), planet, system (tile position), holder
+     * ("space"), unit, tech, actionCard, promissoryNote, count (first integer). Anything else is kept in args (still
+     * id tokens from the custom id, never labels).
+     */
+    private static final java.util.regex.Pattern PLANET_STEP =
+            java.util.regex.Pattern.compile("(?i)planet|landon|placeon");
+
+    static void typeTokens(Game game, String rest, Map<String, Object> v) {
+        List<String> args = new ArrayList<>();
+        Set<String> players = new LinkedHashSet<>();
+        for (String raw : rest.split("_")) {
+            if (raw.isEmpty()) continue;
+            String tok = raw;
+            if (tok.endsWith("damaged") && tok.length() > 7) {
+                v.put("damaged", true);
+                tok = tok.substring(0, tok.length() - 7);
+            }
+            if ("space".equals(tok)) {
+                v.put("holder", "space");
+                continue;
+            }
+            if ("damaged".equals(tok)) {
+                v.put("damaged", true);
+                continue;
+            }
+            // A planet id that is also a faction id (muaat, winnu, ...) is the planet on a step that targets a planet,
+            // and after a player token (a home planet named like its faction, as in ActionCardTargetKind ids).
+            boolean planetToo = game.getPlanetsInfo().containsKey(tok) || Mapper.isValidPlanet(tok);
+            boolean planetStep = PLANET_STEP.matcher(String.valueOf(v.get("step"))).find() && planetToo;
+            Player p = tok.length() > 2 && !planetStep ? game.getPlayerFromColorOrFaction(tok) : null;
+            if (p != null && !(planetToo && !players.isEmpty())) {
+                players.add(p.getFaction());
+                continue;
+            }
+            if (planetToo) {
+                if (!v.containsKey("planet")) v.put("planet", tok);
+                else args.add(tok);
+                continue;
+            }
+            if (tok.matches("\\d{3,4}|[a-z]{2,3}\\d{1,2}") && game.getTileByPosition(tok) != null) {
+                if (!v.containsKey("system")) v.put("system", tok);
+                else args.add(tok);
+                continue;
+            }
+            if (UNITS.contains(tok)) {
+                v.put("unit", tok);
+                continue;
+            }
+            if (tok.matches("-?\\d+")) {
+                if (!v.containsKey("count")) v.put("count", Integer.parseInt(tok));
+                else args.add(tok);
+                continue;
+            }
+            if (Mapper.isValidActionCard(tok)) {
+                v.put("actionCardRef", tok);
+                continue;
+            }
+            if (Mapper.isValidPromissoryNote(tok)) {
+                v.put("promissoryNote", tok);
+                continue;
+            }
+            if (Mapper.isValidTech(tok)) {
+                v.put("tech", tok);
+                continue;
+            }
+            args.add(tok);
+        }
+        if (!players.isEmpty()) v.put("player", players.iterator().next());
+        if (players.size() > 1) v.put("players", new ArrayList<>(players));
+        if (!args.isEmpty()) v.put("args", args);
+    }
+}
