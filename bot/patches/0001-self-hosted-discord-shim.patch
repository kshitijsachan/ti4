new file mode 100644
index 0000000..d5fe6d2
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/EngineModels.java
@@ -0,0 +1,154 @@
+package ti4.selfhost.engine;
+
+import java.util.List;
+import java.util.Map;
+
+/**
+ * Wire contract of the engine API (mirrored 1:1 by shim/src/engine/types.ts — change both together and bump
+ * {@link #CONTRACT_VERSION}). All ids are strings; numbers are plain ints.
+ */
+public final class EngineModels {
+    private EngineModels() {}
+
+    public static final int CONTRACT_VERSION = 1;
+
+    // ------------------------------------------------------------------ state
+
+    public record GameState(
+            int contract,
+            String game,
+            /** Game.getLastModifiedDate(): changes on every save and on undo. */
+            long stateVersion,
+            /** Engine event seq at snapshot time; resume the stream with after=seq. */
+            long seq,
+            String phase,
+            int round,
+            String activePlayer,
+            String speaker,
+            List<PlayerState> players,
+            List<StrategyCardState> strategyCards,
+            List<TileState> tiles,
+            Map<String, List<String>> publicObjectives,
+            List<String> laws,
+            DraftState draft) {}
+
+    /** Hidden information (hand contents) is only filled for the viewer's own player ({@code self=true}). */
+    public record PlayerState(
+            String userId,
+            String userName,
+            String faction,
+            String color,
+            boolean self,
+            boolean real,
+            boolean passed,
+            boolean eliminated,
+            boolean speaker,
+            boolean active,
+            int victoryPoints,
+            int tg,
+            int commodities,
+            int commoditiesMax,
+            CommandTokens commandTokens,
+            List<Integer> strategyCards,
+            List<String> techs,
+            List<String> exhaustedTechs,
+            List<String> planets,
+            List<String> exhaustedPlanets,
+            List<String> relics,
+            List<String> fragments,
+            List<String> leaders,
+            List<String> promissoryNotesInPlayArea,
+            Map<String, Integer> secretsScored,
+            int actionCardCount,
+            int secretObjectiveCount,
+            int promissoryNoteCount,
+            Hand hand) {}
+
+    public record CommandTokens(int tactic, int fleet, int strategy) {}
+
+    /** Only for the viewer's own player. Keys are card ids, values the per-player numeric handles the engine uses. */
+    public record Hand(
+            Map<String, Integer> actionCards,
+            Map<String, Integer> secretObjectives,
+            Map<String, Integer> promissoryNotes) {}
+
+    public record StrategyCardState(int number, String holder, int tradeGoods, boolean played) {}
+
+    public record TileState(String position, String tileId, List<HolderState> holders) {}
+
+    /** "space" or a planet id. */
+    public record HolderState(String name, List<UnitStack> units, List<String> tokens, List<String> control) {}
+
+    /** owner = faction of the unit's colour (null if no player has that colour). */
+    public record UnitStack(String owner, String color, String unit, int count, int damaged, int galvanized) {}
+
+    public record DraftState(String type, String currentPlayer, List<String> order) {}
+
+    // ------------------------------------------------------------------ decisions
+
+    /**
+     * One question the engine asked. Opened when a message carrying components is posted, updated when it is edited,
+     * closed when it is deleted, its components removed, or it is answered.
+     */
+    public record Decision(
+            String id,
+            String game,
+            /** Discriminant: "legacy" or a typed kind such as "strategy_card.pick". See DecisionKinds. */
+            String kind,
+            /** Engine event seq at which this revision was opened. */
+            long seq,
+            long stateVersion,
+            Target target,
+            /** "player" (only target may answer), "table" (any seated player, each answers for themself). */
+            String scope,
+            /** "public" or "private" (cards-info thread, private channel or ephemeral: only target may see it). */
+            String visibility,
+            String prompt,
+            List<Option> options,
+            Source source,
+            long createdAt) {}
+
+    /**
+     * userId null when nobody specific is targeted. resolvedBy says how the engine knows: owner_prefix (FFCC_),
+     * spoof_prefix, cards_thread, private_channel, interaction_user (ephemeral/followup), draft_turn, mention, none.
+     */
+    public record Target(String userId, String faction, String color, String resolvedBy) {}
+
+    /**
+     * id is opaque to clients (today: the component custom id, plus "#value" for select options). value is the
+     * kind-specific typed payload, null for options outside the kind's vocabulary (e.g. "Done").
+     */
+    public record Option(
+            String id,
+            String label,
+            String style,
+            String emoji,
+            boolean disabled,
+            /** Needs free-form input (a Discord modal): not answerable through the engine yet. */
+            boolean needsInput,
+            String handler,
+            Map<String, Object> value) {}
+
+    public record Source(String channelId, String messageId, String customIdPrefix, boolean ephemeral) {}
+
+    // ------------------------------------------------------------------ actions
+
+    public record AnswerRequest(String optionId, Long expectedSeq, String requestId, String userId) {}
+
+    public record AnswerResult(
+            boolean ok,
+            String status,
+            String error,
+            String decisionId,
+            long seq,
+            long stateVersion,
+            List<Decision> opened) {}
+
+    // ------------------------------------------------------------------ events
+
+    /**
+     * type: decision.opened | decision.updated | decision.closed | state.changed. Stream order == seq order.
+     * decision is set for decision.* (on closed: only id/game/target meaningful), reason for closed.
+     */
+    public record EngineEvent(long seq, String type, String game, long stateVersion, Decision decision, String reason) {}
+}
