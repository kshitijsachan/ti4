+import java.util.Map;
+import java.util.Objects;
+import java.util.Set;
+import java.util.concurrent.atomic.AtomicLong;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+import net.dv8tion.jda.api.entities.channel.Channel;
+import net.dv8tion.jda.api.utils.data.DataArray;
+import net.dv8tion.jda.api.utils.data.DataObject;
+import okhttp3.Interceptor;
+import okhttp3.Request;
+import okhttp3.Response;
+import okio.Buffer;
+import ti4.discord.JdaService;
+import ti4.discord.interactions.routing.ComponentIdEnvelope;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.game.persistence.GameManager;
+import ti4.game.persistence.ManagedGame;
+import ti4.logging.BotLogger;
+import ti4.selfhost.engine.EngineModels.Decision;
+import ti4.selfhost.engine.EngineModels.Option;
+import ti4.selfhost.engine.EngineModels.Source;
+import ti4.selfhost.engine.EngineModels.Target;
+import ti4.service.game.GameNameService;
+
+/**
+ * THE capture point: an OkHttp interceptor on JDA's REST client. Every message the engine posts, edits or deletes
+ * (channel messages, interaction replies, followups, ephemerals — all ~5,500 button construction sites) passes
+ * here, so decisions are captured without touching handler code. Target players are resolved from engine state
+ * (FFCC_ owner faction → Player, cards-info thread owner, interaction user), never from message text.
+ */
+public final class DecisionCapture implements Interceptor {
+
+    private static final Pattern CH_MSGS = Pattern.compile(".*/channels/(\\d+)/messages$");
+    private static final Pattern CH_MSG = Pattern.compile(".*/channels/(\\d+)/messages/(\\d+)$");
+    private static final Pattern CH_BULK = Pattern.compile(".*/channels/(\\d+)/messages/bulk-delete$");
+    private static final Pattern HOOK = Pattern.compile(".*/webhooks/(\\d+)/([^/]+)$");
+    private static final Pattern HOOK_MSG = Pattern.compile(".*/webhooks/(\\d+)/([^/]+)/messages/([^/]+)$");
+    private static final Pattern CALLBACK = Pattern.compile(".*/interactions/(\\d+)/([^/]+)/callback$");
+    private static final Pattern MENTION = Pattern.compile("<@!?(\\d+)>");
+    private static final AtomicLong REV = new AtomicLong();
+
+    @Override
+    public Response intercept(Chain chain) throws IOException {
+        Request req = chain.request();
+        Response res = chain.proceed(req);
+        if (!Engine.enabled() || !res.isSuccessful()) return res;
+        try {
+            observe(req, res);
+        } catch (Exception e) {
+            BotLogger.error("engine: decision capture failed for " + req.method() + " " + req.url().encodedPath(), e);
+        }
+        return res;
+    }
+
+    private static void observe(Request req, Response res) throws IOException {
+        String path = req.url().encodedPath();
+        String method = req.method();
+        Matcher m;
+        if ("POST".equals(method) && (m = CH_BULK.matcher(path)).matches()) {
+            DataObject body = DataObject.fromJson(bodyString(req));
+            DataArray ids = body.getArray("messages");
+            for (int i = 0; i < ids.length(); i++) DecisionRegistry.closeByMessage(ids.getString(i), "deleted");
+            return;
+        }
+        if ((m = CH_MSGS.matcher(path)).matches() && "POST".equals(method)) {
+            onMessage(responseJson(res), null);
+            return;
+        }
+        if ((m = CH_MSG.matcher(path)).matches()) {
+            if ("DELETE".equals(method)) DecisionRegistry.closeByMessage(m.group(2), "deleted");
+            else if ("PATCH".equals(method)) onMessage(responseJson(res), null);
+            return;
+        }
+        if ((m = HOOK_MSG.matcher(path)).matches()) {
+            String token = m.group(2);
+            String id = m.group(3);
+            if ("@original".equals(id)) id = InteractionTracker.original(token);
+            if ("DELETE".equals(method)) {
+                if (id != null) DecisionRegistry.closeByMessage(id, "deleted");
+            } else if ("PATCH".equals(method)) {
+                DataObject msg = responseJson(res);
+                if (msg != null && "@original".equals(m.group(3)))
+                    InteractionTracker.setOriginal(token, msg.getString("id", null));
+                onMessage(msg, token);
+            }
+            return;
+        }
+        if ((m = HOOK.matcher(path)).matches() && "POST".equals(method)) {
+            onMessage(responseJson(res), m.group(2)); // interaction followup (or channel webhook: token unknown)
+            return;
+        }
+        if ((m = CALLBACK.matcher(path)).matches() && "POST".equals(method)) {
+            DataObject body = responseJson(res); // only present with ?with_response=true
+            if (body != null && body.hasKey("resource") && !body.isNull("resource")) {
+                DataObject resource = body.getObject("resource");
+                if (resource.hasKey("message") && !resource.isNull("message")) {
+                    DataObject msg = resource.getObject("message");
+                    int type = resource.getInt("type", 0);
+                    if (type == 4 || type == 5) InteractionTracker.setOriginal(m.group(2), msg.getString("id", null));
+                    onMessage(msg, m.group(2));
+                }
+            }
+        }
+    }
+
+    // ------------------------------------------------------------------ message -> decision
+
+    static void onMessage(DataObject msg, String interactionToken) {
+        if (msg == null || !msg.hasKey("id")) return;
+        String messageId = msg.getString("id");
+        String channelId = msg.getString("channel_id", null);
+        List<RawControl> controls = new ArrayList<>();
+        if (msg.hasKey("components") && !msg.isNull("components")) collect(msg.getArray("components"), controls);
+        if (controls.isEmpty()) {
+            DecisionRegistry.closeByMessage(messageId, "no_options");
+            return;
+        }
+        Game game = gameForChannel(channelId);
+        if (game == null) return;
+        boolean ephemeral = (msg.getInt("flags", 0) & 64) != 0;
+        String content = msg.getString("content", "");
+
+        List<String> handlerIds = new ArrayList<>();
+        for (RawControl c : controls) handlerIds.add(ComponentIdEnvelope.decode(c.customId).handlerId());
+
+        Target resolved = resolveTarget(game, controls, channelId, ephemeral, interactionToken, content);
+        Player player = resolved == null || resolved.userId() == null ? null : game.getPlayer(resolved.userId());
+        KindSpec spec = DecisionKinds.classify(handlerIds);
+        KindSpec.CaptureContext ctx =
+                new KindSpec.CaptureContext(game, channelId, messageId, content, ephemeral, resolved, player);
+        Target target = resolved;
+        if (spec != null) {
+            target = spec.target(ctx, resolved);
+            if (!Objects.equals(target, resolved)) {
+                player = target == null || target.userId() == null ? null : game.getPlayer(target.userId());
+                ctx = new KindSpec.CaptureContext(game, channelId, messageId, content, ephemeral, target, player);
+            }
+        }
+
+        List<Option> options = new ArrayList<>();
+        for (int i = 0; i < controls.size(); i++) {
+            RawControl c = controls.get(i);
+            String h = handlerIds.get(i);
+            Map<String, Object> value = null;
+            if (spec != null && h != null && spec.matches(h)) {
+                try {
+                    value = spec.value(h, ctx);
+                } catch (Exception e) {
+                    BotLogger.error("engine: kind " + spec.kind() + " failed to type option " + c.customId, e);
+                }
+            }
+            options.add(new Option(
+                    c.optionId(),
+                    c.label,
+                    c.style,
+                    c.emoji,
+                    c.disabled,
+                    c.customId.contains("~MDL"),
+                    h,
+                    value));
+        }
+        String visibility = ephemeral || isPrivateChannel(game, channelId) ? "private" : "public";
+        String scope = spec != null ? spec.scope(ctx) : (target == null || target.userId() == null ? "table" : "player");
+        String prefix = commonPrefix(handlerIds);
+
+        Decision existing = byIdOrNull(DecisionRegistry.decisionIdForMessage(messageId));
+        if (existing != null
+                && Objects.equals(existing.target(), target)
+                && sameOptions(existing.options(), options)
+                && Objects.equals(existing.prompt(), content)) return;
+
+        Decision d = new Decision(
+                "d" + messageId + "-" + REV.incrementAndGet(),
+                game.getName(),
+                spec == null ? DecisionKinds.LEGACY : spec.kind(),
+                0,
+                game.getLastModifiedDate(),
+                target,
+                scope,
+                visibility,
+                content,
+                options,
+                new Source(channelId, messageId, prefix, ephemeral),
+                System.currentTimeMillis());
+        DecisionRegistry.open(d);
+    }
+
+    private static Decision byIdOrNull(String id) {
+        return id == null ? null : DecisionRegistry.get(id);
+    }
+
+    private static boolean sameOptions(List<Option> a, List<Option> b) {
+        if (a.size() != b.size()) return false;
+        for (int i = 0; i < a.size(); i++) {
+            Option x = a.get(i), y = b.get(i);
+            if (!x.id().equals(y.id()) || x.disabled() != y.disabled() || !Objects.equals(x.label(), y.label()))
+                return false;
+        }
+        return true;
+    }
+
+    // ------------------------------------------------------------------ target resolution
+
+    static Target resolveTarget(
+            Game game, List<RawControl> controls, String channelId, boolean ephemeral, String token, String content) {
+        // 1. FFCC_<faction>_ / dummyPlayerSpoof<faction>_ on the options (2,232 of 5,495 button sites).
+        Set<String> owners = new LinkedHashSet<>();
+        Set<String> spoofs = new LinkedHashSet<>();
+        int unowned = 0;
+        for (RawControl c : controls) {
+            ComponentIdEnvelope env = ComponentIdEnvelope.decode(c.customId);
+            if (env.ownerFaction() != null) owners.add(env.ownerFaction());
+            else if (env.spoofedFaction() != null) spoofs.add(env.spoofedFaction());
+            else unowned++;
+        }
+        if (owners.size() == 1 && spoofs.isEmpty()) {
+            Player p = game.getPlayerFromColorOrFaction(owners.iterator().next());
+            if (p != null) return target(p, "owner_prefix");
+        }
+        if (spoofs.size() == 1 && owners.isEmpty()) {
+            Player p = game.getPlayerFromColorOrFaction(spoofs.iterator().next());
+            if (p != null) return target(p, "spoof_prefix");
+        }
+        // 2. Interaction replies / followups / ephemerals: whoever made the interaction.
+        if (token != null) {
+            InteractionTracker.Info info = InteractionTracker.byToken(token);
+            if (info != null) {
+                Player p = game.getPlayer(info.userId());
+                if (p != null) return target(p, "interaction_user");
+            }
+        }
+        // 3. The player's own cards-info thread / private channel.
+        for (Player p : game.getPlayers().values()) {
+            if (channelId != null && channelId.equals(p.getCardsInfoThreadID())) return target(p, "cards_thread");
+            if (channelId != null && channelId.equals(p.getPrivateChannelID())) return target(p, "private_channel");
+        }
+        // 4. Exactly one seated player mentioned (weak; kinds may override).
+        if (content != null && owners.isEmpty()) {
+            Set<String> mentioned = new HashSet<>();
+            Matcher mm = MENTION.matcher(content);
+            while (mm.find()) if (game.getPlayer(mm.group(1)) != null) mentioned.add(mm.group(1));
+            if (mentioned.size() == 1) return target(game.getPlayer(mentioned.iterator().next()), "mention");
+        }
+        return new Target(null, null, null, owners.size() > 1 ? "mixed_owners" : "none");
+    }
+
+    static Target target(Player p, String how) {
+        return new Target(p.getUserID(), p.getFaction(), p.getColor(), how);
+    }
+
+    private static boolean isPrivateChannel(Game game, String channelId) {
+        if (channelId == null) return false;
+        for (Player p : game.getPlayers().values()) {
+            if (channelId.equals(p.getCardsInfoThreadID()) || channelId.equals(p.getPrivateChannelID())) return true;
+        }
+        return false;
+    }
+
+    static Game gameForChannel(String channelId) {
+        if (channelId == null || JdaService.jda == null) return null;
+        Channel ch = JdaService.jda.getChannelById(Channel.class, channelId);
+        if (ch == null) return null;
+        String name = GameNameService.getGameNameFromChannel(ch);
+        if (name == null) return null;
+        ManagedGame mg = GameManager.getManagedGame(name);
+        return mg == null ? null : mg.getGame();
+    }
+
+    // ------------------------------------------------------------------ components
+
+    record RawControl(String customId, String label, String style, String emoji, boolean disabled, String value) {
+        String optionId() {
+            return value == null ? customId : customId + "#" + value;
+        }
+    }
+
+    private static final String[] STYLES = {"", "primary", "secondary", "success", "danger", "link", "premium"};
+
+    private static void collect(DataArray arr, List<RawControl> out) {
+        for (int i = 0; i < arr.length(); i++) {
+            if (!arr.isType(i, net.dv8tion.jda.api.utils.data.DataType.OBJECT)) continue;
+            DataObject c = arr.getObject(i);
+            int type = c.getInt("type", 0);
+            if (type == 2 && c.hasKey("custom_id") && !c.isNull("custom_id")) {
+                int style = c.getInt("style", 2);
+                String emoji = null;
+                if (c.hasKey("emoji") && !c.isNull("emoji")) {
+                    DataObject e = c.getObject("emoji");
+                    emoji = e.isNull("id") || !e.hasKey("id") ? e.getString("name", null) : e.getString("id", null);
+                }
+                out.add(new RawControl(
+                        c.getString("custom_id"),
+                        c.getString("label", ""),
+                        style >= 0 && style < STYLES.length ? STYLES[style] : String.valueOf(style),
+                        emoji,
+                        c.getBoolean("disabled", false),
+                        null));
+            } else if (type == 3 && c.hasKey("custom_id")) {
+                DataArray opts = c.optArray("options").orElse(DataArray.empty());
+                for (int j = 0; j < opts.length(); j++) {
+                    DataObject o = opts.getObject(j);
+                    out.add(new RawControl(
+                            c.getString("custom_id"),
+                            o.getString("label", ""),
+                            "select",
+                            null,
+                            c.getBoolean("disabled", false),
+                            o.getString("value", "")));
+                }
+            }
+            if (c.hasKey("components") && !c.isNull("components")) collect(c.getArray("components"), out);
+            if (c.hasKey("accessory") && !c.isNull("accessory"))
+                collect(DataArray.empty().add(c.getObject("accessory")), out);
+        }
+    }
+
+    private static String commonPrefix(List<String> ids) {
+        Set<String> heads = new LinkedHashSet<>();
+        for (String h : ids) {
+            if (h == null) continue;
+            int us = h.indexOf('_');
+            heads.add(us < 0 ? h : h.substring(0, us + 1));
+        }
+        return heads.isEmpty() ? null : heads.iterator().next();
+    }
+
+    // ------------------------------------------------------------------ http helpers
+
+    private static DataObject responseJson(Response res) throws IOException {
+        if (res.body() == null) return null;
+        String s = res.peekBody(16L * 1024 * 1024).string();
+        if (s.isBlank() || !s.trim().startsWith("{")) return null;
+        return DataObject.fromJson(s);
+    }
+
+    private static String bodyString(Request req) throws IOException {
+        if (req.body() == null) return "{}";
+        Buffer b = new Buffer();
+        req.body().writeTo(b);
+        return b.readUtf8();
+    }
+}
