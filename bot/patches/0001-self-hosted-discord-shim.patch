@@ -0,0 +1,270 @@
+package ti4.selfhost.engine.interaction;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.atomic.AtomicLong;
+import javax.annotation.Nullable;
+import lombok.Getter;
+import net.dv8tion.jda.api.components.ActionComponent;
+import net.dv8tion.jda.api.components.MessageTopLevelComponent;
+import net.dv8tion.jda.api.components.buttons.Button;
+import net.dv8tion.jda.api.components.selections.StringSelectMenu;
+import net.dv8tion.jda.api.components.tree.MessageComponentTree;
+import net.dv8tion.jda.api.entities.Guild;
+import net.dv8tion.jda.api.entities.Member;
+import net.dv8tion.jda.api.entities.Message;
+import net.dv8tion.jda.api.entities.User;
+import net.dv8tion.jda.api.entities.channel.middleman.GuildChannel;
+import net.dv8tion.jda.api.entities.channel.middleman.MessageChannel;
+import net.dv8tion.jda.api.modals.Modal;
+import net.dv8tion.jda.api.utils.FileUpload;
+import net.dv8tion.jda.api.utils.messages.MessageCreateData;
+import net.dv8tion.jda.api.utils.messages.MessageEditBuilder;
+import net.dv8tion.jda.api.utils.messages.MessageEditData;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.selfhost.engine.DecisionRegistry;
+import ti4.selfhost.engine.Interaction;
+
+/**
+ * The engine's own {@link Interaction}: a seat answering a decision directly. No interaction token, no synthesised
+ * Discord payload, no shim round trip. Message I/O goes through a {@link MessageSink} (today JDA channel REST, which
+ * keeps the Discord mirror and decision capture working; W-INFRA-4 swaps it for a decisions-only sink), and prompt
+ * removal closes the decision in the registry immediately.
+ *
+ * <p>Semantics follow a Discord button press as ButtonListener performs it: the interaction is acknowledged up front
+ * (deferEdit), so "@original" is the prompt message and replies are followups in the prompt's channel.
+ */
+public final class EngineInteraction implements Interaction {
+
+    public enum Type {
+        BUTTON,
+        SELECT,
+        MODAL
+    }
+
+    private static final AtomicLong IDS = new AtomicLong((System.currentTimeMillis() - 1420070400000L) << 22);
+
+    @Getter
+    private final long id = IDS.incrementAndGet();
+
+    @Getter
+    private final Type type;
+
+    private final Game game;
+    private final Player player;
+    private final String userId;
+    private final String channelId;
+    private final String messageId;
+    /** Button / select custom id (raw), or the modal id. */
+    private final String componentId;
+
+    @Getter
+    private final List<String> values;
+
+    @Getter
+    private final Map<String, String> inputs;
+
+    private final MessageSink sink;
+    private Message message;
+    private boolean messageLoaded;
+
+    /** The modal a handler opened (replyModal); the engine turns it into an input.form decision. */
+    @Getter
+    private Modal openedModal;
+
+    /** What the answer did, in order (for logs, results and tests). */
+    @Getter
+    private final List<String> trace = Collections.synchronizedList(new ArrayList<>());
+
+    public EngineInteraction(
+            Type type,
+            Game game,
+            Player player,
+            String userId,
+            String channelId,
+            @Nullable String messageId,
+            String componentId,
+            List<String> values,
+            Map<String, String> inputs,
+            MessageSink sink) {
+        this.type = type;
+        this.game = game;
+        this.player = player;
+        this.userId = userId;
+        this.channelId = channelId;
+        this.messageId = messageId;
+        this.componentId = componentId;
+        this.values = values == null ? List.of() : List.copyOf(values);
+        this.inputs = inputs == null ? Map.of() : Map.copyOf(inputs);
+        this.sink = sink;
+    }
+
+    // ------------------------------------------------------------------ Interaction
+
+    @Override
+    public Game game() {
+        return game;
+    }
+
+    @Override
+    public Player player() {
+        return player;
+    }
+
+    @Override
+    public String userId() {
+        return userId;
+    }
+
+    @Override
+    public String componentId() {
+        return componentId;
+    }
+
+    public String channelId() {
+        return channelId;
+    }
+
+    @Override
+    public MessageChannel channel() {
+        return sink.channel(channelId);
+    }
+
+    @Override
+    @Nullable
+    public String messageId() {
+        return messageId;
+    }
+
+    @Override
+    @Nullable
+    public synchronized Message message() {
+        if (!messageLoaded && messageId != null) {
+            message = sink.fetch(channelId, messageId);
+            messageLoaded = true;
+        }
+        return message;
+    }
+
+    @Override
+    public boolean isEngine() {
+        return true;
+    }
+
+    @Override
+    public void deferEdit() {
+        trace.add("deferEdit");
+    }
+
+    @Override
+    public void reply(MessageCreateData data) {
+        send(data, false);
+    }
+
+    @Override
+    public void replyEphemeral(MessageCreateData data) {
+        send(data, true);
+    }
+
+    @Override
+    public void editComponents(MessageComponentTree tree) {
+        if (messageId == null) return;
+        edit(messageId, new MessageEditBuilder().setComponents(tree.getComponents()).build());
+    }
+
+    @Override
+    public void editMessage(String content, List<? extends MessageTopLevelComponent> components, List<FileUpload> files) {
+        if (messageId == null) return;
+        edit(messageId, new MessageEditBuilder()
+                .setContent(content)
+                .setComponents(components)
+                .setFiles(files)
+                .build());
+    }
+
+    @Override
+    public void deleteMessage() {
+        if (messageId != null) delete(messageId, 0);
+    }
+
+    @Override
+    public void deleteMessage(int delaySeconds) {
+        if (messageId != null) delete(messageId, Math.min(delaySeconds, 20));
+    }
+
+    // ------------------------------------------------------------------ primitives (also used by the JDA view)
+
+    /** Followup in the prompt's channel; ephemeral = only the answering user sees it. */
+    @Nullable
+    public Message send(MessageCreateData data, boolean ephemeral) {
+        trace.add((ephemeral ? "reply_ephemeral" : "reply") + ": " + abbreviate(data.getContent()));
+        return sink.send(channelId, data, ephemeral ? userId : null);
+    }
+
+    @Nullable
+    public Message edit(String targetMessageId, MessageEditData data) {
+        trace.add("edit " + targetMessageId);
+        Message m = sink.edit(channelId, targetMessageId, data);
+        if (targetMessageId.equals(messageId) && m != null) {
+            synchronized (this) {
+                message = m;
+                messageLoaded = true;
+            }
+        }
+        return m;
+    }
+
+    public void delete(String targetMessageId, int delaySeconds) {
+        trace.add("delete " + targetMessageId);
+        if (delaySeconds <= 0) DecisionRegistry.closeByMessage(targetMessageId, "answered");
+        sink.delete(channelId, targetMessageId, delaySeconds);
+    }
+
+    @Nullable
+    public Message fetch(String targetMessageId) {
+        return targetMessageId.equals(messageId) ? message() : sink.fetch(channelId, targetMessageId);
+    }
+
+    public void openModal(Modal modal) {
+        trace.add("modal " + modal.getId());
+        openedModal = modal;
+    }
+
+    /** The pressed button / select menu, taken from the prompt message (so uniqueId matches its tree). */
+    @Nullable
+    public ActionComponent component() {
+        Message m = message();
+        if (m != null) {
+            Class<? extends ActionComponent> kind = type == Type.SELECT ? StringSelectMenu.class : Button.class;
+            for (ActionComponent c : m.getComponentTree().findAll(kind)) {
+                if (componentId.equals(c.getCustomId())) return c;
+            }
+        }
+        return type == Type.SELECT ? StringSelectMenu.create(componentId).addOption("-", "-").build()
+                : Button.secondary(componentId, "-");
+    }
+
+    public User user() {
+        return sink.user(userId);
+    }
+
+    @Nullable
+    public Guild guild() {
+        return channel() instanceof GuildChannel gc ? gc.getGuild() : null;
+    }
+
+    @Nullable
+    public Member member() {
+        Guild g = guild();
+        return g == null ? null : sink.member(g, userId);
+    }
+
+    private static String abbreviate(String s) {
+        if (s == null) return "";
+        s = s.replace('\n', ' ');
+        return s.length() > 80 ? s.substring(0, 80) + "…" : s;
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/interaction/Forms.java b/src/main/java/ti4/selfhost/engine/interaction/Forms.java
new file mode 100644
index 0000000..493f60d
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/interaction/Forms.java
@@ -0,0 +1,175 @@
+package ti4.selfhost.engine.interaction;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.concurrent.ConcurrentHashMap;
+import javax.annotation.Nullable;
+import net.dv8tion.jda.api.components.label.Label;
+import net.dv8tion.jda.api.components.selections.SelectOption;
+import net.dv8tion.jda.api.components.selections.StringSelectMenu;
+import net.dv8tion.jda.api.components.textinput.TextInput;
+import net.dv8tion.jda.api.components.textinput.TextInputStyle;
+import net.dv8tion.jda.api.modals.Modal;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.selfhost.engine.DecisionRegistry;
+import ti4.selfhost.engine.EngineModels.Choice;
+import ti4.selfhost.engine.EngineModels.Decision;
+import ti4.selfhost.engine.EngineModels.InputField;
+import ti4.selfhost.engine.EngineModels.InputSchema;
+import ti4.selfhost.engine.EngineModels.Option;
+import ti4.selfhost.engine.EngineModels.Source;
+import ti4.selfhost.engine.EngineModels.Target;
+
+/**
+ * Forms ("input.form" decisions): when an engine answer presses a button whose handler opens a Discord modal, the
+ * modal becomes a typed decision for that player — its text inputs / selects as an {@link InputSchema} — answered with
+ * {@code {optionId:"submit", inputs:{...}}} (runs the modal's handler as an engine answer) or {@code "cancel"}.
+ */
+public final class Forms {
+    public static final String KIND = "input.form";
+    public static final String SUBMIT = "submit";
+    public static final String CANCEL = "cancel";
+
+    /** Modal text inputs whose handlers parse an integer (engine ids, not labels). */
+    private static final Set<String> NUMERIC = Set.of("vp", "rounds", "diceSides", "diceCount", "count");
+
+    /** An open form: the modal and the prompt it came from. */
+    public record Form(String decisionId, Modal modal, String channelId, String messageId, String userId) {}
+
+    private static final Map<String, Form> open = new ConcurrentHashMap<>();
+
+    private Forms() {}
+
+    @Nullable
+    public static Form get(String decisionId) {
+        return open.get(decisionId);
+    }
+
+    public static void close(String decisionId, String reason) {
+        open.remove(decisionId);
+        DecisionRegistry.close(decisionId, reason);
+    }
+
+    /** Opens the form decision for a modal a handler opened during an engine answer to {@code origin}. */
+    public static Decision open(Decision origin, EngineInteraction ix, Game game, Player player) {
+        Modal modal = ix.getOpenedModal();
+        String pseudoMessage = "form-" + origin.source().messageId() + "-" + ix.userId();
+        String id = "f" + origin.source().messageId() + "-" + ix.userId();
+        InputSchema schema = schema(modal);
+        Decision d = new Decision(
+                id,
+                game.getName(),
+                KIND,
+                0,
+                game.getLastModifiedDate(),
+                new Target(player.getUserID(), player.getFaction(), player.getColor(), "interaction_user"),
+                "player",
+                "private",
+                modal.getTitle(),
+                List.of(
+                        new Option(SUBMIT, "Submit", "primary", null, false, true, modal.getId(), null, null),
+                        new Option(CANCEL, "Cancel", "secondary", null, false, false, null, null, null)),
+                new Source(origin.source().channelId(), pseudoMessage, modal.getId(), true),
+                System.currentTimeMillis(),
+                0,
+                null,
+                null,
+                List.of(schema));
+        Decision stored = DecisionRegistry.open(d);
+        open.put(stored.id(), new Form(stored.id(), modal, origin.source().channelId(), origin.source().messageId(), ix.userId()));
+        return stored;
+    }
+
+    public static InputSchema schema(Modal modal) {
+        Map<String, String> labels = new java.util.HashMap<>();
+        for (Label l : modal.getComponentTree().findAll(Label.class)) {
+            String child = l.getChild() instanceof TextInput t ? t.getCustomId()
+                    : l.getChild() instanceof StringSelectMenu s ? s.getCustomId() : null;
+            if (child != null) labels.put(child, l.getLabel());
+        }
+        List<InputField> fields = new ArrayList<>();
+        for (TextInput t : modal.getComponentTree().findAll(TextInput.class)) {
+            fields.add(new InputField(
+                    t.getCustomId(),
+                    labels.get(t.getCustomId()),
+                    NUMERIC.contains(t.getCustomId()) ? "number" : "text",
+                    t.isRequired(),
+                    t.getMinLength() < 0 ? null : t.getMinLength(),
+                    t.getMaxLength() < 0 ? null : t.getMaxLength(),
+                    null,
+                    null,
+                    t.getStyle() == TextInputStyle.PARAGRAPH,
+                    t.getPlaceHolder(),
+                    t.getValue(),
+                    null));
+        }
+        for (StringSelectMenu s : modal.getComponentTree().findAll(StringSelectMenu.class)) {
+            List<Choice> choices = new ArrayList<>();
+            for (SelectOption o : s.getOptions())
+                choices.add(new Choice(o.getValue(), o.getLabel(), o.getDescription(), o.isDefault()));
+            fields.add(new InputField(
+                    s.getCustomId(),
+                    labels.getOrDefault(s.getCustomId(), s.getPlaceholder()),
+                    "choice",
+                    s.getMinValues() > 0,
+                    null,
+                    null,
+                    s.getMinValues(),
+                    s.getMaxValues(),
+                    false,
+                    s.getPlaceholder(),
+                    null,
+                    choices));
+        }
+        return new InputSchema(modal.getId(), "form", modal.getTitle(), fields);
+    }
+
+    /** Checks answer inputs against a schema; returns an error text or null. Multi-values are "\n"-joined. */
+    @Nullable
+    public static String validate(InputSchema schema, Map<String, String> inputs) {
+        Map<String, String> in = inputs == null ? Map.of() : inputs;
+        for (String k : in.keySet())
+            if (schema.fields().stream().noneMatch(f -> f.id().equals(k))) return "Unknown field " + k + ".";
+        for (InputField f : schema.fields()) {
+            String v = in.get(f.id());
+            if (v == null || v.isEmpty()) {
+                if (f.required()) return "Field " + f.id() + " is required.";
+                continue;
+            }
+            switch (f.type()) {
+                case "number" -> {
+                    try {
+                        Integer.parseInt(v.trim());
+                    } catch (NumberFormatException e) {
+                        return "Field " + f.id() + " must be a whole number.";
+                    }
+                }
+                case "choice" -> {
+                    String err = validateChoice(f, List.of(v.split("\n")));
+                    if (err != null) return err;
+                }
+                default -> {}
+            }
+            if (!"choice".equals(f.type())) {
+                if (f.minLength() != null && v.length() < f.minLength()) return "Field " + f.id() + " is too short.";
+                if (f.maxLength() != null && f.maxLength() > 0 && v.length() > f.maxLength())
+                    return "Field " + f.id() + " is too long.";
+            }
+        }
+        return null;
+    }
+
+    @Nullable
+    public static String validateChoice(InputField f, List<String> values) {
+        int min = f.minValues() == null ? 1 : f.minValues(), max = f.maxValues() == null ? 1 : f.maxValues();
+        if (values.size() < min || values.size() > max)
+            return "Pick between " + min + " and " + max + " option(s).";
+        for (String v : values)
+            if (f.choices().stream().noneMatch(c -> c.value().equals(v))) return "Not an option: " + v + ".";
+        if (values.stream().distinct().count() != values.size()) return "Duplicate option.";
+        return null;
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/interaction/JdaInteraction.java b/src/main/java/ti4/selfhost/engine/interaction/JdaInteraction.java
new file mode 100644
index 0000000..745ffc5
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/interaction/JdaInteraction.java
@@ -0,0 +1,154 @@
+package ti4.selfhost.engine.interaction;
+
+import java.util.List;
+import java.util.concurrent.TimeUnit;
+import javax.annotation.Nullable;
+import net.dv8tion.jda.api.components.MessageTopLevelComponent;
+import net.dv8tion.jda.api.components.tree.MessageComponentTree;
+import net.dv8tion.jda.api.entities.Message;
+import net.dv8tion.jda.api.entities.channel.middleman.MessageChannel;
+import net.dv8tion.jda.api.events.interaction.GenericInteractionCreateEvent;
+import net.dv8tion.jda.api.events.interaction.ModalInteractionEvent;
+import net.dv8tion.jda.api.events.interaction.component.ButtonInteractionEvent;
+import net.dv8tion.jda.api.events.interaction.component.GenericComponentInteractionCreateEvent;
+import net.dv8tion.jda.api.interactions.callbacks.IDeferrableCallback;
+import net.dv8tion.jda.api.interactions.callbacks.IMessageEditCallback;
+import net.dv8tion.jda.api.utils.FileUpload;
+import net.dv8tion.jda.api.utils.messages.MessageCreateData;
+import org.apache.commons.lang3.function.Consumers;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.game.persistence.GameManager;
+import ti4.logging.BotLogger;
+import ti4.message.MessageHelper;
+import ti4.selfhost.engine.Interaction;
+import ti4.service.game.GameNameService;
+
+/**
+ * {@link Interaction} over a real JDA event (Discord path). Each op is exactly what the helper it was extracted from
+ * did before (ButtonHelper.deleteMessage, MessageHelper.sendEphemeralMessageToEventChannel, ...), so Discord-path
+ * behaviour is unchanged.
+ */
+public final class JdaInteraction implements Interaction {
+    private final GenericInteractionCreateEvent event;
+
+    public JdaInteraction(GenericInteractionCreateEvent event) {
+        this.event = event;
+    }
+
+    public GenericInteractionCreateEvent event() {
+        return event;
+    }
+
+    @Override
+    @Nullable
+    public Game game() {
+        String name = GameNameService.getGameNameFromChannel(event);
+        return GameManager.isValid(name) ? GameManager.getManagedGame(name).getGame() : null;
+    }
+
+    @Override
+    @Nullable
+    public Player player() {
+        Game g = game();
+        return g == null ? null : g.getPlayer(userId());
+    }
+
+    @Override
+    public String userId() {
+        return event.getUser().getId();
+    }
+
+    @Override
+    public String componentId() {
+        if (event instanceof GenericComponentInteractionCreateEvent c) return c.getComponentId();
+        if (event instanceof ModalInteractionEvent m) return m.getModalId();
+        return "";
+    }
+
+    @Override
+    public MessageChannel channel() {
+        return event.getMessageChannel();
+    }
+
+    @Override
+    @Nullable
+    public String messageId() {
+        if (event instanceof GenericComponentInteractionCreateEvent c) return c.getMessageId();
+        if (event instanceof ModalInteractionEvent m && m.getMessage() != null) return m.getMessage().getId();
+        return null;
+    }
+
+    @Override
+    @Nullable
+    public Message message() {
+        if (event instanceof GenericComponentInteractionCreateEvent c) return c.getMessage();
+        if (event instanceof ModalInteractionEvent m) return m.getMessage();
+        return null;
+    }
+
+    @Override
+    public boolean isEngine() {
+        return false;
+    }
+
+    @Override
+    public void deferEdit() {
+        if (event instanceof IMessageEditCallback cb && !cb.isAcknowledged())
+            cb.deferEdit().queue(Consumers.nop(), BotLogger::catchRestError);
+    }
+
+    @Override
+    public void reply(MessageCreateData data) {
+        event.getMessageChannel().sendMessage(data).queue(Consumers.nop(), BotLogger::catchRestError);
+    }
+
+    @Override
+    public void replyEphemeral(MessageCreateData data) {
+        if (event instanceof GenericComponentInteractionCreateEvent e) {
+            e.getHook().setEphemeral(true).sendMessage(data).queue(Consumers.nop(), BotLogger::catchRestError);
+        } else {
+            reply(data);
+        }
+    }
+
+    @Override
+    public void replyEphemeral(String text) {
+        if (event instanceof GenericComponentInteractionCreateEvent e) {
+            e.getHook().setEphemeral(true).sendMessage(text).queue(Consumers.nop(), BotLogger::catchRestError);
+        } else {
+            MessageHelper.sendMessageToChannel(event.getMessageChannel(), text);
+        }
+    }
+
+    @Override
+    public void editComponents(MessageComponentTree tree) {
+        if (!(event instanceof GenericComponentInteractionCreateEvent e)) return;
+        if (e.getMessage().isEphemeral()) // only the interaction webhook can edit an ephemeral message
+            e.getHook().editOriginalComponents(tree.getComponents()).queue(Consumers.nop(), BotLogger::catchRestError);
+        else e.getMessage().editMessageComponents(tree).queue(Consumers.nop(), BotLogger::catchRestError);
+    }
+
+    @Override
+    public void editMessage(String content, List<? extends MessageTopLevelComponent> components, List<FileUpload> files) {
+        if (event instanceof IDeferrableCallback cb) {
+            cb.getHook()
+                    .editOriginal(content)
+                    .setComponents(components)
+                    .setFiles(files)
+                    .queue(Consumers.nop(), BotLogger::catchRestError);
+        }
+    }
+
+    @Override
+    public void deleteMessage() {
+        if (event instanceof ButtonInteractionEvent b)
+            b.getHook().deleteOriginal().queue(Consumers.nop(), BotLogger::catchRestError);
+    }
+
+    @Override
+    public void deleteMessage(int delaySeconds) {
+        if (event instanceof ButtonInteractionEvent b)
+            b.getHook().deleteOriginal().queueAfter(Math.min(delaySeconds, 20), TimeUnit.SECONDS);
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/interaction/MessageSink.java b/src/main/java/ti4/selfhost/engine/interaction/MessageSink.java
new file mode 100644
index 0000000..608301d
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/interaction/MessageSink.java
@@ -0,0 +1,124 @@
+package ti4.selfhost.engine.interaction;
+
+import java.util.concurrent.TimeUnit;
+import javax.annotation.Nullable;
+import net.dv8tion.jda.api.JDA;
+import net.dv8tion.jda.api.entities.Guild;
+import net.dv8tion.jda.api.entities.Member;
+import net.dv8tion.jda.api.entities.Message;
+import net.dv8tion.jda.api.entities.User;
+import net.dv8tion.jda.api.entities.channel.middleman.MessageChannel;
+import net.dv8tion.jda.api.requests.RestAction;
+import net.dv8tion.jda.api.utils.messages.MessageCreateData;
+import net.dv8tion.jda.api.utils.messages.MessageEditData;
+import org.apache.commons.lang3.function.Consumers;
+import ti4.discord.JdaService;
+import ti4.logging.BotLogger;
+
+/**
+ * Where an engine answer's messages go. Today: JDA channel REST (public API only — no interaction tokens), so the
+ * Discord mirror and DecisionCapture keep working unchanged. W-INFRA-4 replaces this with a decisions-only sink.
+ */
+public interface MessageSink {
+
+    /** Nonce prefix the shim understands as "ephemeral for this user" on a channel message (see shim rest.ts). */
+    String EPHEMERAL_NONCE = "eph:";
+
+    MessageChannel channel(String channelId);
+
+    @Nullable
+    Message fetch(String channelId, String messageId);
+
+    /** ephemeralFor = user id when only that user may see the message. */
+    @Nullable
+    Message send(String channelId, MessageCreateData data, @Nullable String ephemeralFor);
+
+    @Nullable
+    Message edit(String channelId, String messageId, MessageEditData data);
+
+    void delete(String channelId, String messageId, int delaySeconds);
+
+    User user(String userId);
+
+    @Nullable
+    Member member(Guild guild, String userId);
+
+    static MessageSink jda() {
+        return JdaSink.INSTANCE;
+    }
+
+    final class JdaSink implements MessageSink {
+        static final JdaSink INSTANCE = new JdaSink();
+
+        private static JDA jda() {
+            if (JdaService.jda == null) throw new IllegalStateException("JDA not ready");
+            return JdaService.jda;
+        }
+
+        @Override
+        public MessageChannel channel(String channelId) {
+            MessageChannel ch = jda().getChannelById(MessageChannel.class, channelId);
+            if (ch == null) ch = jda().getThreadChannelById(channelId);
+            if (ch == null) throw new IllegalStateException("unknown channel " + channelId);
+            return ch;
+        }
+
+        @Override
+        public Message fetch(String channelId, String messageId) {
+            try {
+                return channel(channelId).retrieveMessageById(messageId).complete();
+            } catch (Exception e) {
+                return null;
+            }
+        }
+
+        @Override
+        public Message send(String channelId, MessageCreateData data, String ephemeralFor) {
+            var action = channel(channelId).sendMessage(data);
+            if (ephemeralFor != null) action = action.setNonce(EPHEMERAL_NONCE + ephemeralFor);
+            return completeOrQueue(action);
+        }
+
+        @Override
+        public Message edit(String channelId, String messageId, MessageEditData data) {
+            return completeOrQueue(channel(channelId).editMessageById(messageId, data));
+        }
+
+        /**
+         * Synchronous on the answering thread (so the answer's messages exist when it returns); inside a JDA callback
+         * (a handler's queue(success -> ...)) blocking is forbidden, so fall back to queue there.
+         */
+        private static Message completeOrQueue(RestAction<Message> action) {
+            try {
+                return action.complete();
+            } catch (IllegalStateException callbackThread) {
+                action.queue(Consumers.nop(), BotLogger::catchRestError);
+                return null;
+            }
+        }
+
+        @Override
+        public void delete(String channelId, String messageId, int delaySeconds) {
+            var action = channel(channelId).deleteMessageById(messageId);
+            if (delaySeconds > 0) action.queueAfter(delaySeconds, TimeUnit.SECONDS, Consumers.nop(), BotLogger::catchRestError);
+            else action.queue(Consumers.nop(), BotLogger::catchRestError);
+        }
+
+        @Override
+        public User user(String userId) {
+            User u = jda().getUserById(userId);
+            return u != null ? u : jda().retrieveUserById(userId).complete();
+        }
+
+        @Override
+        public Member member(Guild guild, String userId) {
+            Member m = guild.getMemberById(userId);
+            if (m != null) return m;
+            try {
+                return guild.retrieveMemberById(userId).complete();
+            } catch (Exception e) {
+                return null;
+            }
+        }
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/interaction/NativeAction.java b/src/main/java/ti4/selfhost/engine/interaction/NativeAction.java
new file mode 100644
index 0000000..4698c80
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/interaction/NativeAction.java
@@ -0,0 +1,154 @@
+package ti4.selfhost.engine.interaction;
+
+import java.lang.reflect.InvocationHandler;
+import java.lang.reflect.InvocationTargetException;
+import java.lang.reflect.Method;
+import java.lang.reflect.Proxy;
+import java.util.Set;
+import java.util.concurrent.CompletableFuture;
+import java.util.function.Consumer;
+import java.util.function.Function;
+import javax.annotation.Nullable;
+import ti4.discord.JdaService;
+import ti4.logging.BotLogger;
+
+/**
+ * A JDA RestAction-shaped object for an engine answer: builder calls (setContent, setComponents, addFiles, ...) go to a
+ * real JDA message builder; queue/complete/submit run {@code perform} once, synchronously, on the answering thread.
+ * Combinators (map, flatMap, queueAfter, ...) are the interface defaults, which only call queue on this object.
+ *
+ * <p>Used for the interaction-token operations a handler can call on an engine answer (reply, deferEdit, editMessage,
+ * getHook().sendMessage/editOriginal/deleteOriginal, replyModal): there is no token, so each maps onto an
+ * {@link EngineInteraction} op instead.
+ */
+final class NativeAction implements InvocationHandler {
+
+    /** Fluent configuration that has no meaning without Discord; accepted and ignored. */
+    private static final Set<String> IGNORED = Set.of(
+            "setCheck", "addCheck", "timeout", "deadline", "reason", "closeResources", "setUsername", "setAvatarUrl",
+            "createThread", "useComponentsV2", "mentionRepliedUser", "setSuppressedNotifications", "setVoiceMessage");
+
+    private final Class<?> iface;
+    @Nullable
+    private final Object builder;
+    private final Function<NativeAction, Object> perform;
+    boolean ephemeral;
+    private boolean done;
+    private Object result;
+
+    private NativeAction(Class<?> iface, @Nullable Object builder, boolean ephemeral, Function<NativeAction, Object> perform) {
+        this.iface = iface;
+        this.builder = builder;
+        this.ephemeral = ephemeral;
+        this.perform = perform;
+    }
+
+    static <T> T of(Class<T> iface, @Nullable Object builder, boolean ephemeral, Function<NativeAction, Object> perform) {
+        return iface.cast(Proxy.newProxyInstance(
+                NativeAction.class.getClassLoader(),
+                new Class<?>[] {iface},
+                new NativeAction(iface, builder, ephemeral, perform)));
+    }
+
+    @SuppressWarnings("unchecked")
+    <B> B builder() {
+        return (B) builder;
+    }
+
+    private synchronized Object run() {
+        if (!done) {
+            result = perform.apply(this);
+            done = true;
+        }
+        return result;
+    }
+
+    @Override
+    @SuppressWarnings("unchecked")
+    public Object invoke(Object proxy, Method m, Object[] args) throws Throwable {
+        String n = m.getName();
+        Object[] a = args == null ? new Object[0] : args;
+        switch (n) {
+            case "queue" -> {
+                if (a.length == 2) {
+                    Object r;
+                    try {
+                        r = run();
+                    } catch (Throwable t) {
+                        if (a[1] != null) ((Consumer<Throwable>) a[1]).accept(t);
+                        else BotLogger.catchRestError(t);
+                        return null;
+                    }
+                    if (a[0] != null) ((Consumer<Object>) a[0]).accept(r);
+                    return null;
+                }
+            }
+            case "complete" -> {
+                if (a.length == 1 && a[0] instanceof Boolean) return run();
+            }
+            case "submit" -> {
+                if (a.length == 1 && a[0] instanceof Boolean) {
+                    try {
+                        return CompletableFuture.completedFuture(run());
+                    } catch (Throwable t) {
+                        return CompletableFuture.failedFuture(t);
+                    }
+                }
+            }
+            case "getJDA" -> {
+                return JdaService.jda;
+            }
+            case "setEphemeral" -> {
+                ephemeral = (Boolean) a[0];
+                return proxy;
+            }
+            case "isEphemeral" -> {
+                return ephemeral;
+            }
+            case "getCheck" -> {
+                return null;
+            }
+            case "toString" -> {
+                return "EngineAction<" + iface.getSimpleName() + ">";
+            }
+            case "hashCode" -> {
+                return System.identityHashCode(proxy);
+            }
+            case "equals" -> {
+                return proxy == a[0];
+            }
+            default -> {}
+        }
+        if (IGNORED.contains(n) && m.getReturnType().isInstance(proxy)) return proxy;
+        if (builder != null) {
+            Method bm = find(builder.getClass(), m);
+            if (bm != null) {
+                try {
+                    Object r = bm.invoke(builder, a);
+                    return r == builder ? proxy : r;
+                } catch (InvocationTargetException e) {
+                    throw e.getCause();
+                }
+            }
+        }
+        if (m.isDefault()) return InvocationHandler.invokeDefault(proxy, m, args);
+        if (m.getReturnType().isInstance(proxy)) return proxy;
+        throw new UnsupportedOperationException("engine answer: " + iface.getSimpleName() + "." + n + " is not supported");
+    }
+
+    @Nullable
+    private static Method find(Class<?> type, Method m) {
+        try {
+            return type.getMethod(m.getName(), m.getParameterTypes());
+        } catch (NoSuchMethodException e) {
+            for (Method c : type.getMethods()) {
+                if (!c.getName().equals(m.getName()) || c.getParameterCount() != m.getParameterCount()) continue;
+                Class<?>[] want = m.getParameterTypes(), have = c.getParameterTypes();
+                boolean ok = true;
+                for (int i = 0; i < want.length && ok; i++) ok = have[i].isAssignableFrom(want[i]);
+                if (ok) return c;
+            }
+            return null;
+        }
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/interaction/NativeCoverage.java b/src/main/java/ti4/selfhost/engine/interaction/NativeCoverage.java
new file mode 100644
index 0000000..3a27743
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/interaction/NativeCoverage.java
@@ -0,0 +1,493 @@
+package ti4.selfhost.engine.interaction;
+
+import java.lang.annotation.Annotation;
+import java.lang.reflect.Method;
+import java.lang.reflect.Modifier;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.TreeMap;
+import java.util.TreeSet;
+import javassist.ClassPool;
+import javassist.CtClass;
+import javassist.CtMethod;
+import javassist.LoaderClassPath;
+import javassist.bytecode.BootstrapMethodsAttribute;
+import javassist.bytecode.ClassFile;
+import javassist.bytecode.CodeAttribute;
+import javassist.bytecode.CodeIterator;
+import javassist.bytecode.ConstPool;
+import javassist.bytecode.MethodInfo;
+import javassist.bytecode.Opcode;
+import javax.annotation.Nullable;
+import net.dv8tion.jda.api.interactions.InteractionHook;
+import net.dv8tion.jda.api.interactions.components.buttons.ButtonInteraction;
+import net.dv8tion.jda.api.interactions.components.selections.StringSelectInteraction;
+import net.dv8tion.jda.api.interactions.modals.ModalInteraction;
+import net.dv8tion.jda.api.utils.messages.MessageCreateBuilder;
+import net.dv8tion.jda.api.utils.messages.MessageEditBuilder;
+import org.reflections.Reflections;
+import org.reflections.scanners.SubTypesScanner;
+import org.reflections.util.ClasspathHelper;
+import org.reflections.util.ConfigurationBuilder;
+import ti4.discord.interactions.routing.ButtonHandler;
+import ti4.discord.interactions.routing.ModalHandler;
+import ti4.discord.interactions.routing.SelectionHandler;
+import ti4.logging.BotLogger;
+
+/**
+ * Which handlers can run as an engine answer ({@link NativeEvents} view of an {@link EngineInteraction}) instead of a
+ * synthesised Discord click. Static bytecode analysis of every {@code @ButtonHandler} / {@code @SelectionHandler} /
+ * {@code @ModalHandler} method: follow calls into ti4 methods that receive the interaction (an event, an interaction
+ * interface, a listener context or our {@link ti4.selfhost.engine.Interaction}) — including lambdas — and collect every
+ * operation invoked on JDA interaction types (event, callbacks, hook, callback actions). A handler is native when each
+ * of those operations is one the view implements (explicitly or as an interface default built on implemented ones).
+ *
+ * <p>Conservative where it matters: a call into a ti4 method that takes the event is always followed (whatever
+ * branch it is on), and an unknown operation marks the handler non-native. Not followed: dynamic dispatch to
+ * overriding methods in subclasses (handlers are static) and events stashed in fields.
+ */
+public final class NativeCoverage {
+
+    public record HandlerCoverage(
+            String kind, String key, String method, boolean nativeOk, Set<String> uses, Set<String> unsupported) {}
+
+    /**
+     * handlers: routed handler keys; nativeHandlers: runnable as an engine answer; directHandlers: of those, the ones
+     * that use no interaction-token operation at all (only context reads + Interaction ops), i.e. need no JDA-shaped
+     * callback emulation.
+     */
+    public record Report(
+            int handlers,
+            int nativeHandlers,
+            double nativePercent,
+            int directHandlers,
+            double directPercent,
+            Map<String, int[]> byKind,
+            Map<String, Integer> opUsage,
+            Map<String, Integer> unsupportedOps,
+            Set<String> pipelineUnsupported,
+            List<HandlerCoverage> nonNative) {}
+
+    private static volatile Map<String, Map<String, HandlerCoverage>> byKind;
+    private static volatile Report report;
+
+    private NativeCoverage() {}
+
+    /** Coverage of the handler a component id routes to (longest registered prefix), or null if unrouted. */
+    @Nullable
+    public static HandlerCoverage forHandler(String kind, String handlerId) {
+        Map<String, HandlerCoverage> m = ensure().get(kind);
+        if (m == null || handlerId == null) return null;
+        for (int len = handlerId.length(); len >= 0; len--) {
+            HandlerCoverage c = m.get(handlerId.substring(0, len));
+            if (c != null) return c;
+        }
+        return null;
+    }
+
+    /**
+     * Non-blocking: coverage once computed (see {@link #warmUp}), else null. Answers never wait for the analysis;
+     * until it is ready they take the synthetic path.
+     */
+    @Nullable
+    public static HandlerCoverage forHandlerIfReady(String kind, String handlerId) {
+        return byKind == null ? null : forHandler(kind, handlerId);
+    }
+
+    /** Whether this button handler opens a form (replyModal) — known once the analysis ran. */
+    public static boolean opensForm(String handlerId) {
+        HandlerCoverage c = forHandlerIfReady("button", handlerId);
+        return c != null && c.uses().stream().anyMatch(u -> u.endsWith(".replyModal"));
+    }
+
+    /** Runs the analysis on a background thread (engine start). */
+    public static void warmUp() {
+        Thread t = new Thread(
+                () -> {
+                    try {
+                        ensure();
+                    } catch (Throwable e) {
+                        BotLogger.error("engine: native coverage analysis failed", e);
+                    }
+                },
+                "engine-native-coverage");
+        t.setDaemon(true);
+        t.setPriority(Thread.MIN_PRIORITY);
+        t.start();
+    }
+
+    public static Report report() {
+        ensure();
+        return report;
+    }
+
+    private static Map<String, Map<String, HandlerCoverage>> ensure() {
+        if (byKind == null) {
+            synchronized (NativeCoverage.class) {
+                if (byKind == null) compute(NativeCoverage.class.getClassLoader());
+            }
+        }
+        return byKind;
+    }
+
+    // ------------------------------------------------------------------ analysis
+
+    private static final String[] CARRIERS = {
+        "Lnet/dv8tion/jda/api/events/interaction/",
+        "Lnet/dv8tion/jda/api/interactions/",
+        "Lti4/discord/interactions/listeners/context/",
+        "Lti4/selfhost/engine/Interaction;"
+    };
+
+    static synchronized void compute(ClassLoader loader) {
+        long t0 = System.currentTimeMillis();
+        Analyzer an = new Analyzer(loader);
+        Map<String, Map<String, HandlerCoverage>> out = new HashMap<>();
+        List<HandlerCoverage> all = new ArrayList<>();
+        for (Class<?> klass : handlerClasses()) {
+            Method[] methods;
+            try {
+                methods = klass.getDeclaredMethods();
+            } catch (Throwable e) {
+                continue;
+            }
+            for (Method m : methods) {
+                if (!Modifier.isStatic(m.getModifiers())) continue;
+                addAll(out, all, an, klass, m, "button", m.getAnnotationsByType(ButtonHandler.class));
+                addAll(out, all, an, klass, m, "select", m.getAnnotationsByType(SelectionHandler.class));
+                addAll(out, all, an, klass, m, "modal", m.getAnnotationsByType(ModalHandler.class));
+            }
+        }
+        Set<String> pipeline = new TreeSet<>();
+        for (String[] root : new String[][] {
+            {"ti4.discord.interactions.buttons.ButtonProcessor", "processNow"},
+            {"ti4.discord.interactions.selections.SelectionMenuProcessor", "processNow"},
+            {"ti4.discord.interactions.listeners.ModalListener", "processNow"}
+        }) {
+            Set<String>[] r = an.analyzeNamed(root[0], root[1]);
+            if (r != null) pipeline.addAll(r[1]);
+        }
+        Map<String, Integer> usage = new TreeMap<>(), unsupported = new TreeMap<>();
+        Map<String, int[]> kinds = new TreeMap<>();
+        int ok = 0, direct = 0;
+        List<HandlerCoverage> nonNative = new ArrayList<>();
+        all.clear();
+        for (Map<String, HandlerCoverage> m : out.values()) all.addAll(m.values());
+        for (HandlerCoverage c : all) {
+            for (String u : c.uses()) usage.merge(u, 1, Integer::sum);
+            for (String u : c.unsupported()) unsupported.merge(u, 1, Integer::sum);
+            int[] k = kinds.computeIfAbsent(c.kind(), x -> new int[2]);
+            k[0]++;
+            if (c.nativeOk()) {
+                ok++;
+                k[1]++;
+                if (c.uses().stream().noneMatch(NativeCoverage::isTokenOp)) direct++;
+            } else nonNative.add(c);
+        }
+        byKind = out;
+        report = new Report(
+                all.size(),
+                ok,
+                all.isEmpty() ? 0 : Math.round(1000.0 * ok / all.size()) / 10.0,
+                direct,
+                all.isEmpty() ? 0 : Math.round(1000.0 * direct / all.size()) / 10.0,
+                kinds,
+                sortByValue(usage),
+                sortByValue(unsupported),
+                pipeline,
+                nonNative);
+        BotLogger.info("engine: native coverage " + ok + "/" + all.size() + " handlers (" + report.nativePercent()
+                + "%), computed in " + (System.currentTimeMillis() - t0) + " ms");
+    }
+
+    private static <A extends Annotation> void addAll(
+            Map<String, Map<String, HandlerCoverage>> out,
+            List<HandlerCoverage> all,
+            Analyzer an,
+            Class<?> klass,
+            Method m,
+            String kind,
+            A[] anns) {
+        if (anns.length == 0) return;
+        Set<String>[] r = an.analyzeReflect(klass, m);
+        Set<String> uses = r == null ? Set.of() : r[0];
+        Set<String> bad = r == null ? Set.of("(bytecode unavailable)") : r[1];
+        for (A a : anns) {
+            String key =
+                    a instanceof ButtonHandler b ? b.value() : a instanceof SelectionHandler s ? s.value() : ((ModalHandler) a).value();
+            HandlerCoverage c = new HandlerCoverage(
+                    kind, key, klass.getSimpleName() + "#" + m.getName(), bad.isEmpty(), uses, bad);
+            out.computeIfAbsent(kind, k -> new HashMap<>()).put(key, c);
+            all.add(c);
+        }
+    }
+
+    private static List<Class<?>> handlerClasses() {
+        Reflections reflections = new Reflections(new ConfigurationBuilder()
+                .setUrls(ClasspathHelper.forPackage("ti4"))
+                .setScanners(new SubTypesScanner(false)));
+        List<Class<?>> out = new ArrayList<>();
+        for (String name : new TreeSet<>(reflections.getAllTypes())) {
+            if (!name.startsWith("ti4.")) continue;
+            try {
+                out.add(Class.forName(name, false, NativeCoverage.class.getClassLoader()));
+            } catch (Throwable ignored) {
+                // not loadable here
+            }
+        }
+        return out;
+    }
+
+    private static Map<String, Integer> sortByValue(Map<String, Integer> m) {
+        List<Map.Entry<String, Integer>> es = new ArrayList<>(m.entrySet());
+        es.sort((a, b) -> b.getValue() - a.getValue());
+        Map<String, Integer> out = new LinkedHashMap<>();
+        for (Map.Entry<String, Integer> e : es) out.put(e.getKey(), e.getValue());
+        return out;
+    }
+
+    /** Transitive event-operation collector with memoisation. Result: [uses, unsupported]. */
+    private static final class Analyzer {
+        private final ClassPool pool = new ClassPool(false);
+        private final ClassLoader loader;
+        private final Map<String, Set<String>[]> memo = new HashMap<>();
+        private final Set<String> inProgress = new HashSet<>();
+        private final Map<String, Boolean> supportMemo = new HashMap<>();
+
+        Analyzer(ClassLoader loader) {
+            this.loader = loader;
+            pool.appendClassPath(new LoaderClassPath(loader));
+            pool.appendSystemPath();
+        }
+
+        Set<String>[] analyzeReflect(Class<?> klass, Method m) {
+            try {
+                CtClass cc = pool.get(klass.getName());
+                for (CtMethod cm : cc.getDeclaredMethods(m.getName())) {
+                    CtClass[] ps = cm.getParameterTypes();
+                    if (ps.length != m.getParameterCount()) continue;
+                    boolean same = true;
+                    for (int i = 0; i < ps.length && same; i++)
+                        same = ps[i].getName().equals(m.getParameterTypes()[i].getName());
+                    if (same) return analyze(cc, cm.getMethodInfo());
+                }
+            } catch (Exception e) {
+                return null;
+            }
+            return null;
+        }
+
+        Set<String>[] analyzeNamed(String cls, String name) {
+            try {
+                CtClass cc = pool.get(cls);
+                for (CtMethod cm : cc.getDeclaredMethods(name)) return analyze(cc, cm.getMethodInfo());
+            } catch (Exception e) {
+                return null;
+            }
+            return null;
+        }
+
+        @SuppressWarnings("unchecked")
+        Set<String>[] analyze(CtClass cc, MethodInfo mi) {
+            String key = cc.getName() + "." + mi.getName() + mi.getDescriptor();
+            Set<String>[] done = memo.get(key);
+            if (done != null) return done;
+            Set<String>[] r = new Set[] {new TreeSet<String>(), new TreeSet<String>()};
+            if (!inProgress.add(key)) return r; // recursion: the outer frame collects
+            try {
+                CodeAttribute ca = mi.getCodeAttribute();
+                if (ca != null) {
+                    ConstPool cp = mi.getConstPool();
+                    CodeIterator it = ca.iterator();
+                    while (it.hasNext()) {
+                        int pos = it.next();
+                        int op = it.byteAt(pos);
+                        switch (op) {
+                            case Opcode.INVOKEVIRTUAL, Opcode.INVOKESPECIAL, Opcode.INVOKESTATIC, Opcode.INVOKEINTERFACE -> {
+                                int idx = it.u16bitAt(pos + 1);
+                                call(r, cp.getMethodrefClassName(idx), cp.getMethodrefName(idx), cp.getMethodrefType(idx));
+                            }
+                            case Opcode.INVOKEDYNAMIC -> lambda(r, cc, cp, it.u16bitAt(pos + 1));
+                            default -> {}
+                        }
+                    }
+                }
+            } catch (Exception e) {
+                r[1].add("(analysis failed: " + e.getClass().getSimpleName() + ")");
+            } finally {
+                inProgress.remove(key);
+            }
+            memo.put(key, r);
+            return r;
+        }
+
+        private void lambda(Set<String>[] r, CtClass cc, ConstPool cp, int idx) {
+            ClassFile cf = cc.getClassFile2();
+            BootstrapMethodsAttribute bma = (BootstrapMethodsAttribute) cf.getAttribute(BootstrapMethodsAttribute.tag);
+            if (bma == null) return;
+            int bi = cp.getInvokeDynamicBootstrap(idx);
+            for (int arg : bma.getMethods()[bi].arguments) {
+                if (cp.getTag(arg) != ConstPool.CONST_MethodHandle) continue;
+                int ref = cp.getMethodHandleIndex(arg);
+                int tag = cp.getTag(ref);
+                if (tag != ConstPool.CONST_Methodref && tag != ConstPool.CONST_InterfaceMethodref) continue;
+                call(r, cp.getMethodrefClassName(ref), cp.getMethodrefName(ref), cp.getMethodrefType(ref));
+            }
+        }
+
+        private void call(Set<String>[] r, String cls, String name, String desc) {
+            if (cls == null) return;
+            if (isInteractionType(cls)) {
+                String op = cls.substring(cls.lastIndexOf('.') + 1) + "." + name;
+                r[0].add(op);
+                if (!supported(cls, name)) r[1].add(op);
+                return;
+            }
+            if (cls.startsWith("ti4.") && carriesInteraction(desc)) {
+                try {
+                    CtClass target = pool.get(cls);
+                    CtMethod cm = findMethod(target, name, desc);
+                    if (cm == null || cm.getMethodInfo().getCodeAttribute() == null) return;
+                    Set<String>[] sub = analyze(cm.getDeclaringClass(), cm.getMethodInfo());
+                    r[0].addAll(sub[0]);
+                    r[1].addAll(sub[1]);
+                } catch (Exception ignored) {
+                    // constructors / unknown: nothing to follow
+                }
+            }
+        }
+
+        private static CtMethod findMethod(CtClass c, String name, String desc) {
+            try {
+                return c.getMethod(name, desc);
+            } catch (Exception e) {
+                return null;
+            }
+        }
+
+        private static boolean carriesInteraction(String desc) {
+            int close = desc.indexOf(')');
+            String params = close < 0 ? desc : desc.substring(0, close);
+            for (String c : CARRIERS) if (params.contains(c)) return true;
+            return false;
+        }
+
+        private static boolean isInteractionType(String cls) {
+            return cls.startsWith("net.dv8tion.jda.api.events.interaction.")
+                    || cls.startsWith("net.dv8tion.jda.api.interactions.")
+                    || cls.startsWith("net.dv8tion.jda.api.requests.restaction.interactions.")
+                    || cls.startsWith("net.dv8tion.jda.api.requests.restaction.WebhookMessage");
+        }
+
+        /** Mirrors NativeEvents.View / Hook and NativeAction dispatch rules. */
+        private boolean supported(String cls, String name) {
+            return supportMemo.computeIfAbsent(cls + "#" + name, k -> computeSupported(cls, name));
+        }
+
+        private boolean computeSupported(String cls, String name) {
+            Class<?> c;
+            try {
+                c = Class.forName(cls, false, loader);
+            } catch (Throwable e) {
+                return false;
+            }
+            // Event types our view is not (slash commands, autocomplete, entity selects, ...): those code paths are
+            // behind instanceof checks and cannot run for an engine answer.
+            if (cls.startsWith("net.dv8tion.jda.api.events.interaction.")) {
+                boolean ours = c.isAssignableFrom(net.dv8tion.jda.api.events.interaction.component.ButtonInteractionEvent.class)
+                        || c.isAssignableFrom(net.dv8tion.jda.api.events.interaction.component.StringSelectInteractionEvent.class)
+                        || c.isAssignableFrom(net.dv8tion.jda.api.events.interaction.ModalInteractionEvent.class);
+                if (!ours) return true;
+                if (VIEW_EVENT_ONLY.contains(name)) return true;
+                return viewSupports(name);
+            }
+            if (InteractionHook.class.isAssignableFrom(c) || c == net.dv8tion.jda.api.entities.WebhookClient.class)
+                return HOOK_OPS.contains(name) || isDefault(c, name) || isDefault(InteractionHook.class, name);
+            if (c.isInterface() && (c.isAssignableFrom(ButtonInteraction.class)
+                    || c.isAssignableFrom(StringSelectInteraction.class)
+                    || c.isAssignableFrom(ModalInteraction.class))) return viewSupports(name);
+            if (c.isInterface() && cls.startsWith("net.dv8tion.jda.api.interactions.")) return true; // other interaction kinds
+            // slash-command payloads (behind instanceof checks; never our event)
+            if (cls.startsWith("net.dv8tion.jda.api.interactions.commands.")) return true;
+            // modal values are real JDA ModalMappings built from the engine's inputs (no resolved entities)
+            if (cls.equals("net.dv8tion.jda.api.interactions.modals.ModalMapping")) return !name.equals("getAsMentions");
+            // callback / webhook actions → NativeAction
+            if (ACTION_OPS.contains(name)) return true;
+            Class<?> builder = name.startsWith("set") || name.startsWith("add") || name.startsWith("get")
+                    ? (cls.contains("Edit") ? MessageEditBuilder.class : MessageCreateBuilder.class)
+                    : MessageCreateBuilder.class;
+            for (Method m : builder.getMethods()) if (m.getName().equals(name)) return true;
+            for (Method m : c.getMethods()) {
+                if (!m.getName().equals(name)) continue;
+                if (m.isDefault() || m.getReturnType().isAssignableFrom(c)) return true;
+            }
+            return false;
+        }
+
+        private static boolean viewSupports(String name) {
+            if (VIEW_OPS.contains(name)) return true;
+            return isDefault(ButtonInteraction.class, name)
+                    || isDefault(StringSelectInteraction.class, name)
+                    || isDefault(ModalInteraction.class, name);
+        }
+
+        private static boolean isDefault(Class<?> c, String name) {
+            for (Method m : c.getMethods()) if (m.getName().equals(name) && m.isDefault()) return true;
+            return false;
+        }
+    }
+
+    /** Implemented explicitly by NativeEvents.View. */
+    static final Set<String> VIEW_OPS = Set.of(
+            "getJDA", "getIdLong", "getId", "getTypeRaw", "getType", "getToken", "getGuild", "getUser", "getMember",
+            "isAcknowledged", "getChannel", "getMessageChannel", "getGuildChannel", "getChannelIdLong", "getChannelId",
+            "getUserLocale", "getGuildLocale", "getEntitlements", "getContext", "getIntegrationOwners",
+            "getComponentId", "getCustomId", "getModalId", "getComponent", "getButton", "getSelectMenu",
+            "getComponentType", "getMessage", "getMessageIdLong", "getMessageId", "getValues", "getHook",
+            "deferEdit", "deferReply", "replyModal", "reply", "editMessage", "getInteraction", "getTimeCreated",
+            "isFromGuild", "getChannelType", "getUniqueId");
+
+    /** GenericEvent / GenericInteractionCreateEvent methods that need no interaction. */
+    static final Set<String> VIEW_EVENT_ONLY =
+            Set.of("getResponseNumber", "getRawData", "getInteraction", "getJDA", "<init>", "getClass");
+
+    static final Set<String> HOOK_OPS = Set.of(
+            "getJDA", "getInteraction", "getToken", "getIdLong", "getId", "getExpirationTimestamp", "hasCallbackResponse",
+            "getCallbackResponse", "setEphemeral", "sendMessage", "sendMessageEmbeds", "sendMessageComponents",
+            "sendFiles", "editMessageById", "editMessageEmbedsById", "editMessageComponentsById",
+            "editMessageAttachmentsById", "deleteMessageById", "retrieveMessageById", "isExpired");
+
+    static final Set<String> ACTION_OPS = Set.of(
+            "queue", "complete", "submit", "getJDA", "setEphemeral", "isEphemeral", "setCheck", "addCheck", "timeout",
+            "deadline", "reason", "closeResources", "setUsername", "setAvatarUrl", "createThread", "useComponentsV2",
+            "mentionRepliedUser", "setSuppressedNotifications", "setVoiceMessage", "getCheck", "queueAfter",
+            "submitAfter", "completeAfter", "map", "flatMap", "onSuccess", "onErrorMap", "onErrorFlatMap", "delay",
+            "and", "zip", "mapToResult", "applyData");
+
+    private static final Set<String> TOKEN_METHODS = Set.of(
+            "getHook", "reply", "replyEmbeds", "replyComponents", "replyFiles", "replyFormat", "replyPoll", "deferEdit",
+            "deferReply", "editMessage", "editComponents", "editButton", "editSelectMenu", "editMessageEmbeds",
+            "editMessageFormat", "editMessageAttachments", "replyModal");
+
+    /** Operations that need the interaction token on Discord (emulated by the JDA view for engine answers). */
+    static boolean isTokenOp(String op) {
+        int dot = op.indexOf('.');
+        String owner = op.substring(0, dot), name = op.substring(dot + 1);
+        return owner.equals("InteractionHook")
+                || owner.startsWith("WebhookMessage")
+                || owner.endsWith("CallbackAction")
+                || TOKEN_METHODS.contains(name);
+    }
+
+    static List<HandlerCoverage> sorted(List<HandlerCoverage> l) {
+        List<HandlerCoverage> out = new ArrayList<>(l);
+        out.sort((a, b) -> a.key().compareTo(b.key()));
+        return Collections.unmodifiableList(out);
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/interaction/NativeEvents.java b/src/main/java/ti4/selfhost/engine/interaction/NativeEvents.java
new file mode 100644
index 0000000..7d525d1
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/interaction/NativeEvents.java
@@ -0,0 +1,353 @@
+package ti4.selfhost.engine.interaction;
+
+import java.lang.reflect.InvocationHandler;
+import java.lang.reflect.InvocationTargetException;
+import java.lang.reflect.Method;
+import java.lang.reflect.Proxy;
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.List;
+import java.util.Map;
+import javax.annotation.Nullable;
+import net.dv8tion.jda.api.components.Component;
+import net.dv8tion.jda.api.components.MessageTopLevelComponent;
+import net.dv8tion.jda.api.components.selections.StringSelectMenu;
+import net.dv8tion.jda.api.entities.MessageEmbed;
+import net.dv8tion.jda.api.events.interaction.GenericInteractionCreateEvent;
+import net.dv8tion.jda.api.events.interaction.ModalInteractionEvent;
+import net.dv8tion.jda.api.events.interaction.component.ButtonInteractionEvent;
+import net.dv8tion.jda.api.events.interaction.component.StringSelectInteractionEvent;
+import net.dv8tion.jda.api.interactions.DiscordLocale;
+import net.dv8tion.jda.api.interactions.InteractionContextType;
+import net.dv8tion.jda.api.interactions.InteractionHook;
+import net.dv8tion.jda.api.interactions.components.buttons.ButtonInteraction;
+import net.dv8tion.jda.api.interactions.components.selections.StringSelectInteraction;
+import net.dv8tion.jda.api.interactions.modals.ModalInteraction;
+import net.dv8tion.jda.api.interactions.modals.ModalMapping;
+import net.dv8tion.jda.api.modals.Modal;
+import net.dv8tion.jda.api.requests.restaction.WebhookMessageCreateAction;
+import net.dv8tion.jda.api.requests.restaction.WebhookMessageDeleteAction;
+import net.dv8tion.jda.api.requests.restaction.WebhookMessageEditAction;
+import net.dv8tion.jda.api.requests.restaction.WebhookMessageRetrieveAction;
+import net.dv8tion.jda.api.requests.restaction.interactions.MessageEditCallbackAction;
+import net.dv8tion.jda.api.requests.restaction.interactions.ModalCallbackAction;
+import net.dv8tion.jda.api.requests.restaction.interactions.ReplyCallbackAction;
+import net.dv8tion.jda.api.utils.AttachedFile;
+import net.dv8tion.jda.api.utils.FileUpload;
+import net.dv8tion.jda.api.utils.data.DataObject;
+import net.dv8tion.jda.api.utils.messages.MessageCreateBuilder;
+import net.dv8tion.jda.api.utils.messages.MessageCreateData;
+import net.dv8tion.jda.api.utils.messages.MessageEditBuilder;
+import net.dv8tion.jda.api.utils.messages.MessageEditData;
+import ti4.discord.JdaService;
+
+/**
+ * JDA-shaped view of an {@link EngineInteraction}, so unmodified handlers (which take {@code ButtonInteractionEvent}
+ * etc.) run for an engine answer. The JDA event classes are public API with public constructors taking an interaction
+ * <em>interface</em>; we pass a {@link Proxy} of that interface whose methods map onto the EngineInteraction:
+ *
+ * <ul>
+ *   <li>identity / context (user, member, guild, channel, message, component, values) — read from the engine;
+ *   <li>token operations (reply, deferEdit, editMessage, getHook().sendMessage / editOriginal / deleteOriginal,
+ *       replyModal) — {@link NativeAction}s that call EngineInteraction ops;
+ *   <li>everything else — the interface's default method, which is built on the above.
+ * </ul>
+ *
+ * Nothing here touches JDA internals ({@code JDAImpl}, {@code *InteractionImpl}) or needs the shim to mint a payload.
+ * {@link NativeCoverage} statically checks which handlers only use what this view supports.
+ */
+public final class NativeEvents {
+    private NativeEvents() {}
+
+    public static ButtonInteractionEvent button(EngineInteraction ix) {
+        return new ButtonInteractionEvent(JdaService.jda, -1, view(ButtonInteraction.class, ix));
+    }
+
+    public static StringSelectInteractionEvent select(EngineInteraction ix) {
+        return new StringSelectInteractionEvent(JdaService.jda, -1, view(StringSelectInteraction.class, ix));
+    }
+
+    public static ModalInteractionEvent modal(EngineInteraction ix) {
+        return new ModalInteractionEvent(JdaService.jda, -1, view(ModalInteraction.class, ix));
+    }
+
+    /** The EngineInteraction behind an event (or interaction) if it is an engine answer, else null. */
+    @Nullable
+    public static EngineInteraction engineInteraction(@Nullable Object eventOrInteraction) {
+        Object i = eventOrInteraction instanceof GenericInteractionCreateEvent e ? e.getInteraction() : eventOrInteraction;
+        if (i != null && Proxy.isProxyClass(i.getClass()) && Proxy.getInvocationHandler(i) instanceof View v) return v.ix;
+        return null;
+    }
+
+    static <T> T view(Class<T> iface, EngineInteraction ix) {
+        View v = new View(ix);
+        T proxy = iface.cast(Proxy.newProxyInstance(NativeEvents.class.getClassLoader(), new Class<?>[] {iface}, v));
+        v.self = proxy;
+        return proxy;
+    }
+
+    // ------------------------------------------------------------------ the interaction
+
+    private static final class View implements InvocationHandler {
+        final EngineInteraction ix;
+        Object self;
+        InteractionHook hook;
+
+        View(EngineInteraction ix) {
+            this.ix = ix;
+        }
+
+        @Override
+        public Object invoke(Object proxy, Method m, Object[] args) throws Throwable {
+            Object[] a = args == null ? new Object[0] : args;
+            switch (m.getName()) {
+                case "getJDA":
+                    return JdaService.jda;
+                case "getIdLong":
+                    return ix.getId();
+                case "getTypeRaw":
+                    return ix.getType() == EngineInteraction.Type.MODAL ? 5 : 3;
+                case "getToken":
+                    return "engine-" + ix.getId();
+                case "getGuild":
+                    return ix.guild();
+                case "getUser":
+                    return ix.user();
+                case "getMember":
+                    return ix.member();
+                case "isAcknowledged":
+                    return true; // ButtonListener acknowledges (deferEdit) before any handler runs
+                case "getChannel":
+                    return ix.channel();
+                case "getChannelIdLong":
+                    return Long.parseUnsignedLong(ix.channelId());
+                case "getUserLocale":
+                case "getGuildLocale":
+                    return DiscordLocale.ENGLISH_US;
+                case "getEntitlements":
+                    return List.of();
+                case "getContext":
+                    return InteractionContextType.GUILD;
+                case "getIntegrationOwners":
+                    return null;
+                case "getComponentId":
+                case "getCustomId":
+                case "getModalId":
+                    return ix.componentId();
+                case "getComponent":
+                case "getButton":
+                case "getSelectMenu":
+                    return ix.component();
+                case "getComponentType":
+                    return ix.getType() == EngineInteraction.Type.SELECT
+                            ? Component.Type.STRING_SELECT
+                            : Component.Type.BUTTON;
+                case "getMessage":
+                    return ix.message();
+                case "getMessageIdLong":
+                    return ix.messageId() == null ? 0L : Long.parseUnsignedLong(ix.messageId());
+                case "getValues":
+                    return ix.getType() == EngineInteraction.Type.MODAL ? modalMappings(ix) : ix.getValues();
+                case "getHook":
+                    return hook();
+                case "deferEdit":
+                    return editAction(new MessageEditBuilder());
+                case "deferReply":
+                    return replyAction(new MessageCreateBuilder(), a.length == 1 && (Boolean) a[0]);
+                case "replyModal":
+                    ix.openModal((Modal) a[0]);
+                    return NativeAction.of(ModalCallbackAction.class, null, false, act -> null);
+                case "reply":
+                    if (a.length == 1 && a[0] instanceof MessageCreateData d)
+                        return replyAction(new MessageCreateBuilder().applyData(d), false);
+                    break;
+                case "editMessage":
+                    if (a.length == 1 && a[0] instanceof MessageEditData d)
+                        return editAction(new MessageEditBuilder().applyData(d));
+                    break;
+                case "toString":
+                    return "EngineInteraction[" + ix.componentId() + " by " + ix.userId() + "]";
+                case "hashCode":
+                    return System.identityHashCode(proxy);
+                case "equals":
+                    return proxy == a[0];
+                default:
+                    break;
+            }
+            if (m.isDefault()) {
+                try {
+                    return InvocationHandler.invokeDefault(proxy, m, args);
+                } catch (InvocationTargetException e) {
+                    throw e.getCause();
+                }
+            }
+            throw new UnsupportedOperationException("engine answer: " + m.getDeclaringClass().getSimpleName() + "."
+                    + m.getName() + " is not supported");
+        }
+
+        private ReplyCallbackAction replyAction(MessageCreateBuilder b, boolean ephemeral) {
+            return NativeAction.of(ReplyCallbackAction.class, b, ephemeral, act -> {
+                if (!b.isEmpty()) ix.send(b.build(), act.ephemeral);
+                return hook();
+            });
+        }
+
+        private MessageEditCallbackAction editAction(MessageEditBuilder b) {
+            return NativeAction.of(MessageEditCallbackAction.class, b, false, act -> {
+                if (!b.isEmpty() && ix.messageId() != null) ix.edit(ix.messageId(), b.build());
+                else ix.deferEdit();
+                return hook();
+            });
+        }
+
+        synchronized InteractionHook hook() {
+            if (hook == null) hook = (InteractionHook) Proxy.newProxyInstance(
+                    NativeEvents.class.getClassLoader(), new Class<?>[] {InteractionHook.class}, new Hook(this));
+            return hook;
+        }
+    }
+
+    // ------------------------------------------------------------------ the interaction hook (webhook followups)
+
+    private static final class Hook implements InvocationHandler {
+        final View view;
+        boolean ephemeral;
+
+        Hook(View view) {
+            this.view = view;
+        }
+
+        private String target(String id) {
+            return "@original".equals(id) ? view.ix.messageId() : id;
+        }
+
+        @Override
+        @SuppressWarnings("unchecked")
+        public Object invoke(Object proxy, Method m, Object[] args) throws Throwable {
+            Object[] a = args == null ? new Object[0] : args;
+            EngineInteraction ix = view.ix;
+            switch (m.getName()) {
+                case "getJDA":
+                    return JdaService.jda;
+                case "getInteraction":
+                    return view.self;
+                case "getToken":
+                    return "engine-" + ix.getId();
+                case "getIdLong":
+                    return JdaService.jda == null ? 0L : JdaService.jda.getSelfUser().getIdLong();
+                case "getExpirationTimestamp":
+                    return System.currentTimeMillis() + 15 * 60 * 1000L;
+                case "hasCallbackResponse":
+                    return false;
+                case "getCallbackResponse":
+                    return null;
+                case "setEphemeral":
+                    ephemeral = (Boolean) a[0];
+                    return proxy;
+                case "sendMessage":
+                case "sendMessageEmbeds":
+                case "sendMessageComponents":
+                case "sendFiles":
+                case "sendMessagePoll":
+                    if (a.length == 1 && !m.isDefault()) return send(m.getName(), a[0]);
+                    break;
+                case "editMessageById":
+                case "editMessageEmbedsById":
+                case "editMessageComponentsById":
+                case "editMessageAttachmentsById":
+                    if (a.length == 2 && !m.isDefault()) return edit(m.getName(), (String) a[0], a[1]);
+                    break;
+                case "deleteMessageById":
+                    if (a.length == 1 && a[0] instanceof String id) {
+                        String t = target(id);
+                        return NativeAction.of(WebhookMessageDeleteAction.class, null, false, act -> {
+                            if (t != null) ix.delete(t, 0);
+                            return null;
+                        });
+                    }
+                    break;
+                case "retrieveMessageById":
+                    if (a.length == 1 && a[0] instanceof String id) {
+                        String t = target(id);
+                        return NativeAction.of(WebhookMessageRetrieveAction.class, null, false, act -> t == null ? null : ix.fetch(t));
+                    }
+                    break;
+                case "toString":
+                    return "EngineHook[" + ix.componentId() + "]";
+                case "hashCode":
+                    return System.identityHashCode(proxy);
+                case "equals":
+                    return proxy == a[0];
+                default:
+                    break;
+            }
+            if (m.isDefault()) {
+                try {
+                    return InvocationHandler.invokeDefault(proxy, m, args);
+                } catch (InvocationTargetException e) {
+                    throw e.getCause();
+                }
+            }
+            throw new UnsupportedOperationException("engine answer: InteractionHook." + m.getName() + " is not supported");
+        }
+
+        @SuppressWarnings("unchecked")
+        private Object send(String how, Object arg) {
+            MessageCreateBuilder b = new MessageCreateBuilder();
+            switch (how) {
+                case "sendMessage" -> {
+                    if (arg instanceof MessageCreateData d) b.applyData(d);
+                    else b.setContent(String.valueOf(arg));
+                }
+                case "sendMessageEmbeds" -> b.setEmbeds((Collection<? extends MessageEmbed>) arg);
+                case "sendMessageComponents" -> b.setComponents((Collection<? extends MessageTopLevelComponent>) arg);
+                case "sendFiles" -> b.setFiles((Collection<? extends FileUpload>) arg);
+                default -> throw new UnsupportedOperationException("engine answer: InteractionHook." + how);
+            }
+            return NativeAction.of(WebhookMessageCreateAction.class, b, ephemeral, act -> view.ix.send(b.build(), act.ephemeral));
+        }
+
+        @SuppressWarnings("unchecked")
+        private Object edit(String how, String id, Object arg) {
+            MessageEditBuilder b = new MessageEditBuilder();
+            switch (how) {
+                case "editMessageById" -> {
+                    if (arg instanceof MessageEditData d) b.applyData(d);
+                    else b.setContent(String.valueOf(arg));
+                }
+                case "editMessageEmbedsById" -> b.setEmbeds((Collection<? extends MessageEmbed>) arg);
+                case "editMessageComponentsById" -> b.setComponents((Collection<? extends MessageTopLevelComponent>) arg);
+                case "editMessageAttachmentsById" -> b.setAttachments((Collection<? extends AttachedFile>) arg);
+                default -> throw new UnsupportedOperationException("engine answer: InteractionHook." + how);
+            }
+            String t = target(id);
+            return NativeAction.of(WebhookMessageEditAction.class, b, false, act -> t == null ? null : view.ix.edit(t, b.build()));
+        }
+    }
+
+    // ------------------------------------------------------------------ modal values
+
+    /** Field values of a native modal submit as JDA ModalMappings (text inputs and string selects). */
+    private static List<ModalMapping> modalMappings(EngineInteraction ix) {
+        List<ModalMapping> out = new ArrayList<>();
+        Modal modal = ix.getOpenedModal();
+        Map<String, String> inputs = ix.getInputs();
+        int uid = 1;
+        for (Map.Entry<String, String> e : inputs.entrySet()) {
+            boolean select = modal != null
+                    && modal.getComponentTree().findAll(StringSelectMenu.class).stream()
+                            .anyMatch(s -> e.getKey().equals(s.getCustomId()));
+            DataObject d = DataObject.empty().put("id", uid++).put("custom_id", e.getKey());
+            if (select) {
+                d.put("type", Component.Type.STRING_SELECT.getKey())
+                        .put("values", net.dv8tion.jda.api.utils.data.DataArray.fromCollection(
+                                List.of(e.getValue().split("\n"))));
+            } else {
+                d.put("type", Component.Type.TEXT_INPUT.getKey()).put("value", e.getValue());
+            }
+            out.add(new ModalMapping(null, DataObject.empty(), d)); // (interaction, resolved, component)
+        }
+        return out;
+    }
+
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/ActionCardDiscardKind.java b/src/main/java/ti4/selfhost/engine/kinds/ActionCardDiscardKind.java
new file mode 100644
index 0000000..e258253
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/ActionCardDiscardKind.java
@@ -0,0 +1,100 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.helpers.ButtonHelper;
+import ti4.selfhost.engine.EngineModels.Decision;
+import ti4.selfhost.engine.EngineModels.Option;
+import ti4.selfhost.engine.EngineModels.Progress;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * Discard an action card: ac_discard_from_hand_&lt;handle&gt;[stall|redraw|retain|arvaxicommander]
+ * (ActionCardHelper.getDiscardActionCardButtonsWithSuffix, posted in the cards-info thread).
+ *
+ * <p>Value: {handle, actionCard, mode, overLimit, handLimit, reason}. mode is the suffix ("" plain, "stall" = discard
+ * as your action, "redraw" = draw a replacement, "retain" = keep the other buttons). overLimit / handLimit are as
+ * of capture; compare handLimit with the live PlayerState.actionCardCount to know whether a discard is still owed.
+ * reason: "scheming" for the Yssaril Scheming discard (a required discard that is not about the hand limit), else
+ * "hand" (hand limit or any other discard request).
+ *
+ * <p>progress (dynamic, from the live hand): {flow: "discard_action_cards", step: "choose", accumulated: {handSize},
+ * required: {handLimit, overLimit}, canCommit: overLimit == 0}; overLimit &gt; 0 = that many discards still owed.
+ */
+public class ActionCardDiscardKind implements KindSpec {
+    static final String PREFIX = "ac_discard_from_hand_";
+    private static final Pattern ID = Pattern.compile("ac_discard_from_hand_(\\d+)(stall|redraw|retain|arvaxicommander)?");
+
+    @Override
+    public String kind() {
+        return "action_card.discard";
+    }
+
+    @Override
+    public int priority() {
+        return 80;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return handlerId.startsWith(PREFIX);
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        Matcher m = ID.matcher(handlerId);
+        if (!m.matches()) return null;
+        int handle = Integer.parseInt(m.group(1));
+        Player p = ctx.player() != null ? ctx.player() : CardKinds.holderOfHandle(ctx.game(), handle);
+        String ac = CardKinds.acIdForHandle(p, handle);
+        if (ac == null) return null;
+        Map<String, Object> v = new LinkedHashMap<>();
+        v.put("handle", handle);
+        v.put("actionCard", ac);
+        v.put("mode", m.group(2) == null ? "" : m.group(2));
+        limits(ctx.game(), p, v);
+        // The one discard prompt the engine words differently (ActionCardHelper.sendSchemingDiscardButtons).
+        String content = ctx.content() == null ? "" : ctx.content();
+        v.put("reason", p.hasAbility("scheming") && content.contains("**Scheming**") ? "scheming" : "hand");
+        return v;
+    }
+
+    private static void limits(Game game, Player p, Map<String, Object> v) {
+        v.put("overLimit", ButtonHelper.isPlayerOverLimit(game, p));
+        v.put("handLimit", ButtonHelper.getACLimit(game, p));
+    }
+
+    @Override
+    public boolean dynamic() {
+        return true;
+    }
+
+    @Override
+    public Progress progress(CaptureContext ctx) {
+        Player p = ctx.player();
+        if (p == null) return null;
+        int limit = ButtonHelper.getACLimit(ctx.game(), p);
+        int size = p.getActionCards().size();
+        int over = p.hasAbility("crafty") ? 0 : Math.max(0, size - limit);
+        return new Progress(
+                "discard_action_cards",
+                "choose",
+                Map.of("handSize", size),
+                Map.of("handLimit", limit, "overLimit", over),
+                over == 0);
+    }
+
+    @Override
+    public String validate(Game game, Player answering, Decision decision, String optionId) {
+        for (Option o : decision.options()) {
+            if (!o.id().equals(optionId) || o.value() == null) continue;
+            if (o.value().get("handle") instanceof Integer h && !answering.getActionCards().containsValue(h))
+                return "That action card is no longer in your hand.";
+        }
+        return null;
+    }
+}
