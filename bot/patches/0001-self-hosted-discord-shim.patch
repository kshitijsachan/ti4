@@ -0,0 +1,59 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+import ti4.selfhost.engine.EngineModels.Target;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * Choose a planet (and trait) to explore: FFCC_&lt;f&gt;_movedNExplored_[skipKairnAgent_]&lt;via&gt;_&lt;planet&gt;_&lt;trait&gt;[kolleccbt]
+ * (ButtonHelper.getPlanetExplorationButtons). Landing on several planets posts one such message per planet, so the
+ * player picks the order by answering them in any order; "choose any of your planets" prompts (A New Edifice, Dark
+ * Visions, agents, Secret Maps, Migrant Explorers, Lanefir flagship) list several planets in one message.
+ *
+ * <p>value: {planet, planetName, tile, trait, via ("filler" | "dsdihmy" Impressment | "scanlink"), frontierInstead
+ * (Bentor breakthrough: explore the frontier deck instead), fromDiscard (Kollecc breakthrough)}.
+ */
+public class ExplorePlanetKind implements KindSpec {
+
+    static final String PREFIX = "movedNExplored_";
+
+    @Override
+    public String kind() {
+        return "explore.planet";
+    }
+
+    @Override
+    public int priority() {
+        return 100;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return handlerId.startsWith(PREFIX);
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        if (!matches(handlerId)) return null;
+        String rest = handlerId.substring(PREFIX.length());
+        if (rest.startsWith("skipKairnAgent_")) rest = rest.substring("skipKairnAgent_".length());
+        String[] info = rest.split("_");
+        if (info.length < 3) return null;
+        String trait = info[2];
+        boolean fromDiscard = trait.endsWith("kolleccbt");
+        if (fromDiscard) trait = trait.substring(0, trait.length() - "kolleccbt".length());
+        Map<String, Object> v = new LinkedHashMap<>();
+        ExploreSupport.putPlanet(v, ctx.game(), info[1]);
+        v.put("trait", trait);
+        v.put("via", info[0]);
+        v.put("frontierInstead", "frontier".equals(trait));
+        v.put("fromDiscard", fromDiscard);
+        return v;
+    }
+
+    @Override
+    public Target target(CaptureContext ctx, Target resolved) {
+        return ExploreSupport.explorer(ctx, resolved);
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/ExploreSupport.java b/src/main/java/ti4/selfhost/engine/kinds/ExploreSupport.java
new file mode 100644
index 0000000..941d0a5
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/ExploreSupport.java
@@ -0,0 +1,123 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+import java.util.Set;
+import javax.annotation.Nullable;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.game.Tile;
+import ti4.image.Mapper;
+import ti4.model.ExploreModel;
+import ti4.model.PlanetModel;
+import ti4.model.RelicModel;
+import ti4.selfhost.engine.EngineModels.Target;
+import ti4.selfhost.engine.InteractionTracker;
+import ti4.selfhost.engine.KindSpec.CaptureContext;
+
+/** Shared helpers for the exploration / relic kinds (G9). Not a kind itself. */
+final class ExploreSupport {
+    private ExploreSupport() {}
+
+    private static final Set<String> CERTAIN =
+            Set.of("owner_prefix", "spoof_prefix", "interaction_user", "cards_thread", "private_channel");
+
+    /**
+     * Explore follow-ups are mostly plain channel posts with unowned ids ("gain_1_comms", "resolveLocalFab_x"),
+     * sometimes without a mention. The explorer is: the certain/mention target if any, else whoever pressed a button
+     * in this channel a moment ago (the press that led here), else the active player.
+     */
+    static Target explorer(CaptureContext ctx, @Nullable Target resolved) {
+        if (resolved != null && resolved.userId() != null && (CERTAIN.contains(resolved.resolvedBy())
+                || "mention".equals(resolved.resolvedBy()))) {
+            return resolved;
+        }
+        Game game = ctx.game();
+        InteractionTracker.Info press = InteractionTracker.latestInChannel(ctx.channelId(), 20_000);
+        if (press != null) {
+            Player p = game.getPlayer(press.userId());
+            if (p != null && p.isRealPlayer()) return target(p, "recent_press");
+        }
+        Player active = game.getActivePlayer();
+        if (active != null) return target(active, "active_player");
+        return resolved;
+    }
+
+    static Target target(Player p, String how) {
+        return new Target(p.getUserID(), p.getFaction(), p.getColor(), how);
+    }
+
+    /** Planet id + its tile position and display name (ids for logic, name only for display). */
+    static void putPlanet(Map<String, Object> v, Game game, @Nullable String planet) {
+        if (planet == null || planet.isBlank() || "null".equals(planet)) {
+            v.put("planet", null);
+            return;
+        }
+        v.put("planet", planet);
+        PlanetModel pm = Mapper.getPlanet(planet);
+        v.put("planetName", pm == null ? planet : pm.getName());
+        if (!v.containsKey("tile")) {
+            Tile t = game.getTileFromPlanet(planet);
+            v.put("tile", t == null ? null : t.getPosition());
+        }
+    }
+
+    /** Card id plus the model facts a UI needs to show it (name/type/resolution/text from the card data). */
+    static Map<String, Object> card(@Nullable String cardId) {
+        Map<String, Object> c = new LinkedHashMap<>();
+        if (cardId == null) return c;
+        String id = cardId.replace("extra1", "").replace("extra2", "");
+        c.put("card", id);
+        ExploreModel m = Mapper.getExplore(id);
+        if (m != null) {
+            c.put("cardName", m.getName());
+            c.put("cardType", m.getType() == null ? null : m.getType().toLowerCase());
+            c.put("resolution", m.getResolution() == null ? null : m.getResolution().toLowerCase());
+            c.put("cardText", m.getText());
+        }
+        return c;
+    }
+
+    static Map<String, Object> relic(@Nullable String relicId) {
+        Map<String, Object> c = new LinkedHashMap<>();
+        if (relicId == null) return c;
+        c.put("relic", relicId);
+        RelicModel m = Mapper.getRelic(relicId);
+        if (m != null) {
+            c.put("relicName", m.getName());
+            c.put("relicText", m.getText());
+        }
+        return c;
+    }
+
+    /** "CRF" → cultural etc. (ids used by purge_Frags_). */
+    static String fragTrait(String code) {
+        return switch (code.toUpperCase()) {
+            case "CRF" -> "cultural";
+            case "IRF" -> "industrial";
+            case "HRF" -> "hazardous";
+            case "URF" -> "frontier";
+            default -> null;
+        };
+    }
+
+    /** Normal (non-supermassive) fragment counts by trait. */
+    static Map<String, Object> fragmentCounts(Player p) {
+        Map<String, Object> m = new LinkedHashMap<>();
+        int c = 0, i = 0, h = 0, u = 0;
+        if (p != null) {
+            for (String f : p.getFragments()) {
+                if (f.startsWith("supermassive")) continue;
+                if (f.startsWith("crf")) c++;
+                else if (f.startsWith("irf")) i++;
+                else if (f.startsWith("hrf")) h++;
+                else if (f.startsWith("urf")) u++;
+            }
+        }
+        m.put("cultural", c);
+        m.put("industrial", i);
+        m.put("hazardous", h);
+        m.put("frontier", u);
+        return m;
+    }
+}
