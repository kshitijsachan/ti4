@@ -0,0 +1,125 @@
+package ti4.selfhost.engine;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+import static org.mockito.Mockito.RETURNS_DEEP_STUBS;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+
+import java.lang.reflect.Method;
+import java.util.List;
+import net.dv8tion.jda.api.events.interaction.component.ButtonInteractionEvent;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import ti4.discord.interactions.buttons.handlers.commandcounter.CommandCounterButtonHandler;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.helpers.ButtonHelperSCs;
+import ti4.helpers.thundersedge.TeHelperActionCards;
+import ti4.service.milty.MiltyDraftManager;
+import ti4.testUtils.BaseTi4Test;
+
+/** Regressions for the web fuzzer's findings (run/fuzz/VIOLATIONS.md, 2026-10-11). */
+class FuzzFixesTest extends BaseTi4Test {
+
+    private Game game;
+    private Player red;
+    private ButtonInteractionEvent event;
+
+    @BeforeEach
+    void setUp() {
+        game = new Game();
+        game.setName("fuzzfix");
+        red = game.addPlayer("red-user", "mentak");
+        red.setFaction("mentak");
+        red.setColor("red");
+        Player blue = game.addPlayer("blue-user", "jolnar");
+        blue.setFaction("jolnar");
+        blue.setColor("blue");
+        event = mock(ButtonInteractionEvent.class, RETURNS_DEEP_STUBS);
+        when(event.getMessageChannel().getName()).thenReturn("fuzzfix-actions");
+    }
+
+    // ---- 1. Leadership primary once per play; gains capped by reinforcements
+
+    @Test
+    void leadershipPrimaryIsRecognisedOnlyForThePlayedCardInTheActionPhase() {
+        red.addSC(1);
+        game.setPhaseOfGame("action");
+        assertEquals(-1, ButtonHelperSCs.playedLeadershipHeldBy(game, red), "not played yet");
+        game.setSCPlayed(1, true);
+        assertEquals(1, ButtonHelperSCs.playedLeadershipHeldBy(game, red));
+        game.setPhaseOfGame("agenda"); // Crisis: another Leadership primary, never refused
+        assertEquals(-1, ButtonHelperSCs.playedLeadershipHeldBy(game, red));
+    }
+
+    @Test
+    void leadershipPrimaryRefusedWhenAlreadyResolved() {
+        red.addSC(1);
+        game.setSCPlayed(1, true);
+        game.setPhaseOfGame("action");
+        ButtonHelperSCs.recordPrimaryDone(game, 1, "tokens");
+        assertEquals(List.of("tokens"), ButtonHelperSCs.primaryDone(game, 1));
+        ButtonHelperSCs.leadershipButtons(event, game, red, "leadershipGenerateCCButtons");
+        // refused before the gain panel: the panel's starting pools were never stored
+        assertTrue(game.getStoredValue("originalCCsFor" + red.getFaction()).isEmpty());
+    }
+
+    @Test
+    void commandTokenGainStopsAtSixteen() throws Exception {
+        red.setTacticalCC(8);
+        red.setFleetCC(4);
+        red.setStrategicCC(3);
+        invokeIncrease("increaseTacticCC");
+        assertEquals(9, red.getTacticalCC(), "15 -> 16 is allowed");
+        invokeIncrease("increaseTacticCC");
+        invokeIncrease("increaseFleetCC");
+        invokeIncrease("increaseStrategyCC");
+        assertEquals(16, red.getTacticalCC() + red.getFleetCC() + red.getStrategicCC(), "never above 16");
+    }
+
+    private void invokeIncrease(String name) throws Exception {
+        Method m = CommandCounterButtonHandler.class.getDeclaredMethod(
+                name, ButtonInteractionEvent.class, Player.class, Game.class);
+        m.setAccessible(true);
+        m.invoke(null, event, red, game);
+    }
+
+    // ---- 2. Leftover Milty buttons after the draft
+
+    @Test
+    void miltyPickAfterTheDraftDoesNotRunTheFinishAgain() {
+        game.setPhaseOfGame("miltydraft");
+        MiltyDraftManager m = game.getMiltyDraftManager();
+        m.setFinished(true); // draft order exhausted (empty) and finished
+        m.doMiltyPick(event, game, "milty_slice_D", red);
+        assertEquals("miltydraft", game.getPhaseOfGame(), "the finish (players set up again) must not run");
+    }
+
+    // ---- 4. Crash Landing without an active system
+
+    @Test
+    void crashLandingWithoutActiveSystemDoesNotThrow() throws Exception {
+        game.setActiveSystem(null);
+        Method m = TeHelperActionCards.class.getDeclaredMethod(
+                "crashLandingStart", Game.class, Player.class, ButtonInteractionEvent.class);
+        m.setAccessible(true);
+        m.invoke(null, game, red, event); // NPE before the fix
+    }
+
+    // ---- minor: pre-game setup controls mid-game
+
+    @Test
+    void setupControlsRefusedOnlyAfterSetup() {
+        game.setRound(1);
+        game.setPhaseOfGame("playerSetup");
+        assertFalse(SetupControls.refuses(game, "setupBaseGameMode"));
+        game.setPhaseOfGame("action");
+        assertTrue(SetupControls.refuses(game, "setupBaseGameMode"));
+        assertTrue(SetupControls.refuses(game, "chooseExp_te"));
+        assertTrue(SetupControls.refuses(game, "FFCC_mentak_startPlayerSetup"));
+        assertTrue(SetupControls.refuses(game, "milty_slice_D"));
+        assertFalse(SetupControls.refuses(game, "leadershipGenerateCCButtons"));
+    }
+}
diff --git a/src/test/java/ti4/selfhost/engine/GameRewindPlanTest.java b/src/test/java/ti4/selfhost/engine/GameRewindPlanTest.java
