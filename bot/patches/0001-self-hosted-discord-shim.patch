@@ -0,0 +1,57 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.List;
+import java.util.Map;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * A temporary combat modifier to apply before the next combat roll, on a message of its own:
+ * applytempcombatmod__action_cards__&lt;ac alias&gt; ("Resolve Morale Boost / Fighter Prototype / Bunker / …", posted
+ * to the player right after they play the action card; owner-prefixed) and applytempcombatmod__tech__sc (Supercharge;
+ * normally on the combat controls message, where it is a combat.round option — that kind outranks this one).
+ * Pressing it records the modifier (+ exhausts Supercharge) and deletes the prompt.
+ *
+ * <p>value: {source: "action_cards" | "tech", card} (card: the action card alias / "sc").
+ */
+public class CombatModifierKind implements KindSpec {
+    private static final String PREFIX = "applytempcombatmod__";
+
+    @Override
+    public String kind() {
+        return "combat.modifier";
+    }
+
+    @Override
+    public int priority() {
+        return 80;
+    }
+
+    @Override
+    public boolean classifies(List<String> handlerIds) {
+        for (String h : handlerIds) if (h != null && h.startsWith(PREFIX)) return true;
+        return false;
+    }
+
+    @Override
+    public boolean matches(String h) {
+        return value(h) != null;
+    }
+
+    static Map<String, Object> value(String h) {
+        if (!h.startsWith(PREFIX)) return null;
+        String rest = h.substring(PREFIX.length());
+        int sep = rest.indexOf("__");
+        if (sep <= 0 || sep + 2 >= rest.length()) return null;
+        return SetupKindSupport.map("source", rest.substring(0, sep), "card", rest.substring(sep + 2));
+    }
+
+    @Override
+    public Map<String, Object> value(String h, CaptureContext ctx) {
+        return value(h);
+    }
+
+    @Override
+    public String scope(CaptureContext ctx) {
+        return "player";
+    }
+}
