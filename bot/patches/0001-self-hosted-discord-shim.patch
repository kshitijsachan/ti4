+package ti4.selfhost.engine.kinds;
+
+import java.util.List;
+import javax.annotation.Nullable;
+import ti4.selfhost.engine.KindSpec.CaptureContext;
+
+/**
+ * Barony of Letnev: Munitions Reserves (munitionsReserves: spend 2 TG, reroll misses), mech DEPLOY
+ * (letnevMechRes_&lt;planet&gt;_&lt;unit&gt;), War Funding (resolveWarfunding), commander Rear Admiral Farran
+ * (gain1tgFromLetnevCommander). The first three sit on the combat controls message (combat.round owns it); the
+ * agent uses the generic exhaustAgent_/getAgentSelection_ ids (FactionStepsLeaders).
+ */
+public class FactionStepsLetnev implements FactionSteps {
+    private static final String F = "letnev";
+
+    @Override
+    @Nullable
+    public Step step(String h, @Nullable CaptureContext ctx) {
+        if (h.equals("munitionsReserves"))
+            return Step.ability("ability", "munitions", F, "munitionsReserves", "use", true, "cost", 2);
+        if (h.startsWith("letnevMechRes_")) {
+            List<String> a = FactionSteps.args(h, "letnevMechRes_");
+            return Step.ability(
+                    "mech", "letnev_mech", F, "letnevMechRes", "use", true, "planet", FactionSteps.at(a, 0), "unit", "mf");
+        }
+        if (h.equals("resolveWarfunding"))
+            return Step.ability("promissory", "war_funding", F, "resolveWarfunding", "use", true);
+        if (h.equals("gain1tgFromLetnevCommander"))
+            return Step.leader("letnevcommander", "gain1tgFromLetnevCommander", "use", true, "amount", 1);
+        return null;
+    }
+}
