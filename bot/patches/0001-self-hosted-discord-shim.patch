diff --git a/src/main/java/ti4/helpers/MitosisProductionRule.java b/src/main/java/ti4/helpers/MitosisProductionRule.java
new file mode 100644
index 0000000..c940894
--- /dev/null
+++ b/src/main/java/ti4/helpers/MitosisProductionRule.java
@@ -0,0 +1,124 @@
+package ti4.helpers;
+
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import javax.annotation.Nullable;
+import lombok.experimental.UtilityClass;
+import net.dv8tion.jda.api.components.buttons.Button;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.game.Tile;
+import ti4.game.UnitHolder;
+import ti4.helpers.Units.UnitKey;
+import ti4.helpers.Units.UnitType;
+import ti4.model.UnitModel;
+
+/**
+ * Mitosis (Arborec): "Your space docks cannot produce infantry." (rules audit, factions slice; the original offered
+ * infantry at Arborec docks and even skipped Arborec in the production-limit warning). In a production that resolves
+ * the PRODUCTION abilities of the units in a system (tactical action, Warfare, Chaos Mapping, Freelancers, Arborec
+ * commander, ...), Arborec may produce at most as many infantry as the PRODUCTION of its other units there (Letani
+ * Warriors, Letani Behemoths, ...). Effects that place or produce units without the system's PRODUCTION (the Duha
+ * Menaimon, the Arborec hero, Mitosis itself, generic builds) are not limited.
+ *
+ * <p>The production entry point (Helper.getPlaceUnitButtons) records the system; the place_ handlers and the engine's
+ * production.produce kind refuse infantry past the limit, and the infantry buttons are not offered when it is 0.
+ */
+@UtilityClass
+public class MitosisProductionRule {
+
+    private static final Set<String> UNIT_PRODUCTION =
+            Set.of("tacticalaction", "warfare", "chaosm", "freelancers", "arbocommander", "sling");
+
+    private static String key(Player player) {
+        return "mitosisProduction_" + player.getFaction();
+    }
+
+    /** Called when a production opens: remembers the system when Mitosis limits this production, else forgets. */
+    public static void open(Game game, Player player, @Nullable Tile tile, String context) {
+        if (game == null || player == null) return;
+        if (tile != null && player.hasAbility("mitosis") && context != null
+                && UNIT_PRODUCTION.contains(context.toLowerCase())) {
+            game.setStoredValue(key(player), tile.getPosition());
+        } else {
+            game.removeStoredValue(key(player));
+        }
+    }
+
+    /** The system of the current Mitosis-limited production, or null. */
+    @Nullable
+    public static String limitedTile(Game game, Player player) {
+        if (game == null || player == null || !player.hasAbility("mitosis")) return null;
+        String v = game.getStoredValue(key(player));
+        return v == null || v.isEmpty() ? null : v;
+    }
+
+    /**
+     * PRODUCTION of the player's units in the system other than space docks, not counting units produced during this
+     * production (a Letani Warrior just produced has PRODUCTION 1 but was not there when PRODUCTION resolved).
+     */
+    public static int nonDockProduction(Player player, Tile tile) {
+        int total = 0;
+        for (Map.Entry<String, Integer> e : player.getCurrentProducedUnits().entrySet()) {
+            String[] k = e.getKey().split("_");
+            if (k.length < 2 || !tile.getPosition().equals(k[1]) || "sd".equals(k[0])) continue;
+            List<UnitModel> models = player.getUnitsByAsyncID(k[0]);
+            if (!models.isEmpty() && models.getFirst().getProductionValue() > 0)
+                total -= models.getFirst().getProductionValue() * e.getValue();
+        }
+        for (UnitHolder uh : tile.getUnitHolders().values()) {
+            for (UnitKey key : uh.getUnitKeys()) {
+                if (!player.unitBelongsToPlayer(key) || key.unitType() == UnitType.Spacedock) continue;
+                int n = uh.getUnitCount(key);
+                if (n <= 0) continue;
+                UnitModel m = player.getUnitFromUnitKey(key);
+                if (m != null && m.getProductionValue() > 0) total += m.getProductionValue() * n;
+            }
+        }
+        return total;
+    }
+
+    /** Infantry already produced in this system during this production. */
+    public static int infantryProduced(Player player, String tilePos) {
+        int n = 0;
+        for (Map.Entry<String, Integer> e : player.getCurrentProducedUnits().entrySet()) {
+            String[] k = e.getKey().split("_");
+            if (k.length >= 2 && "gf".equals(k[0]) && tilePos.equals(k[1])) n += e.getValue();
+        }
+        return n;
+    }
+
+    /** Why producing {@code count} more of {@code unitId} in {@code tilePos} breaks Mitosis (null = allowed). */
+    @Nullable
+    public static String refusal(Game game, Player player, @Nullable String tilePos, String unitId, int count) {
+        return refusal(game, player, tilePos, unitId, count, -1);
+    }
+
+    /** As above with an explicit count of infantry already produced (the engine sums a whole payload). */
+    @Nullable
+    public static String refusal(
+            Game game, Player player, @Nullable String tilePos, String unitId, int count, int alreadyInfantry) {
+        String limited = limitedTile(game, player);
+        if (limited == null || !"gf".equals(unitId) || (tilePos != null && !tilePos.equals(limited))) return null;
+        Tile tile = game.getTileByPosition(limited);
+        if (tile == null) return null;
+        int limit = nonDockProduction(player, tile);
+        int already = alreadyInfantry >= 0 ? alreadyInfantry : infantryProduced(player, limited);
+        if (already + count <= limit) return null;
+        return "**Mitosis**: your space docks cannot produce infantry; your other units in " + limited
+                + " have PRODUCTION " + limit + " (" + already + " infantry already produced).";
+    }
+
+    /** Drops the infantry buttons of a Mitosis-limited production when no other unit there has PRODUCTION. */
+    public static List<Button> filterButtons(Game game, Player player, Tile tile, List<Button> buttons) {
+        String limited = limitedTile(game, player);
+        if (limited == null || tile == null || !limited.equals(tile.getPosition())) return buttons;
+        if (nonDockProduction(player, tile) > 0) return buttons;
+        buttons.removeIf(b -> {
+            String id = b.getCustomId();
+            return id != null && (id.contains("_infantry_") || id.contains("_2gf_"));
+        });
+        return buttons;
+    }
+}
