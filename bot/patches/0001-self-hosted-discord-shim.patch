+package ti4.selfhost.engine.kinds;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.game.Tile;
+import ti4.selfhost.engine.EngineModels.Decision;
+import ti4.selfhost.engine.EngineModels.Target;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * Thunder's Edge: the player who completed the last expedition places the Thunder's Edge planet
+ * (TeHelperGeneral.resolvePlaceThundersEdge), one message edited in place:
+ * FFCC_&lt;f&gt;_placeThundersEdge → placeThundersEdge_&lt;pos&gt; (no owner prefix) →
+ * FFCC_&lt;f&gt;_placeThundersEdge_&lt;pos&gt;_&lt;faction&gt; (who puts infantry on it: one of the players with the most
+ * completed expeditions). The middle step has no owner, so the target is the last expedition's completer.
+ */
+public class TePlaceThundersEdgeKind implements KindSpec {
+
+    @Override
+    public String kind() {
+        return "te.thunders_edge.place";
+    }
+
+    @Override
+    public int priority() {
+        return 100;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return handlerId.equals("placeThundersEdge") || handlerId.startsWith("placeThundersEdge_");
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        if (!matches(handlerId)) return null;
+        Map<String, Object> v = new LinkedHashMap<>();
+        if (handlerId.equals("placeThundersEdge")) {
+            v.put("step", "start");
+            return v;
+        }
+        String[] parts = handlerId.substring("placeThundersEdge_".length()).split("_", 2);
+        Tile tile = ctx.game().getTileByPosition(parts[0]);
+        v.put("step", parts.length == 1 ? "system" : "infantry");
+        v.put("position", parts[0]);
+        v.put("tileId", tile == null ? null : tile.getTileID());
+        if (parts.length > 1) v.put("faction", parts[1]);
+        return v;
+    }
+
+    @Override
+    public Target target(CaptureContext ctx, Target resolved) {
+        if (resolved != null && "owner_prefix".equals(resolved.resolvedBy())) return resolved;
+        String f = ctx.game().getExpeditions().getLastExpeditionFaction();
+        Player p = f == null ? null : ctx.game().getPlayerFromColorOrFaction(f);
+        return p == null ? resolved : TeKinds.target(p, "owner_prefix");
+    }
+
+    @Override
+    public String scope(CaptureContext ctx) {
+        return "player";
+    }
+
+    @Override
+    public String validate(Game game, Player answering, Decision decision, String optionId) {
+        return TeKinds.ownerLockError(answering, optionId);
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/TeVisionariaKind.java b/src/main/java/ti4/selfhost/engine/kinds/TeVisionariaKind.java
new file mode 100644
index 0000000..51c7727
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/TeVisionariaKind.java
@@ -0,0 +1,119 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.selfhost.engine.EngineModels.Decision;
+import ti4.selfhost.engine.EngineModels.ReactionWindow;
+import ti4.selfhost.engine.EngineModels.Target;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * Thunder's Edge, Deepwrought breakthrough Visionaria Select (VisionariaSelectService.postInitialButtons): a table
+ * window in the main channel. Every other player answers once: acquireATechWithDwsBt (research for 3 trade goods and
+ * give Deepwrought a promissory note), giveVisionariaPN, or declineVisionaria; the active (Deepwrought) player may
+ * preset FFCC_&lt;f&gt;_fleetLogAfterVisionaria / endTurnAfterVisionaria. The game moves on only when everyone has
+ * responded, so an unanswered window stalls the turn.
+ *
+ * <p>value.respondent: whether the option is a response (vs the owner's preset). Who still has to answer is
+ * {@code window}.
+ */
+public class TeVisionariaKind implements KindSpec {
+
+    @Override
+    public String kind() {
+        return "te.visionaria.respond";
+    }
+
+    @Override
+    public int priority() {
+        return 100;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return handlerId.startsWith("acquireATechWithDwsBt")
+                || handlerId.equals("giveVisionariaPN")
+                || handlerId.equals("declineVisionaria")
+                || handlerId.equals("fleetLogAfterVisionaria")
+                || handlerId.equals("endTurnAfterVisionaria");
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        if (!matches(handlerId)) return null;
+        Map<String, Object> v = new LinkedHashMap<>();
+        String choice = handlerId.startsWith("acquireATechWithDwsBt")
+                ? "research"
+                : switch (handlerId) {
+                    case "giveVisionariaPN" -> "give_promissory";
+                    case "declineVisionaria" -> "decline";
+                    case "fleetLogAfterVisionaria" -> "wait_for_all";
+                    default -> "end_turn_after_all";
+                };
+        v.put("choice", choice);
+        v.put("respondent", !handlerId.endsWith("AfterVisionaria"));
+        return v;
+    }
+
+    static List<String> responded(Game game) {
+        List<String> out = new ArrayList<>();
+        for (String f : game.getStoredValue("VisionariaResponded").split("\\|")) if (!f.isBlank()) out.add(f);
+        return out;
+    }
+
+    /** Everyone answers for themself; no single target. */
+    @Override
+    public Target target(CaptureContext ctx, Target resolved) {
+        return new Target(null, null, null, "none");
+    }
+
+    /**
+     * Every real player is eligible; Deepwrought (the owner) answers with a "move along" preset, the others with a
+     * response. responded: players whose faction the engine recorded as responded (VisionariaResponded), except
+     * Deepwrought, which the engine records up front.
+     */
+    @Override
+    public ReactionWindow window(CaptureContext ctx) {
+        Game game = ctx.game();
+        List<String> factions = responded(game);
+        List<String> eligible = new ArrayList<>();
+        List<String> done = new ArrayList<>();
+        String owner = null;
+        for (Player p : game.getRealPlayers()) {
+            eligible.add(p.getUserID());
+            if (p.hasBreakthrough("deepwroughtbt")) owner = p.getUserID();
+            else if (factions.contains(p.getFaction())) done.add(p.getUserID());
+        }
+        // The engine clears the record once everyone has answered: the window is over.
+        if (factions.isEmpty()) done = new ArrayList<>(eligible);
+        Map<String, Object> subject = new LinkedHashMap<>();
+        subject.put("breakthrough", "deepwroughtbt");
+        subject.put("owner", owner);
+        return new ReactionWindow("visionaria", subject, eligible, done, Map.of());
+    }
+
+    @Override
+    public boolean dynamic() {
+        return true;
+    }
+
+    @Override
+    public String scope(CaptureContext ctx) {
+        return "table";
+    }
+
+    @Override
+    public String validate(Game game, Player answering, Decision decision, String optionId) {
+        String err = TeKinds.ownerLockError(answering, optionId);
+        if (err != null) return err;
+        if (optionId.endsWith("AfterVisionaria")) return null;
+        if (game.getStoredValue("VisionariaResponded").isEmpty()) return "Visionaria Select is over.";
+        if (answering.hasBreakthrough("deepwroughtbt")) return "Visionaria Select is yours; the others respond.";
+        if (responded(game).contains(answering.getFaction())) return "You already responded to Visionaria Select.";
+        return null;
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/TechGainKind.java b/src/main/java/ti4/selfhost/engine/kinds/TechGainKind.java
new file mode 100644
index 0000000..b780c32
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/TechGainKind.java
@@ -0,0 +1,100 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.selfhost.engine.EngineModels.SetupPlayer;
+import ti4.selfhost.engine.EngineModels.SetupState;
+import ti4.selfhost.engine.EngineModels.Target;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * Gain a technology: getTech_&lt;alias&gt;[__&lt;payment&gt;][__comp][__noPay]... (PlayerTechService.getTech). The setup
+ * "choose your starting technology" prompt is this kind with free=true in round 1 (value.starting).
+ */
+public class TechGainKind implements KindSpec {
+
+    @Override
+    public String kind() {
+        return "tech.gain";
+    }
+
+    @Override
+    public int priority() {
+        return 50;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return handlerId.startsWith("getTech_");
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        if (!matches(handlerId)) return null;
+        List<String> parts = new ArrayList<>(Arrays.asList(handlerId.substring("getTech_".length()).split("__")));
+        String tech = parts.removeFirst();
+        boolean free = parts.contains("noPay") || parts.contains("shareKnowledge");
+        Map<String, Object> v = new LinkedHashMap<>();
+        v.put("tech", tech);
+        v.put("free", free);
+        v.put("starting", free && ctx.game().getRound() <= 1 && !"action".equals(ctx.game().getPhaseOfGame()));
+        v.put("flags", parts);
+        // G2: what the technology is (type: PROPULSION/BIOTIC/CYBERNETIC/WARFARE/UNITUPGRADE; requirements e.g. "GG").
+        try {
+            ti4.model.TechnologyModel m = ti4.image.Mapper.getTech(tech);
+            v.put("type", m == null || m.getType() == null ? null : m.getType().toString());
+            v.put("requirements", m == null ? null : m.getRequirements().orElse(""));
+            v.put("factionTech", m != null && m.getFaction().isPresent());
+        } catch (Exception e) {
+            v.put("type", null);
+        }
+        return v;
+    }
+
+    /** Faction / colour are picked during setup, and a prompt without owner prefix may name its player only in text. */
+    @Override
+    public boolean dynamic() {
+        return true;
+    }
+
+    /**
+     * The generic target (refreshed: faction / colour may have been picked since capture). Without one (live: setup
+     * starting-tech prompts in the actions channel resolved "none"): the one player the prompt text names by faction
+     * emoji / colour, else, during setup, the one player still owing starting technologies.
+     */
+    @Override
+    public Target target(CaptureContext ctx, Target resolved) {
+        if (resolved != null && resolved.userId() != null) return SetupKindSupport.refresh(ctx, resolved);
+        Game game = ctx.game();
+        String text = ctx.content() == null ? "" : ctx.content().toLowerCase(java.util.Locale.ROOT);
+        Player named = null;
+        int hits = 0;
+        for (Player p : game.getPlayers().values()) {
+            if (p == null || p.isDummy()) continue;
+            String f = p.getFaction() == null ? "" : p.getFaction().toLowerCase(java.util.Locale.ROOT);
+            String c = p.getColor() == null ? "" : p.getColor().toLowerCase(java.util.Locale.ROOT);
+            boolean byFaction = !f.isBlank() && !"null".equals(f) && text.contains("<:" + f + ":");
+            boolean byColor = !c.isBlank() && !"null".equals(c) && text.contains("**" + c + "**");
+            if (byFaction || byColor) {
+                named = p;
+                hits++;
+            }
+        }
+        if (hits == 1) return ti4.selfhost.engine.DecisionCapture.target(named, "prompt_text");
+        SetupState setup = ti4.selfhost.engine.SetupStateBuilder.build(game);
+        if (setup != null) {
+            List<String> owing = new ArrayList<>();
+            for (SetupPlayer sp : setup.players()) if (sp.startingTechsNeeded() > 0) owing.add(sp.userId());
+            if (owing.size() == 1) {
+                Player p = game.getPlayer(owing.getFirst());
+                if (p != null) return ti4.selfhost.engine.DecisionCapture.target(p, "setup_state");
+            }
+        }
+        return resolved;
+    }
+}
