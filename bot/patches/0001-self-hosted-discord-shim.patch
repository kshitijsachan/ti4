@@ -0,0 +1,100 @@
+package ti4.helpers;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import java.util.List;
+import net.dv8tion.jda.api.components.buttons.Button;
+import org.junit.jupiter.api.Test;
+import ti4.discord.interactions.buttons.Buttons;
+import ti4.discord.interactions.routing.ComponentIdEnvelope;
+import ti4.game.Game;
+import ti4.game.Player;
+
+class ScOfferTest {
+
+    private static Player player(Game game, String faction) {
+        Player p = new Player(faction, faction, game);
+        p.setFaction(faction);
+        return p;
+    }
+
+    @Test
+    void aPlayKeepsItsIdsAndEachPlayIsANewOffer() {
+        Game game = new Game();
+        Player hacan = player(game, "hacan");
+        List<Button> play = List.of(Buttons.green("sc_follow_3", "Spend"), Buttons.gray("sc_ac_draw", "Draw 2"));
+
+        ScOffer.recordPlay(game, play);
+        assertThat(play).extracting(Button::getCustomId).containsExactly("sc_follow_3", "sc_ac_draw");
+        String first = ScOffer.of(game, "sc_ac_draw");
+        assertThat(first).isNotNull().isEqualTo(ScOffer.of(game, "sc_follow_3"));
+
+        // the same play: any copy of the card's buttons shares the flags
+        assertThat(ScOffer.markUsed(game, hacan, "sc_ac_draw", "msgA", "ac")).isFalse();
+        assertThat(ScOffer.markUsed(game, hacan, "sc_ac_draw", "msgB", "ac")).isTrue();
+
+        // next play of the card starts clean
+        ScOffer.recordPlay(game, play);
+        assertThat(ScOffer.of(game, "sc_ac_draw")).isNotEqualTo(first);
+        assertThat(ScOffer.markUsed(game, hacan, "sc_ac_draw", "msgC", "ac")).isFalse();
+    }
+
+    @Test
+    void otherOffersCarryTheirOfferInTheIdOutsideTheHandlerId() {
+        Game game = new Game();
+        Player hacan = player(game, "hacan");
+        ScOffer.recordPlay(game, List.of(Buttons.gray("sc_ac_draw", "Draw 2")));
+
+        List<Button> crisis = ScOffer.tag(
+                game,
+                List.of(
+                        Buttons.gray("sc_ac_draw", "Draw 2"),
+                        Buttons.green("leadershipGenerateCCButtons", "Gain"),
+                        Buttons.blue("sc_no_follow_3", "Not Following")));
+        String drawId = crisis.get(0).getCustomId();
+        assertThat(drawId).startsWith("sc_ac_draw~o");
+        assertThat(crisis.get(1).getCustomId()).isEqualTo("leadershipGenerateCCButtons");
+        assertThat(ComponentIdEnvelope.decode(drawId).handlerId()).isEqualTo("sc_ac_draw");
+        assertThat(ComponentIdEnvelope.decode(crisis.get(2).getCustomId()).handlerId())
+                .isEqualTo("sc_no_follow_3");
+
+        // used on the card's play does not use up the Crisis offer, and vice versa
+        assertThat(ScOffer.markUsed(game, hacan, "sc_ac_draw", "play", "ac")).isFalse();
+        assertThat(ScOffer.markUsed(game, hacan, drawId, "crisis", "ac")).isFalse();
+        assertThat(ScOffer.markUsed(game, hacan, drawId, "crisis", "ac")).isTrue();
+
+        // "not following" on the Crisis offer forgets only that offer
+        ScOffer.unmarkUsed(game, hacan, crisis.get(2).getCustomId(), "crisis");
+        assertThat(ScOffer.markUsed(game, hacan, drawId, "crisis", "")).isFalse();
+        assertThat(ScOffer.markUsed(game, hacan, "sc_ac_draw", "play", "ac")).isTrue();
+    }
+
+    @Test
+    void promptsFromBeforeOffersKeepTheirMessageFlags() {
+        Game game = new Game();
+        Player hacan = player(game, "hacan");
+        // no play recorded, no marker: the old per-message flag
+        assertThat(ScOffer.of(game, "sc_draw_so")).isNull();
+        assertThat(ScOffer.markUsed(game, hacan, "sc_draw_so", "oldMsg", "so")).isFalse();
+        assertThat(ScOffer.markUsed(game, hacan, "sc_draw_so", "oldMsg", "so")).isTrue();
+
+        // a flag such a prompt recorded is still honoured once the card's ids are recorded
+        ScOffer.recordPlay(game, List.of(Buttons.gray("sc_draw_so", "Draw")));
+        assertThat(ScOffer.markUsed(game, hacan, "sc_draw_so", "oldMsg", "so")).isTrue();
+        // …and carried over to the play: the same player is still done, another is not
+        assertThat(ScOffer.markUsed(game, hacan, "sc_draw_so", "newMsg", "so")).isTrue();
+        assertThat(ScOffer.markUsed(game, player(game, "sol"), "sc_draw_so", "newMsg", "so")).isFalse();
+    }
+
+    @Test
+    void untrackedIdsAreNotOffers() {
+        Game game = new Game();
+        ScOffer.recordPlay(game, List.of(Buttons.gray("requestAllFollow_3", "Request")));
+        assertThat(ScOffer.of(game, "requestAllFollow_3")).isNull();
+        assertThat(ComponentIdEnvelope.decode("deleteButtons~pay").handlerId()).isEqualTo("deleteButtons~pay");
+        assertThat(ComponentIdEnvelope.decode("sc_refreshdeleteThisButton~o12").handlerId())
+                .isEqualTo("sc_refresh");
+        assertThat(ComponentIdEnvelope.decode("sc_refreshdeleteThisButton~o12").deleteButton())
+                .isTrue();
+    }
+}
diff --git a/src/test/java/ti4/selfhost/engine/CaptureAheadOfSaveTest.java b/src/test/java/ti4/selfhost/engine/CaptureAheadOfSaveTest.java
new file mode 100644
index 0000000..e7cc026
--- /dev/null
+++ b/src/test/java/ti4/selfhost/engine/CaptureAheadOfSaveTest.java
@@ -0,0 +1,123 @@
+package ti4.selfhost.engine;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import java.util.List;
+import java.util.Map;
+import net.dv8tion.jda.api.utils.data.DataArray;
+import net.dv8tion.jda.api.utils.data.DataObject;
+import org.junit.jupiter.api.BeforeAll;
+import org.junit.jupiter.api.Test;
+import ti4.game.Game;
+import ti4.selfhost.engine.EngineModels.Decision;
+
+/**
+ * One bug class, three live instances (homework tokens, Milty slice board, round-2 first SC pick): a prompt is captured
+ * before the interaction that posted it saves, so capture reads the state before that action. For any kind, such a
+ * prompt must not get a capture-time obsolete() verdict from the stale save, and its values must be re-read on the
+ * next save.
+ */
+class CaptureAheadOfSaveTest {
+
+    /** A kind that is obsolete in the status phase and whose option value is the current phase. */
+    static final class PhaseKind implements KindSpec {
+        @Override
+        public String kind() {
+            return "test.ahead_of_save";
+        }
+
+        @Override
+        public boolean matches(String handlerId) {
+            return handlerId != null && handlerId.startsWith("aheadOfSaveTest_");
+        }
+
+        @Override
+        public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+            return Map.of("phase", String.valueOf(ctx.game().getPhaseOfGame()));
+        }
+
+        @Override
+        public boolean obsolete(CaptureContext ctx) {
+            return String.valueOf(ctx.game().getPhaseOfGame()).startsWith("status");
+        }
+    }
+
+    @BeforeAll
+    static void register() {
+        DecisionKinds.registerForTest(new PhaseKind());
+    }
+
+    private static long seq;
+
+    private static DataObject message(long postedAt) {
+        String id = Long.toUnsignedString(((postedAt - 1420070400000L) << 22) | (++seq & 0xFFF));
+        DataObject button = DataObject.empty()
+                .put("type", 2)
+                .put("custom_id", "aheadOfSaveTest_go")
+                .put("label", "Go")
+                .put("style", 1);
+        DataObject row = DataObject.empty().put("type", 1).put("components", DataArray.empty().add(button));
+        return DataObject.empty()
+                .put("id", id)
+                .put("channel_id", "c1")
+                .put("content", "pick")
+                .put("flags", 0)
+                .put("components", DataArray.empty().add(row));
+    }
+
+    private static Game game(String name, String phase, long savedAt) {
+        Game g = new Game();
+        g.setName(name);
+        g.setPhaseOfGame(phase);
+        g.setLastModifiedDate(savedAt);
+        return g;
+    }
+
+    private static Decision open(String game) {
+        List<Decision> open = DecisionRegistry.openDecisions(game);
+        return open.isEmpty() ? null : open.get(open.size() - 1);
+    }
+
+    @Test
+    void promptPostedAfterTheSaveIsNotClosedFromThatSaveAndIsReReadOnTheNextOne() {
+        long now = System.currentTimeMillis();
+        Game stale = game("ahead1", "statusHomework", now - 5_000);
+        Decision d = DecisionCaptureAccess.build(stale, message(now - 1_000), null);
+        assertThat(d).as("not closed as obsolete from the save before the posting action").isNotNull();
+        DecisionRegistry.open(d);
+
+        Game saved = game("ahead1", "strategy", now);
+        Engine.settleAhead(saved);
+        Decision settled = open("ahead1");
+        assertThat(settled).isNotNull();
+        assertThat(settled.options().getFirst().value()).containsEntry("phase", "strategy");
+        assertThat(DecisionCapture.AHEAD).doesNotContainKey(settled.source().messageId());
+    }
+
+    @Test
+    void promptThatIsObsoleteInTheSaveAfterItClosesOnSettle() {
+        long now = System.currentTimeMillis();
+        Decision d = DecisionCaptureAccess.build(game("ahead2", "action", now - 5_000), message(now - 1_000), null);
+        assertThat(d).isNotNull();
+        DecisionRegistry.open(d);
+        Engine.settleAhead(game("ahead2", "statusScoring", now));
+        assertThat(open("ahead2")).isNull();
+    }
+
+    @Test
+    void anOlderSaveDoesNotSettleIt() {
+        long now = System.currentTimeMillis();
+        Decision d = DecisionCaptureAccess.build(game("ahead3", "statusHomework", now - 5_000), message(now - 1_000), null);
+        DecisionRegistry.open(d);
+        Engine.settleAhead(game("ahead3", "statusHomework", now - 4_000));
+        assertThat(open("ahead3")).isNotNull();
+        assertThat(DecisionCapture.AHEAD).containsKey(d.source().messageId());
+    }
+
+    @Test
+    void promptPostedBeforeTheSaveIsStillJudgedAtCapture() {
+        long now = System.currentTimeMillis();
+        Decision d = DecisionCaptureAccess.build(game("ahead4", "statusHomework", now), message(now - 120_000), null);
+        assertThat(d).as("a leftover read against a newer save closes at capture, as before").isNull();
+    }
+}
