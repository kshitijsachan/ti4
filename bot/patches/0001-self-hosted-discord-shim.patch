+package ti4.selfhost.engine.kinds;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.selfhost.engine.EngineModels.Decision;
+import ti4.selfhost.engine.EngineModels.Target;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * Trade primary: the holder may replenish other players' commodities for free (no strategy token).
+ * {@code forceARefresh_<faction>} (ButtonHelper.getForcedRefreshButtons, posted to the holder's channel without an
+ * owner prefix) plus "Done Resolving" (untyped). Target: the player holding strategy card 5.
+ */
+public class TradeForceReplenishKind implements KindSpec {
+    private static final int TRADE = 5;
+
+    @Override
+    public String kind() {
+        return "trade.force_replenish";
+    }
+
+    @Override
+    public int priority() {
+        return 100;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return handlerId.startsWith("forceARefresh_");
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        if (!matches(handlerId)) return null;
+        Player p = ctx.game().getPlayerFromColorOrFaction(handlerId.substring("forceARefresh_".length()));
+        if (p == null) return null;
+        Map<String, Object> v = new LinkedHashMap<>();
+        v.put("faction", p.getFaction());
+        v.put("userId", p.getUserID());
+        v.put("commodities", p.getCommodities());
+        v.put("commoditiesMax", p.getCommoditiesTotal());
+        v.put("neighbor", ctx.player() != null && ctx.player().isNeighboursWith(p));
+        return v;
+    }
+
+    @Override
+    public Target target(CaptureContext ctx, Target resolved) {
+        Player holder = holder(ctx.game());
+        if (holder == null) return resolved;
+        return new Target(holder.getUserID(), holder.getFaction(), holder.getColor(), "sc_holder");
+    }
+
+    @Override
+    public String scope(CaptureContext ctx) {
+        return "player";
+    }
+
+    @Override
+    public String validate(Game game, Player answering, Decision decision, String optionId) {
+        Player holder = holder(game);
+        if (holder != null && holder != answering) return "Only the Trade holder replenishes other players.";
+        return null;
+    }
+
+    private static Player holder(Game game) {
+        for (Player p : game.getRealPlayers()) {
+            if (p.getSCs() != null && p.getSCs().contains(TRADE)) return p;
+        }
+        return null;
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/TradeOfferKind.java b/src/main/java/ti4/selfhost/engine/kinds/TradeOfferKind.java
new file mode 100644
index 0000000..7a9f73f
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/TradeOfferKind.java
@@ -0,0 +1,108 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.selfhost.engine.EngineModels.Decision;
+import ti4.selfhost.engine.EngineModels.Option;
+import ti4.selfhost.engine.EngineModels.Target;
+import ti4.selfhost.engine.KindSpec;
+import ti4.selfhost.engine.TradeEngine;
+
+/**
+ * A transaction offer to the target (TransactionHelper.sendOffer, posted in the receiver's cards-info thread):
+ * {@code acceptOffer_<senderColor>_<offerNumber>[_BMD_<color>]}, {@code rejectOffer_<senderColor>[...]}. The third
+ * button, {@code resetOffer_} ("Reject and CounterOffer"), is left untyped (value null): it shares its id with the
+ * Discord deal builder's "Reset Offer", and a counter is "reject" plus the typed {@code trade.propose} action.
+ *
+ * <p>Every typed option carries the whole offer (sender, offer number, decoded items), so a consumer reads it from
+ * any of them.
+ */
+public class TradeOfferKind implements KindSpec {
+
+    @Override
+    public String kind() {
+        return "trade.offer";
+    }
+
+    @Override
+    public int priority() {
+        return 100;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return handlerId.startsWith("acceptOffer_") || handlerId.startsWith("rejectOffer_");
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        if (!matches(handlerId)) return null;
+        String[] parts = handlerId.split("_");
+        if (parts.length < 2) return null;
+        Game game = ctx.game();
+        Player from = game.getPlayerFromColorOrFaction(parts[1]);
+        Player to = ctx.player() != null ? ctx.player() : cardsThreadOwner(game, ctx.channelId());
+        if (from == null) return null;
+        Integer offerNumber = handlerId.startsWith("acceptOffer_") && parts.length > 2 ? parseInt(parts[2]) : null;
+        Map<String, Object> v = new LinkedHashMap<>();
+        v.put("action", handlerId.startsWith("acceptOffer_") ? "accept" : "reject");
+        v.put("from", from.getFaction());
+        v.put("fromUserId", from.getUserID());
+        v.put("to", to == null ? null : to.getFaction());
+        v.put("offerNumber", offerNumber);
+        v.put("blackMarket", handlerId.contains("_BMD_"));
+        List<Object> items = new ArrayList<>();
+        if (to != null) items.addAll(TradeEngine.items(game, from, to));
+        v.put("items", items);
+        v.put("current", to != null && TradeEngine.isCurrent(game, from, to, offerNumber));
+        return v;
+    }
+
+    @Override
+    public Target target(CaptureContext ctx, Target resolved) {
+        if (resolved != null && resolved.userId() != null) return resolved;
+        Player owner = cardsThreadOwner(ctx.game(), ctx.channelId());
+        if (owner == null) return resolved;
+        return new Target(owner.getUserID(), owner.getFaction(), owner.getColor(), "cards_thread");
+    }
+
+    @Override
+    public String scope(CaptureContext ctx) {
+        return "player";
+    }
+
+    @Override
+    public String validate(Game game, Player answering, Decision decision, String optionId) {
+        Option opt = decision.options().stream()
+                .filter(o -> o.id().equals(optionId))
+                .findFirst()
+                .orElse(null);
+        if (opt == null || opt.value() == null || !"accept".equals(opt.value().get("action"))) return null;
+        Player from = game.getPlayerFromColorOrFaction(String.valueOf(opt.value().get("from")));
+        Object n = opt.value().get("offerNumber");
+        if (from == null) return "The player who made this offer is gone.";
+        if (!TradeEngine.isCurrent(game, from, answering, n instanceof Integer i ? i : null))
+            return "This offer was replaced or withdrawn; only the newest offer can be accepted.";
+        return null;
+    }
+
+    static Player cardsThreadOwner(Game game, String channelId) {
+        if (channelId == null) return null;
+        for (Player p : game.getRealPlayers()) {
+            if (channelId.equals(p.getCardsInfoThreadID())) return p;
+        }
+        return null;
+    }
+
+    private static Integer parseInt(String s) {
+        try {
+            return Integer.parseInt(s);
+        } catch (NumberFormatException e) {
+            return null;
+        }
+    }
+}
