+package ti4.selfhost.engine.kinds;
+
+import java.util.Map;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * "After" queue window in the player's cards-info thread: queueAnAfter (open the list), declineToQueueAnAfter (pass),
+ * queueAfter_&lt;ac|pn|planet|leader|tech|ability&gt;_&lt;id&gt; (queue it; riders are action cards here),
+ * lockAftersIn ("play regardless of others"), unlockQueuedAfters ("be asked again if someone plays an after").
+ */
+public class AgendaAfterKind implements KindSpec {
+
+    @Override
+    public String kind() {
+        return "agenda.after";
+    }
+
+    @Override
+    public int priority() {
+        return 100;
+    }
+
+    @Override
+    public boolean matches(String h) {
+        return h.equals("queueAnAfter")
+                || h.equals("declineToQueueAnAfter")
+                || h.startsWith("queueAfter_")
+                || h.equals("lockAftersIn")
+                || h.equals("unlockQueuedAfters");
+    }
+
+    @Override
+    public Map<String, Object> value(String h, CaptureContext ctx) {
+        if (h.equals("lockAftersIn")) return Map.of("action", "lock");
+        if (h.equals("unlockQueuedAfters")) return Map.of("action", "ask_again");
+        return AgendaWhenKind.window(h, "queueAnAfter", "declineToQueueAnAfter", "queueAfter_");
+    }
+}
