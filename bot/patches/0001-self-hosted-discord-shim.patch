@@ -0,0 +1,44 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * Pre-play an action card for a later window (ButtonHelperActionCards / CryypterHelper): resolvePreassignment_&lt;what&gt;
+ * with &lt;what&gt; e.g. "Puppets On A String", "Relitigate", "Coup_&lt;sc&gt;", "ExtremeDuress_&lt;color&gt;",
+ * "Mentak Envoy &lt;f&gt;_&lt;f2&gt;". The agenda pre-assignments ("Pass On Shenanigans", "Abstain On Agenda") are
+ * agenda.preassign (higher priority).
+ *
+ * <p>value: {preassignment: the card / effect name, target: the part after the first "_" or null}.
+ */
+public class ActionCardPreassignKind implements KindSpec {
+
+    @Override
+    public String kind() {
+        return "action_card.preassign";
+    }
+
+    @Override
+    public int priority() {
+        return 60;
+    }
+
+    @Override
+    public boolean matches(String h) {
+        return h.startsWith("resolvePreassignment_")
+                && !h.equals("resolvePreassignment_Pass On Shenanigans")
+                && !h.equals("resolvePreassignment_Abstain On Agenda");
+    }
+
+    @Override
+    public Map<String, Object> value(String h, CaptureContext ctx) {
+        if (!matches(h)) return null;
+        String rest = h.substring("resolvePreassignment_".length());
+        int us = rest.indexOf('_');
+        Map<String, Object> v = new LinkedHashMap<>();
+        v.put("preassignment", us < 0 ? rest : rest.substring(0, us));
+        v.put("target", us < 0 ? null : rest.substring(us + 1));
+        return v;
+    }
+}
