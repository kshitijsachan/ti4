+package ti4.selfhost.engine;
+
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+import java.util.Set;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+import net.dv8tion.jda.api.entities.channel.Channel;
+import net.dv8tion.jda.api.utils.data.DataArray;
+import net.dv8tion.jda.api.utils.data.DataObject;
+import okhttp3.Interceptor;
+import okhttp3.Request;
+import okhttp3.Response;
+import okio.Buffer;
+import ti4.discord.JdaService;
+import ti4.discord.interactions.routing.ComponentIdEnvelope;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.game.persistence.GameManager;
+import ti4.game.persistence.ManagedGame;
+import ti4.logging.BotLogger;
+import ti4.selfhost.engine.EngineModels.Choice;
+import ti4.selfhost.engine.EngineModels.Decision;
+import ti4.selfhost.engine.EngineModels.InputField;
+import ti4.selfhost.engine.EngineModels.InputSchema;
+import ti4.selfhost.engine.EngineModels.Option;
+import ti4.selfhost.engine.EngineModels.Progress;
+import ti4.selfhost.engine.EngineModels.ReactionWindow;
+import ti4.selfhost.engine.EngineModels.Source;
+import ti4.selfhost.engine.EngineModels.Target;
+import ti4.selfhost.engine.interaction.MessageSink;
+import ti4.selfhost.engine.interaction.NativeCoverage;
+import ti4.service.game.GameNameService;
+
+/**
+ * THE capture point: an OkHttp interceptor on JDA's REST client. Every message the engine posts, edits or deletes
+ * (channel messages, interaction replies, followups, ephemerals — all ~5,500 button construction sites) passes
+ * here, so decisions are captured without touching handler code. Target players are resolved from engine state
+ * (FFCC_ owner faction → Player, cards-info thread owner, interaction user), never from message text.
+ */
+public final class DecisionCapture implements Interceptor {
+
+    private static final Pattern CH_MSGS = Pattern.compile(".*/channels/(\\d+)/messages$");
+    private static final Pattern CH_MSG = Pattern.compile(".*/channels/(\\d+)/messages/(\\d+)$");
+    private static final Pattern CH_BULK = Pattern.compile(".*/channels/(\\d+)/messages/bulk-delete$");
+    private static final Pattern HOOK = Pattern.compile(".*/webhooks/(\\d+)/([^/]+)$");
+    private static final Pattern HOOK_MSG = Pattern.compile(".*/webhooks/(\\d+)/([^/]+)/messages/([^/]+)$");
+    private static final Pattern CALLBACK = Pattern.compile(".*/interactions/(\\d+)/([^/]+)/callback$");
+    private static final Pattern MENTION = Pattern.compile("<@!?(\\d+)>");
+
+    @Override
+    public Response intercept(Chain chain) throws IOException {
+        Request req = chain.request();
+        Response res = chain.proceed(req);
+        if (!Engine.enabled() || !res.isSuccessful() || "GET".equals(req.method())) return res;
+        long t0 = System.nanoTime();
+        try {
+            observe(req, res);
+        } catch (Exception e) {
+            EngineMetrics.count("capture.error");
+            BotLogger.error("engine: decision capture failed for " + req.method() + " " + req.url().encodedPath(), e);
+        } finally {
+            EngineMetrics.captureNanos(System.nanoTime() - t0);
+        }
+        return res;
+    }
+
+    private static void observe(Request req, Response res) throws IOException {
+        String path = req.url().encodedPath();
+        String method = req.method();
+        Matcher m;
+        if ("POST".equals(method) && (m = CH_BULK.matcher(path)).matches()) {
+            DataObject body = DataObject.fromJson(bodyString(req));
+            DataArray ids = body.getArray("messages");
+            for (int i = 0; i < ids.length(); i++) DecisionRegistry.closeByMessage(ids.getString(i), "deleted");
+            return;
+        }
+        if ((m = CH_MSGS.matcher(path)).matches() && "POST".equals(method)) {
+            // An engine answer's ephemeral reply (MessageSink nonce "eph:<user>"): attribute it to that user.
+            String token = null;
+            String nonce = nonce(req);
+            if (nonce.startsWith(MessageSink.EPHEMERAL_NONCE)) {
+                token = nonce;
+                InteractionTracker.recordUser(token, nonce.substring(MessageSink.EPHEMERAL_NONCE.length()));
+            }
+            onMessage(responseJson(res), token);
+            return;
+        }
+        if ((m = CH_MSG.matcher(path)).matches()) {
+            if ("DELETE".equals(method)) DecisionRegistry.closeByMessage(m.group(2), "deleted");
+            else if ("PATCH".equals(method)) onMessage(responseJson(res), null);
+            return;
+        }
+        if ((m = HOOK_MSG.matcher(path)).matches()) {
+            String token = m.group(2);
+            String id = m.group(3);
+            if ("@original".equals(id)) {
+                id = InteractionTracker.original(token);
+                // No reply was made: @original is the message the component was on (deferEdit / UPDATE_MESSAGE).
+                if (id == null && InteractionTracker.byToken(token) != null) id = InteractionTracker.byToken(token).messageId();
+            }
+            if ("DELETE".equals(method)) {
+                if (id != null) DecisionRegistry.closeByMessage(id, "deleted");
+            } else if ("PATCH".equals(method)) {
+                DataObject msg = responseJson(res);
+                if (msg != null && "@original".equals(m.group(3)))
+                    InteractionTracker.setOriginal(token, msg.getString("id", null));
+                onMessage(msg, token);
+            }
+            return;
+        }
+        if ((m = HOOK.matcher(path)).matches() && "POST".equals(method)) {
+            onMessage(responseJson(res), m.group(2)); // interaction followup (or channel webhook: token unknown)
+            return;
+        }
+        if ((m = CALLBACK.matcher(path)).matches() && "POST".equals(method)) {
+            DataObject body = responseJson(res); // only present with ?with_response=true
+            if (body != null && body.hasKey("resource") && !body.isNull("resource")) {
+                DataObject resource = body.getObject("resource");
+                int rtype = resource.getInt("type", 0);
+                if (rtype == 6) {
+                    // DEFERRED_UPDATE_MESSAGE: @original is now the message the component is on, so a later
+                    // DELETE/PATCH of @original (hook.deleteOriginal / editOriginal) must close/update its decision.
+                    InteractionTracker.Info info = InteractionTracker.byToken(m.group(2));
+                    if (info != null && info.messageId() != null) InteractionTracker.setOriginal(m.group(2), info.messageId());
+                }
+                if (resource.hasKey("message") && !resource.isNull("message")) {
+                    DataObject msg = resource.getObject("message");
+                    int type = resource.getInt("type", 0);
+                    if (type == 4 || type == 5 || type == 7)
+                        InteractionTracker.setOriginal(m.group(2), msg.getString("id", null));
+                    onMessage(msg, m.group(2));
+                }
+            }
+        }
+    }
+
+    // ------------------------------------------------------------------ message -> decision
+
+    static void onMessage(DataObject msg, String interactionToken) {
+        onMessage(msg, interactionToken, null);
+    }
+
+    /** knownGame: the game the caller already loaded (rebuild), to skip a per-message game load. */
+    static void onMessage(DataObject msg, String interactionToken, Game knownGame) {
+        if (msg == null || !msg.hasKey("id")) return;
+        EngineMetrics.count("capture.message");
+        String messageId = msg.getString("id");
+        String channelId = msg.getString("channel_id", null);
+        if (interactionToken != null) {
+            // An edit of the message the component is on (deferEdit + editOriginal, UPDATE_MESSAGE) is still that
+            // message's prompt, not a reply to the presser: attributing it to the presser made a table-wide
+            // "score objectives" prompt the last presser's own (found live, pbd96).
+            InteractionTracker.Info info = InteractionTracker.byToken(interactionToken);
+            if (info != null && messageId.equals(info.messageId())) interactionToken = null;
+        }
+        List<RawControl> controls = new ArrayList<>();
+        if (msg.hasKey("components") && !msg.isNull("components")) collect(msg.getArray("components"), controls);
+        if (controls.isEmpty()) {
+            DecisionRegistry.closeByMessage(messageId, "no_options");
+            return;
+        }
+        Game game = knownGame != null ? knownGame : gameForChannel(channelId);
+        if (game == null) {
+            EngineMetrics.count("capture.no_game");
+            return;
+        }
+        Decision d = build(game, msg, controls, interactionToken);
+        if (d != null) DecisionRegistry.open(d);
+    }
+
+    /** Message → Decision for a known game; null when it equals the open revision. Pure apart from reading Game. */
+    static Decision build(Game game, DataObject msg, List<RawControl> controls, String interactionToken) {
+        String messageId = msg.getString("id");
+        String channelId = msg.getString("channel_id", null);
+        boolean ephemeral = (msg.getInt("flags", 0) & 64) != 0;
+        String content = msg.getString("content", "");
+
+        List<String> handlerIds = new ArrayList<>();
+        for (RawControl c : controls) handlerIds.add(ComponentIdEnvelope.decode(c.customId).handlerId());
+
+        Target resolved =
+                resolveTarget(game, controls, channelId, ephemeral, interactionToken, interactionUser(msg), content);
+        Player player = resolved == null || resolved.userId() == null ? null : game.getPlayer(resolved.userId());
+        KindSpec spec = DecisionKinds.classify(handlerIds);
+        KindSpec.CaptureContext ctx =
+                new KindSpec.CaptureContext(game, channelId, messageId, content, ephemeral, resolved, player, handlerIds);
+        // A typed decision that can never be answered must not exist: an obsolete prompt stays legacy.
+        if (spec != null && obsolete(spec, ctx)) spec = null;
+        Target target = resolved;
+        if (spec != null) {
+            target = spec.target(ctx, resolved);
+            if (!Objects.equals(target, resolved)) {
+                player = target == null || target.userId() == null ? null : game.getPlayer(target.userId());
+                ctx = new KindSpec.CaptureContext(
+                        game, channelId, messageId, content, ephemeral, target, player, handlerIds);
+            }
+        }
+
+        boolean mixed = target != null && "mixed_owners".equals(target.resolvedBy());
+        List<Option> options = new ArrayList<>();
+        for (int i = 0; i < controls.size(); i++) {
+            RawControl c = controls.get(i);
+            String h = handlerIds.get(i);
+            Map<String, Object> value = null;
+            if (spec != null && h != null && spec.typesOption(h)) {
+                try {
+                    value = spec.value(h, ctx);
+                } catch (Exception e) {
+                    BotLogger.error("engine: kind " + spec.kind() + " failed to type option " + c.customId, e);
+                }
+            }
+            options.add(new Option(
+                    c.optionId(),
+                    c.label,
+                    c.style,
+                    c.emoji,
+                    c.disabled,
+                    c.customId.contains("~MDL") || (c.value == null && NativeCoverage.opensForm(h)),
+                    h,
+                    value,
+                    mixed ? optionOwner(game, c.customId) : null));
+        }
+        String visibility = ephemeral || isPrivateChannel(game, channelId) ? "private" : "public";
+        ReactionWindow window = null;
+        Progress progress = null;
+        if (spec != null) {
+            try {
+                window = spec.window(ctx);
+                if (spec.recordsResponses()) window = WindowResponses.merge(messageId, window);
+                progress = spec.progress(ctx);
+            } catch (Exception e) {
+                BotLogger.error("engine: kind " + spec.kind() + " failed to build window/progress", e);
+            }
+        }
+        String scope = window != null
+                ? "table"
+                : spec != null ? spec.scope(ctx) : (target == null || target.userId() == null ? "table" : "player");
+        String prefix = commonPrefix(handlerIds);
+
+        Decision existing = byIdOrNull(DecisionRegistry.decisionIdForMessage(messageId));
+        if (existing != null
+                && Objects.equals(existing.target(), target)
+                && sameOptions(existing.options(), options)
+                && Objects.equals(existing.prompt(), content)
+                && Objects.equals(existing.window(), window)
+                && Objects.equals(existing.progress(), progress)) return null;
+
+        // Stable per message: an edit in place (multi-step prompts) is the same decision, revision+1.
+        Decision d = new Decision(
+                "d" + messageId,
+                game.getName(),
+                spec == null ? DecisionKinds.LEGACY : spec.kind(),
+                0,
+                game.getLastModifiedDate(),
+                target,
+                scope,
+                visibility,
+                content,
+                options,
+                new Source(channelId, messageId, prefix, ephemeral),
+                existing != null ? existing.createdAt() : postedAt(messageId),
+                0,
+                window,
+                progress,
+                selectInputs(msg));
+        return d;
+    }
+
+    static List<RawControl> controls(DataObject msg) {
+        List<RawControl> controls = new ArrayList<>();
+        if (msg.hasKey("components") && !msg.isNull("components")) collect(msg.getArray("components"), controls);
+        return controls;
+    }
+
+    /**
+     * When the message was first posted (its snowflake), so edits keep the original time: undo closes decisions by
+     * the time their prompt was posted, and a board edited after the restored save is still the restored state's.
+     */
+    static long postedAt(String messageId) {
+        try {
+            return (Long.parseUnsignedLong(messageId) >>> 22) + 1420070400000L;
+        } catch (Exception e) {
+            return System.currentTimeMillis();
+        }
+    }
+
+    private static Decision byIdOrNull(String id) {
+        return id == null ? null : DecisionRegistry.get(id);
+    }
+
+    private static boolean sameOptions(List<Option> a, List<Option> b) {
+        if (a.size() != b.size()) return false;
+        for (int i = 0; i < a.size(); i++) {
+            Option x = a.get(i), y = b.get(i);
+            if (!x.id().equals(y.id()) || x.disabled() != y.disabled() || !Objects.equals(x.label(), y.label()))
+                return false;
+        }
+        return true;
+    }
+
+    // ------------------------------------------------------------------ target resolution
+
+    /** The user whose interaction produced this message (Discord's interaction_metadata / legacy interaction). */
+    static String interactionUser(DataObject msg) {
+        for (String key : new String[] {"interaction_metadata", "interaction"}) {
+            if (!msg.hasKey(key) || msg.isNull(key)) continue;
+            DataObject meta = msg.getObject(key);
+            if (meta.hasKey("user") && !meta.isNull("user")) return meta.getObject("user").getString("id", null);
+        }
+        return null;
+    }
+
+    /** Owner of one option of a mixed-owner menu (FFCC_/spoof prefix), null if the option has none. */
+    static Target optionOwner(Game game, String customId) {
+        ComponentIdEnvelope env = ComponentIdEnvelope.decode(customId);
+        String f = env.ownerFaction() != null ? env.ownerFaction() : env.spoofedFaction();
+        Player p = f == null ? null : game.getPlayerFromColorOrFaction(f);
+        return p == null ? null : target(p, env.ownerFaction() != null ? "owner_prefix" : "spoof_prefix");
+    }
+
+    static Target resolveTarget(
+            Game game,
+            List<RawControl> controls,
+            String channelId,
+            boolean ephemeral,
+            String token,
+            String metaUserId,
+            String content) {
+        // 1. FFCC_<faction>_ / dummyPlayerSpoof<faction>_ on the options (2,232 of 5,495 button sites).
+        Set<String> owners = new LinkedHashSet<>();
+        Set<String> spoofs = new LinkedHashSet<>();
+        int unowned = 0;
+        for (RawControl c : controls) {
+            ComponentIdEnvelope env = ComponentIdEnvelope.decode(c.customId);
+            if (env.ownerFaction() != null) owners.add(env.ownerFaction());
+            else if (env.spoofedFaction() != null) spoofs.add(env.spoofedFaction());
+            else unowned++;
+        }
+        if (owners.size() == 1 && spoofs.isEmpty()) {
+            Player p = game.getPlayerFromColorOrFaction(owners.iterator().next());
+            if (p != null) return target(p, "owner_prefix");
+        }
+        if (spoofs.size() == 1 && owners.isEmpty()) {
+            Player p = game.getPlayerFromColorOrFaction(spoofs.iterator().next());
+            if (p != null) return target(p, "spoof_prefix");
+        }
+        // 2. Interaction replies / followups / ephemerals: whoever made the interaction.
+        if (token != null) {
+            InteractionTracker.Info info = InteractionTracker.byToken(token);
+            if (info != null) {
+                Player p = game.getPlayer(info.userId());
+                if (p != null) return target(p, "interaction_user");
+            }
+        }
+        // 2b. Same fact from the message itself (interaction_metadata.user): survives restarts and unknown tokens.
+        if (metaUserId != null) {
+            Player p = game.getPlayer(metaUserId);
+            if (p != null) return target(p, "interaction_user");
+        }
+        // 3. The player's own cards-info thread / private channel.
+        for (Player p : game.getPlayers().values()) {
+            if (channelId != null && channelId.equals(p.getCardsInfoThreadID())) return target(p, "cards_thread");
+            if (channelId != null && channelId.equals(p.getPrivateChannelID())) return target(p, "private_channel");
+        }
+        // 4. Exactly one seated player mentioned (weak; kinds may override).
+        if (content != null && owners.isEmpty()) {
+            Set<String> mentioned = new HashSet<>();
+            Matcher mm = MENTION.matcher(content);
+            while (mm.find()) if (game.getPlayer(mm.group(1)) != null) mentioned.add(mm.group(1));
+            if (mentioned.size() == 1) return target(game.getPlayer(mentioned.iterator().next()), "mention");
+        }
+        return new Target(null, null, null, owners.size() > 1 ? "mixed_owners" : "none");
+    }
+
+    static boolean obsolete(KindSpec spec, KindSpec.CaptureContext ctx) {
+        try {
+            return spec.obsolete(ctx);
+        } catch (Exception e) {
+            return false;
+        }
+    }
+
+    public static Target target(Player p, String how) {
+        return new Target(p.getUserID(), nullIfUnset(p.getFaction()), nullIfUnset(p.getColor()), how);
+    }
+
+    /** Player.getFaction()/getColor() return the string "null" before a faction/colour is picked. */
+    static String nullIfUnset(String s) {
+        return s == null || s.isBlank() || "null".equals(s) ? null : s;
+    }
+
+    private static boolean isPrivateChannel(Game game, String channelId) {
+        if (channelId == null) return false;
+        for (Player p : game.getPlayers().values()) {
+            if (channelId.equals(p.getCardsInfoThreadID()) || channelId.equals(p.getPrivateChannelID())) return true;
+        }
+        return false;
+    }
+
+    /** channel id -> game name, for channels JDA has not cached (threads after a restart, private channels). */
+    private static final Map<String, String> channelGame = new ConcurrentHashMap<>();
+    private static volatile long lastScan;
+
+    static Game gameForChannel(String channelId) {
+        if (channelId == null || JdaService.jda == null) return null;
+        String name = null;
+        Channel ch = JdaService.jda.getChannelById(Channel.class, channelId);
+        if (ch != null) name = GameNameService.getGameNameFromChannel(ch);
+        if (name == null || !GameManager.isValid(name)) name = channelGame.get(channelId);
+        if (name == null) name = scanForChannel(channelId);
+        if (name == null) return null;
+        return cachedGame(name);
+    }
+
+    private record Loaded(long mtime, Game game) {}
+
+    private static final Map<String, Loaded> loaded = new ConcurrentHashMap<>();
+
+    /**
+     * Capture only reads the game (players, factions, threads). GameManager loads it from disk on every access, which
+     * put a full game parse on the JDA REST thread for every message with buttons (p95 80 ms, max 2 s live). Reuse
+     * the last load until the game file changes (one stat per message).
+     */
+    static Game cachedGame(String name) {
+        java.io.File f = ti4.helpers.Storage.getGameFile(name + ti4.helpers.Constants.TXT);
+        long mtime = f.lastModified();
+        Loaded hit = loaded.get(name);
+        if (hit != null && hit.mtime() == mtime && mtime != 0) return hit.game();
+        ManagedGame mg = GameManager.getManagedGame(name);
+        Game g = mg == null ? null : mg.getGame();
+        if (g != null) {
+            if (loaded.size() > 200) loaded.clear();
+            loaded.put(name, new Loaded(mtime, g));
+        }
+        return g;
+    }
+
+    /**
+     * A channel JDA does not know by name (uncached thread, private channel): find the live game that owns it via
+     * its players' cards-info threads / private channels. Rescans at most every 10 s.
+     */
+    private static String scanForChannel(String channelId) {
+        long now = System.currentTimeMillis();
+        if (now - lastScan < 10_000 || !JdaService.isReadyToReceiveCommands()) return null;
+        lastScan = now;
+        try {
+            for (ManagedGame mg : GameManager.getManagedGames()) {
+                if (mg.isHasEnded() || now - mg.getLastModifiedDate() > 24L * 3600 * 1000) continue;
+                Game g = cachedGame(mg.getName());
+                if (g == null) continue;
+                for (Player p : g.getPlayers().values()) {
+                    if (p.getCardsInfoThreadID() != null) channelGame.put(p.getCardsInfoThreadID(), g.getName());
+                    if (p.getPrivateChannelID() != null) channelGame.put(p.getPrivateChannelID(), g.getName());
+                }
+            }
+        } catch (Exception e) {
+            BotLogger.error("engine: channel scan failed", e);
+        }
+        return channelGame.get(channelId);
+    }
+
+    // ------------------------------------------------------------------ components
+
+    record RawControl(String customId, String label, String style, String emoji, boolean disabled, String value) {
+        String optionId() {
+            return value == null ? customId : customId + "#" + value;
+        }
+    }
+
+    private static final String[] STYLES = {"", "primary", "secondary", "success", "danger", "link", "premium"};
+
+    private static void collect(DataArray arr, List<RawControl> out) {
+        for (int i = 0; i < arr.length(); i++) {
+            if (!arr.isType(i, net.dv8tion.jda.api.utils.data.DataType.OBJECT)) continue;
+            DataObject c = arr.getObject(i);
+            int type = c.getInt("type", 0);
+            if (type == 2 && c.hasKey("custom_id") && !c.isNull("custom_id")) {
+                int style = c.getInt("style", 2);
+                String emoji = null;
+                if (c.hasKey("emoji") && !c.isNull("emoji")) {
+                    DataObject e = c.getObject("emoji");
+                    emoji = e.isNull("id") || !e.hasKey("id") ? e.getString("name", null) : e.getString("id", null);
+                }
+                out.add(new RawControl(
+                        c.getString("custom_id"),
+                        c.getString("label", ""),
+                        style >= 0 && style < STYLES.length ? STYLES[style] : String.valueOf(style),
+                        emoji,
+                        c.getBoolean("disabled", false),
+                        null));
+            } else if (type == 3 && c.hasKey("custom_id")) {
+                DataArray opts = c.optArray("options").orElse(DataArray.empty());
+                for (int j = 0; j < opts.length(); j++) {
+                    DataObject o = opts.getObject(j);
+                    out.add(new RawControl(
+                            c.getString("custom_id"),
+                            o.getString("label", ""),
+                            "select",
+                            null,
+                            c.getBoolean("disabled", false),
+                            o.getString("value", "")));
+                }
+            }
+            if (c.hasKey("components") && !c.isNull("components")) collect(c.getArray("components"), out);
+            if (c.hasKey("accessory") && !c.isNull("accessory"))
+                collect(DataArray.empty().add(c.getObject("accessory")), out);
+        }
+    }
+
+    /** Select menus on the message as typed inputs (one "choice" field each). null when there are none. */
+    static List<InputSchema> selectInputs(DataObject msg) {
+        List<InputSchema> out = new ArrayList<>();
+        if (msg.hasKey("components") && !msg.isNull("components")) collectSelects(msg.getArray("components"), out);
+        return out.isEmpty() ? null : out;
+    }
+
+    private static void collectSelects(DataArray arr, List<InputSchema> out) {
+        for (int i = 0; i < arr.length(); i++) {
+            if (!arr.isType(i, net.dv8tion.jda.api.utils.data.DataType.OBJECT)) continue;
+            DataObject c = arr.getObject(i);
+            if (c.getInt("type", 0) == 3 && c.hasKey("custom_id")) {
+                List<Choice> choices = new ArrayList<>();
+                DataArray opts = c.optArray("options").orElse(DataArray.empty());
+                for (int j = 0; j < opts.length(); j++) {
+                    DataObject o = opts.getObject(j);
+                    choices.add(new Choice(
+                            o.getString("value", ""),
+                            o.getString("label", ""),
+                            o.getString("description", null),
+                            o.getBoolean("default", false)));
+                }
+                int min = c.getInt("min_values", 1), max = c.getInt("max_values", 1);
+                String placeholder = c.getString("placeholder", null);
+                out.add(new InputSchema(
+                        c.getString("custom_id"),
+                        "select",
+                        placeholder,
+                        List.of(new InputField(
+                                "values", placeholder, "choice", min > 0, null, null, min, max, false, placeholder,
+                                null, choices))));
+            }
+            if (c.hasKey("components") && !c.isNull("components")) collectSelects(c.getArray("components"), out);
+        }
+    }
+
+    private static String commonPrefix(List<String> ids) {
+        Set<String> heads = new LinkedHashSet<>();
+        for (String h : ids) {
+            if (h == null) continue;
+            int us = h.indexOf('_');
+            heads.add(us < 0 ? h : h.substring(0, us + 1));
+        }
+        return heads.isEmpty() ? null : heads.iterator().next();
+    }
+
+    // ------------------------------------------------------------------ http helpers
+
+    private static DataObject responseJson(Response res) throws IOException {
+        if (res.body() == null) return null;
+        String s = res.peekBody(16L * 1024 * 1024).string();
+        if (s.isBlank() || !s.trim().startsWith("{")) return null;
+        return DataObject.fromJson(s);
+    }
+
+    private static String nonce(Request req) {
+        try {
+            if (req.body() == null || req.body().contentType() == null
+                    || !"json".equals(req.body().contentType().subtype())) return "";
+            return DataObject.fromJson(bodyString(req)).getString("nonce", "");
+        } catch (Exception e) {
+            return "";
+        }
+    }
+
+    private static String bodyString(Request req) throws IOException {
+        if (req.body() == null) return "{}";
+        Buffer b = new Buffer();
+        req.body().writeTo(b);
+        return b.readUtf8();
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/DecisionKinds.java b/src/main/java/ti4/selfhost/engine/DecisionKinds.java
new file mode 100644
index 0000000..0a37097
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/DecisionKinds.java
@@ -0,0 +1,65 @@
+package ti4.selfhost.engine;
+
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.List;
+import org.reflections.Reflections;
+import org.reflections.scanners.Scanners;
+import org.reflections.scanners.SubTypesScanner;
+import org.reflections.util.ClasspathHelper;
+import org.reflections.util.ConfigurationBuilder;
+import ti4.logging.BotLogger;
+
+/** All {@link KindSpec}s under ti4.selfhost.engine.kinds, highest priority first. */
+public final class DecisionKinds {
+    public static final String LEGACY = "legacy";
+
+    private static volatile List<KindSpec> specs;
+
+    private DecisionKinds() {}
+
+    public static List<KindSpec> all() {
+        List<KindSpec> s = specs;
+        if (s != null) return s;
+        synchronized (DecisionKinds.class) {
+            if (specs != null) return specs;
+            List<KindSpec> found = new ArrayList<>();
+            try {
+                // Same scan as AnnotationHandler.getAllClasses (known to work for the deployed -jar layout).
+                Reflections r = new Reflections(new ConfigurationBuilder()
+                        .setUrls(ClasspathHelper.forJavaClassPath())
+                        .setScanners(new SubTypesScanner(false)));
+                for (Class<?> raw : r.get(Scanners.SubTypes.of(Object.class).asClass())) {
+                    if (!KindSpec.class.isAssignableFrom(raw)) continue;
+                    @SuppressWarnings("unchecked")
+                    Class<? extends KindSpec> c = (Class<? extends KindSpec>) raw;
+                    if (c.isInterface() || java.lang.reflect.Modifier.isAbstract(c.getModifiers())) continue;
+                    if (!c.getPackageName().startsWith("ti4.selfhost.engine.kinds")) continue;
+                    try {
+                        found.add(c.getDeclaredConstructor().newInstance());
+                    } catch (Exception e) {
+                        BotLogger.error("engine: cannot instantiate decision kind " + c.getName(), e);
+                    }
+                }
+            } catch (Exception e) {
+                BotLogger.error("engine: decision kind scan failed", e);
+            }
+            found.sort(Comparator.comparingInt(KindSpec::priority).reversed().thenComparing(KindSpec::kind));
+            specs = List.copyOf(found);
+            BotLogger.info("engine: " + specs.size() + " decision kinds: "
+                    + specs.stream().map(KindSpec::kind).toList());
+            return specs;
+        }
+    }
+
+    public static KindSpec byKind(String kind) {
+        for (KindSpec k : all()) if (k.kind().equals(kind)) return k;
+        return null;
+    }
+
+    /** The kind for a message given its options' handler ids; null = legacy. */
+    public static KindSpec classify(List<String> handlerIds) {
+        for (KindSpec k : all()) if (k.classifies(handlerIds)) return k;
+        return null;
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/DecisionRebuild.java b/src/main/java/ti4/selfhost/engine/DecisionRebuild.java
new file mode 100644
index 0000000..dad1aaf
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/DecisionRebuild.java
@@ -0,0 +1,129 @@
+package ti4.selfhost.engine;
+
+import java.util.ArrayList;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Set;
+import java.util.concurrent.TimeUnit;
+import net.dv8tion.jda.api.utils.data.DataArray;
+import net.dv8tion.jda.api.utils.data.DataObject;
+import okhttp3.OkHttpClient;
+import okhttp3.Request;
+import okhttp3.Response;
+import ti4.discord.JdaService;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.game.persistence.GameManager;
+import ti4.game.persistence.ManagedGame;
+import ti4.logging.BotLogger;
+
+/**
+ * The registry lives in memory, so after a bot restart it is empty although the prompts are still on screen (the
+ * shim keeps every message). On startup — and on demand per game (POST .../{game}/rebuild) — re-read the recent
+ * bot messages of each live game's channels (actions, table talk, bot-map thread, every player's cards-info thread and
+ * private channel) and feed the ones that still carry components through the normal capture path, oldest first.
+ * Targets resolve exactly as at capture time (owner prefix, cards thread, interaction_metadata.user, kind overrides).
+ * Ephemeral replies are not readable through the channel and stay lost until the engine re-asks.
+ */
+public final class DecisionRebuild {
+    private static final int PER_CHANNEL = 100;
+    /** Games saved within this window count as live (abandoned soak/test games are rarely ended). */
+    private static final long LIVE_WINDOW_MS = TimeUnit.HOURS.toMillis(24);
+
+    private DecisionRebuild() {}
+
+    /** Called once from Engine.registerListeners; waits for the bot to be ready, then rebuilds every live game. */
+    static void scheduleStartupRebuild() {
+        Thread.ofVirtual().name("engine-rebuild").start(() -> {
+            try {
+                long deadline = System.currentTimeMillis() + TimeUnit.MINUTES.toMillis(15);
+                while (!JdaService.isReadyToReceiveCommands() && System.currentTimeMillis() < deadline)
+                    Thread.sleep(2000);
+                if (!JdaService.isReadyToReceiveCommands()) {
+                    BotLogger.warning("engine: bot never became ready; decision registry not rebuilt");
+                    return;
+                }
+                long t0 = System.currentTimeMillis();
+                int games = 0, opened = 0;
+                for (ManagedGame mg : GameManager.getManagedGames()) {
+                    if (mg.isHasEnded() || System.currentTimeMillis() - mg.getLastModifiedDate() > LIVE_WINDOW_MS)
+                        continue;
+                    try {
+                        opened += rebuild(mg.getGame());
+                        games++;
+                        Thread.sleep(100); // stay out of the way of live play while catching up
+                    } catch (Exception e) {
+                        BotLogger.error("engine: rebuild failed for " + mg.getName(), e);
+                    }
+                }
+                BotLogger.info("engine: rebuilt " + opened + " open decisions in " + games + " live games ("
+                        + (System.currentTimeMillis() - t0) + " ms)");
+            } catch (InterruptedException e) {
+                Thread.currentThread().interrupt();
+            } catch (Exception e) {
+                BotLogger.error("engine: startup rebuild failed", e);
+            }
+        });
+    }
+
+    /** Re-captures one game's open prompts; returns how many decisions are open for it afterwards. */
+    public static int rebuild(Game game) throws Exception {
+        String botId = JdaService.getBotId();
+        Set<String> channels = new LinkedHashSet<>();
+        add(channels, game.getMainChannelID());
+        add(channels, game.getTableTalkChannelID());
+        add(channels, game.getBotMapUpdatesThreadID());
+        for (Player p : game.getPlayers().values()) {
+            add(channels, p.getCardsInfoThreadID());
+            add(channels, p.getPrivateChannelID());
+        }
+        // Strategy-card follow threads, combat threads, etc.: "<game>-…" threads JDA knows.
+        String prefix = game.getName() + "-";
+        for (var t : JdaService.jda.getThreadChannels()) {
+            if (t.getName().startsWith(prefix)) add(channels, t.getId());
+        }
+        List<DataObject> messages = new ArrayList<>();
+        for (String ch : channels) {
+            DataArray arr = fetch(ch);
+            if (arr == null) continue;
+            for (int i = 0; i < arr.length(); i++) {
+                DataObject m = arr.getObject(i);
+                if (!m.hasKey("components") || m.isNull("components") || m.getArray("components").isEmpty()) continue;
+                DataObject author = m.optObject("author").orElse(null);
+                if (author == null || !botId.equals(author.getString("id", ""))) continue;
+                if (!m.hasKey("channel_id") || m.isNull("channel_id")) m.put("channel_id", ch);
+                messages.add(m);
+            }
+        }
+        // Oldest first, so a later prompt on the same message wins and seq order follows the game.
+        messages.sort((a, b) -> Long.compareUnsigned(Long.parseUnsignedLong(a.getString("id")),
+                Long.parseUnsignedLong(b.getString("id"))));
+        for (DataObject m : messages) {
+            EngineMetrics.count("rebuild.message");
+            DecisionCapture.onMessage(m, null, game);
+        }
+        return DecisionRegistry.openDecisions(game.getName()).size();
+    }
+
+    private static void add(Set<String> s, String id) {
+        if (id != null && !id.isBlank() && id.chars().allMatch(Character::isDigit)) s.add(id);
+    }
+
+    private static DataArray fetch(String channelId) throws Exception {
+        String base = System.getenv("DISCORD_API_BASE");
+        if (base == null) return null;
+        String token = JdaService.jda.getToken();
+        if (!token.startsWith("Bot ")) token = "Bot " + token;
+        OkHttpClient http = JdaService.jda.getHttpClient().newBuilder().callTimeout(10, TimeUnit.SECONDS).build();
+        Request request = new Request.Builder()
+                .url(base.replaceAll("/+$", "") + "/channels/" + channelId + "/messages?limit=" + PER_CHANNEL)
+                .header("Authorization", token)
+                .get()
+                .build();
+        try (Response res = http.newCall(request).execute()) {
+            if (!res.isSuccessful() || res.body() == null) return null;
+            String text = res.body().string();
+            return text.trim().startsWith("[") ? DataArray.fromJson(text) : null;
+        }
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/DecisionRegistry.java b/src/main/java/ti4/selfhost/engine/DecisionRegistry.java
new file mode 100644
index 0000000..dcb3e09
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/DecisionRegistry.java
@@ -0,0 +1,157 @@
+package ti4.selfhost.engine;
+
+import java.util.ArrayDeque;
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.Deque;
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.CopyOnWriteArrayList;
+import java.util.function.Consumer;
+import ti4.selfhost.engine.EngineModels.Decision;
+import ti4.selfhost.engine.EngineModels.EngineEvent;
+
+/**
+ * Open decisions per game plus the ordered event log (ring buffer) that the stream endpoint replays. One global seq
+ * orders every event of every game. In memory only: after a bot restart clients re-read the snapshot (the bot re-sends
+ * no buttons on restart, so decisions opened before a restart reappear only when the engine re-asks; see ENGINE.md).
+ */
+public final class DecisionRegistry {
+    private static final int LOG_SIZE = 5000;
+
+    private static long seq;
+    private static final Deque<EngineEvent> log = new ArrayDeque<>();
+    /** game -> decision id -> decision */
+    private static final Map<String, Map<String, Decision>> open = new ConcurrentHashMap<>();
+    /** message id -> decision id (one open revision per message) */
+    private static final Map<String, String> byMessage = new ConcurrentHashMap<>();
+    private static final Map<String, String> gameOfDecision = new ConcurrentHashMap<>();
+    private static final List<Consumer<EngineEvent>> listeners = new CopyOnWriteArrayList<>();
+
+    private DecisionRegistry() {}
+
+    public static synchronized long currentSeq() {
+        return seq;
+    }
+
+    /** Opens (or replaces the open revision on the same message with) a decision. Returns the stored decision. */
+    // Listeners are called under the registry lock so they see events in seq order; they must not block
+    // (the stream endpoint only enqueues).
+
+    /**
+     * Opens a decision, or — when the same message already has an open decision with the same id — replaces it in
+     * place (revision+1, event decision.updated). A different decision on the message closes the old one.
+     */
+    public static synchronized Decision open(Decision d) {
+        String prevId = byMessage.get(d.source().messageId());
+        Decision prev = prevId == null ? null : get(prevId);
+        if (prev != null && prev.id().equals(d.id()) && prev.game().equals(d.game())) {
+            d = d.withSeq(++seq, prev.revision() + 1);
+            open.get(d.game()).put(d.id(), d);
+            fire(append(new EngineEvent(d.seq(), "decision.updated", d.game(), d.stateVersion(), d, null)));
+            return d;
+        }
+        if (prevId != null) closeLocked(prevId, "replaced");
+        d = d.withSeq(++seq, 1);
+        open.computeIfAbsent(d.game(), g -> new ConcurrentHashMap<>()).put(d.id(), d);
+        byMessage.put(d.source().messageId(), d.id());
+        gameOfDecision.put(d.id(), d.game());
+        fire(append(new EngineEvent(d.seq(), "decision.opened", d.game(), d.stateVersion(), d, null)));
+        return d;
+    }
+
+    /** Replaces an open decision in place (same id), e.g. a new target or window; emits decision.updated. */
+    public static synchronized Decision update(Decision d) {
+        Map<String, Decision> m = open.get(d.game());
+        Decision prev = m == null ? null : m.get(d.id());
+        if (prev == null) return null;
+        d = d.withSeq(++seq, prev.revision() + 1);
+        m.put(d.id(), d);
+        fire(append(new EngineEvent(d.seq(), "decision.updated", d.game(), d.stateVersion(), d, null)));
+        return d;
+    }
+
+    public static synchronized void closeByMessage(String messageId, String reason) {
+        String id = byMessage.get(messageId);
+        if (id != null) closeLocked(id, reason);
+    }
+
+    public static synchronized void close(String decisionId, String reason) {
+        closeLocked(decisionId, reason);
+    }
+
+    private static EngineEvent closeLocked(String decisionId, String reason) {
+        String game = gameOfDecision.remove(decisionId);
+        if (game == null) return null;
+        Map<String, Decision> m = open.get(game);
+        Decision d = m == null ? null : m.remove(decisionId);
+        if (d == null) return null;
+        byMessage.remove(d.source().messageId(), decisionId);
+        EngineEvent ev = append(new EngineEvent(++seq, "decision.closed", game, d.stateVersion(), d, reason));
+        fire(ev);
+        return ev;
+    }
+
+    public static synchronized void stateChanged(String game, long stateVersion) {
+        fire(append(new EngineEvent(++seq, "state.changed", game, stateVersion, null, null)));
+    }
+
+    public static Decision get(String decisionId) {
+        String game = gameOfDecision.get(decisionId);
+        if (game == null) return null;
+        Map<String, Decision> m = open.get(game);
+        return m == null ? null : m.get(decisionId);
+    }
+
+    public static String decisionIdForMessage(String messageId) {
+        return byMessage.get(messageId);
+    }
+
+    public static List<Decision> openDecisions(String game) {
+        Map<String, Decision> m = open.get(game);
+        if (m == null) return List.of();
+        List<Decision> out = new ArrayList<>(m.values());
+        out.sort((a, b) -> Long.compare(a.seq(), b.seq()));
+        return out;
+    }
+
+    /** Events with seq > after (optionally one game). null when `after` is older than the buffer: re-snapshot. */
+    public static synchronized List<EngineEvent> since(long after, String game) {
+        if (!log.isEmpty() && after < log.peekFirst().seq() - 1 && after < seq) return null;
+        List<EngineEvent> out = new ArrayList<>();
+        for (EngineEvent e : log) if (e.seq() > after && (game == null || game.equals(e.game()))) out.add(e);
+        return out;
+    }
+
+    public static List<Decision> openedAfter(String game, long after) {
+        List<Decision> out = new ArrayList<>();
+        for (Decision d : openDecisions(game)) if (d.seq() > after) out.add(d);
+        return out;
+    }
+
+    public static Runnable subscribe(Consumer<EngineEvent> l) {
+        listeners.add(l);
+        return () -> listeners.remove(l);
+    }
+
+    public static Collection<String> games() {
+        return open.keySet();
+    }
+
+    private static EngineEvent append(EngineEvent e) {
+        log.addLast(e);
+        while (log.size() > LOG_SIZE) log.removeFirst();
+        return e;
+    }
+
+    private static void fire(EngineEvent e) {
+        for (Consumer<EngineEvent> l : listeners) {
+            try {
+                l.accept(e);
+            } catch (Exception ignored) {
+                // a broken subscriber must not break the engine
+            }
+        }
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/Engine.java b/src/main/java/ti4/selfhost/engine/Engine.java
new file mode 100644
index 0000000..1cf8a7e
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/Engine.java
@@ -0,0 +1,99 @@
+package ti4.selfhost.engine;
+
+import java.util.Objects;
+import net.dv8tion.jda.api.JDA;
+import ti4.game.Game;
+import ti4.logging.BotLogger;
+import ti4.selfhost.SelfHosted;
+import ti4.game.Player;
+import ti4.selfhost.engine.EngineModels.Decision;
+import ti4.selfhost.engine.EngineModels.Progress;
+import ti4.selfhost.engine.EngineModels.ReactionWindow;
+import ti4.selfhost.engine.EngineModels.Target;
+
+/**
+ * Entry points the (tiny) patches into upstream code call. Enabled when self-hosted unless TI4_ENGINE=off.
+ * Capture is passive; nothing changes for Discord-style play when no client uses the engine API.
+ */
+public final class Engine {
+    private static final boolean ENABLED =
+            SelfHosted.isEnabled() && !"off".equalsIgnoreCase(System.getenv().getOrDefault("TI4_ENGINE", "on"));
+
+    private Engine() {}
+
+    public static boolean enabled() {
+        return ENABLED;
+    }
+
+    /** JdaService: after build(). */
+    public static void registerListeners(JDA jda) {
+        if (!ENABLED) return;
+        jda.addEventListener(new InteractionTracker());
+        ti4.selfhost.engine.interaction.NativeCoverage.warmUp();
+        BotLogger.info("engine: decision capture on (" + DecisionKinds.all().size() + " typed kinds)");
+        DecisionRebuild.scheduleStartupRebuild();
+    }
+
+    /** A prompt posted up to this long after a save belongs to that save's action (same rule as UndoService). */
+    static final long UNDO_SLACK_MS = 1500;
+
+    /**
+     * UndoJournal.recordUndo (Discord UNDO button, web undo and rewind alike), called after the restored save is
+     * loaded and before the bot re-posts the restored prompt: every decision asked after the restored save belongs to
+     * an undone action and closes ("undone"), including ephemerals and private-channel prompts the undo cannot delete.
+     */
+    public static void onUndo(String gameName, long restoredSavedAt) {
+        if (!ENABLED || gameName == null) return;
+        try {
+            long from = restoredSavedAt + UNDO_SLACK_MS;
+            int n = 0;
+            for (Decision d : DecisionRegistry.openDecisions(gameName)) {
+                if (d.createdAt() >= from) {
+                    DecisionRegistry.close(d.id(), "undone");
+                    n++;
+                }
+            }
+            if (n > 0) EngineMetrics.count("undo.closed");
+        } catch (Exception e) {
+            BotLogger.error("engine: undo hook failed for " + gameName, e);
+        }
+    }
+
+    /** GameWebStatePipeline.queue: every save and every undo. */
+    public static void onStateChanged(Game game) {
+        if (!ENABLED || game == null) return;
+        try {
+            DecisionRegistry.stateChanged(game.getName(), game.getLastModifiedDate());
+            retarget(game);
+        } catch (Exception e) {
+            BotLogger.error("engine: state change hook failed for " + game.getName(), e);
+        }
+    }
+
+    /** Kinds that are dynamic() get target / window / progress recomputed after each state change. */
+    private static void retarget(Game game) {
+        for (Decision d : DecisionRegistry.openDecisions(game.getName())) {
+            KindSpec spec = DecisionKinds.byKind(d.kind());
+            if (spec == null || !spec.dynamic()) continue;
+            Player p = d.target() == null || d.target().userId() == null ? null : game.getPlayer(d.target().userId());
+            KindSpec.CaptureContext ctx = new KindSpec.CaptureContext(
+                    game, d.source().channelId(), d.source().messageId(), d.prompt(), d.source().ephemeral(),
+                    d.target(), p);
+            if (DecisionCapture.obsolete(spec, ctx)) {
+                // Every answer would be refused now (e.g. the round's objective is already revealed): close it.
+                DecisionRegistry.close(d.id(), "obsolete");
+                continue;
+            }
+            Target t = spec.target(ctx, d.target());
+            Player tp = t == null || t.userId() == null ? null : game.getPlayer(t.userId());
+            ctx = new KindSpec.CaptureContext(
+                    game, d.source().channelId(), d.source().messageId(), d.prompt(), d.source().ephemeral(), t, tp);
+            ReactionWindow w = spec.window(ctx);
+            if (spec.recordsResponses()) w = WindowResponses.merge(d.source().messageId(), w);
+            Progress pr = spec.progress(ctx);
+            if (Objects.equals(t, d.target()) && Objects.equals(w, d.window()) && Objects.equals(pr, d.progress()))
+                continue;
+            DecisionRegistry.update(d.withDynamic(game.getLastModifiedDate(), t, w, pr));
+        }
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/EngineController.java b/src/main/java/ti4/selfhost/engine/EngineController.java
new file mode 100644
index 0000000..e7c765c
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/EngineController.java
@@ -0,0 +1,256 @@
+package ti4.selfhost.engine;
+
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.LinkedBlockingQueue;
+import java.util.concurrent.TimeUnit;
+import org.springframework.http.CacheControl;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.MediaType;
+import org.springframework.http.ResponseEntity;
+import org.springframework.security.access.prepost.PreAuthorize;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestHeader;
+import org.springframework.web.bind.annotation.RequestParam;
+import org.springframework.web.bind.annotation.RestController;
+import org.springframework.web.servlet.mvc.method.annotation.SseEmitter;
+import ti4.discord.JdaService;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.game.persistence.GameManager;
+import ti4.game.persistence.ManagedGame;
+import ti4.selfhost.engine.EngineModels.AnswerRequest;
+import ti4.selfhost.engine.EngineModels.AnswerResult;
+import ti4.selfhost.engine.EngineModels.Decision;
+import ti4.selfhost.engine.EngineModels.EngineEvent;
+import ti4.spring.context.RequestContext;
+
+/**
+ * Engine API. Two audiences:
+ * <ul>
+ *   <li>The shim (trusted; {@code Authorization: Bot <bot token>}, i.e. the shim's own state.bot_token), under
+ *   /api/public/selfhost/engine/** — full state with any viewer's hand, every decision, answer as any seated user,
+ *   and the SSE firehose. The shim fans out to browsers and drives autopilot seats.</li>
+ *   <li>A seat ({@code Authorization: Bearer <seat token>}) under /api/game/{game}/engine/** — own view only.</li>
+ * </ul>
+ */
+@RestController
+public class EngineController {
+
+    // ------------------------------------------------------------------ trusted (shim)
+
+    @GetMapping("/api/public/selfhost/engine/{game}/state")
+    public ResponseEntity<?> state(
+            @PathVariable String game,
+            @RequestParam(required = false) String viewer,
+            @RequestHeader(value = "Authorization", required = false) String auth) {
+        Game g = game(game);
+        if (g == null) return notFound();
+        String v = trusted(auth) ? viewer : null; // without the bot token: public view (no hand)
+        return ok(StateSnapshotBuilder.build(g, v));
+    }
+
+    @GetMapping("/api/public/selfhost/engine/{game}/decisions")
+    public ResponseEntity<?> decisions(
+            @PathVariable String game, @RequestHeader(value = "Authorization", required = false) String auth) {
+        if (!trusted(auth)) return unauthorized();
+        return ok(Map.of("seq", DecisionRegistry.currentSeq(), "decisions", DecisionRegistry.openDecisions(game)));
+    }
+
+    @PostMapping("/api/public/selfhost/engine/{game}/decisions/{id}/answer")
+    public ResponseEntity<?> answerAs(
+            @PathVariable String game,
+            @PathVariable String id,
+            @RequestBody AnswerRequest req,
+            @RequestHeader(value = "Authorization", required = false) String auth) {
+        if (!trusted(auth)) return unauthorized();
+        if (req.userId() == null) return ResponseEntity.badRequest().body(Map.of("error", "userId required"));
+        return answerResponse(ActionInvoker.answer(game, id, req.userId(), req));
+    }
+
+    /** Counters since start plus open-decision coverage (typed %, weak targets, top untyped prefixes, latency). */
+    @GetMapping("/api/public/selfhost/engine/metrics")
+    public ResponseEntity<?> metrics(
+            @RequestParam(required = false) String game,
+            @RequestHeader(value = "Authorization", required = false) String auth) {
+        if (!trusted(auth)) return unauthorized();
+        return ok(EngineMetrics.snapshot(game));
+    }
+
+    /** Re-reads the game's recent bot messages and re-captures every prompt still on screen (after a restart). */
+    @PostMapping("/api/public/selfhost/engine/{game}/rebuild")
+    public ResponseEntity<?> rebuild(
+            @PathVariable String game, @RequestHeader(value = "Authorization", required = false) String auth) {
+        if (!trusted(auth)) return unauthorized();
+        Game g = game(game);
+        if (g == null) return notFound();
+        try {
+            int open = DecisionRebuild.rebuild(g);
+            return ok(Map.of("open", open, "seq", DecisionRegistry.currentSeq()));
+        } catch (Exception e) {
+            return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR).body(Map.of("error", String.valueOf(e)));
+        }
+    }
+
+    /**
+     * Which handlers an answer can run as an engine-native Interaction (static analysis, see NativeCoverage).
+     * ?handlers=true lists the non-native ones with the operations that keep them on the synthetic path.
+     */
+    @GetMapping("/api/public/selfhost/engine/coverage")
+    public ResponseEntity<?> coverage(
+            @RequestParam(required = false) Boolean handlers,
+            @RequestHeader(value = "Authorization", required = false) String auth) {
+        if (!trusted(auth)) return unauthorized();
+        var r = ti4.selfhost.engine.interaction.NativeCoverage.report();
+        if (Boolean.TRUE.equals(handlers)) return ok(r);
+        return ok(new ti4.selfhost.engine.interaction.NativeCoverage.Report(
+                r.handlers(), r.nativeHandlers(), r.nativePercent(), r.directHandlers(), r.directPercent(),
+                r.byKind(), r.opUsage(), r.unsupportedOps(), r.pipelineUnsupported(), List.of()));
+    }
+
+    /**
+     * Server-sent events, one per EngineEvent (event name = type, id = seq, data = EngineEvent JSON). Resume with
+     * ?after=&lt;seq&gt; (or the Last-Event-ID header). If the buffer no longer covers `after`, a "reset" event
+     * tells the client to re-read state + decisions and continue from the seq given there.
+     */
+    @GetMapping(value = "/api/public/selfhost/engine/stream", produces = MediaType.TEXT_EVENT_STREAM_VALUE)
+    public Object stream(
+            @RequestParam(required = false) Long after,
+            @RequestParam(required = false) String game,
+            @RequestHeader(value = "Last-Event-ID", required = false) String lastEventId,
+            @RequestHeader(value = "Authorization", required = false) String auth) {
+        if (!trusted(auth)) return unauthorized();
+        long from = after != null ? after : lastEventId != null ? parse(lastEventId) : DecisionRegistry.currentSeq();
+        SseEmitter emitter = new SseEmitter(0L);
+        LinkedBlockingQueue<EngineEvent> queue = new LinkedBlockingQueue<>();
+        Runnable unsubscribe = DecisionRegistry.subscribe(e -> {
+            if (game == null || game.equals(e.game())) queue.add(e);
+        });
+        List<EngineEvent> backlog = DecisionRegistry.since(from, game);
+        Thread.ofVirtual().name("engine-sse").start(() -> {
+            try {
+                long sent = from;
+                if (backlog == null) {
+                    emitter.send(SseEmitter.event()
+                            .name("reset")
+                            .data(Map.of("seq", DecisionRegistry.currentSeq()), MediaType.APPLICATION_JSON));
+                    sent = DecisionRegistry.currentSeq();
+                } else {
+                    for (EngineEvent e : backlog) {
+                        send(emitter, e);
+                        sent = e.seq();
+                    }
+                }
+                while (true) {
+                    EngineEvent e = queue.poll(15, TimeUnit.SECONDS);
+                    if (e == null) {
+                        emitter.send(SseEmitter.event().comment("ping"));
+                        continue;
+                    }
+                    if (e.seq() <= sent) continue; // already in the backlog
+                    send(emitter, e);
+                    sent = e.seq();
+                }
+            } catch (Exception closed) {
+                // client went away
+            } finally {
+                unsubscribe.run();
+                emitter.complete();
+            }
+        });
+        emitter.onCompletion(unsubscribe);
+        emitter.onTimeout(unsubscribe);
+        emitter.onError(t -> unsubscribe.run());
+        return emitter;
+    }
+
+    // ------------------------------------------------------------------ seat (own view)
+
+    @GetMapping("/api/game/{gameName}/engine/state")
+    @PreAuthorize("@security.canAccessGame(#gameName)")
+    public ResponseEntity<?> myState(@PathVariable String gameName) {
+        Player me = RequestContext.getPlayer();
+        return ok(StateSnapshotBuilder.build(RequestContext.getGame(), me == null ? null : me.getUserID()));
+    }
+
+    @GetMapping("/api/game/{gameName}/engine/decisions")
+    @PreAuthorize("@security.canAccessGame(#gameName)")
+    public ResponseEntity<?> myDecisions(@PathVariable String gameName) {
+        Player me = RequestContext.getPlayer();
+        List<Decision> out = new ArrayList<>();
+        for (Decision d : DecisionRegistry.openDecisions(gameName)) if (visibleTo(d, me)) out.add(d);
+        return ok(Map.of("seq", DecisionRegistry.currentSeq(), "decisions", out));
+    }
+
+    @PostMapping("/api/game/{gameName}/engine/decisions/{id}/answer")
+    @PreAuthorize("@security.canAccessGame(#gameName)")
+    // No request-context lock/save: games are loaded from disk per access, so a request-scoped copy saved after the
+    // handler ran would overwrite what the handler saved (the answer would be silently undone).
+    @ti4.spring.context.SetupRequestContext(false)
+    public ResponseEntity<?> answer(@PathVariable String gameName, @PathVariable String id, @RequestBody AnswerRequest req) {
+        return answerResponse(ActionInvoker.answer(gameName, id, RequestContext.getUserId(), req));
+    }
+
+    // ------------------------------------------------------------------ helpers
+
+    public static boolean visibleTo(Decision d, Player me) {
+        if (me == null) return "public".equals(d.visibility());
+        if ("private".equals(d.visibility()))
+            return d.target() != null && me.getUserID().equals(d.target().userId());
+        return true;
+    }
+
+    private static void send(SseEmitter emitter, EngineEvent e) throws IOException {
+        emitter.send(SseEmitter.event().id(String.valueOf(e.seq())).name(e.type()).data(e, MediaType.APPLICATION_JSON));
+    }
+
+    private static long parse(String s) {
+        try {
+            return Long.parseLong(s.trim());
+        } catch (Exception e) {
+            return 0;
+        }
+    }
+
+    private static ResponseEntity<?> answerResponse(AnswerResult r) {
+        HttpStatus status = switch (r.status()) {
+            case "done", "needs_input" -> HttpStatus.OK;
+            case "stale", "busy" -> HttpStatus.CONFLICT;
+            case "forbidden" -> HttpStatus.FORBIDDEN;
+            case "not_found" -> HttpStatus.NOT_FOUND;
+            case "error" -> HttpStatus.INTERNAL_SERVER_ERROR;
+            default -> HttpStatus.UNPROCESSABLE_ENTITY;
+        };
+        return ResponseEntity.status(status).cacheControl(CacheControl.noStore()).body(r);
+    }
+
+    static boolean trusted(String auth) {
+        if (auth == null || JdaService.jda == null) return false;
+        String token = JdaService.jda.getToken();
+        String bare = token.startsWith("Bot ") ? token.substring(4) : token;
+        return auth.equals("Bot " + bare);
+    }
+
+    private static Game game(String name) {
+        if (!GameManager.isValid(name)) return null;
+        ManagedGame mg = GameManager.getManagedGame(name);
+        return mg == null ? null : mg.getGame();
+    }
+
+    private static ResponseEntity<?> ok(Object body) {
+        return ResponseEntity.ok().cacheControl(CacheControl.noStore()).body(body);
+    }
+
+    private static ResponseEntity<?> notFound() {
+        return ResponseEntity.status(HttpStatus.NOT_FOUND).body(Map.of("error", "no such game"));
+    }
+
+    private static ResponseEntity<?> unauthorized() {
+        return ResponseEntity.status(HttpStatus.UNAUTHORIZED).body(Map.of("error", "bot token required"));
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/EngineMetrics.java b/src/main/java/ti4/selfhost/engine/EngineMetrics.java
new file mode 100644
index 0000000..853beb8
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/EngineMetrics.java
@@ -0,0 +1,149 @@
+package ti4.selfhost.engine;
+
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.TreeMap;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.atomic.AtomicLong;
+import java.util.concurrent.atomic.LongAdder;
+import ti4.selfhost.engine.EngineModels.Decision;
+import ti4.selfhost.engine.EngineModels.Option;
+
+/**
+ * Counters since bot start plus a snapshot of the open decisions: how much of what the engine asks is typed, how
+ * well targets resolve, which untyped handler prefixes are most common, and how fast capture and answers are.
+ * Served at GET /api/public/selfhost/engine/metrics (tools/engine-metrics.mjs prints it).
+ */
+public final class EngineMetrics {
+    private EngineMetrics() {}
+
+    private static final long STARTED = System.currentTimeMillis();
+    private static final Map<String, LongAdder> counters = new ConcurrentHashMap<>();
+    private static final Timer capture = new Timer();
+    private static final Map<String, Timer> answers = new ConcurrentHashMap<>();
+
+    public static void count(String name) {
+        counters.computeIfAbsent(name, k -> new LongAdder()).increment();
+    }
+
+    public static void captureNanos(long nanos) {
+        capture.add(nanos);
+    }
+
+    public static void answer(String status, long nanos) {
+        answers.computeIfAbsent(status, k -> new Timer()).add(nanos);
+    }
+
+    /** Snapshot for one game, or all games with open decisions when game is null. */
+    public static Map<String, Object> snapshot(String game) {
+        List<Decision> open = new ArrayList<>();
+        if (game != null) open.addAll(DecisionRegistry.openDecisions(game));
+        else for (String g : DecisionRegistry.games()) open.addAll(DecisionRegistry.openDecisions(g));
+
+        Map<String, Integer> byKind = new TreeMap<>();
+        Map<String, Integer> byTarget = new TreeMap<>();
+        Map<String, Integer> untypedPrefixes = new LinkedHashMap<>();
+        Map<String, Integer> perGame = new TreeMap<>();
+        int typed = 0, weak = 0, answerable = 0;
+        for (Decision d : open) {
+            byKind.merge(d.kind(), 1, Integer::sum);
+            String how = d.target() == null ? "none" : d.target().resolvedBy();
+            byTarget.merge(how, 1, Integer::sum);
+            perGame.merge(d.game(), 1, Integer::sum);
+            if (!DecisionKinds.LEGACY.equals(d.kind())) typed++;
+            if ("none".equals(how) || "mention".equals(how)) weak++;
+            boolean anyAnswerable = false;
+            for (Option o : d.options()) {
+                if (!o.disabled() && !o.needsInput() && !o.id().contains("#")) anyAnswerable = true;
+            }
+            if (anyAnswerable) answerable++;
+            if (DecisionKinds.LEGACY.equals(d.kind())) {
+                java.util.Set<String> seen = new java.util.HashSet<>();
+                for (Option o : d.options()) {
+                    String p = handlerPrefix(o.handler());
+                    if (p != null && seen.add(p)) untypedPrefixes.merge(p, 1, Integer::sum);
+                }
+            }
+        }
+        List<Map<String, Object>> top = untypedPrefixes.entrySet().stream()
+                .sorted(Map.Entry.<String, Integer>comparingByValue(Comparator.reverseOrder()))
+                .limit(25)
+                .map(e -> Map.<String, Object>of("prefix", e.getKey(), "decisions", e.getValue()))
+                .toList();
+
+        Map<String, Object> out = new LinkedHashMap<>();
+        out.put("game", game);
+        out.put("uptimeSec", (System.currentTimeMillis() - STARTED) / 1000);
+        out.put("seq", DecisionRegistry.currentSeq());
+        out.put("open", open.size());
+        out.put("typed", typed);
+        out.put("typedPct", pct(typed, open.size()));
+        out.put("weakTarget", weak);
+        out.put("weakTargetPct", pct(weak, open.size()));
+        out.put("answerablePct", pct(answerable, open.size()));
+        out.put("byKind", byKind);
+        out.put("byTarget", byTarget);
+        out.put("perGame", perGame);
+        out.put("topUntypedPrefixes", top);
+        Map<String, Long> c = new TreeMap<>();
+        counters.forEach((k, v) -> c.put(k, v.sum()));
+        out.put("counters", c);
+        out.put("captureMs", capture.summary());
+        Map<String, Object> a = new TreeMap<>();
+        answers.forEach((k, v) -> a.put(k, v.summary()));
+        out.put("answersMs", a);
+        return out;
+    }
+
+    /** Handler id up to and including its first '_' (or the whole id), e.g. "scPick_", "sc_follow_" -> "sc_". */
+    static String handlerPrefix(String handler) {
+        if (handler == null) return null;
+        int us = handler.indexOf('_');
+        return us < 0 ? handler : handler.substring(0, us + 1);
+    }
+
+    private static double pct(int part, int whole) {
+        return whole == 0 ? 0 : Math.round(1000.0 * part / whole) / 10.0;
+    }
+
+    /** Count, mean and max plus a recent-window p50/p95 (last 512 samples), in milliseconds. */
+    static final class Timer {
+        private final AtomicLong n = new AtomicLong();
+        private final AtomicLong total = new AtomicLong();
+        private final AtomicLong max = new AtomicLong();
+        private final long[] ring = new long[512];
+        private int pos;
+
+        void add(long nanos) {
+            n.incrementAndGet();
+            total.addAndGet(nanos);
+            max.accumulateAndGet(nanos, Math::max);
+            synchronized (ring) {
+                ring[pos++ % ring.length] = nanos;
+            }
+        }
+
+        Map<String, Object> summary() {
+            long count = n.get();
+            long[] copy;
+            synchronized (ring) {
+                copy = java.util.Arrays.copyOf(ring, (int) Math.min(count, ring.length));
+            }
+            java.util.Arrays.sort(copy);
+            Map<String, Object> m = new LinkedHashMap<>();
+            m.put("count", count);
+            m.put("mean", count == 0 ? 0 : ms(total.get() / count));
+            m.put("p50", copy.length == 0 ? 0 : ms(copy[copy.length / 2]));
+            m.put("p95", copy.length == 0 ? 0 : ms(copy[Math.min(copy.length - 1, (int) (copy.length * 0.95))]));
+            m.put("max", ms(max.get()));
+            return m;
+        }
+
+        private static double ms(long nanos) {
+            return Math.round(nanos / 10_000.0) / 100.0;
+        }
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/EngineModels.java b/src/main/java/ti4/selfhost/engine/EngineModels.java
new file mode 100644
index 0000000..0dc360f
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/EngineModels.java
@@ -0,0 +1,443 @@
+package ti4.selfhost.engine;
+
+import java.util.List;
+import java.util.Map;
+
+/**
+ * Wire contract of the engine API (mirrored 1:1 by shim/src/engine/types.ts — change both together and bump
+ * {@link #CONTRACT_VERSION}). All ids are strings; numbers are plain ints.
+ */
+public final class EngineModels {
+    private EngineModels() {}
+
+    public static final int CONTRACT_VERSION = 1;
+
+    // ------------------------------------------------------------------ state
+
+    public record GameState(
+            int contract,
+            String game,
+            /** Game.getLastModifiedDate(): changes on every save and on undo. */
+            long stateVersion,
+            /** Engine event seq at snapshot time; resume the stream with after=seq. */
+            long seq,
+            String phase,
+            int round,
+            String activePlayer,
+            String speaker,
+            List<PlayerState> players,
+            List<StrategyCardState> strategyCards,
+            List<TileState> tiles,
+            Map<String, List<String>> publicObjectives,
+            List<String> laws,
+            DraftState draft,
+            /** Exploration decks, relic deck and recent explore results / relic draws (G9). */
+            ExplorationState exploration,
+            /** The agenda in play (agenda phase, or one revealed mid-action); null otherwise. */
+            AgendaState agenda,
+            /** Status phase (scoring + homework) facts; null outside the status phase. See kinds/StatusPhase. */
+            StatusState status,
+            /** Thunder's Edge: null when the game does not use it. Built by ThundersEdgeStateBuilder. */
+            ThundersEdgeState thundersEdge,
+            /** Setup progress (draft over, before the first strategy phase); null once the game is under way. */
+            SetupState setup,
+            /** The viewer's trade view (null without a viewer). G11. */
+            TradeEngine.TradeState trade,
+            /** Combat in the active system (G4); null when there is none. */
+            ti4.selfhost.engine.kinds.CombatSupport.CombatState combat) {}
+
+
+    /**
+     * Thunder's Edge state. expeditions: key (techSkip, tradeGoods, fiveRes, fiveInf, secret, actionCards) → faction
+     * that completed it, or null while open. breakthroughs: faction → that player's breakthroughs.
+     */
+    public record ThundersEdgeState(
+            boolean fractureInPlay,
+            boolean thundersEdgeInPlay,
+            Map<String, String> expeditions,
+            Map<String, List<BreakthroughState>> breakthroughs) {}
+
+    public record BreakthroughState(String id, boolean unlocked, boolean exhausted, boolean active, int tradeGoods) {}
+
+    /** Hidden information (hand contents) is only filled for the viewer's own player ({@code self=true}). */
+    public record PlayerState(
+            String userId,
+            String userName,
+            String faction,
+            String color,
+            boolean self,
+            boolean real,
+            boolean passed,
+            boolean eliminated,
+            boolean speaker,
+            boolean active,
+            int victoryPoints,
+            int tg,
+            int commodities,
+            int commoditiesMax,
+            CommandTokens commandTokens,
+            List<Integer> strategyCards,
+            List<String> techs,
+            List<String> exhaustedTechs,
+            List<String> planets,
+            List<String> exhaustedPlanets,
+            List<String> relics,
+            List<String> fragments,
+            List<String> leaders,
+            List<String> promissoryNotesInPlayArea,
+            Map<String, Integer> secretsScored,
+            int actionCardCount,
+            int secretObjectiveCount,
+            int promissoryNoteCount,
+            Hand hand) {}
+
+    public record CommandTokens(int tactic, int fleet, int strategy) {}
+
+    /** Only for the viewer's own player. Keys are card ids, values the per-player numeric handles the engine uses. */
+    public record Hand(
+            Map<String, Integer> actionCards,
+            Map<String, Integer> secretObjectives,
+            Map<String, Integer> promissoryNotes) {}
+
+    /**
+     * One strategy card. name/card: display name and the card's automation id (e.g. "pok4construction", what the
+     * engine resolves it as). reactions: once played, every seated player's answer to it (see ScReaction).
+     */
+    public record StrategyCardState(
+            int number,
+            String holder,
+            int tradeGoods,
+            boolean played,
+            String name,
+            String card,
+            String holderFaction,
+            List<ScReaction> reactions) {}
+
+    /**
+     * A player's answer to a played strategy card. status: holder (played it; never follows it), pending, followed
+     * (spent a strategy token / used the secondary), declined. canFollow/cantFollowReason only for pending players
+     * (reason codes: no_strategy_token, no_home_space_dock, all_secrets_scored).
+     */
+    public record ScReaction(String faction, String status, boolean canFollow, String cantFollowReason) {}
+
+    public record TileState(String position, String tileId, List<HolderState> holders) {}
+
+    /** "space" or a planet id. */
+    public record HolderState(String name, List<UnitStack> units, List<String> tokens, List<String> control) {}
+
+    /** owner = faction of the unit's colour (null if no player has that colour). */
+    public record UnitStack(String owner, String color, String unit, int count, int damaged, int galvanized) {}
+
+    /**
+     * Milty draft. status: "drafting" | "finished". order: the snake (one entry per pick). players: each drafter's
+     * picks so far (null = not yet). available: what is still on the board.
+     */
+    public record DraftState(
+            String type,
+            String status,
+            String currentPlayer,
+            List<String> order,
+            List<DraftPlayer> players,
+            DraftAvailable available) {}
+
+    /** faction: draft id (Keleres is drafted as "keleresm" whatever flavour it plays). */
+    public record DraftPlayer(String userId, String faction, String slice, Integer speakerOrder) {}
+
+    public record DraftAvailable(List<String> slices, List<String> factions, List<Integer> speakerOrders) {}
+
+    /**
+     * stage: "settings" (game created, draft not started) | "draft" | "player_setup" (factions, Keleres flavour,
+     * starting technologies) | "deal_secrets" (everyone set up, secret objectives not dealt) | "keep_secrets" |
+     * "reveal_objectives" (everyone kept one: reveal and start the strategy phase). waitingOn: user ids the stage
+     * waits for (empty for the table-wide steps).
+     */
+    public record SetupState(String stage, List<String> waitingOn, List<SetupPlayer> players) {}
+
+    public record SetupPlayer(
+            String userId,
+            String faction,
+            int startingTechsNeeded,
+            int secretObjectivesToDiscard,
+            boolean keleresFlavorPending) {}
+
+    /** decks: trait (cultural/industrial/hazardous/frontier) → deck size + discard pile (card ids, public). */
+    public record ExplorationState(Map<String, ExploreDeckState> decks, int relicDeck, List<ExploreEvent> recent) {}
+
+    public record ExploreDeckState(int deck, List<String> discard) {}
+
+    /**
+     * One exploration result (type "explore": card = explore card id, planet null for a frontier token) or relic draw
+     * (type "relic": card = relic id). name/trait/resolution/text come from the card data, for display.
+     */
+    public record ExploreEvent(
+            int round,
+            String userId,
+            String faction,
+            String type,
+            String card,
+            String name,
+            String trait,
+            String resolution,
+            String text,
+            String planet,
+            String planetName,
+            String tile,
+            long at) {}
+
+    /**
+     * The agenda being decided. outcomeType: for_against | player | planet | secret_objective | strategy_card |
+     * law | unit_upgrade | unit | other. stage = the engine phase (agendawaiting: whens/afters, agendaVoting,
+     * agendaEnd: resolving). Vote details are omitted in fog of war / hidden agenda games (availableVotes then only
+     * holds the viewer's own count).
+     */
+    public record AgendaState(
+            String agendaId,
+            String name,
+            String type,
+            String target,
+            String outcomeType,
+            int number,
+            String stage,
+            boolean whensResolved,
+            boolean aftersResolved,
+            /** User ids who have not yet queued or passed on "when"s / "after"s for this agenda. */
+            List<String> awaitingWhens,
+            List<String> awaitingAfters,
+            /** User id of the player whose turn it is to vote (agendaVoting only). */
+            String currentVoter,
+            /** User ids in voting order. */
+            List<String> votingOrder,
+            /** User id -> votes the player can cast now (planets + other sources the engine counts). */
+            Map<String, Integer> availableVotes,
+            /** Outcomes with votes or riders on them so far, most votes first. */
+            List<AgendaOutcomeState> outcomes) {}
+
+    public record AgendaOutcomeState(
+            String outcome, String name, int votes, List<AgendaVoteCast> voters, List<AgendaRider> riders) {}
+
+    public record AgendaVoteCast(String userId, String faction, int votes) {}
+
+    public record AgendaRider(String userId, String faction, String rider) {}
+
+    /**
+     * Status phase: step = "scoring" (statusScoring) or "homework" (statusHomework). next = phase after status:
+     * "strategy" | "agenda" | "edict". players by userId.
+     */
+    public record StatusState(
+            int round,
+            String step,
+            boolean objectiveRevealed,
+            boolean custodiansTaken,
+            String next,
+            Map<String, PlayerStatus> players) {}
+
+    /**
+     * publicScored/secretScored: objective id scored this round, "none" when declined, null while undecided.
+     * tokensBase: pools before this status phase's gain; tokenGain: how many the rules give now; tokenMaxTotal: the
+     * most the three pools may hold after the gain (base + gain, capped by reinforcements); noTokenLoss: may not
+     * lower a pool below base (Deliberate Action). tokensConfirmed: final pools set this round (null until then).
+     * ready: pressed Ready (reacted to the homework prompt). actionCardLimit: hand limit.
+     * scorableSecrets: viewer only.
+     */
+    public record PlayerStatus(
+            String publicScored,
+            String secretScored,
+            CommandTokens tokensBase,
+            int tokenGain,
+            int tokenMaxTotal,
+            boolean noTokenLoss,
+            CommandTokens tokensConfirmed,
+            boolean ready,
+            int actionCardLimit,
+            /** Viewer only (null for others): secret objectives in hand the engine knows are met now (status phase). */
+            List<String> scorableSecrets) {}
+
+    // ------------------------------------------------------------------ decisions
+
+    /**
+     * One question the engine asked. Opened when a message carrying components is posted, updated when it is edited,
+     * closed when it is deleted, its components removed, or it is answered.
+     */
+    public record Decision(
+            /** Stable for the life of the prompt message (edits in place keep the id; see revision). */
+            String id,
+            String game,
+            /** Discriminant: "legacy" or a typed kind such as "strategy_card.pick". See DecisionKinds. */
+            String kind,
+            /** Engine event seq at which this revision was opened. */
+            long seq,
+            long stateVersion,
+            Target target,
+            /** "player" (only target may answer), "table" (any seated player, each answers for themself). */
+            String scope,
+            /** "public" or "private" (cards-info thread, private channel or ephemeral: only target may see it). */
+            String visibility,
+            String prompt,
+            List<Option> options,
+            Source source,
+            long createdAt,
+            /** Increments each time the prompt changes (edit in place, new target, window/progress change). */
+            int revision,
+            /** Set for "everyone answers in parallel" prompts (scope table); null otherwise. */
+            ReactionWindow window,
+            /** Set for multi-step prompts that accumulate choices before committing; null otherwise. */
+            Progress progress,
+            /**
+             * Typed inputs this decision accepts besides plain options: select menus (answer with values) and forms
+             * (kind "input.form": answer "submit" with inputs). null when none.
+             */
+            List<InputSchema> inputs) {
+
+        public Decision withSeq(long newSeq, int newRevision) {
+            return new Decision(id, game, kind, newSeq, stateVersion, target, scope, visibility, prompt, options,
+                    source, createdAt, newRevision, window, progress, inputs);
+        }
+
+        public Decision withDynamic(long newStateVersion, Target newTarget, ReactionWindow newWindow, Progress newProgress) {
+            return new Decision(id, game, kind, seq, newStateVersion, newTarget, scope, visibility, prompt, options,
+                    source, createdAt, revision, newWindow, newProgress, inputs);
+        }
+    }
+
+    /**
+     * A typed input: a select menu on the prompt (kind "select", id = the menu's custom id, one "choice" field
+     * "values") or a form a button opened (kind "form", id = the form's id, fields = its text inputs / selects).
+     * Answer a select with {optionId: id, values: [...]} (or a single option "id#value"); a form with
+     * {optionId: "submit", inputs: {fieldId: value}} — multi-value fields joined with "\n".
+     */
+    public record InputSchema(String id, String kind, String title, List<InputField> fields) {}
+
+    /**
+     * type: "choice" (pick from choices; minValues..maxValues of them), "text" (minLength..maxLength chars;
+     * multiline for paragraphs) or "number" (integer text). value: the prefilled value, if any.
+     */
+    public record InputField(
+            String id,
+            String label,
+            String type,
+            boolean required,
+            Integer minLength,
+            Integer maxLength,
+            Integer minValues,
+            Integer maxValues,
+            boolean multiline,
+            String placeholder,
+            String value,
+            List<Choice> choices) {}
+
+    public record Choice(String value, String label, String description, boolean selected) {}
+
+    /**
+     * A reaction window: every eligible player answers (in parallel, any order); it is over when everyone eligible
+     * has responded (the engine then closes the decision). kind: "follow" (strategy card secondary), "when",
+     * "after", "sabotage", "vote", "pre_vote", "trade_follow", ... (area-defined, document new ones in types.ts).
+     * subject: what the window is about, e.g. {"strategyCard": 5} or {"actionCard": "ac_id", "player": uid}.
+     * responses: optional per-player answer summaries, e.g. uid → "followed" / "passed" / "3 votes for Against".
+     */
+    public record ReactionWindow(
+            String kind,
+            Map<String, Object> subject,
+            List<String> eligible,
+            List<String> responded,
+            Map<String, String> responses) {}
+
+    /**
+     * Sub-step state of a multi-step decision (movement, landing, hit assignment, payment, agenda voting, when/after
+     * queues): what has been chosen so far and what is left, derived by the kind from engine state (stored values,
+     * the game), never from message text — so it survives reloads and restarts. step: the current sub-step name
+     * ("select_units", "select_planets", "confirm", ...). accumulated: the typed running selection (e.g.
+     * {"units": [...], "spent": {"planets": [...], "tg": 2}, "votes": 7}). required: what is still needed, e.g.
+     * {"hits": 2} or {"resources": 3}. canCommit: the "Done"/"Confirm" option is meaningful now.
+     */
+    public record Progress(
+            String flow,
+            String step,
+            Map<String, Object> accumulated,
+            Map<String, Object> required,
+            boolean canCommit) {}
+
+    /**
+     * userId null when nobody specific is targeted. resolvedBy says how the engine knows: owner_prefix (FFCC_),
+     * spoof_prefix, cards_thread, private_channel, interaction_user (ephemeral/followup), draft_turn, mention, none.
+     */
+    public record Target(String userId, String faction, String color, String resolvedBy) {}
+
+    /**
+     * id is opaque to clients (today: the component custom id, plus "#value" for select options). value is the
+     * kind-specific typed payload, null for options outside the kind's vocabulary (e.g. "Done").
+     */
+    public record Option(
+            String id,
+            String label,
+            String style,
+            String emoji,
+            boolean disabled,
+            /**
+             * Answering it asks for input first: a button that opens a form (the answer returns status "needs_input"
+             * and opens an "input.form" decision), or a form's submit (send inputs).
+             */
+            boolean needsInput,
+            String handler,
+            Map<String, Object> value,
+            /**
+             * Who may press this option when it differs from the decision's target: set only on menus whose options
+             * carry different owners (target.resolvedBy = mixed_owners). null = the decision's target/scope rules.
+             */
+            Target owner) {}
+
+    public record Source(String channelId, String messageId, String customIdPrefix, boolean ephemeral) {}
+
+    // ------------------------------------------------------------------ actions
+
+    /**
+     * Exactly one way of answering: optionId (press one option; for a select option "customId#value"), optionId = a
+     * select's id + values (multi-select), optionId "submit"/"cancel" + inputs (input.form decisions), or payload (a
+     * structured answer the kind executes as one or more engine steps under the game lock, e.g. a whole payment
+     * {"planets":[...],"tg":2} or agenda vote; see KindSpec.answerPayload; only kinds with acceptsPayload()).
+     */
+    public record AnswerRequest(
+            String optionId,
+            Long expectedSeq,
+            String requestId,
+            String userId,
+            Map<String, Object> payload,
+            List<String> values,
+            Map<String, String> inputs) {
+        public AnswerRequest(String optionId, Long expectedSeq, String requestId, String userId) {
+            this(optionId, expectedSeq, requestId, userId, null, null, null);
+        }
+
+        public AnswerRequest(
+                String optionId, Long expectedSeq, String requestId, String userId, Map<String, Object> payload) {
+            this(optionId, expectedSeq, requestId, userId, payload, null, null);
+        }
+    }
+
+    public record AnswerResult(
+            boolean ok,
+            String status,
+            String error,
+            String decisionId,
+            long seq,
+            long stateVersion,
+            List<Decision> opened,
+            /**
+             * "engine" (run directly through an engine Interaction), "synthetic" (simulated Discord click) or
+             * "payload" (a structured answer: the kind's presses each took one of the other two).
+             */
+            String path) {
+        public AnswerResult(
+                boolean ok, String status, String error, String decisionId, long seq, long stateVersion,
+                List<Decision> opened) {
+            this(ok, status, error, decisionId, seq, stateVersion, opened, null);
+        }
+    }
+
+    // ------------------------------------------------------------------ events
+
+    /**
+     * type: decision.opened | decision.updated | decision.closed | state.changed. Stream order == seq order.
+     * decision is set for decision.* (on closed: only id/game/target meaningful), reason for closed.
+     */
+    public record EngineEvent(long seq, String type, String game, long stateVersion, Decision decision, String reason) {}
+}
diff --git a/src/main/java/ti4/selfhost/engine/Interaction.java b/src/main/java/ti4/selfhost/engine/Interaction.java
new file mode 100644
index 0000000..85c4423
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/Interaction.java
@@ -0,0 +1,101 @@
+package ti4.selfhost.engine;
+
+import java.util.List;
+import javax.annotation.Nullable;
+import net.dv8tion.jda.api.components.MessageTopLevelComponent;
+import net.dv8tion.jda.api.components.tree.MessageComponentTree;
+import net.dv8tion.jda.api.entities.Message;
+import net.dv8tion.jda.api.entities.channel.middleman.MessageChannel;
+import net.dv8tion.jda.api.events.interaction.GenericInteractionCreateEvent;
+import net.dv8tion.jda.api.utils.FileUpload;
+import net.dv8tion.jda.api.utils.messages.MessageCreateData;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.selfhost.engine.interaction.EngineInteraction;
+import ti4.selfhost.engine.interaction.JdaInteraction;
+import ti4.selfhost.engine.interaction.NativeEvents;
+
+/**
+ * "A player answered a prompt": what handlers and helpers need from a button press / select / modal submit, without
+ * Discord. Two implementations:
+ *
+ * <ul>
+ *   <li>{@link JdaInteraction} wraps a real JDA event (Discord path; behaviour identical to the code it replaced);
+ *   <li>{@link EngineInteraction} is created by the engine for a direct answer: its ops close/update the decision
+ *       registry and post through the engine's message sink (today: JDA channel REST, no interaction token, no
+ *       synthesised Discord event, no shim round trip).
+ * </ul>
+ *
+ * <p>Helpers obtain it with {@link #of(GenericInteractionCreateEvent)}, so the ~2,300 handler methods that take a JDA
+ * event keep their signatures: for an engine answer the event they receive is a thin JDA-shaped view
+ * ({@link NativeEvents}) of an {@link EngineInteraction}.
+ */
+public interface Interaction {
+
+    /** The game this interaction belongs to (null outside game channels). */
+    @Nullable
+    Game game();
+
+    /** The seat answering (null if the user is not seated). */
+    @Nullable
+    Player player();
+
+    String userId();
+
+    /** Raw custom id of the component (incl. FFCC_/spoof prefixes and delete markers) or the modal id. */
+    String componentId();
+
+    /** Where replies go: the channel of the prompt. */
+    MessageChannel channel();
+
+    /** The prompt message the component lives on; null for modal submits without a message / slash commands. */
+    @Nullable
+    String messageId();
+
+    /** The prompt message (content + components). Engine: fetched lazily through the sink. */
+    @Nullable
+    Message message();
+
+    default String messageContent() {
+        Message m = message();
+        return m == null ? "" : m.getContentRaw();
+    }
+
+    /** True when the engine runs this answer directly (no Discord interaction behind it). */
+    boolean isEngine();
+
+    /** Acknowledge without changing anything (Discord: deferEdit; engine: no-op). */
+    void deferEdit();
+
+    /** Public reply in the prompt's channel. */
+    void reply(MessageCreateData data);
+
+    /** Reply only the answering player sees (Discord: ephemeral followup; engine: private message for that user). */
+    void replyEphemeral(MessageCreateData data);
+
+    default void replyEphemeral(String text) {
+        replyEphemeral(MessageCreateData.fromContent(text));
+    }
+
+    /** Replace the prompt's components (empty tree removes them). */
+    void editComponents(MessageComponentTree tree);
+
+    /** Replace the prompt's content, components and files. */
+    void editMessage(String content, List<? extends MessageTopLevelComponent> components, List<FileUpload> files);
+
+    /** The prompt is done: delete it (engine: the decision closes as "answered" immediately). */
+    void deleteMessage();
+
+    void deleteMessage(int delaySeconds);
+
+    /** The Interaction behind a handler's JDA event: the engine's own for engine answers, else a JDA adapter. */
+    static Interaction of(GenericInteractionCreateEvent event) {
+        EngineInteraction ix = NativeEvents.engineInteraction(event);
+        return ix != null ? ix : new JdaInteraction(event);
+    }
+
+    /** True when this JDA event is an engine-native answer (no Discord interaction token exists). */
+    static boolean isEngine(@Nullable GenericInteractionCreateEvent event) {
+        return event != null && NativeEvents.engineInteraction(event) != null;
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/InteractionTracker.java b/src/main/java/ti4/selfhost/engine/InteractionTracker.java
new file mode 100644
index 0000000..149af12
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/InteractionTracker.java
@@ -0,0 +1,97 @@
+package ti4.selfhost.engine;
+
+import java.util.Map;
+import java.util.concurrent.ConcurrentHashMap;
+import javax.annotation.Nonnull;
+import net.dv8tion.jda.api.events.interaction.GenericInteractionCreateEvent;
+import net.dv8tion.jda.api.events.interaction.component.GenericComponentInteractionCreateEvent;
+import net.dv8tion.jda.api.hooks.ListenerAdapter;
+
+/**
+ * Remembers who made each interaction (by interaction token and id), so replies, followups and ephemeral messages
+ * sent through the interaction webhook are attributed to that player, not guessed from text.
+ */
+public final class InteractionTracker extends ListenerAdapter {
+    private static final long TTL_MS = 15 * 60 * 1000;
+
+    public record Info(String userId, String channelId, String messageId, String customId, long at) {}
+
+    private static final Map<String, Info> byToken = new ConcurrentHashMap<>();
+    private static final Map<String, Info> byId = new ConcurrentHashMap<>();
+    /** interaction token -> message id of its @original response, once known. */
+    private static final Map<String, String> originals = new ConcurrentHashMap<>();
+
+    @Override
+    public void onGenericInteractionCreate(@Nonnull GenericInteractionCreateEvent event) {
+        record(event);
+    }
+
+    public static void record(GenericInteractionCreateEvent event) {
+        try {
+            String messageId = null;
+            String customId = null;
+            if (event instanceof GenericComponentInteractionCreateEvent c) {
+                messageId = c.getMessageId();
+                customId = c.getComponentId();
+            }
+            Info info = new Info(
+                    event.getUser().getId(),
+                    event.getChannel() == null ? null : event.getChannel().getId(),
+                    messageId,
+                    customId,
+                    System.currentTimeMillis());
+            byToken.put(event.getToken(), info);
+            byId.put(event.getId(), info);
+            prune();
+        } catch (Exception ignored) {
+            // best effort
+        }
+    }
+
+    /** Attribute messages sent under a pseudo token (engine answers have no interaction token) to a user. */
+    public static void recordUser(String token, String userId) {
+        byToken.put(token, new Info(userId, null, null, null, System.currentTimeMillis()));
+        prune();
+    }
+
+    public static Info byToken(String token) {
+        return byToken.get(token);
+    }
+
+    public static Info byId(String id) {
+        return byId.get(id);
+    }
+
+    /**
+     * The most recent interaction made in a channel within maxAgeMs: the press that most likely caused a plain channel
+     * post (no interaction token) that names nobody. Weak; kinds use it only as a fallback.
+     */
+    public static Info latestInChannel(String channelId, long maxAgeMs) {
+        if (channelId == null) return null;
+        long cutoff = System.currentTimeMillis() - maxAgeMs;
+        Info best = null;
+        for (Info i : byToken.values()) {
+            if (channelId.equals(i.channelId()) && i.at() >= cutoff && (best == null || i.at() > best.at())) best = i;
+        }
+        return best;
+    }
+
+    public static void setOriginal(String token, String messageId) {
+        if (token != null && messageId != null) originals.put(token, messageId);
+    }
+
+    public static String original(String token) {
+        return originals.get(token);
+    }
+
+    private static void prune() {
+        if (byToken.size() < 2000) return;
+        long cutoff = System.currentTimeMillis() - TTL_MS;
+        byToken.entrySet().removeIf(e -> {
+            boolean old = e.getValue().at() < cutoff;
+            if (old) originals.remove(e.getKey());
+            return old;
+        });
+        byId.values().removeIf(i -> i.at() < cutoff);
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/KindSpec.java b/src/main/java/ti4/selfhost/engine/KindSpec.java
new file mode 100644
index 0000000..4be88f0
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/KindSpec.java
@@ -0,0 +1,217 @@
+package ti4.selfhost.engine;
+
+import java.util.List;
+import java.util.Map;
+import java.util.function.Predicate;
+import javax.annotation.Nullable;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.selfhost.engine.EngineModels.Decision;
+import ti4.selfhost.engine.EngineModels.Target;
+
+/**
+ * A typed decision kind. Implementations live in {@code ti4.selfhost.engine.kinds} and are discovered by classpath
+ * scan (public class, public no-arg constructor): adding a kind needs no edit to any shared file.
+ *
+ * <p>A captured message gets the kind of the highest-priority spec that {@link #matches} at least one of its options;
+ * otherwise it is "legacy". Every option of the message is still listed; {@link #value} types the ones the kind
+ * understands (others get value null, e.g. a "Done" button).
+ */
+public interface KindSpec {
+
+    /** Discriminant, "area.verb" (e.g. "strategy_card.pick"). Must match the TS union member in engine/types.ts. */
+    String kind();
+
+    /** Higher wins when several kinds match one message. Default 0; legacy is below everything. */
+    default int priority() {
+        return 0;
+    }
+
+    /** Whether this option (handler id = custom id without FFCC_/spoof prefix and delete markers) belongs to us. */
+    boolean matches(String handlerId);
+
+    /**
+     * Whether {@link #value} should be asked for this option of a message already classified as this kind. Defaults
+     * to {@link #matches}; override to type generic options (e.g. "gain 1 commodity") that must not by themselves
+     * classify a message as this kind.
+     */
+    default boolean typesOption(String handlerId) {
+        return matches(handlerId);
+    }
+
+    /**
+     * Whether a message with these options is ours. Default: any option {@link #matches}. Override when a kind types
+     * options that also appear on other kinds' messages (e.g. a combat roll button on a hits prompt) and should only
+     * claim a message by its distinctive options.
+     */
+    default boolean classifies(List<String> handlerIds) {
+        for (String h : handlerIds) if (h != null && matches(h)) return true;
+        return false;
+    }
+
+    /** Typed value for one of our options; null if it carries no typed meaning. */
+    @Nullable
+    Map<String, Object> value(String handlerId, CaptureContext ctx);
+
+    /**
+     * Override the target the generic resolver found (e.g. the draft's current player). Also called again after
+     * every state change while the decision is open when {@link #dynamic()} is true.
+     */
+    @Nullable
+    default Target target(CaptureContext ctx, @Nullable Target resolved) {
+        return resolved;
+    }
+
+    /**
+     * True when target / window / progress move with game state: they are recomputed after every state change while
+     * the decision is open (emitting decision.updated when they change).
+     */
+    default boolean dynamic() {
+        return false;
+    }
+
+    /**
+     * The engine records who answered this kind's reaction window (one answer per eligible player) and merges that
+     * into {@link #window}: for windows whose engine-side record of reactions is unreliable. Off by default (some
+     * table decisions take several presses from one player).
+     */
+    default boolean recordsResponses() {
+        return false;
+    }
+
+    /**
+     * Whether this player may answer the decision although they are not (or no longer) awaited by its window — e.g.
+     * the holder of a played strategy card resolving its primary on the card's message (the window lists only the
+     * players who may follow). The kind's validate() still applies.
+     */
+    default boolean answersOutsideWindow(Game game, Player answering, Decision decision) {
+        return false;
+    }
+
+    /** With {@link #recordsResponses()}: whether pressing this option (handler id) is the player's response. */
+    default boolean countsAsResponse(String handlerId) {
+        return true;
+    }
+
+    /**
+     * True when this prompt can no longer be answered (validate would refuse every option), e.g. a stale "reveal the
+     * next objective" after it was revealed. Checked at capture (the message then stays legacy) and, for dynamic()
+     * kinds, after every state change (the open decision is closed). A typed decision that can never be answered
+     * must not exist.
+     */
+    default boolean obsolete(CaptureContext ctx) {
+        return false;
+    }
+
+    /**
+     * Reaction window for "everyone answers" prompts: eligible players and who has responded, from engine state
+     * (stored values etc.). When set, scope is "table" and an answer is accepted from each eligible player once.
+     */
+    @Nullable
+    default EngineModels.ReactionWindow window(CaptureContext ctx) {
+        return null;
+    }
+
+    /** Sub-step state for multi-step prompts edited in place (see EngineModels.Progress). */
+    @Nullable
+    default EngineModels.Progress progress(CaptureContext ctx) {
+        return null;
+    }
+
+    /** "player" (only the target answers) or "table" (any seated player answers for themself). */
+    default String scope(CaptureContext ctx) {
+        return ctx.target() == null || ctx.target().userId() == null ? "table" : "player";
+    }
+
+    /**
+     * Extra check before an answer is executed (the handler validates again). Return an error text to refuse.
+     */
+    @Nullable
+    default String validate(Game game, Player answering, Decision decision, String optionId) {
+        return null;
+    }
+
+    /** Whether this kind takes structured answers (AnswerRequest.payload); routes them to {@link #answerPayload}. */
+    default boolean acceptsPayload() {
+        return false;
+    }
+
+    /**
+     * A structured answer (AnswerRequest.payload) that the kind carries out as one or more engine steps: a whole
+     * payment, a production order, an agenda vote (outcome + planets), the status-phase token split. Called after the
+     * generic checks (decision open, seq, seated, target, window) under the decision's in-flight guard, with the
+     * game's WRITE lock held for the whole sequence (reentrant, so the presses run under it too and nobody else's
+     * click interleaves). Validate first, then press; return an error text to refuse, null when done.
+     */
+    @Nullable
+    default String answerPayload(PayloadAnswer answer, Map<String, Object> payload) throws Exception {
+        return "This decision does not take a structured answer.";
+    }
+
+    /** What a payload answer may do: press options as the answering player and wait for the prompts that follow. */
+    interface Steps {
+        /** Presses an option of an open decision as the answering player; returns once the handler ran. */
+        void press(Decision decision, String optionId) throws Exception;
+
+        /**
+         * Runs an engine-owned handler id that is not an option of the message (e.g. engineStatusTokens_t_f_s, which
+         * applies a whole answer at once) as the answering player, on this decision's message.
+         */
+        void pressEngine(Decision decision, String customId) throws Exception;
+
+        /** The registry seq now (use as the lower bound for {@link #await}). */
+        long seq();
+
+        /** Waits up to timeoutMs for an open decision of this game, opened or revised after seq, that matches. */
+        @Nullable
+        Decision await(long afterSeq, Predicate<Decision> match, long timeoutMs);
+    }
+
+    /** The context of one payload answer: who answers what, plus {@link Steps}. */
+    interface PayloadAnswer extends Steps {
+        String gameName();
+
+        /** The game as it is now (re-read after every press: handlers may replace it). */
+        @Nullable
+        Game game();
+
+        /** The answering player in {@link #game()}. */
+        @Nullable
+        Player player();
+
+        String userId();
+
+        /** The latest open revision of the decision being answered (null once its message is gone). */
+        @Nullable
+        Decision decision();
+
+        /** Press one option (its id) of the latest revision of the answered decision, like a click by the player. */
+        void press(String optionId) throws Exception;
+    }
+
+    /** What the engine knows when it captures a message. */
+    record CaptureContext(
+            Game game,
+            String channelId,
+            String messageId,
+            String content,
+            boolean ephemeral,
+            @Nullable Target target,
+            @Nullable Player player,
+            /**
+             * Handler ids of every option of the message (decision-level facts, e.g. what a "Done" finishes); null
+             * when not known (dynamic recompute: read the open decision's options instead).
+             */
+            @Nullable List<String> handlerIds) {
+        public CaptureContext(
+                Game game,
+                String channelId,
+                String messageId,
+                String content,
+                boolean ephemeral,
+                @Nullable Target target,
+                @Nullable Player player) {
+            this(game, channelId, messageId, content, ephemeral, target, player, null);
+        }
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/SetupStateBuilder.java b/src/main/java/ti4/selfhost/engine/SetupStateBuilder.java
new file mode 100644
index 0000000..6216ba1
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/SetupStateBuilder.java
@@ -0,0 +1,201 @@
+package ti4.selfhost.engine;
+
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import javax.annotation.Nullable;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.model.FactionModel;
+import ti4.selfhost.engine.EngineModels.DraftAvailable;
+import ti4.selfhost.engine.EngineModels.DraftPlayer;
+import ti4.selfhost.engine.EngineModels.DraftState;
+import ti4.selfhost.engine.EngineModels.SetupPlayer;
+import ti4.selfhost.engine.EngineModels.SetupState;
+import ti4.service.milty.MiltyDraftManager;
+import ti4.service.milty.MiltyDraftManager.PlayerDraft;
+import ti4.service.milty.MiltyDraftSlice;
+
+/**
+ * Draft and setup facts the setup decision kinds, bots and the web need (who picked what, what is left, who the
+ * table waits on). Pure reads of Game / MiltyDraftManager; the same rules the setup handlers check.
+ */
+public final class SetupStateBuilder {
+    private SetupStateBuilder() {}
+
+    @Nullable
+    public static DraftState draft(Game game) {
+        MiltyDraftManager m = game.getMiltyDraftManager();
+        if (m == null || m.getDraftOrder() == null || m.getDraftOrder().isEmpty()) return null;
+        boolean finished = draftFinished(game, m);
+        Player cur = finished ? null : m.getCurrentDraftPlayer(game);
+        List<DraftPlayer> players = new ArrayList<>();
+        List<String> takenSlices = new ArrayList<>();
+        List<Integer> takenOrders = new ArrayList<>();
+        for (String uid : m.getPlayers()) {
+            PlayerDraft pd = m.getPlayerDraft(uid);
+            String faction = pd == null ? null : pd.getFaction();
+            String slice = pd == null || pd.getSlice() == null ? null : pd.getSlice().getName();
+            Integer order = pd == null ? null : pd.getPosition();
+            if (slice != null) takenSlices.add(slice);
+            if (order != null) takenOrders.add(order);
+            players.add(new DraftPlayer(uid, faction, slice, order));
+        }
+        List<String> slices = new ArrayList<>();
+        for (MiltyDraftSlice s : m.getSlices()) if (!takenSlices.contains(s.getName())) slices.add(s.getName());
+        List<String> factions = new ArrayList<>();
+        for (FactionModel f : m.remainingFactions()) factions.add(f.getAlias());
+        List<Integer> orders = new ArrayList<>();
+        for (int i = 1; i <= m.getPlayers().size(); i++) if (!takenOrders.contains(i)) orders.add(i);
+        return new DraftState(
+                "milty",
+                finished ? "finished" : "drafting",
+                cur == null ? null : cur.getUserID(),
+                List.copyOf(m.getDraftOrder()),
+                players,
+                new DraftAvailable(slices, factions, orders));
+    }
+
+    /** Which draft category the player still has to pick, by draft id: slice / faction / order. */
+    public static boolean hasPicked(Game game, Player player, String category) {
+        MiltyDraftManager m = game.getMiltyDraftManager();
+        PlayerDraft pd = m == null ? null : m.getPlayerDraft(player.getUserID());
+        if (pd == null) return false;
+        return switch (category) {
+            case "slice" -> pd.getSlice() != null;
+            case "faction" -> pd.getFaction() != null;
+            case "order" -> pd.getPosition() != null;
+            default -> false;
+        };
+    }
+
+    /**
+     * The milty draft is over. MiltyDraftManager.isFinished() can stay false after the last pick (live: pbd97, every
+     * drafter had slice + faction + position, no current drafter), so also: nobody is on the clock, or every drafter
+     * has all three picks.
+     */
+    public static boolean draftFinished(Game game, @Nullable MiltyDraftManager m) {
+        if (m == null) return true;
+        if (m.isFinished()) return true;
+        boolean allPicked = !m.getPlayers().isEmpty();
+        for (String uid : m.getPlayers()) {
+            PlayerDraft pd = m.getPlayerDraft(uid);
+            if (pd == null || pd.getSlice() == null || pd.getFaction() == null || pd.getPosition() == null) allPicked = false;
+        }
+        if (allPicked) return true;
+        try {
+            return m.getCurrentDraftPlayer(game) == null;
+        } catch (Exception e) {
+            return false;
+        }
+    }
+
+    @Nullable
+    public static SetupState build(Game game) {
+        try {
+            return compute(game);
+        } catch (Exception e) {
+            return null;
+        }
+    }
+
+    /** The game is past setup (round 2+, or a strategy / action / status / agenda phase, or objectives revealed). */
+    public static boolean pastSetup(Game game) {
+        String phase = game.getPhaseOfGame() == null ? "" : game.getPhaseOfGame();
+        return game.getRound() > 1
+                || phase.startsWith("strategy")
+                || phase.startsWith("action")
+                || phase.startsWith("status")
+                || phase.startsWith("agenda")
+                || !game.getStoredValue("revealedFlop1").isEmpty();
+    }
+
+    private static SetupState compute(Game game) {
+        if (pastSetup(game)) return null;
+        MiltyDraftManager m = game.getMiltyDraftManager();
+        boolean drafting = m != null && m.getDraftOrder() != null && !m.getDraftOrder().isEmpty() && !draftFinished(game, m);
+        Map<String, SetupPlayer> players = new LinkedHashMap<>();
+        for (Player p : game.getPlayers().values()) {
+            if (p == null || p.isDummy()) continue;
+            String faction = factionOf(p);
+            boolean keleresPending = faction == null && keleresDrafter(game, p);
+            if (faction == null && !keleresPending) continue;
+            players.put(
+                    p.getUserID(),
+                    new SetupPlayer(
+                            p.getUserID(),
+                            faction,
+                            faction == null ? 0 : startingTechsNeeded(p),
+                            faction == null ? 0 : secretsToDiscard(game, p),
+                            keleresPending));
+        }
+        List<SetupPlayer> list = new ArrayList<>(players.values());
+        if (drafting) {
+            Player cur = m.getCurrentDraftPlayer(game);
+            return new SetupState("draft", cur == null ? List.of() : List.of(cur.getUserID()), list);
+        }
+        if (list.isEmpty()) return new SetupState("settings", List.of(), list);
+        List<String> waiting = new ArrayList<>();
+        for (SetupPlayer sp : list) if (sp.keleresFlavorPending() || sp.startingTechsNeeded() > 0) waiting.add(sp.userId());
+        if (!waiting.isEmpty()) return new SetupState("player_setup", waiting, list);
+        if (!secretsDealt(game)) return new SetupState("deal_secrets", List.of(), list);
+        for (SetupPlayer sp : list) if (sp.secretObjectivesToDiscard() > 0) waiting.add(sp.userId());
+        if (!waiting.isEmpty()) return new SetupState("keep_secrets", waiting, list);
+        return new SetupState("reveal_objectives", List.of(), list);
+    }
+
+    @Nullable
+    static String factionOf(Player p) {
+        String f = p.getFaction();
+        return f == null || f.isBlank() || "null".equals(f) ? null : f;
+    }
+
+    /** A drafter whose Keleres flavour is not chosen yet (the draft finished; the player has no faction). */
+    public static boolean keleresDrafter(Game game, Player p) {
+        MiltyDraftManager m = game.getMiltyDraftManager();
+        if (m == null || !draftFinished(game, m)) return false;
+        PlayerDraft pd = m.getPlayerDraft(p.getUserID());
+        return pd != null && pd.getFaction() != null && pd.getFaction().startsWith("keleres") && factionOf(p) == null;
+    }
+
+    public static int startingTechsNeeded(Player p) {
+        try {
+            FactionModel fm = p.getFactionModel();
+            if (fm == null) return 0;
+            return Math.max(0, fm.finalStartingTechAmount() - p.getTechs().size());
+        } catch (Exception e) {
+            return 0;
+        }
+    }
+
+    /** Secret objectives the player must still discard at setup (keep one), as startOfGameObjReveal checks it. */
+    public static int secretsToDiscard(Game game, Player p) {
+        if (game.isExtraSecretMode()) return 0;
+        if (game.isErwansGambitMode() && "mentak".equalsIgnoreCase(p.getFaction())) return 0;
+        return Math.max(0, p.getSecrets().size() - 1);
+    }
+
+    public static boolean secretsDealt(Game game) {
+        for (Player p : game.getRealPlayers()) {
+            if (!p.getSecrets().isEmpty() || !p.getSecretsScored().isEmpty()) return true;
+        }
+        return false;
+    }
+
+    /** Users (other than the given one) who still have starting technologies to choose; Keleres waits on them. */
+    public static List<String> othersChoosingStartingTech(Game game, Player except) {
+        List<String> out = new ArrayList<>();
+        for (Player p : game.getPlayers().values()) {
+            if (p == null || p == except || p.isDummy()) continue;
+            String f = factionOf(p);
+            if (f == null) {
+                if (keleresDrafter(game, p)) out.add(p.getUserID());
+                continue;
+            }
+            if (f.startsWith("keleres")) continue;
+            if (startingTechsNeeded(p) > 0) out.add(p.getUserID());
+        }
+        return out;
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/StateSnapshotBuilder.java b/src/main/java/ti4/selfhost/engine/StateSnapshotBuilder.java
new file mode 100644
index 0000000..9031883
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/StateSnapshotBuilder.java
@@ -0,0 +1,204 @@
+package ti4.selfhost.engine;
+
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import javax.annotation.Nullable;
+import ti4.game.Game;
+import ti4.game.Leader;
+import ti4.game.Player;
+import ti4.game.Tile;
+import ti4.game.UnitHolder;
+import ti4.helpers.Units.UnitKey;
+import ti4.selfhost.engine.EngineModels.CommandTokens;
+import ti4.selfhost.engine.EngineModels.DraftState;
+import ti4.selfhost.engine.EngineModels.ExplorationState;
+import ti4.selfhost.engine.EngineModels.ExploreDeckState;
+import ti4.selfhost.engine.EngineModels.GameState;
+import ti4.selfhost.engine.EngineModels.Hand;
+import ti4.selfhost.engine.EngineModels.HolderState;
+import ti4.selfhost.engine.EngineModels.PlayerState;
+import ti4.selfhost.engine.EngineModels.StrategyCardState;
+import ti4.selfhost.engine.EngineModels.TileState;
+import ti4.selfhost.engine.EngineModels.UnitStack;
+import ti4.selfhost.engine.kinds.ExploreLog;
+
+/**
+ * Builds the authoritative structured state straight from Game/Player (no text, no image pipeline). Callers hold
+ * the game's read lock or accept a racy read (the web-data endpoint does the same). Grow it per area: add fields to
+ * EngineModels + types.ts together.
+ */
+public final class StateSnapshotBuilder {
+    private StateSnapshotBuilder() {}
+
+    public static GameState build(Game game, @Nullable String viewerUserId) {
+        List<PlayerState> players = new ArrayList<>();
+        Player active = game.getActivePlayer();
+        Player speaker = game.getSpeaker();
+        for (Player p : game.getPlayers().values()) {
+            if (p == null) continue;
+            players.add(player(game, p, p.getUserID().equals(viewerUserId), p == active, p == speaker));
+        }
+        List<StrategyCardState> scs = new ArrayList<>();
+        for (Integer sc : game.getSCList()) {
+            if (sc == null || sc <= 0) continue;
+            String holder = null;
+            for (Player p : game.getPlayers().values()) {
+                if (p != null && p.getSCs() != null && p.getSCs().contains(sc)) holder = p.getUserID();
+            }
+            Integer tg = game.getScTradeGoods().get(sc);
+            Boolean played = game.getScPlayed().get(sc);
+            scs.add(ti4.selfhost.engine.kinds.StrategyCards.state(game, sc, holder, tg == null ? 0 : tg, played != null && played));
+        }
+        List<TileState> tiles = new ArrayList<>();
+        for (Map.Entry<String, Tile> e : game.getTileMap().entrySet()) {
+            Tile t = e.getValue();
+            List<HolderState> holders = new ArrayList<>();
+            for (Map.Entry<String, UnitHolder> he : t.getUnitHolders().entrySet()) {
+                UnitHolder uh = he.getValue();
+                List<UnitStack> units = new ArrayList<>();
+                for (Map.Entry<UnitKey, List<Integer>> ue : uh.getUnitsByState().entrySet()) {
+                    List<Integer> st = ue.getValue();
+                    int total = 0;
+                    for (Integer n : st) total += n == null ? 0 : n;
+                    if (total == 0) continue;
+                    UnitKey k = ue.getKey();
+                    Player owner = game.getPlayerFromColorOrFaction(k.getColor());
+                    int dmg = st.size() > 1 ? nz(st.get(1)) + (st.size() > 3 ? nz(st.get(3)) : 0) : 0;
+                    int glv = st.size() > 2 ? nz(st.get(2)) + (st.size() > 3 ? nz(st.get(3)) : 0) : 0;
+                    units.add(new UnitStack(
+                            owner == null ? null : owner.getFaction(),
+                            k.getColor(),
+                            k.asyncID(),
+                            total,
+                            dmg,
+                            glv));
+                }
+                holders.add(new HolderState(
+                        he.getKey(),
+                        units,
+                        new ArrayList<>(uh.getTokenList()),
+                        new ArrayList<>(uh.getControlList())));
+            }
+            tiles.add(new TileState(e.getKey(), t.getTileID(), holders));
+        }
+        Map<String, List<String>> objectives = new LinkedHashMap<>();
+        for (String po : game.getRevealedPublicObjectives().keySet()) {
+            List<String> scorers = game.getScoredPublicObjectives().get(po);
+            objectives.put(po, scorers == null ? List.of() : List.copyOf(scorers));
+        }
+        return new GameState(
+                EngineModels.CONTRACT_VERSION,
+                game.getName(),
+                game.getLastModifiedDate(),
+                DecisionRegistry.currentSeq(),
+                game.getPhaseOfGame(),
+                game.getRound(),
+                active == null ? null : active.getUserID(),
+                speaker == null ? null : speaker.getUserID(),
+                players,
+                scs,
+                tiles,
+                objectives,
+                new ArrayList<>(game.getLaws().keySet()),
+                draft(game),
+                exploration(game, viewerUserId),
+                agenda(game, viewerUserId),
+                ti4.selfhost.engine.kinds.StatusPhase.state(game, viewerUserId),
+                ThundersEdgeStateBuilder.build(game),
+                SetupStateBuilder.build(game),
+                TradeEngine.state(game, viewerUserId),
+                ti4.selfhost.engine.kinds.CombatSupport.state(game));
+    }
+
+    private static EngineModels.AgendaState agenda(Game game, @Nullable String viewerUserId) {
+        try {
+            return ti4.selfhost.engine.kinds.AgendaSupport.state(game, viewerUserId);
+        } catch (Exception e) {
+            return null;
+        }
+    }
+
+    private static int nz(Integer i) {
+        return i == null ? 0 : i;
+    }
+
+    private static PlayerState player(Game game, Player p, boolean self, boolean active, boolean speaker) {
+        List<String> leaders = new ArrayList<>();
+        for (Leader l : p.getLeaders()) {
+            leaders.add(l.getId() + (l.isLocked() ? ":locked" : l.isExhausted() ? ":exhausted" : ""));
+        }
+        Hand hand = self
+                ? new Hand(
+                        new LinkedHashMap<>(p.getActionCards()),
+                        new LinkedHashMap<>(p.getSecrets()),
+                        new LinkedHashMap<>(p.getPromissoryNotes()))
+                : null;
+        return new PlayerState(
+                p.getUserID(),
+                p.getUserName(),
+                normalize(p.getFaction()),
+                normalize(p.getColor()),
+                self,
+                p.isRealPlayer(),
+                p.isPassed(),
+                p.isEliminated(),
+                speaker,
+                active,
+                safeVp(p),
+                p.getTg(),
+                p.getCommodities(),
+                p.getCommoditiesTotal(),
+                new CommandTokens(p.getTacticalCC(), p.getFleetCC(), p.getStrategicCC()),
+                new ArrayList<>(p.getSCs()),
+                new ArrayList<>(p.getTechs()),
+                new ArrayList<>(p.getExhaustedTechs()),
+                new ArrayList<>(p.getPlanets()),
+                new ArrayList<>(p.getExhaustedPlanets()),
+                new ArrayList<>(p.getRelics()),
+                new ArrayList<>(p.getFragments()),
+                leaders,
+                new ArrayList<>(p.getPromissoryNotesInPlayArea()),
+                new LinkedHashMap<>(p.getSecretsScored()),
+                p.getActionCards().size(),
+                p.getSecrets().size(),
+                p.getPromissoryNotes().size(),
+                hand);
+    }
+
+    private static int safeVp(Player p) {
+        try {
+            return p.getTotalVictoryPoints();
+        } catch (Exception e) {
+            return 0;
+        }
+    }
+
+    private static String normalize(String s) {
+        return s == null || "null".equals(s) || s.isBlank() ? null : s;
+    }
+
+    private static ExplorationState exploration(Game game, @Nullable String viewerUserId) {
+        try {
+            Map<String, ExploreDeckState> decks = new LinkedHashMap<>();
+            for (String trait : List.of("cultural", "industrial", "hazardous", "frontier")) {
+                decks.put(
+                        trait,
+                        new ExploreDeckState(
+                                game.getExploreDeck(trait).size(), new ArrayList<>(game.getExploreDiscard(trait))));
+            }
+            return new ExplorationState(decks, game.getRelicDeckSize(), ExploreLog.recent(game, viewerUserId));
+        } catch (Exception e) {
+            return null;
+        }
+    }
+
+    private static DraftState draft(Game game) {
+        try {
+            return SetupStateBuilder.draft(game);
+        } catch (Exception e) {
+            return null;
+        }
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/TacticalController.java b/src/main/java/ti4/selfhost/engine/TacticalController.java
new file mode 100644
index 0000000..293647a
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/TacticalController.java
@@ -0,0 +1,445 @@
+package ti4.selfhost.engine;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.HashMap;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+import net.dv8tion.jda.api.entities.channel.middleman.MessageChannel;
+import org.apache.commons.lang3.function.Consumers;
+import org.springframework.http.CacheControl;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.security.access.prepost.PreAuthorize;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestHeader;
+import org.springframework.web.bind.annotation.RestController;
+import ti4.discord.JdaService;
+import ti4.discord.interactions.buttons.handlers.faction.homebrew.theodisi.arcanum.ArcanumPrimordialTechHandler;
+import ti4.executors.ExecutionLockManager;
+import ti4.executors.ExecutionLockType;
+import ti4.game.Game;
+import ti4.game.Planet;
+import ti4.game.Player;
+import ti4.game.Tile;
+import ti4.game.UnitHolder;
+import ti4.game.persistence.GameManager;
+import ti4.game.persistence.ManagedGame;
+import ti4.helpers.CheckDistanceHelper;
+import ti4.helpers.Units;
+import ti4.helpers.Units.UnitKey;
+import ti4.helpers.Units.UnitState;
+import ti4.logging.BotLogger;
+import ti4.model.UnitModel;
+import ti4.selfhost.engine.EngineModels.AnswerRequest;
+import ti4.selfhost.engine.EngineModels.AnswerResult;
+import ti4.selfhost.engine.EngineModels.Decision;
+import ti4.selfhost.engine.EngineModels.Option;
+import ti4.selfhost.engine.tactical.TacticalFacts;
+import ti4.service.planet.AsgardLegendaryService;
+import ti4.service.tactical.TacticalActionDisplacementService;
+import ti4.service.tactical.TacticalActionOutputService;
+import ti4.spring.context.RequestContext;
+import ti4.spring.context.SetupRequestContext;
+
+/**
+ * Direct tactical actions on typed decisions (G3), so a client never walks the per-unit buttons:
+ * <ul>
+ *   <li>{@code …/decisions/{id}/move} on a {@code tactical.move} decision: stage the whole movement into the active
+ *   system ({units:[{from, holder, unit, color?, count, damaged?}]}, replacing anything staged before) and, unless
+ *   {conclude:false}, press that prompt's "Done moving" (space cannon, combat, landing follow as usual).</li>
+ *   <li>{@code …/decisions/{id}/land} on a {@code tactical.land} decision: land {landings:[{planet, unit, count,
+ *   color?}]} by answering the prompt's land options one by one, then (unless {done:false}) "Done Landing Troops".</li>
+ * </ul>
+ * Same answer semantics as ActionInvoker (stale / forbidden / refused…), same {@link AnswerResult} shape with every
+ * decision opened meanwhile. Trusted routes (Bot token, userId in body) and seat routes (Bearer, own seat). The seat
+ * routes opt out of the request-context lock/save: the game is loaded from disk per access, so a request-scoped copy
+ * saved after the handler would overwrite what the handler saved.
+ */
+@RestController
+public class TacticalController {
+
+    public record MoveUnit(String from, String holder, String unit, String color, int count, Integer damaged) {}
+
+    public record MoveRequest(
+            List<MoveUnit> units, Boolean conclude, Long expectedSeq, String requestId, String userId) {}
+
+    public record Landing(String planet, String unit, int count, String color) {}
+
+    public record LandRequest(
+            List<Landing> landings, Boolean done, Long expectedSeq, String requestId, String userId) {}
+
+    private static final Map<String, AnswerResult> byRequestId =
+            Collections.synchronizedMap(new LinkedHashMap<>(64, 0.75f, true) {
+                @Override
+                protected boolean removeEldestEntry(Map.Entry<String, AnswerResult> e) {
+                    return size() > 500;
+                }
+            });
+
+    // ------------------------------------------------------------------ routes
+
+    @PostMapping("/api/public/selfhost/engine/{game}/decisions/{id}/move")
+    public ResponseEntity<?> moveAs(
+            @PathVariable String game,
+            @PathVariable String id,
+            @RequestBody MoveRequest req,
+            @RequestHeader(value = "Authorization", required = false) String auth) {
+        if (!EngineController.trusted(auth)) return status(HttpStatus.UNAUTHORIZED, "bot token required");
+        if (req.userId() == null) return status(HttpStatus.BAD_REQUEST, "userId required");
+        return respond(once(req.userId(), req.requestId(), () -> move(game, id, req.userId(), req)));
+    }
+
+    @PostMapping("/api/game/{gameName}/engine/decisions/{id}/move")
+    @PreAuthorize("@security.canAccessGame(#gameName)")
+    @SetupRequestContext(false)
+    public ResponseEntity<?> move(@PathVariable String gameName, @PathVariable String id, @RequestBody MoveRequest req) {
+        String me = RequestContext.getUserId();
+        return respond(once(me, req.requestId(), () -> move(gameName, id, me, req)));
+    }
+
+    @PostMapping("/api/public/selfhost/engine/{game}/decisions/{id}/land")
+    public ResponseEntity<?> landAs(
+            @PathVariable String game,
+            @PathVariable String id,
+            @RequestBody LandRequest req,
+            @RequestHeader(value = "Authorization", required = false) String auth) {
+        if (!EngineController.trusted(auth)) return status(HttpStatus.UNAUTHORIZED, "bot token required");
+        if (req.userId() == null) return status(HttpStatus.BAD_REQUEST, "userId required");
+        return respond(once(req.userId(), req.requestId(), () -> land(game, id, req.userId(), req)));
+    }
+
+    @PostMapping("/api/game/{gameName}/engine/decisions/{id}/land")
+    @PreAuthorize("@security.canAccessGame(#gameName)")
+    @SetupRequestContext(false)
+    public ResponseEntity<?> land(@PathVariable String gameName, @PathVariable String id, @RequestBody LandRequest req) {
+        String me = RequestContext.getUserId();
+        return respond(once(me, req.requestId(), () -> land(gameName, id, me, req)));
+    }
+
+    // ------------------------------------------------------------------ move
+
+    static AnswerResult move(String gameName, String decisionId, String userId, MoveRequest req) {
+        return ActionInvoker.asOneUndoStep(
+                gameName, userId, "tactical.move", () -> moveSteps(gameName, decisionId, userId, req));
+    }
+
+    private static AnswerResult moveSteps(String gameName, String decisionId, String userId, MoveRequest req) {
+        Decision d = DecisionRegistry.get(decisionId);
+        AnswerResult bad = check(d, gameName, decisionId, userId, "tactical.move", req.expectedSeq());
+        if (bad != null) return bad;
+        long before = DecisionRegistry.currentSeq();
+        boolean conclude = !Boolean.FALSE.equals(req.conclude());
+
+        // In the per-system sub-step the prompt has no "Done moving": go back to the system list first.
+        if (conclude && optionWith(d, "action", "done") == null) {
+            Option back = optionWith(d, "action", "back");
+            if (back == null) return fail("refused", "This movement prompt cannot finish movement.", decisionId);
+            AnswerResult r = ActionInvoker.answer(gameName, d.id(), userId, new AnswerRequest(back.id(), null, null, userId));
+            if (!r.ok()) return r;
+            d = awaitRevision(d.source().messageId(), d);
+            if (d == null || optionWith(d, "action", "done") == null)
+                return fail("stale", "The movement prompt did not come back; re-read it.", decisionId);
+        }
+
+        String messageId = d.source().messageId();
+        String channelId = d.source().channelId();
+        ExecutionLockManager.lock(gameName, ExecutionLockType.WRITE);
+        try {
+            Game game = loadGame(gameName);
+            if (game == null) return fail("not_found", "No such game.", decisionId);
+            Player player = game.getPlayer(userId);
+            if (player == null) return fail("forbidden", "You are not a player of this game.", decisionId);
+            String active = game.getActiveSystem();
+            if (active == null || active.isBlank() || game.getTileByPosition(active) == null)
+                return fail("refused", "No system is active.", decisionId);
+
+            if (!game.getTacticalActionDisplacement().isEmpty())
+                TacticalActionDisplacementService.reverseAllUnitMovement(game, player);
+            Map<String, Map<UnitKey, List<Integer>>> internal = new HashMap<>();
+            for (MoveUnit u : req.units() == null ? List.<MoveUnit>of() : req.units()) {
+                String err = addMove(game, player, active, u, internal);
+                if (err != null) return fail("refused", err, decisionId);
+            }
+            TacticalActionDisplacementService.stageFullDisplacementAndRemoveFromOrigins(game, player, internal);
+            markRifts(game, player, active, internal);
+            if (!conclude) TacticalActionOutputService.refreshButtonsAndMessageForChoosingTile(null, game, player);
+            GameManager.save(game, player.getUserName() + " moved units (engine)");
+        } catch (Exception e) {
+            BotLogger.error("engine: move " + decisionId + " by " + userId + " failed", e);
+            return fail("error", String.valueOf(e.getMessage()), decisionId);
+        } finally {
+            ExecutionLockManager.unlock(gameName, ExecutionLockType.WRITE);
+        }
+
+        if (conclude) {
+            Option done = optionWith(d, "action", "done");
+            AnswerResult r = ActionInvoker.answer(gameName, d.id(), userId, new AnswerRequest(done.id(), null, null, userId));
+            if (!r.ok()) return r;
+            return done(gameName, decisionId, before);
+        }
+        // Staged only: the engine posted a fresh movement prompt; retire the old one.
+        deleteMessage(channelId, messageId);
+        awaitOpened(gameName, before, userId, "tactical.move");
+        return done(gameName, decisionId, before);
+    }
+
+    /** Validates one move order against the board and adds it to the displacement (states: healthy first). */
+    private static String addMove(
+            Game game, Player player, String active, MoveUnit u, Map<String, Map<UnitKey, List<Integer>>> out) {
+        if (u == null || u.count() < 1) return null;
+        Tile tile = u.from() == null ? null : game.getTileByPosition(u.from());
+        if (tile == null) return "No system at " + u.from() + ".";
+        if (tile.getPosition().equalsIgnoreCase(active)) return "Units in the active system do not move.";
+        if (!TacticalFacts.canLeave(game, player, tile))
+            return "Your command token is in " + u.from() + "; units there cannot move.";
+        String holderName = u.holder() == null || u.holder().isBlank() ? "space" : u.holder().toLowerCase();
+        UnitHolder holder =
+                "space".equals(holderName) ? tile.getSpaceUnitHolder() : tile.getUnitHolderFromPlanet(holderName);
+        if (holder == null) return "No " + holderName + " in " + u.from() + ".";
+        String color = u.color() == null || u.color().isBlank() ? player.getColor() : u.color();
+        Player owner = game.getPlayerFromColorOrFaction(color);
+        if (owner == null) return "Unknown colour " + color + ".";
+        if (owner != player && !player.getAllianceMembers().contains(owner.getFaction()))
+            return "Those units are not yours.";
+        UnitKey key = Units.getUnitKey(u.unit(), owner.getColor());
+        if (key == null) return "Unknown unit " + u.unit() + ".";
+        if (holder instanceof Planet && !(key.unitType() == Units.UnitType.Infantry
+                || key.unitType() == Units.UnitType.Mech
+                || key.unitType() == Units.UnitType.Fighter))
+            return "Only ground forces leave a planet.";
+        List<Integer> have = holder.getUnitsByStateForPlayer(owner).getOrDefault(key, List.of());
+        String uhKey = tile.getPosition() + "-" + holder.getName();
+        List<Integer> already = out.getOrDefault(uhKey, Map.of()).getOrDefault(key, List.of(0, 0, 0, 0));
+        int[] left = new int[4];
+        for (int i = 0; i < 4; i++) left[i] = count(have, i) - count(already, i);
+        int healthyAvail = left[UnitState.none.ordinal()] + left[UnitState.glv.ordinal()];
+        int damagedAvail = left[UnitState.dmg.ordinal()] + left[UnitState.dmg_glv.ordinal()];
+        int damaged = u.damaged() != null ? u.damaged() : Math.max(0, u.count() - healthyAvail);
+        int healthy = u.count() - damaged;
+        if (damaged < 0 || healthy < 0 || damaged > damagedAvail || healthy > healthyAvail)
+            return "Not enough " + u.unit() + " in " + uhKey + " (have " + (healthyAvail + damagedAvail) + ").";
+        List<Integer> states = new ArrayList<>(List.of(0, 0, 0, 0));
+        take(states, left, UnitState.none, UnitState.glv, healthy);
+        take(states, left, UnitState.dmg, UnitState.dmg_glv, damaged);
+        Map<UnitKey, List<Integer>> byKey = out.computeIfAbsent(uhKey, k -> new HashMap<>());
+        List<Integer> sum = new ArrayList<>(List.of(0, 0, 0, 0));
+        for (int i = 0; i < 4; i++) sum.set(i, count(already, i) + states.get(i));
+        byKey.put(key, sum);
+        return null;
+    }
+
+    private static void take(List<Integer> states, int[] left, UnitState first, UnitState second, int n) {
+        int a = Math.min(n, left[first.ordinal()]);
+        states.set(first.ordinal(), a);
+        states.set(second.ordinal(), n - a);
+    }
+
+    private static int count(List<Integer> s, int i) {
+        return s == null || s.size() <= i ? 0 : Objects.requireNonNullElse(s.get(i), 0);
+    }
+
+    /**
+     * What TacticalActionOutputService.validateMoveValue records while the move prompt is refreshed: a ship that
+     * may have taken a shorter path through a gravity rift makes the engine offer the rift rolls afterwards.
+     */
+    private static void markRifts(
+            Game game, Player player, String active, Map<String, Map<UnitKey, List<Integer>>> moved) {
+        boolean ignores = ArcanumPrimordialTechHandler.planeShiftIgnoresAnomalies(game, player)
+                || AsgardLegendaryService.isBifrostBridgeActive(game, player);
+        if (ignores || player.hasAbility("celestial_guides")) return;
+        for (Map.Entry<String, Map<UnitKey, List<Integer>>> e : moved.entrySet()) {
+            String pos = e.getKey().substring(0, e.getKey().indexOf('-'));
+            boolean ships = false;
+            for (UnitKey k : e.getValue().keySet()) {
+                UnitModel m = player.getUnitFromUnitKey(k);
+                if (m != null && m.getMoveValue() > 0) ships = true;
+            }
+            if (!ships) continue;
+            try {
+                int distance = CheckDistanceHelper.getDistanceBetweenTwoTiles(game, player, pos, active, true);
+                int rift = CheckDistanceHelper.getDistanceBetweenTwoTiles(game, player, pos, active, false);
+                if (rift < distance) game.setStoredValue("possiblyUsedRift", "yes");
+            } catch (Exception ignored) {
+                // distance unknown: no rift prompt
+            }
+        }
+    }
+
+    // ------------------------------------------------------------------ land
+
+    static AnswerResult land(String gameName, String decisionId, String userId, LandRequest req) {
+        return ActionInvoker.asOneUndoStep(
+                gameName, userId, "tactical.land", () -> landSteps(gameName, decisionId, userId, req));
+    }
+
+    private static AnswerResult landSteps(String gameName, String decisionId, String userId, LandRequest req) {
+        Decision d = DecisionRegistry.get(decisionId);
+        AnswerResult bad = check(d, gameName, decisionId, userId, "tactical.land", req.expectedSeq());
+        if (bad != null) return bad;
+        long before = DecisionRegistry.currentSeq();
+        String messageId = d.source().messageId();
+        Player me = player(gameName, userId);
+        String myColor = me == null ? null : me.getColor();
+        for (Landing l : req.landings() == null ? List.<Landing>of() : req.landings()) {
+            int left = l.count();
+            String color = l.color() == null || l.color().isBlank() ? myColor : l.color();
+            while (left > 0) {
+                Decision cur = DecisionRegistry.get(DecisionRegistry.decisionIdForMessage(messageId));
+                if (cur == null) return fail("stale", "The landing prompt is gone.", decisionId);
+                Option pick = null;
+                int best = 0;
+                for (Option o : cur.options()) {
+                    Map<String, Object> v = o.value();
+                    if (v == null || o.disabled() || !"land".equals(v.get("op"))) continue;
+                    if (!Objects.equals(v.get("planet"), l.planet()) || !Objects.equals(v.get("unit"), l.unit())) continue;
+                    if (color != null && !color.equalsIgnoreCase(String.valueOf(v.get("color")))) continue;
+                    int n = ((Number) v.get("count")).intValue();
+                    if (n <= left && n > best) {
+                        best = n;
+                        pick = o;
+                    }
+                }
+                if (pick == null)
+                    return fail("refused", "The engine no longer offers landing " + left + " " + l.unit() + " on "
+                            + l.planet() + ".", decisionId);
+                AnswerResult r = ActionInvoker.answer(gameName, cur.id(), userId, new AnswerRequest(pick.id(), null, null, userId));
+                if (!r.ok()) return r;
+                left -= best;
+                awaitRevision(messageId, cur);
+            }
+        }
+        if (!Boolean.FALSE.equals(req.done())) {
+            Decision cur = DecisionRegistry.get(DecisionRegistry.decisionIdForMessage(messageId));
+            Option done = cur == null ? null : optionWith(cur, "op", "done");
+            if (done == null) return fail("refused", "The landing prompt has no Done Landing Troops.", decisionId);
+            AnswerResult r = ActionInvoker.answer(gameName, cur.id(), userId, new AnswerRequest(done.id(), null, null, userId));
+            if (!r.ok()) return r;
+        }
+        return done(gameName, decisionId, before);
+    }
+
+    // ------------------------------------------------------------------ helpers
+
+    private static AnswerResult check(
+            Decision d, String gameName, String decisionId, String userId, String kind, Long expectedSeq) {
+        if (d == null || !d.game().equals(gameName)) return fail("stale", "That decision is no longer open.", decisionId);
+        if (!kind.equals(d.kind())) return fail("bad_option", "That decision is not " + kind + ".", decisionId);
+        if (expectedSeq != null && expectedSeq != d.seq()) return fail("stale", "That decision changed; re-read it.", decisionId);
+        if (d.target() == null || !userId.equals(d.target().userId()))
+            return fail("forbidden", "That decision is for someone else.", decisionId);
+        return null;
+    }
+
+    static Option optionWith(Decision d, String key, String value) {
+        for (Option o : d.options())
+            if (!o.disabled() && o.value() != null && value.equals(o.value().get(key))) return o;
+        return null;
+    }
+
+    /**
+     * Waits (≤5 s) until the handler's edit of the message is captured — its options change, it becomes another
+     * decision, or it is gone (handlers edit asynchronously). Returns the message's current decision.
+     */
+    private static Decision awaitRevision(String messageId, Decision old) {
+        String oldOptions = optionKey(old);
+        long until = System.currentTimeMillis() + 5000;
+        while (System.currentTimeMillis() < until) {
+            String now = DecisionRegistry.decisionIdForMessage(messageId);
+            if (now == null) return null;
+            Decision d = DecisionRegistry.get(now);
+            if (d == null || !now.equals(old.id()) || !optionKey(d).equals(oldOptions)) return d;
+            sleep(50);
+        }
+        String now = DecisionRegistry.decisionIdForMessage(messageId);
+        return now == null ? null : DecisionRegistry.get(now);
+    }
+
+    private static String optionKey(Decision d) {
+        StringBuilder sb = new StringBuilder();
+        for (Option o : d.options()) sb.append(o.id()).append('|').append(o.label()).append('|').append(o.disabled()).append(';');
+        return sb.toString();
+    }
+
+    private static void awaitOpened(String game, long after, String userId, String kind) {
+        long until = System.currentTimeMillis() + 3000;
+        while (System.currentTimeMillis() < until) {
+            for (Decision d : DecisionRegistry.openedAfter(game, after))
+                if (kind.equals(d.kind()) && d.target() != null && userId.equals(d.target().userId())) return;
+            sleep(50);
+        }
+    }
+
+    private static void deleteMessage(String channelId, String messageId) {
+        try {
+            MessageChannel ch = JdaService.jda.getChannelById(MessageChannel.class, channelId);
+            if (ch != null) ch.deleteMessageById(messageId).queue(Consumers.nop(), BotLogger::catchRestError);
+        } catch (Exception e) {
+            BotLogger.error("engine: could not delete replaced movement prompt " + messageId, e);
+        }
+    }
+
+    private static AnswerResult done(String gameName, String decisionId, long before) {
+        Game game = loadGame(gameName);
+        return new AnswerResult(
+                true,
+                "done",
+                null,
+                decisionId,
+                DecisionRegistry.currentSeq(),
+                game == null ? 0 : game.getLastModifiedDate(),
+                DecisionRegistry.openedAfter(gameName, before));
+    }
+
+    private static Game loadGame(String name) {
+        ManagedGame mg = GameManager.getManagedGame(name);
+        return mg == null ? null : mg.getGame();
+    }
+
+    private static Player player(String gameName, String userId) {
+        Game g = loadGame(gameName);
+        return g == null ? null : g.getPlayer(userId);
+    }
+
+    private static AnswerResult once(String userId, String requestId, java.util.function.Supplier<AnswerResult> run) {
+        if (requestId == null) return run.get();
+        String key = userId + ":" + requestId;
+        AnswerResult prev = byRequestId.get(key);
+        if (prev != null) return prev;
+        AnswerResult r = run.get();
+        if (!"busy".equals(r.status())) byRequestId.put(key, r);
+        return r;
+    }
+
+    private static AnswerResult fail(String status, String error, String decisionId) {
+        return new AnswerResult(false, status, error, decisionId, DecisionRegistry.currentSeq(), 0, List.of());
+    }
+
+    private static void sleep(long ms) {
+        try {
+            Thread.sleep(ms);
+        } catch (InterruptedException e) {
+            Thread.currentThread().interrupt();
+        }
+    }
+
+    private static ResponseEntity<?> respond(AnswerResult r) {
+        HttpStatus status = switch (r.status()) {
+            case "done" -> HttpStatus.OK;
+            case "stale", "busy" -> HttpStatus.CONFLICT;
+            case "forbidden" -> HttpStatus.FORBIDDEN;
+            case "not_found" -> HttpStatus.NOT_FOUND;
+            case "error" -> HttpStatus.INTERNAL_SERVER_ERROR;
+            default -> HttpStatus.UNPROCESSABLE_ENTITY;
+        };
+        return ResponseEntity.status(status).cacheControl(CacheControl.noStore()).body(r);
+    }
+
+    private static ResponseEntity<?> status(HttpStatus s, String error) {
+        return ResponseEntity.status(s).body(Map.of("error", error));
+    }
+}
