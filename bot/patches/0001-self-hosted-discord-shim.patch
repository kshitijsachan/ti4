+package ti4.selfhost.engine.kinds;
+
+import java.util.Map;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * Queue a Milty pick for when it is your turn (posted in each drafter's cards-info thread):
+ * queueMilyPick_&lt;category&gt;_&lt;value&gt;, restartMiltyQueue, restartAllMiltyQueue.
+ * value: {action: "queue"|"restart"|"restart_all", category, pick} (category/pick null for the restarts).
+ */
+public class MiltyDraftQueueKind implements KindSpec {
+
+    @Override
+    public String kind() {
+        return "draft.milty.queue";
+    }
+
+    @Override
+    public int priority() {
+        return 90;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return handlerId.matches("queueMilyPick_(slice|faction|order)_.+")
+                || "restartMiltyQueue".equals(handlerId)
+                || "restartAllMiltyQueue".equals(handlerId);
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        if ("restartMiltyQueue".equals(handlerId))
+            return SetupKindSupport.map("action", "restart", "category", null, "pick", null);
+        if ("restartAllMiltyQueue".equals(handlerId))
+            return SetupKindSupport.map("action", "restart_all", "category", null, "pick", null);
+        if (!matches(handlerId)) return null;
+        String rest = handlerId.substring("queueMilyPick_".length());
+        int us = rest.indexOf('_');
+        return SetupKindSupport.map(
+                "action", "queue", "category", rest.substring(0, us), "pick", rest.substring(us + 1));
+    }
+
+    /** Setup: faction / colour are picked after capture; re-resolve the target on every state change. */
+    @Override
+    public boolean dynamic() {
+        return true;
+    }
+
+    @Override
+    public ti4.selfhost.engine.EngineModels.Target target(
+            CaptureContext ctx, ti4.selfhost.engine.EngineModels.Target resolved) {
+        return SetupKindSupport.refresh(ctx, resolved);
+    }
+
+    /** Once the draft is over this prompt is a leftover (live: hundreds open across games). */
+    @Override
+    public boolean obsolete(CaptureContext ctx) {
+        return ti4.selfhost.engine.SetupStateBuilder.pastSetup(ctx.game())
+                || ti4.selfhost.engine.SetupStateBuilder.draftFinished(
+                        ctx.game(), ctx.game().getMiltyDraftManager());
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/PaymentSpendKind.java b/src/main/java/ti4/selfhost/engine/kinds/PaymentSpendKind.java
new file mode 100644
index 0000000..a849c5b
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/PaymentSpendKind.java
@@ -0,0 +1,304 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+import ti4.game.Game;
+import ti4.game.Planet;
+import ti4.game.Player;
+import ti4.helpers.AliasHandler;
+import ti4.helpers.Helper;
+import ti4.selfhost.engine.DecisionRegistry;
+import ti4.selfhost.engine.EngineModels.Decision;
+import ti4.selfhost.engine.EngineModels.Option;
+import ti4.selfhost.engine.EngineModels.Progress;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * Paying a cost: the engine's "please choose the planets you wish to exhaust" message (ButtonHelper
+ * .getExhaustButtonsWithTG): spend_&lt;planet&gt;_&lt;for&gt;, reduceTG_&lt;n&gt;_&lt;for&gt;, reduceComm_&lt;n&gt;_&lt;for&gt; (only
+ * offered while the Keleres agent is ready), useTech_st (Sarween Tools), resetSpend, and the "Done Exhausting
+ * Planets" button (deleteButtons_&lt;context&gt; / finishComponentAction_spitItOut).
+ *
+ * <p>Answered in ONE action with a payload {planets: [planetId], tg: n, commodities: n, sarween: bool}: validated
+ * against the offered options and the player's state (no commodities without the Keleres agent, no exhausted planet,
+ * no more trade goods than held, and never less than the cost when the engine knows it), then executed as the same
+ * presses a player would make, under the game lock, ending with Done. A plain option press still works (legacy).
+ */
+public class PaymentSpendKind implements KindSpec {
+    static final String KIND = "payment.spend";
+    private static final Pattern PROMPT_COST = Pattern.compile(
+            "(?i)(?:cost of|preceding build cost|pay the required|pay a cost of|to pay|required) (\\d+)\\b");
+    private static final Pattern PROMPT_EMOJI_COST = Pattern.compile("(?i)spend <:(?:influence|resources)_(\\d+):");
+
+    @Override
+    public String kind() {
+        return KIND;
+    }
+
+    @Override
+    public int priority() {
+        return 100;
+    }
+
+    /** Classification: any option of the message claims it (Done buttons never do). */
+    @Override
+    public boolean classifies(List<String> handlerIds) {
+        for (String h : handlerIds) if (h != null && claims(h)) return true;
+        return false;
+    }
+
+    static boolean claims(String h) {
+        return h.startsWith("spend_") || h.startsWith("reduceTG_") || h.startsWith("reduceComm_");
+    }
+
+    @Override
+    public boolean matches(String h) {
+        return claims(h)
+                || h.startsWith("resetSpend")
+                || h.equals("useTech_st")
+                || h.equals("useTech_absol_st")
+                || isDone(h);
+    }
+
+    static boolean isDone(String h) {
+        // Only typed inside a message classified as a payment (claims() never claims a Done button).
+        return h.equals("deleteButtons") || h.matches("deleteButtons_[A-Za-z0-9]+") || h.equals("finishComponentAction_spitItOut");
+    }
+
+    @Override
+    public Map<String, Object> value(String h, CaptureContext ctx) {
+        Game game = ctx.game();
+        String whatFor = PaymentSupport.whatFor(ctx.handlerIds());
+        Map<String, Object> v = new LinkedHashMap<>();
+        if (h.startsWith("spend_")) {
+            String planet = h.split("_")[1];
+            Planet p = game.getPlanetsInfo().get(AliasHandler.resolvePlanet(planet));
+            v.put("source", "planet");
+            v.put("planet", planet);
+            // Planet values include attachments and other modifiers (Planet.getResources/getInfluence).
+            v.put("resources", p == null ? 0 : p.getResources());
+            v.put("influence", p == null ? 0 : p.getInfluence());
+            v.put("techSpecialties", p == null ? List.of() : p.getTechSpecialities());
+            v.put("legendary", p != null && p.isLegendary());
+            return v;
+        }
+        if (h.startsWith("reduceTG_") || h.startsWith("reduceComm_")) {
+            v.put("source", h.startsWith("reduceTG_") ? "tg" : "commodities");
+            v.put("amount", PaymentSupport.intOf(h.split("_")[1], 0));
+            return v;
+        }
+        if (h.startsWith("useTech_")) {
+            v.put("source", "discount");
+            v.put("discount", "sarween");
+            return v;
+        }
+        if (h.startsWith("resetSpend")) {
+            v.put("action", "reset");
+            return v;
+        }
+        // Done: decision-level facts (what it pays for, how much, how much is already counted).
+        Facts f = facts(ctx);
+        String context = h.startsWith("finishComponentAction")
+                ? "componentAction"
+                : h.startsWith("deleteButtons_") ? h.substring("deleteButtons_".length()) : "";
+        v.put("action", "done");
+        v.put("context", context);
+        v.put("for", f.whatFor());
+        v.put("currency", f.currency());
+        v.put("tech", f.whatFor().contains("tech"));
+        v.put("cost", f.cost());
+        v.put("costSource", f.costSource());
+        v.put("spentResources", f.spent()[0]);
+        v.put("spentInfluence", f.spent()[1]);
+        Player player = ctx.player();
+        v.put("tgValue", player != null && player.hasTech("mc") ? 2 : 1);
+        v.put("keleresAgent", player != null && player.hasUnexhaustedLeader("keleresagent"));
+        return v;
+    }
+
+    record Facts(String whatFor, String currency, Integer cost, String costSource, int[] spent) {}
+
+    /** Payment facts from engine state (stored values, the player's spent-things window), never from labels. */
+    static Facts facts(CaptureContext ctx) {
+        Game game = ctx.game();
+        List<String> handlers = ctx.handlerIds();
+        Decision existing = existing(ctx.messageId());
+        if (handlers == null && existing != null)
+            handlers = existing.options().stream().map(Option::handler).toList();
+        String whatFor = PaymentSupport.whatFor(handlers);
+        String currency = PaymentSupport.currency(whatFor);
+        Player player = ctx.player();
+        Integer cost = null;
+        String costSource = null;
+        if (player != null && !"inf".equals(currency)) {
+            String stored = game.getStoredValue("producedUnitCostFor" + player.getFaction());
+            if (stored != null && stored.matches("\\d+")) {
+                cost = Integer.parseInt(stored);
+                costSource = "production";
+            }
+        }
+        if (cost == null
+                && existing != null
+                && existing.progress() != null
+                && existing.progress().required() != null
+                && existing.progress().required().get("cost") instanceof Integer i) {
+            cost = i; // the engine replaces the prompt text after the first spend: keep the first reading
+            costSource = String.valueOf(existing.progress().required().get("costSource"));
+        }
+        if (cost == null && ctx.content() != null) {
+            Matcher m = PROMPT_COST.matcher(ctx.content());
+            Matcher e = PROMPT_EMOJI_COST.matcher(ctx.content());
+            if (m.find()) cost = Integer.parseInt(m.group(1));
+            else if (e.find()) cost = Integer.parseInt(e.group(1));
+            if (cost != null) costSource = "prompt";
+        }
+        int[] spent = player == null ? new int[2] : PaymentSupport.spent(game, player, whatFor);
+        return new Facts(whatFor, currency, cost, costSource, spent);
+    }
+
+    private static Decision existing(String messageId) {
+        String id = DecisionRegistry.decisionIdForMessage(messageId);
+        Decision d = id == null ? null : DecisionRegistry.get(id);
+        return d != null && KIND.equals(d.kind()) ? d : null;
+    }
+
+    /** Spent totals and cost come from engine state: recompute after every save / undo. */
+    @Override
+    public boolean dynamic() {
+        return true;
+    }
+
+    /**
+     * flow "payment": accumulated = what this window counts so far (engine totals) and the planets / trade goods
+     * spent; required = {currency, cost, costSource, remaining}; canCommit when the cost is covered (or unknown).
+     */
+    @Override
+    public Progress progress(CaptureContext ctx) {
+        Facts f = facts(ctx);
+        Player player = ctx.player();
+        Map<String, Object> acc = new LinkedHashMap<>();
+        acc.put("resources", f.spent()[0]);
+        acc.put("influence", f.spent()[1]);
+        List<String> planets = new ArrayList<>();
+        if (player != null) {
+            for (String t : player.getSpentThingsThisWindow()) {
+                if (ctx.game().getPlanetsInfo().containsKey(AliasHandler.resolvePlanet(t)) && !planets.contains(t))
+                    planets.add(t);
+            }
+            acc.put("tg", player.getSpentTgsThisWindow());
+        }
+        acc.put("planets", planets);
+        Map<String, Object> req = new LinkedHashMap<>();
+        req.put("currency", f.currency());
+        req.put("cost", f.cost());
+        req.put("costSource", f.costSource());
+        int paid = PaymentSupport.value(f.spent(), f.currency());
+        Integer remaining = f.cost() == null ? null : Math.max(0, f.cost() - paid);
+        req.put("remaining", remaining);
+        return new Progress("payment", "select_sources", acc, req, remaining == null || remaining == 0);
+    }
+
+    // ------------------------------------------------------------------ atomic payment
+
+    @Override
+    public boolean acceptsPayload() {
+        return true;
+    }
+
+    @Override
+    public String answerPayload(PayloadAnswer a, Map<String, Object> payload) throws Exception {
+        Decision d = a.decision();
+        Game game = a.game();
+        Player player = a.player();
+        if (d == null || game == null || player == null) return "That payment is no longer open.";
+        Option done = PaymentSupport.firstWith(d, "action", "done");
+        if (done == null) return "This payment has no Done button.";
+        String whatFor = String.valueOf(done.value().get("for"));
+        String currency = String.valueOf(done.value().get("currency"));
+
+        // ---- validate (nothing changes before every check passed)
+        Map<String, String> planetOption = new LinkedHashMap<>();
+        Map<Integer, String> tgOption = new LinkedHashMap<>();
+        Map<Integer, String> commOption = new LinkedHashMap<>();
+        String sarweenOption = null;
+        for (Option o : d.options()) {
+            Map<String, Object> v = o.value();
+            if (v == null || o.disabled()) continue;
+            Object src = v.get("source");
+            if ("planet".equals(src)) planetOption.put(String.valueOf(v.get("planet")), o.id());
+            else if ("tg".equals(src)) tgOption.put(PaymentSupport.intOf(v.get("amount"), 0), o.id());
+            else if ("commodities".equals(src)) commOption.put(PaymentSupport.intOf(v.get("amount"), 0), o.id());
+            else if ("discount".equals(src)) sarweenOption = o.id();
+        }
+        List<String> planets = new ArrayList<>();
+        Set<String> seen = new HashSet<>();
+        Set<String> readied = new HashSet<>(player.getReadiedPlanets());
+        for (Object o : PaymentSupport.listOf(payload.get("planets"))) {
+            String p = String.valueOf(o);
+            if (!seen.add(p)) return "Planet " + p + " is listed twice.";
+            if (!planetOption.containsKey(p)) return "Planet " + p + " is not offered for this payment.";
+            if (!readied.contains(p)) return "Planet " + p + " is exhausted or not yours.";
+            planets.add(p);
+        }
+        int tg = PaymentSupport.intOf(payload.get("tg"), 0);
+        int comms = PaymentSupport.intOf(payload.get("commodities"), 0);
+        boolean sarween = Boolean.TRUE.equals(payload.get("sarween"));
+        if (tg < 0 || comms < 0) return "Amounts cannot be negative.";
+        if (tg > player.getTg()) return "You have only " + player.getTg() + " trade goods.";
+        if (tg > 0 && !tgOption.containsKey(1)) return "Trade goods cannot be spent on this payment.";
+        if (comms > 0) {
+            // Commodities are never money, except through the Keleres agent (Xander Alexin Victori III).
+            if (commOption.isEmpty() || !player.hasUnexhaustedLeader("keleresagent"))
+                return "Commodities can only be spent with the Keleres agent ready.";
+            if (comms > player.getCommodities()) return "You have only " + player.getCommodities() + " commodities.";
+        }
+        if (sarween && sarweenOption == null) return "Sarween Tools is not available for this payment.";
+        String discount = sarween ? (sarweenOption.endsWith("absol_st") ? "absol_sarween" : "sarween") : null;
+        Object costObj = done.value().get("cost");
+        if (costObj instanceof Number cost && ("res".equals(currency) || "inf".equals(currency))) {
+            int total = PaymentSupport.value(
+                    PaymentSupport.simulate(game, player, whatFor, planets, tg, comms, discount), currency);
+            if (total < cost.intValue())
+                return "That pays " + total + " of " + cost.intValue() + ("inf".equals(currency) ? " influence." : " resources.");
+        }
+
+        // ---- execute: the same presses a player makes, then Done
+        if (sarween) a.press(sarweenOption);
+        for (String p : planets) a.press(planetOption.get(p));
+        pressAmounts(a, tgOption, tg, () -> a.player().getTg());
+        pressAmounts(a, commOption, comms, () -> a.player().getCommodities());
+        Player after = a.player();
+        Game g = a.game();
+        Decision latest = a.decision();
+        if (after != null && g != null && latest != null)
+            PaymentSupport.syncContent(latest, Helper.buildSpentThingsMessage(after, g, whatFor));
+        a.press(done.id());
+        return null;
+    }
+
+    /** Spend `amount` with the offered fixed-size buttons (e.g. 3/2/1 trade goods), largest that fits first. */
+    private static void pressAmounts(PayloadAnswer a, Map<Integer, String> options, int amount, IntSupplier held)
+            throws Exception {
+        int left = amount;
+        int guard = 0;
+        while (left > 0 && guard++ < 100) {
+            int have = held.get();
+            int pick = 0;
+            for (int n : options.keySet()) if (n <= left && n <= have && n > pick) pick = n;
+            if (pick == 0) throw new IllegalStateException("cannot spend the remaining " + left);
+            a.press(options.get(pick));
+            left -= pick;
+        }
+    }
+
+    @FunctionalInterface
+    private interface IntSupplier {
+        int get();
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/PaymentSupport.java b/src/main/java/ti4/selfhost/engine/kinds/PaymentSupport.java
new file mode 100644
index 0000000..49213e5
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/PaymentSupport.java
@@ -0,0 +1,127 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+import javax.annotation.Nullable;
+import net.dv8tion.jda.api.entities.channel.middleman.MessageChannel;
+import ti4.discord.JdaService;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.helpers.Helper;
+import ti4.logging.BotLogger;
+import ti4.selfhost.engine.EngineModels.Decision;
+import ti4.selfhost.engine.EngineModels.Option;
+
+/**
+ * Shared helpers for the production/payment kinds. Totals always come from the engine's own accounting
+ * (Helper.buildSpentThingsMessage), so attachments, Mirror Computing, Sarween Tools, Xxcha hero, Emergency
+ * Appropriations etc. count exactly as the engine counts them.
+ */
+final class PaymentSupport {
+    private static final Pattern TOTAL_RES = Pattern.compile("for a total spend of (\\d+) resource");
+    private static final Pattern TOTAL_INF =
+            Pattern.compile("for a total spend of (?:\\d+ resources? or )?(\\d+) influence");
+
+    private PaymentSupport() {}
+
+    /** What a payment is for, from the "_<for>" suffix of its spend_/reduceTG_/reduceComm_ options (engine ids). */
+    static String whatFor(List<String> handlerIds) {
+        if (handlerIds == null) return "both";
+        for (String h : handlerIds) {
+            if (h == null) continue;
+            String[] parts = h.split("_");
+            if ((h.startsWith("reduceTG_") || h.startsWith("reduceComm_")) && parts.length > 2) return parts[2];
+            if (h.startsWith("spend_") && parts.length > 2) return parts[2];
+        }
+        return "both";
+    }
+
+    /** "res", "inf", "both" or "freelancers" — the currency the payment is counted in (tech suffix dropped). */
+    static String currency(String whatFor) {
+        String c = whatFor.replace("tech", "");
+        if (c.equals("tgsonly")) return "res";
+        return c.isEmpty() ? "both" : c;
+    }
+
+    /** {resources, influence} already spent in this payment window, as the engine counts them. */
+    static int[] spent(Game game, Player player, String whatFor) {
+        String msg = Helper.buildSpentThingsMessage(player, game, whatFor);
+        return new int[] {firstInt(TOTAL_RES, msg), firstInt(TOTAL_INF, msg)};
+    }
+
+    /**
+     * {resources, influence} the window would total if these things were spent on top of what already is. Mutates
+     * the player's spent-things list temporarily: call only with the game's WRITE lock held.
+     */
+    static int[] simulate(
+            Game game, Player player, String whatFor, List<String> planets, int tg, int commodities, String discount) {
+        List<String> things = player.getSpentThingsThisWindow();
+        List<String> saved = new ArrayList<>(things);
+        try {
+            if (discount != null) player.addSpentThing(discount);
+            for (String p : planets) player.addSpentThing(p);
+            if (tg > 0) player.increaseTgsSpentThisWindow(tg);
+            if (commodities > 0) player.addSpentThing("comm_" + commodities);
+            return spent(game, player, whatFor);
+        } finally {
+            things.clear();
+            things.addAll(saved);
+        }
+    }
+
+    static int value(int[] spent, String currency) {
+        return "inf".equals(currency) ? spent[1] : spent[0];
+    }
+
+    private static int firstInt(Pattern p, String s) {
+        if (s == null) return 0;
+        Matcher m = p.matcher(s);
+        return m.find() ? Integer.parseInt(m.group(1)) : 0;
+    }
+
+    static int intOf(Object o, int dflt) {
+        if (o instanceof Number n) return n.intValue();
+        if (o instanceof String s) {
+            try {
+                return Integer.parseInt(s.trim());
+            } catch (NumberFormatException e) {
+                return dflt;
+            }
+        }
+        return dflt;
+    }
+
+    @SuppressWarnings("unchecked")
+    static List<Object> listOf(Object o) {
+        return o instanceof List<?> l ? (List<Object>) l : List.of();
+    }
+
+    @Nullable
+    static Option firstWith(Decision d, String key, Object val) {
+        if (d == null) return null;
+        for (Option o : d.options()) {
+            Map<String, Object> v = o.value();
+            if (v != null && val.equals(v.get(key)) && !o.disabled()) return o;
+        }
+        return null;
+    }
+
+    /**
+     * Replace the message text so the next press (whose interaction carries the stored message) sees the up-to-date
+     * summary: the "Done" handlers post the message text as the record of what was paid / produced.
+     */
+    static void syncContent(Decision d, String content) {
+        if (d == null || content == null || content.isBlank() || JdaService.jda == null) return;
+        try {
+            MessageChannel ch = JdaService.jda.getChannelById(MessageChannel.class, d.source().channelId());
+            if (ch == null) return;
+            String text = content.length() > 2000 ? content.substring(0, 1990) + "…" : content;
+            ch.editMessageById(d.source().messageId(), text).complete();
+        } catch (Exception e) {
+            BotLogger.warning("engine: could not refresh payment/production summary: " + e.getMessage());
+        }
+    }
+}
