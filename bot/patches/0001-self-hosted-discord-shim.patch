+package ti4.selfhost.engine.kinds;
+
+import static ti4.selfhost.engine.kinds.ChooseSupport.rule;
+
+import java.util.List;
+import java.util.Map;
+import ti4.game.Game;
+
+/**
+ * Generic "choose a card" step: value {source, cardType, relic|card|trait|position, ...}. cardType: "relic",
+ * "explore_deck" (a whole exploration deck by trait), "action_card", "card". Add rules here.
+ */
+public class ChooseCardKind extends ChooseKindBase {
+
+    public static final List<ChooseSupport.Rule> RULES = List.of(
+            // Relic draw with advantage (look at the top N, take one): position in the relic deck.
+            rule(
+                    "relic_draw_advantage",
+                    "drawRelicAtPosition_(?<position>\\d+)",
+                    Map.of("cardType", "relic"),
+                    (v, ctx) -> {
+                        Game g = ctx.game();
+                        Object pos = v.get("position");
+                        java.util.List<String> deck = g == null ? null : g.getAllRelics();
+                        if (deck != null && pos instanceof Integer i && i >= 0 && i < deck.size()) {
+                            v.putAll(ExploreSupport.relic(deck.get(i)));
+                        }
+                    }),
+            // Relic swap (hero): first relic, then the one to swap it with ("faction;relic").
+            rule("relic_swap", "relicSwapStep1_(?<faction>[^;]*);(?<relic>.+)", Map.of("cardType", "relic", "step", 1)),
+            rule(
+                    "relic_swap",
+                    "relicSwapStep2;(?<faction>[^;]*);(?<relic>[^;]+);(?<faction2>[^;]*);(?<relic2>.+)",
+                    Map.of("cardType", "relic", "step", 2)),
+            // Steal a relic from a player (hero).
+            rule("steal_relic", "stealRelic_(?<faction>[^_]+)_(?<relic>.+)", Map.of("cardType", "relic")),
+            // Look at / discard the top card of an exploration deck (Exploration Probe, Scepter of Dominion, ...).
+            rule("explore_look_top", "resolveExp_Look_(?<trait>[a-z]+)", Map.of("cardType", "explore_deck")),
+            rule("explore_discard_top", "discardExploreTop_(?<trait>[a-z]+)", Map.of("cardType", "explore_deck")),
+            // The Codex (relic): take one of the action cards from the discard pile.
+            rule("codex", "codexCardPick_(?<position>\\d+)", Map.of("cardType", "action_card")),
+            // Quantum Entangler: which drawn relic the target gets / the owner keeps (index into the drawn relics).
+            rule(
