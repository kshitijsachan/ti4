@@ -0,0 +1,71 @@
+package ti4.spring.api.selfhost;
+
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.TimeUnit;
+import net.dv8tion.jda.api.components.buttons.Button;
+import net.dv8tion.jda.api.entities.Message;
+import net.dv8tion.jda.api.entities.MessageHistory;
+import net.dv8tion.jda.api.entities.channel.concrete.TextChannel;
+import org.springframework.stereotype.Component;
+import ti4.discord.JdaService;
+import ti4.game.Game;
+
+/**
+ * Finds which message in the game's main channel currently carries each draft button, so the web client can
+ * "press" it through the shim. Reads the latest 200 messages through JDA (i.e. the shim's REST API) and caches
+ * the result briefly per channel + game version.
+ */
+@Component
+public class DraftButtonLocator {
+
+    /** Interactions that move buttons usually save the game (new version); the TTL covers the ones that do not. */
+    private static final long TTL_MS = 4000;
+    private static final int PAGES = 2;
+
+    private record Entry(long at, long version, Map<String, String> buttons) {}
+
+    private final Map<String, Entry> cache = new ConcurrentHashMap<>();
+
+    /** custom_id -> message id (newest message wins). */
+    public Map<String, String> locate(Game game) {
+        TextChannel channel;
+        try {
+            channel = game.getMainGameChannel();
+        } catch (Exception e) {
+            return Map.of();
+        }
+        if (channel == null) return Map.of();
+        String key = channel.getId();
+        long now = System.currentTimeMillis();
+        Entry hit = cache.get(key);
+        if (hit != null && hit.version == game.getLastModifiedDate() && now - hit.at < TTL_MS) return hit.buttons;
+
+        Map<String, String> found = new HashMap<>();
+        try {
+            MessageHistory mh = channel.getHistory();
+            List<Message> history = new java.util.ArrayList<>();
+            for (int page = 0; page < PAGES; page++) {
+                List<Message> got = mh.retrievePast(100).timeout(5, TimeUnit.SECONDS).complete();
+                history.addAll(got);
+                if (got.size() < 100) break;
+            }
+            // History is newest first; keep the first (newest) message seen for each button.
+            String botId = JdaService.getBotId();
+            for (Message m : history) {
+                if (botId != null && !botId.equals(m.getAuthor().getId())) continue;
+                for (Button b : m.getComponentTree().findAll(Button.class)) {
+                    if (b.getCustomId() == null || b.isDisabled()) continue;
+                    found.putIfAbsent(b.getCustomId(), m.getId());
+                }
+            }
+        } catch (Exception e) {
+            if (hit != null) return hit.buttons;
+            return Map.of();
+        }
+        cache.put(key, new Entry(now, game.getLastModifiedDate(), found));
+        return found;
+    }
+}
diff --git a/src/main/java/ti4/spring/api/selfhost/DraftViewController.java b/src/main/java/ti4/spring/api/selfhost/DraftViewController.java
new file mode 100644
index 0000000..f2f3ab6
--- /dev/null
+++ b/src/main/java/ti4/spring/api/selfhost/DraftViewController.java
@@ -0,0 +1,84 @@
+package ti4.spring.api.selfhost;
+
+import java.awt.Graphics2D;
+import java.awt.RenderingHints;
+import java.awt.image.BufferedImage;
+import java.io.ByteArrayOutputStream;
+import java.util.Map;
+import java.util.concurrent.ConcurrentHashMap;
+import javax.imageio.ImageIO;
+import lombok.RequiredArgsConstructor;
+import org.springframework.http.CacheControl;
+import org.springframework.http.MediaType;
+import org.springframework.http.ResponseEntity;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.RequestParam;
+import org.springframework.web.bind.annotation.RestController;
+import ti4.game.Game;
+import ti4.image.ImageHelper;
+import ti4.image.TileHelper;
+import ti4.model.TileModel;
+import ti4.spring.api.selfhost.DraftViewModels.DraftView;
+import ti4.spring.context.RequestContext;
+
+/**
+ * Read-only endpoints for the self-hosted web draft UI.
+ * <ul>
+ *   <li>{@code GET /api/public/game/{gameName}/draft} — full draft state, including the button custom_id (and the
+ *       message carrying it) for every pick.</li>
+ *   <li>{@code GET /api/public/selfhost/tile/{tileId}?w=} — a system tile image from the bot's resources, scaled
+ *       to {@code w} px wide (default 240), so the UI doesn't depend on an external CDN.</li>
+ * </ul>
+ */
+@RestController
+@RequiredArgsConstructor
+public class DraftViewController {
+
+    private final DraftViewService draftViewService;
+    private final Map<String, byte[]> tileCache = new ConcurrentHashMap<>();
+
+    @GetMapping(value = "/api/public/game/{gameName}/draft", produces = MediaType.APPLICATION_JSON_VALUE)
+    public ResponseEntity<DraftView> draft(@PathVariable String gameName) {
+        Game game = RequestContext.getGame();
+        if (game == null || game.isFowMode()) return ResponseEntity.notFound().build();
+        return ResponseEntity.ok().cacheControl(CacheControl.noStore()).body(draftViewService.build(game));
+    }
+
+    @GetMapping(value = "/api/public/selfhost/tile/{tileId}", produces = MediaType.IMAGE_PNG_VALUE)
+    public ResponseEntity<byte[]> tile(@PathVariable String tileId, @RequestParam(defaultValue = "240") int w) {
+        int width = Math.clamp(w, 32, 345);
+        String id = tileId.replaceAll("\\.png$", "");
+        TileModel model = TileHelper.getTileById(id);
+        if (model == null) return ResponseEntity.notFound().build();
+        byte[] bytes = tileCache.computeIfAbsent(id + "@" + width, _ -> render(model, width));
+        if (bytes == null || bytes.length == 0) {
+            tileCache.remove(id + "@" + width);
+            return ResponseEntity.notFound().build();
+        }
+        return ResponseEntity.ok()
+                .cacheControl(CacheControl.maxAge(java.time.Duration.ofDays(7)).cachePublic())
+                .contentType(MediaType.IMAGE_PNG)
+                .body(bytes);
+    }
+
+    private static byte[] render(TileModel model, int width) {
+        try {
+            BufferedImage src = ImageHelper.read(model.getTilePath());
+            if (src == null) return new byte[0];
+            int height = Math.round(src.getHeight() * (width / (float) src.getWidth()));
+            BufferedImage out = new BufferedImage(width, height, BufferedImage.TYPE_INT_ARGB);
+            Graphics2D g = out.createGraphics();
+            g.setRenderingHint(RenderingHints.KEY_INTERPOLATION, RenderingHints.VALUE_INTERPOLATION_BICUBIC);
+            g.setRenderingHint(RenderingHints.KEY_RENDERING, RenderingHints.VALUE_RENDER_QUALITY);
+            g.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
+            g.drawImage(src, 0, 0, width, height, null);
+            g.dispose();
+            ByteArrayOutputStream bos = new ByteArrayOutputStream();
+            ImageIO.write(out, "png", bos);
+            return bos.toByteArray();
+        } catch (Exception e) {
+            return new byte[0];
+        }
+    }
+}
