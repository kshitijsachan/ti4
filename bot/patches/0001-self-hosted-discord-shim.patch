+            leader("jolnarhero", "target", false, "jnHeroSwapOut_(?<tech>[^_]+)"),
+            leader("jolnarhero", "target", false, "swapTechs__(?<techOut>[^_]+)__(?<tech>.+)"),
+            leader("jolnaragent", "target", true, "jolNarAgentRemoval_(?<tile>[^_]+)_(?<holder>.+)"));
+
+    @Override
+    protected List<Rule> rules() {
