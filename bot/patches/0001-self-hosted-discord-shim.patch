@@ -0,0 +1,71 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+import ti4.game.Player;
+import ti4.selfhost.engine.EngineModels.Target;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * Resolve the agenda once votes (and shenanigans) are in (AgendaHelper.resolveTime / autoResolve /
+ * resolveWithNoEffect): agendaResolution_&lt;outcome&gt; ("Resolve with Current Winner", or one per outcome when
+ * resolving manually), tiedPlanets_agendaResolution_&lt;owner&gt; (manual planet pick: first the owner),
+ * autoresolve_manual ("Resolve it Manually"), resolveWithNoEffect. Posted to the table with no owner: the engine
+ * targets the speaker, who moves the agenda phase along (anyone may still press it the legacy way).
+ */
+public class AgendaResolveKind implements KindSpec {
+
+    @Override
+    public String kind() {
+        return "agenda.resolve";
+    }
+
+    @Override
+    public int priority() {
+        return 100;
+    }
+
+    @Override
+    public boolean matches(String h) {
+        return h.startsWith("agendaResolution_")
+                || h.startsWith("tiedPlanets_agendaResolution_")
+                || h.equals("autoresolve_manual")
+                || h.equals("resolveWithNoEffect");
+    }
+
+    @Override
+    public Map<String, Object> value(String h, CaptureContext ctx) {
+        Map<String, Object> v = new LinkedHashMap<>();
+        if (h.startsWith("agendaResolution_")) {
+            String outcome = h.substring("agendaResolution_".length());
+            v.put("action", "resolve");
+            v.put("outcome", outcome);
+            v.put("name", AgendaSupport.outcomeName(ctx.game(), outcome));
+        } else if (h.startsWith("tiedPlanets_agendaResolution_")) {
+            String who = h.substring("tiedPlanets_agendaResolution_".length());
+            Player p = ctx.game().getPlayerFromColorOrFaction(who);
+            v.put("action", "planet_owner");
+            v.put("planetOwner", p == null ? who : p.getFaction());
+            v.put("userId", p == null ? null : p.getUserID());
+        } else if (h.equals("autoresolve_manual")) {
+            v.put("action", "manual");
+        } else if (h.equals("resolveWithNoEffect")) {
+            v.put("action", "no_effect");
+        } else {
+            return null;
+        }
+        return v;
+    }
+
+    @Override
+    public Target target(CaptureContext ctx, Target resolved) {
+        if (resolved != null && resolved.userId() != null && "owner_prefix".equals(resolved.resolvedBy())) return resolved;
+        Target s = AgendaSupport.speakerTarget(ctx.game(), "speaker");
+        return s == null ? resolved : s;
+    }
+
+    @Override
+    public String scope(CaptureContext ctx) {
+        return ctx.target() == null || ctx.target().userId() == null ? "table" : "player";
+    }
+}
