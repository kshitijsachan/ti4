@@ -0,0 +1,68 @@
+package ti4.spring.api.selfhost;
+
+import java.util.Map;
+import lombok.RequiredArgsConstructor;
+import org.springframework.http.CacheControl;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.security.access.prepost.PreAuthorize;
+import org.springframework.web.bind.annotation.ExceptionHandler;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.spring.api.selfhost.TradeModels.PendingResponse;
+import ti4.spring.api.selfhost.TradeModels.ProposeRequest;
+import ti4.spring.api.selfhost.TradeModels.ProposeResponse;
+import ti4.spring.api.selfhost.TradeModels.TradeOptions;
+import ti4.spring.context.RequestContext;
+import ti4.spring.context.SetupRequestContext;
+
+/**
+ * Per-player trade endpoints for the self-hosted web trade panel. Auth: {@code Authorization: Bearer <seat token>}
+ * (the shim forwards it; non-GET is allowed under /api/game/**).
+ * <ul>
+ *   <li>{@code GET  /api/game/{gameName}/trade/options} — what I can offer, who I can trade with, what they have</li>
+ *   <li>{@code POST /api/game/{gameName}/trade/propose} — build the bot transaction and send the offer</li>
+ *   <li>{@code GET  /api/game/{gameName}/trade/pending} — open offers to / from me, with the bot's buttons</li>
+ * </ul>
+ */
+@RestController
+@RequiredArgsConstructor
+@RequestMapping("/api/game/{gameName}/trade")
+public class TradeController {
+
+    private final TradeService tradeService;
+
+    @GetMapping("/options")
+    @PreAuthorize("@security.canAccessGame(#gameName)")
+    public ResponseEntity<TradeOptions> options(@PathVariable String gameName) {
+        Game game = RequestContext.getGame();
+        Player me = RequestContext.getPlayer();
+        return ResponseEntity.ok().cacheControl(CacheControl.noStore()).body(tradeService.options(game, me));
+    }
+
+    @PostMapping("/propose")
+    @SetupRequestContext
+    @PreAuthorize("@security.canAccessGame(#gameName)")
+    public ProposeResponse propose(@PathVariable String gameName, @RequestBody ProposeRequest request) {
+        return tradeService.propose(RequestContext.getGame(), RequestContext.getPlayer(), request);
+    }
+
+    @GetMapping("/pending")
+    @PreAuthorize("@security.canAccessGame(#gameName)")
+    public ResponseEntity<PendingResponse> pending(@PathVariable String gameName) {
+        Game game = RequestContext.getGame();
+        Player me = RequestContext.getPlayer();
+        return ResponseEntity.ok().cacheControl(CacheControl.noStore()).body(tradeService.pending(game, me));
+    }
+
+    @ExceptionHandler(TradeService.TradeException.class)
+    public ResponseEntity<Map<String, String>> tradeError(TradeService.TradeException e) {
+        return ResponseEntity.status(HttpStatus.BAD_REQUEST).body(Map.of("error", e.getMessage()));
+    }
+}
diff --git a/src/main/java/ti4/spring/api/selfhost/TradeModels.java b/src/main/java/ti4/spring/api/selfhost/TradeModels.java
new file mode 100644
index 0000000..e09cc47
--- /dev/null
+++ b/src/main/java/ti4/spring/api/selfhost/TradeModels.java
@@ -0,0 +1,143 @@
+package ti4.spring.api.selfhost;
+
+import java.util.List;
+import java.util.Map;
+
+/**
+ * JSON shapes for the self-hosted web trade panel ({@code /api/game/{gameName}/trade/**}). A trade is the bot's own
+ * "transaction": the offerer's transaction items plus the offer message with Accept / Reject buttons that
+ * {@code TransactionHelper.sendOffer} posts to the receiver. Acceptance and execution stay 100% bot logic.
+ */
+public final class TradeModels {
+    private TradeModels() {}
+
+    /**
+     * @param blockedReason non-null when the calling player can't propose any trade right now (old transaction
+     *                      model, Hidden Agenda in the agenda phase, ...)
+     */
+    public record TradeOptions(
+            String game,
+            String phase,
+            int round,
+            boolean newTransactionModel,
+            String blockedReason,
+            long version,
+            TradeSelf me,
+            List<TradeCounterparty> counterparties) {}
+
+    /** Everything the calling player could put into an offer. */
+    public record TradeSelf(
+            String userId,
+            String userName,
+            String faction,
+            String color,
+            int tg,
+            int commodities,
+            int commoditiesTotal,
+            boolean canSendCommodities,
+            List<CardRef> promissoryNotes,
+            List<CardRef> actionCards,
+            Map<String, Integer> fragments,
+            List<CardRef> relics,
+            String icon) {}
+
+    /**
+     * Another player, with whether we may trade with them (the bot's own {@code canTheseTwoTransact} check) and their
+     * publicly known stuff that can be requested.
+     *
+     * @param requestablePromissoryNotes their own PNs not in anyone's play area (the bot's "request" list; whether
+     *                                   they still hold one is private)
+     * @param debtIHold     their debt tokens in my debt pool (what I can clear for them)
+     * @param debtTheyHold  my debt tokens in their pool (what they can clear for me)
+     * @param excludedGivePromissoryNotes my PNs I can't give them (Alliance to a Hubris player)
+     */
+    public record TradeCounterparty(
+            String userId,
+            String userName,
+            String faction,
+            String color,
+            boolean canTrade,
+            boolean neighbor,
+            String reason,
+            int tg,
+            int commodities,
+            int commoditiesTotal,
+            boolean canSendCommodities,
+            int pnCount,
+            int acCount,
+            Map<String, Integer> fragments,
+            List<CardRef> requestablePromissoryNotes,
+            List<CardRef> relics,
+            boolean canTradeActionCards,
+            int debtIHold,
+            int debtTheyHold,
+            List<String> excludedGivePromissoryNotes,
+            String icon) {}
+
+    // icon / otherIcon: the faction's emoji image as served by the shim ("/emojis/<id>"), or null.
+
+    /** A card-like thing: PN (owner set), action card, relic. */
+    public record CardRef(String id, String name, String text, String ownerFaction, String ownerColor) {}
+
+    /** Request body for {@code POST /trade/propose}. */
+    public record ProposeRequest(String to, TradeSide give, TradeSide receive, String note) {}
+
+    /**
+     * One side of an offer.
+     *
+     * @param promissoryNotes PN ids; on the receive side {@code "any"} asks for a PN of their choice
+     * @param actionCards     action card ids (give side only)
+     * @param actionCardCount number of unspecified action cards (receive side only; the giver picks)
+     * @param fragments       trait ({@code cultural|industrial|hazardous|frontier}) -> count
+     * @param sendDebt        debt tokens the giver sends into the other's debt pool
+     * @param clearDebt       the other's debt tokens the giver clears from their own pool
+     */
+    public record TradeSide(
+            Integer tg,
+            Integer commodities,
+            List<String> promissoryNotes,
+            List<String> actionCards,
+            Integer actionCardCount,
+            Map<String, Integer> fragments,
+            List<String> relics,
+            Integer sendDebt,
+            Integer clearDebt) {}
+
+    public record ProposeResponse(
+            boolean ok, int offerNumber, String to, List<TradeItem> items, String offerText, List<String> warnings) {}
+
+    /**
+     * One line of an offer, decoded from a bot transaction item {@code sending<f>_receiving<f>_<thing>_<detail>}.
+     *
+     * @param kind tg | commodities | pn | pnAny | ac | acAny | fragment | relic | sendDebt | clearDebt | note | other
+     */
+    public record TradeItem(String from, String to, String kind, int amount, String id, String label, String raw) {}
+
+    /**
+     * An open offer. {@code direction} is "incoming" (to me; {@code accept}/{@code reject}/{@code counter} are the
+     * bot's buttons) or "outgoing" (from me; {@code rescind}). Press a button through the shim's /app/ws
+     * {@code click} op with the given channel / message / custom id.
+     *
+     * @param current false when a newer offer replaced it (the bot will refuse to accept it)
+     */
+    public record PendingOffer(
+            String direction,
+            String otherFaction,
+            String otherUserId,
+            String otherUserName,
+            String otherColor,
+            int offerNumber,
+            boolean current,
+            String text,
+            List<TradeItem> items,
+            ButtonRef accept,
+            ButtonRef reject,
+            ButtonRef counter,
+            ButtonRef rescind,
+            String createdAt,
+            String otherIcon) {}
+
+    public record ButtonRef(String channelId, String messageId, String customId, String label) {}
+
+    public record PendingResponse(List<PendingOffer> incoming, List<PendingOffer> outgoing) {}
+}
