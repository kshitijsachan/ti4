--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/TradeOfferSentKind.java
@@ -0,0 +1,66 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.selfhost.engine.EngineModels.Target;
+import ti4.selfhost.engine.KindSpec;
+import ti4.selfhost.engine.TradeEngine;
+
+/**
+ * The sender's copy of an offer they made (TransactionHelper.sendOffer, sender's cards-info thread):
+ * {@code rescindOffer_<receiverColor>[_BMD_<color>]}. The bot leaves this message up after the offer was accepted or
+ * rejected, so whether the offer is still open is {@code GameState.trade.outgoing}, not this decision.
+ */
+public class TradeOfferSentKind implements KindSpec {
+
+    @Override
+    public String kind() {
+        return "trade.offer_sent";
+    }
+
+    @Override
+    public int priority() {
+        return 100;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return handlerId.startsWith("rescindOffer_");
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        if (!matches(handlerId)) return null;
+        String[] parts = handlerId.split("_");
+        if (parts.length < 2) return null;
+        Game game = ctx.game();
+        Player to = game.getPlayerFromColorOrFaction(parts[1]);
+        Player from = ctx.player() != null ? ctx.player() : TradeOfferKind.cardsThreadOwner(game, ctx.channelId());
+        if (to == null) return null;
+        Map<String, Object> v = new LinkedHashMap<>();
+        v.put("action", "rescind");
+        v.put("to", to.getFaction());
+        v.put("toUserId", to.getUserID());
+        List<Object> items = new ArrayList<>();
+        if (from != null) items.addAll(TradeEngine.items(game, from, to));
+        v.put("items", items);
+        return v;
+    }
+
+    @Override
+    public Target target(CaptureContext ctx, Target resolved) {
+        if (resolved != null && resolved.userId() != null) return resolved;
+        Player owner = TradeOfferKind.cardsThreadOwner(ctx.game(), ctx.channelId());
+        if (owner == null) return resolved;
+        return new Target(owner.getUserID(), owner.getFaction(), owner.getColor(), "cards_thread");
+    }
+
+    @Override
+    public String scope(CaptureContext ctx) {
+        return "player";
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/TurnActionKind.java b/src/main/java/ti4/selfhost/engine/kinds/TurnActionKind.java
new file mode 100644
index 0000000..1bf913e
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/TurnActionKind.java
@@ -0,0 +1,101 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.selfhost.engine.EngineModels.Decision;
+import ti4.selfhost.engine.EngineModels.Option;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * The action-phase turn menu (StartTurnService.getStartOfTurnButtons, also after an action: "end turn or do another
+ * action"), the pass-with-abilities menu and the end-of-turn-abilities menu. Typed options:
+ * tacticalAction, componentAction, strategicAction_&lt;sc&gt;, passForRound, passingAbilities, endOfTurnAbilities,
+ * turnEnd. Faction abilities on the same menu stay untyped (value null). Priority 110 so the menu stays this kind
+ * even when another area types one of its buttons (e.g. strategicAction_).
+ */
+public class TurnActionKind implements KindSpec {
+    private static final Pattern ID = Pattern.compile(
+            "^(tacticalAction|componentAction|strategicAction_(\\d+)|passForRound|passingAbilities|endOfTurnAbilities|turnEnd)$");
+
+    @Override
+    public String kind() {
+        return "turn.action";
+    }
+
+    @Override
+    public int priority() {
+        return 110;
+    }
+
+    /**
+     * Starting an action (tactical / component / strategic) or passing settles the turn prompt; its message stays up
+     * in the original. End-of-turn ids are left alone (they are on their own messages, which the original deletes).
+     */
+    @Override
+    public boolean closesOnAnswer(String handler) {
+        return handler != null && handler.matches("tacticalAction|componentAction|strategicAction_\\d+|passForRound|passingAbilities");
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return ID.matcher(handlerId).matches();
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        Matcher m = ID.matcher(handlerId);
+        if (!m.matches()) return null;
+        Map<String, Object> v = new LinkedHashMap<>();
+        Player p = ctx.player();
+        switch (m.group(1)) {
+            case "tacticalAction" -> {
+                v.put("action", "tactical");
+                v.put("tacticTokens", p == null ? null : p.getTacticalCC());
+            }
+            case "componentAction" -> v.put("action", "component");
+            case "passForRound" -> {
+                v.put("action", "pass");
+                v.put("abilities", false);
+            }
+            case "passingAbilities" -> {
+                v.put("action", "pass");
+                v.put("abilities", true);
+            }
+            case "endOfTurnAbilities" -> {
+                v.put("action", "end_turn");
+                v.put("abilities", true);
+            }
+            case "turnEnd" -> {
+                v.put("action", "end_turn");
+                v.put("abilities", false);
+            }
+            default -> {
+                v.put("action", "strategic");
+                v.put("strategyCard", Integer.parseInt(m.group(2)));
+            }
+        }
+        return v;
+    }
+
+    @Override
+    public String validate(Game game, Player answering, Decision decision, String optionId) {
+        for (Option o : decision.options()) {
+            if (!o.id().equals(optionId) || o.value() == null) continue;
+            Object action = o.value().get("action");
+            if ("end_turn".equals(action)) return null;
+            if ("pass".equals(action)
+                    && ti4.service.turn.PassService.passIsOutsideActionPhase(
+                            game))
+                return "The action phase is over; there is nothing to pass.";
+            Player active = game.getActivePlayer();
+            if (active != null && !active.getUserID().equals(answering.getUserID()) && !game.isNaaluAgent()) return "It is not your turn.";
+            if ("tactical".equals(action) && answering.getTacticalCC() < 1)
+                return "You have no command tokens in your tactic pool.";
+        }
+        return null;
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/UiAffordanceKind.java b/src/main/java/ti4/selfhost/engine/kinds/UiAffordanceKind.java
new file mode 100644
index 0000000..f93469a
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/UiAffordanceKind.java
@@ -0,0 +1,119 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import javax.annotation.Nullable;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * Undo affordances: a message whose only purpose is to take back something the player just did, posted next to (or
+ * after) the action and left on screen for the rest of the round. Nobody is asked anything, so this is NOT a pending
+ * decision: consumers never list it as "waiting on me" (TS {@code isAffordance} / {@code awaits} false), bots never
+ * press it, but a player who clicks it is answered like any other option.
+ *
+ * <ul>
+ *   <li>{@code drawSpecificSO_<so>} "you discarded … if this was an accident: Retrieve" (DiscardSecretService) — {@code
+ *       undoes: so_discard, ref: <so id>}</li>
+ *   <li>{@code removePreset_<messageId|edynAgentPreset>} "use this button to undo the preset" (agenda / action card
+ *       preassignment) — {@code preset}</li>
+ *   <li>{@code retrieveAgenda_<agenda>} "Put … on top/bottom of the agenda deck … Reassign" — {@code agenda_put}</li>
+ *   <li>{@code eraseMyVote} "erase my vote &amp; have me vote again" — {@code vote}; {@code eraseMyRiders} — {@code
+ *       rider}</li>
+ *   <li>{@code reversepreScoreObbie_<PO_n|SO_n>} "unqueue it" — {@code pre_score}</li>
+ *   <li>{@code ultimateUndo_<n>} (the generic UNDO companion) — {@code last_action}</li>
+ * </ul>
+ *
+ * The message is claimed only when EVERY option is an affordance or a dismiss ({@code deleteButtons…}): a real
+ * question with an undo button beside it stays with its own kind (or legacy). value: {@code {action: "undo",
+ * undoes, ref}}; dismiss options are null.
+ */
+public class UiAffordanceKind implements KindSpec {
+
+    public static final String KIND = "ui.undo_affordance";
+
+    @Override
+    public String kind() {
+        return KIND;
+    }
+
+    /** Below every real kind: only messages made of affordances alone (see classifies). */
+    @Override
+    public int priority() {
+        return 6;
+    }
+
+    @Override
+    public boolean matches(String h) {
+        return undoes(h) != null;
+    }
+
+    @Override
+    public boolean typesOption(String h) {
+        return matches(h);
+    }
+
+    @Override
+    public boolean classifies(List<String> handlerIds) {
+        boolean any = false;
+        for (String h : handlerIds) {
+            if (h == null) return false;
+            if (isDismiss(h)) continue;
+            if (undoes(h) == null) return false;
+            any = true;
+        }
+        return any;
+    }
+
+    @Override
+    @Nullable
+    public Map<String, Object> value(String h, CaptureContext ctx) {
+        String u = undoes(h);
+        return u == null ? null : v("undo", u, ref(h));
+    }
+
+    // ------------------------------------------------------------------ shared with UiOptionalKind / InfoMenuSplit
+
+    /** What an undo affordance takes back, null when the handler is not one. */
+    @Nullable
+    static String undoes(String h) {
+        if (h.startsWith("drawSpecificSO_")) return "so_discard";
+        if (h.startsWith("removePreset_")) return "preset";
+        if (h.startsWith("retrieveAgenda_")) return "agenda_put";
+        if (h.equals("eraseMyVote")) return "vote";
+        if (h.equals("eraseMyRiders")) return "rider";
+        if (h.startsWith("reversepreScoreObbie_")) return "pre_score";
+        if (h.startsWith("ultimateUndo_")) return "last_action";
+        return null;
+    }
+
+    /** "Delete these buttons" / "Done" / "Decline": closes the message, nothing else. */
+    static boolean isDismiss(String h) {
+        return h.startsWith("deleteButtons") || h.equals("deleteThisMessage") || h.equals("doNothing");
+    }
+
+    /** Everything after the handler's first '_' (the id the handler parses), null when there is none. */
+    @Nullable
+    static String ref(String h) {
+        int us = h.indexOf('_');
+        if (us < 0 || us == h.length() - 1) return null;
+        String r = h.substring(us + 1);
+        return r.endsWith("~MDL") ? r.substring(0, r.length() - 4) : r;
+    }
+
+    static boolean readOnly(String h) {
+        try {
+            return ti4.discord.interactions.buttons.ButtonProcessor.isReadOnly(h);
+        } catch (Throwable t) {
+            return false;
+        }
+    }
+
+    static Map<String, Object> v(String action, @Nullable String undoes, @Nullable String ref) {
+        Map<String, Object> m = new LinkedHashMap<>();
+        m.put("action", action);
+        m.put("undoes", undoes);
+        m.put("ref", ref);
+        return m;
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/UiOptionalKind.java b/src/main/java/ti4/selfhost/engine/kinds/UiOptionalKind.java
new file mode 100644
index 0000000..ce9ab4f
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/UiOptionalKind.java
@@ -0,0 +1,153 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+import javax.annotation.Nullable;
+import ti4.selfhost.engine.DecisionRegistry;
+import ti4.selfhost.engine.EngineModels.Decision;
+import ti4.selfhost.engine.EngineModels.Option;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * Optional affordances that sit on screen for a long time without asking anything: a player MAY use them, nobody
+ * waits for them. Like {@link UiAffordanceKind} this is not a pending decision (TS {@code isAffordance}: never
+ * "waiting on me", never awaited, bots ignore it), yet every option stays answerable when a player clicks it.
+ *
+ * <ul>
+ *   <li>{@code editRoundSummary_<round>~MDL} / {@code editEndOfRoundSummaries} "you may write down your end of round
+ *       thoughts" (opens a form) — {@code round_summary}</li>
+ *   <li>{@code preScoreObbie_<PO_n|SO_n>} "queue an objective to score" (decide-in-advance) — {@code pre_score}</li>
+ *   <li>{@code temporaryPingDisable} (AutoPingCron) — {@code disable_pings}</li>
+ *   <li>the agenda help menu "these buttons can help with bugs/issues": {@code proceedToVoting} (skip waiting),
+ *       {@code refreshAgenda}, {@code pingNonresponders}, plus its read-only / undo companions ({@code transaction},
+ *       {@code eraseMyVote}, {@code eraseMyRiders}, {@code ultimateUndo_})</li>
+ *   <li>a message whose only control is a dismiss ({@code deleteButtons…}) — nothing to decide</li>
+ * </ul>
+ *
+ * value: {@code {action, undoes, ref}} (undoes set on the undo companions, see UiAffordanceKind); dismiss and
+ * read-only options are null.
+ */
+public class UiOptionalKind implements KindSpec {
+
+    public static final String KIND = "ui.optional";
+
+    @Override
+    public String kind() {
+        return KIND;
+    }
+
+    /** Below every real kind; above nothing that could claim these messages (see classifies). */
+    @Override
+    public int priority() {
+        return 5;
+    }
+
+    @Override
+    public boolean matches(String h) {
+        return action(h) != null;
+    }
+
+    @Override
+    public boolean typesOption(String h) {
+        return action(h) != null || UiAffordanceKind.undoes(h) != null;
+    }
+
+    /**
+     * Every option is optional, an undo affordance, a dismiss or read-only (info), and at least one is optional — or
+     * the message is only dismiss buttons.
+     */
+    @Override
+    public boolean classifies(List<String> handlerIds) {
+        boolean optional = false, other = false;
+        for (String h : handlerIds) {
+            if (h == null) return false;
+            if (action(h) != null) {
+                optional = true;
+                continue;
+            }
+            if (UiAffordanceKind.isDismiss(h)) continue;
+            other = true;
+            if (UiAffordanceKind.undoes(h) != null || UiAffordanceKind.readOnly(h)) continue;
+            return false;
+        }
+        return optional || (!other && !handlerIds.isEmpty());
+    }
+
+    @Override
+    @Nullable
+    public Map<String, Object> value(String h, CaptureContext ctx) {
+        String a = action(h);
+        if (a != null) return UiAffordanceKind.v(a, null, UiAffordanceKind.ref(h));
+        String u = UiAffordanceKind.undoes(h);
+        return u == null ? null : UiAffordanceKind.v("undo", u, UiAffordanceKind.ref(h));
+    }
+
+    /**
+     * One "Create round N summary" offer per player per round: the engine re-sends it (live pbd105: 19 copies of round
+     * 1's for one player, 103 in the game), so a newer copy obsoletes the older ones. At capture of the newest copy the
+     * older ones close at once ("superseded"); the state-change sweep closes any it finds later (e.g. after a rebuild).
+     */
+    @Override
+    public boolean obsolete(CaptureContext ctx) {
+        if (ctx.game() == null || ctx.messageId() == null) return false;
+        String round = summaryRound(handlersOf(ctx));
+        String user = ctx.target() == null ? null : ctx.target().userId();
+        if (round == null || user == null) return false;
+        List<Decision> older = new ArrayList<>();
+        for (Decision d : DecisionRegistry.openDecisions(ctx.game().getName())) {
+            if (!KIND.equals(d.kind()) || d.source() == null || ctx.messageId().equals(d.source().messageId())) continue;
+            if (d.target() == null || !user.equals(d.target().userId())) continue;
+            if (!round.equals(summaryRound(d.options().stream().map(Option::handler).toList()))) continue;
+            if (newer(d.source().messageId(), ctx.messageId())) return true; // a newer copy is open: this one goes
+            older.add(d);
+        }
+        for (Decision d : older) DecisionRegistry.close(d.id(), "superseded");
+        return false;
+    }
+
+    @Nullable
+    private static List<String> handlersOf(CaptureContext ctx) {
+        if (ctx.handlerIds() != null) return ctx.handlerIds();
+        String id = DecisionRegistry.decisionIdForMessage(ctx.messageId());
+        Decision d = id == null ? null : DecisionRegistry.get(id);
+        return d == null ? null : d.options().stream().map(Option::handler).toList();
+    }
+
+    /** "1" for a message whose only offer is "Create round 1 summary" (editRoundSummary_1~MDL); null otherwise. */
+    @Nullable
+    static String summaryRound(@Nullable List<String> handlers) {
+        if (handlers == null) return null;
+        String round = null;
+        for (String h : handlers) {
+            if (h == null) return null;
+            if (h.startsWith("editRoundSummary_")) {
+                String r = h.substring("editRoundSummary_".length()).replace("~MDL", "");
+                if (round != null && !round.equals(r)) return null;
+                round = r;
+            } else if (!UiAffordanceKind.isDismiss(h)) return null;
+        }
+        return round;
+    }
+
+    /** Discord snowflakes grow with time: is message a newer than b? */
+    private static boolean newer(String a, String b) {
+        try {
+            return Long.parseUnsignedLong(a) > Long.parseUnsignedLong(b);
+        } catch (NumberFormatException e) {
+            return !Objects.equals(a, b) && a.compareTo(b) > 0;
+        }
+    }
+
+    @Nullable
+    static String action(String h) {
+        if (h.startsWith("editRoundSummary_") || h.equals("editEndOfRoundSummaries")) return "round_summary";
+        if (h.startsWith("preScoreObbie_")) return "pre_score";
+        if (h.equals("temporaryPingDisable")) return "disable_pings";
+        if (h.equals("proceedToVoting")) return "skip_waiting";
+        if (h.equals("refreshAgenda")) return "refresh_agenda";
+        if (h.equals("pingNonresponders")) return "ping_nonresponders";
+        return null;
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/UnitsModifyKind.java b/src/main/java/ti4/selfhost/engine/kinds/UnitsModifyKind.java
new file mode 100644
index 0000000..8a56d90
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/UnitsModifyKind.java
@@ -0,0 +1,102 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.List;
+import java.util.Map;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.game.Tile;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * The "Modify Units" menu (getModifyTiles on the turn-start / cards-info menus, Anti-Intellectual Revolution): a
+ * manual board edit, never a rules question.
+ *
+ * <ol>
+ *   <li>system list: genericModify_&lt;pos&gt; (systems with your units) + "Show All Tiles" (modifyUnitsAllTiles), or
+ *       genericModifyAllTiles_&lt;pos&gt; (every system; goes straight to the place menu);
+ *   <li>build or remove in that system: genericBuild_&lt;pos&gt; (opens the place menu: production.produce, context
+ *       "genericBuild") / getDamageButtons_&lt;pos&gt;_remove (opens the per-unit menu: combat.assign_units);
+ *   <li>"Delete these buttons" (deleteButtons) on every step.
+ * </ol>
+ *
+ * value: {action: "tile", tile, allTiles, units} | {action: "all_tiles"} | {action: "build" | "remove", tile, units}
+ * | {action: "done"} (units: the owner's unit count in that system when the prompt was captured). Not claimed by
+ * units.remove (its classifies() steps aside when genericBuild_ / genericModify* is on the message).
+ */
+public class UnitsModifyKind implements KindSpec {
+    private static final Pattern TILE = Pattern.compile("^genericModify(AllTiles)?_([A-Za-z0-9]+)$");
+    private static final Pattern BUILD = Pattern.compile("^genericBuild_([A-Za-z0-9]+)$");
+    private static final Pattern REMOVE = Pattern.compile("^getDamageButtons_([A-Za-z0-9]+)_remove$");
+
+    @Override
+    public String kind() {
+        return "units.modify";
+    }
+
+    @Override
+    public int priority() {
+        return 60;
+    }
+
+    static boolean claims(String h) {
+        return h.equals("modifyUnitsAllTiles") || TILE.matcher(h).matches() || BUILD.matcher(h).matches();
+    }
+
+    @Override
+    public boolean classifies(List<String> handlerIds) {
+        for (String h : handlerIds) if (h != null && claims(h)) return true;
+        return false;
+    }
+
+    @Override
+    public boolean matches(String h) {
+        return claims(h) || REMOVE.matcher(h).matches() || h.equals("deleteButtons");
+    }
+
+    @Override
+    public Map<String, Object> value(String h, CaptureContext ctx) {
+        if (h.equals("deleteButtons")) return SetupKindSupport.map("action", "done", "tile", null);
+        if (h.equals("modifyUnitsAllTiles")) return SetupKindSupport.map("action", "all_tiles", "tile", null);
+        Matcher m;
+        if ((m = TILE.matcher(h)).matches()) {
+            Map<String, Object> v = SetupKindSupport.map("action", "tile", "tile", m.group(2));
+            v.put("allTiles", m.group(1) != null);
+            v.put("units", units(ctx, m.group(2)));
+            return v;
+        }
+        if ((m = BUILD.matcher(h)).matches()) {
+            Map<String, Object> v = SetupKindSupport.map("action", "build", "tile", m.group(1));
+            v.put("units", units(ctx, m.group(1)));
+            return v;
+        }
+        if ((m = REMOVE.matcher(h)).matches()) {
+            Map<String, Object> v = SetupKindSupport.map("action", "remove", "tile", m.group(1));
+            v.put("units", units(ctx, m.group(1)));
+            return v;
+        }
+        return null;
+    }
+
+    /** The menu owner's units in that system (all holders), 0 when unknown. */
+    private static int units(CaptureContext ctx, String pos) {
+        Game game = ctx.game();
+        Player p = ctx.player();
+        if (game == null || p == null || p.getColor() == null) return 0;
+        Tile t = game.getTileByPosition(pos);
+        if (t == null) return 0;
+        int n = 0;
+        try {
+            for (var uh : t.getUnitHolders().values()) n += uh.getUnitCount(p.getColorID());
+        } catch (RuntimeException e) {
+            return 0;
+        }
+        return n;
+    }
+
+    @Override
+    public String scope(CaptureContext ctx) {
+        return "player";
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/UnitsRemoveKind.java b/src/main/java/ti4/selfhost/engine/kinds/UnitsRemoveKind.java
new file mode 100644
index 0000000..50aa159
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/UnitsRemoveKind.java
@@ -0,0 +1,104 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.List;
+import java.util.Map;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * A stand-alone "assign hits / remove units" opener: a message whose only control is getDamageButtons_&lt;pos&gt;_&lt;type&gt;
+ * (+ "Done" = deleteButtons). Posted for fleet-pool / capacity violations and after a gravity rift ("remove"),
+ * for bombardment / anti-fighter barrage / space cannon hits taken outside the combat controls ("bombardment",
+ * "afb", "pds", "spacecombat", "groundcombat"). Pressing it opens the per-unit menu (combat.assign_units). The
+ * combat controls and the hit prompts (combat.round / combat.hits) keep their own messages; the modify-units menu
+ * (genericBuild_ / genericModify_) is not claimed.
+ *
+ * <p>value: {action: "open", tile, assignType} | {action: "done", tile: null, assignType: null}.
+ */
+public class UnitsRemoveKind implements KindSpec {
+    private static final Pattern OPEN = Pattern.compile("^getDamageButtons_([^_]+?)(?:deleteThis)?(?:_(\\w+))?$");
+
+    @Override
+    public String kind() {
+        return "units.remove";
+    }
+
+    @Override
+    public int priority() {
+        return 45;
+    }
+
+    @Override
+    public boolean classifies(List<String> handlerIds) {
+        boolean opener = false;
+        for (String h : handlerIds) {
+            if (h == null) continue;
+            if (h.startsWith("genericBuild_") || h.startsWith("genericModify")) return false;
+            if (h.startsWith("getDamageButtons_")) opener = true;
+        }
+        return opener;
+    }
+
+    @Override
+    public boolean matches(String h) {
+        return h.startsWith("getDamageButtons_") || h.equals("deleteButtons");
+    }
+
+    /**
+     * Hits taken before a fight (bombardment before ground combat, anti-fighter barrage before space combat) are past
+     * once that fight has rolled a round in the opener's system: the opener can no longer be answered meaningfully
+     * (live pbd60: a bombardment opener from a ground combat fought 6 rounds was re-pressed by a bot every minute,
+     * each press opening an empty hit menu). Round hits ("combat") and fleet-pool removals stay.
+     */
+    @Override
+    public boolean obsolete(CaptureContext ctx) {
+        if (ctx.game() == null) return false;
+        List<String> ids = ctx.handlerIds();
+        if (ids == null && ctx.messageId() != null) {
+            String id = ti4.selfhost.engine.DecisionRegistry.decisionIdForMessage(ctx.messageId());
+            ti4.selfhost.engine.EngineModels.Decision d = id == null ? null : ti4.selfhost.engine.DecisionRegistry.get(id);
+            if (d != null) ids = d.options().stream()
+                    .map(o -> ti4.discord.interactions.routing.ComponentIdEnvelope.decode(o.id().split("#")[0]).handlerId())
+                    .toList();
+        }
+        if (ids == null) return false;
+        boolean any = false;
+        for (String h : ids) {
+            if (h == null || !h.startsWith("getDamageButtons_")) continue;
+            Matcher m = OPEN.matcher(h);
+            if (!m.matches()) continue;
+            String type = m.group(2);
+            if (!"bombardment".equals(type) && !"afb".equals(type)) return false;
+            if (!fightRolled(ctx.game(), m.group(1), "afb".equals(type))) return false;
+            any = true;
+        }
+        return any;
+    }
+
+    /** Whether a combat round was rolled in `pos`: in space, or (ground) on any planet of the system. */
+    static boolean fightRolled(ti4.game.Game game, String pos, boolean space) {
+        ti4.game.Tile tile = game.getTileByPosition(pos);
+        if (tile == null) return false;
+        for (String holder : tile.getUnitHolders().keySet()) {
+            if (space != "space".equals(holder)) continue;
+            for (ti4.game.Player p : game.getRealPlayersNNeutral())
+                if (CombatSupport.roundsRolled(game, p, pos, holder) > 0) return true;
+        }
+        return false;
+    }
+
+    @Override
+    public boolean dynamic() {
+        return true;
+    }
+
+    @Override
+    public Map<String, Object> value(String h, CaptureContext ctx) {
+        if (h.equals("deleteButtons")) return SetupKindSupport.map("action", "done", "tile", null, "assignType", null);
+        Matcher m = OPEN.matcher(h);
+        if (!m.matches()) return null;
+        return SetupKindSupport.map(
+                "action", "open", "tile", m.group(1), "assignType", m.group(2) == null ? "combat" : m.group(2));
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/WhenAfterWindowKind.java b/src/main/java/ti4/selfhost/engine/kinds/WhenAfterWindowKind.java
new file mode 100644
index 0000000..da8f6f1
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/WhenAfterWindowKind.java
@@ -0,0 +1,124 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+import java.util.Set;
+import java.util.concurrent.ConcurrentHashMap;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.message.GameMessage;
+import ti4.message.GameMessageManager;
+import ti4.selfhost.engine.EngineModels.ReactionWindow;
+import ti4.selfhost.engine.EngineModels.Target;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * The non-queued agenda "when" / "after" windows in the actions channel (AgendaWhensAftersHelper.getWhenButtons /
+ * getAfterButtons, posted with persistent reacts): play_when, no_when, no_when_persistent; play_after_&lt;rider&gt;,
+ * no_after, no_after_persistent (plus owner-prefixed ability buttons such as quash / Galactic Threat, which stay
+ * untyped). The queued mode (cards-info thread) is agenda.when / agenda.after.
+ *
+ * <p>Option value: {timing: "when"|"after", action: "play"|"pass"|"pass_agenda", rider?}. pass = "for now",
+ * pass_agenda = for the rest of this agenda (persistent). Window (kind "when" / "after"): eligible = every real
+ * player; responded = the factions the engine recorded as reacted on this message (GameMessageManager) plus those who
+ * passed for the whole agenda (Game.playersWhoHitPersistentNoWhen/After). Once the engine forgot a registered
+ * message the window is over.
+ */
+public class WhenAfterWindowKind implements KindSpec {
+    private static final Set<String> registered = ConcurrentHashMap.newKeySet();
+    private static final Map<String, String> timingOfMessage = new ConcurrentHashMap<>();
+
+    @Override
+    public String kind() {
+        return "action_card.when_after";
+    }
+
+    @Override
+    public int priority() {
+        return 100;
+    }
+
+    @Override
+    public boolean dynamic() {
+        return true;
+    }
+
+    @Override
+    public boolean recordsResponses() {
+        return true;
+    }
+
+    @Override
+    public boolean matches(String h) {
+        return h.equals("play_when")
+                || h.equals("no_when")
+                || h.equals("no_when_persistent")
+                || h.equals("no_after")
+                || h.equals("no_after_persistent")
+                || h.startsWith("play_after_");
+    }
+
+    @Override
+    public Map<String, Object> value(String h, CaptureContext ctx) {
+        Map<String, Object> v = new LinkedHashMap<>();
+        String timing = h.contains("when") ? "when" : "after";
+        v.put("timing", timing);
+        if (h.startsWith("play_")) {
+            v.put("action", "play");
+            if (h.startsWith("play_after_")) v.put("rider", h.substring("play_after_".length()));
+        } else {
+            v.put("action", h.endsWith("_persistent") ? "pass_agenda" : "pass");
+        }
+        timingOfMessage.putIfAbsent(ctx.messageId(), timing);
+        return v;
+    }
+
+    @Override
+    public Target target(CaptureContext ctx, Target resolved) {
+        return new Target(null, null, null, "none");
+    }
+
+    @Override
+    public String scope(CaptureContext ctx) {
+        return "table";
+    }
+
+    @Override
+    public ReactionWindow window(CaptureContext ctx) {
+        Game game = ctx.game();
+        String messageId = ctx.messageId();
+        String timing = timingOfMessage.get(messageId);
+        if (timing == null && ctx.handlerIds() != null)
+            timing = ctx.handlerIds().stream().anyMatch(h -> h != null && h.contains("no_when")) ? "when" : "after";
+        if (timing == null) timing = "after";
+        Optional<GameMessage> gm = GameMessageManager.getOne(game.getName(), messageId);
+        boolean over = false;
+        if (gm.isPresent()) registered.add(messageId);
+        else if (registered.contains(messageId)) over = true;
+        Set<String> reacted = new LinkedHashSet<>();
+        if (gm.isPresent() && gm.get().factionsThatReacted() != null) reacted.addAll(gm.get().factionsThatReacted());
+        String persistent = "when".equals(timing)
+                ? game.getPlayersWhoHitPersistentNoWhen()
+                : game.getPlayersWhoHitPersistentNoAfter();
+        List<String> eligible = new ArrayList<>();
+        List<String> responded = new ArrayList<>();
+        Map<String, String> responses = new LinkedHashMap<>();
+        for (Player p : game.getRealPlayers()) {
+            eligible.add(p.getUserID());
+            boolean pers = persistent != null && persistent.contains(p.getFaction());
+            if (over || reacted.contains(p.getFaction()) || pers) {
+                responded.add(p.getUserID());
+                responses.put(
+                        p.getUserID(),
+                        reacted.contains(p.getFaction()) ? "reacted" : pers ? "passed_for_agenda" : "closed");
+            }
+        }
+        Map<String, Object> subject = new LinkedHashMap<>();
+        subject.put("timing", timing);
+        return new ReactionWindow(timing, subject, eligible, responded, responses);
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/tactical/TacticalFacts.java b/src/main/java/ti4/selfhost/engine/tactical/TacticalFacts.java
new file mode 100644
index 0000000..5e4bea4
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/tactical/TacticalFacts.java
@@ -0,0 +1,200 @@
+package ti4.selfhost.engine.tactical;
+
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+import ti4.discord.interactions.buttons.handlers.unit.monuments.MonumentsDSButtonHandler;
+import ti4.game.Game;
+import ti4.game.Planet;
+import ti4.game.Player;
+import ti4.game.Tile;
+import ti4.game.UnitHolder;
+import ti4.helpers.ButtonHelper;
+import ti4.helpers.CheckDistanceHelper;
+import ti4.helpers.CommandCounterHelper;
+import ti4.helpers.Constants;
+import ti4.helpers.Units.UnitKey;
+import ti4.helpers.Units.UnitState;
+import ti4.helpers.Units.UnitType;
+import ti4.image.Mapper;
+import ti4.model.UnitModel;
+
+/**
+ * Facts about the active player's tactical action, read straight from {@link Game} for the tactical decision kinds
+ * and the direct move / land actions. Everything is ids and numbers (positions, planet ids, async unit ids, colours).
+ */
+public final class TacticalFacts {
+    private TacticalFacts() {}
+
+    /** Ships, fighters and ground forces of this player in space, and ground forces on planets (what can move). */
+    public static List<Map<String, Object>> movableUnits(Game game, Player player, Tile tile) {
+        List<Map<String, Object>> out = new ArrayList<>();
+        Tile nebulaCheck = tile;
+        boolean nebula = false;
+        try {
+            nebula = nebulaCheck.isNebula(game);
+        } catch (Exception ignored) {
+            // homebrew tiles without a model
+        }
+        for (UnitHolder uh : tile.getUnitHolders().values()) {
+            boolean space = !(uh instanceof Planet);
+            for (Map.Entry<UnitKey, List<Integer>> e :
+                    uh.getUnitsByStateForPlayer(player).entrySet()) {
+                UnitKey key = e.getKey();
+                UnitModel model = player.getUnitFromUnitKey(key);
+                if (model == null) continue;
+                UnitType type = key.unitType();
+                boolean ground = type == UnitType.Infantry || type == UnitType.Mech;
+                if (model.getIsStructure() && type != UnitType.Fighter && !ground) continue;
+                if (!space && !ground) continue;
+                List<Integer> s = e.getValue();
+                int count = sum(s);
+                if (count < 1) continue;
+                int damaged = at(s, UnitState.dmg) + at(s, UnitState.dmg_glv);
+                int move = model.getMoveValue();
+                if (nebula && move > 0) move = 1;
+                Map<String, Object> u = new LinkedHashMap<>();
+                u.put("holder", space ? "space" : uh.getName());
+                u.put("unit", key.asyncID());
+                u.put("color", player.getColor());
+                u.put("count", count);
+                u.put("damaged", damaged);
+                u.put("move", move);
+                u.put("capacity", model.getCapacityValue());
+                u.put("ship", model.getIsShip());
+                out.add(u);
+            }
+        }
+        return out;
+    }
+
+    /** Whether units may leave this system now (no own command token there, or an ability lets them). */
+    public static boolean canLeave(Game game, Player player, Tile tile) {
+        return tile.getPosition().equalsIgnoreCase(game.getActiveSystem())
+                || !CommandCounterHelper.hasCC(null, player.getColor(), tile)
+                || ButtonHelper.canMoveOutOfLockedSystems(player, game)
+                || MonumentsDSButtonHandler.canMoveOutOfFreeholdSystem(game, player, tile);
+    }
+
+    /** Every system the player's units could move from into the active system, with distances (rift-aware). */
+    public static List<Map<String, Object>> origins(Game game, Player player) {
+        List<Map<String, Object>> out = new ArrayList<>();
+        String active = game.getActiveSystem();
+        if (active == null || active.isBlank()) return out;
+        for (Tile tile : new ArrayList<>(game.getTileMap().values())) {
+            if (tile.getPosition().equalsIgnoreCase(active)) continue;
+            if (!tile.containsPlayersUnits(player) || !canLeave(game, player, tile)) continue;
+            List<Map<String, Object>> units = movableUnits(game, player, tile);
+            if (units.isEmpty()) continue;
+            Map<String, Object> o = new LinkedHashMap<>();
+            o.put("position", tile.getPosition());
+            o.put("tileId", tile.getTileID());
+            int distance = safeDistance(game, player, tile.getPosition(), active, true);
+            int rift = safeDistance(game, player, tile.getPosition(), active, false);
+            o.put("distance", distance);
+            o.put("riftDistance", rift);
+            o.put("units", units);
+            out.add(o);
+        }
+        out.sort((a, b) -> Integer.compare((int) a.get("distance"), (int) b.get("distance")));
+        return out;
+    }
+
+    private static int safeDistance(Game game, Player player, String from, String to, boolean riftsNormal) {
+        try {
+            return CheckDistanceHelper.getDistanceBetweenTwoTiles(game, player, from, to, riftsNormal);
+        } catch (Exception e) {
+            return 100;
+        }
+    }
+
+    /** What is staged to move into the active system: [{from, holder, unit, color, count, damaged}]. */
+    public static List<Map<String, Object>> staged(Game game) {
+        List<Map<String, Object>> out = new ArrayList<>();
+        for (Map.Entry<String, Map<UnitKey, List<Integer>>> e :
+                game.getTacticalActionDisplacement().entrySet()) {
+            String k = e.getKey();
+            int dash = k == null ? -1 : k.indexOf('-');
+            if (dash <= 0 || e.getValue() == null) continue;
+            for (Map.Entry<UnitKey, List<Integer>> u : e.getValue().entrySet()) {
+                int count = sum(u.getValue());
+                if (count < 1) continue;
+                Map<String, Object> m = new LinkedHashMap<>();
+                m.put("from", k.substring(0, dash));
+                m.put("holder", k.substring(dash + 1));
+                m.put("unit", u.getKey().asyncID());
+                m.put("color", u.getKey().getColor());
+                m.put("count", count);
+                m.put("damaged", at(u.getValue(), UnitState.dmg) + at(u.getValue(), UnitState.dmg_glv));
+                out.add(m);
+            }
+        }
+        return out;
+    }
+
+    /**
+     * Movement bonuses the player may apply this tactical action (the engine does not enforce move values; these
+     * tell planners and the UI what is legal): [{source, amount, appliesTo: "one_ship" | "all_ships"}].
+     */
+    public static List<Map<String, Object>> bonuses(Game game, Player player) {
+        List<Map<String, Object>> out = new ArrayList<>();
+        if (player.hasTech("gd")) out.add(bonus("gravity_drive", 1, "one_ship"));
+        if (player.hasTech("baldrick_gd") || !game.getStoredValue("baldrickGDboost").isEmpty())
+            out.add(bonus("baldrick_gravity_drive", 1, "all_ships"));
+        if (!game.getStoredValue("flankspeedBoost").isEmpty())
+            out.add(bonus("flank_speed", game.isWildWildGalaxyMode() ? 2 : 1, "all_ships"));
+        if (!game.getStoredValue("crucibleBoost").isEmpty()) out.add(bonus("crucible", 1, "all_ships"));
+        if (player.getTechs().contains("dsgledb")) out.add(bonus("lightning_drives", 1, "ships_not_transporting"));
+        return out;
+    }
+
+    private static Map<String, Object> bonus(String source, int amount, String appliesTo) {
+        Map<String, Object> m = new LinkedHashMap<>();
+        m.put("source", source);
+        m.put("amount", amount);
+        m.put("appliesTo", appliesTo);
+        return m;
+    }
+
+    /** Concluding the action in this system explores its frontier token (Dark Energy Tap and friends). */
+    public static boolean frontierExplore(Game game, Player player, Tile tile) {
+        if (tile == null || player == null) return false;
+        if (!(player.hasTech("det") || game.isCptiExploreMode() || player.hasTech("antimatter"))) return false;
+        UnitHolder space = tile.getSpaceUnitHolder();
+        return space != null && space.getTokenList().contains(Mapper.getTokenID(Constants.FRONTIER));
+    }
+
+    /** Planets of the system with their controller and units (for landing). */
+    public static List<Map<String, Object>> planets(Game game, Tile tile) {
+        List<Map<String, Object>> out = new ArrayList<>();
+        if (tile == null) return out;
+        for (Planet p : tile.getPlanetUnitHolders()) {
+            Map<String, Object> m = new LinkedHashMap<>();
+            m.put("planet", p.getName());
+            Player owner = null;
+            for (Player pl : game.getRealPlayers()) if (pl.getPlanets().contains(p.getName())) owner = pl;
+            m.put("controller", owner == null ? null : owner.getFaction());
+            out.add(m);
+        }
+        return out;
+    }
+
+    /** Progress.flow of one tactical action: "tactical:&lt;uid&gt;:r&lt;round&gt;:&lt;active system&gt;". */
+    public static String flow(Game game, Player player) {
+        return "tactical:" + (player == null ? "?" : player.getUserID()) + ":r" + game.getRound() + ":"
+                + game.getActiveSystem();
+    }
+
+    static int sum(List<Integer> s) {
+        int n = 0;
+        if (s != null) for (Integer i : s) n += Objects.requireNonNullElse(i, 0);
+        return n;
+    }
+
+    static int at(List<Integer> s, UnitState state) {
+        if (s == null || s.size() <= state.ordinal()) return 0;
+        return Objects.requireNonNullElse(s.get(state.ordinal()), 0);
+    }
+}
