+package ti4.selfhost.engine.kinds;
+
+import java.util.List;
+
+/**
+ * Sardakk N'orr. Commander G'hom Sek'kus (land 1 infantry / mech from an adjacent planet you control)
+ * sardakkcommander_&lt;infantry|mech&gt;_&lt;planet&gt;_&lt;fromPlanet&gt;; hero Sh'val, Harbinger purgeSardakkHero (after
+ * activating a system). Agent T'ro: leader.use exhaustAgent_sardakkagent_&lt;tile&gt;_&lt;planet&gt; (FactionStepsAgentPlanets).
+ * Unrelenting, Valkyrie Particle Weave, Exotrireme, Tekklar Legion, mech, flagship: passive or other areas' prompts.
+ * sardakkbtRes (breakthrough) is the Thunder's Edge area's.
+ */
+public class FactionStepsSardakk extends FactionStepsRegex {
+    private static final List<Rule> RULES = List.of(
+            leader("sardakkcommander", "use", true,
+                    "sardakkcommander_(?<unit>infantry|mech)_(?<planet>[^_]+)_(?<from>[^_]+)"),
+            leader("sardakkhero", "use", true, "purgeSardakkHero"));
+
+    @Override
+    protected List<Rule> rules() {
+        return RULES;
+    }
+}
