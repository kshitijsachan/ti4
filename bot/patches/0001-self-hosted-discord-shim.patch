diff --git a/src/main/java/ti4/helpers/ActionCardTiming.java b/src/main/java/ti4/helpers/ActionCardTiming.java
new file mode 100644
index 0000000..3394a7d
--- /dev/null
+++ b/src/main/java/ti4/helpers/ActionCardTiming.java
@@ -0,0 +1,298 @@
+package ti4.helpers;
+
+import java.util.HashMap;
+import java.util.Map;
+import java.util.Set;
+import ti4.game.Game;
+import ti4.game.Planet;
+import ti4.game.Player;
+import ti4.game.Tile;
+import ti4.helpers.Units.UnitType;
+import ti4.image.Mapper;
+import ti4.model.ActionCardModel;
+import ti4.model.Source.ComponentSource;
+
+/**
+ * Selfhost (deliberate improvement over the original bot): whether an official action card's timing window (and its
+ * hard preconditions, such as a cost the player cannot pay) is open right now. The original bot only refused an
+ * "Action:" card from a player who is not the active player, so every other card could be played at any moment (a
+ * rider during the action phase, Crash Landing with no active system, Summit in the agenda phase...).
+ *
+ * <p>Conservative: only the four official decks (base, Prophecy of Kings, Codex, Thunder's Edge) are judged, and a
+ * window is "closed" only when the public game state proves it: the phase, the active player, the active system and
+ * who has units in it. Anything the state cannot see (did the player win the combat, was a ship just destroyed) stays
+ * open and is left to the players, as before. Twilight's Fall games, and Wild, Wild Galaxy's altered four-of-a-kind
+ * cards, keep the original behaviour. Played through the hand tray (ac_play_from_hand_) and the engine; the
+ * {@code /ac play} command and the bot's own automatic plays (pre-assigned Summit, Coup, Crisis...) are not gated.
+ */
+public final class ActionCardTiming {
+
+    private ActionCardTiming() {}
+
+    /** Per-game off switch: stored value {@code acTimingGate=off}. */
+    public static final String GAME_SWITCH = "acTimingGate";
+
+    /**
+     * On by default on the self-hosted (web) server; off with env {@code TI4_AC_TIMING=off} (whole server, instant
+     * rollback) or per game with the stored value {@code acTimingGate=off}. Off = the original behaviour.
+     */
+    public static boolean enabled(Game game) {
+        if (game == null) return false;
+        String env = System.getenv("TI4_AC_TIMING");
+        if ("off".equalsIgnoreCase(env) || "false".equalsIgnoreCase(env)) return false;
+        if ("off".equalsIgnoreCase(game.getStoredValue(GAME_SWITCH))) return false;
+        return ti4.selfhost.SelfHosted.isEnabled() || "on".equalsIgnoreCase(env);
+    }
+
+    private enum Window {
+        /** "Action": a component action on your own turn. */
+        ACTION,
+        /** "After you activate a system" family: your tactical action, a system activated. */
+        OWN_ACTIVATION,
+        /** Master Plan: "After you perform an action". */
+        OWN_TURN,
+        /** "After another player activates / moves into / commits to land ...": someone else's tactical action. */
+        OTHER_ACTIVATION,
+        /** Combat / invasion / space cannon windows the player takes part in (has units in the active system). */
+        IN_ACTIVE_SYSTEM,
+        /** Combat-ish windows where the player may have no units left there (Direct Hit, Courageous, Scramble). */
+        TACTICAL,
+        /** Anything during the action phase (planet control changes, production, end of a turn). */
+        ACTION_PHASE,
+        AGENDA,
+        STRATEGY,
+        STATUS,
+        /** Puppets on a String: at the end of a turn, if you have passed. */
+        PASSED,
+        /** Coup d'Etat, Extreme Duress: during another player's turn. */
+        OTHER_TURN,
+        /**
+         * Reparations: after another player gains control of a planet you control. Planets change hands on someone
+         * else's turn in the action phase (their invasion, their action card), never on your own (playtest 8: it showed
+         * Play enabled on the player's own turn).
+         */
+        TAKEN_FROM_YOU,
+        /**
+         * Sabotage: when another player plays an action card. Played from that card's "Sabotage?" window
+         * (action_card.sabotage), so from the hand only while such a window is open.
+         */
+        SABOTAGE
+    }
+
+    private static final Set<ComponentSource> OFFICIAL =
+            Set.of(ComponentSource.base, ComponentSource.pok, ComponentSource.codex1, ComponentSource.thunders_edge);
+
+    private static final Map<String, Window> WINDOWS = new HashMap<>();
+
+    private static void put(Window w, String... aliases) {
+        for (String a : aliases) WINDOWS.put(a, w);
+    }
+
+    static {
+        put(Window.OWN_ACTIVATION, "fs1", "fs2", "fs3", "fs4", "lost_star", "silence_space", "nav_suite", "solar_flare");
+        put(Window.OWN_ACTIVATION, "upgrade", "harness", "rally");
+        put(Window.OWN_TURN, "master_plan");
+        put(Window.OTHER_ACTIVATION, "counterstroke", "fsb", "decoy", "rescue", "experimental", "parley", "ghost_squad");
+        put(Window.IN_ACTIVE_SYSTEM, "mb1", "mb2", "mb3", "mb4", "sh1", "sh2", "sh3", "sh4", "emergency", "f_prototype");
+        put(Window.IN_ACTIVE_SYSTEM, "s_retreat1", "s_retreat2", "s_retreat3", "s_retreat4", "intercept", "fire_team");
+        put(Window.IN_ACTIVE_SYSTEM, "mjets1", "mjets2", "mjets3", "mjets4", "waylay", "reveal_prototype", "rout");
+        put(Window.IN_ACTIVE_SYSTEM, "salvage", "reflective", "blitz", "disable", "bunker", "crashlanding");
+        put(Window.TACTICAL, "dh1", "dh2", "dh3", "dh4", "courageous", "scramble");
+        put(Window.ACTION_PHASE, "infiltrate", "crisis");
+        put(Window.TAKEN_FROM_YOU, "reparations");
+        put(Window.SABOTAGE, "sabo1", "sabo2", "sabo3", "sabo4");
+        put(Window.ACTION_PHASE, "war_machine1", "war_machine2", "war_machine3", "war_machine4", "war_machinell");
+        put(Window.AGENDA, "abs", "assassin", "bribery", "confusing", "confounding", "distinguished", "deadly_plot");
+        put(Window.AGENDA, "const_rider", "diplo_rider", "imp_rider", "lead_rider", "politic_rider", "tech_rider");
+        put(Window.AGENDA, "trade_rider", "war_rider", "sanction", "veto", "veto3", "veto4", "hack", "insider");
+        put(Window.AGENDA, "dp1", "dp2", "dp3", "dp4");
+        put(Window.STRATEGY, "summit", "investments", "disgrace");
+        put(Window.STATUS, "stability");
+        put(Window.PASSED, "puppetsonastring");
+        put(Window.OTHER_TURN, "coup", "extremeduress");
+        // Reverse Engineer, Lie in Wait and Black Market Dealings answer events the state does not track.
+    }
+
+    /**
+     * Why {@code player} cannot play {@code acId} right now, or null when they may (or the card is not judged). The
+     * reason is a full sentence for the player.
+     */
+    public static String closedReason(Game game, Player player, String acId) {
+        if (game == null || player == null || acId == null || !enabled(game)) return null;
+        ActionCardModel card = Mapper.getActionCard(acId);
+        if (card == null || !OFFICIAL.contains(card.getSource())) return null;
+        if (game.isTwilightsFallMode()) return null;
+        if (game.isWildWildGalaxyMode() && card.isAffectedByWildWildGalaxy()) return null;
+        Window w = "action".equalsIgnoreCase(card.getWindow()) ? Window.ACTION : WINDOWS.get(card.getAlias());
+        if (w == null) return null;
+
+        String name = "_" + card.getName() + "_";
+        String phase = game.getPhaseOfGame() == null ? "" : game.getPhaseOfGame().toLowerCase();
+        boolean actionPhase = "action".equals(phase);
+        Player active = game.getActivePlayer();
+        boolean isActive = active != null && active == player;
+        // The system activated in THIS tactical action: getActiveSystem() falls back to the stored lastActiveSystem, so
+        // the previous turn's system kept every "after you activate" / combat window open at turn start (playtest 6,
+        // pbd387: Nav Suite played with no activation). A save written with no active system loads it as "null".
+        String pos = game.getCurrentActiveSystem();
+        Tile tile = pos == null || pos.isBlank() || "null".equalsIgnoreCase(pos) ? null : game.getTileByPosition(pos);
+
+        switch (w) {
+            case ACTION -> {
+                if (!actionPhase || !isActive)
+                    return name + " is a component action: it can only be played on your own turn in the action phase.";
+                String taken = ti4.selfhost.engine.ScFollowGate.actionTaken(game, player);
+                if (taken != null) return name + " is a component action, and " + taken + ".";
+                return costReason(game, player, card);
+            }
+            case OWN_ACTIVATION -> {
+                if (!actionPhase || !isActive || tile == null)
+                    return name + " can only be played during your own tactical action, after you activate a system.";
+                if ("upgrade".equals(card.getAlias())
+                        && tile.getSpaceUnitHolder().getUnitCount(UnitType.Cruiser, player.getColor()) < 1)
+                    return name + " needs 1 of your cruisers in the active system.";
+                if ("harness".equals(card.getAlias()) && !tile.isAnomaly(game, player))
+                    return name + " can only be played after you activate an anomaly.";
+                return null;
+            }
+            case OWN_TURN -> {
+                if (!actionPhase || !isActive) return name + " can only be played on your own turn, after your action.";
+                return null;
+            }
+            case OTHER_ACTIVATION -> {
+                if (!actionPhase || tile == null || isActive)
+                    return name + " can only be played during another player's tactical action.";
+                return otherActivationReason(game, player, card, tile, name);
+            }
+            case IN_ACTIVE_SYSTEM -> {
+                if (!actionPhase || tile == null || !(isActive || FoWHelper.playerHasUnitsInSystem(player, tile)))
+                    return name + " can only be played during a combat or invasion you take part in"
+                            + " (you need units in the active system).";
+                return null;
+            }
+            case TACTICAL -> {
+                if (!actionPhase || tile == null)
+                    return name + " can only be played during a tactical action (there is no active system).";
+                return null;
+            }
+            case ACTION_PHASE -> {
+                return actionPhase ? null : name + " can only be played during the action phase.";
+            }
+            case AGENDA -> {
+                return phase.contains("agenda") ? null : name + " can only be played during the agenda phase.";
+            }
+            case STRATEGY -> {
+                return "strategy".equals(phase) ? null : name + " can only be played during the strategy phase.";
+            }
+            case STATUS -> {
+                return phase.contains("status") ? null : name + " can only be played during the status phase.";
+            }
+            case PASSED -> {
+                if (!actionPhase || !player.isPassed())
+                    return name + " can only be played in the action phase once you have passed.";
+                return null;
+            }
+            case TAKEN_FROM_YOU -> {
+                if (!actionPhase || active == null || isActive)
+                    return name + " can only be played after another player gains control of one of your planets"
+                            + " (on their turn).";
+                return null;
+            }
+            case SABOTAGE -> {
+                if (!sabotageWindowOpen(game, player))
+                    return name + " can only be played when another player plays an action card"
+                            + " (from that card's Sabotage window).";
+                return null;
+            }
+            case OTHER_TURN -> {
+                if (!actionPhase || active == null || isActive)
+                    return name + " can only be played during another player's turn.";
+                if ("extremeduress".equals(card.getAlias()) && !active.hasUnplayedSCs())
+                    return name + " needs the active player to have a readied strategy card.";
+                return null;
+            }
+        }
+        return null;
+    }
+
+    /**
+     * Another player's action card is waiting on its "Sabotage?" window (an open action_card.sabotage decision of this
+     * game that this player has not answered). Unknown (no engine) counts as open.
+     */
+    private static boolean sabotageWindowOpen(Game game, Player player) {
+        try {
+            for (var d : ti4.selfhost.engine.DecisionRegistry.openDecisions(game.getName())) {
+                if (!"action_card.sabotage".equals(d.kind())) continue;
+                var w = d.window();
+                if (w == null) return true;
+                if (w.eligible().contains(player.getUserID()) && !w.responded().contains(player.getUserID()))
+                    return true;
+            }
+            return false;
+        } catch (Exception | LinkageError e) {
+            return true;
+        }
+    }
+
+    /** {@link #closedReason} for the card behind a hand handle (or a Garbozia discard handle); null when unknown. */
+    public static String closedReasonForHandle(Game game, Player player, int handle) {
+        if (game == null || player == null) return null;
+        for (Map.Entry<String, Integer> e : player.getActionCards().entrySet())
+            if (e.getValue() == handle) return closedReason(game, player, e.getKey());
+        if (player.hasPlanet("garbozia"))
+            for (Map.Entry<String, Integer> e : game.getDiscardActionCards().entrySet())
+                if (e.getValue() == handle) return closedReason(game, player, e.getKey());
+        return null;
+    }
+
+    /** Every card in {@code player}'s hand whose window is closed right now: card id to the reason. */
+    public static Map<String, String> closedInHand(Game game, Player player) {
+        Map<String, String> out = new java.util.LinkedHashMap<>();
+        if (game == null || player == null) return out;
+        for (String ac : player.getActionCards().keySet()) {
+            String r = closedReason(game, player, ac);
+            if (r != null) out.put(ac, r);
+        }
+        return out;
+    }
+
+    /** A component card's cost the player plainly cannot pay (the card would be discarded for nothing). */
+    private static String costReason(Game game, Player player, ActionCardModel card) {
+        String name = "_" + card.getName() + "_";
+        switch (card.getAlias()) {
+            case "f_researched" -> {
+                if (player.getTg() < 4 && !player.hasUnexhaustedLeader("keleresagent"))
+                    return name + " costs 4 trade goods; you have " + player.getTg() + ".";
+            }
+            case "mercenarycontract" -> {
+                if (player.getTg() < 2) return name + " costs 2 trade goods; you have " + player.getTg() + ".";
+            }
+            default -> {}
+        }
+        return null;
+    }
+
+    private static String otherActivationReason(Game game, Player player, ActionCardModel card, Tile tile, String name) {
+        switch (card.getAlias()) {
+            case "counterstroke" -> {
+                if (!CommandCounterHelper.hasCC(player, tile))
+                    return name + " needs 1 of your command tokens in the active system.";
+            }
+            case "fsb", "decoy" -> {
+                if (!FoWHelper.playerHasUnitsInSystem(player, tile))
+                    return name + " needs your units in the active system.";
+            }
+            case "rescue" -> {
+                if (!FoWHelper.playerHasShipsInSystem(player, tile))
+                    return name + " needs your ships in the active system.";
+            }
+            case "parley", "ghost_squad" -> {
+                boolean controls = false;
+                for (Planet p : tile.getPlanetUnitHolders()) controls |= player.getPlanets().contains(p.getName());
+                if (!controls) return name + " needs a planet you control in the active system.";
+            }
+            default -> {}
+        }
+        return null;
+    }
+}
