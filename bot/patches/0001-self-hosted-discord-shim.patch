@@ -0,0 +1,54 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * Gravity rift rolls for units that moved through a rift (RiftUnitsHelper.getButtonsForRiftingUnitsInSystem):
+ * riftUnit_&lt;pos&gt;_&lt;n&gt;&lt;unit name&gt;[damaged] → {op:"roll", position, count, unit, damaged};
+ * riftAllUnits_&lt;pos&gt; → {op:"roll_all", position}; doneRifting → {op:"done"}. Unit is the unit's plain name
+ * (carrier, cruiser, …) as the engine writes it. The remove-transported-units button belongs to combat (value null).
+ */
+public class TacticalRiftKind implements KindSpec {
+    private static final Pattern UNIT = Pattern.compile("^riftunit_([^_]+)_(\\d)([a-z]+?)(damaged)?$");
+
+    @Override
+    public String kind() {
+        return "tactical.rift";
+    }
+
+    @Override
+    public int priority() {
+        return 100;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return handlerId.startsWith("riftUnit_") || handlerId.startsWith("riftAllUnits_") || handlerId.equals("doneRifting");
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        Map<String, Object> v = new LinkedHashMap<>();
+        if (handlerId.equals("doneRifting")) {
+            v.put("op", "done");
+            return v;
+        }
+        if (handlerId.startsWith("riftAllUnits_")) {
+            v.put("op", "roll_all");
+            v.put("position", handlerId.substring("riftAllUnits_".length()));
+            return v;
+        }
+        Matcher m = UNIT.matcher(handlerId.toLowerCase());
+        if (!m.matches()) return null;
+        v.put("op", "roll");
+        v.put("position", m.group(1));
+        v.put("count", Integer.parseInt(m.group(2)));
+        v.put("unit", m.group(3));
+        v.put("damaged", m.group(4) != null);
+        return v;
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/TeExpeditionKind.java b/src/main/java/ti4/selfhost/engine/kinds/TeExpeditionKind.java
new file mode 100644
index 0000000..a528017
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/TeExpeditionKind.java
@@ -0,0 +1,78 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.selfhost.engine.EngineModels.Decision;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * Thunder's Edge expeditions (Expeditions.getRemainingExpeditionButtons, opened from "Do an Expedition (N
+ * Remaining)" on the end-of-turn / pass menus): FFCC_&lt;f&gt;_TEexpedition_&lt;key&gt; for each open expedition plus
+ * "Delete These Buttons". Completing one marks it with the faction, unlocks the player's breakthroughs, and the
+ * last one lets its completer place Thunder's Edge.
+ *
+ * <p>Keys and costs: techSkip (exhaust 1 technology specialty planet), tradeGoods (spend 3 trade goods; deducted at
+ * once when the player has 3), fiveRes / fiveInf (spend 5 resources / influence via the payment prompt), secret
+ * (discard 1 unscored secret objective), actionCards (discard 2 action cards). value.affordable is the engine's view
+ * at capture time (ready planets + trade goods, cards in hand).
+ */
+public class TeExpeditionKind implements KindSpec {
+
+    @Override
+    public String kind() {
+        return "te.expedition";
+    }
+
+    @Override
+    public int priority() {
+        return 100;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return handlerId.startsWith("TEexpedition_");
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        if (!matches(handlerId)) return null;
+        String key = handlerId.substring("TEexpedition_".length());
+        Map<String, Object> v = new LinkedHashMap<>();
+        v.put("expedition", key);
+        v.put("affordable", affordable(ctx.game(), ctx.player(), key));
+        v.put("unlocksBreakthrough", ctx.player() != null
+                && ctx.player().getBreakthroughIDs().stream().anyMatch(bt -> !ctx.player().isBreakthroughUnlocked(bt)));
+        v.put("remaining", ctx.game().getExpeditions().getRemainingExpeditionCount());
+        return v;
+    }
+
+    static boolean affordable(Game game, Player p, String key) {
+        if (p == null) return false;
+        return switch (key) {
+            case "techSkip" -> TeKinds.hasReadySkipPlanet(game, p);
+            case "tradeGoods" -> p.getTg() >= 3;
+            case "fiveRes" -> TeKinds.readyPlanetValue(game, p, true) + p.getTg() >= 5;
+            case "fiveInf" -> TeKinds.readyPlanetValue(game, p, false) + p.getTg() >= 5;
+            case "secret" -> p.getSecrets().size() > 0;
+            case "actionCards" -> p.getActionCards().size() >= 2;
+            default -> false;
+        };
+    }
+
+    @Override
+    public String scope(CaptureContext ctx) {
+        return "player";
+    }
+
+    @Override
+    public String validate(Game game, Player answering, Decision decision, String optionId) {
+        String err = TeKinds.ownerLockError(answering, optionId);
+        if (err != null) return err;
+        String key = optionId.replaceFirst("^.*TEexpedition_", "");
+        if (optionId.contains("TEexpedition_") && game.getExpeditions().getExpeditionFactions().get(key) != null)
+            return "That expedition is already completed.";
+        return null;
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/TeFractureIngressKind.java b/src/main/java/ti4/selfhost/engine/kinds/TeFractureIngressKind.java
new file mode 100644
index 0000000..5ab6dce
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/TeFractureIngressKind.java
@@ -0,0 +1,97 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+import java.util.Set;
+import java.util.concurrent.ConcurrentHashMap;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.game.Tile;
+import ti4.helpers.Constants;
+import ti4.selfhost.engine.EngineModels.Decision;
+import ti4.selfhost.engine.EngineModels.Progress;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * Thunder's Edge: The Fracture entered play; place ingress tokens (FractureService.spawnIngressTokens). One message
+ * per technology type: FFCC_&lt;f&gt;_addIngressToken_&lt;pos&gt;_&lt;perType&gt; (+ "Done Resolving" deleteButtons).
+ * Each press places one token and removes that button (the message is edited in place). perType is 1 normally, 3 per
+ * synergy type when brought in by a breakthrough. In fog the GM gets these buttons without an owner prefix.
+ *
+ * <p>progress.accumulated.placed = tokens this prompt has placed so far: the tiles ever offered on this message that
+ * now hold an ingress token (offered tiles never have one when offered).
+ */
+public class TeFractureIngressKind implements KindSpec {
+
+    @Override
+    public String kind() {
+        return "te.fracture.ingress";
+    }
+
+    @Override
+    public int priority() {
+        return 100;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return handlerId.matches("addIngressToken_[^_]+_\\d+");
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        if (!matches(handlerId)) return null;
+        String[] parts = handlerId.split("_");
+        String pos = parts[1];
+        int perType = Integer.parseInt(parts[2]);
+        Game game = ctx.game();
+        Tile tile = game.getTileByPosition(pos);
+        Set<String> offered = TeKinds.remember(ctx.messageId(), "ingressOffered", ConcurrentHashMap.newKeySet());
+        offered.add(pos);
+        TeKinds.remember(ctx.messageId(), "ingressPerType", perType);
+        Map<String, Object> v = new LinkedHashMap<>();
+        v.put("position", pos);
+        v.put("tileId", tile == null ? null : tile.getTileID());
+        v.put("skips", TeKinds.skips(tile));
+        v.put("hasIngress", tile != null && hasIngress(tile));
+        v.put("perType", perType);
+        return v;
+    }
+
+    /** accumulated.placed: tokens placed from this prompt; required.perType: how many this prompt may place. */
+    @Override
+    public Progress progress(CaptureContext ctx) {
+        Set<String> offered = TeKinds.remember(ctx.messageId(), "ingressOffered", ConcurrentHashMap.newKeySet());
+        int perType = TeKinds.remember(ctx.messageId(), "ingressPerType", 1);
+        int placed = 0;
+        for (String p : offered) {
+            Tile t = ctx.game().getTileByPosition(p);
+            if (t != null && hasIngress(t)) placed++;
+        }
+        return new Progress(
+                "fracture.ingress",
+                placed >= perType ? "done" : "place",
+                Map.of("placed", placed),
+                Map.of("perType", perType, "remaining", Math.max(0, perType - placed)),
+                true);
+    }
+
+    @Override
+    public boolean dynamic() {
+        return true;
+    }
+
+    static boolean hasIngress(Tile t) {
+        return t.getSpaceUnitHolder().getTokenList().contains(Constants.TOKEN_INGRESS);
+    }
+
+    @Override
+    public String scope(CaptureContext ctx) {
+        return "player";
+    }
+
+    @Override
+    public String validate(Game game, Player answering, Decision decision, String optionId) {
+        return TeKinds.ownerLockError(answering, optionId);
+    }
+}
