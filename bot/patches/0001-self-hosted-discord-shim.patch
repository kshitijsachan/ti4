+package ti4.spring.api.selfhost;
+
+import java.lang.reflect.Method;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.TimeUnit;
+import net.dv8tion.jda.api.components.buttons.Button;
+import net.dv8tion.jda.api.entities.Message;
+import net.dv8tion.jda.api.entities.MessageHistory;
+import net.dv8tion.jda.api.entities.channel.concrete.ThreadChannel;
+import org.springframework.stereotype.Service;
+import ti4.discord.JdaService;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.helpers.ButtonHelper;
+import ti4.helpers.ButtonHelperExplore;
+import ti4.helpers.Constants;
+import ti4.helpers.TransactionHelper;
+import ti4.image.Mapper;
+import ti4.model.ActionCardModel;
+import ti4.model.PromissoryNoteModel;
+import ti4.model.RelicModel;
+import ti4.service.agenda.IsPlayerElectedService;
+import ti4.spring.api.selfhost.TradeModels.ButtonRef;
+import ti4.spring.api.selfhost.TradeModels.CardRef;
+import ti4.spring.api.selfhost.TradeModels.PendingOffer;
+import ti4.spring.api.selfhost.TradeModels.PendingResponse;
+import ti4.spring.api.selfhost.TradeModels.ProposeRequest;
+import ti4.spring.api.selfhost.TradeModels.ProposeResponse;
+import ti4.spring.api.selfhost.TradeModels.TradeCounterparty;
+import ti4.spring.api.selfhost.TradeModels.TradeItem;
+import ti4.spring.api.selfhost.TradeModels.TradeOptions;
+import ti4.spring.api.selfhost.TradeModels.TradeSelf;
+import ti4.spring.api.selfhost.TradeModels.TradeSide;
+
+/**
+ * Builds the web trade panel's view of the bot's transaction system and proposes offers through it. Proposing
+ * writes the same transaction items the {@code offerToTransact_} buttons write, then calls the bot's own
+ * {@link TransactionHelper#sendOffer} so the receiver gets the usual Accept / Reject / Counter buttons.
+ */
+@Service
+public class TradeService {
+
+    /** Thrown for a request the bot's transaction rules don't allow; mapped to HTTP 400. */
+    public static class TradeException extends RuntimeException {
+        public TradeException(String message) {
+            super(message);
+        }
+    }
+
+    private static final List<String> FRAGMENT_TRAITS =
+            List.of(Constants.CULTURAL, Constants.INDUSTRIAL, Constants.HAZARDOUS, Constants.FRONTIER);
+    private static final int MAX_GENERIC = 7;
+    private static final int MAX_DIGIT = 9;
+    private static final long HISTORY_TTL_MS = 3000;
+
+    private record HistoryEntry(long at, long version, List<Message> messages) {}
+
+    private final Map<String, HistoryEntry> historyCache = new ConcurrentHashMap<>();
+
+    // ---------------------------------------------------------------- options
+
+    public TradeOptions options(Game game, Player me) {
+        List<TradeCounterparty> others = new ArrayList<>();
+        for (Player p : game.getRealPlayers()) {
+            if (p == me || p.getFaction().equalsIgnoreCase(me.getFaction())) continue;
+            if (!Mapper.isValidFaction(p.getFaction())) continue;
+            others.add(counterparty(game, me, p));
+        }
+        return new TradeOptions(
+                game.getName(),
+                game.getPhaseOfGame(),
+                game.getRound(),
+                TransactionHelper.useNewTransactionModel(game),
+                blockedReason(game, me),
+                game.getLastModifiedDate(),
+                self(game, me),
+                others);
+    }
+
+    private static String blockedReason(Game game, Player me) {
+        if (game.isFowMode()) return "Trading from the web panel isn't available in fog of war games.";
+        if (!TransactionHelper.useNewTransactionModel(game))
+            return "This game uses the old transaction method (direct sends), which has no offers.";
+        String phase = game.getPhaseOfGame() == null ? "" : game.getPhaseOfGame().toLowerCase(Locale.ROOT);
+        if (game.isHiddenAgendaMode()
+                && phase.contains("agenda")
+                && game.getStoredValue("executiveOrder").isEmpty())
+            return "Hidden Agenda mode doesn't allow transactions in the agenda phase.";
+        if (me.hasAbility("policy_the_people_control") && !"action".equals(phase))
+            return "Policy - The People: Control prevents you from transacting outside the action phase.";
+        return null;
+    }
