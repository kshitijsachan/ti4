@@ -0,0 +1,50 @@
+package ti4.helpers;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import org.junit.jupiter.api.Test;
+import ti4.game.Game;
+import ti4.game.Player;
+
+class PromptStateTest {
+
+    @Test
+    void valueBelongsToItsPromptOnly() {
+        Game game = new Game();
+        Player player = new Player("u1", "u1", game);
+
+        assertThat(PromptState.get(player, "ccAdjustFrom", "111")).isEmpty();
+
+        PromptState.put(player, "ccAdjustFrom", "111", "3/3/2");
+        assertThat(PromptState.get(player, "ccAdjustFrom", "111")).isEqualTo("3/3/2");
+        // a newer prompt never sees the older prompt's state
+        assertThat(PromptState.get(player, "ccAdjustFrom", "222")).isEmpty();
+
+        PromptState.put(player, "ccAdjustFrom", "222", "1/2/3");
+        assertThat(PromptState.get(player, "ccAdjustFrom", "111")).isEmpty();
+        assertThat(PromptState.get(player, "ccAdjustFrom", "222")).isEqualTo("1/2/3");
+
+        PromptState.clear(player, "ccAdjustFrom");
+        assertThat(PromptState.get(player, "ccAdjustFrom", "222")).isEmpty();
+    }
+
+    @Test
+    void hasTellsAnEmptyValueFromNone() {
+        Game game = new Game();
+        Player player = new Player("u1", "u1", game);
+        assertThat(PromptState.has(player, "paymentCurrency", "5")).isFalse();
+        PromptState.put(player, "paymentCurrency", "5", "");
+        assertThat(PromptState.has(player, "paymentCurrency", "5")).isTrue();
+        assertThat(PromptState.has(player, "paymentCurrency", "6")).isFalse();
+        assertThat(PromptState.has(null, "paymentCurrency", "5")).isFalse();
+    }
+
+    @Test
+    void keptInPlayerStoredValuesSoItIsSavedAndUndone() {
+        Game game = new Game();
+        Player player = new Player("u1", "u1", game);
+        PromptState.put(player, "readiedPlanets", "9", "mr,lodor");
+        assertThat(player.getStoredValueMap()).isNotEmpty();
+        assertThat(PromptState.get(player, "readiedPlanets", "9")).isEqualTo("mr,lodor");
+    }
+}
