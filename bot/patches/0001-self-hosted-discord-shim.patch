@@ -0,0 +1,70 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import ti4.game.Game;
+import ti4.game.Planet;
+import ti4.game.Player;
+import ti4.game.Tile;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * Diplomacy primary, part 1: choose a system that contains a planet you control (diplo_&lt;planet&gt;_diploP; one button
+ * per system, named by one of your planets there; Mecatol Rex is excluded by the engine). Scepter of Dominion variant:
+ * diplo_&lt;tilePos&gt;_mahact&lt;color&gt;. value: {tile, planet, planets:[…your planets there], home, resources, influence,
+ * mahact}. Part 2 (ready up to 2 planets) is the diploRefresh2 button on the card's message → planet.ready.
+ */
+public class DiplomacySystemKind implements KindSpec {
+
+    @Override
+    public String kind() {
+        return "strategy_card.diplomacy_system";
+    }
+
+    @Override
+    public int priority() {
+        return 80;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return handlerId.matches("diplo_[^_]+_(diploP|mahact.*)");
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        String[] parts = handlerId.split("_", 3);
+        Game game = ctx.game();
+        boolean mahact = parts[2].startsWith("mahact");
+        Tile tile = mahact ? game.getTileByPosition(parts[1]) : game.getTileFromPlanet(parts[1]);
+        Map<String, Object> v = new LinkedHashMap<>();
+        v.put("tile", tile == null ? null : tile.getPosition());
+        v.put("planet", mahact ? null : parts[1]);
+        v.put("mahact", mahact);
+        List<String> mine = new ArrayList<>();
+        int res = 0;
+        int inf = 0;
+        Player p = ctx.player();
+        if (tile != null) {
+            for (Planet pl : tile.getPlanetUnitHolders()) {
+                if (p != null && p.getPlanets().contains(pl.getName())) {
+                    mine.add(pl.getName());
+                    res += pl.getResources();
+                    inf += pl.getInfluence();
+                }
+            }
+        }
+        v.put("planets", mine);
+        v.put("resources", res);
+        v.put("influence", inf);
+        v.put("home", tile != null && p != null && tile == p.getHomeSystemTile());
+        return v;
+    }
+
+    @Override
+    public String scope(CaptureContext ctx) {
+        return "player";
+    }
+}
