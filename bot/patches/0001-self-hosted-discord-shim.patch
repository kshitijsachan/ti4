@@ -0,0 +1,232 @@
+package ti4.selfhost.engine.interaction;
+
+import java.lang.reflect.Proxy;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+import net.dv8tion.jda.api.components.actionrow.ActionRow;
+import net.dv8tion.jda.api.components.buttons.Button;
+import net.dv8tion.jda.api.components.label.Label;
+import net.dv8tion.jda.api.components.selections.StringSelectMenu;
+import net.dv8tion.jda.api.components.textinput.TextInput;
+import net.dv8tion.jda.api.components.textinput.TextInputStyle;
+import net.dv8tion.jda.api.components.tree.MessageComponentTree;
+import net.dv8tion.jda.api.entities.Guild;
+import net.dv8tion.jda.api.entities.Member;
+import net.dv8tion.jda.api.entities.Message;
+import net.dv8tion.jda.api.entities.User;
+import net.dv8tion.jda.api.entities.channel.middleman.MessageChannel;
+import net.dv8tion.jda.api.events.interaction.ModalInteractionEvent;
+import net.dv8tion.jda.api.events.interaction.component.ButtonInteractionEvent;
+import net.dv8tion.jda.api.events.interaction.component.StringSelectInteractionEvent;
+import net.dv8tion.jda.api.interactions.modals.ModalMapping;
+import net.dv8tion.jda.api.modals.Modal;
+import net.dv8tion.jda.api.utils.data.DataObject;
+import net.dv8tion.jda.api.utils.messages.MessageCreateData;
+import net.dv8tion.jda.api.utils.messages.MessageEditData;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.helpers.ButtonHelper;
+import ti4.message.MessageHelper;
+import ti4.selfhost.engine.DecisionRegistry;
+import ti4.selfhost.engine.EngineModels;
+import ti4.selfhost.engine.Interaction;
+
+/**
+ * Offline test of the engine-native Interaction: unmodified helper code and JDA-shaped handler calls run against an
+ * EngineInteraction with a recording sink (no JDA connection, no shim, no Discord payloads).
+ */
+public class InteractionSmoke {
+    static int failures;
+
+    static void check(boolean ok, String what) {
+        System.out.println((ok ? "PASS " : "FAIL ") + what);
+        if (!ok) failures++;
+    }
+
+    /** Records every message op; serves one prompt message with the given buttons. */
+    static final class RecordingSink implements MessageSink {
+        final List<String> ops = new ArrayList<>();
+        Message prompt;
+
+        @Override
+        public MessageChannel channel(String channelId) {
+            return null; // channel-level helpers are not exercised here (they post through JDA REST)
+        }
+
+        @Override
+        public Message fetch(String channelId, String messageId) {
+            ops.add("fetch " + messageId);
+            return prompt;
+        }
+
+        @Override
+        public Message send(String channelId, MessageCreateData data, String ephemeralFor) {
+            ops.add("send" + (ephemeralFor != null ? "[eph:" + ephemeralFor + "]" : "") + " " + data.getContent()
+                    + (data.getComponents().isEmpty() ? "" : " +components"));
+            return null;
+        }
+
+        @Override
+        public Message edit(String channelId, String messageId, MessageEditData data) {
+            ops.add("edit " + messageId + " components=" + data.getComponents().size()
+                    + (data.getContent() == null || data.getContent().isEmpty() ? "" : " content=" + data.getContent()));
+            return null;
+        }
+
+        @Override
+        public void delete(String channelId, String messageId, int delaySeconds) {
+            ops.add("delete " + messageId + (delaySeconds > 0 ? " after " + delaySeconds : ""));
+        }
+
+        @Override
+        public User user(String userId) {
+            return null;
+        }
+
+        @Override
+        public Member member(Guild guild, String userId) {
+            return null;
+        }
+    }
+
+    static Message message(String id, String content, List<Button> buttons) {
+        MessageComponentTree tree = MessageComponentTree.of(ActionRow.partitionOf(buttons));
+        return (Message) Proxy.newProxyInstance(Message.class.getClassLoader(), new Class<?>[] {Message.class}, (p, m, a) ->
+                switch (m.getName()) {
+                    case "getComponentTree" -> tree;
+                    case "getComponents" -> tree.getComponents();
+                    case "getContentRaw" -> content;
+                    case "getId" -> id;
+                    case "getIdLong" -> Long.parseLong(id);
+                    case "isEphemeral" -> false;
+                    case "hashCode" -> 1;
+                    case "equals" -> p == a[0];
+                    case "toString" -> "Msg" + id;
+                    default -> throw new UnsupportedOperationException("test message: " + m.getName());
+                });
+    }
+
+    public static void main(String[] args) throws Exception {
+        Game g = new Game();
+        g.setName("pbd998");
+        Player a = g.addPlayer("111", "alice");
+        a.setFaction(g, "hacan");
+
+        // ---------------------------------------------------------------- button: delete one button, keep message
+        RecordingSink sink = new RecordingSink();
+        Button b1 = Buttons("FFCC_hacan_doThing_1", 1), b2 = Buttons("FFCC_hacan_doThing_2", 2);
+        sink.prompt = message("7001", "pick", List.of(b1, b2, Buttons("deleteButtons", 3)));
+        EngineInteraction ix = new EngineInteraction(EngineInteraction.Type.BUTTON, g, a, "111", "800", "7001",
+                "FFCC_hacan_doThing_1", null, null, sink);
+        ButtonInteractionEvent ev = NativeEvents.button(ix);
+        check(Interaction.of(ev) == ix && Interaction.isEngine(ev), "Interaction.of(event) finds the engine interaction");
+        check("FFCC_hacan_doThing_1".equals(ev.getComponentId()) && ev.getButton().getUniqueId() == 1,
+                "component id + button (uniqueId from the prompt's tree) " + ev.getButton().getUniqueId());
+        check("pick".equals(ev.getMessage().getContentRaw()) && "7001".equals(ev.getMessageId()), "getMessage via sink");
+        ButtonHelper.deleteButtonAndDeleteMessageIfEmpty(ev);
+        check(sink.ops.contains("edit 7001 components=1"), "deleteTheOneButton edits components " + sink.ops);
+
+        // ---------------------------------------------------------------- button: last real button → delete message
+        sink = new RecordingSink();
+        sink.prompt = message("7002", "pick", List.of(b1, Buttons("deleteButtons", 3)));
+        DecisionRegistry.open(new EngineModels.Decision("d7002", "pbd998", "legacy", 0, 0, null, "table", "public",
+                "pick", List.of(), new EngineModels.Source("800", "7002", null, false), 0, 0, null, null, null));
+        ix = new EngineInteraction(EngineInteraction.Type.BUTTON, g, a, "111", "800", "7002", "FFCC_hacan_doThing_1",
+                null, null, sink);
+        ev = NativeEvents.button(ix);
+        ButtonHelper.deleteButtonAndDeleteMessageIfEmpty(ev);
+        check(sink.ops.contains("delete 7002"), "deletes message when no real button left " + sink.ops);
+        check(DecisionRegistry.get("d7002") == null, "decision closed immediately in the registry (answered)");
+
+        // ---------------------------------------------------------------- JDA token ops on the view
+        sink = new RecordingSink();
+        sink.prompt = message("7003", "pick", List.of(b1));
+        ix = new EngineInteraction(EngineInteraction.Type.BUTTON, g, a, "111", "800", "7003", "x_1", null, null, sink);
+        ev = NativeEvents.button(ix);
+        ev.deferEdit().queue();
+        ev.reply("hello").setEphemeral(true).queue();
+        ev.getHook().setEphemeral(true).sendMessage("secret").queue();
+        ev.getHook().sendMessage("public followup").queue(m -> {}, t -> {});
+        ev.getHook().editOriginalComponents(ActionRow.of(b2)).queue();
+        ev.getHook().editOriginal("new text").setComponents(List.of()).queue();
+        ev.getHook().deleteOriginal().queue();
+        ev.getMessage().getContentRaw();
+        MessageHelper.sendEphemeralMessageToEventChannel(ev, "via helper");
+        MessageHelper.sendMessageToEventChannelWithEphemeralButtons(ev, "eph buttons", List.of(b2));
+        MessageHelper.editMessageWithButtons(ev, "edited", List.of(b1));
+        ButtonHelper.deleteMessage(ev);
+        List<String> want = List.of(
+                "send[eph:111] hello",
+                "send[eph:111] secret",
+                "send[eph:111] public followup", // JDA: hook.setEphemeral is sticky for later followups
+                "edit 7003 components=1",
+                "edit 7003 components=0 content=new text",
+                "delete 7003",
+                "send[eph:111] via helper",
+                "send[eph:111] eph buttons +components",
+                "edit 7003 components=1 content=edited",
+                "delete 7003");
+        List<String> got = sink.ops.stream().filter(o -> !o.startsWith("fetch")).toList();
+        check(got.equals(want), "token ops map onto engine ops\n   got  " + got + "\n   want " + want);
+        check(ix.getTrace().contains("deferEdit"), "deferEdit is a no-op ack");
+
+        // ---------------------------------------------------------------- modal: replyModal → form schema
+        Modal modal = Modal.create("tgModal_hacan", "Send trade goods")
+                .addComponents(
+                        Label.of("How many", TextInput.create("count", TextInputStyle.SHORT).setRequired(true).build()),
+                        Label.of("Note", TextInput.create("note", TextInputStyle.PARAGRAPH).setRequired(false).setMaxLength(50).build()),
+                        Label.of("To", StringSelectMenu.create("to").addOption("Sol", "sol").addOption("Xxcha", "xxcha").build()))
+                .build();
+        ev.replyModal(modal).queue();
+        check(ix.getOpenedModal() == modal, "replyModal captured");
+        EngineModels.InputSchema schema = Forms.schema(modal);
+        check(schema.fields().size() == 3 && "number".equals(schema.fields().get(0).type())
+                        && "text".equals(schema.fields().get(1).type()) && schema.fields().get(1).multiline()
+                        && "choice".equals(schema.fields().get(2).type()) && schema.fields().get(2).choices().size() == 2,
+                "form schema " + schema);
+        check(Forms.validate(schema, Map.of("note", "x")) != null, "required field enforced");
+        check(Forms.validate(schema, Map.of("count", "two", "to", "sol")) != null, "number field enforced");
+        check(Forms.validate(schema, Map.of("count", "2", "to", "vuil")) != null, "choice enforced");
+        check(Forms.validate(schema, Map.of("count", "2", "to", "sol")) == null, "valid inputs accepted");
+
+        // ---------------------------------------------------------------- modal submit view
+        EngineInteraction mx = new EngineInteraction(EngineInteraction.Type.MODAL, g, a, "111", "800", "7003",
+                "tgModal_hacan", null, Map.of("count", "2", "to", "sol"), new RecordingSink());
+        mx.openModal(modal);
+        ModalInteractionEvent mev = NativeEvents.modal(mx);
+        ModalMapping count = mev.getValue("count");
+        ModalMapping to = mev.getValue("to");
+        check("tgModal_hacan".equals(mev.getModalId()) && count != null && "2".equals(count.getAsString())
+                        && to != null && List.of("sol").equals(to.getAsStringList()),
+                "modal event values " + (count == null ? null : count.getAsString()) + " " + (to == null ? null : to.getAsStringList()));
+
+        // ---------------------------------------------------------------- select view
+        sink = new RecordingSink();
+        EngineInteraction sx = new EngineInteraction(EngineInteraction.Type.SELECT, g, a, "111", "800", "7004",
+                "planetSelect_hacan", List.of("mr", "lodor"), null, sink);
+        StringSelectInteractionEvent sev = NativeEvents.select(sx);
+        check(List.of("mr", "lodor").equals(sev.getValues()) && "planetSelect_hacan".equals(sev.getComponentId()),
+                "select event values " + sev.getValues());
+
+        // ---------------------------------------------------------------- capture: select schema + ephemeral nonce attribution
+        DataObject msg = DataObject.fromJson("{\"id\":\"7005\",\"channel_id\":\"800\",\"flags\":64,\"content\":\"pick planets\","
+                + "\"components\":[{\"type\":1,\"components\":[{\"type\":3,\"custom_id\":\"planetSelect_hacan\",\"min_values\":1,\"max_values\":2,"
+                + "\"options\":[{\"label\":\"Mecatol\",\"value\":\"mr\"},{\"label\":\"Lodor\",\"value\":\"lodor\"}]}]}]}");
+        ti4.selfhost.engine.InteractionTracker.recordUser(MessageSink.EPHEMERAL_NONCE + "111", "111");
+        EngineModels.Decision sd = ti4.selfhost.engine.DecisionCaptureAccess.build(g, msg, MessageSink.EPHEMERAL_NONCE + "111");
+        check(sd.inputs() != null && sd.inputs().size() == 1 && sd.inputs().getFirst().fields().getFirst().maxValues() == 2
+                        && sd.options().size() == 2 && sd.options().getFirst().id().equals("planetSelect_hacan#mr"),
+                "select captured with schema " + sd.inputs());
+        check("111".equals(sd.target().userId()) && "interaction_user".equals(sd.target().resolvedBy())
+                        && "private".equals(sd.visibility()),
+                "engine ephemeral attributed to the answering user " + sd.target());
+
+        System.out.println(failures == 0 ? "ALL PASS" : failures + " FAILURES");
+        System.exit(failures == 0 ? 0 : 1);
+    }
+
+    static Button Buttons(String id, int uid) {
+        return Button.secondary(id, id).withUniqueId(uid);
+    }
+}
