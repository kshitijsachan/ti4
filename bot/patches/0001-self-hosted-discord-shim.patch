diff --git a/src/main/java/ti4/service/combat/PlanetaryShieldRules.java b/src/main/java/ti4/service/combat/PlanetaryShieldRules.java
new file mode 100644
index 0000000..6cb9b74
--- /dev/null
+++ b/src/main/java/ti4/service/combat/PlanetaryShieldRules.java
@@ -0,0 +1,123 @@
+package ti4.service.combat;
+
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import javax.annotation.Nullable;
+import lombok.experimental.UtilityClass;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.game.Tile;
+import ti4.game.UnitHolder;
+import ti4.helpers.ButtonHelper;
+import ti4.helpers.Helper;
+import ti4.helpers.Units.UnitKey;
+import ti4.helpers.Units.UnitType;
+import ti4.helpers.thundersedge.TeHelperUnits;
+import ti4.model.UnitModel;
+
+/**
+ * PLANETARY SHIELD against BOMBARDMENT (rules audit, factions slice; the original bot never checked it — it only drew
+ * the shield on the map). "Units cannot use BOMBARDMENT against a planet that contains a unit with PLANETARY SHIELD"
+ * (PDS, PDS II, Arborec Letani Behemoth, Titans Hel-Titan I/II, ...).
+ *
+ * <p>Turned off by: the bombarding player's unit in the system that removes it (war suns, Prototype War Sun, data flag
+ * {@code disablesPlanetaryShield}) or Arc Secundus (Letnev flagship: "Other players' units in this system lose
+ * PLANETARY SHIELD", missing from the unit data); Disable (action card) played by the bombarding player during this
+ * invasion ("Your opponents' PDS units lose PLANETARY SHIELD") — PDS only, recorded per tactical action when the card
+ * is played; units that lose their abilities to the Crimson flagship (Quietus).
+ */
+@UtilityClass
+public class PlanetaryShieldRules {
+
+    private static final String DISABLE_KEY = "planetaryShieldDisabledBy";
+
+    /** Disable (disable / disable2) played: its player's opponents' PDS lose PLANETARY SHIELD this tactical action. */
+    public static void recordDisable(Game game, Player player) {
+        if (game == null || player == null) return;
+        game.setStoredValue(DISABLE_KEY, player.getFaction() + ";" + game.getActiveSystem() + ";" + game.getRound());
+    }
+
+    /** True while a Disable played by {@code bombarder} applies (same active system, same round). */
+    public static boolean disableActive(Game game, Player bombarder) {
+        String v = game.getStoredValue(DISABLE_KEY);
+        if (v == null || v.isEmpty() || bombarder == null) return false;
+        String[] a = v.split(";");
+        return a.length == 3
+                && a[0].equals(bombarder.getFaction())
+                && a[1].equals(String.valueOf(game.getActiveSystem()))
+                && a[2].equals(String.valueOf(game.getRound()));
+    }
+
+    /** True when the bombarder has a unit in the system that removes other players' PLANETARY SHIELD. */
+    public static boolean bombarderIgnoresShields(Game game, Player bombarder, Tile tile) {
+        if (ButtonHelper.doesPlayerHaveFSHere("letnev_flagship", bombarder, tile)) return true;
+        for (UnitHolder uh : tile.getUnitHolders().values()) {
+            for (UnitKey key : uh.getUnitKeys()) {
+                if (!bombarder.unitBelongsToPlayer(key) || uh.getUnitCount(key) <= 0) continue;
+                UnitModel m = bombarder.getUnitFromUnitKey(key);
+                if (m != null && m.getDisablesPlanetaryShield()) return true;
+            }
+        }
+        return false;
+    }
+
+    /**
+     * Why {@code bombarder} cannot use BOMBARDMENT against {@code planet} in {@code tile} because of PLANETARY SHIELD
+     * (null = no active shield).
+     */
+    @Nullable
+    public static String shieldReason(Game game, Player bombarder, Tile tile, String planet) {
+        if (game == null || bombarder == null || tile == null || planet == null) return null;
+        UnitHolder uh = tile.getUnitHolders().get(planet);
+        if (uh == null || bombarderIgnoresShields(game, bombarder, tile)) return null;
+        boolean disable = disableActive(game, bombarder);
+        for (UnitKey key : uh.getUnitKeys()) {
+            if (uh.getUnitCount(key) <= 0 || bombarder.unitBelongsToPlayer(key)) continue;
+            Player owner = game.getPlayerByColorID(key.colorID()).orElse(null);
+            if (owner == null || bombarder.getAllianceMembers().contains(owner.getFaction())) continue;
+            UnitModel m = owner.getUnitFromUnitKey(key);
+            if (m == null || !m.getPlanetaryShield()) continue;
+            if (disable && key.unitType() == UnitType.Pds) continue;
+            if (TeHelperUnits.affectedByQuietus(game, owner, uh)) continue;
+            return Helper.getPlanetRepresentationNoResInf(planet, game) + " has PLANETARY SHIELD ("
+                    + owner.getRepresentationNoPing() + "'s " + m.getName() + ")";
+        }
+        return null;
+    }
+
+    /** Planets of the system the shield keeps out of reach of this bombarder, with the reason. */
+    public static Map<String, String> shieldedPlanets(Game game, Player bombarder, Tile tile) {
+        Map<String, String> out = new LinkedHashMap<>();
+        if (tile == null) return out;
+        for (UnitHolder uh : tile.getPlanetUnitHolders()) {
+            String why = shieldReason(game, bombarder, tile, uh.getName());
+            if (why != null) out.put(uh.getName(), why);
+        }
+        return out;
+    }
+
+    /**
+     * Why a BOMBARDMENT roll by {@code bombarder} in {@code tile} has no legal target because of shields (null when
+     * some planet can be bombarded, or when no planet is shielded — the original messages cover that case).
+     */
+    @Nullable
+    public static String rollRefusal(Game game, Player bombarder, Tile tile) {
+        if (tile == null || !BombardmentService.getBombardablePlanets(bombarder, game, tile).isEmpty()) return null;
+        Map<String, String> shielded = shieldedPlanets(game, bombarder, tile);
+        if (shielded.isEmpty()) return null;
+        return String.join("; ", new ArrayList<>(shielded.values()));
+    }
+
+    /** {@link #rollRefusal} for a bombardment roll button id (combatRoll_&lt;pos&gt;_&lt;holder&gt;_bombardment...). */
+    @Nullable
+    public static String rollRefusal(Game game, Player bombarder, String handlerId) {
+        if (game == null || handlerId == null) return null;
+        String h = handlerId.replaceFirst("^FFCC_[^_]+_", "").replaceFirst("^bombardConfirm_", "");
+        if (!h.startsWith("combatRoll_")) return null;
+        String[] parts = h.split("_");
+        if (parts.length < 4 || !"bombardment".equals(parts[3])) return null;
+        return rollRefusal(game, bombarder, game.getTileByPosition(parts[1]));
+    }
+}
