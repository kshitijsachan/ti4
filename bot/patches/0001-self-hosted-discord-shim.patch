diff --git a/src/main/java/ti4/spring/api/selfhost/ArtController.java b/src/main/java/ti4/spring/api/selfhost/ArtController.java
new file mode 100644
index 0000000..abfae77
--- /dev/null
+++ b/src/main/java/ti4/spring/api/selfhost/ArtController.java
@@ -0,0 +1,71 @@
+package ti4.spring.api.selfhost;
+
+import jakarta.servlet.http.HttpServletRequest;
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.TimeUnit;
+import org.springframework.core.io.FileSystemResource;
+import org.springframework.core.io.Resource;
+import org.springframework.http.CacheControl;
+import org.springframework.http.MediaType;
+import org.springframework.http.ResponseEntity;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.RestController;
+import ti4.helpers.Storage;
+
+/**
+ * Serves the bot's own art (tiles, units, tokens, cards, factions) to the self-hosted web client as
+ * {@code GET /api/public/selfhost/art/<path under resources>}, so the site doesn't depend on AsyncTI4's CDN.
+ * The web asks for .webp and .png interchangeably, so other image extensions are tried when the exact file is missing.
+ */
+@RestController
+public class ArtController {
+
+    private static final String PREFIX = "/api/public/selfhost/art/";
+    private static final List<String> EXTENSIONS = List.of(".png", ".webp", ".jpg", ".jpeg", ".gif", ".svg");
+    private static final Map<String, MediaType> TYPES = Map.of(
+            ".png", MediaType.IMAGE_PNG,
+            ".webp", MediaType.parseMediaType("image/webp"),
+            ".jpg", MediaType.IMAGE_JPEG,
+            ".jpeg", MediaType.IMAGE_JPEG,
+            ".gif", MediaType.IMAGE_GIF,
+            ".svg", MediaType.parseMediaType("image/svg+xml"));
+
+    @GetMapping(PREFIX + "**")
+    public ResponseEntity<Resource> art(HttpServletRequest request) throws IOException {
+        String resources = Storage.getResourcePath();
+        if (resources == null) return ResponseEntity.notFound().build();
+        Path root = Path.of(resources).toRealPath();
+        String rel = request.getRequestURI().substring(request.getRequestURI().indexOf(PREFIX) + PREFIX.length());
+        rel = java.net.URLDecoder.decode(rel, java.nio.charset.StandardCharsets.UTF_8);
+        Path requested = root.resolve(rel).normalize();
+        if (!requested.startsWith(root)) return ResponseEntity.badRequest().build();
+
+        Path file = resolve(requested);
+        if (file == null) return ResponseEntity.notFound().build();
+        String name = file.getFileName().toString();
+        String ext = name.contains(".") ? name.substring(name.lastIndexOf('.')).toLowerCase() : "";
+        // Images only: never expose config or data files that live under resources.
+        if (!TYPES.containsKey(ext)) return ResponseEntity.notFound().build();
+        return ResponseEntity.ok()
+                .contentType(TYPES.get(ext))
+                .cacheControl(CacheControl.maxAge(7, TimeUnit.DAYS).cachePublic())
+                .body(new FileSystemResource(file));
+    }
+
+    private static Path resolve(Path requested) {
+        String requestedName = requested.getFileName().toString().toLowerCase();
+        boolean isImage = EXTENSIONS.stream().anyMatch(requestedName::endsWith);
+        if (isImage && Files.isRegularFile(requested)) return requested;
+        String name = requested.getFileName().toString();
+        String stem = name.contains(".") ? name.substring(0, name.lastIndexOf('.')) : name;
+        for (String ext : EXTENSIONS) {
+            Path candidate = requested.resolveSibling(stem + ext);
+            if (Files.isRegularFile(candidate)) return candidate;
+        }
+        return null;
+    }
+}
diff --git a/src/main/java/ti4/spring/api/selfhost/DraftButtonLocator.java b/src/main/java/ti4/spring/api/selfhost/DraftButtonLocator.java
new file mode 100644
index 0000000..19401c4
--- /dev/null
+++ b/src/main/java/ti4/spring/api/selfhost/DraftButtonLocator.java
@@ -0,0 +1,71 @@
+package ti4.spring.api.selfhost;
+
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.TimeUnit;
+import net.dv8tion.jda.api.components.buttons.Button;
+import net.dv8tion.jda.api.entities.Message;
+import net.dv8tion.jda.api.entities.MessageHistory;
+import net.dv8tion.jda.api.entities.channel.concrete.TextChannel;
+import org.springframework.stereotype.Component;
+import ti4.discord.JdaService;
+import ti4.game.Game;
+
+/**
+ * Finds which message in the game's main channel currently carries each draft button, so the web client can
+ * "press" it through the shim. Reads the latest 200 messages through JDA (i.e. the shim's REST API) and caches
+ * the result briefly per channel + game version.
+ */
+@Component
+public class DraftButtonLocator {
+
+    /** Interactions that move buttons usually save the game (new version); the TTL covers the ones that do not. */
+    private static final long TTL_MS = 4000;
+    private static final int PAGES = 2;
+
+    private record Entry(long at, long version, Map<String, String> buttons) {}
+
+    private final Map<String, Entry> cache = new ConcurrentHashMap<>();
+
+    /** custom_id -> message id (newest message wins). */
+    public Map<String, String> locate(Game game) {
+        TextChannel channel;
+        try {
+            channel = game.getMainGameChannel();
+        } catch (Exception e) {
+            return Map.of();
+        }
+        if (channel == null) return Map.of();
+        String key = channel.getId();
+        long now = System.currentTimeMillis();
+        Entry hit = cache.get(key);
+        if (hit != null && hit.version == game.getLastModifiedDate() && now - hit.at < TTL_MS) return hit.buttons;
+
+        Map<String, String> found = new HashMap<>();
+        try {
+            MessageHistory mh = channel.getHistory();
+            List<Message> history = new java.util.ArrayList<>();
+            for (int page = 0; page < PAGES; page++) {
+                List<Message> got = mh.retrievePast(100).timeout(5, TimeUnit.SECONDS).complete();
+                history.addAll(got);
+                if (got.size() < 100) break;
+            }
+            // History is newest first; keep the first (newest) message seen for each button.
+            String botId = JdaService.getBotId();
+            for (Message m : history) {
+                if (botId != null && !botId.equals(m.getAuthor().getId())) continue;
+                for (Button b : m.getComponentTree().findAll(Button.class)) {
+                    if (b.getCustomId() == null || b.isDisabled()) continue;
+                    found.putIfAbsent(b.getCustomId(), m.getId());
+                }
+            }
+        } catch (Exception e) {
+            if (hit != null) return hit.buttons;
+            return Map.of();
+        }
+        cache.put(key, new Entry(now, game.getLastModifiedDate(), found));
+        return found;
+    }
+}
