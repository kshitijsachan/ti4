+            leader("xxchahero-te", "target", false, "xxchaHeroTEStep2_(?<unit>.+)"));
+
+    @Override
+    protected List<Rule> rules() {
+        return RULES;
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/FactionStepsYin.java b/src/main/java/ti4/selfhost/engine/kinds/FactionStepsYin.java
new file mode 100644
