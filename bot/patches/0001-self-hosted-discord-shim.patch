+++ b/src/main/java/ti4/selfhost/engine/kinds/CombatPlanController.java
@@ -0,0 +1,62 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.Map;
+import org.springframework.http.CacheControl;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.security.access.prepost.PreAuthorize;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestHeader;
+import org.springframework.web.bind.annotation.RestController;
+import ti4.discord.JdaService;
+import ti4.selfhost.engine.kinds.CombatPlanService.PlanRequest;
+import ti4.selfhost.engine.kinds.CombatPlanService.PlanResult;
+import ti4.spring.context.RequestContext;
+
+/**
+ * Answer a combat.hits decision with a whole assignment plan (see {@link CombatPlanService}). Same two audiences as
+ * EngineController: the shim (Bot token, userId in the body) and a seat (Bearer, own decisions only).
+ */
+@RestController
+public class CombatPlanController {
+
+    @PostMapping("/api/public/selfhost/engine/{game}/decisions/{id}/combat-plan")
+    public ResponseEntity<?> planAs(
+            @PathVariable String game,
+            @PathVariable String id,
+            @RequestBody PlanRequest req,
+            @RequestHeader(value = "Authorization", required = false) String auth) {
+        if (!trusted(auth)) return ResponseEntity.status(HttpStatus.UNAUTHORIZED).body(Map.of("error", "bot token required"));
+        if (req.userId() == null) return ResponseEntity.badRequest().body(Map.of("error", "userId required"));
+        return respond(CombatPlanService.execute(game, id, req.userId(), req));
+    }
+
+    @PostMapping("/api/game/{gameName}/engine/decisions/{id}/combat-plan")
+    @PreAuthorize("@security.canAccessGame(#gameName)")
+    // No request-context lock/save (see EngineController.answer): the presses save the game themselves, and a
+    // request-scoped copy saved afterwards would undo them.
+    @ti4.spring.context.SetupRequestContext(false)
+    public ResponseEntity<?> plan(@PathVariable String gameName, @PathVariable String id, @RequestBody PlanRequest req) {
+        return respond(CombatPlanService.execute(gameName, id, RequestContext.getUserId(), req));
+    }
+
+    private static ResponseEntity<?> respond(PlanResult r) {
+        HttpStatus status = switch (r.status()) {
+            case "done" -> HttpStatus.OK;
+            case "stale", "busy" -> HttpStatus.CONFLICT;
+            case "forbidden" -> HttpStatus.FORBIDDEN;
+            case "error" -> HttpStatus.INTERNAL_SERVER_ERROR;
+            default -> HttpStatus.UNPROCESSABLE_ENTITY;
+        };
+        return ResponseEntity.status(status).cacheControl(CacheControl.noStore()).body(r);
+    }
+
+    private static boolean trusted(String auth) {
+        if (auth == null || JdaService.jda == null) return false;
+        String token = JdaService.jda.getToken();
+        String bare = token.startsWith("Bot ") ? token.substring(4) : token;
+        return auth.equals("Bot " + bare);
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/CombatPlanService.java b/src/main/java/ti4/selfhost/engine/kinds/CombatPlanService.java
new file mode 100644
index 0000000..d796066
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/CombatPlanService.java
@@ -0,0 +1,194 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+import net.dv8tion.jda.api.entities.channel.middleman.MessageChannel;
+import org.apache.commons.lang3.function.Consumers;
+import ti4.discord.JdaService;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.game.Tile;
+import ti4.game.persistence.GameManager;
+import ti4.game.persistence.ManagedGame;
+import ti4.logging.BotLogger;
+import ti4.selfhost.engine.ActionInvoker;
+import ti4.selfhost.engine.DecisionRegistry;
+import ti4.selfhost.engine.EngineModels.AnswerRequest;
+import ti4.selfhost.engine.EngineModels.AnswerResult;
+import ti4.selfhost.engine.EngineModels.Decision;
+import ti4.selfhost.engine.EngineModels.Option;
+
+/**
+ * Assign the hits of a combat.hits decision in one call: "sustain my dreadnought, destroy 2 fighters". Validated
+ * against the hits owed and the live units (never destroys more than owed, never leaves hits unassigned while units
+ * remain), then executed through the engine's own manual flow — "Manually Assign Hits", one unit button per unit,
+ * "Done" — so every side effect (Duranium, commanders, combat bookkeeping, messages) is the engine's.
+ */
+public final class CombatPlanService {
+    private CombatPlanService() {}
+
+    /** One line of a plan: `count` units of `unit` in `holder`, of the damaged or undamaged ones. */
+    public record PlanEntry(String holder, String unit, boolean damaged, String action, int count) {}
+
+    public record PlanRequest(String userId, Long expectedSeq, List<PlanEntry> plan) {}
+
+    public record PlanResult(boolean ok, String status, String error, int pressed) {}
+
+    private static final long WAIT_MS = 8000;
+
+    public static PlanResult execute(String gameName, String decisionId, String userId, PlanRequest req) {
+        return ti4.selfhost.engine.ActionInvoker.asOneUndoStep(
+                gameName, userId, "combat plan", () -> executeSteps(gameName, decisionId, userId, req));
+    }
+
+    private static PlanResult executeSteps(String gameName, String decisionId, String userId, PlanRequest req) {
+        Decision d = DecisionRegistry.get(decisionId);
+        if (d == null || !d.game().equals(gameName)) return fail("stale", "That decision is no longer open.");
+        if (!"combat.hits".equals(d.kind())) return fail("bad_option", "Not a combat.hits decision.");
+        if (req.expectedSeq() != null && req.expectedSeq() != d.seq()) return fail("stale", "The hits changed; re-read them.");
+        if (d.target() == null || !userId.equals(d.target().userId())) return fail("forbidden", "These hits are someone else's.");
+        ManagedGame mg = GameManager.getManagedGame(gameName);
+        Game game = mg == null ? null : mg.getGame();
+        Player player = game == null ? null : game.getPlayer(userId);
+        if (player == null) return fail("forbidden", "You are not a player of this game.");
+        Option auto = find(d, o -> "auto".equals(o.get("action")));
+        Option manual = find(d, o -> "assign_manual".equals(o.get("action")));
+        if (auto == null || manual == null) return fail("unsupported", "No manual assignment on this prompt.");
+        if (manual.disabled()) return fail("bad_option", "Manual assignment is disabled.");
+        String err = validate(game, player, auto.value(), req.plan() == null ? List.of() : req.plan());
+        if (err != null) return fail("refused", err);
+
+        long t0 = System.currentTimeMillis();
+        AnswerResult r = ActionInvoker.answer(gameName, d.id(), userId, new AnswerRequest(manual.id(), d.seq(), null, userId));
+        if (!r.ok()) return fail(r.status(), r.error());
+        Decision menu = waitForMenu(gameName, userId, t0);
+        if (menu == null) return fail("error", "The assignment menu did not open.");
+        String menuMsg = menu.source().messageId();
+        int pressed = 0;
+        for (PlanEntry e : req.plan()) {
+            for (int i = 0; i < e.count(); i++) {
+                String why = press(gameName, userId, menuMsg, e);
+                if (why != null) return new PlanResult(false, "error", why, pressed);
+                pressed++;
+            }
+        }
+        press(gameName, userId, menuMsg, null); // Done: closes the menu
+        closeHitsPrompt(d);
+        return new PlanResult(true, "done", null, pressed);
+    }
+
+    /** Null when the plan is legal for the hits owed and the units there now. */
+    static String validate(Game game, Player player, Map<String, Object> auto, List<PlanEntry> plan) {
+        int hits = ((Number) auto.get("hits")).intValue();
+        String source = String.valueOf(auto.get("source"));
+        String holder = String.valueOf(auto.get("holder"));
+        Tile tile = game.getTileByPosition(String.valueOf(auto.get("tile")));
+        int cancels = player.hasTech("nes") ? 2 : 1;
+        Map<String, Map<String, Object>> live = new HashMap<>();
+        int unitsThere = 0;
+        for (Map<String, Object> u : CombatSupport.hittableUnits(game, player, tile, holder, source)) {
+            live.put(u.get("holder") + "/" + u.get("unit"), u);
+            unitsThere += ((Number) u.get("count")).intValue();
+        }
+        Map<String, int[]> used = new HashMap<>(); // [undamaged, damaged]
+        int assigned = 0, destroyed = 0;
+        for (PlanEntry e : plan) {
+            if (e.count() <= 0) return "Counts must be positive.";
+            Map<String, Object> u = live.get(e.holder() + "/" + e.unit());
+            if (u == null) return "No " + e.unit() + " of yours there to take a hit.";
+            int count = ((Number) u.get("count")).intValue();
+            int damaged = ((Number) u.get("damaged")).intValue();
+            int[] use = used.computeIfAbsent(e.holder() + "/" + e.unit(), k -> new int[2]);
+            if ("sustain".equals(e.action())) {
+                if (!Boolean.TRUE.equals(u.get("sustain"))) return e.unit() + " cannot sustain damage.";
+                if (e.damaged()) return "A damaged unit cannot sustain damage again.";
+                use[0] += e.count();
+                assigned += e.count() * cancels;
+            } else if ("destroy".equals(e.action())) {
+                if (e.damaged()) use[1] += e.count();
+                else use[0] += e.count();
+                assigned += e.count();
+                destroyed += e.count();
+            } else {
+                return "Unknown action " + e.action() + ".";
+            }
+            if (use[0] > count - damaged || use[1] > damaged) return "Not that many " + e.unit() + " there.";
+        }
+        if (assigned > hits && !(cancels == 2 && assigned - 1 == hits)) return "That assigns more than the " + hits + " hit(s) owed.";
+        if (assigned < hits && destroyed < unitsThere) return "Assign all " + hits + " hit(s).";
+        if (hits > 0 && plan.isEmpty()) return "Assign the hits.";
+        return null;
+    }
+
+    private static Decision waitForMenu(String game, String userId, long since) {
+        long until = System.currentTimeMillis() + WAIT_MS;
+        while (System.currentTimeMillis() < until) {
+            for (Decision x : DecisionRegistry.openDecisions(game)) {
+                if ("combat.assign_units".equals(x.kind())
+                        && x.target() != null
+                        && userId.equals(x.target().userId())
+                        && x.createdAt() >= since) return x;
+            }
+            sleep(100);
+        }
+        return null;
+    }
+
+    /** Presses the unit option for `e` (or Done when e is null) on the menu's current revision. */
+    private static String press(String game, String userId, String menuMsg, PlanEntry e) {
+        long until = System.currentTimeMillis() + WAIT_MS;
+        String last = "The menu closed.";
+        while (System.currentTimeMillis() < until) {
+            String id = DecisionRegistry.decisionIdForMessage(menuMsg);
+            Decision cur = id == null ? null : DecisionRegistry.get(id);
+            if (cur == null) return e == null ? null : last;
+            Option o = find(cur, v -> e == null ? "done".equals(v.get("action")) : matches(v, e));
+            if (o == null) {
+                last = "No option for " + (e == null ? "Done" : e.action() + " " + e.unit()) + ".";
+                sleep(150); // the edit after the previous press may still be on its way
+                continue;
+            }
+            AnswerResult r = ActionInvoker.answer(game, cur.id(), userId, new AnswerRequest(o.id(), cur.seq(), null, userId));
+            if (r.ok()) return null;
+            last = r.error();
+            if (!"stale".equals(r.status()) && !"busy".equals(r.status())) return last;
+            sleep(150);
+        }
+        BotLogger.warning("engine: combat plan press timed out: " + last);
+        return last;
+    }
+
+    private static boolean matches(Map<String, Object> v, PlanEntry e) {
+        return e.action().equals(v.get("action"))
+                && Objects.equals(e.holder(), v.get("holder"))
+                && e.unit().equals(v.get("unit"))
+                && Objects.equals(1, v.get("count"))
+                && Objects.equals(e.damaged(), v.get("damaged"));
+    }
+
+    /** AFB / space cannon prompts survive a manual assignment; remove the spent prompt so nobody assigns twice. */
+    private static void closeHitsPrompt(Decision d) {
+        if (DecisionRegistry.get(d.id()) == null || JdaService.jda == null) return;
+        MessageChannel ch = JdaService.jda.getChannelById(MessageChannel.class, d.source().channelId());
+        if (ch != null) ch.deleteMessageById(d.source().messageId()).queue(Consumers.nop(), BotLogger::catchRestError);
+    }
+
+    private static Option find(Decision d, java.util.function.Predicate<Map<String, Object>> test) {
+        for (Option o : d.options()) if (o.value() != null && !o.disabled() && test.test(o.value())) return o;
+        return null;
+    }
+
+    private static PlanResult fail(String status, String error) {
+        return new PlanResult(false, status, error, 0);
+    }
+
+    private static void sleep(long ms) {
+        try {
+            Thread.sleep(ms);
+        } catch (InterruptedException ie) {
+            Thread.currentThread().interrupt();
+        }
+    }
+}
