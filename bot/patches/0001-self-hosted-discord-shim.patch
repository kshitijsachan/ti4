--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/DealSecretsKind.java
@@ -0,0 +1,72 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.Map;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.selfhost.engine.EngineModels.Decision;
+import ti4.selfhost.engine.EngineModels.SetupState;
+import ti4.selfhost.engine.EngineModels.Target;
+import ti4.selfhost.engine.KindSpec;
+import ti4.selfhost.engine.SetupStateBuilder;
+
+/**
+ * Table step "Deal 2 Secret Objectives To All" (deal2SOToAll, main channel, anyone may press). The handler refuses a
+ * first early press but lets a second one through ("press again to proceed anyway"), and it may be posted more than
+ * once (again after Keleres sets up): validate refuses while any player is still setting up and once secrets were
+ * dealt, so through the engine it deals exactly once, and only when the table is ready. value: {}.
+ */
+public class DealSecretsKind implements KindSpec {
+
+    @Override
+    public String kind() {
+        return "setup.deal_secrets";
+    }
+
+    @Override
+    public int priority() {
+        return 100;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return "deal2SOToAll".equals(handlerId);
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        return matches(handlerId) ? SetupKindSupport.map() : null;
+    }
+
+    @Override
+    public Target target(CaptureContext ctx, Target resolved) {
+        return null;
+    }
+
+    @Override
+    public String scope(CaptureContext ctx) {
+        return "table";
+    }
+
+    @Override
+    public String validate(Game game, Player answering, Decision decision, String optionId) {
+        if (!matches(SetupKindSupport.handlerOf(decision, optionId))) return null;
+        if (SetupStateBuilder.secretsDealt(game)) return "Secret objectives have already been dealt.";
+        SetupState s = SetupStateBuilder.build(game);
+        if (s == null) return null;
+        // Fail open when we cannot name anyone still choosing (the handler validates again).
+        if (!"deal_secrets".equals(s.stage()) && !s.waitingOn().isEmpty())
+            return "Not every player is set up yet (" + s.waitingOn().size() + " still choosing).";
+        return null;
+    }
+
+    @Override
+    public boolean dynamic() {
+        return true;
+    }
+
+    /** Past setup this prompt is a leftover nobody needs (live: hundreds open across games, flooding the web queue). */
+    @Override
+    public boolean obsolete(CaptureContext ctx) {
+        return ti4.selfhost.engine.SetupStateBuilder.pastSetup(ctx.game());
+    }
+}
