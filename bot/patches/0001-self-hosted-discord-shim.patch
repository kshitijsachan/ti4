+        leader("handleRalNelAgent_", "ralnelagent", "target", false, "card");
+        leader("ralnelCommander_", "ralnelcommander", "use", true, "tile");
+        leader("ralnelCStep3_", "ralnelcommander", "target", false, "to", "from");
+        leader("moveOjzRetreatS1_", "ralnelcommander", "target", false, "from", "unit", "holder");
+        leader("undoOjzRetreatS1_", "ralnelcommander", "undo", false, "from", "unit", "holder");
+        leader("ojzRetreatS2_", "ralnelcommander", "target", false, "from");
+        leader("ojzRetreatS3_", "ralnelcommander", "target", false, "to");
+
+        ability("startSurvival_", "ability", "survivalinstinct", F, "target", true, "tile", "from");
+        ability("moveSurvival_", "ability", "survivalinstinct", F, "target", true, "tile", "from", "unit", "holder");
+        ability("undoSurvival_", "ability", "survivalinstinct", F, "undo", true, "tile", "from", "unit", "holder");
+        ability("finishSurvival_", "ability", "survivalinstinct", F, "skip", true, "tile");
+        ability("miniLanding_", "ability", "miniaturization", F, "use", true, "tile", "units", "planet");
+        ability("removeStrandedStructures_", "ability", "miniaturization", F, "target", false, "tile");
+
+        ability("startForerunner_", "mech", "ralnel_mech", F, "target", true, "tile", "from");
+        ability("moveForerunner_", "mech", "ralnel_mech", F, "target", true, "tile", "from", "unit", "holder");
