diff --git a/src/main/java/ti4/selfhost/engine/kinds/RelicFragmentsKind.java b/src/main/java/ti4/selfhost/engine/kinds/RelicFragmentsKind.java
new file mode 100644
index 0000000..05cde67
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/RelicFragmentsKind.java
@@ -0,0 +1,116 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+import java.util.concurrent.ConcurrentHashMap;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.image.Mapper;
+import ti4.model.ExploreModel;
+import ti4.selfhost.engine.EngineModels.Progress;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * Purge relic fragments (and then draw a relic). One message, several presses (ComponentActionHelper "getRelic",
+ * Fabrication, Lanefir mech, promissory notes, secret objectives):
+ *
+ * <pre>
+ * purge_Frags_{CRF,IRF,HRF,URF}_n     {action:"purge", trait, count:n, fragmentsAtStart, setSize}
+ * purgeSupermassiveFrag_&lt;id&gt;          {action:"purge", trait, count:1, fragment:id, supermassive:true, ...}
+ * drawRelicFromFrag                   {action:"draw", fragmentsAtStart, setSize, explore (A New Edifice explores instead)}
+ * </pre>
+ *
+ * The message stays up between presses (a purge button only disappears once that trait is used up), so the decision
+ * is dynamic and carries progress: {flow:"relic_fragments", step:"purge", accumulated:{purged, byTrait}, required:
+ * {setSize}, canCommit: purged at least setSize}, recomputed after every save from the player's fragments versus the
+ * counts when this menu was first seen ({@code fragmentsAtStart} on each option). setSize = fragments needed for a
+ * relic (3, minus Age of Exploration / Fabrication / Black Market Forgery); frontier fragments are wild.
+ */
+public class RelicFragmentsKind implements KindSpec {
+
+    /** messageId → counts at first capture (edits keep the first). Bounded; menus are short-lived. */
+    private static final Map<String, Map<String, Object>> BASELINE = new ConcurrentHashMap<>();
+
+    @Override
+    public String kind() {
+        return "relic.fragments";
+    }
+
+    @Override
+    public int priority() {
+        return 100;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return handlerId.matches("purge_Frags_(CRF|IRF|HRF|URF)_\\d+")
+                || handlerId.startsWith("purgeSupermassiveFrag_")
+                || handlerId.equals("drawRelicFromFrag");
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        if (!matches(handlerId)) return null;
+        Player p = ctx.player();
+        Map<String, Object> v = new LinkedHashMap<>();
+        if (handlerId.equals("drawRelicFromFrag")) {
+            v.put("action", "draw");
+            v.put("explore", p != null && p.hasAbility("a_new_edifice"));
+        } else if (handlerId.startsWith("purgeSupermassiveFrag_")) {
+            String id = handlerId.substring("purgeSupermassiveFrag_".length());
+            ExploreModel m = Mapper.getExplore(id);
+            v.put("action", "purge");
+            v.put("trait", m == null || m.getType() == null ? null : m.getType().toLowerCase());
+            v.put("count", 1);
+            v.put("fragment", id);
+            v.put("supermassive", true);
+        } else {
+            String[] parts = handlerId.split("_");
+            v.put("action", "purge");
+            v.put("trait", ExploreSupport.fragTrait(parts[2]));
+            v.put("count", Integer.parseInt(parts[3]));
+            v.put("supermassive", false);
+        }
+        v.put("fragmentsAtStart", baseline(ctx.messageId(), p));
+        v.put("setSize", setSize(ctx.game(), p));
+        return v;
+    }
+
+    private static Map<String, Object> baseline(String messageId, Player p) {
+        if (messageId == null) return ExploreSupport.fragmentCounts(p);
+        if (BASELINE.size() > 500) BASELINE.clear();
+        return BASELINE.computeIfAbsent(messageId, k -> ExploreSupport.fragmentCounts(p));
+    }
+
+    @Override
+    public boolean dynamic() {
+        return true;
+    }
+
+    @Override
+    public Progress progress(CaptureContext ctx) {
+        Player p = ctx.player();
+        if (p == null) return null;
+        Map<String, Object> start = baseline(ctx.messageId(), p);
+        Map<String, Object> now = ExploreSupport.fragmentCounts(p);
+        Map<String, Object> byTrait = new LinkedHashMap<>();
+        int purged = 0;
+        for (Map.Entry<String, Object> e : start.entrySet()) {
+            int d = Math.max(0, (Integer) e.getValue() - (Integer) now.getOrDefault(e.getKey(), 0));
+            byTrait.put(e.getKey(), d);
+            purged += d;
+        }
+        int size = setSize(ctx.game(), p);
+        Map<String, Object> acc = new LinkedHashMap<>();
+        acc.put("purged", purged);
+        acc.put("byTrait", byTrait);
+        return new Progress("relic_fragments", "purge", acc, Map.of("setSize", size), purged >= size);
+    }
+
+    static int setSize(Game game, Player p) {
+        int n = 3;
+        if (game.isAgeOfExplorationMode()) n--;
+        if (p != null && (p.hasAbility("fabrication") || p.getPromissoryNotes().containsKey("bmf"))) n--;
+        return n;
+    }
+}
