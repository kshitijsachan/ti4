+package ti4.selfhost.engine.kinds;
+
+import java.util.Map;
+import ti4.selfhost.engine.EngineModels.Target;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * After an agenda resolved (AgendaResolveButtonHandler.buildNextButtons / resolveWithNoEffect): flip_agenda (reveal
+ * the next agenda), proceed_to_strategy (agenda cleanup, strategy phase), and in Omega Phase proceed_to_scoring /
+ * elect_voice_of_the_council. Target: the speaker. Low priority so a status-phase kind may claim a lone
+ * proceed_to_strategy message.
+ */
+public class AgendaNextKind implements KindSpec {
+
+    @Override
+    public String kind() {
+        return "agenda.next";
+    }
+
+    @Override
+    public int priority() {
+        return 40;
+    }
+
+    @Override
+    public boolean matches(String h) {
+        return h.equals("flip_agenda")
+                || h.equals("proceed_to_strategy")
+                || h.equals("proceed_to_scoring")
+                || h.equals("elect_voice_of_the_council");
+    }
+
+    @Override
+    public Map<String, Object> value(String h, CaptureContext ctx) {
+        return switch (h) {
+            case "flip_agenda" -> Map.of("action", "flip");
+            case "proceed_to_strategy" -> Map.of("action", "strategy_phase");
+            case "proceed_to_scoring" -> Map.of("action", "scoring");
+            case "elect_voice_of_the_council" -> Map.of("action", "elect_voice_of_the_council");
+            default -> null;
+        };
+    }
+
+    @Override
+    public Target target(CaptureContext ctx, Target resolved) {
+        if (resolved != null && resolved.userId() != null && "owner_prefix".equals(resolved.resolvedBy())) return resolved;
+        Target s = AgendaSupport.speakerTarget(ctx.game(), "speaker");
+        return s == null ? resolved : s;
+    }
+
+    @Override
+    public String scope(CaptureContext ctx) {
+        return ctx.target() == null || ctx.target().userId() == null ? "table" : "player";
+    }
+}
