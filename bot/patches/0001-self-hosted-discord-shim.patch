@@ -0,0 +1,40 @@
+package ti4.selfhost.engine.kinds;
+
+import javax.annotation.Nullable;
+import ti4.selfhost.engine.KindSpec.CaptureContext;
+
+/**
+ * Federation of Sol: commander Claire Gibson (utilizeSolCommander_&lt;planet&gt;: place 1 infantry at the start of a
+ * ground combat; also Genesis Corps), Orbital Drop mech option (orbitalMechDrop_&lt;planet&gt;: pay 3 resources for a
+ * mech), breakthrough Bellum Gloriosum (solBtBuild_&lt;pos&gt;_...). Agent: generic exhaustAgent_solagent ids; Orbital
+ * Drop itself starts from the component-action menu (ability_orbitalDrop) and places through the generic
+ * place-unit prompt.
+ */
+public class FactionStepsSol implements FactionSteps {
+    private static final String F = "sol";
+
+    @Override
+    @Nullable
+    public Step step(String h, @Nullable CaptureContext ctx) {
+        if (h.startsWith("utilizeSolCommander_"))
+            return Step.leader(
+                    "solcommander", "utilizeSolCommander", "use", true,
+                    "planet", h.substring("utilizeSolCommander_".length()),
+                    "unit", "gf");
+        if (h.startsWith("orbitalMechDrop_"))
+            return Step.ability(
+                    "ability", "orbital_drop", F, "orbitalMechDrop", "use", true,
+                    "planet", FactionSteps.at(FactionSteps.args(h, "orbitalMechDrop_"), 0),
+                    "unit", "mf",
+                    "cost", 3);
+        if (h.startsWith("solBtBuild_")) {
+            // solBtBuild_<pos>_<limit>: produce up to <limit> (the produced ship's capacity) ground forces + fighters
+            java.util.List<String> a = FactionSteps.args(h, "solBtBuild_");
+            return Step.ability(
+                    "breakthrough", "solbt", F, "solBtBuild", "use", true,
+                    "tile", FactionSteps.at(a, 0),
+                    "count", FactionSteps.num(FactionSteps.at(a, 1)));
+        }
+        return null;
+    }
+}
