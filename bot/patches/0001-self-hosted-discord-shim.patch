+package ti4.selfhost.engine.kinds;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * Gain a technology: getTech_&lt;alias&gt;[__&lt;payment&gt;][__comp][__noPay]... (PlayerTechService.getTech). The setup
+ * "choose your starting technology" prompt is this kind with free=true in round 1 (value.starting).
+ */
+public class TechGainKind implements KindSpec {
+
+    @Override
+    public String kind() {
+        return "tech.gain";
+    }
+
+    @Override
+    public int priority() {
+        return 50;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return handlerId.startsWith("getTech_");
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        if (!matches(handlerId)) return null;
+        List<String> parts = new ArrayList<>(Arrays.asList(handlerId.substring("getTech_".length()).split("__")));
+        String tech = parts.removeFirst();
+        boolean free = parts.contains("noPay") || parts.contains("shareKnowledge");
+        Map<String, Object> v = new LinkedHashMap<>();
+        v.put("tech", tech);
+        v.put("free", free);
+        v.put("starting", free && ctx.game().getRound() <= 1 && !"action".equals(ctx.game().getPhaseOfGame()));
+        v.put("flags", parts);
+        return v;
+    }
+}
