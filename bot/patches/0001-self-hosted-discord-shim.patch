+package ti4.spring.api.selfhost;
+
+import java.util.List;
+
+/** JSON shapes for {@code GET /api/public/game/{gameName}/draft} (self-hosted web draft view). */
+public final class DraftViewModels {
+    private DraftViewModels() {}
+
+    /**
+     * @param system      "milty" (classic Milty draft, MiltyDraftManager) or "draft" (new DraftManager system, e.g. nucleus)
+     * @param status      "none" (no draft), "drafting", or "finished"
+     * @param version     changes whenever the game is saved; clients can skip re-render when unchanged
+     */
+    public record DraftView(
+            String game,
+            String system,
+            String status,
+            String phase,
+            long version,
+            String channelId,
+            List<DraftPlayer> players,
+            List<String> pickOrder,
+            int pickIndex,
+            String currentPlayer,
+            String nextPlayer,
+            List<SliceView> slices,
+            List<FactionView> factions,
+            List<OrderView> speakerOrder,
+            List<OrderView> seats,
+            List<CategoryView> otherCategories,
+            MapTemplateView mapTemplate,
+            Icons icons) {}
+
+    public record DraftPlayer(
+            String userId,
+            String name,
+            String color,
+            int draftPosition,
+            String faction,
+            String slice,
+            Integer speakerOrder,
+            Integer seat,
+            List<PickView> picks,
+            boolean current,
+            boolean next) {}
+
+    public record PickView(String type, String key, String label) {}
+
+    /**
+     * How to make a pick: press {@code customId} on message {@code messageId} in channel {@code channelId}.
+     * {@code messageId} is null when the button message couldn't be found (e.g. it was deleted).
+     */
+    public record ChoiceView(
+            String key, String label, String customId, String channelId, String messageId, String pickedBy) {}
+
+    public record SliceView(String name, List<TileView> tiles, SliceTotals totals, ChoiceView choice) {}
+
+    public record SliceTotals(
+            int resources,
+            int influence,
+            int optimalResources,
+            int optimalInfluence,
+            int optimalFlex,
+            int optimalTotal,
+            int planets,
+            int legendaries,
+            int anomalies,
+            List<String> techSkips,
+            List<String> wormholes) {}
+
+    public record TileView(
+            String id,
+            String name,
+            String tier,
+            String image,
+            int resources,
+            int influence,
+            List<String> wormholes,
+            List<String> anomalies,
+            List<PlanetView> planets) {}
+
+    public record PlanetView(
+            String id,
+            String name,
+            int resources,
+            int influence,
+            List<String> traits,
+            List<String> techSpecialties,
+            boolean legendary,
+            String legendaryAbility,
+            String legendaryText,
+            boolean station) {}
+
+    public record FactionView(
+            String alias,
+            String name,
+            String shortName,
+            String icon,
+            String source,
+            int commodities,
+            String complexity,
+            String homeSystem,
+            String homeSystemImage,
+            List<PlanetView> homePlanets,
+            List<String> abilities,
+            List<String> factionTech,
+            List<String> startingTech,
+            ChoiceView choice) {}
+
+    /** A numbered pick: speaker order position or seat. */
+    public record OrderView(int number, String label, String icon, ChoiceView choice) {}
+
+    public record CategoryView(String type, String label, List<ChoiceView> choices) {}
+
+    /**
+     * Template geometry in the bot's map pixel space (tile images are {@code tileWidth}x{@code tileHeight}).
+     * {@code sliceLayout[0]} is the home system; {@code sliceLayout[i+1]} is where slice tile {@code i} sits.
+     */
+    public record MapTemplateView(
+            String alias,
+            String description,
+            Integer playerCount,
+            int tileWidth,
+            int tileHeight,
+            List<Point> sliceLayout,
+            List<TemplatePosition> positions) {}
+
+    public record Point(int x, int y) {}
+
+    /** One hex on the galaxy. {@code tileId} is whatever the game map currently has there (draft fills it in). */
+    public record TemplatePosition(
+            String pos,
+            int x,
+            int y,
+            Integer playerNumber,
+            Integer miltyTileIndex,
+            boolean home,
+            String staticTileId,
+            String tileId,
+            String image) {}
+
+    /** Emoji image URLs (served by the shim) for common draft glyphs, keyed by name. */
+    public record Icons(java.util.Map<String, String> glyphs) {}
+}
