--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/CommoditiesKind.java
@@ -0,0 +1,51 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.List;
+import java.util.Map;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * Gain / convert commodities prompts outside exploration (Celdauri commander, Trade-style effects, combat
+ * rewards, action cards): gain_&lt;n&gt;_comms[_stay], convert_&lt;n&gt;_comms[_stay], gainComms_&lt;n&gt;[_stay],
+ * convertComms_&lt;n&gt;[_stay] (+ "Done"). The explore outcome kind keeps these ids when they sit on an explore
+ * message (higher priority).
+ *
+ * <p>value: {op: "gain" | "convert", amount, stay (the prompt stays after the press)} | {op: "done"}.
+ */
+public class CommoditiesKind implements KindSpec {
+    private static final Pattern A = Pattern.compile("^(gain|convert)_(\\d+)_comms(_stay)?$");
+    private static final Pattern B = Pattern.compile("^(gain|convert)Comms_(\\d+)(_stay)?$");
+
+    @Override
+    public String kind() {
+        return "commodities.gain";
+    }
+
+    @Override
+    public int priority() {
+        return 40;
+    }
+
+    @Override
+    public boolean classifies(List<String> handlerIds) {
+        for (String h : handlerIds) if (h != null && (A.matcher(h).matches() || B.matcher(h).matches())) return true;
+        return false;
+    }
+
+    @Override
+    public boolean matches(String h) {
+        return A.matcher(h).matches() || B.matcher(h).matches() || h.equals("deleteButtons");
+    }
+
+    @Override
+    public Map<String, Object> value(String h, CaptureContext ctx) {
+        if (h.equals("deleteButtons")) return SetupKindSupport.map("op", "done");
+        Matcher m = A.matcher(h);
+        if (!m.matches()) m = B.matcher(h);
+        if (!m.matches()) return null;
+        return SetupKindSupport.map(
+                "op", m.group(1), "amount", Integer.parseInt(m.group(2)), "stay", m.group(3) != null);
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/ComponentActionKind.java b/src/main/java/ti4/selfhost/engine/kinds/ComponentActionKind.java
new file mode 100644
index 0000000..f16e203
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/ComponentActionKind.java
@@ -0,0 +1,107 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+import ti4.image.Mapper;
+import ti4.model.LeaderModel;
+import ti4.model.PromissoryNoteModel;
+import ti4.model.TechnologyModel;
+import ti4.selfhost.engine.EngineModels.Target;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * The component action menu (GamePhaseButtonHandler.componentAction -> ComponentActionHelper.getAllPossibleCompButtons,
+ * an ephemeral reply to the acting player). Every entry is typed:
+ *
+ * <pre>
+ * componentActionRes_&lt;type&gt;_&lt;id&gt;   {component: type, id, name?}
+ *     type: leader (agent / hero / other leader), relic, pn, ability, generic, getRelic (purge fragments),
+ *           doStarCharts, doMutagens, doVolatileMutagenics, doTotalWarPoint, stellarAtomicsAction,
+ *           mercenariesForHireAction, absolMOW, exhaustBT (breakthrough), turnInBounty, ...
+ *     leader: + leaderType agent|commander|hero
+ * exhaustTech_&lt;tech&gt;                    {component:"tech", id, name}     (typed here, but does not classify alone:
+ *                                                                        combat / payment menus offer it too)
+ * mahactCommander / corefacilityAction / unlockPharadnCommander  {component:"ability", id}
+ * </pre>
+ *
+ * The Cancel button (deleteButtons) has value null.
+ */
+public class ComponentActionKind implements KindSpec {
+
+    private static final Pattern RES = Pattern.compile("componentActionRes_([A-Za-z]+)_?(.*)");
+
+    @Override
+    public String kind() {
+        return "component.action";
+    }
+
+    @Override
+    public int priority() {
+        return 40;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return handlerId.startsWith("componentActionRes_");
+    }
+
+    @Override
+    public boolean typesOption(String h) {
+        return matches(h)
+                || h.startsWith("exhaustTech_")
+                || h.equals("mahactCommander")
+                || h.equals("corefacilityAction")
+                || h.equals("unlockPharadnCommander");
+    }
+
+    @Override
+    public Map<String, Object> value(String h, CaptureContext ctx) {
+        Map<String, Object> v = new LinkedHashMap<>();
+        if (h.startsWith("exhaustTech_")) {
+            String tech = h.substring("exhaustTech_".length());
+            // c9b: exhaustTech_aida_discount = AI Development Algorithm used for its production discount
+            boolean discount = tech.endsWith("_discount");
+            if (discount) tech = tech.substring(0, tech.length() - "_discount".length());
+            v.put("component", "tech");
+            v.put("id", tech);
+            if (discount) v.put("use", "discount");
+            TechnologyModel t = Mapper.getTech(tech);
+            v.put("name", t == null ? tech : t.getName());
+            return v;
+        }
+        if (!h.startsWith("componentActionRes_")) {
+            v.put("component", "ability");
+            v.put("id", h);
+            return v;
+        }
+        Matcher m = RES.matcher(h);
+        if (!m.matches()) return null;
+        String type = m.group(1);
+        String id = m.group(2) == null || m.group(2).isEmpty() ? null : m.group(2);
+        if (id != null && id.endsWith("_")) id = id.substring(0, id.length() - 1);
+        if (id != null && id.isEmpty()) id = null;
+        v.put("component", type);
+        v.put("id", id);
+        switch (type) {
+            case "leader" -> {
+                LeaderModel lm = id == null ? null : Mapper.getLeader(id);
+                v.put("name", lm == null ? id : lm.getName());
+                v.put("leaderType", lm == null ? null : lm.getType());
+            }
+            case "relic" -> v.put("name", ExploreSupport.relic(id).get("relicName"));
+            case "pn" -> {
+                PromissoryNoteModel pn = id == null ? null : Mapper.getPromissoryNote(id);
+                v.put("name", pn == null ? id : pn.getName());
+            }
+            default -> {}
+        }
+        return v;
+    }
+
+    @Override
+    public Target target(CaptureContext ctx, Target resolved) {
+        return ExploreSupport.explorer(ctx, resolved);
+    }
+}
