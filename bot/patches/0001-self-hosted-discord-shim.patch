+package ti4.helpers;
+
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import lombok.experimental.UtilityClass;
+import net.dv8tion.jda.api.events.interaction.GenericInteractionCreateEvent;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.game.Tile;
+import ti4.game.UnitHolder;
+import ti4.helpers.Units.UnitKey;
+import ti4.helpers.Units.UnitType;
+import ti4.message.MessageHelper;
+import ti4.service.unit.DestroyUnitService;
+
+/**
+ * Board-state consequences printed on faction cards that the original bot never applied (rules audit, factions
+ * slice; deliberate improvements over the original):
+ *
+ * <ul>
+ *   <li>Floating Factory I/II (Clan of Saar space dock): "If this unit is blockaded, it is destroyed." — a Saar dock
+ *       in a space area with another (non-allied) player's ships and none of Saar's ships is destroyed.</li>
+ *   <li>Sundered (Crimson Rebellion): "Other players' units that move or are placed into your home system are
+ *       destroyed." — after a movement into the Crimson home system, the mover's units there are destroyed.</li>
+ * </ul>
+ */
+@UtilityClass
+public class FactionBoardRules {
+
+    private static final List<String> FLOATING_FACTORIES =
+            List.of("saar_spacedock", "saar_spacedock2", "absol_saar_spacedock", "absol_saar_spacedock2");
+
+    /** Destroys every blockaded Floating Factory on the board. Safe to call any time (no-op without Saar). */
+    public static void destroyBlockadedFloatingFactories(Game game, GenericInteractionCreateEvent event) {
+        if (game == null) return;
+        for (Player saar : game.getRealPlayers()) {
+            if (FLOATING_FACTORIES.stream().noneMatch(saar::hasUnit)) continue;
+            for (Tile tile : new ArrayList<>(game.getTileMap().values())) {
+                UnitHolder space = tile.getSpaceUnitHolder();
+                if (space == null) continue;
+                int docks = space.getUnitCount(UnitType.Spacedock, saar.getColor());
+                if (docks <= 0 || FoWHelper.playerHasActualShipsInSystem(saar, tile)) continue;
+                Player blockader = null;
+                for (Player p2 : game.getRealPlayersNNeutral()) {
+                    if (p2 == saar || saar.getAllianceMembers().contains(p2.getFaction())) continue;
+                    if (FoWHelper.playerHasActualShipsInSystem(p2, tile)) {
+                        blockader = p2;
+                        break;
+                    }
+                }
+                if (blockader == null) continue;
+                UnitKey key = Units.getUnitKey(UnitType.Spacedock, saar.getColorID());
+                DestroyUnitService.destroyUnit(event, tile, game, key, docks, space, false);
+                MessageHelper.sendMessageToChannel(
+                        saar.getCorrectChannel(),
+                        saar.getRepresentation() + ", your Floating Factory in "
+                                + tile.getRepresentationForButtons(game, saar) + " was blockaded by "
+                                + blockader.getRepresentationNoPing() + " and has been destroyed.");
+            }
+        }
+    }
+
+    /**
+     * Sundered: destroys {@code mover}'s units in {@code tile} when it is the home system of another player with the
+     * ability. Called after a movement into the active system.
+     */
+    public static void applySundered(Game game, Player mover, Tile tile, GenericInteractionCreateEvent event) {
+        if (game == null || mover == null || tile == null) return;
+        for (Player crimson : game.getRealPlayers()) {
+            if (crimson == mover
+                    || !crimson.hasAbility("sundered")
+                    || crimson.getAllianceMembers().contains(mover.getFaction())) continue;
+            Tile home = crimson.getHomeSystemTile();
+            if (home == null || !home.getPosition().equals(tile.getPosition())) continue;
+            Map<UnitHolder, Map<UnitKey, Integer>> doomed = new LinkedHashMap<>();
+            for (UnitHolder uh : tile.getUnitHolders().values()) {
+                for (UnitKey key : uh.getUnitKeys()) {
+                    if (!mover.unitBelongsToPlayer(key) || uh.getUnitCount(key) <= 0) continue;
+                    doomed.computeIfAbsent(uh, x -> new LinkedHashMap<>()).put(key, uh.getUnitCount(key));
+                }
+            }
+            if (doomed.isEmpty()) return;
+            for (Map.Entry<UnitHolder, Map<UnitKey, Integer>> e : doomed.entrySet()) {
+                for (Map.Entry<UnitKey, Integer> u : e.getValue().entrySet()) {
+                    DestroyUnitService.destroyUnit(event, tile, game, u.getKey(), u.getValue(), e.getKey(), false);
+                }
+            }
+            MessageHelper.sendMessageToChannel(
+                    mover.getCorrectChannel(),
+                    mover.getRepresentation() + ", your units that moved into "
+                            + tile.getRepresentationForButtons(game, mover) + " were destroyed by "
+                            + crimson.getRepresentationNoPing() + "'s **Sundered** ability.");
+            return;
+        }
+    }
+}
