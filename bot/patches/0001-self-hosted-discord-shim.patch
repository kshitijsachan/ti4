+package ti4.selfhost.engine;
+
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import javax.annotation.Nullable;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.helpers.Constants;
+import ti4.selfhost.engine.EngineModels.BreakthroughState;
+import ti4.selfhost.engine.EngineModels.ThundersEdgeState;
+import ti4.service.map.FractureService;
+
+/** The Thunder's Edge part of {@link EngineModels.GameState} (G10). Null for games without Thunder's Edge. */
+public final class ThundersEdgeStateBuilder {
+    private ThundersEdgeStateBuilder() {}
+
+    @Nullable
+    public static ThundersEdgeState build(Game game) {
+        try {
+            if (!game.isThundersEdge()) return null;
+            Map<String, String> expeditions = new LinkedHashMap<>(game.getExpeditions().getExpeditionFactions());
+            Map<String, List<BreakthroughState>> bts = new LinkedHashMap<>();
+            for (Player p : game.getRealPlayers()) {
+                if (p.getFaction() == null || p.getBreakthroughIDs().isEmpty()) continue;
+                List<BreakthroughState> list = new ArrayList<>();
+                for (String bt : p.getBreakthroughIDs()) {
+                    list.add(new BreakthroughState(
+                            bt,
+                            p.isBreakthroughUnlocked(bt),
+                            p.isBreakthroughExhausted(bt),
+                            p.isBreakthroughActive(bt),
+                            p.getBreakthroughTGs(bt)));
+                }
+                bts.put(p.getFaction(), list);
+            }
+            return new ThundersEdgeState(
+                    FractureService.isFractureInPlay(game),
+                    game.getTileFromPlanet(Constants.THUNDERSEDGE) != null,
+                    expeditions,
+                    bts);
+        } catch (Exception e) {
+            return null;
+        }
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/TradeActionController.java b/src/main/java/ti4/selfhost/engine/TradeActionController.java
new file mode 100644
index 0000000..6d4295a
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/TradeActionController.java
@@ -0,0 +1,67 @@
+package ti4.selfhost.engine;
+
+import java.util.Map;
+import org.springframework.http.CacheControl;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.security.access.prepost.PreAuthorize;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestHeader;
+import org.springframework.web.bind.annotation.RestController;
+import ti4.spring.api.selfhost.TradeModels.ProposeRequest;
+import ti4.spring.api.selfhost.TradeModels.TradeSide;
+import ti4.spring.context.RequestContext;
+import ti4.spring.context.SetupRequestContext;
+
+/**
+ * Typed action {@code trade.propose}: send a transaction offer (the receiver gets a {@code trade.offer} decision).
+ * Proposing again to the same player replaces the open offer (the bot only accepts the newest).
+ * <ul>
+ *   <li>{@code POST /api/public/selfhost/engine/{game}/actions/trade.propose} — Bot token, body
+ *   {@code {userId, to, give, receive, note}} (the shim, for autopilot seats)</li>
+ *   <li>{@code POST /api/game/{gameName}/engine/actions/trade.propose} — seat Bearer, body {@code {to, give, receive,
+ *   note}} (lock + save by the request interceptor)</li>
+ * </ul>
+ */
+@RestController
+public class TradeActionController {
+
+    public record ProposeBody(String userId, String to, TradeSide give, TradeSide receive, String note) {
+        ProposeRequest request() {
+            return new ProposeRequest(to, give, receive, note);
+        }
+    }
+
+    @PostMapping("/api/public/selfhost/engine/{game}/actions/trade.propose")
+    public ResponseEntity<?> proposeAs(
+            @PathVariable String game,
+            @RequestBody ProposeBody body,
+            @RequestHeader(value = "Authorization", required = false) String auth) {
+        if (!EngineController.trusted(auth))
+            return ResponseEntity.status(HttpStatus.UNAUTHORIZED).body(Map.of("error", "bot token required"));
+        if (body == null || body.userId() == null)
+            return ResponseEntity.badRequest().body(Map.of("error", "userId required"));
+        return respond(TradeEngine.propose(game, body.userId(), body.request()));
+    }
+
+    @PostMapping("/api/game/{gameName}/engine/actions/trade.propose")
+    @PreAuthorize("@security.canAccessGame(#gameName)")
+    // Same path as the bot route (own lock + save, then capture reads the saved game); no request-scoped copy.
+    @SetupRequestContext(false)
+    public ResponseEntity<?> propose(@PathVariable String gameName, @RequestBody ProposeBody body) {
+        return respond(TradeEngine.propose(gameName, RequestContext.getUserId(), body.request()));
+    }
+
+    private static ResponseEntity<?> respond(TradeEngine.ProposeResult r) {
+        HttpStatus status = switch (r.status()) {
+            case "done" -> HttpStatus.OK;
+            case "forbidden" -> HttpStatus.FORBIDDEN;
+            case "not_found" -> HttpStatus.NOT_FOUND;
+            case "error" -> HttpStatus.INTERNAL_SERVER_ERROR;
+            default -> HttpStatus.UNPROCESSABLE_ENTITY;
+        };
+        return ResponseEntity.status(status).cacheControl(CacheControl.noStore()).body(r);
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/TradeEngine.java b/src/main/java/ti4/selfhost/engine/TradeEngine.java
new file mode 100644
index 0000000..f9e2a0c
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/TradeEngine.java
@@ -0,0 +1,223 @@
+package ti4.selfhost.engine;
+
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.concurrent.ConcurrentHashMap;
+import javax.annotation.Nullable;
+import ti4.executors.ExecutionLockManager;
+import ti4.executors.ExecutionLockType;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.game.persistence.GameManager;
+import ti4.game.persistence.ManagedGame;
+import ti4.logging.BotLogger;
+import ti4.selfhost.engine.EngineModels.Decision;
+import ti4.selfhost.engine.EngineModels.Option;
+import ti4.spring.api.selfhost.TradeModels.ProposeRequest;
+import ti4.spring.api.selfhost.TradeModels.ProposeResponse;
+import ti4.spring.api.selfhost.TradeModels.TradeCounterparty;
+import ti4.spring.api.selfhost.TradeModels.TradeItem;
+import ti4.spring.api.selfhost.TradeModels.TradeOptions;
+import ti4.spring.api.selfhost.TradeModels.TradeSelf;
+import ti4.spring.api.selfhost.TradeService;
+
+/**
+ * Transactions in the engine API: the viewer's {@link TradeState} (part of {@link EngineModels.GameState}) and the
+ * typed {@code trade.propose} action. Offers themselves are bot transactions ({@link TradeService#propose} writes the
+ * transaction items and calls the bot's own sendOffer), answered through the {@code trade.offer} decision.
+ *
+ * <p>Rule (LRR 94): players transact only with neighbours, except in the agenda phase (anyone) and with an ability
+ * that lifts it (Hacan Guild Ships, Trade Convoys in play, both own a space station, Age of Commerce). The bot's own
+ * check is looser outside the action phase; {@link TradeState#mayTransactWith} is the strict one and
+ * {@code trade.propose} enforces it.
+ */
+public final class TradeEngine {
+    private TradeEngine() {}
+
+    private static final TradeService SERVICE = new TradeService();
+    private static final List<String> CONVOYS = List.of("convoys", "sigma_trade_convoys", "viability_trade_convoys");
+
+    /**
+     * The viewer's trade view.
+     *
+     * @param blockedReason     non-null when the viewer cannot propose anything now (fog of war, old transaction
+     *                          model, Hidden Agenda in the agenda phase, Policy - The People: Control)
+     * @param me                what the viewer could put into an offer (own PNs / action cards: private)
+     * @param partners          every other player: public counts, requestable PNs, the bot's {@code canTrade}
+     * @param mayTransactWith   factions the viewer may transact with now under the strict neighbour rule
+     * @param incoming          open, current offers to the viewer (answer via the trade.offer decision)
+     * @param outgoing          open, current offers from the viewer
+     */
+    public record TradeState(
+            String phase,
+            String blockedReason,
+            boolean newTransactionModel,
+            TradeSelf me,
+            List<TradeCounterparty> partners,
+            List<String> mayTransactWith,
+            List<OpenOffer> incoming,
+            List<OpenOffer> outgoing) {}
+
+    /** decisionId: the receiver's trade.offer decision (private to them). */
+    public record OpenOffer(String from, String to, int offerNumber, List<TradeItem> items, String decisionId) {}
+
+    public record ProposeResult(
+            boolean ok,
+            String status,
+            String error,
+            Integer offerNumber,
+            String to,
+            List<TradeItem> items,
+            long seq,
+            long stateVersion) {}
+
+    private record Cached(long version, TradeOptions options, List<String> may) {}
+
+    /** (game|viewer) → options at a state version: neighbour checks are not cheap and /state is read often. */
+    private static final Map<String, Cached> cache = new ConcurrentHashMap<>();
+
+    // ------------------------------------------------------------------ state
+
+    @Nullable
+    public static TradeState state(Game game, @Nullable String viewerUserId) {
+        if (viewerUserId == null) return null;
+        Player me = game.getPlayer(viewerUserId);
+        if (me == null || !me.isRealPlayer()) return null;
+        try {
+            String key = game.getName() + "|" + viewerUserId;
+            Cached c = cache.get(key);
+            if (c == null || c.version() != game.getLastModifiedDate()) {
+                TradeOptions o = SERVICE.options(game, me);
+                List<String> may = new ArrayList<>();
+                for (TradeCounterparty cp : o.counterparties()) {
+                    Player p = game.getPlayerFromColorOrFaction(cp.faction());
+                    if (p != null && cp.canTrade() && (cp.neighbor() || ruleExempt(game, me, p))) may.add(cp.faction());
+                }
+                c = new Cached(game.getLastModifiedDate(), o, may);
+                cache.put(key, c);
+            }
+            List<OpenOffer> in = new ArrayList<>();
+            List<OpenOffer> out = new ArrayList<>();
+            for (OpenOffer offer : openOffers(game)) {
+                if (offer.to().equals(me.getFaction())) in.add(offer);
+                if (offer.from().equals(me.getFaction())) out.add(offer);
+            }
+            TradeOptions o = c.options();
+            return new TradeState(
+                    game.getPhaseOfGame(),
+                    o.blockedReason(),
+                    o.newTransactionModel(),
+                    o.me(),
+                    o.counterparties(),
+                    c.may(),
+                    in,
+                    out);
+        } catch (Exception e) {
+            BotLogger.error("engine: trade state for " + game.getName() + " failed", e);
+            return null;
+        }
+    }
+
+    /** Neighbour rule exceptions (LRR 94 + the abilities the bot knows). */
+    static boolean ruleExempt(Game game, Player a, Player b) {
+        String phase = game.getPhaseOfGame() == null ? "" : game.getPhaseOfGame().toLowerCase(Locale.ROOT);
+        if (phase.contains("agenda")) return true;
+        if (game.isAgeOfCommerceMode()) return true;
+        if (a.hasSpaceStation() && b.hasSpaceStation()) return true;
+        for (Player p : List.of(a, b)) {
+            if (p.hasAbility("guild_ships")) return true;
+            for (String pn : CONVOYS) if (p.getPromissoryNotesInPlayArea().contains(pn)) return true;
+        }
+        return false;
+    }
+
+    /** Current offers with an open trade.offer decision, newest per sender → receiver pair. */
+    static List<OpenOffer> openOffers(Game game) {
+        Map<String, OpenOffer> byPair = new LinkedHashMap<>();
+        for (Decision d : DecisionRegistry.openDecisions(game.getName())) {
+            if (!"trade.offer".equals(d.kind()) || d.target() == null) continue;
+            Map<String, Object> v = null;
+            for (Option o : d.options()) if (o.value() != null && "accept".equals(o.value().get("action"))) v = o.value();
+            if (v == null) continue;
+            Player from = game.getPlayerFromColorOrFaction(String.valueOf(v.get("from")));
+            Player to = d.target().userId() == null ? null : game.getPlayer(d.target().userId());
+            Integer n = v.get("offerNumber") instanceof Integer i ? i : null;
+            if (from == null || to == null || !isCurrent(game, from, to, n)) continue;
+            byPair.put(from.getFaction() + ">" + to.getFaction(),
+                    new OpenOffer(from.getFaction(), to.getFaction(), n == null ? latest(game, from, to) : n,
+                            items(game, from, to), d.id()));
+        }
+        return new ArrayList<>(byPair.values());
+    }
+
+    /** The sender's transaction items with the receiver, decoded (empty once accepted or rescinded). */
+    public static List<TradeItem> items(Game game, Player from, Player to) {
+        return TradeService.decode(game, from.getTransactionItemsWithPlayer(to));
+    }
+
+    /** The bot accepts only the newest offer from a sender, and only while its items are still there. */
+    public static boolean isCurrent(Game game, Player from, Player to, @Nullable Integer offerNumber) {
+        if (from.getTransactionItemsWithPlayer(to).isEmpty()) return false;
+        return offerNumber == null || offerNumber == latest(game, from, to);
+    }
+
+    private static int latest(Game game, Player from, Player to) {
+        try {
+            return Integer.parseInt(game.getStoredValue("offerFrom" + from.getFaction() + "To" + to.getFaction()));
+        } catch (NumberFormatException e) {
+            return -1;
+        }
+    }
+
+    // ------------------------------------------------------------------ action: trade.propose
+
+    /**
+     * Proposes an offer as {@code userId}: takes the game's write lock, enforces the strict neighbour rule, writes the
+     * transaction and sends it (receiver gets a trade.offer decision), saves.
+     */
+    public static ProposeResult propose(String gameName, String userId, ProposeRequest req) {
+        ManagedGame mg = GameManager.isValid(gameName) ? GameManager.getManagedGame(gameName) : null;
+        if (mg == null || mg.getGame() == null) return fail("not_found", "No such game.");
+        ExecutionLockManager.lock(gameName, ExecutionLockType.WRITE);
+        try {
+            Game game = mg.getGame();
+            Player me = game.getPlayer(userId);
+            if (me == null || !me.isRealPlayer()) return fail("forbidden", "You are not a player of this game.");
+            ProposeResult r = proposeLocked(game, me, req);
+            if (r.ok()) GameManager.save(game, me.getUserName() + " proposed a transaction (engine)");
+            return r.ok()
+                    ? new ProposeResult(true, "done", null, r.offerNumber(), r.to(), r.items(),
+                            DecisionRegistry.currentSeq(), game.getLastModifiedDate())
+                    : r;
+        } finally {
+            ExecutionLockManager.unlock(gameName, ExecutionLockType.WRITE);
+        }
+    }
+
+    /** Caller holds the game's write lock and saves afterwards. */
+    public static ProposeResult proposeLocked(Game game, Player me, ProposeRequest req) {
+        if (req == null || req.to() == null || req.to().isBlank()) return fail("refused", "Missing 'to'.");
+        Player them = game.getPlayerFromColorOrFaction(req.to().toLowerCase(Locale.ROOT));
+        if (them == null) them = game.getPlayer(req.to());
+        if (them == null || them == me || !them.isRealPlayer()) return fail("refused", "Unknown trade partner: " + req.to());
+        if (!me.isNeighboursWith(them) && !ruleExempt(game, me, them))
+            return fail("refused", "You may only transact with neighbours outside the agenda phase.");
+        try {
+            ProposeResponse res = SERVICE.propose(game, me, req);
+            return new ProposeResult(true, "done", null, res.offerNumber(), res.to(), res.items(),
+                    DecisionRegistry.currentSeq(), game.getLastModifiedDate());
+        } catch (TradeService.TradeException e) {
+            return fail("refused", e.getMessage());
+        } catch (Exception e) {
+            BotLogger.error("engine: trade.propose in " + game.getName() + " failed", e);
+            return fail("error", String.valueOf(e.getMessage()));
+        }
+    }
+
+    private static ProposeResult fail(String status, String error) {
+        return new ProposeResult(false, status, error, null, null, List.of(), DecisionRegistry.currentSeq(), 0);
+    }
+}
