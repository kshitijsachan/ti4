+package ti4.selfhost.engine.kinds;
+
+import java.util.List;
+import java.util.Map;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.selfhost.engine.EngineModels.Decision;
+import ti4.selfhost.engine.KindSpec;
+import ti4.selfhost.engine.SetupStateBuilder;
+
+/**
+ * Keleres starting technologies: FFCC_keleres*_getKeleresTechOptions. Keleres chooses two technologies other players
+ * own, so the options it is offered are computed when it presses. Pressed before every other player chose their
+ * starting technologies, Keleres would be offered too little (or nothing) and the button is gone. validate therefore
+ * refuses until nobody else is still choosing. value: {waitingOn: user ids still choosing at capture time} — read the
+ * live answer from GameState.setup.
+ */
+public class KeleresTechOptionsKind implements KindSpec {
+
+    @Override
+    public String kind() {
+        return "setup.keleres_tech";
+    }
+
+    @Override
+    public int priority() {
+        return 100;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return "getKeleresTechOptions".equals(handlerId);
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        if (!matches(handlerId)) return null;
+        Player p = ctx.target() == null ? null : ctx.game().getPlayer(ctx.target().userId());
+        List<String> waiting = SetupStateBuilder.othersChoosingStartingTech(ctx.game(), p);
+        return SetupKindSupport.map("waitingOn", waiting);
+    }
+
+    @Override
+    public String validate(Game game, Player answering, Decision decision, String optionId) {
+        if (!matches(SetupKindSupport.handlerOf(decision, optionId))) return null;
+        List<String> waiting = SetupStateBuilder.othersChoosingStartingTech(game, answering);
+        if (waiting.isEmpty()) return null;
+        return "Wait until every other player has chosen their starting technologies (" + waiting.size()
+                + " still choosing): Keleres chooses from theirs.";
+    }
+
+    /** Setup: faction / colour are picked after capture; re-resolve the target on every state change. */
+    @Override
+    public boolean dynamic() {
+        return true;
+    }
+
+    @Override
+    public ti4.selfhost.engine.EngineModels.Target target(
+            CaptureContext ctx, ti4.selfhost.engine.EngineModels.Target resolved) {
+        return SetupKindSupport.refresh(ctx, resolved);
+    }
+
+    /** Past setup this prompt is a leftover nobody needs (live: hundreds open across games, flooding the web queue). */
+    @Override
+    public boolean obsolete(CaptureContext ctx) {
+        return ti4.selfhost.engine.SetupStateBuilder.pastSetup(ctx.game());
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/MiltyDraftInfoKind.java b/src/main/java/ti4/selfhost/engine/kinds/MiltyDraftInfoKind.java
new file mode 100644
