+            "resolveExplorationRiderStep2_", "resolveHiddenInitiativesNoSwap", "resolveHiddenInitiativesStep2_",
+            "resolveHiddenInitiativesStep3_", "resolveIncubate_", "resolveInitiativeOutpost",
+            "resolveLostTreatiseFleet", "resolveLostTreatiseRedistribute", "resolveMarketOutpost_",
+            "resolveNokarBt_", "resolveOvertimeStep2_", "resolveParleyStep2", "resolvePirateContract_",
+            "resolvePirateFleet_", "resolveProjectRiderReward", "resolveRaze_", "resolveReverseTF",
+            "resolveReverse_", "resolveRiposte_", "resolveShrapnelTurrets_", "resolveTeMercenaryContract_",
+            "resolveTheodisiOutpost_", "resolveTkAmalgamate", "resolveTkBestow", "resolveTkCommission_",
+            "resolveTkConscript_", "resolveTkContract_", "resolveTwin_", "retrofitShip_",
+            "sacrificeIngressFrom_", "sacrificePlanet_", "sacrificeReward_", "scorchedEarthDestroy_",
+            "scorchedEarthDone_", "scorchedEarthPlanet_", "scuttleIn_", "scuttleOn_", "seizeArtifactStep3_",
+            "seizedResearchBreakthrough", "seizedResearchPlanet_", "seizedResearchSpecialty_",
+            "settlementsPlaceOn_", "settlersChoose_", "settlersConsent_", "settlersDestroy_",
+            "simulacrumToggleAgent_", "spatialCollapseStep2_", "spatialCollapseStep3_", "starFlareStep2_",
+            "starFlareTKStep2_", "startOrdain", "startRescue", "startThwart", "startToLuckyShotAUnit_",
+            "startToScuttleAUnit_", "stasisHaulComm", "stasisHaulShip_", "strategize", "surveyDiscardOptions_",
+            "surveyResolveDiscard_", "surveyResolveRevealed_", "surveySelect_", "syndicateAssign_",
+            "tacticalRetreatCargo_", "tacticalRetreatDestination_", "tacticalRetreatMoveTo_",
+            "tacticalRetreatShip_", "teMercenaryContract_", "tkCommission_", "tkInitiate_",
+            "transferSingularity", "transposeStep2", "transposeStep3", "transposeStep4",
+            "unexpectedSomeoneElse", "unravelStep2", "unravelStep3");
+
+    /**
+     * Finish/cancel steps: a leading verb (endScuttle, cancelTacticalRetreat) or a camel-case word
+     * (defectorsShipsDone, resolveHiddenInitiativesNoSwap). Case-sensitive on purpose: a case-insensitive
+     * "end[A-Z]" / "done" also hit amendmentChooseObjective, espionageSendPN and ordainDiscardOne.
+     */
+    static final java.util.regex.Pattern DONE_STEP = java.util.regex.Pattern.compile(
+            "(?:end|finish|cancel|decline|done|noswap)(?:[A-Z0-9].*)?|.*(?:Done|Finish|Cancel|Decline|NoSwap|Noswap)(?:[A-Z0-9].*)?");
+
+    @Override
+    public String kind() {
+        return "action_card.step";
+    }
+
+    @Override
+    public int priority() {
+        return 58;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        // The first "Resolve X" button of a card is action_card.resolve even when the step list names it too.
+        return step(handlerId) != null && CardSteps.resolveKey(handlerId) == null;
+    }
+
+    /** The STEPS entry this handler id belongs to: exact, a '_'-ending prefix, or a bare name followed by '_'/'@'. */
+    static String step(String handlerId) {
+        if (STEPS.contains(handlerId)) return handlerId;
+        String found = null;
+        for (int i = 0; i < handlerId.length(); i++) {
+            char c = handlerId.charAt(i);
+            if (c != '_' && c != '@') continue;
+            String head = handlerId.substring(0, i + 1);
+            if (STEPS.contains(head)) found = head; // longest registered prefix wins, like HandlerRegistry
+            else if (STEPS.contains(handlerId.substring(0, i))) found = handlerId.substring(0, i);
+        }
+        return found;
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        String step = step(handlerId);
+        if (step == null) return null;
+        Map<String, Object> v = new LinkedHashMap<>();
+        String name = step.replaceAll("[_@]+$", "");
+        v.put("step", name);
+        v.put("actionCard", CardSteps.cardFor(ctx.game(), name));
+        v.put("role", DONE_STEP.matcher(name).matches() ? "done" : "choose");
+        String rest = handlerId.substring(Math.min(handlerId.length(), step.length()));
+        if (rest.startsWith("_") || rest.startsWith("@")) rest = rest.substring(1);
+        CardSteps.typeTokens(ctx.game(), rest.replace('@', '_'), v);
+        return v;
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/ActionCardTargetKind.java b/src/main/java/ti4/selfhost/engine/kinds/ActionCardTargetKind.java
new file mode 100644
index 0000000..cc2d0a3
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/ActionCardTargetKind.java
@@ -0,0 +1,105 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+import java.util.Set;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.image.Mapper;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * The target steps of base/PoK/Codex action cards after "Resolve X" (ButtonHelperActionCards): choose a player
+ * (plagueStep2_&lt;faction&gt;), a planet (plagueStep3_&lt;faction&gt;_&lt;planet&gt;), a system (probeStep2_&lt;pos&gt;),
+ * a strategy card (psStep2_&lt;n&gt;). Only the listed step prefixes are ours, and every id token is checked against the
+ * game before it is typed (a token that is no player / planet / system leaves the option untyped).
+ *
+ * <p>Value: {step, player?, planet?, system?, holder?, strategyCard?}. step = the handler prefix without the
+ * trailing '_' (identifies the card and step); player = faction, planet = planet id, system = tile position,
+ * holder = "space" for space-area targets; actionCard (C7) = the card being resolved (CardSteps.cardFor).
+ */
+public class ActionCardTargetKind implements KindSpec {
+
+    static final Set<String> STEPS = Set.of(
+            "absStep2_", "assRepsStep2_", "bountyStep2_", "crippleStep2_", "crippleStep3_", "decoyOperationStep2_",
+            "diplomaticPressureStep2_", "forwardSupplyBaseStep2_", "ghostShipStep2_", "heistStep2_",
+            "infiltrateStep2_", "infiltrateStep3_", "insubStep2_", "micrometeoroidStormStep2_",
+            "micrometeoroidStormStep3_", "plagueStep2_", "plagueStep3_", "probeStep2_", "psStep2_",
+            "psionicHammerStep2_", "psionicHammerStep3_", "reactorMeltdownStep2_", "reactorMeltdownStep3_",
+            "reconstructionStep2_", "reconstructionStep3_", "reparationsStep2_", "reparationsStep3_",
+            "resolveBetrayalStep2_", "resolveBlackMarketRaidStep2_", "resolveCacheStep2_", "resolveCorruptionStep2_",
+            "resolveDecoyOperationStep1_", "resolveEBSStep1_", "resolveFreedomFightersStep2_",
+            "resolveLiberationStep2_", "resolveParleyStep2_", "resolveRefugeesStep2_", "resolveRefugeesStep3_",
+            "salvageStep2_", "seizeArtifactStep2_", "signalJammingStep2_", "signalJammingStep3_",
+            "signalJammingStep4_", "spyStep2_", "spyStep3_", "strandedShipStep2_", "tacticalBombardmentStep2_",
+            "unexpectedSomeoneElseStep2_", "unstableStep2_", "unstableStep3_", "uprisingStep2_", "uprisingStep3_",
+            "resolveBlitz_", "resolveEmergencyRepairs_", "resolveUpgrade_");
+
+    /** Steps whose id tokens are planets / unit holders (ButtonHelperActionCards builds them from planet names). */
+    static final Set<String> PLANET_STEPS = Set.of(
+            "decoyOperationStep2_", "reconstructionStep2_", "reconstructionStep3_", "resolveCacheStep2_",
+            "resolveFreedomFightersStep2_", "resolveLiberationStep2_", "resolveParleyStep2_");
+
+    @Override
+    public String kind() {
+        return "action_card.target";
+    }
+
+    @Override
+    public int priority() {
+        return 60;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return step(handlerId) != null;
+    }
+
+    private static String step(String handlerId) {
+        int us = handlerId.indexOf('_');
+        if (us < 0) return null;
+        String head = handlerId.substring(0, us + 1);
+        return STEPS.contains(head) ? head : null;
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        String step = step(handlerId);
+        if (step == null) return null;
+        Game game = ctx.game();
+        Map<String, Object> v = new LinkedHashMap<>();
+        v.put("step", step.substring(0, step.length() - 1));
+        String rest = handlerId.substring(step.length());
+        boolean typed = false;
+        for (String tok : rest.split("_")) {
+            if (tok.isEmpty()) continue;
+            if ("psStep2_".equals(step)) {
+                int sc = CardKinds.parseInt(tok, -1);
+                if (sc >= 0 && game.getSCList().contains(sc)) {
+                    v.put("strategyCard", sc);
+                    typed = true;
+                }
+                continue;
+            }
+            if ("space".equals(tok)) {
+                v.put("holder", "space");
+                continue;
+            }
+            boolean planetTok = game.getPlanetsInfo().containsKey(tok) || Mapper.isValidPlanet(tok);
+            // Planet ids that are also faction ids (muaat, winnu, ...): these steps carry a planet, not a player.
+            Player p = planetTok && PLANET_STEPS.contains(step) ? null : game.getPlayerFromColorOrFaction(tok);
+            if (p != null && !v.containsKey("player")) {
+                v.put("player", p.getFaction());
+                typed = true;
+            } else if (planetTok) {
+                v.put("planet", tok);
+                typed = true;
+            } else if (game.getTileByPosition(tok) != null) {
+                v.put("system", tok);
+                typed = true;
+            }
+        }
+        if (typed) v.put("actionCard", CardSteps.cardFor(game, step.substring(0, step.length() - 1)));
+        return typed ? v : null;
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/Affordability.java b/src/main/java/ti4/selfhost/engine/kinds/Affordability.java
new file mode 100644
index 0000000..ddfae36
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/Affordability.java
@@ -0,0 +1,87 @@
+package ti4.selfhost.engine.kinds;
+
+import javax.annotation.Nullable;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.game.Tile;
+import ti4.helpers.AliasHandler;
+import ti4.helpers.ButtonHelper;
+import ti4.helpers.Constants;
+import ti4.helpers.ExploreHelper;
+import ti4.game.Planet;
+import ti4.selfhost.engine.KindSpec.CaptureContext;
+
+/**
+ * Rules audit (tech / relic / explore): can the player pay an option's cost right now? A costed option carries
+ * value.unavailable = the reason it cannot be chosen (null when it can); the kind's validate() refuses it and the web
+ * shows it greyed out with that reason. Re-read on every state change (dynamicValues), so an option enables as soon
+ * as the resource arrives. Deliberate improvement over the original code, whose buttons were pressable regardless.
+ */
+final class Affordability {
+    private Affordability() {}
+
+    static final String NEED_COMM_OR_TG = "Need 1 trade good or commodity";
+    static final String NO_MECH_IN_REINFORCEMENTS = "No mechs in reinforcements";
+
+    /** The player the option is for: the capture's player, else the decision's target. */
+    @Nullable
+    static Player player(CaptureContext ctx) {
+        if (ctx.player() != null) return ctx.player();
+        if (ctx.target() != null && ctx.target().userId() != null && ctx.game() != null)
+            return ctx.game().getPlayer(ctx.target().userId());
+        return null;
+    }
+
+    @Nullable
+    static String commodityOrTg(@Nullable Player p) {
+        if (p == null) return null;
+        return p.getCommodities() + p.getTg() >= 1 ? null : NEED_COMM_OR_TG;
+    }
+
+    static boolean mechInReinforcements(Game game, Player p) {
+        int cap = p.getUnitCap("mech");
+        if (cap <= 0) return true; // unknown cap: do not block
+        return ButtonHelper.getNumberOfUnitsOnTheBoard(game, p, "mech") < cap;
+    }
+
+    static boolean hasDmz(Game game, String planet) {
+        Planet uh = game.getUnitHolderFromPlanet(planet);
+        return uh != null && uh.getTokenList().stream().anyMatch(t -> t.contains(Constants.DMZ_LARGE));
+    }
+
+    /** Local Fabricators: 1 commodity or trade good, a mech in reinforcements, and a planet units may be placed on. */
+    @Nullable
+    static String localFabricators(Game game, @Nullable Player p, String planet) {
+        if (p == null) return null;
+        String pay = commodityOrTg(p);
+        if (pay != null) return pay;
+        if (!mechInReinforcements(game, p)) return NO_MECH_IN_REINFORCEMENTS;
+        if (hasDmz(game, planet)) return "Demilitarized Zone: units cannot be placed on this planet";
+        return null;
+    }
+
+    /** Hazardous explores: "if you have at least 1 mech on this planet, or if you remove 1 infantry from it". */
+    @Nullable
+    static String unitOnPlanet(Game game, @Nullable Player p, String planet, boolean mech) {
+        if (p == null || planet == null) return null;
+        try {
+            Tile tile = game.getTile(AliasHandler.resolveTile(planet));
+            if (tile == null || tile.getUnitHolders().get(planet) == null) return null;
+            boolean ok = mech ? ExploreHelper.checkForMech(planet, game, p) : ExploreHelper.checkForInf(planet, game, p);
+            if (ok) return null;
+        } catch (Exception e) {
+            return null;
+        }
+        return mech ? "No mech of yours on this planet" : "No infantry of yours on this planet";
+    }
+
+    /** Same as ButtonHelper.controlsTombOfEmphidia (kept here so the engine compiles against older bot classes). */
+    static boolean controlsTombOfEmphidia(Game game, Player p) {
+        for (String pl : p.getPlanets()) {
+            Planet uh = game.getUnitHolderFromPlanet(pl);
+            if (uh != null && uh.getTokenList() != null && uh.getTokenList().contains("attachment_tombofemphidia.png"))
+                return true;
+        }
+        return false;
+    }
+}
