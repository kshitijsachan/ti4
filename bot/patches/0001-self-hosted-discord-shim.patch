+package ti4.selfhost.engine.kinds;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * Pre-decide following a strategy card before it is played (ButtonHelperSCs.preDeclineSC /
+ * getPreDeclineSCButtons): preDeclineSC_&lt;sc&gt;_yes (don't follow it when it is played), preDeclineSC_&lt;sc&gt;_no
+ * (decide later), getPreDeclineSCButtons_&lt;sc&gt; (undo the decision). Posted to the player (cards-info thread).
+ *
+ * <p>value: {strategyCard, action: "pre_decline" | "decide_later" | "undo"}.
+ */
+public class StrategyCardPreDeclineKind implements KindSpec {
+
+    @Override
+    public String kind() {
+        return "strategy_card.pre_decline";
+    }
+
+    @Override
+    public int priority() {
+        return 80;
+    }
+
+    @Override
+    public boolean matches(String h) {
+        return h.matches("preDeclineSC_\\d+_(yes|no)") || h.matches("getPreDeclineSCButtons_\\d+");
+    }
+
+    @Override
+    public Map<String, Object> value(String h, CaptureContext ctx) {
+        if (!matches(h)) return null;
+        String[] p = h.split("_");
+        Map<String, Object> v = new LinkedHashMap<>();
+        v.put("strategyCard", Integer.parseInt(p[1]));
+        v.put("action", h.startsWith("get") ? "undo" : "yes".equals(p[2]) ? "pre_decline" : "decide_later");
+        return v;
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/StrategyCardQueuePickKind.java b/src/main/java/ti4/selfhost/engine/kinds/StrategyCardQueuePickKind.java
new file mode 100644
