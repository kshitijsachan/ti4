@@ -0,0 +1,78 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+import ti4.game.Game;
+import ti4.game.Planet;
+import ti4.game.Player;
+import ti4.game.Tile;
+import ti4.helpers.ButtonHelperModifyUnits;
+import ti4.helpers.Units.UnitType;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * Construction (primary or secondary): the planet to put the structure on, after construction_&lt;unit&gt; on the card's
+ * message: place_&lt;pds|spacedock&gt;_&lt;planet&gt;~construction (ephemeral to the presser). One structure per prompt — the holder's
+ * primary is two prompts (space dock or PDS, then a PDS): see strategy_card.resolve primaryParts.
+ * value: {unit, planet, tile, home, resources, influence, pds, spaceDock} (pds/spaceDock: already on that planet).
+ *
+ * <p>Priority 110: above the production kind's generic place_ (production prompts never offer PDS / space docks).
+ */
+public class ConstructionPlaceKind implements KindSpec {
+
+    @Override
+    public String kind() {
+        return "strategy_card.construction_place";
+    }
+
+    @Override
+    public int priority() {
+        return 110;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return handlerId.matches(
+                "place_(pds|spacedock)_[^_~]+(" + ButtonHelperModifyUnits.CONSTRUCTION_PLACEMENT + ")?");
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        String id = handlerId.endsWith(ButtonHelperModifyUnits.CONSTRUCTION_PLACEMENT)
+                ? handlerId.substring(0, handlerId.length() - ButtonHelperModifyUnits.CONSTRUCTION_PLACEMENT.length())
+                : handlerId;
+        String rest = id.substring("place_".length());
+        int us = rest.indexOf('_');
+        String unit = rest.substring(0, us);
+        String planet = rest.substring(us + 1);
+        Game game = ctx.game();
+        Planet p = game.getUnitHolderFromPlanet(planet);
+        Tile tile = game.getTileFromPlanet(planet);
+        Player me = ctx.player();
+        Map<String, Object> v = new LinkedHashMap<>();
+        v.put("unit", unit);
+        v.put("planet", planet);
+        v.put("tile", tile == null ? null : tile.getPosition());
+        v.put("home", tile != null && me != null && tile == me.getHomeSystemTile());
+        v.put("resources", p == null ? 0 : p.getResources());
+        v.put("influence", p == null ? 0 : p.getInfluence());
+        v.put("pds", p == null || me == null ? 0 : p.getUnitCount(UnitType.Pds, me));
+        v.put("spaceDock", p == null || me == null ? 0 : p.getUnitCount(UnitType.Spacedock, me));
+        return v;
+    }
+
+    /** Structure limits on a Construction placement (2 PDS / 1 space dock per planet): see constructionStructureLimit. */
+    @Override
+    public String validate(Game game, Player answering, ti4.selfhost.engine.EngineModels.Decision decision, String optionId) {
+        String h = StatusScoreKind.handlerOf(decision, optionId);
+        if (h == null || !h.endsWith(ButtonHelperModifyUnits.CONSTRUCTION_PLACEMENT) || !matches(h)) return null;
+        String rest = h.substring("place_".length(), h.length() - ButtonHelperModifyUnits.CONSTRUCTION_PLACEMENT.length());
+        int us = rest.indexOf('_');
+        return ButtonHelperModifyUnits.constructionStructureLimit(game, answering, rest.substring(0, us), rest.substring(us + 1));
+    }
+
+    @Override
+    public String scope(CaptureContext ctx) {
+        return "player";
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/DealSecretsKind.java b/src/main/java/ti4/selfhost/engine/kinds/DealSecretsKind.java
new file mode 100644
index 0000000..fc104fc
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/DealSecretsKind.java
@@ -0,0 +1,72 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.Map;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.selfhost.engine.EngineModels.Decision;
+import ti4.selfhost.engine.EngineModels.SetupState;
+import ti4.selfhost.engine.EngineModels.Target;
+import ti4.selfhost.engine.KindSpec;
+import ti4.selfhost.engine.SetupStateBuilder;
+
+/**
+ * Table step "Deal 2 Secret Objectives To All" (deal2SOToAll, main channel, anyone may press). The handler refuses a
+ * first early press but lets a second one through ("press again to proceed anyway"), and it may be posted more than
+ * once (again after Keleres sets up): validate refuses while any player is still setting up and once secrets were
+ * dealt, so through the engine it deals exactly once, and only when the table is ready. value: {}.
+ */
+public class DealSecretsKind implements KindSpec {
+
+    @Override
+    public String kind() {
+        return "setup.deal_secrets";
+    }
+
+    @Override
+    public int priority() {
+        return 100;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return "deal2SOToAll".equals(handlerId);
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        return matches(handlerId) ? SetupKindSupport.map() : null;
+    }
+
+    @Override
+    public Target target(CaptureContext ctx, Target resolved) {
+        return null;
+    }
+
+    @Override
+    public String scope(CaptureContext ctx) {
+        return "table";
+    }
+
+    @Override
+    public String validate(Game game, Player answering, Decision decision, String optionId) {
+        if (!matches(SetupKindSupport.handlerOf(decision, optionId))) return null;
+        if (SetupStateBuilder.secretsDealt(game)) return "Secret objectives have already been dealt.";
+        SetupState s = SetupStateBuilder.build(game);
+        if (s == null) return null;
+        // Fail open when we cannot name anyone still choosing (the handler validates again).
+        if (!"deal_secrets".equals(s.stage()) && !s.waitingOn().isEmpty())
+            return "Not every player is set up yet (" + s.waitingOn().size() + " still choosing).";
+        return null;
+    }
+
+    @Override
+    public boolean dynamic() {
+        return true;
+    }
+
+    /** Past setup this prompt is a leftover nobody needs (live: hundreds open across games, flooding the web queue). */
+    @Override
+    public boolean obsolete(CaptureContext ctx) {
+        return ti4.selfhost.engine.SetupStateBuilder.pastSetup(ctx.game());
+    }
+}
