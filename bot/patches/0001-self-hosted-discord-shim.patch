+++ b/src/main/java/ti4/selfhost/engine/kinds/FactionStepsLeaders.java
@@ -0,0 +1,36 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.List;
+import javax.annotation.Nullable;
+import ti4.selfhost.engine.KindSpec.CaptureContext;
+
+/**
+ * Generic leader ids shared by every faction (leader.use): exhaustAgent_&lt;agent&gt;[_&lt;arg&gt;...] (ButtonHelperAgents
+ * .exhaustAgent: exhaust the agent; a first arg naming a seated player is its target) and
+ * getAgentSelection_&lt;agent&gt; (FactionMiscButtonHandler: use the agent, then a target picker of
+ * exhaustAgent_&lt;agent&gt;_&lt;faction&gt; follows). Nothing is exhausted before the target is pressed, so both are
+ * optional.
+ */
+public class FactionStepsLeaders implements FactionSteps {
+    @Override
+    @Nullable
+    public Step step(String h, @Nullable CaptureContext ctx) {
+        if (h.startsWith("exhaustAgent_")) {
+            List<String> a = FactionSteps.args(h, "exhaustAgent_");
+            String agent = FactionSteps.at(a, 0);
+            if (agent == null || !FactionSteps.isLeader(agent)) return null;
+            if (a.size() == 1) return Step.leader(agent, "exhaustAgent", "use", true);
+            // the first arg is the target, except after a sub-step marker (exhaustAgent_cabalagent_startCabalAgent_<faction>)
+            int t = a.size() > 2 && a.get(1).matches("start[A-Z].*") ? 2 : 1;
+            String target = FactionSteps.faction(a.get(t), ctx);
+            return Step.leader(
+                    agent, "exhaustAgent", "target", true, "target", target, "args", List.copyOf(a.subList(1, a.size())));
+        }
+        if (h.startsWith("getAgentSelection_")) {
+            String agent = h.substring("getAgentSelection_".length());
+            if (!FactionSteps.isLeader(agent)) return null;
+            return Step.leader(agent, "getAgentSelection", "use", true);
+        }
+        return null;
+    }
+}
