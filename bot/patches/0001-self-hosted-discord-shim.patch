+package ti4.helpers;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import org.junit.jupiter.api.Test;
+
+class DoneRoleTest {
+
+    @Test
+    void roleRoundTripsThroughTheId() {
+        for (DoneRole role : DoneRole.values()) {
+            String id = role.tag("deleteButtons_tacticalAction_37");
+            assertThat(id).startsWith("deleteButtons_tacticalAction_37");
+            assertThat(DoneRole.of(id)).isEqualTo(role);
+            assertThat(DoneRole.strip(id)).isEqualTo("deleteButtons_tacticalAction_37");
+        }
+        assertThat(DoneRole.of(DoneRole.pay("deleteButtons"))).isEqualTo(DoneRole.PAY);
+        assertThat(DoneRole.strip(DoneRole.pay("deleteButtons"))).isEqualTo("deleteButtons");
+    }
+
+    @Test
+    void untaggedIdsHaveNoRole() {
+        assertThat(DoneRole.of("deleteButtons")).isNull();
+        assertThat(DoneRole.of("deleteButtons_spitItOut")).isNull();
+        assertThat(DoneRole.of("presetSlices~MDL")).isNull();
+        assertThat(DoneRole.strip("deleteButtons_leadership")).isEqualTo("deleteButtons_leadership");
+        assertThat(DoneRole.of(null)).isNull();
+    }
+
+    @Test
+    void ownerPrefixIsKeptInFront() {
+        String raw = DoneRole.ccGain("FFCC_xxcha_deleteButtons_leadership");
+        assertThat(raw).isEqualTo("FFCC_xxcha_deleteButtons_leadership~ccgain");
+        assertThat(DoneRole.of(raw)).isEqualTo(DoneRole.CC_GAIN);
+        assertThat(DoneRole.CC_GAIN.isCommandTokens()).isTrue();
+        assertThat(DoneRole.PAY.isCommandTokens()).isFalse();
+    }
+}
