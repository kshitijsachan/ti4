new file mode 100644
index 0000000..1a98a07
--- /dev/null
+++ b/src/main/java/ti4/service/combat/SpaceCannonRestrictions.java
@@ -0,0 +1,93 @@
+package ti4.service.combat;
+
+import java.util.ArrayList;
+import java.util.List;
+import javax.annotation.Nullable;
+import lombok.experimental.UtilityClass;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.game.Tile;
+import ti4.helpers.ButtonHelper;
+import ti4.helpers.FoWHelper;
+
+/**
+ * Faction cards that forbid SPACE CANNON rolls (rules audit, factions slice; a deliberate improvement over the
+ * original bot, which only posted reminders and still accepted the roll):
+ *
+ * <ul>
+ *   <li>L4 Disruptors (Barony of Letnev): "During an invasion, units cannot use SPACE CANNON against your units." —
+ *       no SPACE CANNON DEFENCE against an invading player who owns the technology.</li>
+ *   <li>Quetzecoatl (Argent Flight flagship): "Other players cannot use SPACE CANNON against your ships in this
+ *       system." — no SPACE CANNON OFFENCE when every other player with ships in the system is an Argent player
+ *       whose flagship is there.</li>
+ * </ul>
+ */
+@UtilityClass
+public class SpaceCannonRestrictions {
+
+    /** Why {@code roller} may not roll this space cannon type in {@code tile} (null = allowed). */
+    @Nullable
+    public static String blocked(Game game, Player roller, Tile tile, CombatRollType type) {
+        if (game == null || roller == null || tile == null || type == null) return null;
+        if (type == CombatRollType.SpaceCannonDefence) {
+            Player invader = game.getActivePlayer();
+            if (invader != null
+                    && invader != roller
+                    && !roller.getAllianceMembers().contains(invader.getFaction())
+                    && invader.hasTech("l4")) {
+                return "_L4 Disruptors_: units cannot use SPACE CANNON against "
+                        + invader.getRepresentationNoPing() + "'s units during an invasion";
+            }
+            if (invader != null && invader != roller && PlanetaryShieldRules.disableActive(game, invader)
+                    && !hasNonPdsSpaceCannonOnPlanets(roller, tile)) {
+                return "_Disable_: " + roller.getRepresentationNoPing()
+                        + "'s PDS lost SPACE CANNON during this invasion";
+            }
+            return null;
+        }
+        if (type == CombatRollType.SpaceCannonOffence) {
+            List<Player> targets = new ArrayList<>();
+            for (Player p : game.getRealPlayersNNeutral()) {
+                if (p == roller || roller.getAllianceMembers().contains(p.getFaction())) continue;
+                if (FoWHelper.playerHasActualShipsInSystem(p, tile)) targets.add(p);
+            }
+            if (targets.isEmpty()) return null;
+            for (Player t : targets) {
+                if (!ButtonHelper.doesPlayerHaveFSHere("argent_flagship", t, tile)) return null;
+            }
+            return "_Quetzecoatl_ (the Argent flagship): other players cannot use SPACE CANNON against "
+                    + targets.getFirst().getRepresentationNoPing() + "'s ships in this system";
+        }
+        return null;
+    }
+
+    private static boolean hasNonPdsSpaceCannonOnPlanets(Player roller, Tile tile) {
+        for (ti4.game.UnitHolder uh : tile.getPlanetUnitHolders()) {
+            for (ti4.helpers.Units.UnitKey key : uh.getUnitKeys()) {
+                if (!roller.unitBelongsToPlayer(key) || uh.getUnitCount(key) <= 0) continue;
+                if (key.unitType() == ti4.helpers.Units.UnitType.Pds) continue;
+                ti4.model.UnitModel m = roller.getUnitFromUnitKey(key);
+                if (m != null && m.getSpaceCannonDieCount(roller) > 0) return true;
+            }
+        }
+        return false;
+    }
+
+    /** {@link #blocked(Game, Player, Tile, CombatRollType)} for a roll button id (combatRoll_&lt;pos&gt;_&lt;holder&gt;_&lt;type&gt;). */
+    @Nullable
+    public static String blocked(Game game, Player roller, String handlerId) {
+        if (game == null || handlerId == null) return null;
+        String h = handlerId.replaceFirst("^FFCC_[^_]+_", "").replaceFirst("^bombardConfirm_", "");
+        if (!h.startsWith("combatRoll_")) return null;
+        String[] parts = h.split("_");
+        if (parts.length < 4) return null;
+        CombatRollType type =
+                switch (parts[3]) {
+                    case "spacecannondefence" -> CombatRollType.SpaceCannonDefence;
+                    case "spacecannonoffence" -> CombatRollType.SpaceCannonOffence;
+                    default -> null;
+                };
+        if (type == null) return null;
+        return blocked(game, roller, game.getTileByPosition(parts[1]), type);
+    }
+}
