+++ b/src/main/java/ti4/selfhost/engine/kinds/TacticalActivateKind.java
@@ -0,0 +1,101 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import net.dv8tion.jda.api.components.buttons.Button;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.game.Tile;
+import ti4.helpers.ButtonHelper;
+import ti4.helpers.CheckDistanceHelper;
+import ti4.discord.interactions.routing.ComponentIdEnvelope;
+import ti4.selfhost.engine.KindSpec;
+import ti4.service.map.SystemPickerService;
+
+/**
+ * Choosing the system to activate (tactical action): the ring menu (ring_&lt;n&gt;[_left|_right], ring_corners), the
+ * distance menu (getTilesThisFarAway_&lt;d&gt;) and the systems themselves (ringTile_&lt;pos&gt;).
+ *
+ * <p>Values: a system {step:"system", position, tileId}; a menu step {step:"ring"|"distance", ring|distance,
+ * positions}, where positions are the systems the sub-menu will offer — so a client that wants to activate X answers
+ * the menu option whose positions contain X, then the system option, without knowing the map's ring geometry.
+ */
+public class TacticalActivateKind implements KindSpec {
+
+    @Override
+    public String kind() {
+        return "tactical.activate";
+    }
+
+    @Override
+    public int priority() {
+        return 100;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return handlerId.startsWith("ringTile_")
+                || handlerId.startsWith("ring_")
+                || handlerId.matches("getTilesThisFarAway_\\d+");
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        Map<String, Object> v = new LinkedHashMap<>();
+        Game game = ctx.game();
+        Player player = ctx.player();
+        if (handlerId.startsWith("ringTile_")) {
+            String pos = handlerId.substring("ringTile_".length());
+            Tile tile = game.getTileByPosition(pos);
+            v.put("step", "system");
+            v.put("position", pos);
+            v.put("tileId", tile == null ? null : tile.getTileID());
+            return v;
+        }
+        if (player == null) return null;
+        if (handlerId.startsWith("ring_")) {
+            v.put("step", "ring");
+            v.put("ring", handlerId.substring("ring_".length()));
+            v.put("positions", new ArrayList<>(ringPositions(game, player, handlerId, 0)));
+            return v;
+        }
+        int d = Integer.parseInt(handlerId.substring("getTilesThisFarAway_".length()));
+        v.put("step", "distance");
+        v.put("distance", d);
+        List<String> positions = new ArrayList<>();
+        try {
+            Map<String, Integer> distances =
+                    CheckDistanceHelper.getTileDistancesRelativeToAllYourUnlockedTiles(game, player);
+            for (String pos : CheckDistanceHelper.getAllTilesACertainDistanceAway(game, player, distances, d)) {
+                Tile tile = game.getTileByPosition(pos);
+                if (tile != null && ButtonHelper.canActivateTile(game, player, tile)) positions.add(pos);
+            }
+        } catch (Exception ignored) {
+            // leave positions empty: the client then walks the menu
+        }
+        v.put("positions", positions);
+        return v;
+    }
+
+    /** Systems a ring button leads to (following one more ring level for the big rings' left/right split). */
+    private static Set<String> ringPositions(Game game, Player player, String ringId, int depth) {
+        Set<String> out = new LinkedHashSet<>();
+        try {
+            List<Button> buttons = ButtonHelper.getTileInARing(player, game, ringId);
+            SystemPickerService.dropUnknownSystems(buttons, player, game);
+            for (Button b : buttons) {
+                String h = ComponentIdEnvelope.decode(b.getCustomId()).handlerId();
+                if (h == null) continue;
+                if (h.startsWith("ringTile_")) out.add(h.substring("ringTile_".length()));
+                else if (h.startsWith("ring_") && depth < 1) out.addAll(ringPositions(game, player, h, depth + 1));
+            }
+        } catch (Exception ignored) {
+            // malformed ring id: no positions
+        }
+        return out;
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/TacticalConcludeKind.java b/src/main/java/ti4/selfhost/engine/kinds/TacticalConcludeKind.java
