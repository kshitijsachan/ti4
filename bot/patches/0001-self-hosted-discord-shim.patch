index 0000000..42e2f9a
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/InteractionTracker.java
@@ -0,0 +1,77 @@
+package ti4.selfhost.engine;
+
+import java.util.Map;
+import java.util.concurrent.ConcurrentHashMap;
+import javax.annotation.Nonnull;
+import net.dv8tion.jda.api.events.interaction.GenericInteractionCreateEvent;
+import net.dv8tion.jda.api.events.interaction.component.GenericComponentInteractionCreateEvent;
+import net.dv8tion.jda.api.hooks.ListenerAdapter;
+
+/**
+ * Remembers who made each interaction (by interaction token and id), so replies, followups and ephemeral messages
+ * sent through the interaction webhook are attributed to that player, not guessed from text.
+ */
+public final class InteractionTracker extends ListenerAdapter {
+    private static final long TTL_MS = 15 * 60 * 1000;
+
+    public record Info(String userId, String channelId, String messageId, String customId, long at) {}
+
+    private static final Map<String, Info> byToken = new ConcurrentHashMap<>();
+    private static final Map<String, Info> byId = new ConcurrentHashMap<>();
+    /** interaction token -> message id of its @original response, once known. */
+    private static final Map<String, String> originals = new ConcurrentHashMap<>();
+
+    @Override
+    public void onGenericInteractionCreate(@Nonnull GenericInteractionCreateEvent event) {
+        record(event);
+    }
+
+    public static void record(GenericInteractionCreateEvent event) {
+        try {
+            String messageId = null;
+            String customId = null;
+            if (event instanceof GenericComponentInteractionCreateEvent c) {
+                messageId = c.getMessageId();
+                customId = c.getComponentId();
+            }
+            Info info = new Info(
+                    event.getUser().getId(),
+                    event.getChannel() == null ? null : event.getChannel().getId(),
+                    messageId,
+                    customId,
+                    System.currentTimeMillis());
+            byToken.put(event.getToken(), info);
+            byId.put(event.getId(), info);
+            prune();
+        } catch (Exception ignored) {
+            // best effort
+        }
+    }
+
+    public static Info byToken(String token) {
+        return byToken.get(token);
+    }
+
+    public static Info byId(String id) {
+        return byId.get(id);
+    }
+
+    public static void setOriginal(String token, String messageId) {
+        if (token != null && messageId != null) originals.put(token, messageId);
+    }
+
+    public static String original(String token) {
+        return originals.get(token);
+    }
+
+    private static void prune() {
+        if (byToken.size() < 2000) return;
+        long cutoff = System.currentTimeMillis() - TTL_MS;
+        byToken.entrySet().removeIf(e -> {
+            boolean old = e.getValue().at() < cutoff;
+            if (old) originals.remove(e.getKey());
+            return old;
+        });
+        byId.values().removeIf(i -> i.at() < cutoff);
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/KindSpec.java b/src/main/java/ti4/selfhost/engine/KindSpec.java
new file mode 100644
index 0000000..e7d6b20
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/KindSpec.java
@@ -0,0 +1,70 @@
+package ti4.selfhost.engine;
+
+import java.util.Map;
+import javax.annotation.Nullable;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.selfhost.engine.EngineModels.Decision;
+import ti4.selfhost.engine.EngineModels.Target;
+
+/**
+ * A typed decision kind. Implementations live in {@code ti4.selfhost.engine.kinds} and are discovered by classpath
+ * scan (public class, public no-arg constructor): adding a kind needs no edit to any shared file.
+ *
+ * <p>A captured message gets the kind of the highest-priority spec that {@link #matches} at least one of its options;
+ * otherwise it is "legacy". Every option of the message is still listed; {@link #value} types the ones the kind
+ * understands (others get value null, e.g. a "Done" button).
+ */
+public interface KindSpec {
+
+    /** Discriminant, "area.verb" (e.g. "strategy_card.pick"). Must match the TS union member in engine/types.ts. */
+    String kind();
+
+    /** Higher wins when several kinds match one message. Default 0; legacy is below everything. */
+    default int priority() {
+        return 0;
+    }
+
+    /** Whether this option (handler id = custom id without FFCC_/spoof prefix and delete markers) belongs to us. */
+    boolean matches(String handlerId);
+
+    /** Typed value for one of our options; null if it carries no typed meaning. */
+    @Nullable
+    Map<String, Object> value(String handlerId, CaptureContext ctx);
+
+    /**
+     * Override the target the generic resolver found (e.g. the draft's current player). Also called again after
+     * every state change while the decision is open when {@link #dynamicTarget()} is true.
+     */
+    @Nullable
+    default Target target(CaptureContext ctx, @Nullable Target resolved) {
+        return resolved;
+    }
+
+    default boolean dynamicTarget() {
+        return false;
+    }
+
+    /** "player" (only the target answers) or "table" (any seated player answers for themself). */
+    default String scope(CaptureContext ctx) {
+        return ctx.target() == null || ctx.target().userId() == null ? "table" : "player";
+    }
+
+    /**
+     * Extra check before an answer is executed (the handler validates again). Return an error text to refuse.
+     */
+    @Nullable
+    default String validate(Game game, Player answering, Decision decision, String optionId) {
+        return null;
+    }
+
+    /** What the engine knows when it captures a message. */
+    record CaptureContext(
+            Game game,
+            String channelId,
+            String messageId,
+            String content,
+            boolean ephemeral,
+            @Nullable Target target,
+            @Nullable Player player) {}
+}
