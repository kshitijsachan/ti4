+package ti4.selfhost.engine.kinds;
+
+import static ti4.selfhost.engine.kinds.ChooseSupport.rule;
+
+import java.util.List;
+
+/**
+ * Generic "choose a unit" step: value {source, unit (async unit id), tile?, planet?, damaged?}. Add one-step unit
+ * prompts here (named groups {@code unit}, optionally {@code tile} / {@code planet}), e.g.
+ * {@code rule("my_ability", "myAbilityUnit_(?<tile>[^_]+)_(?<unit>[a-z]+)")}.
+ */
+public class ChooseUnitKind extends ChooseKindBase {
+
+    public static final List<ChooseSupport.Rule> RULES = List.of(
+            // Industrex (TE legendary planet): the ship type to place (then placeOneNDone_ picks the system).
+            rule("industrex", "industrexPickType_(?<unit>[a-z]+)"),
+            // "Remove one <unit type>" lists (ButtonHelperModifyUnits.getRemoveThisTypeOfUnitButton): the unit plastic /
+            // cardboard limit warning PlayerAreaGenerator posts on every render, and the capacity / fleet-pool lists of
+            // Vortex-style removals; "Done Resolving" (deleteButtons) is chrome. unit = display name ("Space Dock"),
+            // holder = "space" or a planet id, color = the owner's color; destroy = "_destroy" when it destroys.
+            rule(
+                    "remove_unit_type",
+                    "removeThisTypeOfUnit_(?<unit>[^_]+)_(?<tile>[^_]+)_(?<holder>[^_]+)(?:_(?<color>[a-z]+))?(?:_(?<destroy>destroy))?"),
+            // The Cavalry (Nomad promissory note): the ship in the active system that becomes the Cavalry.
+            rule("cavalry", "cavStep2_(?<unit>[a-z]+?)(?<damaged>damaged)?"),
+            // Refit Troops (action card): the infantry replaced with a mech (two copies of the prompt, one per mech).
+            rule(
+                    "refit",
+                    "mitoMechPlacement_(?<tile>[^_]+)_(?<holder>[^_]+)_refit",
+                    java.util.Map.of("unit", "mech"),
+                    (v, ctx) -> {
+                        Object h = v.get("holder");
+                        if (h instanceof String s && !"space".equals(s)) ExploreSupport.putPlanet(v, ctx.game(), s);
+                    }));
+
+    @Override
+    public String kind() {
+        return "choose.unit";
+    }
+
+    @Override
+    protected List<ChooseSupport.Rule> rules() {
+        return RULES;
+    }
+}
