+++ b/src/main/java/ti4/selfhost/engine/kinds/KeleresFlavorKind.java
@@ -0,0 +1,116 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.Map;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.selfhost.engine.EngineModels.Decision;
+import ti4.selfhost.engine.KindSpec;
+import ti4.service.milty.MiltyDraftManager;
+
+/**
+ * Which Keleres to play (Mentak / Xxcha / Argent flavour). Two prompts, both in the Keleres drafter's cards-info
+ * thread and without an owner prefix:
+ *
+ * <ul>
+ *   <li>during the draft: draftPresetKeleres_&lt;flavor&gt; (preset; can be changed; gray "🛑" when that faction is
+ *       still in the draft) — value.preset = true;
+ *   <li>after the draft, when no valid preset exists: setupStep5_&lt;uid&gt;_keleres&lt;m|x|a&gt;_null_&lt;pos&gt;_&lt;yes|no&gt;
+ *       (sets the player up) — value.preset = false.
+ * </ul>
+ *
+ * value: {flavor: "mentak"|"xxcha"|"argent", faction: "keleresm"|…, preset, contested (that faction is drafted or
+ * still on the draft board), homePosition, speaker}. Target: the cards-info thread's owner; validate also checks
+ * the user the setupStep5 id names (the handler sets up that user, whoever presses).
+ */
+public class KeleresFlavorKind implements KindSpec {
+    private static final Pattern SETUP =
+            Pattern.compile("setupStep5_(\\d+)_keleres([mxa])_null_([^_]+)_(yes|no)");
+    private static final Pattern PRESET = Pattern.compile("draftPresetKeleres_(mentak|xxcha|argent)");
+
+    @Override
+    public String kind() {
+        return "setup.keleres_flavor";
+    }
+
+    @Override
+    public int priority() {
+        return 110;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return SETUP.matcher(handlerId).matches() || PRESET.matcher(handlerId).matches();
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        Matcher s = SETUP.matcher(handlerId);
+        if (s.matches()) {
+            String flavor = flavorOf(s.group(2));
+            return SetupKindSupport.map(
+                    "flavor", flavor,
+                    "faction", "keleres" + s.group(2),
+                    "preset", false,
+                    "contested", contested(ctx.game(), flavor),
+                    "homePosition", s.group(3),
+                    "speaker", "yes".equals(s.group(4)));
+        }
+        Matcher p = PRESET.matcher(handlerId);
+        if (!p.matches()) return null;
+        String flavor = p.group(1);
+        return SetupKindSupport.map(
+                "flavor", flavor,
+                "faction", "keleres" + flavor.charAt(0),
+                "preset", true,
+                "contested", contested(ctx.game(), flavor),
+                "homePosition", null,
+                "speaker", null);
+    }
+
+    @Override
+    public String scope(CaptureContext ctx) {
+        return "player";
+    }
+
+    @Override
+    public String validate(Game game, Player answering, Decision decision, String optionId) {
+        Matcher s = SETUP.matcher(SetupKindSupport.handlerOf(decision, optionId));
+        if (s.matches() && !s.group(1).equals(answering.getUserID())) return "That choice is for another player.";
+        return null;
+    }
+
+    private static String flavorOf(String letter) {
+        return switch (letter) {
+            case "m" -> "mentak";
+            case "x" -> "xxcha";
+            default -> "argent";
+        };
+    }
+
+    /** That flavour's faction is drafted by someone, or still on the draft board. */
+    private static boolean contested(Game game, String flavor) {
+        MiltyDraftManager m = game.getMiltyDraftManager();
+        if (m == null) return false;
+        return m.isFactionTaken(flavor) || (!m.isFinished() && m.getFactionDraft().contains(flavor));
+    }
+
+    /** Setup: faction / colour are picked after capture; re-resolve the target on every state change. */
+    @Override
+    public boolean dynamic() {
+        return true;
+    }
+
+    @Override
+    public ti4.selfhost.engine.EngineModels.Target target(
+            CaptureContext ctx, ti4.selfhost.engine.EngineModels.Target resolved) {
+        return SetupKindSupport.refresh(ctx, resolved);
+    }
+
+    /** Past setup this prompt is a leftover nobody needs (live: hundreds open across games, flooding the web queue). */
+    @Override
+    public boolean obsolete(CaptureContext ctx) {
+        return ti4.selfhost.engine.SetupStateBuilder.pastSetup(ctx.game());
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/KeleresTechOptionsKind.java b/src/main/java/ti4/selfhost/engine/kinds/KeleresTechOptionsKind.java
