index 0000000..89ef450
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/UndoGroup.java
@@ -0,0 +1,69 @@
+package ti4.selfhost.engine;
+
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.StandardCopyOption;
+import java.util.List;
+import ti4.helpers.Constants;
+import ti4.helpers.Storage;
+import ti4.logging.BotLogger;
+import ti4.service.game.GameUndoNameService;
+
+/**
+ * One undo step per engine answer. A payload answer (payment, production, agenda vote, token split…) makes several
+ * presses, and the bot saves an undo snapshot after each ({@code <game>_N.txt}). Once the answer is done we collapse
+ * them: the last snapshot becomes {@code before + 1} and the intermediate ones go, so the UNDO button, {@code /game
+ * undo} and the web undo / rewind take the whole answer back in one step (the web's flow grouping is not needed for
+ * engine answers). Callers hold the game's WRITE lock, so no other save interleaves.
+ */
+final class UndoGroup {
+    private UndoGroup() {}
+
+    /** The latest undo snapshot number now (-1 when none). */
+    static int latest(String gameName) {
+        try {
+            return GameUndoNameService.getLatestUndoNumber(gameName);
+        } catch (Exception e) {
+            return -1;
+        }
+    }
+
+    /**
+     * Collapses the snapshots made after {@code before} into one, labelled {@code label} as pressed by {@code by}.
+     * No-op when the answer made fewer than two snapshots or the numbering is not contiguous.
+     */
+    static void collapse(String gameName, int before, String by, String label) {
+        if (before < 0) return;
+        try {
+            List<Integer> numbers = GameUndoNameService.getSortedUndoNumbers(gameName);
+            if (numbers.isEmpty()) return;
+            int last = numbers.getLast();
+            if (last - before < 2) return;
+            for (int i = before + 1; i <= last; i++) if (!numbers.contains(i)) return;
+            Path target = file(gameName, before + 1);
+            Files.move(file(gameName, last), target, StandardCopyOption.REPLACE_EXISTING);
+            for (int i = before + 2; i < last; i++) Files.deleteIfExists(file(gameName, i));
+            relabel(target, by + " pressed button: " + label + " (engine answer)");
+            EngineMetrics.count("answer.undo_collapsed");
+        } catch (Exception e) {
+            BotLogger.error("engine: could not group the undo snapshots of an answer in " + gameName, e);
+        }
+    }
+
+    private static Path file(String gameName, int index) {
+        return Storage.getGameUndo(gameName, gameName + "_" + index + Constants.TXT);
+    }
+
+    /** Rewrites the snapshot's {@code latest_command} line (what the undo list shows for it). */
+    private static void relabel(Path snapshot, String command) throws Exception {
+        List<String> lines = Files.readAllLines(snapshot, StandardCharsets.UTF_8);
+        for (int i = 0; i < lines.size(); i++) {
+            if (lines.get(i).startsWith("latest_command ")) {
+                lines.set(i, "latest_command " + command.replace('\n', ' '));
+                Files.write(snapshot, lines, StandardCharsets.UTF_8);
+                return;
+            }
+        }
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/WindowResponses.java b/src/main/java/ti4/selfhost/engine/WindowResponses.java
new file mode 100644
index 0000000..778c13d
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/WindowResponses.java
@@ -0,0 +1,53 @@
+package ti4.selfhost.engine;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.LinkedHashMap;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import javax.annotation.Nullable;
+import ti4.selfhost.engine.EngineModels.ReactionWindow;
+
+/**
+ * Engine-side record of who answered a reaction window, for kinds whose own record is unreliable
+ * ({@link KindSpec#recordsResponses()}: e.g. agenda shenanigans, whose persistent-react entry is not always kept). A
+ * successful engine answer by an eligible player marks them responded on that message, so the window closes over for
+ * them (ActionInvoker then answers 409 "already responded" instead of pressing again).
+ */
+final class WindowResponses {
+    private static final int MAX_MESSAGES = 2000;
+    private static final Map<String, Set<String>> byMessage = Collections.synchronizedMap(
+            new LinkedHashMap<>(256, 0.75f, true) {
+                @Override
+                protected boolean removeEldestEntry(Map.Entry<String, Set<String>> e) {
+                    return size() > MAX_MESSAGES;
+                }
+            });
+
+    private WindowResponses() {}
+
+    static void record(String messageId, String userId) {
+        byMessage.computeIfAbsent(messageId, k -> Collections.synchronizedSet(new LinkedHashSet<>())).add(userId);
+    }
+
+    /** The kind's window plus the responses the engine recorded for this message. */
+    @Nullable
+    static ReactionWindow merge(String messageId, @Nullable ReactionWindow w) {
+        if (w == null) return null;
+        Set<String> recorded = byMessage.get(messageId);
+        if (recorded == null || recorded.isEmpty()) return w;
+        List<String> responded = new ArrayList<>(w.responded());
+        Map<String, String> responses = new LinkedHashMap<>(w.responses());
+        synchronized (recorded) {
+            for (String uid : recorded) {
+                if (!w.eligible().contains(uid) || responded.contains(uid)) continue;
+                responded.add(uid);
+                responses.putIfAbsent(uid, "answered");
+            }
+        }
+        if (responded.size() == w.responded().size()) return w;
+        return new ReactionWindow(w.kind(), w.subject(), w.eligible(), responded, responses);
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/interaction/EngineInteraction.java b/src/main/java/ti4/selfhost/engine/interaction/EngineInteraction.java
new file mode 100644
index 0000000..7df605e
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/interaction/EngineInteraction.java
@@ -0,0 +1,270 @@
+package ti4.selfhost.engine.interaction;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.atomic.AtomicLong;
+import javax.annotation.Nullable;
+import lombok.Getter;
+import net.dv8tion.jda.api.components.ActionComponent;
+import net.dv8tion.jda.api.components.MessageTopLevelComponent;
+import net.dv8tion.jda.api.components.buttons.Button;
+import net.dv8tion.jda.api.components.selections.StringSelectMenu;
+import net.dv8tion.jda.api.components.tree.MessageComponentTree;
+import net.dv8tion.jda.api.entities.Guild;
+import net.dv8tion.jda.api.entities.Member;
+import net.dv8tion.jda.api.entities.Message;
+import net.dv8tion.jda.api.entities.User;
+import net.dv8tion.jda.api.entities.channel.middleman.GuildChannel;
+import net.dv8tion.jda.api.entities.channel.middleman.MessageChannel;
+import net.dv8tion.jda.api.modals.Modal;
+import net.dv8tion.jda.api.utils.FileUpload;
+import net.dv8tion.jda.api.utils.messages.MessageCreateData;
+import net.dv8tion.jda.api.utils.messages.MessageEditBuilder;
+import net.dv8tion.jda.api.utils.messages.MessageEditData;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.selfhost.engine.DecisionRegistry;
+import ti4.selfhost.engine.Interaction;
+
+/**
+ * The engine's own {@link Interaction}: a seat answering a decision directly. No interaction token, no synthesised
+ * Discord payload, no shim round trip. Message I/O goes through a {@link MessageSink} (today JDA channel REST, which
+ * keeps the Discord mirror and decision capture working; W-INFRA-4 swaps it for a decisions-only sink), and prompt
+ * removal closes the decision in the registry immediately.
+ *
+ * <p>Semantics follow a Discord button press as ButtonListener performs it: the interaction is acknowledged up front
+ * (deferEdit), so "@original" is the prompt message and replies are followups in the prompt's channel.
+ */
+public final class EngineInteraction implements Interaction {
+
+    public enum Type {
+        BUTTON,
+        SELECT,
+        MODAL
+    }
+
+    private static final AtomicLong IDS = new AtomicLong((System.currentTimeMillis() - 1420070400000L) << 22);
+
+    @Getter
+    private final long id = IDS.incrementAndGet();
+
+    @Getter
+    private final Type type;
+
+    private final Game game;
+    private final Player player;
+    private final String userId;
+    private final String channelId;
+    private final String messageId;
+    /** Button / select custom id (raw), or the modal id. */
+    private final String componentId;
+
+    @Getter
+    private final List<String> values;
+
+    @Getter
+    private final Map<String, String> inputs;
+
+    private final MessageSink sink;
+    private Message message;
+    private boolean messageLoaded;
+
+    /** The modal a handler opened (replyModal); the engine turns it into an input.form decision. */
+    @Getter
+    private Modal openedModal;
+
+    /** What the answer did, in order (for logs, results and tests). */
+    @Getter
+    private final List<String> trace = Collections.synchronizedList(new ArrayList<>());
+
+    public EngineInteraction(
+            Type type,
+            Game game,
+            Player player,
+            String userId,
+            String channelId,
+            @Nullable String messageId,
+            String componentId,
+            List<String> values,
+            Map<String, String> inputs,
+            MessageSink sink) {
+        this.type = type;
+        this.game = game;
+        this.player = player;
+        this.userId = userId;
+        this.channelId = channelId;
+        this.messageId = messageId;
+        this.componentId = componentId;
+        this.values = values == null ? List.of() : List.copyOf(values);
+        this.inputs = inputs == null ? Map.of() : Map.copyOf(inputs);
+        this.sink = sink;
+    }
+
+    // ------------------------------------------------------------------ Interaction
+
+    @Override
+    public Game game() {
+        return game;
+    }
+
+    @Override
+    public Player player() {
+        return player;
+    }
+
+    @Override
+    public String userId() {
+        return userId;
+    }
+
+    @Override
+    public String componentId() {
+        return componentId;
+    }
+
+    public String channelId() {
+        return channelId;
+    }
+
+    @Override
+    public MessageChannel channel() {
+        return sink.channel(channelId);
+    }
+
+    @Override
+    @Nullable
+    public String messageId() {
+        return messageId;
+    }
+
+    @Override
+    @Nullable
+    public synchronized Message message() {
+        if (!messageLoaded && messageId != null) {
+            message = sink.fetch(channelId, messageId);
+            messageLoaded = true;
+        }
+        return message;
+    }
+
+    @Override
+    public boolean isEngine() {
+        return true;
+    }
+
+    @Override
+    public void deferEdit() {
+        trace.add("deferEdit");
+    }
+
+    @Override
+    public void reply(MessageCreateData data) {
+        send(data, false);
+    }
+
+    @Override
+    public void replyEphemeral(MessageCreateData data) {
+        send(data, true);
+    }
+
+    @Override
+    public void editComponents(MessageComponentTree tree) {
+        if (messageId == null) return;
+        edit(messageId, new MessageEditBuilder().setComponents(tree.getComponents()).build());
+    }
+
+    @Override
+    public void editMessage(String content, List<? extends MessageTopLevelComponent> components, List<FileUpload> files) {
+        if (messageId == null) return;
+        edit(messageId, new MessageEditBuilder()
+                .setContent(content)
+                .setComponents(components)
+                .setFiles(files)
+                .build());
+    }
+
+    @Override
+    public void deleteMessage() {
+        if (messageId != null) delete(messageId, 0);
+    }
+
+    @Override
+    public void deleteMessage(int delaySeconds) {
+        if (messageId != null) delete(messageId, Math.min(delaySeconds, 20));
+    }
+
+    // ------------------------------------------------------------------ primitives (also used by the JDA view)
+
+    /** Followup in the prompt's channel; ephemeral = only the answering user sees it. */
+    @Nullable
+    public Message send(MessageCreateData data, boolean ephemeral) {
+        trace.add((ephemeral ? "reply_ephemeral" : "reply") + ": " + abbreviate(data.getContent()));
+        return sink.send(channelId, data, ephemeral ? userId : null);
+    }
+
+    @Nullable
+    public Message edit(String targetMessageId, MessageEditData data) {
+        trace.add("edit " + targetMessageId);
+        Message m = sink.edit(channelId, targetMessageId, data);
+        if (targetMessageId.equals(messageId) && m != null) {
+            synchronized (this) {
+                message = m;
+                messageLoaded = true;
+            }
+        }
+        return m;
+    }
+
+    public void delete(String targetMessageId, int delaySeconds) {
+        trace.add("delete " + targetMessageId);
+        if (delaySeconds <= 0) DecisionRegistry.closeByMessage(targetMessageId, "answered");
+        sink.delete(channelId, targetMessageId, delaySeconds);
+    }
+
+    @Nullable
+    public Message fetch(String targetMessageId) {
+        return targetMessageId.equals(messageId) ? message() : sink.fetch(channelId, targetMessageId);
+    }
+
+    public void openModal(Modal modal) {
+        trace.add("modal " + modal.getId());
+        openedModal = modal;
+    }
+
+    /** The pressed button / select menu, taken from the prompt message (so uniqueId matches its tree). */
+    @Nullable
+    public ActionComponent component() {
+        Message m = message();
+        if (m != null) {
+            Class<? extends ActionComponent> kind = type == Type.SELECT ? StringSelectMenu.class : Button.class;
+            for (ActionComponent c : m.getComponentTree().findAll(kind)) {
+                if (componentId.equals(c.getCustomId())) return c;
+            }
+        }
+        return type == Type.SELECT ? StringSelectMenu.create(componentId).addOption("-", "-").build()
+                : Button.secondary(componentId, "-");
+    }
+
+    public User user() {
+        return sink.user(userId);
+    }
+
+    @Nullable
+    public Guild guild() {
+        return channel() instanceof GuildChannel gc ? gc.getGuild() : null;
+    }
+
+    @Nullable
+    public Member member() {
+        Guild g = guild();
+        return g == null ? null : sink.member(g, userId);
+    }
+
+    private static String abbreviate(String s) {
+        if (s == null) return "";
+        s = s.replace('\n', ' ');
+        return s.length() > 80 ? s.substring(0, 80) + "…" : s;
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/interaction/Forms.java b/src/main/java/ti4/selfhost/engine/interaction/Forms.java
new file mode 100644
index 0000000..493f60d
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/interaction/Forms.java
@@ -0,0 +1,175 @@
+package ti4.selfhost.engine.interaction;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.concurrent.ConcurrentHashMap;
+import javax.annotation.Nullable;
+import net.dv8tion.jda.api.components.label.Label;
+import net.dv8tion.jda.api.components.selections.SelectOption;
+import net.dv8tion.jda.api.components.selections.StringSelectMenu;
+import net.dv8tion.jda.api.components.textinput.TextInput;
+import net.dv8tion.jda.api.components.textinput.TextInputStyle;
+import net.dv8tion.jda.api.modals.Modal;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.selfhost.engine.DecisionRegistry;
+import ti4.selfhost.engine.EngineModels.Choice;
+import ti4.selfhost.engine.EngineModels.Decision;
+import ti4.selfhost.engine.EngineModels.InputField;
+import ti4.selfhost.engine.EngineModels.InputSchema;
+import ti4.selfhost.engine.EngineModels.Option;
+import ti4.selfhost.engine.EngineModels.Source;
+import ti4.selfhost.engine.EngineModels.Target;
+
+/**
+ * Forms ("input.form" decisions): when an engine answer presses a button whose handler opens a Discord modal, the
+ * modal becomes a typed decision for that player — its text inputs / selects as an {@link InputSchema} — answered with
+ * {@code {optionId:"submit", inputs:{...}}} (runs the modal's handler as an engine answer) or {@code "cancel"}.
+ */
+public final class Forms {
+    public static final String KIND = "input.form";
+    public static final String SUBMIT = "submit";
+    public static final String CANCEL = "cancel";
+
+    /** Modal text inputs whose handlers parse an integer (engine ids, not labels). */
+    private static final Set<String> NUMERIC = Set.of("vp", "rounds", "diceSides", "diceCount", "count");
+
+    /** An open form: the modal and the prompt it came from. */
+    public record Form(String decisionId, Modal modal, String channelId, String messageId, String userId) {}
+
+    private static final Map<String, Form> open = new ConcurrentHashMap<>();
+
+    private Forms() {}
+
+    @Nullable
+    public static Form get(String decisionId) {
+        return open.get(decisionId);
+    }
+
+    public static void close(String decisionId, String reason) {
+        open.remove(decisionId);
+        DecisionRegistry.close(decisionId, reason);
+    }
+
+    /** Opens the form decision for a modal a handler opened during an engine answer to {@code origin}. */
+    public static Decision open(Decision origin, EngineInteraction ix, Game game, Player player) {
+        Modal modal = ix.getOpenedModal();
+        String pseudoMessage = "form-" + origin.source().messageId() + "-" + ix.userId();
+        String id = "f" + origin.source().messageId() + "-" + ix.userId();
+        InputSchema schema = schema(modal);
+        Decision d = new Decision(
+                id,
+                game.getName(),
+                KIND,
+                0,
+                game.getLastModifiedDate(),
+                new Target(player.getUserID(), player.getFaction(), player.getColor(), "interaction_user"),
+                "player",
+                "private",
+                modal.getTitle(),
+                List.of(
+                        new Option(SUBMIT, "Submit", "primary", null, false, true, modal.getId(), null, null),
+                        new Option(CANCEL, "Cancel", "secondary", null, false, false, null, null, null)),
+                new Source(origin.source().channelId(), pseudoMessage, modal.getId(), true),
+                System.currentTimeMillis(),
+                0,
+                null,
+                null,
+                List.of(schema));
+        Decision stored = DecisionRegistry.open(d);
+        open.put(stored.id(), new Form(stored.id(), modal, origin.source().channelId(), origin.source().messageId(), ix.userId()));
+        return stored;
+    }
+
+    public static InputSchema schema(Modal modal) {
+        Map<String, String> labels = new java.util.HashMap<>();
+        for (Label l : modal.getComponentTree().findAll(Label.class)) {
+            String child = l.getChild() instanceof TextInput t ? t.getCustomId()
+                    : l.getChild() instanceof StringSelectMenu s ? s.getCustomId() : null;
+            if (child != null) labels.put(child, l.getLabel());
+        }
+        List<InputField> fields = new ArrayList<>();
+        for (TextInput t : modal.getComponentTree().findAll(TextInput.class)) {
+            fields.add(new InputField(
+                    t.getCustomId(),
+                    labels.get(t.getCustomId()),
+                    NUMERIC.contains(t.getCustomId()) ? "number" : "text",
+                    t.isRequired(),
+                    t.getMinLength() < 0 ? null : t.getMinLength(),
+                    t.getMaxLength() < 0 ? null : t.getMaxLength(),
+                    null,
+                    null,
+                    t.getStyle() == TextInputStyle.PARAGRAPH,
+                    t.getPlaceHolder(),
+                    t.getValue(),
+                    null));
+        }
+        for (StringSelectMenu s : modal.getComponentTree().findAll(StringSelectMenu.class)) {
+            List<Choice> choices = new ArrayList<>();
+            for (SelectOption o : s.getOptions())
+                choices.add(new Choice(o.getValue(), o.getLabel(), o.getDescription(), o.isDefault()));
+            fields.add(new InputField(
+                    s.getCustomId(),
+                    labels.getOrDefault(s.getCustomId(), s.getPlaceholder()),
+                    "choice",
+                    s.getMinValues() > 0,
+                    null,
+                    null,
+                    s.getMinValues(),
+                    s.getMaxValues(),
+                    false,
+                    s.getPlaceholder(),
+                    null,
+                    choices));
+        }
+        return new InputSchema(modal.getId(), "form", modal.getTitle(), fields);
+    }
+
+    /** Checks answer inputs against a schema; returns an error text or null. Multi-values are "\n"-joined. */
+    @Nullable
+    public static String validate(InputSchema schema, Map<String, String> inputs) {
+        Map<String, String> in = inputs == null ? Map.of() : inputs;
+        for (String k : in.keySet())
+            if (schema.fields().stream().noneMatch(f -> f.id().equals(k))) return "Unknown field " + k + ".";
+        for (InputField f : schema.fields()) {
+            String v = in.get(f.id());
+            if (v == null || v.isEmpty()) {
+                if (f.required()) return "Field " + f.id() + " is required.";
+                continue;
+            }
+            switch (f.type()) {
+                case "number" -> {
+                    try {
+                        Integer.parseInt(v.trim());
+                    } catch (NumberFormatException e) {
+                        return "Field " + f.id() + " must be a whole number.";
+                    }
+                }
+                case "choice" -> {
+                    String err = validateChoice(f, List.of(v.split("\n")));
+                    if (err != null) return err;
+                }
+                default -> {}
+            }
+            if (!"choice".equals(f.type())) {
+                if (f.minLength() != null && v.length() < f.minLength()) return "Field " + f.id() + " is too short.";
+                if (f.maxLength() != null && f.maxLength() > 0 && v.length() > f.maxLength())
+                    return "Field " + f.id() + " is too long.";
+            }
+        }
+        return null;
+    }
+
+    @Nullable
+    public static String validateChoice(InputField f, List<String> values) {
+        int min = f.minValues() == null ? 1 : f.minValues(), max = f.maxValues() == null ? 1 : f.maxValues();
+        if (values.size() < min || values.size() > max)
+            return "Pick between " + min + " and " + max + " option(s).";
+        for (String v : values)
+            if (f.choices().stream().noneMatch(c -> c.value().equals(v))) return "Not an option: " + v + ".";
+        if (values.stream().distinct().count() != values.size()) return "Duplicate option.";
+        return null;
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/interaction/JdaInteraction.java b/src/main/java/ti4/selfhost/engine/interaction/JdaInteraction.java
new file mode 100644
index 0000000..745ffc5
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/interaction/JdaInteraction.java
@@ -0,0 +1,154 @@
+package ti4.selfhost.engine.interaction;
+
+import java.util.List;
+import java.util.concurrent.TimeUnit;
+import javax.annotation.Nullable;
+import net.dv8tion.jda.api.components.MessageTopLevelComponent;
+import net.dv8tion.jda.api.components.tree.MessageComponentTree;
+import net.dv8tion.jda.api.entities.Message;
+import net.dv8tion.jda.api.entities.channel.middleman.MessageChannel;
+import net.dv8tion.jda.api.events.interaction.GenericInteractionCreateEvent;
+import net.dv8tion.jda.api.events.interaction.ModalInteractionEvent;
+import net.dv8tion.jda.api.events.interaction.component.ButtonInteractionEvent;
+import net.dv8tion.jda.api.events.interaction.component.GenericComponentInteractionCreateEvent;
+import net.dv8tion.jda.api.interactions.callbacks.IDeferrableCallback;
+import net.dv8tion.jda.api.interactions.callbacks.IMessageEditCallback;
+import net.dv8tion.jda.api.utils.FileUpload;
+import net.dv8tion.jda.api.utils.messages.MessageCreateData;
+import org.apache.commons.lang3.function.Consumers;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.game.persistence.GameManager;
+import ti4.logging.BotLogger;
+import ti4.message.MessageHelper;
+import ti4.selfhost.engine.Interaction;
+import ti4.service.game.GameNameService;
+
+/**
+ * {@link Interaction} over a real JDA event (Discord path). Each op is exactly what the helper it was extracted from
+ * did before (ButtonHelper.deleteMessage, MessageHelper.sendEphemeralMessageToEventChannel, ...), so Discord-path
+ * behaviour is unchanged.
+ */
+public final class JdaInteraction implements Interaction {
+    private final GenericInteractionCreateEvent event;
+
+    public JdaInteraction(GenericInteractionCreateEvent event) {
+        this.event = event;
+    }
+
+    public GenericInteractionCreateEvent event() {
+        return event;
+    }
+
+    @Override
+    @Nullable
+    public Game game() {
+        String name = GameNameService.getGameNameFromChannel(event);
+        return GameManager.isValid(name) ? GameManager.getManagedGame(name).getGame() : null;
+    }
+
+    @Override
+    @Nullable
+    public Player player() {
+        Game g = game();
+        return g == null ? null : g.getPlayer(userId());
+    }
+
+    @Override
+    public String userId() {
+        return event.getUser().getId();
+    }
+
+    @Override
+    public String componentId() {
+        if (event instanceof GenericComponentInteractionCreateEvent c) return c.getComponentId();
+        if (event instanceof ModalInteractionEvent m) return m.getModalId();
+        return "";
+    }
+
+    @Override
+    public MessageChannel channel() {
+        return event.getMessageChannel();
+    }
+
+    @Override
+    @Nullable
+    public String messageId() {
+        if (event instanceof GenericComponentInteractionCreateEvent c) return c.getMessageId();
+        if (event instanceof ModalInteractionEvent m && m.getMessage() != null) return m.getMessage().getId();
+        return null;
+    }
+
+    @Override
+    @Nullable
+    public Message message() {
+        if (event instanceof GenericComponentInteractionCreateEvent c) return c.getMessage();
+        if (event instanceof ModalInteractionEvent m) return m.getMessage();
+        return null;
+    }
+
+    @Override
+    public boolean isEngine() {
+        return false;
+    }
+
+    @Override
+    public void deferEdit() {
+        if (event instanceof IMessageEditCallback cb && !cb.isAcknowledged())
+            cb.deferEdit().queue(Consumers.nop(), BotLogger::catchRestError);
+    }
+
+    @Override
+    public void reply(MessageCreateData data) {
+        event.getMessageChannel().sendMessage(data).queue(Consumers.nop(), BotLogger::catchRestError);
+    }
+
+    @Override
+    public void replyEphemeral(MessageCreateData data) {
+        if (event instanceof GenericComponentInteractionCreateEvent e) {
+            e.getHook().setEphemeral(true).sendMessage(data).queue(Consumers.nop(), BotLogger::catchRestError);
+        } else {
+            reply(data);
+        }
+    }
+
+    @Override
+    public void replyEphemeral(String text) {
+        if (event instanceof GenericComponentInteractionCreateEvent e) {
+            e.getHook().setEphemeral(true).sendMessage(text).queue(Consumers.nop(), BotLogger::catchRestError);
+        } else {
+            MessageHelper.sendMessageToChannel(event.getMessageChannel(), text);
+        }
+    }
+
+    @Override
+    public void editComponents(MessageComponentTree tree) {
+        if (!(event instanceof GenericComponentInteractionCreateEvent e)) return;
+        if (e.getMessage().isEphemeral()) // only the interaction webhook can edit an ephemeral message
+            e.getHook().editOriginalComponents(tree.getComponents()).queue(Consumers.nop(), BotLogger::catchRestError);
+        else e.getMessage().editMessageComponents(tree).queue(Consumers.nop(), BotLogger::catchRestError);
+    }
+
+    @Override
+    public void editMessage(String content, List<? extends MessageTopLevelComponent> components, List<FileUpload> files) {
+        if (event instanceof IDeferrableCallback cb) {
+            cb.getHook()
+                    .editOriginal(content)
+                    .setComponents(components)
+                    .setFiles(files)
+                    .queue(Consumers.nop(), BotLogger::catchRestError);
+        }
+    }
+
+    @Override
+    public void deleteMessage() {
+        if (event instanceof ButtonInteractionEvent b)
+            b.getHook().deleteOriginal().queue(Consumers.nop(), BotLogger::catchRestError);
+    }
+
+    @Override
+    public void deleteMessage(int delaySeconds) {
+        if (event instanceof ButtonInteractionEvent b)
+            b.getHook().deleteOriginal().queueAfter(Math.min(delaySeconds, 20), TimeUnit.SECONDS);
+    }
+}
