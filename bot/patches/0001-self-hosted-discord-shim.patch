@@ -0,0 +1,46 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * Draw action cards offered by an effect: draw_1_AC, draw_1_ACDelete, drawActionCards_&lt;n&gt;, draw7AC ("draw up
+ * to 7"). Low priority: when these sit in a message another kind owns (e.g. a strategy card's), that kind wins.
+ * Politics' "draw2 AC" belongs to the strategy-card area and is not typed here. Value: {count, upTo}.
+ */
+public class ActionCardDrawKind implements KindSpec {
+
+    @Override
+    public String kind() {
+        return "action_card.draw";
+    }
+
+    @Override
+    public int priority() {
+        return 10;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return handlerId.equals("draw_1_AC")
+                || handlerId.equals("draw_1_ACDelete")
+                || handlerId.equals("draw7AC")
+                || handlerId.matches("drawActionCards_\\d+");
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        Map<String, Object> v = new LinkedHashMap<>();
+        if (handlerId.equals("draw7AC")) {
+            v.put("count", 7);
+            v.put("upTo", true);
+        } else {
+            v.put("count", handlerId.startsWith("drawActionCards_")
+                    ? CardKinds.parseInt(handlerId.substring("drawActionCards_".length()), 1)
+                    : 1);
+            v.put("upTo", false);
+        }
+        return v;
+    }
+}
