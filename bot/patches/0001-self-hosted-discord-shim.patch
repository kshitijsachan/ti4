+    // ------------------------------------------------------------------ target resolution
+
+    /** The user whose interaction produced this message (Discord's interaction_metadata / legacy interaction). */
+    static String interactionUser(DataObject msg) {
+        for (String key : new String[] {"interaction_metadata", "interaction"}) {
+            if (!msg.hasKey(key) || msg.isNull(key)) continue;
+            DataObject meta = msg.getObject(key);
+            if (meta.hasKey("user") && !meta.isNull("user")) return meta.getObject("user").getString("id", null);
+        }
+        return null;
+    }
+
+    /** Owner of one option of a mixed-owner menu (FFCC_/spoof prefix), null if the option has none. */
+    static Target optionOwner(Game game, String customId) {
+        ComponentIdEnvelope env = ComponentIdEnvelope.decode(customId);
+        String f = env.ownerFaction() != null ? env.ownerFaction() : env.spoofedFaction();
+        Player p = f == null ? null : game.getPlayerFromColorOrFaction(f);
+        return p == null ? null : target(p, env.ownerFaction() != null ? "owner_prefix" : "spoof_prefix");
+    }
+
+    static Target resolveTarget(
+            Game game,
+            List<RawControl> controls,
+            String channelId,
+            boolean ephemeral,
+            String token,
+            String metaUserId,
+            String content) {
+        // 1. FFCC_<faction>_ / dummyPlayerSpoof<faction>_ on the options (2,232 of 5,495 button sites).
+        Set<String> owners = new LinkedHashSet<>();
+        Set<String> spoofs = new LinkedHashSet<>();
+        int unowned = 0;
+        for (RawControl c : controls) {
+            ComponentIdEnvelope env = ComponentIdEnvelope.decode(c.customId);
+            if (env.ownerFaction() != null) owners.add(env.ownerFaction());
+            else if (env.spoofedFaction() != null) spoofs.add(env.spoofedFaction());
+            else unowned++;
+        }
+        if (owners.size() == 1 && spoofs.isEmpty()) {
+            Player p = game.getPlayerFromColorOrFaction(owners.iterator().next());
+            if (p != null) return target(p, "owner_prefix");
+        }
+        if (spoofs.size() == 1 && owners.isEmpty()) {
+            Player p = game.getPlayerFromColorOrFaction(spoofs.iterator().next());
+            if (p != null) return target(p, "spoof_prefix");
+        }
+        // 2. Interaction replies / followups / ephemerals: whoever made the interaction.
+        if (token != null) {
+            InteractionTracker.Info info = InteractionTracker.byToken(token);
+            if (info != null) {
+                Player p = game.getPlayer(info.userId());
+                if (p != null) return target(p, "interaction_user");
+            }
+        }
+        // 2b. Same fact from the message itself (interaction_metadata.user): survives restarts and unknown tokens.
+        if (metaUserId != null) {
+            Player p = game.getPlayer(metaUserId);
+            if (p != null) return target(p, "interaction_user");
+        }
+        // 3. The player's own cards-info thread / private channel.
+        for (Player p : game.getPlayers().values()) {
+            if (channelId != null && channelId.equals(p.getCardsInfoThreadID())) return target(p, "cards_thread");
+            if (channelId != null && channelId.equals(p.getPrivateChannelID())) return target(p, "private_channel");
+        }
+        // 4. Exactly one seated player mentioned (weak; kinds may override).
+        if (content != null && owners.isEmpty()) {
+            Set<String> mentioned = new HashSet<>();
+            Matcher mm = MENTION.matcher(content);
+            while (mm.find()) if (game.getPlayer(mm.group(1)) != null) mentioned.add(mm.group(1));
+            if (mentioned.size() == 1) return target(game.getPlayer(mentioned.iterator().next()), "mention");
+        }
+        return new Target(null, null, null, owners.size() > 1 ? "mixed_owners" : "none");
+    }
+
+    /** Saving handlers that are perpetual menus on their own (not questions). */
+    private static final java.util.Set<String> INFO_ALONE = java.util.Set.of("getModifyTiles", "purgeOverrule");
+
+    /**
+     * Saving handlers (prefixes) that ride along on the game's info menus (round summaries, presets, player setup,
+     * dismiss): info only next to at least one read-only option.
+     */
+    private static final List<String> INFO_COMPANIONS = List.of(
+            "deleteButtons", "editRoundSummary_", "editEndOfRoundSummaries", "startPlayerSetup", "removePreset_",
+            // Agent shortcuts on the cards-info menu (c1): keep the menu info, the agents have their own prompts.
+            "exhaustAgent_hacanagent", "getAgentSelection_saaragent");
+
+    /**
+     * Handlers that do not save (save = false) but start an action, not a view: "Use X Agent" (getAgentSelection_
+     * posts the agent's target picker; leader.use types it). Read-only for the undo log, not for capture: a message of
+     * them alone is a decision (the cards-info shortcut getAgentSelection_saaragent stays an INFO_COMPANION).
+     */
+    private static final List<String> ACTION_NOT_SAVED = List.of(
+            "getAgentSelection_",
+            // Emelpar's "Ready Another Player's Components" -> faction picker -> that faction's emelparReady_ menu.
+            "getOtherFactionsEmelpar",
+            "getEmelparButtons_",
+            // "Get a Technology" -> colour picker -> that colour's techs (no save until the tech is taken): a step of
+            // a technology gain, not an info view (live pbd230: Deepwrought's starting-tech colour prompt was closed
+            // as an info menu, so setup waited on the bot forever).
+            "getAllTechOfType_",
+            "acquireAFreeTech");
+
+    /**
+     * An info menu, not a decision: every option opens a read-only handler (save = false: info, decks, views,
+     * preferences), one of {@link #INFO_ALONE}, or (with at least one read-only option) an {@link #INFO_COMPANIONS}.
+     */
+    static boolean isInfoMenu(List<RawControl> controls, List<String> handlerIds) {
+        boolean readOnlySeen = false;
+        boolean infoSeen = false; // a read-only option other than undo
+        boolean shortcutSeen = false; // an agent shortcut companion
+        boolean aloneSeen = false;
+        boolean companionSeen = false;
+        for (int i = 0; i < controls.size(); i++) {
+            String h = handlerIds.get(i);
+            if (h == null) return false;
+            if (h.startsWith("exhaustAgent_") || h.startsWith("getAgentSelection_")) shortcutSeen = true;
+            if (INFO_ALONE.contains(h)) {
+                aloneSeen = true;
+                continue;
+            }
+            boolean companion = false;
+            for (String c : INFO_COMPANIONS) if (h.startsWith(c)) companion = true;
+            if (companion) {
+                companionSeen = true;
+                continue;
+            }
+            boolean readOnly;
+            try {
+                readOnly = ti4.discord.interactions.buttons.ButtonProcessor.isReadOnly(controls.get(i).customId)
+                        && !ACTION_NOT_SAVED.stream().anyMatch(h::startsWith);
+            } catch (Throwable t) {
+                readOnly = false;
+            }
+            if (!readOnly) return false;
+            readOnlySeen = true;
+            if (!h.startsWith("ultimateUndo")) infoSeen = true;
+        }
+        // An agent offer with only an undo button next to it ("Use Hacan Agent" + UNDO) is a question, not the
+        // cards-info menu the shortcut companions are for (scenario faction-hacan: the offer was never captured).
+        if (shortcutSeen && !infoSeen) return false;
+        if (readOnlySeen) return true;
+        // Without a read-only option: only the stand-alone menus (plus a dismiss button) count.
+        if (!aloneSeen) return false;
+        for (String h : handlerIds) if (!INFO_ALONE.contains(h) && !h.startsWith("deleteButtons")) return false;
+        return companionSeen || aloneSeen;
+    }
+
+    static boolean obsolete(KindSpec spec, KindSpec.CaptureContext ctx) {
+        try {
+            return phasePassed(spec.kind(), ctx) || spec.obsolete(ctx);
+        } catch (Exception e) {
+            return false;
+        }
+    }
+
+    /**
+     * The message was posted more than ms ago (snowflake time). Capture reads the game from its last save
+     * (cachedGame), which lags behind a prompt the bot posts mid-interaction: a phase-based obsolete() rule must not
+     * close a fresh prompt on the strength of the previous phase (see FRESH_MS).
+     */
+    /**
+     * Prompts captured ahead of their save: message id -> post time. Capture reads the game from its last save
+     * (cachedGame), and a prompt posted mid-interaction is captured before that interaction saves, i.e. against the
+     * state before the action that posted it (live, one bug class: the homework token payload read before the phase
+     * flag, the Milty slice board against a half-loaded draft, the round-2 first SC pick closed as obsolete because the
+     * save still said statusHomework). Such a prompt is opened without a capture-time obsolete() verdict and settled
+     * on the first save at or after its post time (Engine.settleAhead), for every kind.
+     */
+    static final Map<String, Long> AHEAD = new ConcurrentHashMap<>();
+
+    /** Post time (ms) of a snowflake message id; -1 when not a snowflake. */
+    static long postTime(String messageId) {
+        try {
+            return (Long.parseUnsignedLong(messageId) >>> 22) + 1420070400000L;
+        } catch (Exception e) {
+            return -1;
+        }
+    }
+
+    /** True (and remembered) when the game read is a save older than the message: see AHEAD. */
+    static boolean markIfAhead(Game game, String messageId) {
+        Long marked = AHEAD.get(messageId);
+        if (marked != null && System.currentTimeMillis() - marked < 600_000 && game.getLastModifiedDate() < marked) {
+            EngineMetrics.count("capture.ahead_of_save");
+            return true;
+        }
+        if (marked != null) AHEAD.remove(messageId);
+        long at = postTime(messageId);
+        if (at <= 0 || game.getLastModifiedDate() >= at) return false;
+        if (AHEAD.size() > 2000) AHEAD.entrySet().removeIf(e -> System.currentTimeMillis() - e.getValue() > 600_000);
+        AHEAD.put(messageId, at);
+        EngineMetrics.count("capture.ahead_of_save");
+        return true;
+    }
+
+    /** The game is a save at or after the prompt's post time: it is settled (forgotten here) and true is returned. */
+    static boolean settles(String messageId, Game game) {
+        Long at = AHEAD.get(messageId);
+        if (at == null || game.getLastModifiedDate() < at) return false;
+        return AHEAD.remove(messageId) != null;
+    }
+
+    public static boolean olderThan(String messageId, long ms) {
+        try {
+            long at = (Long.parseUnsignedLong(messageId) >>> 22) + 1420070400000L;
+            return System.currentTimeMillis() - at > ms;
+        } catch (Exception e) {
+            return false;
+        }
+    }
+
+    /** Agenda windows (not the in-advance preassign): only during the agenda phase. */
+    private static final java.util.Set<String> AGENDA_PHASE_KINDS = java.util.Set.of(
+            "agenda.when", "agenda.after", "agenda.shenanigans", "agenda.rider", "agenda.tiebreak", "agenda.vote",
+            "agenda.vote_step", "agenda.resolve", "agenda.next");
+    /** Status-phase steps (status.score_secret is not here: secrets are scored in the action phase too). */
+    private static final java.util.Set<String> STATUS_PHASE_KINDS =
+            java.util.Set.of("status.score", "status.homework", "status.reveal_objective", "status.advance");
+
+    /**
+     * The phase a decision belongs to is over: every answer would be refused, and it only fills the queue (stale-scan
+     * 03:40: ~400 open agenda/status/tactical decisions from earlier phases across live games). Generic rules by kind;
+     * kinds add their own via obsolete(). Game phases: agenda* (agenda, agendaVoting, agendawaiting, agendaEnd),
+     * status* (statusScoring, statusHomework), action, strategy.
+     */
+    /**
+     * Younger than this, a prompt is "fresh": the game capture reads may still be the save before the interaction
+     * that posted it (live pbd223 / pbd229 / pbd188: the last "Ready For Strategy Phase" press starts the strategy
+     * phase and posts the first pick, while the saved game still says statusHomework, so StrategyCardPickKind.obsolete
+     * closed the pick at capture and the picker had nothing to answer until a restart rebuilt it). The state-change
+     * sweep (Engine.closeObsolete, on the live game) closes a fresh prompt that really is obsolete.
+     */
+    public static final long FRESH_MS = 60_000;
+
+    /**
+     * Kinds whose prompts belong to one game round: agenda windows and votes (not the in-advance preassign), status
+     * steps (not secret scoring, also an action-phase prompt), every strategy-card prompt but the next-round pick
+     * queue, combat, tactical actions and their production, the turn menu.
+     */
+    static boolean roundScoped(String kind) {
+        if (kind == null) return false;
+        if (kind.startsWith("agenda.")) return !"agenda.preassign".equals(kind);
+        if (kind.startsWith("status.")) return !"status.score_secret".equals(kind);
+        if (kind.startsWith("strategy_card")) return !"strategy_card.queue_pick".equals(kind);
+        return kind.startsWith("combat.") || kind.startsWith("tactical.") || kind.startsWith("production.")
+                || "turn.action".equals(kind);
+    }
+
+    static boolean phasePassed(String kind, KindSpec.CaptureContext ctx) {
+        ti4.game.Game game = ctx.game();
+        if (game == null) return false;
+        String phase = game.getPhaseOfGame() == null ? "" : game.getPhaseOfGame();
+        if (phase.isEmpty()) return false;
+        // Never on a fresh prompt: the bot may post a phase's first prompt just before it records the new phase / active
+        // player; these rules are for leftovers.
+        if (!olderThan(ctx.messageId(), FRESH_MS)) return false;
+        // Posted in an earlier round: round-scoped prompts never carry over (live pbd436: the rebuild after a restart
+        // re-opened round 2's follow prompts in round 3; an old pre-decline would pre-pass this round's card).
+        if (roundScoped(kind) && RoundClock.beforeThisRound(game, ctx.messageId())) return true;
+        if (AGENDA_PHASE_KINDS.contains(kind)) return !phase.startsWith("agenda");
+        if (STATUS_PHASE_KINDS.contains(kind)) return !phase.startsWith("status");
+        if (kind.startsWith("tactical.") || "turn.action".equals(kind)) {
+            if (!"action".equals(phase)) return true;
+            // Only the active player's turn prompts (Naalu's agent lets another seat act for them).
+            Player target = ctx.player();
+            Player active = game.getActivePlayer();
+            return target != null && active != null && !target.getUserID().equals(active.getUserID())
+                    && !game.isNaaluAgent();
+        }
+        return false;
+    }
+
+    public static Target target(Player p, String how) {
+        return new Target(p.getUserID(), nullIfUnset(p.getFaction()), nullIfUnset(p.getColor()), how);
+    }
+
+    /** Player.getFaction()/getColor() return the string "null" before a faction/colour is picked. */
+    static String nullIfUnset(String s) {
+        return s == null || s.isBlank() || "null".equals(s) ? null : s;
+    }
+
+    private static boolean isPrivateChannel(Game game, String channelId) {
+        if (channelId == null) return false;
+        for (Player p : game.getPlayers().values()) {
+            if (channelId.equals(p.getCardsInfoThreadID()) || channelId.equals(p.getPrivateChannelID())) return true;
+        }
+        return false;
+    }
+
+    /** channel id -> game name, for channels JDA has not cached (threads after a restart, private channels). */
+    private static final Map<String, String> channelGame = new ConcurrentHashMap<>();
+    private static volatile long lastScan;
+
+    static Game gameForChannel(String channelId) {
+        if (channelId == null || JdaService.jda == null) return null;
+        String name = null;
+        Channel ch = JdaService.jda.getChannelById(Channel.class, channelId);
+        if (ch != null) name = GameNameService.getGameNameFromChannel(ch);
+        if (name == null || !GameManager.isValid(name)) name = channelGame.get(channelId);
+        if (name == null) name = scanForChannel(channelId);
+        if (name == null) return null;
+        return cachedGame(name);
+    }
+
+    private record Loaded(long mtime, Game game) {}
+
+    private static final Map<String, Loaded> loaded = new ConcurrentHashMap<>();
+
+    /**
+     * Capture only reads the game (players, factions, threads). GameManager loads it from disk on every access, which
+     * put a full game parse on the JDA REST thread for every message with buttons (p95 80 ms, max 2 s live). Reuse
+     * the last load until the game file changes (one stat per message).
+     */
+    static Game cachedGame(String name) {
+        java.io.File f = ti4.helpers.Storage.getGameFile(name + ti4.helpers.Constants.TXT);
+        long mtime = f.lastModified();
+        Loaded hit = loaded.get(name);
+        if (hit != null && hit.mtime() == mtime && mtime != 0) return hit.game();
+        ManagedGame mg = GameManager.getManagedGame(name);
+        Game g = mg == null ? null : mg.getGame();
+        if (g != null) {
+            if (loaded.size() > 200) loaded.clear();
+            loaded.put(name, new Loaded(mtime, g));
+        }
+        return g;
+    }
+
+    /**
+     * A channel JDA does not know by name (uncached thread, private channel): find the live game that owns it via
+     * its players' cards-info threads / private channels. Rescans at most every 10 s.
+     */
+    private static String scanForChannel(String channelId) {
+        long now = System.currentTimeMillis();
+        if (now - lastScan < 10_000 || !JdaService.isReadyToReceiveCommands()) return null;
+        lastScan = now;
+        try {
+            for (ManagedGame mg : GameManager.getManagedGames()) {
+                if (mg.isHasEnded() || now - mg.getLastModifiedDate() > 24L * 3600 * 1000) continue;
+                Game g = cachedGame(mg.getName());
+                if (g == null) continue;
+                for (Player p : g.getPlayers().values()) {
+                    if (p.getCardsInfoThreadID() != null) channelGame.put(p.getCardsInfoThreadID(), g.getName());
+                    if (p.getPrivateChannelID() != null) channelGame.put(p.getPrivateChannelID(), g.getName());
+                }
+            }
+        } catch (Exception e) {
+            BotLogger.error("engine: channel scan failed", e);
+        }
+        return channelGame.get(channelId);
+    }
+
+    // ------------------------------------------------------------------ components
+
+    record RawControl(String customId, String label, String style, String emoji, boolean disabled, String value) {
+        String optionId() {
+            return value == null ? customId : customId + "#" + value;
+        }
+    }
+
+    private static final String[] STYLES = {"", "primary", "secondary", "success", "danger", "link", "premium"};
+
+    private static void collect(DataArray arr, List<RawControl> out) {
+        for (int i = 0; i < arr.length(); i++) {
+            if (!arr.isType(i, net.dv8tion.jda.api.utils.data.DataType.OBJECT)) continue;
+            DataObject c = arr.getObject(i);
+            int type = c.getInt("type", 0);
+            if (type == 2 && c.hasKey("custom_id") && !c.isNull("custom_id")) {
+                int style = c.getInt("style", 2);
+                String emoji = null;
+                if (c.hasKey("emoji") && !c.isNull("emoji")) {
+                    DataObject e = c.getObject("emoji");
+                    emoji = e.isNull("id") || !e.hasKey("id") ? e.getString("name", null) : e.getString("id", null);
+                }
+                out.add(new RawControl(
+                        c.getString("custom_id"),
+                        c.getString("label", ""),
+                        style >= 0 && style < STYLES.length ? STYLES[style] : String.valueOf(style),
+                        emoji,
+                        c.getBoolean("disabled", false),
+                        null));
+            } else if (type == 3 && c.hasKey("custom_id")) {
+                DataArray opts = c.optArray("options").orElse(DataArray.empty());
+                for (int j = 0; j < opts.length(); j++) {
+                    DataObject o = opts.getObject(j);
+                    out.add(new RawControl(
+                            c.getString("custom_id"),
+                            o.getString("label", ""),
+                            "select",
+                            null,
+                            c.getBoolean("disabled", false),
+                            o.getString("value", "")));
+                }
+            }
+            if (c.hasKey("components") && !c.isNull("components")) collect(c.getArray("components"), out);
+            if (c.hasKey("accessory") && !c.isNull("accessory"))
+                collect(DataArray.empty().add(c.getObject("accessory")), out);
+        }
+    }
+
+    /** Select menus on the message as typed inputs (one "choice" field each). null when there are none. */
+    static List<InputSchema> selectInputs(DataObject msg) {
+        List<InputSchema> out = new ArrayList<>();
+        if (msg.hasKey("components") && !msg.isNull("components")) collectSelects(msg.getArray("components"), out);
+        return out.isEmpty() ? null : out;
+    }
+
+    private static void collectSelects(DataArray arr, List<InputSchema> out) {
+        for (int i = 0; i < arr.length(); i++) {
+            if (!arr.isType(i, net.dv8tion.jda.api.utils.data.DataType.OBJECT)) continue;
+            DataObject c = arr.getObject(i);
+            if (c.getInt("type", 0) == 3 && c.hasKey("custom_id")) {
+                List<Choice> choices = new ArrayList<>();
+                DataArray opts = c.optArray("options").orElse(DataArray.empty());
+                for (int j = 0; j < opts.length(); j++) {
+                    DataObject o = opts.getObject(j);
+                    choices.add(new Choice(
+                            o.getString("value", ""),
+                            o.getString("label", ""),
+                            o.getString("description", null),
+                            o.getBoolean("default", false)));
+                }
+                int min = c.getInt("min_values", 1), max = c.getInt("max_values", 1);
+                String placeholder = c.getString("placeholder", null);
+                out.add(new InputSchema(
+                        c.getString("custom_id"),
+                        "select",
+                        placeholder,
+                        List.of(new InputField(
+                                "values", placeholder, "choice", min > 0, null, null, min, max, false, placeholder,
+                                null, choices))));
+            }
+            if (c.hasKey("components") && !c.isNull("components")) collectSelects(c.getArray("components"), out);
+        }
+    }
+
+    private static String commonPrefix(List<String> ids) {
+        Set<String> heads = new LinkedHashSet<>();
+        for (String h : ids) {
+            if (h == null) continue;
+            int us = h.indexOf('_');
+            heads.add(us < 0 ? h : h.substring(0, us + 1));
+        }
+        return heads.isEmpty() ? null : heads.iterator().next();
+    }
+
+    // ------------------------------------------------------------------ http helpers
+
+    private static DataObject responseJson(Response res) throws IOException {
+        if (res.body() == null) return null;
+        String s = res.peekBody(16L * 1024 * 1024).string();
+        if (s.isBlank() || !s.trim().startsWith("{")) return null;
+        return DataObject.fromJson(s);
+    }
+
+    private static String nonce(Request req) {
+        try {
+            if (req.body() == null || req.body().contentType() == null
+                    || !"json".equals(req.body().contentType().subtype())) return "";
+            return DataObject.fromJson(bodyString(req)).getString("nonce", "");
+        } catch (Exception e) {
+            return "";
+        }
+    }
+
+    private static String bodyString(Request req) throws IOException {
+        if (req.body() == null) return "{}";
+        Buffer b = new Buffer();
+        req.body().writeTo(b);
+        return b.readUtf8();
+    }
+}
