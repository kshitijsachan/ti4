@@ -0,0 +1,68 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.selfhost.engine.EngineModels.Decision;
+import ti4.selfhost.engine.EngineModels.Target;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * Speaker breaks a tie (AgendaHelper.resolvingAnAgendaVote): FFCC_&lt;speaker&gt;_resolveAgendaVote_outcomeTie* &lt;outcome&gt;
+ * for tied outcomes, or — when nobody voted — every outcome as resolveAgendaVote_outcomeTie*_&lt;outcome&gt; (no owner),
+ * with planets reached through tiedPlanets_resolveAgendaVote_outcomeTie*_&lt;owner&gt;. Target: the speaker.
+ */
+public class AgendaTieBreakKind implements KindSpec {
+
+    @Override
+    public String kind() {
+        return "agenda.tiebreak";
+    }
+
+    @Override
+    public int priority() {
+        return 100;
+    }
+
+    @Override
+    public boolean matches(String h) {
+        return h.startsWith("resolveAgendaVote_outcomeTie*") || h.startsWith("tiedPlanets_resolveAgendaVote_outcomeTie*");
+    }
+
+    @Override
+    public Map<String, Object> value(String h, CaptureContext ctx) {
+        Map<String, Object> v = new LinkedHashMap<>();
+        if (h.startsWith("tiedPlanets_")) {
+            String who = h.substring(h.lastIndexOf('*') + 2);
+            Player p = ctx.game().getPlayerFromColorOrFaction(who);
+            v.put("planetOwner", p == null ? who : p.getFaction());
+            v.put("userId", p == null ? null : p.getUserID());
+            return v;
+        }
+        int star = h.lastIndexOf('*');
+        if (star < 0 || star + 2 > h.length()) return null;
+        String outcome = h.substring(star + 2); // same parse as the handler
+        v.put("outcome", outcome);
+        v.put("name", AgendaSupport.outcomeName(ctx.game(), outcome));
+        return v;
+    }
+
+    @Override
+    public Target target(CaptureContext ctx, Target resolved) {
+        Target s = AgendaSupport.speakerTarget(ctx.game(), "speaker");
+        return s == null ? resolved : s;
+    }
+
+    @Override
+    public String scope(CaptureContext ctx) {
+        return "player";
+    }
+
+    @Override
+    public String validate(Game game, Player answering, Decision decision, String optionId) {
+        Player speaker = game.getSpeaker();
+        if (speaker != null && speaker != answering) return "Only the speaker breaks ties.";
+        return null;
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/AgendaVoteKind.java b/src/main/java/ti4/selfhost/engine/kinds/AgendaVoteKind.java
new file mode 100644
index 0000000..9adcc6f
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/AgendaVoteKind.java
@@ -0,0 +1,216 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.function.Predicate;
+import javax.annotation.Nullable;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.selfhost.engine.DecisionRegistry;
+import ti4.selfhost.engine.EngineModels.Decision;
+import ti4.selfhost.engine.EngineModels.Option;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * "You are up to vote": FFCC_&lt;f&gt;_vote / FFCC_&lt;f&gt;_resolveAgendaVote_0 (abstain) / forceAbstainForPlayer_&lt;f&gt;
+ * (AgendaHelper.startTheVoting / resolvingAnAgendaVote). The vote option's value carries everything a voter needs
+ * (outcomes, ready planets with their votes, total available), and the decision takes one structured answer
+ * {@code {outcome, planets[], sources[], allPlanets?}} that the engine executes as the five-step button flow
+ * (vote → outcome → exhaust planets → done → confirm). Abstain is the plain resolveAgendaVote_0 option.
+ */
+public class AgendaVoteKind implements KindSpec {
+    private static final long STEP_TIMEOUT_MS = 8000;
+
+    @Override
+    public String kind() {
+        return "agenda.vote";
+    }
+
+    @Override
+    public int priority() {
+        return 100;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return "vote".equals(handlerId)
+                || "resolveAgendaVote_0".equals(handlerId)
+                || handlerId.startsWith("forceAbstainForPlayer_");
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        Map<String, Object> v = new LinkedHashMap<>();
+        if ("resolveAgendaVote_0".equals(handlerId)) {
+            v.put("action", "abstain");
+            return v;
+        }
+        if (handlerId.startsWith("forceAbstainForPlayer_")) {
+            v.put("action", "force_abstain");
+            v.put("faction", handlerId.substring("forceAbstainForPlayer_".length()));
+            return v;
+        }
+        if (!"vote".equals(handlerId)) return null;
+        v.put("action", "vote");
+        v.putAll(ballot(ctx.game(), ctx.player()));
+        return v;
+    }
+
+    /** What a voter chooses from: outcome vocabulary, ready planets → votes, total votes the engine allows. */
+    static Map<String, Object> ballot(Game game, @Nullable Player player) {
+        Map<String, Object> v = new LinkedHashMap<>();
+        v.put("outcomeType", AgendaSupport.outcomeType(game));
+        v.put("outcomes", AgendaSupport.outcomes(game));
+        List<Map<String, Object>> planets = new ArrayList<>();
+        if (player != null) {
+            for (Map.Entry<String, Integer> e : AgendaSupport.planetVotes(game, player).entrySet()) {
+                Map<String, Object> p = new LinkedHashMap<>();
+                p.put("planet", e.getKey());
+                p.put("votes", e.getValue());
+                planets.add(p);
+            }
+        }
+        v.put("planets", planets);
+        v.put("available", player == null ? 0 : AgendaSupport.availableVotes(game, player));
+        return v;
+    }
+
+    @Override
+    public String validate(Game game, Player answering, Decision decision, String optionId) {
+        if (optionId.contains("forceAbstainForPlayer_")) return null;
+        Player active = game.getActivePlayer();
+        if (active != null && active != answering) return "It is not your turn to vote.";
+        return null;
+    }
+
+    @Override
+    public boolean acceptsPayload() {
+        return true;
+    }
+
+    @Override
+    public String answerPayload(PayloadAnswer steps, Map<String, Object> payload) throws Exception {
+        Game game = steps.game();
+        Player answering = steps.player();
+        Decision d = steps.decision();
+        if (game == null || answering == null || d == null) return "That decision is no longer open.";
+        String err = validate(game, answering, d, "vote");
+        if (err != null) return err;
+        return castVote(game, answering, d, "vote", payload, steps);
+    }
+
+    // ------------------------------------------------------------------ the vote flow (shared with pre-votes)
+
+    /**
+     * Runs the vote button flow from {@code startHandler} ("vote" or "preVote") on decision {@code start}.
+     * Returns an error text (the flow is left where it stopped; its prompts stay answerable) or null when done.
+     */
+    @SuppressWarnings("unchecked")
+    static String castVote(
+            Game game, Player p, Decision start, String startHandler, Map<String, Object> payload, Steps steps)
+            throws Exception {
+        if (Boolean.TRUE.equals(payload.get("abstain"))) {
+            Option abstain = option(start, h -> h.equals("resolveAgendaVote_0"));
+            if (abstain == null) return "No abstain option here.";
+            steps.press(start, abstain.id());
+            return null;
+        }
+        Object o = payload.get("outcome");
+        if (!(o instanceof String outcome) || outcome.isBlank()) return "payload.outcome is required (or abstain: true).";
+        List<String> planets = payload.get("planets") instanceof List<?> l ? (List<String>) l : List.of();
+        List<String> sources = payload.get("sources") instanceof List<?> l2 ? (List<String>) l2 : List.of();
+        boolean all = Boolean.TRUE.equals(payload.get("allPlanets"));
+        Map<String, Integer> votable = AgendaSupport.planetVotes(game, p);
+        for (String planet : planets) {
+            if (!votable.containsKey(planet)) return "Planet " + planet + " is not a ready planet you can vote with.";
+        }
+        Option begin = option(start, h -> h.equals(startHandler));
+        if (begin == null) return "No " + startHandler + " option here.";
+        String channel = start.source().channelId();
+        Predicate<Decision> mine = x -> channel.equals(x.source().channelId())
+                && (x.target() == null || x.target().userId() == null || p.getUserID().equals(x.target().userId()));
+
+        long s = steps.seq();
+        steps.press(start, begin.id());
+        Decision outs = steps.await(
+                s, x -> mine.test(x) && has(x, h -> h.startsWith("outcome_") || h.startsWith("planetOutcomes_")),
+                STEP_TIMEOUT_MS);
+        if (outs == null) return "The outcome prompt did not appear.";
+        Option pick = option(outs, h -> h.equalsIgnoreCase("outcome_" + outcome));
+        if (pick == null && has(outs, h -> h.startsWith("planetOutcomes_"))) {
+            Player owner = AgendaSupport.planetOwner(game, outcome);
+            Option ownerOpt = owner == null
+                    ? null
+                    : option(outs, h -> h.equalsIgnoreCase("planetOutcomes_" + owner.getFaction())
+                            || h.equalsIgnoreCase("planetOutcomes_" + owner.getColor()));
+            if (ownerOpt == null) return "Nobody controls planet " + outcome + "; choose it from the prompt.";
+            s = steps.seq();
+            steps.press(outs, ownerOpt.id());
+            outs = steps.await(s, x -> mine.test(x) && has(x, h -> h.startsWith("outcome_")), STEP_TIMEOUT_MS);
+            if (outs == null) return "The planet prompt did not appear.";
+            pick = option(outs, h -> h.equalsIgnoreCase("outcome_" + outcome));
+        }
+        if (pick == null) return "Outcome " + outcome + " is not offered; choose from the prompt.";
+        s = steps.seq();
+        steps.press(outs, pick.id());
+        Decision next = steps.await(
+                s, x -> mine.test(x) && has(x, h -> h.startsWith("exhaustForVotes_") || h.matches("resolveAgendaVote_\\d+")),
+                STEP_TIMEOUT_MS);
+        if (next == null) return "The planet exhaust prompt did not appear.";
+
+        if (has(next, h -> h.startsWith("exhaustForVotes_"))) {
+            List<Predicate<String>> presses = new ArrayList<>();
+            if (all) presses.add(h -> h.startsWith("exhaustForVotes_allPlanets"));
+            else for (String planet : planets) presses.add(h -> h.equals("exhaustForVotes_planet_" + planet));
+            for (String src : sources) {
+                String id = src.startsWith("exhaustForVotes_") ? src : "exhaustForVotes_" + src;
+                presses.add(h -> h.equals(id) || h.startsWith(id + "_"));
+            }
+            for (Predicate<String> want : presses) {
+                next = current(next);
+                if (next == null) return "The planet exhaust prompt closed early.";
+                Option ex = option(next, want);
+                if (ex == null) continue; // already used / not offered (e.g. a planet exhausted meanwhile)
+                s = steps.seq();
+                steps.press(next, ex.id());
+                // The handler edits this message (removes the button); wait for that before the next press so
+                // the edits do not overwrite each other.
+                String msg = next.source().messageId();
+                steps.await(s, x -> msg.equals(x.source().messageId()), 3000);
+            }
+            next = current(next);
+            if (next == null) return "The planet exhaust prompt closed early.";
+            Option done = option(next, h -> h.equals("proceedToFinalizingVote"));
+            if (done == null) return "No 'done exhausting' option.";
+            s = steps.seq();
+            steps.press(next, done.id());
+            next = steps.await(s, x -> mine.test(x) && has(x, h -> h.matches("resolveAgendaVote_\\d+")), STEP_TIMEOUT_MS);
+            if (next == null) return "The confirm prompt did not appear.";
+        }
+        Option confirm = option(next, h -> h.matches("resolveAgendaVote_\\d+"));
+        if (confirm == null) return "No confirm option.";
+        steps.press(next, confirm.id());
+        return null;
+    }
+
+    /** The newest open revision of the decision on the same message (ids change per revision), or null if closed. */
+    @Nullable
+    static Decision current(Decision d) {
+        String id = DecisionRegistry.decisionIdForMessage(d.source().messageId());
+        return id == null ? null : DecisionRegistry.get(id);
+    }
+
+    static boolean has(Decision d, Predicate<String> handler) {
+        return option(d, handler) != null;
+    }
+
+    @Nullable
+    static Option option(Decision d, Predicate<String> handler) {
+        for (Option o : d.options()) {
+            if (o.handler() != null && !o.disabled() && handler.test(o.handler())) return o;
+        }
+        return null;
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/AgendaVoteStepKind.java b/src/main/java/ti4/selfhost/engine/kinds/AgendaVoteStepKind.java
new file mode 100644
index 0000000..c547c73
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/AgendaVoteStepKind.java
@@ -0,0 +1,155 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.helpers.AgendaHelper;
+import ti4.helpers.Helper;
+import ti4.selfhost.engine.EngineModels.Progress;
+import ti4.selfhost.engine.EngineModels.Target;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * The intermediate prompts of a vote (what agenda.vote's structured answer walks through; a person or the legacy
+ * path may also step through them one by one): outcome_&lt;id&gt;, planetOutcomes_&lt;owner&gt;,
+ * exhaustForVotes_planet_&lt;p&gt; / _allPlanets_&lt;n&gt; / other sources, proceedToFinalizingVote, resetMyVote,
+ * resolveAgendaVote_&lt;n&gt; (confirm), distinguished_/distinguishedReverse_ (modify the count).
+ */
+public class AgendaVoteStepKind implements KindSpec {
+    private static final Pattern CONFIRM = Pattern.compile("resolveAgendaVote_(\\d+)");
+    private static final Pattern TRAILING_N = Pattern.compile(".*_(\\d+)$");
+
+    @Override
+    public String kind() {
+        return "agenda.vote_step";
+    }
+
+    @Override
+    public int priority() {
+        return 90;
+    }
+
+    @Override
+    public boolean matches(String h) {
+        return h.startsWith("outcome_")
+                || h.startsWith("planetOutcomes_")
+                || h.startsWith("exhaustForVotes_")
+                || h.equals("proceedToFinalizingVote")
+                || h.equals("resetMyVote")
+                || CONFIRM.matcher(h).matches()
+                || h.startsWith("distinguished_")
+                || h.startsWith("distinguishedReverse_");
+    }
+
+    @Override
+    public Map<String, Object> value(String h, CaptureContext ctx) {
+        Map<String, Object> v = new LinkedHashMap<>();
+        Matcher m;
+        if (h.startsWith("outcome_")) {
+            String outcome = h.substring("outcome_".length());
+            v.put("step", "outcome");
+            v.put("outcome", outcome);
+            v.put("name", AgendaSupport.outcomeName(ctx.game(), outcome));
+        } else if (h.startsWith("planetOutcomes_")) {
+            String who = h.substring("planetOutcomes_".length());
+            Player p = ctx.game().getPlayerFromColorOrFaction(who);
+            v.put("step", "planet_owner");
+            v.put("faction", p == null ? who : p.getFaction());
+            v.put("userId", p == null ? null : p.getUserID());
+        } else if (h.startsWith("exhaustForVotes_planet_")) {
+            String planet = h.substring("exhaustForVotes_planet_".length());
+            v.put("step", "exhaust");
+            v.put("planet", planet);
+            Player p = ctx.player();
+            v.put("votes", p == null ? null : AgendaHelper.getSpecificPlanetsVoteWorth(p, ctx.game(), planet));
+        } else if (h.startsWith("exhaustForVotes_allPlanets")) {
+            v.put("step", "exhaust_all");
+            v.put("votes", trailingNumber(h));
+        } else if (h.startsWith("exhaustForVotes_")) {
+            v.put("step", "source");
+            v.put("source", h.substring("exhaustForVotes_".length()));
+            v.put("votes", trailingNumber(h));
+        } else if (h.equals("proceedToFinalizingVote")) {
+            v.put("step", "done_exhausting");
+        } else if (h.equals("resetMyVote")) {
+            v.put("step", "reset");
+        } else if ((m = CONFIRM.matcher(h)).matches()) {
+            v.put("step", "confirm");
+            v.put("votes", Integer.parseInt(m.group(1)));
+        } else if (h.startsWith("distinguishedReverse_")) {
+            v.put("step", "modify_down");
+            v.put("votes", trailingNumber(h));
+        } else if (h.startsWith("distinguished_")) {
+            v.put("step", "modify_up");
+            v.put("votes", trailingNumber(h));
+        } else {
+            return null;
+        }
+        return v;
+    }
+
+    private static Integer trailingNumber(String h) {
+        Matcher m = TRAILING_N.matcher(h);
+        return m.matches() ? Integer.valueOf(m.group(1)) : null;
+    }
+
+    @Override
+    public boolean dynamic() {
+        return true;
+    }
+
+    /**
+     * The running vote, from engine state (the player's spent things this window and the outcome they chose),
+     * never from the edited message text.
+     */
+    @Override
+    public Progress progress(CaptureContext ctx) {
+        Player p = ctx.player();
+        if (p == null) return null;
+        Game game = ctx.game();
+        Map<String, Object> acc = new LinkedHashMap<>();
+        String outcome = game.getStoredValue("latestOutcomeVotedFor" + p.getFaction());
+        if (outcome != null && !outcome.isEmpty()) {
+            acc.put("outcome", outcome);
+            acc.put("outcomeName", AgendaSupport.outcomeName(game, outcome));
+        }
+        List<String> planets = new ArrayList<>();
+        List<String> sources = new ArrayList<>();
+        for (String thing : new ArrayList<>(p.getSpentThingsThisWindow())) {
+            if (thing.startsWith("planet_")) planets.add(thing.substring("planet_".length()));
+            else sources.add(thing);
+        }
+        acc.put("planets", planets);
+        acc.put("sources", sources);
+        int votes = 0;
+        try {
+            votes = Integer.parseInt(Helper.buildSpentThingsMessageForVoting(p, game, true).trim());
+        } catch (Exception ignored) {
+            // nothing spent yet
+        }
+        acc.put("votes", votes);
+        acc.put("available", AgendaSupport.availableVotes(game, p));
+        acc.put("prevote", !game.getStoredValue("preVoting" + p.getFaction()).isEmpty());
+        String step = acc.containsKey("outcome") ? "exhaust" : "outcome";
+        return new Progress("agenda.vote", step, acc, Map.of(), acc.containsKey("outcome"));
+    }
+
+    /** Steps posted in the voting channel without an owner prefix belong to the current voter. */
+    @Override
+    public Target target(CaptureContext ctx, Target resolved) {
+        if (resolved != null && resolved.userId() != null && !"mention".equals(resolved.resolvedBy())) return resolved;
+        Player active = ctx.game().getActivePlayer();
+        if (active == null || !"agendavoting".equalsIgnoreCase(ctx.game().getPhaseOfGame())) return resolved;
+        return new Target(active.getUserID(), active.getFaction(), active.getColor(), "agenda_voter");
+    }
+
+    @Override
+    public String scope(CaptureContext ctx) {
+        return ctx.target() == null || ctx.target().userId() == null ? "table" : "player";
+    }
+}
