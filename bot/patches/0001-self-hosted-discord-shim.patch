@@ -0,0 +1,90 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.List;
+import java.util.Map;
+import ti4.selfhost.engine.EngineModels.ReactionWindow;
+import ti4.selfhost.engine.EngineModels.Target;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * The combat controls the engine posts for both sides: roll buttons (combat round, anti-fighter barrage,
+ * bombardment, space cannon offence/defence), "Decline SPACE CANNON", "Assign Hits" (manual), announce a retreat /
+ * retreat, ready for dice, repair, and the combat action-card window (checkCombatACs; the cards themselves belong to
+ * the action-card kinds). Each combatant answers for themself (the roller is whoever presses), so this is a table
+ * decision with no target; who should roll what comes from GameState.combat (rounds rolled per side, units,
+ * abilities), never from this message. Other ability buttons on the same message stay untyped (value null).
+ */
+public class CombatRoundKind implements KindSpec {
+
+    @Override
+    public String kind() {
+        return "combat.round";
+    }
+
+    @Override
+    public int priority() {
+        return 90;
+    }
+
+    @Override
+    public boolean classifies(List<String> handlerIds) {
+        // A landing prompt carries a bombardment roll too: that message belongs to the landing kind (G3).
+        for (String h : handlerIds) if (h != null && h.startsWith("landUnits_")) return false;
+        for (String h : handlerIds) {
+            if (h == null) continue;
+            if (h.startsWith("combatRoll_")
+                    || h.startsWith("bombardConfirm_combatRoll_")
+                    || h.startsWith("declinePDS_")
+                    || h.equals("checkCombatACs")
+                    || h.equals("announceARetreat")
+                    || h.startsWith("retreat_")
+                    || h.startsWith("getRepairButtons_")) return true;
+        }
+        return false;
+    }
+
+    @Override
+    public boolean matches(String h) {
+        return h.startsWith("combatRoll_")
+                || h.startsWith("bombardConfirm_combatRoll_")
+                || h.startsWith("declinePDS_")
+                || h.equals("checkCombatACs")
+                || h.equals("announceARetreat")
+                || h.startsWith("retreat_")
+                || h.startsWith("getRepairButtons_")
+                || h.startsWith("getDamageButtons_")
+                || h.startsWith("announceReadyForDice_")
+                || h.startsWith("automateGroundCombat_");
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        Map<String, Object> v = CombatSupport.value(handlerId, ctx.game());
+        if (v != null && "roll".equals(v.get("action"))) CombatSupport.noteRollMessage(ctx.messageId(), v);
+        return v;
+    }
+
+    /**
+     * Who rolls here and who already did, from engine state: for a combat round, both combatants, "responded" = the
+     * side that has rolled more rounds than the other (waiting for its opponent); for anti-fighter barrage / space
+     * cannon offence, the players who can fire, "responded" = those whose roll the engine recorded since the prompt.
+     */
+    @Override
+    public ReactionWindow window(CaptureContext ctx) {
+        return CombatSupport.rollWindow(ctx.game(), ctx.messageId());
+    }
+
+    @Override
+    public boolean dynamic() {
+        return true;
+    }
+
+    /**
+     * Both combatants (and, for space cannon, anyone in range) answer here: never "the one mentioned player", nor the
+     * owner of the one faction ability that happens to sit on the same message (e.g. Supercharge).
+     */
+    @Override
+    public Target target(CaptureContext ctx, Target resolved) {
+        return new Target(null, null, null, "none");
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/CombatSupport.java b/src/main/java/ti4/selfhost/engine/kinds/CombatSupport.java
new file mode 100644
index 0000000..ec17819
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/CombatSupport.java
@@ -0,0 +1,534 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.ArrayDeque;
+import java.util.ArrayList;
+import java.util.Deque;
+import java.util.HashMap;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+import javax.annotation.Nullable;
+import ti4.contest.replay.core.CombatRollPayload;
+import ti4.game.Game;
+import ti4.game.Planet;
+import ti4.game.Player;
+import ti4.game.Tile;
+import ti4.game.UnitHolder;
+import ti4.helpers.ButtonHelper;
+import ti4.helpers.Units.UnitKey;
+import ti4.model.UnitModel;
+import ti4.selfhost.engine.EngineModels.Progress;
+import ti4.selfhost.engine.EngineModels.ReactionWindow;
+import ti4.service.combat.CombatRollType;
+
+/**
+ * Combat facts for the engine: typed values for every combat button id (shared by the combat kinds), the combat
+ * section of GameState, and a small in-memory log of structured dice rolls (fed by one hook in CombatRollService).
+ *
+ * <p>Roll types on the wire: "combat" (a combat round), "afb", "bombardment", "spacecannonoffence",
+ * "spacecannondefence". Hit sources: "space" (space combat), "ground", "afb", "spacecannonoffence".
+ */
+public final class CombatSupport {
+    private CombatSupport() {}
+
+    // ------------------------------------------------------------------ option values
+
+    private static final Pattern ROLL =
+            Pattern.compile("^(bombardConfirm_)?combatRoll_([^_]+)_([^_]+)(?:_(afb|bombardment|spacecannonoffence|spacecannondefence))?(?:_.*)?$");
+    private static final Pattern AUTO = Pattern.compile("^autoAssign(Space|AFB|SpaceCannonOffence)Hits_([^_]+)_(\\d+)$");
+    private static final Pattern AUTO_GROUND = Pattern.compile("^autoAssignGroundHits_(.+)_(\\d+)$");
+    private static final Pattern CANCEL = Pattern.compile("^cancel(Space|AFB|PdsOffense)Hits_([^_]+)_(\\d+)(_interlocking)?$");
+    private static final Pattern CANCEL_GROUND = Pattern.compile("^cancelGroundHits_([^_]+)_(\\d+)_(.+?)(_interlocking)?$");
+    private static final Pattern MANUAL = Pattern.compile("^getDamageButtons_([^_]+?)(?:deleteThis)?(?:_(\\w+))?$");
+    private static final Pattern RETREAT = Pattern.compile("^retreat_([^_]+)(?:_(\\w+))?$");
+    private static final Pattern RETREAT_TO = Pattern.compile("^retreatUnitsFrom_([^_]+)_([^_]+?)(skilled)?$");
+    private static final Pattern RETREAT_GROUND = Pattern.compile("^retreatGroundUnits_([^_]+)_([^_]+)_(\\d+)_([a-z]+)_?(.*)$");
+    private static final Pattern UNIT_PICK = Pattern.compile("^(assignHits|assignDamage)_([^_]+)_(\\d+)_([a-z]+)(?:_(.*))?$");
+    private static final Pattern ALL = Pattern.compile("^assignHits_([^_]+)_(All|AllShips)$");
+
+    /** Typed value of any combat button id, or null. ctx may be null (tests). */
+    @Nullable
+    static Map<String, Object> value(String h, @Nullable Game game) {
+        Matcher m;
+        if ((m = ROLL.matcher(h)).matches()) {
+            String type = m.group(4) == null ? "combat" : m.group(4);
+            Map<String, Object> v = base("roll", m.group(2));
+            v.put("holder", m.group(3));
+            v.put("rollType", type);
+            if (m.group(1) != null) v.put("chooseTargets", true);
+            return v;
+        }
+        if ((m = AUTO.matcher(h)).matches()) return hits("auto", m.group(2), source(m.group(1)), Integer.parseInt(m.group(3)), null);
+        if ((m = AUTO_GROUND.matcher(h)).matches()) {
+            Tile t = game == null ? null : game.getTileFromPlanet(m.group(1));
+            return hits("auto", t == null ? null : t.getPosition(), "ground", Integer.parseInt(m.group(2)), m.group(1));
+        }
+        if ((m = CANCEL.matcher(h)).matches()) {
+            String src = "PdsOffense".equals(m.group(1)) ? "spacecannonoffence" : source(m.group(1));
+            return hits("cancel", m.group(2), src, Integer.parseInt(m.group(3)), null);
+        }
+        if ((m = CANCEL_GROUND.matcher(h)).matches())
+            return hits("cancel", m.group(1), "ground", Integer.parseInt(m.group(2)), m.group(3));
+        if ((m = MANUAL.matcher(h)).matches()) {
+            Map<String, Object> v = base("assign_manual", m.group(1));
+            v.put("assignType", m.group(2) == null ? "combat" : m.group(2));
+            return v;
+        }
+        if ((m = UNIT_PICK.matcher(h)).matches()) return unitPick(m, game);
+        if ((m = ALL.matcher(h)).matches()) {
+            Map<String, Object> v = base("All".equals(m.group(2)) ? "destroy_all" : "destroy_all_ships", m.group(1));
+            return v;
+        }
+        if ((m = RETREAT_TO.matcher(h)).matches()) {
+            Map<String, Object> v = base("retreat_to", m.group(1));
+            v.put("to", m.group(2));
+            v.put("skilled", m.group(3) != null);
+            return v;
+        }
+        if ((m = RETREAT_GROUND.matcher(h)).matches()) {
+            Map<String, Object> v = base("retreat_ground", m.group(1));
+            v.put("to", m.group(2));
+            v.put("count", Integer.parseInt(m.group(3)));
+            v.put("unit", m.group(4));
+            v.put("holder", m.group(5).isBlank() ? null : m.group(5));
+            return v;
+        }
+        if ((m = RETREAT.matcher(h)).matches()) {
+            Map<String, Object> v = base("retreat", m.group(1));
+            v.put("variant", m.group(2)); // null | skilled | foresight | gheminabt
+            return v;
+        }
+        if (h.equals("announceARetreat")) return base("announce_retreat", activeSystem(game));
+        if (h.startsWith("announceReadyForDice_")) return base("ready_for_dice", activeSystem(game));
+        if (h.equals("checkCombatACs")) return base("action_cards", activeSystem(game));
+        if (h.startsWith("getRepairButtons_")) return base("repair", h.substring("getRepairButtons_".length()));
+        if (h.startsWith("declinePDS_")) {
+            Map<String, Object> v = base("decline_space_cannon", activeSystem(game));
+            v.put("rollType", "spacecannonoffence");
+            return v;
+        }
+        if (h.startsWith("automateGroundCombat_")) return base("automate", activeSystem(game));
+        if (h.equals("deleteButtons")) return base("done", null);
+        return null;
+    }
+
+    private static String activeSystem(@Nullable Game game) {
+        String a = game == null ? null : game.getActiveSystem();
+        return a == null || a.isBlank() ? null : a;
+    }
+
+    private static String source(String s) {
+        return switch (s) {
+            case "AFB" -> "afb";
+            case "SpaceCannonOffence" -> "spacecannonoffence";
+            default -> "space";
+        };
+    }
+
+    private static Map<String, Object> base(String action, String tile) {
+        Map<String, Object> v = new LinkedHashMap<>();
+        v.put("action", action);
+        v.put("tile", tile);
+        return v;
+    }
+
+    private static Map<String, Object> hits(String action, String tile, String source, int hits, String planet) {
+        Map<String, Object> v = base(action, tile);
+        v.put("source", source);
+        v.put("holder", planet == null ? "space" : planet);
+        v.put("hits", hits);
+        return v;
+    }
+
+    /** assignHits_/assignDamage_ &lt;pos&gt;_&lt;amt&gt;_&lt;unit&gt;[_&lt;state&gt;][_&lt;planet&gt;]_&lt;color&gt;. */
+    private static Map<String, Object> unitPick(Matcher m, @Nullable Game game) {
+        Map<String, Object> v = base("assignDamage".equals(m.group(1)) ? "sustain" : "destroy", m.group(2));
+        v.put("count", Integer.parseInt(m.group(3)));
+        v.put("unit", m.group(4));
+        String rest = m.group(5) == null ? "" : m.group(5);
+        String state = "none";
+        for (String s : new String[] {"dmg_glv", "dmg", "glv", "none"}) {
+            if (rest.equals(s) || rest.startsWith(s + "_")) {
+                state = s;
+                rest = rest.equals(s) ? "" : rest.substring(s.length() + 1);
+                break;
+            }
+        }
+        // what is left: [planet_]color
+        int last = rest.lastIndexOf('_');
+        String planet = last < 0 ? null : rest.substring(0, last);
+        if (planet == null && game != null && !rest.isEmpty() && game.getPlanetsInfo().containsKey(rest)) planet = rest;
+        v.put("holder", planet == null || planet.isBlank() ? "space" : planet);
+        v.put("damaged", state.startsWith("dmg"));
+        v.put("state", state);
+        return v;
+    }
+
+    // ------------------------------------------------------------------ units
+
+    /** The player's units in one holder that a hit from `source` may land on. */
+    static List<Map<String, Object>> hittableUnits(Game game, Player p, Tile tile, String holderName, String source) {
+        List<Map<String, Object>> out = new ArrayList<>();
+        if (tile == null || p == null) return out;
+        UnitHolder uh = tile.getUnitHolders().get(holderName == null ? "space" : holderName);
+        if (uh == null) return out;
+        for (Map.Entry<UnitKey, List<Integer>> e : uh.getUnitsByState().entrySet()) {
+            UnitKey k = e.getKey();
+            if (!p.unitBelongsToPlayer(k)) continue;
+            UnitModel model = p.getUnitFromUnitKey(k);
+            if (model == null) continue;
+            boolean eligible = switch (source) {
+                case "ground" -> model.getIsGroundForce();
+                case "afb" -> k.unitType() == ti4.helpers.Units.UnitType.Fighter;
+                default -> model.getIsShip();
+            };
+            if (!eligible) continue;
+            List<Integer> st = e.getValue();
+            int total = 0;
+            for (Integer n : st) total += n == null ? 0 : n;
+            if (total == 0) continue;
+            int dmg = (st.size() > 1 ? nz(st.get(1)) : 0) + (st.size() > 3 ? nz(st.get(3)) : 0);
+            Map<String, Object> u = new LinkedHashMap<>();
+            u.put("holder", uh.getName());
+            u.put("unit", k.asyncID());
+            u.put("count", total);
+            u.put("damaged", dmg);
+            u.put("sustain", canSustain(game, p, tile, model));
+            out.add(u);
+        }
+        return out;
+    }
+
+    // ------------------------------------------------------------------ roll windows (combat.round)
+
+    /** What a roll prompt offers: roll type → holder, its tile, when it was first seen. */
+    record RollMessage(String tile, Map<String, String> types, long at) {}
+
+    private static final Map<String, RollMessage> ROLL_MSGS = new ConcurrentHashMap<>();
+
+    static void noteRollMessage(String messageId, Map<String, Object> rollValue) {
+        if (messageId == null) return;
+        if (ROLL_MSGS.size() > 5000) ROLL_MSGS.clear();
+        RollMessage m = ROLL_MSGS.computeIfAbsent(
+                messageId,
+                k -> new RollMessage(
+                        (String) rollValue.get("tile"), new ConcurrentHashMap<>(), System.currentTimeMillis()));
+        m.types().putIfAbsent((String) rollValue.get("rollType"), String.valueOf(rollValue.get("holder")));
+    }
+
+    @Nullable
+    static ReactionWindow rollWindow(Game game, String messageId) {
+        RollMessage m = messageId == null ? null : ROLL_MSGS.get(messageId);
+        if (m == null || m.tile() == null) return null;
+        Tile tile = game.getTileByPosition(m.tile());
+        if (tile == null) return null;
+        List<Player> fighters = new ArrayList<>();
+        for (String f : game.getStoredValue("factionsInCombat").split("_")) {
+            Player p = f.isBlank() ? null : game.getPlayerFromColorOrFaction(f);
+            if (p != null) fighters.add(p);
+        }
+        Map<String, Object> subject = new LinkedHashMap<>();
+        subject.put("tile", m.tile());
+        List<String> eligible = new ArrayList<>();
+        List<String> responded = new ArrayList<>();
+        String combatHolder = m.types().get("combat");
+        if (combatHolder != null) {
+            if (fighters.size() < 2) return null;
+            Map<String, Object> rounds = new LinkedHashMap<>();
+            int min = Integer.MAX_VALUE;
+            for (Player p : fighters) {
+                int r = roundsRolled(game, p, m.tile(), combatHolder);
+                rounds.put(p.getFaction(), r);
+                min = Math.min(min, r);
+            }
+            for (Player p : fighters) {
+                eligible.add(p.getUserID());
+                if ((int) rounds.get(p.getFaction()) > min) responded.add(p.getUserID());
+            }
+            subject.put("holder", combatHolder);
+            subject.put("rollType", "combat");
+            subject.put("roundsRolled", rounds);
+            return new ReactionWindow("combat_roll", subject, eligible, responded, Map.of());
+        }
+        String type = m.types().containsKey("afb")
+                ? "afb"
+                : m.types().containsKey("spacecannonoffence") ? "spacecannonoffence" : null;
+        if (type == null) return null;
+        List<Player> who = new ArrayList<>();
+        if ("afb".equals(type)) {
+            for (Player p : fighters) if (abilities(p, tile, tile.getSpaceUnitHolder(), true).contains("afb")) who.add(p);
+        } else {
+            Player active = game.getActivePlayer();
+            try {
+                if (active != null)
+                    for (Player p : ButtonHelper.getPlayersWithPds2Cover(active, game, m.tile()))
+                        if (p != active && !who.contains(p)) who.add(p);
+            } catch (Exception ignored) {
+                // best effort
+            }
+        }
+        for (Player p : who) {
+            eligible.add(p.getUserID());
+            for (CombatRoll r : rollsFor(game.getName())) {
+                if (r.at() >= m.at() && type.equals(r.rollType()) && p.getFaction().equals(r.faction())) {
+                    responded.add(p.getUserID());
+                    break;
+                }
+            }
+        }
+        subject.put("holder", "space");
+        subject.put("rollType", type);
+        return new ReactionWindow("combat_roll", subject, eligible, responded, Map.of());
+    }
+
+    static int roundsRolled(Game game, Player p, String pos, String holder) {
+        String t = game.getStoredValue("combatRoundTracker" + p.getFaction() + pos + holder);
+        try {
+            return t == null || t.isBlank() ? 0 : Integer.parseInt(t.trim());
+        } catch (NumberFormatException e) {
+            return 0;
+        }
+    }
+
+    // ------------------------------------------------------------------ hits owed (progress of the manual menu)
+
+    /** The latest hits prompt for a player: what was owed and the units then, to measure assignment progress. */
+    record Owed(String tile, String holder, String source, int hits, int cancels, Map<String, int[]> baseline) {}
+
+    private static final Map<String, Owed> OWED = new ConcurrentHashMap<>();
+
+    /** Called when a hits prompt is captured (its auto option typed). */
+    static void noteOwed(Game game, Player p, String tile, String holder, String source, int hits, int cancels) {
+        if (p == null || tile == null) return;
+        Map<String, int[]> base = new HashMap<>();
+        for (Map<String, Object> u : hittableUnits(game, p, game.getTileByPosition(tile), holder, source))
+            base.put((String) u.get("unit"), new int[] {(int) u.get("count"), (int) u.get("damaged")});
+        OWED.put(game.getName() + "|" + p.getFaction(), new Owed(tile, holder, source, hits, cancels, base));
+    }
+
+    /**
+     * Progress of a manual assignment: hits owed (from the last hits prompt) against what the units show now —
+     * each unit gone or newly damaged since the prompt is one hit taken (two per sustain with Non-Euclidean
+     * Shielding). Null when no hits prompt is known for the player (e.g. after a bot restart).
+     */
+    @Nullable
+    static Progress assignProgress(Game game, @Nullable Player p) {
+        Owed o = p == null ? null : OWED.get(game.getName() + "|" + p.getFaction());
+        if (o == null) return null;
+        Map<String, Object> destroyed = new LinkedHashMap<>();
+        Map<String, Object> sustained = new LinkedHashMap<>();
+        int assigned = 0, left = 0;
+        Map<String, int[]> now = new HashMap<>();
+        for (Map<String, Object> u : hittableUnits(game, p, game.getTileByPosition(o.tile()), o.holder(), o.source())) {
+            now.put((String) u.get("unit"), new int[] {(int) u.get("count"), (int) u.get("damaged")});
+            left += (int) u.get("count");
+        }
+        for (Map.Entry<String, int[]> e : o.baseline().entrySet()) {
+            int[] cur = now.getOrDefault(e.getKey(), new int[2]);
+            int gone = Math.max(0, e.getValue()[0] - cur[0]);
+            int newlyDamaged = Math.max(0, cur[1] - e.getValue()[1]);
+            if (gone > 0) destroyed.put(e.getKey(), gone);
+            if (newlyDamaged > 0) sustained.put(e.getKey(), newlyDamaged);
+            assigned += gone + newlyDamaged * o.cancels();
+        }
+        Map<String, Object> acc = new LinkedHashMap<>();
+        acc.put("assigned", assigned);
+        acc.put("destroyed", destroyed);
+        acc.put("sustained", sustained);
+        Map<String, Object> req = new LinkedHashMap<>();
+        req.put("owed", o.hits());
+        req.put("hits", Math.max(0, o.hits() - assigned));
+        req.put("tile", o.tile());
+        req.put("holder", o.holder());
+        req.put("source", o.source());
+        boolean done = assigned >= o.hits() || left == 0;
+        return new Progress("combat.assign_hits", done ? "confirm" : "select_units", acc, req, done);
+    }
+
+    static boolean canSustain(Game game, Player p, Tile tile, UnitModel model) {
+        try {
+            return ButtonHelper.unitCanSustainDamage(game, p, tile, model);
+        } catch (Exception e) {
+            return model.getSustainDamage();
+        }
+    }
+
+    private static int nz(Integer i) {
+        return i == null ? 0 : i;
+    }
+
+    // ------------------------------------------------------------------ GameState.combat
+
+    public record CombatState(
+            /** Active system position (where the combat is). */
+            String tile,
+            String tileId,
+            /** Factions fighting (factionsInCombat); empty before the combat starts (space cannon offence). */
+            List<String> factions,
+            List<CombatFront> fronts,
+            /** Factions other than the active player that may fire SPACE CANNON at the active system. */
+            List<String> spaceCannonOffence,
+            /** Recent structured rolls in this game, oldest first (in-memory; empty after a bot restart). */
+            List<CombatRoll> rolls) {}
+
+    /** One place combat happens or happened in the active system: "space" or a planet id. */
+    public record CombatFront(String holder, List<CombatSide> sides) {}
+
+    public record CombatSide(
+            String faction,
+            String userId,
+            /** Combat rounds this side has rolled in this fight (the engine's combatRoundTracker). */
+            int roundsRolled,
+            /** Units able to fight here (ships in space, ground forces on a planet). */
+            List<Map<String, Object>> units,
+            /** Optional rolls this side has units for here: afb, spacecannondefence, bombardment. */
+            List<String> abilities) {}
+
+    public record CombatRoll(
+            long at,
+            String faction,
+            String opponent,
+            String tile,
+            String holder,
+            String rollType,
+            Integer round,
+            int hits,
+            List<DieGroup> dice) {}
+
+    public record DieGroup(String unit, int threshold, List<Integer> results) {}
+
+    @Nullable
+    public static CombatState state(Game game) {
+        try {
+            return buildState(game);
+        } catch (Exception e) {
+            return null;
+        }
+    }
+
+    private static CombatState buildState(Game game) {
+        String pos = game.getActiveSystem();
+        Tile tile = pos == null || pos.isBlank() ? null : game.getTileByPosition(pos);
+        if (tile == null) return null;
+        List<String> factions = new ArrayList<>();
+        for (String f : game.getStoredValue("factionsInCombat").split("_")) if (!f.isBlank()) factions.add(f);
+        List<String> sco = new ArrayList<>();
+        Player active = game.getActivePlayer();
+        if (active != null) {
+            try {
+                for (Player p : ButtonHelper.getPlayersWithPds2Cover(active, game, pos))
+                    if (p != active && !sco.contains(p.getFaction())) sco.add(p.getFaction());
+            } catch (Exception ignored) {
+                // best effort
+            }
+        }
+        List<CombatRoll> rolls = rollsFor(game.getName());
+        if (factions.isEmpty() && sco.isEmpty() && rolls.isEmpty()) return null;
+        List<CombatFront> fronts = new ArrayList<>();
+        if (factions.size() >= 2) {
+            for (UnitHolder uh : tile.getUnitHolders().values()) {
+                boolean space = !(uh instanceof Planet);
+                List<CombatSide> sides = new ArrayList<>();
+                int withUnits = 0;
+                boolean tracked = false;
+                for (String f : factions) {
+                    Player p = game.getPlayerFromColorOrFaction(f);
+                    if (p == null) continue;
+                    int rounds = roundsRolled(game, p, pos, uh.getName());
+                    tracked |= game.getStoredValueMap().containsKey("combatRoundTracker" + f + pos + uh.getName());
+                    List<Map<String, Object>> units = hittableUnits(game, p, tile, uh.getName(), space ? "space" : "ground");
+                    if (!units.isEmpty()) withUnits++;
+                    sides.add(new CombatSide(f, p.getUserID(), rounds, units, abilities(p, tile, uh, space)));
+                }
+                if (withUnits >= 2 || tracked) fronts.add(new CombatFront(uh.getName(), sides));
+            }
+        }
+        return new CombatState(pos, tile.getTileID(), factions, fronts, sco, rolls);
+    }
+
+    private static List<String> abilities(Player p, Tile tile, UnitHolder uh, boolean space) {
+        List<String> out = new ArrayList<>();
+        boolean afb = false, bombard = false, scd = false;
+        for (UnitHolder h : space ? List.of(uh) : List.of(tile.getSpaceUnitHolder(), uh)) {
+            if (h == null) continue;
+            for (UnitKey k : h.getUnitKeys()) {
+                if (!p.unitBelongsToPlayer(k) || h.getUnitCount(k) <= 0) continue;
+                UnitModel m = p.getUnitFromUnitKey(k);
+                if (m == null) continue;
+                if (space && m.getAfbDieCount(p) > 0) afb = true;
+                if (!space && h != uh && m.getBombardDieCount(p) > 0) bombard = true;
+                if (!space && h == uh && m.getSpaceCannonDieCount(p) > 0) scd = true;
+            }
+        }
+        if (afb) out.add("afb");
+        if (bombard) out.add("bombardment");
+        if (scd) out.add("spacecannondefence");
+        return out;
+    }
+
+    // ------------------------------------------------------------------ roll log
+
+    private static final int LOG_SIZE = 40;
+    private static final Map<String, Deque<CombatRoll>> LOG = new ConcurrentHashMap<>();
+
+    /** Hook (CombatRollService, after the hits are final): remember a roll in structured form. Never throws. */
+    public static void recordRoll(
+            Game game,
+            Player player,
+            Player opponent,
+            Tile tile,
+            String holder,
+            CombatRollType rollType,
+            int hits,
+            CombatRollPayload payload) {
+        try {
+            List<DieGroup> dice = new ArrayList<>();
+            if (payload != null) {
+                for (CombatRollPayload.UnitRoll ur : payload.unitRolls()) {
+                    List<Integer> results = new ArrayList<>();
+                    for (CombatRollPayload.DieRoll d : ur.dice()) results.add(d.result());
+                    dice.add(new DieGroup(ur.asyncId(), ur.effectiveThreshold(), results));
+                }
+            }
+            Integer round = payload == null || payload.header() == null ? null : payload.header().combatRound();
+            CombatRoll r = new CombatRoll(
+                    System.currentTimeMillis(),
+                    player.getFaction(),
+                    opponent == null || opponent == player ? null : opponent.getFaction(),
+                    tile.getPosition(),
+                    holder,
+                    wire(rollType),
+                    round,
+                    hits,
+                    dice);
+            Deque<CombatRoll> q = LOG.computeIfAbsent(game.getName(), k -> new ArrayDeque<>());
+            synchronized (q) {
+                q.addLast(r);
+                while (q.size() > LOG_SIZE) q.removeFirst();
+            }
+        } catch (Exception ignored) {
+            // display aid only
+        }
+    }
+
+    static List<CombatRoll> rollsFor(String game) {
+        Deque<CombatRoll> q = LOG.get(game);
+        if (q == null) return List.of();
+        synchronized (q) {
+            return List.copyOf(q);
+        }
+    }
+
+    static String wire(CombatRollType t) {
+        return switch (t) {
+            case AFB -> "afb";
+            case bombardment -> "bombardment";
+            case SpaceCannonOffence -> "spacecannonoffence";
+            case SpaceCannonDefence -> "spacecannondefence";
+            default -> "combat";
+        };
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/CommandTokensAdjustKind.java b/src/main/java/ti4/selfhost/engine/kinds/CommandTokensAdjustKind.java
new file mode 100644
index 0000000..53b5ede
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/CommandTokensAdjustKind.java
@@ -0,0 +1,94 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.selfhost.engine.EngineModels.CommandTokens;
+import ti4.selfhost.engine.EngineModels.Decision;
+import ti4.selfhost.engine.EngineModels.Progress;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * The step-by-step command token prompt (CommandCounterButtonHandler.redistributeCCButtons / Leadership / Warfare):
+ * FFCC_&lt;f&gt;_increase_|decrease_&lt;pool&gt;_cc, resetCCs, and a "Done" (deleteButtons, untyped). Edited in place
+ * after every step, so one decision with progress {flow: "command_tokens", step: "adjust", accumulated: current
+ * pools {tactic, fleet, strategy}, required: {status: bool, base?, gain?, maxTotal?}, canCommit: true}.
+ *
+ * <p>value: {pool, delta: +1|-1} or {action: "reset"}. In the status phase the increase options also take the
+ * whole answer as a payload {tactic, fleet, strategy} (same check and handler as status.homework), which replaces
+ * the step-by-step clicking and closes this prompt.
+ */
+public class CommandTokensAdjustKind implements KindSpec {
+
+    @Override
+    public String kind() {
+        return "command_tokens.adjust";
+    }
+
+    @Override
+    public int priority() {
+        return 80;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return handlerId.matches("(increase|decrease)_(tactic|fleet|strategy)_cc") || "resetCCs".equals(handlerId);
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        Map<String, Object> v = new LinkedHashMap<>();
+        if ("resetCCs".equals(handlerId)) {
+            v.put("action", "reset");
+            return v;
+        }
+        String[] a = handlerId.split("_");
+        v.put("action", "adjust");
+        v.put("pool", a[1]);
+        v.put("delta", "increase".equals(a[0]) ? 1 : -1);
+        v.put("payload", StatusPhase.inHomework(ctx.game()));
+        return v;
+    }
+
+    @Override
+    public boolean dynamic() {
+        return true;
+    }
+
+    @Override
+    public Progress progress(CaptureContext ctx) {
+        Player p = ctx.player();
+        if (p == null) return null;
+        Game game = ctx.game();
+        CommandTokens cur = StatusPhase.current(p);
+        Map<String, Object> acc = new LinkedHashMap<>();
+        acc.put("tactic", cur.tactic());
+        acc.put("fleet", cur.fleet());
+        acc.put("strategy", cur.strategy());
+        Map<String, Object> req = new LinkedHashMap<>();
+        boolean status = StatusPhase.inHomework(game);
+        req.put("status", status);
+        if (status) {
+            CommandTokens base = StatusPhase.tokensBase(game, p);
+            req.put("base", Map.of("tactic", base.tactic(), "fleet", base.fleet(), "strategy", base.strategy()));
+            req.put("gain", StatusPhase.tokenGain(game, p));
+            req.put("maxTotal", StatusPhase.tokenMaxTotal(game, p, base));
+        }
+        return new Progress("command_tokens", "adjust", acc, req, true);
+    }
+
+    @Override
+    public boolean acceptsPayload() {
+        return true;
+    }
+
+    @Override
+    public String answerPayload(PayloadAnswer steps, Map<String, Object> payload) throws Exception {
+        Game game = steps.game();
+        Player answering = steps.player();
+        Decision decision = steps.decision();
+        if (game == null || answering == null || decision == null) return "That decision is no longer open.";
+        return StatusHomeworkKind.applyTokens(game, answering, decision, payload, steps);
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/ConstructionPlaceKind.java b/src/main/java/ti4/selfhost/engine/kinds/ConstructionPlaceKind.java
new file mode 100644
index 0000000..9ac32c4
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/ConstructionPlaceKind.java
@@ -0,0 +1,63 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+import ti4.game.Game;
+import ti4.game.Planet;
+import ti4.game.Player;
+import ti4.game.Tile;
+import ti4.helpers.Units.UnitType;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * Construction (primary or secondary): the planet to put the structure on, after construction_&lt;unit&gt; on the card's
+ * message: place_&lt;pds|spacedock&gt;_&lt;planet&gt; (ephemeral to the presser). One structure per prompt — the holder's
+ * primary is two prompts (space dock or PDS, then a PDS): see strategy_card.resolve primaryParts.
+ * value: {unit, planet, tile, home, resources, influence, pds, spaceDock} (pds/spaceDock: already on that planet).
+ *
+ * <p>Priority 110: above the production kind's generic place_ (production prompts never offer PDS / space docks).
+ */
+public class ConstructionPlaceKind implements KindSpec {
+
+    @Override
+    public String kind() {
+        return "strategy_card.construction_place";
+    }
+
+    @Override
+    public int priority() {
+        return 110;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return handlerId.matches("place_(pds|spacedock)_[^_]+");
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        String rest = handlerId.substring("place_".length());
+        int us = rest.indexOf('_');
+        String unit = rest.substring(0, us);
+        String planet = rest.substring(us + 1);
+        Game game = ctx.game();
+        Planet p = game.getUnitHolderFromPlanet(planet);
+        Tile tile = game.getTileFromPlanet(planet);
+        Player me = ctx.player();
+        Map<String, Object> v = new LinkedHashMap<>();
+        v.put("unit", unit);
+        v.put("planet", planet);
+        v.put("tile", tile == null ? null : tile.getPosition());
+        v.put("home", tile != null && me != null && tile == me.getHomeSystemTile());
+        v.put("resources", p == null ? 0 : p.getResources());
+        v.put("influence", p == null ? 0 : p.getInfluence());
+        v.put("pds", p == null || me == null ? 0 : p.getUnitCount(UnitType.Pds, me));
+        v.put("spaceDock", p == null || me == null ? 0 : p.getUnitCount(UnitType.Spacedock, me));
+        return v;
+    }
+
+    @Override
+    public String scope(CaptureContext ctx) {
+        return "player";
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/DealSecretsKind.java b/src/main/java/ti4/selfhost/engine/kinds/DealSecretsKind.java
new file mode 100644
