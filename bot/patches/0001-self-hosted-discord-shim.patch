+package ti4.selfhost.engine.kinds;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import java.util.List;
+import java.util.Map;
+import org.junit.jupiter.api.Test;
+import ti4.game.Game;
+import ti4.helpers.DoneRole;
+import ti4.selfhost.engine.KindSpec.CaptureContext;
+
+/** c9b id suffixes (~pick, _discount, DoneRole tags) keep the c-kinds' typing (cov-batch1). */
+class MsgStateSuffixesTest {
+
+    private static CaptureContext ctx(String... handlerIds) {
+        Game game = new Game();
+        game.setName("pbd0");
+        return new CaptureContext(game, "c", "m", "", false, null, null, List.of(handlerIds));
+    }
+
+    @Test
+    void agentTargetPickerMarkerIsNotPartOfTheTarget() {
+        FactionSteps.Step trailing = FactionSteps.Registry.find("exhaustAgent_mentakagent_sol~pick", null);
+        assertThat(trailing).isNotNull();
+        assertThat(trailing.kind()).isEqualTo("leader.use");
+        assertThat(trailing.fields().get("target")).isEqualTo("sol");
+
+        // getButtonsForAgentSelection: "exhaustAgent_<agent>~pick" + "_<faction>"
+        FactionSteps.Step picker = FactionSteps.Registry.find("exhaustAgent_keleresagent~pick_hacan", null);
+        assertThat(picker).isNotNull();
+        assertThat(picker.kind()).isEqualTo("leader.use");
+        assertThat(picker.component()).isEqualTo("keleresagent");
+        assertThat(picker.fields().get("target")).isEqualTo("hacan");
+    }
+
+    @Test
