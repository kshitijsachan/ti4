+    /**
+     * The summary a closed prompt showed: the spending summary of a payment prompt, the planets readied from a
+     * ready-planets prompt, or the units produced so far. All three are kept in the game (PromptState / produced units);
+     * the prompt's text only displayed them.
+     */
+    private static String promptSummary(ButtonInteractionEvent event, Game game, Player player, boolean paying) {
+        if (player == null) return "";
+        String promptId = event.getMessageId();
+        if (paying) return Helper.paymentPromptText(player, game, promptId);
+        String readied = Helper.readiedPlanetsPromptText(player, game, promptId);
+        if (!readied.isEmpty()) return readied;
+        if (!player.getCurrentProducedUnits().isEmpty()) return Helper.buildProducedUnitsMessage(player, game);
+        return "";
+    }
+
+    /**
+     * Prophecy of Ixth: "When the owner of this card uses PRODUCTION, they discard this card unless they produce 2 or
+     * more fighters." The original only reminded the player ("its removal is not automated"); discarding it here is a
+     * deliberate rules improvement (rules audit).
+     */
+    private static void resolveProphecyOfIxth(Game game, Player player) {
+        if (!ti4.service.agenda.IsPlayerElectedService.isPlayerElected(game, player, "prophecy")) return;
+        int fighters = 0;
+        for (Map.Entry<String, Integer> entry : player.getCurrentProducedUnits().entrySet()) {
+            String unit = AliasHandler.resolveUnit(entry.getKey().split("_")[0]);
+            if ("ff".equals(Mapper.getUnitKey(unit, player.getColor()).asyncID())) fighters += entry.getValue();
+        }
+        if (fighters >= 2) return;
+        game.removeLaw("prophecy");
+        MessageHelper.sendMessageToChannel(
+                player.getCorrectChannel(),
+                player.getRepresentation() + " used PRODUCTION without producing 2 or more fighters, so _Prophecy of Ixth_"
+                        + " has been discarded.");
+    }
 }
