@@ -0,0 +1,46 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * Draw action cards offered by an effect: draw_1_AC, draw_1_ACDelete, drawActionCards_&lt;n&gt;, draw7AC ("draw up
+ * to 7"). Low priority: when these sit in a message another kind owns (e.g. a strategy card's), that kind wins.
+ * Politics' "draw2 AC" belongs to the strategy-card area and is not typed here. Value: {count, upTo}.
+ */
+public class ActionCardDrawKind implements KindSpec {
+
+    @Override
+    public String kind() {
+        return "action_card.draw";
+    }
+
+    @Override
+    public int priority() {
+        return 10;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return handlerId.equals("draw_1_AC")
+                || handlerId.equals("draw_1_ACDelete")
+                || handlerId.equals("draw7AC")
+                || handlerId.matches("drawActionCards_\\d+");
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        Map<String, Object> v = new LinkedHashMap<>();
+        if (handlerId.equals("draw7AC")) {
+            v.put("count", 7);
+            v.put("upTo", true);
+        } else {
+            v.put("count", handlerId.startsWith("drawActionCards_")
+                    ? CardKinds.parseInt(handlerId.substring("drawActionCards_".length()), 1)
+                    : 1);
+            v.put("upTo", false);
+        }
+        return v;
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/ActionCardPlayKind.java b/src/main/java/ti4/selfhost/engine/kinds/ActionCardPlayKind.java
new file mode 100644
index 0000000..60abb53
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/ActionCardPlayKind.java
@@ -0,0 +1,85 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.helpers.ActionCardTiming;
+import ti4.selfhost.engine.EngineModels.Decision;
+import ti4.selfhost.engine.EngineModels.Option;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * Play an action card from hand: ac_play_from_hand_&lt;handle&gt; (ActionCardHelper hand tray in the cards-info
+ * thread, and the action-window / combat subsets offered as replies). Value: {handle, actionCard, window}. The
+ * same hand-tray message also carries "Discard an Action Card" / "Pre-Assign" (value null).
+ */
+public class ActionCardPlayKind implements KindSpec {
+    static final String PREFIX = "ac_play_from_hand_";
+
+    @Override
+    public String kind() {
+        return "action_card.play";
+    }
+
+    @Override
+    public int priority() {
+        return 90;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return handlerId.startsWith(PREFIX);
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        int handle = CardKinds.parseInt(handlerId.substring(PREFIX.length()), -1);
+        if (handle < 0) return null;
+        Player holder = ctx.player() != null ? ctx.player() : CardKinds.holderOfHandle(ctx.game(), handle);
+        String ac = CardKinds.acIdForHandle(holder, handle);
+        if (ac == null) {
+            // Garbozia (Dok 'N Pic's Salvage Yard): cards played from the discard pile use the pile's handle.
+            for (Map.Entry<String, Integer> e : ctx.game().getDiscardActionCards().entrySet()) {
+                if (e.getValue() == handle) ac = e.getKey();
+            }
+        }
+        if (ac == null) return null;
+        Map<String, Object> v = new LinkedHashMap<>();
+        v.put("handle", handle);
+        v.put("actionCard", ac);
+        v.put("window", CardKinds.window(ac));
+        return v;
+    }
+
+    @Override
+    public String validate(Game game, Player answering, Decision decision, String optionId) {
+        for (Option o : decision.options()) {
+            if (!o.id().equals(optionId) || o.value() == null) continue;
+            Object h = o.value().get("handle");
+            if (h instanceof Integer handle
+                    && !answering.getActionCards().containsValue(handle)
+                    && !game.getDiscardActionCards().containsValue(handle))
+                return "That action card is not in your hand.";
+            // Selfhost (deliberate improvement over the original, which only checked "Action:" cards' active
+            // player): a card whose timing window is closed is refused (ti4.helpers.ActionCardTiming).
+            if (h instanceof Integer handle) {
+                String closed = ActionCardTiming.closedReasonForHandle(game, answering, handle);
+                if (closed != null) return closed;
+            }
+        }
+        return null;
+    }
+
+    /** An "Action:" card played on the player's own turn is that turn's action (ActionCardTiming refuses another). */
+    @Override
+    public void beforeAnswer(Game game, Player answering, Decision decision, String optionId) {
+        for (Option o : decision.options()) {
+            if (!o.id().equals(optionId) || o.value() == null) continue;
+            Object ac = o.value().get("actionCard");
+            ti4.model.ActionCardModel card = ac instanceof String id ? ti4.image.Mapper.getActionCard(id) : null;
+            if (card != null && "action".equalsIgnoreCase(card.getWindow()) && answering == game.getActivePlayer())
+                ti4.selfhost.engine.ScFollowGate.recordActionCard(game, answering);
+        }
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/ActionCardPreassignKind.java b/src/main/java/ti4/selfhost/engine/kinds/ActionCardPreassignKind.java
