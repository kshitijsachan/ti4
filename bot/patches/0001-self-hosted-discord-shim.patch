@@ -0,0 +1,71 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.selfhost.engine.EngineModels.Decision;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * Ahead-of-time agenda choices in the cards-info thread: pre-pass on shenanigans (Bribery, Deadly Plot, Legal Texts),
+ * pass on all whens/afters for the phase, pre-vote / pre-abstain / erase a pre-vote. "Decline" (deleteButtons) has
+ * value null. A pre-vote prompt takes the same structured answer as agenda.vote ({outcome, planets[], ...}).
+ */
+public class AgendaPreassignKind implements KindSpec {
+
+    @Override
+    public String kind() {
+        return "agenda.preassign";
+    }
+
+    @Override
+    public int priority() {
+        return 95;
+    }
+
+    @Override
+    public boolean matches(String h) {
+        return h.equals("resolvePreassignment_Pass On Shenanigans")
+                || h.equals("resolvePreassignment_Abstain On Agenda")
+                || h.equals("preVote")
+                || h.equals("erasePreVote")
+                || h.equals("passOnEverythingWhensNAfters")
+                || h.equals("undoPassOnAllWhensNAfters");
+    }
+
+    @Override
+    public Map<String, Object> value(String h, CaptureContext ctx) {
+        Map<String, Object> v = new LinkedHashMap<>();
+        switch (h) {
+            case "resolvePreassignment_Pass On Shenanigans" -> v.put("preset", "pass_shenanigans");
+            case "resolvePreassignment_Abstain On Agenda" -> v.put("preset", "abstain");
+            case "preVote" -> {
+                v.put("preset", "prevote");
+                v.putAll(AgendaVoteKind.ballot(ctx.game(), ctx.player()));
+            }
+            case "erasePreVote" -> v.put("preset", "erase_prevote");
+            case "passOnEverythingWhensNAfters" -> v.put("preset", "pass_whens_afters");
+            case "undoPassOnAllWhensNAfters" -> v.put("preset", "undo_pass_whens_afters");
+            default -> {
+                return null;
+            }
+        }
+        return v;
+    }
+
+    @Override
+    public boolean acceptsPayload() {
+        return true;
+    }
+
+    @Override
+    public String answerPayload(PayloadAnswer steps, Map<String, Object> payload) throws Exception {
+        Game game = steps.game();
+        Player answering = steps.player();
+        Decision d = steps.decision();
+        if (game == null || answering == null || d == null) return "That decision is no longer open.";
+        if (AgendaVoteKind.option(d, "preVote"::equals) == null) return "This prompt does not offer a pre-vote.";
+        return AgendaVoteKind.castVote(game, answering, d, "preVote", payload, steps);
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/AgendaResolveKind.java b/src/main/java/ti4/selfhost/engine/kinds/AgendaResolveKind.java
new file mode 100644
index 0000000..14e5acb
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/AgendaResolveKind.java
@@ -0,0 +1,77 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+import ti4.game.Player;
+import ti4.selfhost.engine.EngineModels.Target;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * Resolve the agenda once votes (and shenanigans) are in (AgendaHelper.resolveTime / autoResolve /
+ * resolveWithNoEffect): agendaResolution_&lt;outcome&gt; ("Resolve with Current Winner", or one per outcome when
+ * resolving manually), tiedPlanets_agendaResolution_&lt;owner&gt; (manual planet pick: first the owner),
+ * autoresolve_manual ("Resolve it Manually"), resolveWithNoEffect. Posted to the table with no owner: the engine
+ * targets the speaker, who moves the agenda phase along (anyone may still press it the legacy way).
+ */
+public class AgendaResolveKind implements KindSpec {
+
+    @Override
+    public String kind() {
+        return "agenda.resolve";
+    }
+
+    @Override
+    public int priority() {
+        return 100;
+    }
+
+    @Override
+    public boolean matches(String h) {
+        return h.startsWith("agendaResolution_")
+                || h.startsWith("tiedPlanets_agendaResolution_")
+                || h.equals("autoresolve_manual")
+                || h.equals("resolveWithNoEffect");
+    }
+
+    @Override
+    public Map<String, Object> value(String h, CaptureContext ctx) {
+        Map<String, Object> v = new LinkedHashMap<>();
+        if (h.startsWith("agendaResolution_")) {
+            String outcome = h.substring("agendaResolution_".length());
+            v.put("action", "resolve");
+            v.put("outcome", outcome);
+            v.put("name", AgendaSupport.outcomeName(ctx.game(), outcome));
+        } else if (h.startsWith("tiedPlanets_agendaResolution_")) {
+            String who = h.substring("tiedPlanets_agendaResolution_".length());
+            Player p = ctx.game().getPlayerFromColorOrFaction(who);
+            v.put("action", "planet_owner");
+            v.put("planetOwner", p == null ? who : p.getFaction());
+            v.put("userId", p == null ? null : p.getUserID());
+        } else if (h.equals("autoresolve_manual")) {
+            v.put("action", "manual");
+        } else if (h.equals("resolveWithNoEffect")) {
+            v.put("action", "no_effect");
+        } else {
+            return null;
+        }
+        return v;
+    }
+
+    @Override
+    public Target target(CaptureContext ctx, Target resolved) {
+        if (resolved != null && resolved.userId() != null && "owner_prefix".equals(resolved.resolvedBy())) return resolved;
+        Target s = AgendaSupport.speakerTarget(ctx.game(), "speaker");
+        return s == null ? resolved : s;
+    }
+
+    /** Targets the speaker (who is waited on), but the original button is pressable by anyone at the table. */
+    @Override
+    public boolean othersMayAnswer(ti4.game.Game game, ti4.game.Player answering, ti4.selfhost.engine.EngineModels.Decision decision) {
+        return decision.target() == null || !"owner_prefix".equals(decision.target().resolvedBy());
+    }
+
+    @Override
+    public String scope(CaptureContext ctx) {
+        return ctx.target() == null || ctx.target().userId() == null ? "table" : "player";
+    }
+}
