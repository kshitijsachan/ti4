+    }
+
+    // ------------------------------------------------------------------ the interaction hook (webhook followups)
+
+    private static final class Hook implements InvocationHandler {
+        final View view;
+        boolean ephemeral;
+
+        Hook(View view) {
+            this.view = view;
+        }
+
+        private String target(String id) {
