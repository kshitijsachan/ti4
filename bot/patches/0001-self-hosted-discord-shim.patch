diff --git a/src/main/java/ti4/selfhost/engine/kinds/ChooseSelectKind.java b/src/main/java/ti4/selfhost/engine/kinds/ChooseSelectKind.java
new file mode 100644
index 0000000..e939f8c
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/ChooseSelectKind.java
@@ -0,0 +1,87 @@
+package ti4.selfhost.engine.kinds;
+
+import java.lang.reflect.Field;
+import java.util.List;
+import java.util.Map;
+import javax.annotation.Nullable;
+import ti4.discord.interactions.routing.HandlerRegistry;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * Fallback for messages whose only controls are select menus (@SelectionHandler routes: setup / draft settings
+ * menus, lore, FoW setup…). They used to be kind "legacy" although INFRA-3 already describes every select as a typed
+ * input ({@code Decision.inputs}: {@code kind: "select"}, one {@code choice} field with min/max values and choices).
+ * This kind makes them typed: answer {@code {optionId: <inputs[i].id>, values: [...]}} or one flat option
+ * {@code "<menu>#<value>"}. A more specific kind always wins (lowest priority).
+ *
+ * <p>value per option: {@code {menu: <select handler id>}} (the choice itself is in the option id and in inputs).
+ */
+public class ChooseSelectKind implements KindSpec {
+
+    public static final String KIND = "choose.select";
+
+    @Override
+    public String kind() {
+        return KIND;
+    }
+
+    @Override
+    public int priority() {
+        return -50;
+    }
+
+    @Override
+    public boolean matches(String h) {
+        return isSelect(h);
+    }
+
+    /** Every control of the message is a select menu option. */
+    @Override
+    public boolean classifies(List<String> handlerIds) {
+        if (handlerIds.isEmpty()) return false;
+        for (String h : handlerIds) if (h == null || !isSelect(h)) return false;
+        return true;
+    }
+
+    @Override
+    @Nullable
+    public Map<String, Object> value(String h, CaptureContext ctx) {
+        return isSelect(h) ? SetupKindSupport.map("menu", h) : null;
+    }
+
+    // ------------------------------------------------------------------ select routes
+
+    private static volatile HandlerRegistry<?> selections;
+    private static volatile boolean failed;
+
+    /** Whether the id routes to a @SelectionHandler (select menu custom ids never reach button handlers). */
+    static boolean isSelect(String h) {
+        HandlerRegistry<?> reg = registry();
+        if (reg == null) return false;
+        try {
+            return reg.resolve(h).isMatched();
+        } catch (Throwable t) {
+            return false;
+        }
+    }
+
+    @Nullable
+    private static HandlerRegistry<?> registry() {
+        HandlerRegistry<?> r = selections;
+        if (r != null || failed) return r;
+        r = field(ti4.discord.interactions.selections.SelectionMenuProcessor.class);
+        if (r == null) failed = true;
+        return selections = r;
+    }
+
+    @Nullable
+    private static HandlerRegistry<?> field(Class<?> owner) {
+        try {
+            Field f = owner.getDeclaredField("registry");
+            f.setAccessible(true);
+            return (HandlerRegistry<?>) f.get(null);
+        } catch (Throwable t) {
+            return null;
+        }
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/ChooseSupport.java b/src/main/java/ti4/selfhost/engine/kinds/ChooseSupport.java
new file mode 100644
index 0000000..ac7d149
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/ChooseSupport.java
@@ -0,0 +1,163 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.function.BiConsumer;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+import javax.annotation.Nullable;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.game.Tile;
+import ti4.image.TileHelper;
+import ti4.model.TileModel;
+import ti4.selfhost.engine.KindSpec.CaptureContext;
+
+/**
+ * Shared machinery of the generic single-choice kinds ({@code choose.planet|system|player|unit|amount|card|confirm},
+ * classes {@code Choose*Kind}). A kind is a list of {@link Rule}s: a regex over the handler id with NAMED groups,
+ * plus the {@code source} (the card/ability/relic asking). The typed value is built from the groups by name:
+ *
+ * <pre>
+ * planet            {planet, planetName, tile}           (planet id; tile position looked up)
+ * tile              {tile, tileName}                     (tile POSITION, e.g. "201")
+ * tileId            {tileId, tileName}                   (tile id from the tile data, e.g. "d123")
+ * faction, faction2 {faction[, color]}                   (a seated player's faction)
+ * unit              {unit}                               (async unit id, e.g. "mech", "fs")
+ * amount, position  {amount | position} as integers
+ * relic, relic2     {relic, relicName, relicText}
+ * card              {card}                               (any other card id)
+ * trait             {trait}                              (cultural / industrial / hazardous / frontier)
+ * choice            {choice}                             (a raw sub-option string)
+ * </pre>
+ *
+ * Every value also carries {@code source} and the rule's fixed entries (e.g. {@code effect}). Add a rule to the
+ * right {@code Choose*Kind.RULES} for a one-step prompt of your area instead of writing a new kind; for anything
+ * richer (accumulators, windows, payloads) write a dedicated kind. Options no rule matches (Done, Cancel) get
+ * value null; the bot policy then falls back to them.
+ */
+public final class ChooseSupport {
+
+    private ChooseSupport() {}
+
+    /** One handler-id shape of a generic choice. */
+    public record Rule(
+            String source,
+            Pattern pattern,
+            Map<String, Object> fixed,
+            @Nullable BiConsumer<Map<String, Object>, CaptureContext> enrich) {
+
+        public boolean matches(String handlerId) {
+            return pattern.matcher(handlerId).matches();
+        }
+    }
+
+    public static Rule rule(String source, String regex) {
+        return new Rule(source, Pattern.compile(regex), Map.of(), null);
+    }
+
+    public static Rule rule(String source, String regex, Map<String, Object> fixed) {
+        return new Rule(source, Pattern.compile(regex), fixed, null);
+    }
+
+    public static Rule rule(
+            String source,
+            String regex,
+            Map<String, Object> fixed,
+            BiConsumer<Map<String, Object>, CaptureContext> enrich) {
+        return new Rule(source, Pattern.compile(regex), fixed, enrich);
+    }
+
+    /**
+     * Whether a message is entirely ours: at least one option matches and every other option is "chrome" (dismiss /
+     * decline / undo / done). Generic kinds use this so they never claim mixed menus (e.g. the perpetual player-info
+     * menu that also offers "use agent").
+     */
+    public static boolean onlyOurs(List<String> handlerIds, java.util.function.Predicate<String> ours) {
+        boolean any = false;
+        for (String h : handlerIds) {
+            if (h == null) continue;
+            if (ours.test(h)) any = true;
+            else if (!isChrome(h)) return false;
+        }
+        return any;
+    }
+
+    /** Dismiss / decline / undo / done buttons that ride along on many prompts. */
+    public static boolean isChrome(String h) {
+        return h.startsWith("deleteButtons")
+                || h.startsWith("ultimateUndo")
+                || h.equals("deleteThisButton")
+                || h.startsWith("no_")
+                || h.equals("no")
+                || h.startsWith("decline")
+                || h.startsWith("finishComponentAction")
+                || h.startsWith("done");
+    }
+
+    @Nullable
+    static Rule find(List<Rule> rules, String handlerId) {
+        for (Rule r : rules) if (r.matches(handlerId)) return r;
+        return null;
+    }
+
+    @Nullable
+    static Map<String, Object> value(List<Rule> rules, String handlerId, CaptureContext ctx) {
+        Rule r = find(rules, handlerId);
+        if (r == null) return null;
+        Matcher m = r.pattern().matcher(handlerId);
+        if (!m.matches()) return null;
+        Map<String, Object> v = new LinkedHashMap<>();
+        v.put("source", r.source());
+        v.putAll(r.fixed());
+        Game game = ctx.game();
+        for (String g : m.namedGroups().keySet()) {
+            String s = m.group(g);
+            if (s == null) continue;
+            switch (g) {
+                case "planet" -> ExploreSupport.putPlanet(v, game, s);
+                case "tile" -> {
+                    v.put("tile", s);
+                    Tile t = game == null ? null : game.getTileByPosition(s);
+                    v.put("tileName", t == null ? null : t.getRepresentation());
+                }
+                case "tileId" -> {
+                    v.put("tileId", s);
+                    TileModel tm = TileHelper.getTileById(s);
+                    v.put("tileName", tm == null ? null : tm.getName());
+                }
+                case "faction", "faction2" -> {
+                    v.put(g, s);
+                    Player p = game == null ? null : game.getPlayerFromColorOrFaction(s);
+                    if (p != null && "faction".equals(g)) v.put("color", p.getColor());
+                }
+                case "amount", "position" -> {
+                    try {
+                        v.put(g, Integer.parseInt(s));
+                    } catch (NumberFormatException e) {
+                        v.put(g, null);
+                    }
+                }
+                case "relic", "relic2" -> {
+                    Map<String, Object> rel = ExploreSupport.relic(s);
+                    if ("relic2".equals(g)) {
+                        v.put("relic2", rel.get("relic"));
+                        v.put("relic2Name", rel.get("relicName"));
+                    } else {
+                        v.putAll(rel);
+                    }
+                }
+                default -> v.put(g, s);
+            }
+        }
+        if (r.enrich() != null) {
+            try {
+                r.enrich().accept(v, ctx);
+            } catch (RuntimeException e) {
+                // Extras are best-effort (capture reads the game while handlers mutate it); the ids stay typed.
+            }
+        }
+        return v;
+    }
+}
