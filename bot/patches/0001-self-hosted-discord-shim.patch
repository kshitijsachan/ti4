+package ti4.selfhost.engine.kinds;
+
+import java.util.List;
+import java.util.Map;
+import ti4.selfhost.engine.EngineModels.Progress;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * The manual hit-assignment menu (ButtonHelper.getButtonsForRemovingAllUnitsInSystem): one option per unit type and
+ * state, "Sustain" (assignDamage_) or "Destroy"/"Remove" (assignHits_), plus remove-all and "Done" (deleteButtons).
+ * Each press edits the menu in place. Owner = FFCC_ on the unit buttons.
+ */
+public class CombatAssignUnitsKind implements KindSpec {
+
+    @Override
+    public String kind() {
+        return "combat.assign_units";
+    }
+
+    @Override
+    public int priority() {
+        return 100;
+    }
+
+    @Override
+    public boolean classifies(List<String> handlerIds) {
+        for (String h : handlerIds) {
+            if (h != null && (h.startsWith("assignHits_") || h.startsWith("assignDamage_"))) return true;
+        }
+        return false;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return handlerId.startsWith("assignHits_")
+                || handlerId.startsWith("assignDamage_")
+                || handlerId.equals("deleteButtons");
+    }
+
+    /** Hits owed and assigned so far, from the units on the board (recomputed after every save). */
+    @Override
+    public Progress progress(CaptureContext ctx) {
+        return CombatSupport.assignProgress(ctx.game(), ctx.player());
+    }
+
+    @Override
+    public boolean dynamic() {
+        return true;
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        Map<String, Object> v = CombatSupport.value(handlerId, ctx.game());
+        if (v != null && ctx.player() != null) {
+            String type = ctx.game().getStoredValue(ctx.player().getFaction() + "latestAssignHits");
+            v.put("assignType", type == null || type.isBlank() ? "combat" : type.toLowerCase());
+        }
+        return v;
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/CombatAutomateKind.java b/src/main/java/ti4/selfhost/engine/kinds/CombatAutomateKind.java
new file mode 100644
index 0000000..6081e35
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/CombatAutomateKind.java
@@ -0,0 +1,57 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.List;
+import java.util.Map;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * "Automate the entire ground combat" (StartCombatService, combat thread): automateGroundCombat_&lt;p1&gt;_&lt;p2&gt;_
+ * &lt;planet&gt;_unconfirmed, one per contested planet, on a message of its own (no owner: either combatant votes), and the
+ * opponent's confirmation automateGroundCombat_…_confirmed (owner-prefixed to the opponent, one button). Pressing the
+ * vote asks the opponent; pressing the confirmation (or a vote against a dummy) resolves the whole ground combat.
+ * On the combat controls message the same id is a combat.round option (that kind outranks this one).
+ *
+ * <p>value: {planet, factions: [p1, p2], confirmed}. Vote prompt: table scope, no window (optional; nobody is on the
+ * hook). Confirmation: the opponent's (owner prefix).
+ */
+public class CombatAutomateKind implements KindSpec {
+    private static final Pattern ID = Pattern.compile("^automateGroundCombat_([^_]+)_([^_]+)_(.+)_(confirmed|unconfirmed)$");
+
+    @Override
+    public String kind() {
+        return "combat.automate";
+    }
+
+    @Override
+    public int priority() {
+        return 85;
+    }
+
+    @Override
+    public boolean classifies(List<String> handlerIds) {
+        for (String h : handlerIds) if (h != null && h.startsWith("automateGroundCombat_")) return true;
+        return false;
+    }
+
+    @Override
+    public boolean matches(String h) {
+        return ID.matcher(h).matches();
+    }
+
+    @Override
+    public Map<String, Object> value(String h, CaptureContext ctx) {
+        Matcher m = ID.matcher(h);
+        if (!m.matches()) return null;
+        return SetupKindSupport.map(
+                "planet", m.group(3),
+                "factions", List.of(m.group(1), m.group(2)),
+                "confirmed", "confirmed".equals(m.group(4)));
+    }
+
+    @Override
+    public String scope(CaptureContext ctx) {
+        return ctx.target() == null || ctx.target().userId() == null ? "table" : "player";
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/CombatBombardKind.java b/src/main/java/ti4/selfhost/engine/kinds/CombatBombardKind.java
new file mode 100644
index 0000000..fbbf28d
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/CombatBombardKind.java
@@ -0,0 +1,139 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.helpers.BombardmentAssignment;
+import ti4.selfhost.engine.EngineModels.Progress;
+import ti4.selfhost.engine.EngineModels.Target;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * BOMBARDMENT target step (BombardmentButtonHandler): after "bombardConfirm_" the bombarding player assigns each
+ * bombardment unit (and Plasma Scoring / Argent commander die) to a planet, edited in place, then "Done Assigning"
+ * (combatRoll_&lt;pos&gt;_space_bombardment) rolls. The engine already auto-assigned every unit to a planet when the
+ * prompt opened, so "Done" is always a legal answer. Claims the message ahead of combat.round (which would make the
+ * roll a table window).
+ *
+ * <p>value: assign / unassign {op, source (unit async id | plasmascoring | argentcommander), planet, galvanized,
+ * type: UNIT|TECH|LEADER}; the roll {op: "done", tile}. progress (flow "combat.bombard"): accumulated.assigned =
+ * [{source, planet, galvanized, type}] from the stored value {@code assignedBombardment<faction>}.
+ */
+public class CombatBombardKind implements KindSpec {
+
+    @Override
+    public String kind() {
+        return "combat.bombard";
+    }
+
+    @Override
+    public int priority() {
+        return 95;
+    }
+
+    @Override
+    public boolean classifies(List<String> handlerIds) {
+        for (String h : handlerIds) {
+            if (h != null && (h.startsWith("assignBombardUnit_") || h.startsWith("unassignBombardUnit_"))) return true;
+        }
+        return false;
+    }
+
+    @Override
+    public boolean matches(String h) {
+        return h.startsWith("assignBombardUnit_")
+                || h.startsWith("unassignBombardUnit_")
+                || (h.startsWith("combatRoll_") && h.contains("_bombardment"));
+    }
+
+    @Override
+    public Map<String, Object> value(String h, CaptureContext ctx) {
+        if (h.startsWith("combatRoll_")) {
+            String[] p = h.split("_");
+            return SetupKindSupport.map("op", "done", "tile", p.length > 1 ? p[1] : null);
+        }
+        boolean assign = h.startsWith("assignBombardUnit_");
+        try {
+            BombardmentAssignment a = BombardmentAssignment.decode(h.substring(h.indexOf('_') + 1));
+            Map<String, Object> v = describe(a);
+            v.put("op", assign ? "assign" : "unassign");
+            return v;
+        } catch (RuntimeException e) {
+            return null;
+        }
+    }
+
+    private static Map<String, Object> describe(BombardmentAssignment a) {
+        Map<String, Object> v = new LinkedHashMap<>();
+        v.put("source", a.sourceId());
+        v.put("planet", a.planet());
+        v.put("galvanized", a.galvanized());
+        v.put("type", a.type().name());
+        return v;
+    }
+
+    /** The bombarding player: the active player (bombardment happens in their tactical action). */
+    @Override
+    public Target target(CaptureContext ctx, Target resolved) {
+        Player p = bombarder(ctx.game(), ctx.player());
+        return p == null ? null : new Target(p.getUserID(), p.getFaction(), p.getColor(), "active_player");
+    }
+
+    private static Player bombarder(Game game, Player fallback) {
+        Player active = game.getActivePlayer();
+        return active != null ? active : fallback;
+    }
+
+    @Override
+    public boolean dynamic() {
+        return true;
+    }
+
+    /**
+     * Rules audit (factions): no BOMBARDMENT against a planet with an active PLANETARY SHIELD — assigning a unit to it,
+     * or rolling with nothing else left to bombard, is refused (the bot's handlers refuse it too).
+     */
+    @Override
+    public String validate(Game game, Player answering, ti4.selfhost.engine.EngineModels.Decision decision, String optionId) {
+        if (game == null || optionId == null) return null;
+        String h = ti4.discord.interactions.routing.ComponentIdEnvelope.decode(optionId).handlerId();
+        Player p = bombarder(game, answering);
+        if (h.startsWith("assignBombardUnit_")) {
+            try {
+                BombardmentAssignment a = BombardmentAssignment.decode(h.substring(h.indexOf('_') + 1));
+                String why = ti4.service.combat.PlanetaryShieldRules.shieldReason(
+                        game, p, game.getTileByPosition(game.getActiveSystem()), a.planet());
+                return why == null ? null : why + ": units cannot use BOMBARDMENT against it.";
+            } catch (RuntimeException e) {
+                return null;
+            }
+        }
+        String why = ti4.service.combat.PlanetaryShieldRules.rollRefusal(game, p, h);
+        return why == null ? null : "No planet can be bombarded: " + why + ".";
+    }
+
+    @Override
+    public Progress progress(CaptureContext ctx) {
+        Player p = bombarder(ctx.game(), ctx.player());
+        if (p == null) return null;
+        List<Map<String, Object>> assigned = new ArrayList<>();
+        String json = ctx.game().getStoredValue("assignedBombardment" + p.getFaction());
+        if (json != null && !json.isBlank()) {
+            try {
+                List<BombardmentAssignment> list = new tools.jackson.databind.ObjectMapper()
+                        .readValue(json, new tools.jackson.core.type.TypeReference<List<BombardmentAssignment>>() {});
+                for (BombardmentAssignment a : list) assigned.add(describe(a));
+            } catch (RuntimeException ignored) {
+                // unreadable stored value: no progress detail
+            }
+        }
+        Map<String, Object> acc = new LinkedHashMap<>();
+        acc.put("assigned", assigned);
+        Map<String, Object> req = new LinkedHashMap<>();
+        req.put("tile", ctx.game().getActiveSystem());
+        return new Progress("combat.bombard", "assign", acc, req, true);
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/CombatEngageKind.java b/src/main/java/ti4/selfhost/engine/kinds/CombatEngageKind.java
