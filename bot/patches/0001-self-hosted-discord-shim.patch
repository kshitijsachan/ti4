--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/interaction/MessageSink.java
@@ -0,0 +1,124 @@
+package ti4.selfhost.engine.interaction;
+
+import java.util.concurrent.TimeUnit;
+import javax.annotation.Nullable;
+import net.dv8tion.jda.api.JDA;
+import net.dv8tion.jda.api.entities.Guild;
+import net.dv8tion.jda.api.entities.Member;
+import net.dv8tion.jda.api.entities.Message;
+import net.dv8tion.jda.api.entities.User;
+import net.dv8tion.jda.api.entities.channel.middleman.MessageChannel;
+import net.dv8tion.jda.api.requests.RestAction;
+import net.dv8tion.jda.api.utils.messages.MessageCreateData;
+import net.dv8tion.jda.api.utils.messages.MessageEditData;
+import org.apache.commons.lang3.function.Consumers;
+import ti4.discord.JdaService;
+import ti4.logging.BotLogger;
+
+/**
+ * Where an engine answer's messages go. Today: JDA channel REST (public API only — no interaction tokens), so the
+ * Discord mirror and DecisionCapture keep working unchanged. W-INFRA-4 replaces this with a decisions-only sink.
+ */
+public interface MessageSink {
+
+    /** Nonce prefix the shim understands as "ephemeral for this user" on a channel message (see shim rest.ts). */
+    String EPHEMERAL_NONCE = "eph:";
+
+    MessageChannel channel(String channelId);
+
+    @Nullable
+    Message fetch(String channelId, String messageId);
+
+    /** ephemeralFor = user id when only that user may see the message. */
+    @Nullable
+    Message send(String channelId, MessageCreateData data, @Nullable String ephemeralFor);
+
+    @Nullable
+    Message edit(String channelId, String messageId, MessageEditData data);
+
+    void delete(String channelId, String messageId, int delaySeconds);
+
+    User user(String userId);
+
+    @Nullable
+    Member member(Guild guild, String userId);
+
+    static MessageSink jda() {
+        return JdaSink.INSTANCE;
+    }
+
+    final class JdaSink implements MessageSink {
+        static final JdaSink INSTANCE = new JdaSink();
+
+        private static JDA jda() {
+            if (JdaService.jda == null) throw new IllegalStateException("JDA not ready");
+            return JdaService.jda;
+        }
+
+        @Override
+        public MessageChannel channel(String channelId) {
+            MessageChannel ch = jda().getChannelById(MessageChannel.class, channelId);
+            if (ch == null) ch = jda().getThreadChannelById(channelId);
+            if (ch == null) throw new IllegalStateException("unknown channel " + channelId);
+            return ch;
+        }
+
+        @Override
+        public Message fetch(String channelId, String messageId) {
+            try {
+                return channel(channelId).retrieveMessageById(messageId).complete();
+            } catch (Exception e) {
+                return null;
+            }
+        }
+
+        @Override
+        public Message send(String channelId, MessageCreateData data, String ephemeralFor) {
+            var action = channel(channelId).sendMessage(data);
+            if (ephemeralFor != null) action = action.setNonce(EPHEMERAL_NONCE + ephemeralFor);
+            return completeOrQueue(action);
+        }
+
+        @Override
+        public Message edit(String channelId, String messageId, MessageEditData data) {
+            return completeOrQueue(channel(channelId).editMessageById(messageId, data));
+        }
+
+        /**
+         * Synchronous on the answering thread (so the answer's messages exist when it returns); inside a JDA callback
+         * (a handler's queue(success -> ...)) blocking is forbidden, so fall back to queue there.
+         */
+        private static Message completeOrQueue(RestAction<Message> action) {
+            try {
+                return action.complete();
+            } catch (IllegalStateException callbackThread) {
+                action.queue(Consumers.nop(), BotLogger::catchRestError);
+                return null;
+            }
+        }
+
+        @Override
+        public void delete(String channelId, String messageId, int delaySeconds) {
+            var action = channel(channelId).deleteMessageById(messageId);
+            if (delaySeconds > 0) action.queueAfter(delaySeconds, TimeUnit.SECONDS, Consumers.nop(), BotLogger::catchRestError);
+            else action.queue(Consumers.nop(), BotLogger::catchRestError);
+        }
+
+        @Override
+        public User user(String userId) {
+            User u = jda().getUserById(userId);
+            return u != null ? u : jda().retrieveUserById(userId).complete();
+        }
+
+        @Override
+        public Member member(Guild guild, String userId) {
+            Member m = guild.getMemberById(userId);
+            if (m != null) return m;
+            try {
+                return guild.retrieveMemberById(userId).complete();
+            } catch (Exception e) {
+                return null;
+            }
+        }
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/interaction/NativeAction.java b/src/main/java/ti4/selfhost/engine/interaction/NativeAction.java
new file mode 100644
index 0000000..4698c80
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/interaction/NativeAction.java
@@ -0,0 +1,154 @@
+package ti4.selfhost.engine.interaction;
+
+import java.lang.reflect.InvocationHandler;
+import java.lang.reflect.InvocationTargetException;
+import java.lang.reflect.Method;
+import java.lang.reflect.Proxy;
+import java.util.Set;
+import java.util.concurrent.CompletableFuture;
+import java.util.function.Consumer;
+import java.util.function.Function;
+import javax.annotation.Nullable;
+import ti4.discord.JdaService;
+import ti4.logging.BotLogger;
+
+/**
+ * A JDA RestAction-shaped object for an engine answer: builder calls (setContent, setComponents, addFiles, ...) go to a
+ * real JDA message builder; queue/complete/submit run {@code perform} once, synchronously, on the answering thread.
+ * Combinators (map, flatMap, queueAfter, ...) are the interface defaults, which only call queue on this object.
+ *
+ * <p>Used for the interaction-token operations a handler can call on an engine answer (reply, deferEdit, editMessage,
+ * getHook().sendMessage/editOriginal/deleteOriginal, replyModal): there is no token, so each maps onto an
+ * {@link EngineInteraction} op instead.
+ */
+final class NativeAction implements InvocationHandler {
+
+    /** Fluent configuration that has no meaning without Discord; accepted and ignored. */
+    private static final Set<String> IGNORED = Set.of(
+            "setCheck", "addCheck", "timeout", "deadline", "reason", "closeResources", "setUsername", "setAvatarUrl",
+            "createThread", "useComponentsV2", "mentionRepliedUser", "setSuppressedNotifications", "setVoiceMessage");
+
+    private final Class<?> iface;
+    @Nullable
+    private final Object builder;
+    private final Function<NativeAction, Object> perform;
+    boolean ephemeral;
+    private boolean done;
+    private Object result;
+
+    private NativeAction(Class<?> iface, @Nullable Object builder, boolean ephemeral, Function<NativeAction, Object> perform) {
+        this.iface = iface;
+        this.builder = builder;
+        this.ephemeral = ephemeral;
+        this.perform = perform;
+    }
+
+    static <T> T of(Class<T> iface, @Nullable Object builder, boolean ephemeral, Function<NativeAction, Object> perform) {
+        return iface.cast(Proxy.newProxyInstance(
+                NativeAction.class.getClassLoader(),
+                new Class<?>[] {iface},
+                new NativeAction(iface, builder, ephemeral, perform)));
+    }
+
+    @SuppressWarnings("unchecked")
+    <B> B builder() {
+        return (B) builder;
+    }
+
+    private synchronized Object run() {
+        if (!done) {
+            result = perform.apply(this);
+            done = true;
+        }
+        return result;
+    }
+
+    @Override
+    @SuppressWarnings("unchecked")
+    public Object invoke(Object proxy, Method m, Object[] args) throws Throwable {
+        String n = m.getName();
+        Object[] a = args == null ? new Object[0] : args;
+        switch (n) {
+            case "queue" -> {
+                if (a.length == 2) {
+                    Object r;
+                    try {
+                        r = run();
+                    } catch (Throwable t) {
+                        if (a[1] != null) ((Consumer<Throwable>) a[1]).accept(t);
+                        else BotLogger.catchRestError(t);
+                        return null;
+                    }
+                    if (a[0] != null) ((Consumer<Object>) a[0]).accept(r);
+                    return null;
+                }
+            }
+            case "complete" -> {
+                if (a.length == 1 && a[0] instanceof Boolean) return run();
+            }
+            case "submit" -> {
+                if (a.length == 1 && a[0] instanceof Boolean) {
+                    try {
+                        return CompletableFuture.completedFuture(run());
+                    } catch (Throwable t) {
+                        return CompletableFuture.failedFuture(t);
+                    }
+                }
+            }
+            case "getJDA" -> {
+                return JdaService.jda;
+            }
+            case "setEphemeral" -> {
+                ephemeral = (Boolean) a[0];
+                return proxy;
+            }
+            case "isEphemeral" -> {
+                return ephemeral;
+            }
+            case "getCheck" -> {
+                return null;
+            }
+            case "toString" -> {
+                return "EngineAction<" + iface.getSimpleName() + ">";
+            }
+            case "hashCode" -> {
+                return System.identityHashCode(proxy);
+            }
+            case "equals" -> {
+                return proxy == a[0];
+            }
+            default -> {}
+        }
+        if (IGNORED.contains(n) && m.getReturnType().isInstance(proxy)) return proxy;
+        if (builder != null) {
+            Method bm = find(builder.getClass(), m);
+            if (bm != null) {
+                try {
+                    Object r = bm.invoke(builder, a);
+                    return r == builder ? proxy : r;
+                } catch (InvocationTargetException e) {
+                    throw e.getCause();
+                }
+            }
+        }
+        if (m.isDefault()) return InvocationHandler.invokeDefault(proxy, m, args);
+        if (m.getReturnType().isInstance(proxy)) return proxy;
+        throw new UnsupportedOperationException("engine answer: " + iface.getSimpleName() + "." + n + " is not supported");
+    }
+
+    @Nullable
+    private static Method find(Class<?> type, Method m) {
+        try {
+            return type.getMethod(m.getName(), m.getParameterTypes());
+        } catch (NoSuchMethodException e) {
+            for (Method c : type.getMethods()) {
+                if (!c.getName().equals(m.getName()) || c.getParameterCount() != m.getParameterCount()) continue;
+                Class<?>[] want = m.getParameterTypes(), have = c.getParameterTypes();
+                boolean ok = true;
+                for (int i = 0; i < want.length && ok; i++) ok = have[i].isAssignableFrom(want[i]);
+                if (ok) return c;
+            }
+            return null;
+        }
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/interaction/NativeCoverage.java b/src/main/java/ti4/selfhost/engine/interaction/NativeCoverage.java
