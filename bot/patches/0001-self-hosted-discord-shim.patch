@@ -0,0 +1,33 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.List;
+import java.util.regex.Pattern;
+
+/**
+ * Agents whose exhaustAgent_ id names a planet of the active system instead of a player
+ * (ButtonHelperAgents: exhaustAgent_&lt;agent&gt;_&lt;tile&gt;_&lt;planet&gt;): L1Z1X I48S, Sardakk T'ro and Nomad Field Marshal
+ * Mercer. Typed as leader.use {step: exhaustAgent, action: target, tile, planet}. Also the other non-player args:
+ * Argent Trrakan Aun Zulok on the production menu (exhaustAgent_argentagent_&lt;tile&gt; -&gt; tile) and Nomad Artuno
+ * (exhaustAgent_nomadagentartuno_&lt;tg&gt; -&gt; amount of trade goods placed on it). The class name sorts before FactionStepsLeaders on purpose:
+ * the generic rule there would read the tile position as the target player.
+ */
+public class FactionStepsAgentPlanets extends FactionStepsRegex {
+    private static Rule agent(String agent, String faction) {
+        return new Rule("leader.use", "", agent, faction, "exhaustAgent", "target", true,
+                Pattern.compile("exhaustAgent_" + agent + "_(?<tile>[^_]+)_(?<planet>.+)"), null);
+    }
+
+    private static final List<Rule> RULES = List.of(
+            agent("l1z1xagent", "l1z1x"),
+            agent("sardakkagent", "sardakk"),
+            agent("nomadagentmercer", "nomad"),
+            new Rule("leader.use", "", "argentagent", "argent", "exhaustAgent", "target", true,
+                    Pattern.compile("exhaustAgent_argentagent_(?<tile>[^_]+)"), null),
+            new Rule("leader.use", "", "nomadagentartuno", "nomad", "exhaustAgent", "target", true,
+                    Pattern.compile("exhaustAgent_nomadagentartuno_(?<amount>\\d+)"), null));
+
+    @Override
+    protected List<Rule> rules() {
+        return RULES;
+    }
+}
