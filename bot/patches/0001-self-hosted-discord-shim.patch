--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/AgendaSupport.java
@@ -0,0 +1,290 @@
+package ti4.selfhost.engine.kinds;
+
+import java.lang.reflect.Method;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import javax.annotation.Nullable;
+import net.dv8tion.jda.api.components.buttons.Button;
+import org.apache.commons.lang3.math.NumberUtils;
+import ti4.game.Game;
+import ti4.game.Planet;
+import ti4.game.Player;
+import ti4.game.Tile;
+import ti4.helpers.AgendaHelper;
+import ti4.helpers.AgendaRiderHelper;
+import ti4.image.Mapper;
+import ti4.model.AgendaModel;
+import ti4.selfhost.engine.EngineModels.AgendaOutcomeState;
+import ti4.selfhost.engine.EngineModels.AgendaRider;
+import ti4.selfhost.engine.EngineModels.AgendaState;
+import ti4.selfhost.engine.EngineModels.AgendaVoteCast;
+import ti4.selfhost.engine.EngineModels.Target;
+
+/**
+ * Shared agenda facts for the agenda.* kinds and GameState.agenda, read straight from Game (currentAgendaInfo =
+ * "type_target_uniqueId_agendaId", currentAgendaVotes = outcome -> "who_votes;who_riderName;..."). Not a kind.
+ */
+public final class AgendaSupport {
+    private AgendaSupport() {}
+
+    /** "Elect Player", "For/Against", ... (the agenda card's target line); null when no agenda is up. */
+    @Nullable
+    public static String target(Game game) {
+        String info = game.getCurrentAgendaInfo();
+        if (info == null) return null;
+        String[] parts = info.split("_");
+        return parts.length < 2 ? null : parts[1];
+    }
+
+    /** The vocabulary of outcome ids, decided the same way VoteButtonHandler.firstStepOfVoting does. */
+    public static String outcomeType(Game game) {
+        String t = target(game);
+        if (t == null) return "other";
+        String l = t.toLowerCase(Locale.ROOT);
+        if (t.contains("For") || t.contains("for")) return "for_against";
+        if (l.contains("player")) return "player";
+        if (l.contains("planet")) return "planet";
+        if (l.contains("secret")) return "secret_objective";
+        if (l.contains("strategy")) return "strategy_card";
+        if (t.contains("unit upgrade")) return "unit_upgrade";
+        if (l.contains("unit")) return "unit";
+        if (l.contains("law")) return "law";
+        return "other";
+    }
+
+    public static String outcomeName(Game game, String outcome) {
+        try {
+            return AgendaHelper.getAgendaOutcomeName(game, outcome, true);
+        } catch (Exception e) {
+            return outcome;
+        }
+    }
+
+    /** Outcomes a vote may name now: [{id, name}]. Planets: every non-station planet a player controls. */
+    public static List<Map<String, Object>> outcomes(Game game) {
+        List<String> ids = new ArrayList<>();
+        String type = outcomeType(game);
+        try {
+            switch (type) {
+                case "for_against" -> ids.addAll(List.of("for", "against"));
+                case "player" -> ids.addAll(idsOf(AgendaRiderHelper.getPlayerOutcomeButtons(game, null, "outcome", null)));
+                case "planet" -> ids.addAll(electablePlanets(game));
+                case "secret_objective" -> ids.addAll(idsOf(AgendaRiderHelper.getSecretOutcomeButtons(game, null, "outcome")));
+                case "strategy_card" -> ids.addAll(idsOf(AgendaRiderHelper.getStrategyOutcomeButtons(game, null, "outcome")));
+                case "unit_upgrade" -> ids.addAll(idsOf(AgendaRiderHelper.getUnitUpgradeOutcomeButtons(game, null, "outcome")));
+                case "unit" -> ids.addAll(idsOf(AgendaRiderHelper.getUnitOutcomeButtons(game, null, "outcome")));
+                default -> ids.addAll(idsOf(AgendaRiderHelper.getLawOutcomeButtons(game, null, "outcome")));
+            }
+        } catch (Exception ignored) {
+            // racy read of a game mid-change: an empty list just means "use the step prompts"
+        }
+        List<Map<String, Object>> out = new ArrayList<>();
+        for (String id : ids) out.add(outcome(game, id));
+        return out;
+    }
+
+    static Map<String, Object> outcome(Game game, String id) {
+        Map<String, Object> m = new LinkedHashMap<>();
+        m.put("id", id);
+        m.put("name", outcomeName(game, id));
+        Player p = "player".equals(outcomeType(game)) ? game.getPlayerFromColorOrFaction(id) : null;
+        if (p != null) m.put("userId", p.getUserID());
+        return m;
+    }
+
+    private static List<String> idsOf(List<Button> buttons) {
+        List<String> out = new ArrayList<>();
+        for (Button b : buttons) {
+            String id = b.getCustomId();
+            if (id == null) continue;
+            int i = id.indexOf("outcome_");
+            if (i >= 0) out.add(id.substring(i + "outcome_".length()));
+        }
+        return out;
+    }
+
+    /** Planets that the Elect Planet outcome lists (non-fog), with the "non-home" restriction applied. */
+    public static List<String> electablePlanets(Game game) {
+        String t = target(game);
+        boolean nonHome = t != null && t.toLowerCase(Locale.ROOT).contains("non-home");
+        List<String> out = new ArrayList<>();
+        for (Player owner : game.getRealPlayers()) {
+            for (String planet : owner.getPlanets()) {
+                Planet p = game.getPlanetsInfo().get(planet);
+                if (p != null && p.isSpaceStation(game)) continue;
+                if (nonHome) {
+                    Tile tile = game.getTileFromPlanet(planet);
+                    if (tile != null && tile.isHomeSystem(game)) continue;
+                    if ("mr".equalsIgnoreCase(planet) || "mrte".equalsIgnoreCase(planet)) continue;
+                }
+                out.add(planet);
+            }
+        }
+        return out;
+    }
+
+    /** Who controls a planet (for the "choose the planet's owner, then the planet" vote flow). */
+    @Nullable
+    public static Player planetOwner(Game game, String planet) {
+        for (Player p : game.getRealPlayers()) if (p.getPlanets().contains(planet)) return p;
+        return null;
+    }
+
+    /** Ready planets with a vote value for this player: planet id -> votes (AgendaHelper.getSpecificPlanetsVoteWorth). */
+    public static Map<String, Integer> planetVotes(Game game, Player player) {
+        Map<String, Integer> out = new LinkedHashMap<>();
+        for (String planet : new ArrayList<>(player.getReadiedPlanets())) {
+            try {
+                int v = AgendaHelper.getSpecificPlanetsVoteWorth(player, game, planet);
+                if (v > 0) out.put(planet, v);
+            } catch (Exception ignored) {
+                // unknown planet model: not votable
+            }
+        }
+        return out;
+    }
+
+    /** Votes this player can cast now, as the engine counts them (AgendaHelper.getVoteTotal; 0 = cannot vote). */
+    public static int availableVotes(Game game, Player player) {
+        try {
+            Method m = AgendaHelper.class.getDeclaredMethod("getVoteTotal", Player.class, Game.class);
+            m.setAccessible(true);
+            int[] r = (int[]) m.invoke(null, player, game);
+            return r[0];
+        } catch (Exception e) {
+            return planetVotes(game, player).values().stream().mapToInt(Integer::intValue).sum();
+        }
+    }
+
+    @SuppressWarnings("unchecked")
+    public static List<Player> votingOrder(Game game) {
+        try {
+            Method m = AgendaHelper.class.getDeclaredMethod("getVotingOrder", Game.class);
+            m.setAccessible(true);
+            return (List<Player>) m.invoke(null, game);
+        } catch (Exception e) {
+            return game.getRealPlayers();
+        }
+    }
+
+    /** The speaker as a decision target (the tie-breaker and the one who moves the agenda phase along). */
+    @Nullable
+    public static Target speakerTarget(Game game, String how) {
+        Player s = game.getSpeaker();
+        if (s == null) return null;
+        return new Target(s.getUserID(), s.getFaction(), s.getColor(), how);
+    }
+
+    // ------------------------------------------------------------------ when / after queue
+
+    /** Has this player decided on whens ("when") or afters ("after") for the current agenda (queued or passed)? */
+    public static boolean decided(Game game, Player p, String which) {
+        String f = p.getFaction() + "_";
+        String cap = "when".equals(which) ? "Whens" : "Afters";
+        return game.getStoredValue("declined" + cap).contains(f) || game.getStoredValue("queued" + cap).contains(f);
+    }
+
+    /** "queued" | "passed" | null for one player and "when"/"after". */
+    @Nullable
+    static String response(Game game, Player p, String which) {
+        String f = p.getFaction() + "_";
+        String cap = "when".equals(which) ? "Whens" : "Afters";
+        if (game.getStoredValue("queued" + cap).contains(f)) return "queued";
+        if (game.getStoredValue("declined" + cap).contains(f)) return "passed";
+        return null;
+    }
+
+    /** Real players who still have to decide on whens / afters for this agenda (user ids, speaker order). */
+    public static List<String> awaiting(Game game, String which) {
+        List<String> out = new ArrayList<>();
+        if ("after".equals(which) && game.getStoredValue("whensResolved").isEmpty()) return out;
+        String resolved = game.getStoredValue("when".equals(which) ? "whensResolved" : "aftersResolved");
+        if (!resolved.isEmpty()) return out;
+        for (Player p : game.getRealPlayers()) if (!decided(game, p, which)) out.add(p.getUserID());
+        return out;
+    }
+
+    // ------------------------------------------------------------------ GameState.agenda
+
+    @Nullable
+    public static AgendaState state(Game game, @Nullable String viewerUserId) {
+        String phase = game.getPhaseOfGame() == null ? "" : game.getPhaseOfGame();
+        String info = game.getCurrentAgendaInfo();
+        if (info == null || info.split("_").length < 2 || !phase.toLowerCase(Locale.ROOT).startsWith("agenda"))
+            return null;
+        String[] parts = info.split("_", 4);
+        String agendaId = parts.length >= 4 ? parts[3] : null;
+        String name = null;
+        String type = parts[0];
+        if ("covert".equals(agendaId)) {
+            name = "Covert Legislation";
+        } else if (agendaId != null) {
+            AgendaModel model = Mapper.getAgenda(agendaId);
+            if (model != null) name = model.getName();
+        }
+        int number = NumberUtils.toInt(game.getStoredValue("agendaCount"), 0);
+        boolean hidden = game.isFowMode() || game.isHiddenAgendaMode();
+
+        List<String> order = new ArrayList<>();
+        Map<String, Integer> available = new LinkedHashMap<>();
+        for (Player p : votingOrder(game)) {
+            if (p == null || !p.isRealPlayer()) continue;
+            order.add(p.getUserID());
+            if (!hidden || p.getUserID().equals(viewerUserId)) available.put(p.getUserID(), availableVotes(game, p));
+        }
+        Player active = game.getActivePlayer();
+        String voter = "agendavoting".equalsIgnoreCase(phase) && active != null ? active.getUserID() : null;
+        return new AgendaState(
+                agendaId,
+                name,
+                type,
+                parts[1],
+                outcomeType(game),
+                number,
+                phase,
+                !game.getStoredValue("whensResolved").isEmpty(),
+                !game.getStoredValue("aftersResolved").isEmpty(),
+                awaiting(game, "when"),
+                awaiting(game, "after"),
+                voter,
+                hidden ? List.of() : order,
+                available,
+                hidden ? List.of() : castOutcomes(game));
+    }
+
+    /** Votes and riders placed so far, per outcome, most votes first. */
+    public static List<AgendaOutcomeState> castOutcomes(Game game) {
+        List<AgendaOutcomeState> out = new ArrayList<>();
+        Map<String, String> votes = game.getCurrentAgendaVotes();
+        if (votes == null) return out;
+        for (Map.Entry<String, String> e : votes.entrySet()) {
+            if (e.getValue() == null || e.getValue().isBlank() || "empty".equalsIgnoreCase(e.getValue())) continue;
+            List<AgendaVoteCast> voters = new ArrayList<>();
+            List<AgendaRider> riders = new ArrayList<>();
+            int total = 0;
+            for (String piece : e.getValue().split(";")) {
+                int us = piece.indexOf('_');
+                if (us <= 0) continue;
+                String who = piece.substring(0, us);
+                String what = piece.substring(us + 1);
+                Player p = game.getPlayerFromColorOrFaction(who.toLowerCase(Locale.ROOT));
+                String uid = p == null ? null : p.getUserID();
+                String faction = p == null ? who : p.getFaction();
+                if (NumberUtils.isDigits(what)) {
+                    int n = Integer.parseInt(what);
+                    total += n;
+                    voters.add(new AgendaVoteCast(uid, faction, n));
+                } else {
+                    riders.add(new AgendaRider(uid, faction, what));
+                }
+            }
+            out.add(new AgendaOutcomeState(e.getKey(), outcomeName(game, e.getKey()), total, voters, riders));
+        }
+        out.sort(Comparator.comparingInt(AgendaOutcomeState::votes).reversed());
+        return out;
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/AgendaTieBreakKind.java b/src/main/java/ti4/selfhost/engine/kinds/AgendaTieBreakKind.java
