@@ -0,0 +1,72 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.Map;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * Per-player preference questions the engine asks around setup and round 1 (cards-info thread): the "welcome to
+ * async" survey (answerSurvey_&lt;answer&gt;_&lt;question#&gt;), auto-pass on secret scoring (sandbagPref_bot|manual),
+ * auto-pass on Sabotage after N hours (setAutoPassMedian_&lt;n&gt;), auto-react on whens/afters and similar toggles
+ * (playerPrefDecision_&lt;true|false&gt;_&lt;pref&gt;), pillaging own transactions (setwillPillageOwnTransactions_&lt;yes|no&gt;).
+ * value: {preference: "survey"|"sandbag"|"auto_pass_sabotage"|&lt;pref&gt;|"pillage_own_transactions", question:
+ * survey question number or null, choice: the answer as the engine names it}.
+ */
+public class SetupPreferenceKind implements KindSpec {
+
+    @Override
+    public String kind() {
+        return "setup.preference";
+    }
+
+    @Override
+    public int priority() {
+        return 35;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return handlerId.startsWith("answerSurvey_")
+                || handlerId.startsWith("sandbagPref_")
+                || handlerId.startsWith("setAutoPassMedian_")
+                || handlerId.startsWith("playerPrefDecision_")
+                || handlerId.startsWith("setwillPillageOwnTransactions_");
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        if (!matches(handlerId)) return null;
+        String rest = handlerId.substring(handlerId.indexOf('_') + 1);
+        if (handlerId.startsWith("answerSurvey_")) {
+            int last = rest.lastIndexOf('_');
+            String q = last < 0 ? null : rest.substring(last + 1);
+            return v("survey", q, last < 0 ? rest : rest.substring(0, last));
+        }
+        if (handlerId.startsWith("sandbagPref_")) return v("sandbag", null, rest);
+        if (handlerId.startsWith("setAutoPassMedian_")) return v("auto_pass_sabotage", null, rest);
+        if (handlerId.startsWith("setwillPillageOwnTransactions_")) return v("pillage_own_transactions", null, rest);
+        int us = rest.indexOf('_');
+        return us < 0 ? v(rest, null, null) : v(rest.substring(us + 1), null, rest.substring(0, us));
+    }
+
+    private static Map<String, Object> v(String pref, String question, String choice) {
+        return SetupKindSupport.map("preference", pref, "question", question, "choice", choice);
+    }
+
+    /** Setup: faction / colour are picked after capture; re-resolve the target on every state change. */
+    @Override
+    public boolean dynamic() {
+        return true;
+    }
+
+    @Override
+    public ti4.selfhost.engine.EngineModels.Target target(
+            CaptureContext ctx, ti4.selfhost.engine.EngineModels.Target resolved) {
+        return SetupKindSupport.refresh(ctx, resolved);
+    }
+
+    /** Past setup this prompt is a leftover nobody needs (live: hundreds open across games, flooding the web queue). */
+    @Override
+    public boolean obsolete(CaptureContext ctx) {
+        return ti4.selfhost.engine.SetupStateBuilder.pastSetup(ctx.game());
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/StatusAdvanceKind.java b/src/main/java/ti4/selfhost/engine/kinds/StatusAdvanceKind.java
new file mode 100644
index 0000000..bb13661
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/StatusAdvanceKind.java
@@ -0,0 +1,135 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+import java.util.Set;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.Executors;
+import java.util.concurrent.ScheduledExecutorService;
+import java.util.concurrent.TimeUnit;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.game.persistence.GameManager;
+import ti4.game.persistence.ManagedGame;
+import ti4.logging.BotLogger;
+import ti4.selfhost.engine.ActionInvoker;
+import ti4.selfhost.engine.DecisionRegistry;
+import ti4.selfhost.engine.EngineModels.AnswerRequest;
+import ti4.selfhost.engine.EngineModels.AnswerResult;
+import ti4.selfhost.engine.EngineModels.Decision;
+import ti4.selfhost.engine.EngineModels.Option;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * End of the status phase: "Start Strategy Phase" (startStrategyPhase), posted when every player has reacted to the
+ * homework prompt but the last reaction was the step-by-step token button. value {action: "start", next:
+ * "strategy"}.
+ *
+ * <p>Nobody should have to press it: once it (or the status phase's "Flip Agenda", whichever kind owns that) is open,
+ * the game is still in status homework, and no player is still in the step-by-step token prompt, the engine presses
+ * it itself as the speaker (a few seconds later, so a last "Done" can land). The same applies to the agenda flip the
+ * bot posts after the last Ready when the custodians are taken.
+ */
+public class StatusAdvanceKind implements KindSpec {
+    private static final Set<String> STEPS = Set.of("startStrategyPhase", "flip_agenda");
+    private static final Set<String> pressed = ConcurrentHashMap.newKeySet();
+    private static final ScheduledExecutorService timer = Executors.newSingleThreadScheduledExecutor(r -> {
+        Thread t = new Thread(r, "engine-status-advance");
+        t.setDaemon(true);
+        return t;
+    });
+    private static volatile boolean subscribed;
+
+    public StatusAdvanceKind() {
+        synchronized (StatusAdvanceKind.class) {
+            if (subscribed) return;
+            subscribed = true;
+            DecisionRegistry.subscribe(ev -> {
+                if (ev == null || ev.game() == null) return;
+                if ("decision.opened".equals(ev.type())
+                        || "decision.closed".equals(ev.type())
+                        || "state.changed".equals(ev.type())) schedule(ev.game());
+            });
+        }
+    }
+
+    @Override
+    public String kind() {
+        return "status.advance";
+    }
+
+    @Override
+    public int priority() {
+        return 100;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return "startStrategyPhase".equals(handlerId);
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        Map<String, Object> v = new LinkedHashMap<>();
+        v.put("action", "start");
+        v.put("next", "strategy");
+        return v;
+    }
+
+    @Override
+    public String scope(CaptureContext ctx) {
+        return "table";
+    }
+
+    // ------------------------------------------------------------------ auto-advance
+
+    private static final Set<String> scheduled = ConcurrentHashMap.newKeySet();
+
+    private static void schedule(String gameName) {
+        if (!scheduled.add(gameName)) return;
+        timer.schedule(
+                () -> {
+                    scheduled.remove(gameName);
+                    try {
+                        tryAdvance(gameName);
+                    } catch (Exception e) {
+                        BotLogger.error("engine: status auto-advance failed for " + gameName, e);
+                    }
+                },
+                4,
+                TimeUnit.SECONDS);
+    }
+
+    private static void tryAdvance(String gameName) {
+        Decision step = null;
+        Option stepOption = null;
+        for (Decision d : DecisionRegistry.openDecisions(gameName)) {
+            for (Option o : d.options()) {
+                if (o.handler() == null) continue;
+                // Someone is still adjusting tokens step by step: wait for their "Done".
+                if (o.handler().matches("(increase|decrease)_(tactic|fleet|strategy)_cc")) return;
+                if (STEPS.contains(o.handler()) && !o.disabled() && step == null) {
+                    step = d;
+                    stepOption = o;
+                }
+            }
+        }
+        if (step == null || pressed.contains(step.id() + "@" + step.seq())) return;
+        ManagedGame mg = GameManager.getManagedGame(gameName);
+        Game game = mg == null ? null : mg.getGame();
+        if (game == null || !StatusPhase.inHomework(game)) return;
+        // flip_agenda is also the agenda phase's own button: only the one that ends the status phase is ours.
+        if ("flip_agenda".equals(stepOption.handler()) && !game.isCustodiansScored()) return;
+        Player by = game.getSpeaker();
+        if (by == null || !by.isRealPlayer()) by = game.getRealPlayers().isEmpty() ? null : game.getRealPlayers().getFirst();
+        if (by == null) return;
+        pressed.add(step.id() + "@" + step.seq());
+        AnswerResult r = ActionInvoker.answer(
+                gameName,
+                step.id(),
+                by.getUserID(),
+                new AnswerRequest(stepOption.id(), step.seq(), "status-advance-" + step.id() + "-" + step.seq(), by.getUserID(), null));
+        BotLogger.info("engine: " + gameName + " status over, pressed " + stepOption.handler() + " as speaker -> "
+                + r.status() + (r.error() == null ? "" : " (" + r.error() + ")"));
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/StatusHomeworkKind.java b/src/main/java/ti4/selfhost/engine/kinds/StatusHomeworkKind.java
new file mode 100644
index 0000000..ba01b83
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/StatusHomeworkKind.java
@@ -0,0 +1,170 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.selfhost.engine.EngineModels.CommandTokens;
+import ti4.selfhost.engine.EngineModels.Decision;
+import ti4.selfhost.engine.EngineModels.PlayerStatus;
+import ti4.selfhost.engine.EngineModels.ReactionWindow;
+import ti4.selfhost.engine.EngineModels.StatusState;
+import ti4.selfhost.engine.EngineModels.Target;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * Status homework ("Resolve status homework using the buttons", StartPhaseService.startStatusHomework): one shared
+ * prompt, each player answers for themself.
+ *
+ * <ul>
+ *   <li>redistributeCCButtons → {action: "command_tokens", payload: true}: answer it WITH a payload {tactic, fleet,
+ *       strategy} = the final pools. The engine checks them against the pre-gain pools + this round's gain
+ *       (GameState.status.players[uid]: tokensBase, tokenGain, tokenMaxTotal, noTokenLoss) and applies them at once
+ *       (StatusTokensButtonHandler). Re-answering re-sets; it never gains twice. Answered without a payload it is the
+ *       legacy step-by-step prompt.</li>
+ *   <li>pass_on_abilities → {action: "ready", next: "strategy" | "agenda" | "edict"}. When the last player is ready
+ *       the engine moves on by itself (strategy) or posts the agenda flip (status.advance, auto-pressed).</li>
+ * </ul>
+ * Outside the status phase (Warfare's "Redistribute Command Tokens") the option is typed with payload: false.
+ */
+public class StatusHomeworkKind implements KindSpec {
+
+    @Override
+    public String kind() {
+        return "status.homework";
+    }
+
+    @Override
+    public int priority() {
+        return 90;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return "redistributeCCButtons".equals(handlerId) || "pass_on_abilities".equals(handlerId);
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        Game game = ctx.game();
+        Map<String, Object> v = new LinkedHashMap<>();
+        if ("pass_on_abilities".equals(handlerId)) {
+            v.put("action", "ready");
+            v.put("next", StatusPhase.next(game));
+            return v;
+        }
+        boolean status = StatusPhase.inHomework(game);
+        v.put("action", "command_tokens");
+        v.put("payload", status);
+        if (status) {
+            // First sight of the homework prompt: remember every player's pre-gain pools (first write wins), so a
+            // token answer is always measured against the same base.
+            for (Player p : game.getRealPlayers()) StatusPhase.rememberBase(game, p);
+        }
+        return v;
+    }
+
+    @Override
+    public Target target(CaptureContext ctx, Target resolved) {
+        return resolved != null && "owner_prefix".equals(resolved.resolvedBy()) ? resolved : null;
+    }
+
+    @Override
+    public String scope(CaptureContext ctx) {
+        return ctx.target() != null && ctx.target().userId() != null ? "player" : "table";
+    }
+
+    @Override
+    public boolean dynamic() {
+        return true;
+    }
+
+    /**
+     * The status homework prompt is a reaction window ("ready"): responded = players who reacted to it (Ready, or the
+     * legacy step-by-step token button, which the bot also counts). Setting tokens through the engine is not a
+     * response; Ready is. The last Ready moves the game on.
+     */
+    @Override
+    public ReactionWindow window(CaptureContext ctx) {
+        Game game = ctx.game();
+        if (!StatusPhase.inHomework(game) || (ctx.target() != null && ctx.target().userId() != null)) return null;
+        StatusState st = StatusPhase.state(game);
+        List<String> eligible = new ArrayList<>();
+        List<String> responded = new ArrayList<>();
+        Map<String, String> responses = new LinkedHashMap<>();
+        for (Player p : game.getRealPlayers()) {
+            eligible.add(p.getUserID());
+            PlayerStatus ps = st == null ? null : st.players().get(p.getUserID());
+            if (ps != null && ps.ready()) {
+                responded.add(p.getUserID());
+                responses.put(p.getUserID(), "ready");
+            } else {
+                responses.put(p.getUserID(), ps != null && ps.tokensConfirmed() != null ? "tokens_set" : "pending");
+            }
+        }
+        Map<String, Object> subject = new LinkedHashMap<>();
+        subject.put("round", game.getRound());
+        subject.put("next", StatusPhase.next(game));
+        return new ReactionWindow("status.ready", subject, eligible, responded, responses);
+    }
+
+    /**
+     * Structured answer (AnswerRequest.payload, shared API with the agenda area): {tactic, fleet, strategy} = the
+     * final pools. Checked here, then applied in one step by the engine-owned token handler.
+     */
+    @Override
+    public boolean acceptsPayload() {
+        return true;
+    }
+
+    @Override
+    public String answerPayload(PayloadAnswer steps, Map<String, Object> payload) throws Exception {
+        Game game = steps.game();
+        Player answering = steps.player();
+        Decision decision = steps.decision();
+        if (game == null || answering == null || decision == null) return "That decision is no longer open.";
+        return applyTokens(game, answering, decision, payload, steps);
+    }
+
+    static String applyTokens(Game game, Player answering, Decision decision, Map<String, Object> payload, Steps steps)
+            throws Exception {
+        String id;
+        try {
+            id = new StatusHomeworkKind().tokensCustomId(game, answering, payload);
+        } catch (IllegalArgumentException e) {
+            return e.getMessage();
+        }
+        steps.pressEngine(decision, id);
+        return null;
+    }
+
+    /** Payload {tactic, fleet, strategy} → the engine-owned token handler's id, or IllegalArgumentException. */
+    String tokensCustomId(Game game, Player answering, Map<String, Object> payload) {
+        if (!StatusPhase.inHomework(game))
+            throw new IllegalArgumentException("Command tokens can only be set like this in the status phase.");
+        CommandTokens want = new CommandTokens(
+                intOf(payload.get("tactic")), intOf(payload.get("fleet")), intOf(payload.get("strategy")));
+        String err = StatusTokensButtonHandler.check(game, answering, want);
+        if (err != null) throw new IllegalArgumentException(Character.toUpperCase(err.charAt(0)) + err.substring(1));
+        return StatusTokensButtonHandler.PREFIX + want.tactic() + "_" + want.fleet() + "_" + want.strategy();
+    }
+
+    private static int intOf(Object o) {
+        if (o instanceof Number n && n.doubleValue() == Math.floor(n.doubleValue())) return n.intValue();
+        if (o instanceof String s && s.matches("-?\\d+")) return Integer.parseInt(s);
+        throw new IllegalArgumentException("Give whole numbers for tactic, fleet and strategy.");
+    }
+
+    /** Ready is recorded engine-side too: the react record behind PlayerStatus.ready is not always kept (live pbd97). */
+    @Override
+    public boolean recordsResponses() {
+        return true;
+    }
+
+    @Override
+    public boolean countsAsResponse(String handlerId) {
+        return "pass_on_abilities".equals(handlerId);
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/StatusPhase.java b/src/main/java/ti4/selfhost/engine/kinds/StatusPhase.java
new file mode 100644
index 0000000..4a6fee8
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/StatusPhase.java
@@ -0,0 +1,214 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+import javax.annotation.Nullable;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.helpers.ButtonHelper;
+import ti4.helpers.Helper;
+import ti4.image.Mapper;
+import ti4.message.GameMessage;
+import ti4.message.GameMessageManager;
+import ti4.message.GameMessageType;
+import ti4.model.PublicObjectiveModel;
+import ti4.model.SecretObjectiveModel;
+import ti4.selfhost.engine.EngineModels.CommandTokens;
+import ti4.selfhost.engine.EngineModels.PlayerStatus;
+import ti4.selfhost.engine.EngineModels.StatusState;
+import ti4.service.info.ListPlayerInfoService;
+
+/**
+ * Status phase facts the engine derives from Game (the bot keeps them in stored values): who scored / declined
+ * which objective this round, command token gain, readiness. Shared by the status.* kinds, the engine-owned token
+ * handler and the state snapshot.
+ */
+public final class StatusPhase {
+    private StatusPhase() {}
+
+    /** Stored value holding a player's pools before this round's status gain: "t/f/s". Set once per round. */
+    static String baseKey(Player p, Game game) {
+        return "engineStatusTokenBase" + p.getFaction() + "Round" + game.getRound();
+    }
+
+    /** Stored value holding the final pools the player confirmed this round through the engine: "t/f/s". */
+    static String confirmedKey(Player p, Game game) {
+        return "engineStatusTokensDone" + p.getFaction() + "Round" + game.getRound();
+    }
+
+    public static boolean inStatus(Game game) {
+        String ph = game.getPhaseOfGame();
+        return ph != null && ph.toLowerCase().startsWith("status");
+    }
+
+    public static boolean inHomework(Game game) {
+        return "statusHomework".equalsIgnoreCase(game.getPhaseOfGame());
+    }
+
+    /** The phase that follows this status phase. */
+    public static String next(Game game) {
+        if (game.isCustodiansScored() || game.isOmegaPhaseMode()) return game.isTwilightsFallMode() ? "edict" : "agenda";
+        return "strategy";
+    }
+
+    @Nullable
+    public static StatusState state(Game game) {
+        return state(game, null);
+    }
+
+    /** viewerUserId: whose private facts (scorable secrets) to include; null = none. */
+    @Nullable
+    public static StatusState state(Game game, @Nullable String viewerUserId) {
+        try {
+            if (!inStatus(game)) return null;
+            Map<String, PlayerStatus> players = new LinkedHashMap<>();
+            GameMessage homework = GameMessageManager.getOne(game.getName(), GameMessageType.STATUS_END)
+                    .orElse(null);
+            for (Player p : game.getRealPlayers()) {
+                CommandTokens base = tokensBase(game, p);
+                String done = game.getStoredValue(confirmedKey(p, game));
+                players.put(
+                        p.getUserID(),
+                        new PlayerStatus(
+                                scoredThisRound(game, p, "PO"),
+                                scoredThisRound(game, p, "SO"),
+                                base,
+                                tokenGain(game, p),
+                                tokenMaxTotal(game, p, base),
+                                noTokenLoss(game, p),
+                                done.isEmpty() ? null : parse(done),
+                                homework != null
+                                        && homework.factionsThatReacted() != null
+                                        && homework.factionsThatReacted().contains(p.getFaction()),
+                                ButtonHelper.getACLimit(game, p),
+                                p.getUserID().equals(viewerUserId) ? scorableSecrets(game, p) : null));
+            }
+            return new StatusState(
+                    game.getRound(),
+                    inHomework(game) ? "homework" : "scoring",
+                    !game.getStoredValue("revealedPOInRound" + game.getRound()).isEmpty(),
+                    game.isCustodiansScored(),
+                    next(game),
+                    players);
+        } catch (Exception e) {
+            return null;
+        }
+    }
+
+    /**
+     * "PO"/"SO" declared this round: objective id, "none", or null. The bot stores the objective's name (or "None").
+     */
+    @Nullable
+    static String scoredThisRound(Game game, Player p, String which) {
+        String v = game.getStoredValue(p.getFaction() + "round" + game.getRound() + which);
+        if (v == null || v.isEmpty()) return null;
+        if ("None".equalsIgnoreCase(v)) return "none";
+        if ("PO".equals(which)) {
+            for (String id : game.getRevealedPublicObjectives().keySet()) {
+                PublicObjectiveModel m = Mapper.getPublicObjective(id);
+                if (m != null && v.equalsIgnoreCase(m.getName())) return id;
+            }
+        } else {
+            for (String id : p.getSecretsScored().keySet()) {
+                SecretObjectiveModel m = Mapper.getSecretObjective(id);
+                if (m != null && v.equalsIgnoreCase(m.getName())) return id;
+            }
+        }
+        return v;
+    }
+
+    /** Status-phase secret objectives in hand that the engine knows are met now. */
+    static java.util.List<String> scorableSecrets(Game game, Player p) {
+        java.util.List<String> out = new java.util.ArrayList<>();
+        for (String id : p.getSecretsUnscored().keySet()) {
+            SecretObjectiveModel m = Mapper.getSecretObjective(id);
+            if (m == null || "dp".equals(id) || !"status".equalsIgnoreCase(m.getPhase())) continue;
+            int[] pr = progress(game, p, id);
+            if (pr[1] > 0 && pr[0] >= pr[1]) out.add(id);
+        }
+        return out;
+    }
+
+    /** Progress toward an objective and its threshold; threshold 0 = the engine cannot judge it. */
+    static int[] progress(Game game, Player p, String objectiveId) {
+        try {
+            int threshold = ListPlayerInfoService.getObjectiveThreshold(objectiveId, game);
+            int progress = threshold > 0 ? ListPlayerInfoService.getPlayerProgressOnObjective(objectiveId, game, p) : 0;
+            return new int[] {progress, threshold};
+        } catch (Exception e) {
+            return new int[] {0, 0};
+        }
+    }
+
+    /** Whether the player meets a revealed public objective (the same test the bot applies when scoring it). */
+    static boolean meetsPublic(Game game, Player p, String objectiveId) {
+        int[] pr = progress(game, p, objectiveId);
+        return pr[1] > 0 && pr[0] >= pr[1] && Helper.canPlayerScorePOs(game, p);
+    }
+
+    // ------------------------------------------------------------------ command tokens
+
+    static CommandTokens current(Player p) {
+        return new CommandTokens(p.getTacticalCC(), p.getFleetCC(), p.getStrategicCC());
+    }
+
+    /** Pools before this round's gain: remembered on first sight in the homework step, else the current pools. */
+    static CommandTokens tokensBase(Game game, Player p) {
+        String b = game.getStoredValue(baseKey(p, game));
+        return b.isEmpty() ? current(p) : parse(b);
+    }
+
+    /** Remember the pre-gain pools (idempotent: the first call in a round wins). */
+    static CommandTokens rememberBase(Game game, Player p) {
+        String b = game.getStoredValue(baseKey(p, game));
+        if (!b.isEmpty()) return parse(b);
+        CommandTokens c = current(p);
+        game.setStoredValue(baseKey(p, game), format(c));
+        return c;
+    }
+
+    /** Tokens the status phase gives this player: 2, adjusted like the bot's own reminder (Versatile, HM, …). */
+    public static int tokenGain(Game game, Player p) {
+        int gain = 2;
+        if (p.hasAbility("versatile")) gain++;
+        if (p.hasTech("hm")) gain++;
+        if (p.hasTech("tf-inheritancesystems")) gain++;
+        boolean malevolency = false;
+        for (String pn : p.getPromissoryNotes().keySet()) {
+            if ("ce".equalsIgnoreCase(pn) && !p.ownsPromissoryNote("ce")) gain++;
+            if ("malevolency".equalsIgnoreCase(pn) && !p.ownsPromissoryNote("malevolency")) malevolency = true;
+        }
+        // With Mahact tokens, Malevolency instead returns one of them after the normal gain (handled on confirm).
+        if (malevolency && p.getMahactCC().isEmpty()) gain--;
+        return Math.max(0, gain);
+    }
+
+    /** Most tokens the three pools may hold after the gain: base + gain, capped by reinforcements (16 total). */
+    static int tokenMaxTotal(Game game, Player p, CommandTokens base) {
+        int baseTotal = base.tactic() + base.fleet() + base.strategy();
+        int want = baseTotal + tokenGain(game, p);
+        try {
+            int inPlay = Helper.getCCCount(game, p.getColor()); // board + pools (+ faction-sheet extras)
+            CommandTokens cur = current(p);
+            int poolsNow = cur.tactic() + cur.fleet() + cur.strategy();
+            int reinforcements = Math.max(0, 16 - inPlay);
+            // The pools may hold what they hold now plus what is left in reinforcements.
+            return Math.max(baseTotal, Math.min(want, poolsNow + reinforcements));
+        } catch (Exception e) {
+            return want;
+        }
+    }
+
+    static boolean noTokenLoss(Game game, Player p) {
+        return p.hasAbility("deliberate_action") && inStatus(game);
+    }
+
+    static CommandTokens parse(String s) {
+        String[] a = s.split("/");
+        return new CommandTokens(Integer.parseInt(a[0].trim()), Integer.parseInt(a[1].trim()), Integer.parseInt(a[2].trim()));
+    }
+
+    static String format(CommandTokens c) {
+        return c.tactic() + "/" + c.fleet() + "/" + c.strategy();
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/StatusRevealObjectiveKind.java b/src/main/java/ti4/selfhost/engine/kinds/StatusRevealObjectiveKind.java
new file mode 100644
index 0000000..f6488ce
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/StatusRevealObjectiveKind.java
@@ -0,0 +1,84 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.selfhost.engine.EngineModels.Decision;
+import ti4.selfhost.engine.EngineModels.Target;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * "All players have indicated scoring. Flip the relevant public objective" (ReactionCheckService.respondAllHaveScored):
+ * reveal_stage_1 | _2 | _2x2 | _none | _1position_N | _2position_N, and when objectives ran out endGameMostPoints.
+ * The speaker reveals (rules 61.17), so the target is the speaker. value {action: "reveal", stage, count, position}
+ * or {action: "continue"} (nothing left to reveal, fog) or {action: "end_game"}.
+ */
+public class StatusRevealObjectiveKind implements KindSpec {
+
+    @Override
+    public String kind() {
+        return "status.reveal_objective";
+    }
+
+    @Override
+    public int priority() {
+        return 100;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return handlerId.startsWith("reveal_stage_") || "endGameMostPoints".equals(handlerId);
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        Map<String, Object> v = new LinkedHashMap<>();
+        if ("endGameMostPoints".equals(handlerId)) {
+            v.put("action", "end_game");
+            return v;
+        }
+        String s = handlerId.substring("reveal_stage_".length());
+        if ("none".equals(s)) {
+            v.put("action", "continue");
+            return v;
+        }
+        v.put("action", "reveal");
+        v.put("stage", s.startsWith("2") ? 2 : 1);
+        v.put("count", "2x2".equals(s) ? 2 : 1);
+        v.put("position", s.contains("position_") ? Integer.parseInt(s.substring(s.indexOf("position_") + 9)) : null);
+        return v;
+    }
+
+    @Override
+    public Target target(CaptureContext ctx, Target resolved) {
+        Player sp = ctx.game().getSpeaker();
+        if (sp == null) return resolved;
+        return new Target(sp.getUserID(), sp.getFaction(), sp.getColor(), "speaker");
+    }
+
+    @Override
+    public boolean dynamic() {
+        return true;
+    }
+
+    /** The round's objective is already revealed (stale prompts in old games, live pbd26/27): never answerable. */
+    @Override
+    public boolean obsolete(CaptureContext ctx) {
+        return !ctx.game().getStoredValue("revealedPOInRound" + ctx.game().getRound()).isEmpty();
+    }
+
+    @Override
+    public String scope(CaptureContext ctx) {
+        return ctx.target() != null && ctx.target().userId() != null ? "player" : "table";
+    }
+
+    @Override
+    public String validate(Game game, Player answering, Decision decision, String optionId) {
+        String h = StatusScoreKind.handlerOf(decision, optionId);
+        if (h != null && h.startsWith("reveal_stage_")
+                && !game.getStoredValue("revealedPOInRound" + game.getRound()).isEmpty())
+            return "This round's objective is already revealed.";
+        return null;
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/StatusScoreKind.java b/src/main/java/ti4/selfhost/engine/kinds/StatusScoreKind.java
new file mode 100644
index 0000000..565871a
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/StatusScoreKind.java
@@ -0,0 +1,164 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.image.Mapper;
+import ti4.model.PublicObjectiveModel;
+import ti4.selfhost.engine.EngineModels.Decision;
+import ti4.selfhost.engine.EngineModels.Option;
+import ti4.selfhost.engine.EngineModels.ReactionWindow;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * Status phase scoring prompt ("Please score objectives.", StatusHelper.poScoring): one shared message, every player
+ * answers for themself (scope table). Also Imperial's "Score A Public" list (FFCC_&lt;f&gt;_po_scoring_N, scope
+ * player).
+ *
+ * <p>Option values (action):
+ * <ul>
+ *   <li>score_public {objective, number, stage, points, threshold, progress{userId: n}, eligible[userId]} — eligible
+ *       = players who meet it now and have not scored it (the bot refuses the others anyway);</li>
+ *   <li>no_public — declare no public objective this round;</li>
+ *   <li>score_secret — opens the player's private list of secret objectives (status.score_secret);</li>
+ *   <li>no_secret — declare no secret objective this round.</li>
+ * </ul>
+ * Who already declared what is in GameState.status.players (publicScored / secretScored).
+ */
+public class StatusScoreKind implements KindSpec {
+
+    @Override
+    public String kind() {
+        return "status.score";
+    }
+
+    @Override
+    public int priority() {
+        return 100;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return handlerId.matches("po_scoring_\\d+")
+                || "po_no_scoring".equals(handlerId)
+                || "so_no_scoring".equals(handlerId)
+                || "get_so_score_buttons".equals(handlerId);
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        Map<String, Object> v = new LinkedHashMap<>();
+        switch (handlerId) {
+            case "po_no_scoring" -> v.put("action", "no_public");
+            case "so_no_scoring" -> v.put("action", "no_secret");
+            case "get_so_score_buttons" -> v.put("action", "score_secret");
+            default -> {
+                int number = Integer.parseInt(handlerId.substring("po_scoring_".length()));
+                Game game = ctx.game();
+                String id = objectiveByNumber(game, number);
+                if (id == null) return null;
+                PublicObjectiveModel m = Mapper.getPublicObjective(id);
+                v.put("action", "score_public");
+                v.put("objective", id);
+                v.put("number", number);
+                v.put("stage", m == null ? null : m.getPoints() != null && m.getPoints() >= 2 ? 2 : 1);
+                v.put("points", m == null || m.getPoints() == null ? 1 : m.getPoints());
+                Map<String, Object> progress = new LinkedHashMap<>();
+                List<String> eligible = new ArrayList<>();
+                int threshold = 0;
+                List<String> scored = game.getScoredPublicObjectives().getOrDefault(id, List.of());
+                for (Player p : game.getRealPlayers()) {
+                    int[] pr = StatusPhase.progress(game, p, id);
+                    threshold = pr[1];
+                    progress.put(p.getUserID(), pr[0]);
+                    if (!scored.contains(p.getUserID()) && StatusPhase.meetsPublic(game, p, id))
+                        eligible.add(p.getUserID());
+                }
+                v.put("threshold", threshold);
+                v.put("progress", progress);
+                v.put("eligible", eligible);
+            }
+        }
+        return v;
+    }
+
+    @Override
+    public String scope(CaptureContext ctx) {
+        // The shared prompt pings the whole table; Imperial's list carries an owner prefix.
+        return ctx.target() != null && "owner_prefix".equals(ctx.target().resolvedBy()) ? "player" : "table";
+    }
+
+    @Override
+    public boolean dynamic() {
+        return true;
+    }
+
+    /**
+     * The shared prompt is a reaction window: every real player declares a public and a secret objective (or none).
+     * responded = declared both; responses[uid] = "&lt;public&gt;/&lt;secret&gt;" with an objective id, "none" or
+     * "pending" each (structured per-player detail: GameState.status.players).
+     */
+    @Override
+    public ReactionWindow window(CaptureContext ctx) {
+        if (ctx.target() != null && "owner_prefix".equals(ctx.target().resolvedBy())) return null;
+        Game game = ctx.game();
+        if (!StatusPhase.inStatus(game)) return null;
+        List<String> eligible = new ArrayList<>();
+        List<String> responded = new ArrayList<>();
+        Map<String, String> responses = new LinkedHashMap<>();
+        for (Player p : game.getRealPlayers()) {
+            eligible.add(p.getUserID());
+            String po = StatusPhase.scoredThisRound(game, p, "PO");
+            String so = StatusPhase.scoredThisRound(game, p, "SO");
+            if (po != null && so != null) responded.add(p.getUserID());
+            responses.put(p.getUserID(), (po == null ? "pending" : po) + "/" + (so == null ? "pending" : so));
+        }
+        Map<String, Object> subject = new LinkedHashMap<>();
+        subject.put("round", game.getRound());
+        return new ReactionWindow("status.score", subject, eligible, responded, responses);
+    }
+
+    @Override
+    public ti4.selfhost.engine.EngineModels.Target target(
+            CaptureContext ctx, ti4.selfhost.engine.EngineModels.Target resolved) {
+        return resolved != null && "owner_prefix".equals(resolved.resolvedBy()) ? resolved : null;
+    }
+
+    static String objectiveByNumber(Game game, int number) {
+        for (Map.Entry<String, Integer> e : game.getRevealedPublicObjectives().entrySet()) {
+            if (e.getValue() != null && e.getValue() == number) return e.getKey();
+        }
+        return null;
+    }
+
+    @Override
+    public String validate(Game game, Player answering, Decision decision, String optionId) {
+        String h = handlerOf(decision, optionId);
+        if (h == null) return null;
+        boolean statusScoring = StatusPhase.inStatus(game);
+        String po = StatusPhase.scoredThisRound(game, answering, "PO");
+        String so = StatusPhase.scoredThisRound(game, answering, "SO");
+        if (h.startsWith("po_scoring_")) {
+            if (statusScoring && po != null) return "You already declared your public objective this round.";
+            String id = objectiveByNumber(game, Integer.parseInt(h.substring("po_scoring_".length())));
+            if (id == null) return "That objective is not revealed.";
+            if (game.didPlayerScoreThisAlready(answering.getUserID(), id)) return "You already scored that objective.";
+            int[] pr = StatusPhase.progress(game, answering, id);
+            if (pr[1] > 0 && pr[0] < pr[1])
+                return "You do not meet that objective (" + pr[0] + "/" + pr[1] + ").";
+        } else if ("po_no_scoring".equals(h)) {
+            if (po != null) return "You already declared your public objective this round.";
+        } else if ("so_no_scoring".equals(h) || "get_so_score_buttons".equals(h)) {
+            if (so != null) return "You already declared your secret objective this round.";
+        }
+        return null;
+    }
+
+    static String handlerOf(Decision d, String optionId) {
+        for (Option o : d.options()) if (o.id().equals(optionId)) return o.handler();
+        return null;
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/StatusScoreSecretKind.java b/src/main/java/ti4/selfhost/engine/kinds/StatusScoreSecretKind.java
new file mode 100644
index 0000000..8d14666
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/StatusScoreSecretKind.java
@@ -0,0 +1,82 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.image.Mapper;
+import ti4.model.SecretObjectiveModel;
+import ti4.selfhost.engine.EngineModels.Decision;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * Score a secret objective from hand: so_score_hand_&lt;handle&gt; (the private list opened by "Score A Secret
+ * Objective"). value {handle, secretObjective, phase ("status" | "action" | "agenda"), points, progress, threshold,
+ * met}: met = true/false when the engine can judge the objective (threshold &gt; 0), null when it cannot (e.g. most
+ * action-phase secrets). Answers the engine knows are not met, or a non-status secret in the status phase, are
+ * refused.
+ */
+public class StatusScoreSecretKind implements KindSpec {
+    static final String PREFIX = "so_score_hand_";
+
+    @Override
+    public String kind() {
+        return "status.score_secret";
+    }
+
+    @Override
+    public int priority() {
+        return 100;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return handlerId.matches(PREFIX + "\\d+");
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        int handle = Integer.parseInt(handlerId.substring(PREFIX.length()));
+        Map<String, Object> v = new LinkedHashMap<>();
+        v.put("handle", handle);
+        Player p = ctx.player();
+        String id = p == null ? null : idOf(p, handle);
+        v.put("secretObjective", id);
+        SecretObjectiveModel m = id == null ? null : Mapper.getSecretObjective(id);
+        v.put("phase", m == null || m.getPhase() == null ? null : m.getPhase().toLowerCase());
+        v.put("points", m == null ? 1 : m.getPoints());
+        if (id != null) {
+            int[] pr = StatusPhase.progress(ctx.game(), p, id);
+            v.put("progress", pr[0]);
+            v.put("threshold", pr[1]);
+            v.put("met", pr[1] > 0 && !"dp".equals(id) ? pr[0] >= pr[1] : null);
+        }
+        return v;
+    }
+
+    static String idOf(Player p, int handle) {
+        for (Map.Entry<String, Integer> e : p.getSecrets().entrySet()) {
+            if (e.getValue() != null && e.getValue() == handle) return e.getKey();
+        }
+        return null;
+    }
+
+    @Override
+    public String validate(Game game, Player answering, Decision decision, String optionId) {
+        String h = StatusScoreKind.handlerOf(decision, optionId);
+        if (h == null || !matches(h)) return null;
+        String id = idOf(answering, Integer.parseInt(h.substring(PREFIX.length())));
+        if (id == null) return "That secret objective is no longer in your hand.";
+        SecretObjectiveModel m = Mapper.getSecretObjective(id);
+        if (StatusPhase.inStatus(game)) {
+            if (StatusPhase.scoredThisRound(game, answering, "SO") != null)
+                return "You already declared your secret objective this round.";
+            if (m != null && m.getPhase() != null && !"status".equalsIgnoreCase(m.getPhase()))
+                return m.getName() + " is not scored in the status phase.";
+        }
+        int[] pr = StatusPhase.progress(game, answering, id);
+        if (pr[1] > 0 && !"dp".equals(id) && pr[0] < pr[1])
+            return "You do not meet " + (m == null ? id : m.getName()) + " (" + pr[0] + "/" + pr[1] + ").";
+        return null;
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/StatusTokensButtonHandler.java b/src/main/java/ti4/selfhost/engine/kinds/StatusTokensButtonHandler.java
new file mode 100644
index 0000000..5b9b901
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/StatusTokensButtonHandler.java
@@ -0,0 +1,116 @@
+package ti4.selfhost.engine.kinds;
+
+import lombok.experimental.UtilityClass;
+import net.dv8tion.jda.api.events.interaction.component.ButtonInteractionEvent;
+import ti4.discord.interactions.routing.ButtonHandler;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.helpers.ButtonHelper;
+import ti4.helpers.PromissoryNoteHelper;
+import ti4.helpers.StringHelper;
+import ti4.message.MessageHelper;
+import ti4.selfhost.engine.EngineModels.CommandTokens;
+import ti4.service.abilities.MahactTokenService;
+
+/**
+ * Engine-owned status step: set this round's command token pools in one go. Only reachable through the engine
+ * (status.homework option "command_tokens" answered with a payload; never shown as a Discord button):
+ * engineStatusTokens_&lt;tactic&gt;_&lt;fleet&gt;_&lt;strategy&gt;.
+ *
+ * <p>The final pools are checked against the pools the player had before this status phase's gain (remembered once
+ * per round), so answering twice re-sets the same allowance instead of gaining again — the old "press Redistribute
+ * twice, gain twice" bug cannot happen. It does not react to the homework prompt: "Ready" stays a separate answer.
+ */
+@UtilityClass
+public class StatusTokensButtonHandler {
+    public static final String PREFIX = "engineStatusTokens_";
+
+    @ButtonHandler(PREFIX)
+    public static void setTokens(ButtonInteractionEvent event, Game game, Player player, String buttonID) {
+        if (player == null || game == null) return;
+        if (!StatusPhase.inHomework(game)) {
+            MessageHelper.sendMessageToChannel(
+                    player.getCorrectChannel(),
+                    player.getRepresentation() + ", command tokens can only be set during the status phase.");
+            return;
+        }
+        CommandTokens want;
+        try {
+            String[] a = buttonID.substring(PREFIX.length()).split("_");
+            want = new CommandTokens(Integer.parseInt(a[0]), Integer.parseInt(a[1]), Integer.parseInt(a[2]));
+        } catch (Exception e) {
+            return;
+        }
+        String err = check(game, player, want);
+        if (err != null) {
+            MessageHelper.sendMessageToChannel(player.getCorrectChannel(), player.getRepresentation() + ", " + err);
+            return;
+        }
+        CommandTokens base = StatusPhase.rememberBase(game, player);
+        boolean first = game.getStoredValue(StatusPhase.confirmedKey(player, game)).isEmpty();
+        player.setTacticalCC(want.tactic());
+        player.setFleetCC(want.fleet());
+        player.setStrategicCC(want.strategy());
+        game.setStoredValue(StatusPhase.confirmedKey(player, game), StatusPhase.format(want));
+        int net = total(want) - total(base);
+
+        if (first) {
+            boolean cyber = false;
+            boolean malevolency = false;
+            for (String pn : player.getPromissoryNotes().keySet()) {
+                if ("ce".equalsIgnoreCase(pn) && !player.ownsPromissoryNote("ce")) cyber = true;
+                if ("malevolency".equalsIgnoreCase(pn) && !player.ownsPromissoryNote("malevolency")) malevolency = true;
+            }
+            if (malevolency && !player.getMahactCC().isEmpty()) {
+                MahactTokenService.removeFleetCC(game, player, "due to _Malevolency_");
+            }
+            if (cyber && net > 2) PromissoryNoteHelper.resolvePNPlay("ce", player, game, event);
+            if (net > 0 && game.playerHasLeaderUnlockedOrAlliance(player, "ardentiacommander")) {
+                int before = player.getCommodities();
+                player.gainCommodities(net);
+                int gained = player.getCommodities() - before;
+                if (gained > 0) {
+                    MessageHelper.sendMessageToChannel(
+                            game.getActionsChannel(),
+                            player.getRepresentation() + " gained " + gained
+                                    + " commodities due to _High Marshall Serisi_.");
+                }
+            }
+        }
+        MessageHelper.sendMessageToChannel(
+                player.getCorrectChannel(),
+                player.getRepresentationNoPing() + " set command tokens for this round: " + StatusPhase.format(base)
+                        + " -> " + StatusPhase.format(StatusPhase.current(player)) + " (net "
+                        + (net >= 0 ? "gain of " : "loss of ")
+                        + StringHelper.pluralize(Math.abs(net), "command token") + ").");
+        ButtonHelper.checkFleetInEveryTile(player, game);
+        // Answered on the step-by-step prompt (command_tokens.adjust): that prompt is done.
+        if (event.getMessage() != null
+                && event.getMessage().getComponentTree().findAll(net.dv8tion.jda.api.components.buttons.Button.class).stream()
+                        .anyMatch(b -> b.getCustomId() != null && b.getCustomId().contains("increase_"))) {
+            ButtonHelper.deleteMessage(event);
+        }
+    }
+
+    /** Null when the pools are allowed; else a reason, phrased to follow "<player>, ". */
+    static String check(Game game, Player player, CommandTokens want) {
+        if (want.tactic() < 0 || want.fleet() < 0 || want.strategy() < 0) return "a pool cannot be negative.";
+        CommandTokens base = StatusPhase.tokensBase(game, player);
+        int max = StatusPhase.tokenMaxTotal(game, player, base);
+        if (total(want) > max) {
+            return "you may hold at most " + max + " command tokens in your pools now (you had " + total(base)
+                    + " and gain " + StatusPhase.tokenGain(game, player) + ").";
+        }
+        if (StatusPhase.noTokenLoss(game, player)
+                && (want.tactic() < base.tactic()
+                        || want.fleet() < base.fleet()
+                        || want.strategy() < base.strategy())) {
+            return "**Deliberate Action**: you may only add command tokens in this status phase.";
+        }
+        return null;
+    }
+
+    static int total(CommandTokens c) {
+        return c.tactic() + c.fleet() + c.strategy();
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/StrategicActionKind.java b/src/main/java/ti4/selfhost/engine/kinds/StrategicActionKind.java
