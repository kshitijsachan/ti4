index 0000000..3a27743
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/interaction/NativeCoverage.java
@@ -0,0 +1,493 @@
+package ti4.selfhost.engine.interaction;
+
+import java.lang.annotation.Annotation;
+import java.lang.reflect.Method;
+import java.lang.reflect.Modifier;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.TreeMap;
+import java.util.TreeSet;
+import javassist.ClassPool;
+import javassist.CtClass;
+import javassist.CtMethod;
+import javassist.LoaderClassPath;
+import javassist.bytecode.BootstrapMethodsAttribute;
+import javassist.bytecode.ClassFile;
+import javassist.bytecode.CodeAttribute;
+import javassist.bytecode.CodeIterator;
+import javassist.bytecode.ConstPool;
+import javassist.bytecode.MethodInfo;
+import javassist.bytecode.Opcode;
+import javax.annotation.Nullable;
+import net.dv8tion.jda.api.interactions.InteractionHook;
+import net.dv8tion.jda.api.interactions.components.buttons.ButtonInteraction;
+import net.dv8tion.jda.api.interactions.components.selections.StringSelectInteraction;
+import net.dv8tion.jda.api.interactions.modals.ModalInteraction;
+import net.dv8tion.jda.api.utils.messages.MessageCreateBuilder;
+import net.dv8tion.jda.api.utils.messages.MessageEditBuilder;
+import org.reflections.Reflections;
+import org.reflections.scanners.SubTypesScanner;
+import org.reflections.util.ClasspathHelper;
+import org.reflections.util.ConfigurationBuilder;
+import ti4.discord.interactions.routing.ButtonHandler;
+import ti4.discord.interactions.routing.ModalHandler;
+import ti4.discord.interactions.routing.SelectionHandler;
+import ti4.logging.BotLogger;
+
+/**
+ * Which handlers can run as an engine answer ({@link NativeEvents} view of an {@link EngineInteraction}) instead of a
+ * synthesised Discord click. Static bytecode analysis of every {@code @ButtonHandler} / {@code @SelectionHandler} /
+ * {@code @ModalHandler} method: follow calls into ti4 methods that receive the interaction (an event, an interaction
+ * interface, a listener context or our {@link ti4.selfhost.engine.Interaction}) — including lambdas — and collect every
+ * operation invoked on JDA interaction types (event, callbacks, hook, callback actions). A handler is native when each
+ * of those operations is one the view implements (explicitly or as an interface default built on implemented ones).
+ *
+ * <p>Conservative where it matters: a call into a ti4 method that takes the event is always followed (whatever
+ * branch it is on), and an unknown operation marks the handler non-native. Not followed: dynamic dispatch to
+ * overriding methods in subclasses (handlers are static) and events stashed in fields.
+ */
+public final class NativeCoverage {
+
+    public record HandlerCoverage(
+            String kind, String key, String method, boolean nativeOk, Set<String> uses, Set<String> unsupported) {}
+
+    /**
+     * handlers: routed handler keys; nativeHandlers: runnable as an engine answer; directHandlers: of those, the ones
+     * that use no interaction-token operation at all (only context reads + Interaction ops), i.e. need no JDA-shaped
+     * callback emulation.
+     */
+    public record Report(
+            int handlers,
+            int nativeHandlers,
+            double nativePercent,
+            int directHandlers,
+            double directPercent,
+            Map<String, int[]> byKind,
+            Map<String, Integer> opUsage,
+            Map<String, Integer> unsupportedOps,
+            Set<String> pipelineUnsupported,
+            List<HandlerCoverage> nonNative) {}
+
+    private static volatile Map<String, Map<String, HandlerCoverage>> byKind;
+    private static volatile Report report;
+
+    private NativeCoverage() {}
+
+    /** Coverage of the handler a component id routes to (longest registered prefix), or null if unrouted. */
+    @Nullable
+    public static HandlerCoverage forHandler(String kind, String handlerId) {
+        Map<String, HandlerCoverage> m = ensure().get(kind);
+        if (m == null || handlerId == null) return null;
+        for (int len = handlerId.length(); len >= 0; len--) {
+            HandlerCoverage c = m.get(handlerId.substring(0, len));
+            if (c != null) return c;
+        }
+        return null;
+    }
+
+    /**
+     * Non-blocking: coverage once computed (see {@link #warmUp}), else null. Answers never wait for the analysis;
+     * until it is ready they take the synthetic path.
+     */
+    @Nullable
+    public static HandlerCoverage forHandlerIfReady(String kind, String handlerId) {
+        return byKind == null ? null : forHandler(kind, handlerId);
+    }
+
+    /** Whether this button handler opens a form (replyModal) — known once the analysis ran. */
+    public static boolean opensForm(String handlerId) {
+        HandlerCoverage c = forHandlerIfReady("button", handlerId);
+        return c != null && c.uses().stream().anyMatch(u -> u.endsWith(".replyModal"));
+    }
+
+    /** Runs the analysis on a background thread (engine start). */
+    public static void warmUp() {
+        Thread t = new Thread(
+                () -> {
+                    try {
+                        ensure();
+                    } catch (Throwable e) {
+                        BotLogger.error("engine: native coverage analysis failed", e);
+                    }
+                },
+                "engine-native-coverage");
+        t.setDaemon(true);
+        t.setPriority(Thread.MIN_PRIORITY);
+        t.start();
+    }
+
+    public static Report report() {
+        ensure();
+        return report;
+    }
+
+    private static Map<String, Map<String, HandlerCoverage>> ensure() {
+        if (byKind == null) {
+            synchronized (NativeCoverage.class) {
+                if (byKind == null) compute(NativeCoverage.class.getClassLoader());
+            }
+        }
+        return byKind;
+    }
+
+    // ------------------------------------------------------------------ analysis
+
+    private static final String[] CARRIERS = {
+        "Lnet/dv8tion/jda/api/events/interaction/",
+        "Lnet/dv8tion/jda/api/interactions/",
+        "Lti4/discord/interactions/listeners/context/",
+        "Lti4/selfhost/engine/Interaction;"
+    };
+
+    static synchronized void compute(ClassLoader loader) {
+        long t0 = System.currentTimeMillis();
+        Analyzer an = new Analyzer(loader);
+        Map<String, Map<String, HandlerCoverage>> out = new HashMap<>();
+        List<HandlerCoverage> all = new ArrayList<>();
+        for (Class<?> klass : handlerClasses()) {
+            Method[] methods;
+            try {
+                methods = klass.getDeclaredMethods();
+            } catch (Throwable e) {
+                continue;
+            }
+            for (Method m : methods) {
+                if (!Modifier.isStatic(m.getModifiers())) continue;
+                addAll(out, all, an, klass, m, "button", m.getAnnotationsByType(ButtonHandler.class));
+                addAll(out, all, an, klass, m, "select", m.getAnnotationsByType(SelectionHandler.class));
+                addAll(out, all, an, klass, m, "modal", m.getAnnotationsByType(ModalHandler.class));
+            }
+        }
+        Set<String> pipeline = new TreeSet<>();
+        for (String[] root : new String[][] {
+            {"ti4.discord.interactions.buttons.ButtonProcessor", "processNow"},
+            {"ti4.discord.interactions.selections.SelectionMenuProcessor", "processNow"},
+            {"ti4.discord.interactions.listeners.ModalListener", "processNow"}
+        }) {
+            Set<String>[] r = an.analyzeNamed(root[0], root[1]);
+            if (r != null) pipeline.addAll(r[1]);
+        }
+        Map<String, Integer> usage = new TreeMap<>(), unsupported = new TreeMap<>();
+        Map<String, int[]> kinds = new TreeMap<>();
+        int ok = 0, direct = 0;
+        List<HandlerCoverage> nonNative = new ArrayList<>();
+        all.clear();
+        for (Map<String, HandlerCoverage> m : out.values()) all.addAll(m.values());
+        for (HandlerCoverage c : all) {
+            for (String u : c.uses()) usage.merge(u, 1, Integer::sum);
+            for (String u : c.unsupported()) unsupported.merge(u, 1, Integer::sum);
+            int[] k = kinds.computeIfAbsent(c.kind(), x -> new int[2]);
+            k[0]++;
+            if (c.nativeOk()) {
+                ok++;
+                k[1]++;
+                if (c.uses().stream().noneMatch(NativeCoverage::isTokenOp)) direct++;
+            } else nonNative.add(c);
+        }
+        byKind = out;
+        report = new Report(
+                all.size(),
+                ok,
+                all.isEmpty() ? 0 : Math.round(1000.0 * ok / all.size()) / 10.0,
+                direct,
+                all.isEmpty() ? 0 : Math.round(1000.0 * direct / all.size()) / 10.0,
+                kinds,
+                sortByValue(usage),
+                sortByValue(unsupported),
+                pipeline,
+                nonNative);
+        BotLogger.info("engine: native coverage " + ok + "/" + all.size() + " handlers (" + report.nativePercent()
+                + "%), computed in " + (System.currentTimeMillis() - t0) + " ms");
+    }
+
+    private static <A extends Annotation> void addAll(
+            Map<String, Map<String, HandlerCoverage>> out,
+            List<HandlerCoverage> all,
+            Analyzer an,
+            Class<?> klass,
+            Method m,
+            String kind,
+            A[] anns) {
+        if (anns.length == 0) return;
+        Set<String>[] r = an.analyzeReflect(klass, m);
+        Set<String> uses = r == null ? Set.of() : r[0];
+        Set<String> bad = r == null ? Set.of("(bytecode unavailable)") : r[1];
+        for (A a : anns) {
+            String key =
+                    a instanceof ButtonHandler b ? b.value() : a instanceof SelectionHandler s ? s.value() : ((ModalHandler) a).value();
+            HandlerCoverage c = new HandlerCoverage(
+                    kind, key, klass.getSimpleName() + "#" + m.getName(), bad.isEmpty(), uses, bad);
+            out.computeIfAbsent(kind, k -> new HashMap<>()).put(key, c);
+            all.add(c);
+        }
+    }
+
+    private static List<Class<?>> handlerClasses() {
+        Reflections reflections = new Reflections(new ConfigurationBuilder()
+                .setUrls(ClasspathHelper.forPackage("ti4"))
+                .setScanners(new SubTypesScanner(false)));
+        List<Class<?>> out = new ArrayList<>();
+        for (String name : new TreeSet<>(reflections.getAllTypes())) {
+            if (!name.startsWith("ti4.")) continue;
+            try {
+                out.add(Class.forName(name, false, NativeCoverage.class.getClassLoader()));
+            } catch (Throwable ignored) {
+                // not loadable here
+            }
+        }
+        return out;
+    }
+
+    private static Map<String, Integer> sortByValue(Map<String, Integer> m) {
+        List<Map.Entry<String, Integer>> es = new ArrayList<>(m.entrySet());
+        es.sort((a, b) -> b.getValue() - a.getValue());
+        Map<String, Integer> out = new LinkedHashMap<>();
+        for (Map.Entry<String, Integer> e : es) out.put(e.getKey(), e.getValue());
+        return out;
+    }
+
+    /** Transitive event-operation collector with memoisation. Result: [uses, unsupported]. */
+    private static final class Analyzer {
+        private final ClassPool pool = new ClassPool(false);
+        private final ClassLoader loader;
+        private final Map<String, Set<String>[]> memo = new HashMap<>();
+        private final Set<String> inProgress = new HashSet<>();
+        private final Map<String, Boolean> supportMemo = new HashMap<>();
+
+        Analyzer(ClassLoader loader) {
+            this.loader = loader;
+            pool.appendClassPath(new LoaderClassPath(loader));
+            pool.appendSystemPath();
+        }
+
+        Set<String>[] analyzeReflect(Class<?> klass, Method m) {
+            try {
+                CtClass cc = pool.get(klass.getName());
+                for (CtMethod cm : cc.getDeclaredMethods(m.getName())) {
+                    CtClass[] ps = cm.getParameterTypes();
+                    if (ps.length != m.getParameterCount()) continue;
+                    boolean same = true;
+                    for (int i = 0; i < ps.length && same; i++)
+                        same = ps[i].getName().equals(m.getParameterTypes()[i].getName());
+                    if (same) return analyze(cc, cm.getMethodInfo());
+                }
+            } catch (Exception e) {
+                return null;
+            }
+            return null;
+        }
+
+        Set<String>[] analyzeNamed(String cls, String name) {
+            try {
+                CtClass cc = pool.get(cls);
+                for (CtMethod cm : cc.getDeclaredMethods(name)) return analyze(cc, cm.getMethodInfo());
+            } catch (Exception e) {
+                return null;
+            }
+            return null;
+        }
+
+        @SuppressWarnings("unchecked")
+        Set<String>[] analyze(CtClass cc, MethodInfo mi) {
+            String key = cc.getName() + "." + mi.getName() + mi.getDescriptor();
+            Set<String>[] done = memo.get(key);
+            if (done != null) return done;
+            Set<String>[] r = new Set[] {new TreeSet<String>(), new TreeSet<String>()};
+            if (!inProgress.add(key)) return r; // recursion: the outer frame collects
+            try {
+                CodeAttribute ca = mi.getCodeAttribute();
+                if (ca != null) {
+                    ConstPool cp = mi.getConstPool();
+                    CodeIterator it = ca.iterator();
+                    while (it.hasNext()) {
+                        int pos = it.next();
+                        int op = it.byteAt(pos);
+                        switch (op) {
+                            case Opcode.INVOKEVIRTUAL, Opcode.INVOKESPECIAL, Opcode.INVOKESTATIC, Opcode.INVOKEINTERFACE -> {
+                                int idx = it.u16bitAt(pos + 1);
+                                call(r, cp.getMethodrefClassName(idx), cp.getMethodrefName(idx), cp.getMethodrefType(idx));
+                            }
+                            case Opcode.INVOKEDYNAMIC -> lambda(r, cc, cp, it.u16bitAt(pos + 1));
+                            default -> {}
+                        }
+                    }
+                }
+            } catch (Exception e) {
+                r[1].add("(analysis failed: " + e.getClass().getSimpleName() + ")");
+            } finally {
+                inProgress.remove(key);
+            }
+            memo.put(key, r);
+            return r;
+        }
+
+        private void lambda(Set<String>[] r, CtClass cc, ConstPool cp, int idx) {
+            ClassFile cf = cc.getClassFile2();
+            BootstrapMethodsAttribute bma = (BootstrapMethodsAttribute) cf.getAttribute(BootstrapMethodsAttribute.tag);
+            if (bma == null) return;
+            int bi = cp.getInvokeDynamicBootstrap(idx);
+            for (int arg : bma.getMethods()[bi].arguments) {
+                if (cp.getTag(arg) != ConstPool.CONST_MethodHandle) continue;
+                int ref = cp.getMethodHandleIndex(arg);
+                int tag = cp.getTag(ref);
+                if (tag != ConstPool.CONST_Methodref && tag != ConstPool.CONST_InterfaceMethodref) continue;
+                call(r, cp.getMethodrefClassName(ref), cp.getMethodrefName(ref), cp.getMethodrefType(ref));
+            }
+        }
+
+        private void call(Set<String>[] r, String cls, String name, String desc) {
+            if (cls == null) return;
+            if (isInteractionType(cls)) {
+                String op = cls.substring(cls.lastIndexOf('.') + 1) + "." + name;
+                r[0].add(op);
+                if (!supported(cls, name)) r[1].add(op);
+                return;
+            }
+            if (cls.startsWith("ti4.") && carriesInteraction(desc)) {
+                try {
+                    CtClass target = pool.get(cls);
+                    CtMethod cm = findMethod(target, name, desc);
+                    if (cm == null || cm.getMethodInfo().getCodeAttribute() == null) return;
+                    Set<String>[] sub = analyze(cm.getDeclaringClass(), cm.getMethodInfo());
+                    r[0].addAll(sub[0]);
+                    r[1].addAll(sub[1]);
+                } catch (Exception ignored) {
+                    // constructors / unknown: nothing to follow
+                }
+            }
+        }
+
+        private static CtMethod findMethod(CtClass c, String name, String desc) {
+            try {
+                return c.getMethod(name, desc);
+            } catch (Exception e) {
+                return null;
+            }
+        }
+
+        private static boolean carriesInteraction(String desc) {
+            int close = desc.indexOf(')');
+            String params = close < 0 ? desc : desc.substring(0, close);
+            for (String c : CARRIERS) if (params.contains(c)) return true;
+            return false;
+        }
+
+        private static boolean isInteractionType(String cls) {
+            return cls.startsWith("net.dv8tion.jda.api.events.interaction.")
+                    || cls.startsWith("net.dv8tion.jda.api.interactions.")
+                    || cls.startsWith("net.dv8tion.jda.api.requests.restaction.interactions.")
+                    || cls.startsWith("net.dv8tion.jda.api.requests.restaction.WebhookMessage");
+        }
+
+        /** Mirrors NativeEvents.View / Hook and NativeAction dispatch rules. */
+        private boolean supported(String cls, String name) {
+            return supportMemo.computeIfAbsent(cls + "#" + name, k -> computeSupported(cls, name));
+        }
+
+        private boolean computeSupported(String cls, String name) {
+            Class<?> c;
+            try {
+                c = Class.forName(cls, false, loader);
+            } catch (Throwable e) {
+                return false;
+            }
+            // Event types our view is not (slash commands, autocomplete, entity selects, ...): those code paths are
+            // behind instanceof checks and cannot run for an engine answer.
+            if (cls.startsWith("net.dv8tion.jda.api.events.interaction.")) {
+                boolean ours = c.isAssignableFrom(net.dv8tion.jda.api.events.interaction.component.ButtonInteractionEvent.class)
+                        || c.isAssignableFrom(net.dv8tion.jda.api.events.interaction.component.StringSelectInteractionEvent.class)
+                        || c.isAssignableFrom(net.dv8tion.jda.api.events.interaction.ModalInteractionEvent.class);
+                if (!ours) return true;
+                if (VIEW_EVENT_ONLY.contains(name)) return true;
+                return viewSupports(name);
+            }
+            if (InteractionHook.class.isAssignableFrom(c) || c == net.dv8tion.jda.api.entities.WebhookClient.class)
+                return HOOK_OPS.contains(name) || isDefault(c, name) || isDefault(InteractionHook.class, name);
+            if (c.isInterface() && (c.isAssignableFrom(ButtonInteraction.class)
+                    || c.isAssignableFrom(StringSelectInteraction.class)
+                    || c.isAssignableFrom(ModalInteraction.class))) return viewSupports(name);
+            if (c.isInterface() && cls.startsWith("net.dv8tion.jda.api.interactions.")) return true; // other interaction kinds
+            // slash-command payloads (behind instanceof checks; never our event)
+            if (cls.startsWith("net.dv8tion.jda.api.interactions.commands.")) return true;
+            // modal values are real JDA ModalMappings built from the engine's inputs (no resolved entities)
+            if (cls.equals("net.dv8tion.jda.api.interactions.modals.ModalMapping")) return !name.equals("getAsMentions");
+            // callback / webhook actions → NativeAction
+            if (ACTION_OPS.contains(name)) return true;
+            Class<?> builder = name.startsWith("set") || name.startsWith("add") || name.startsWith("get")
+                    ? (cls.contains("Edit") ? MessageEditBuilder.class : MessageCreateBuilder.class)
+                    : MessageCreateBuilder.class;
+            for (Method m : builder.getMethods()) if (m.getName().equals(name)) return true;
+            for (Method m : c.getMethods()) {
+                if (!m.getName().equals(name)) continue;
+                if (m.isDefault() || m.getReturnType().isAssignableFrom(c)) return true;
+            }
+            return false;
+        }
+
+        private static boolean viewSupports(String name) {
+            if (VIEW_OPS.contains(name)) return true;
+            return isDefault(ButtonInteraction.class, name)
+                    || isDefault(StringSelectInteraction.class, name)
+                    || isDefault(ModalInteraction.class, name);
+        }
+
+        private static boolean isDefault(Class<?> c, String name) {
+            for (Method m : c.getMethods()) if (m.getName().equals(name) && m.isDefault()) return true;
+            return false;
+        }
+    }
+
+    /** Implemented explicitly by NativeEvents.View. */
+    static final Set<String> VIEW_OPS = Set.of(
+            "getJDA", "getIdLong", "getId", "getTypeRaw", "getType", "getToken", "getGuild", "getUser", "getMember",
+            "isAcknowledged", "getChannel", "getMessageChannel", "getGuildChannel", "getChannelIdLong", "getChannelId",
+            "getUserLocale", "getGuildLocale", "getEntitlements", "getContext", "getIntegrationOwners",
+            "getComponentId", "getCustomId", "getModalId", "getComponent", "getButton", "getSelectMenu",
+            "getComponentType", "getMessage", "getMessageIdLong", "getMessageId", "getValues", "getHook",
+            "deferEdit", "deferReply", "replyModal", "reply", "editMessage", "getInteraction", "getTimeCreated",
+            "isFromGuild", "getChannelType", "getUniqueId");
+
+    /** GenericEvent / GenericInteractionCreateEvent methods that need no interaction. */
+    static final Set<String> VIEW_EVENT_ONLY =
+            Set.of("getResponseNumber", "getRawData", "getInteraction", "getJDA", "<init>", "getClass");
+
+    static final Set<String> HOOK_OPS = Set.of(
+            "getJDA", "getInteraction", "getToken", "getIdLong", "getId", "getExpirationTimestamp", "hasCallbackResponse",
+            "getCallbackResponse", "setEphemeral", "sendMessage", "sendMessageEmbeds", "sendMessageComponents",
+            "sendFiles", "editMessageById", "editMessageEmbedsById", "editMessageComponentsById",
+            "editMessageAttachmentsById", "deleteMessageById", "retrieveMessageById", "isExpired");
+
+    static final Set<String> ACTION_OPS = Set.of(
+            "queue", "complete", "submit", "getJDA", "setEphemeral", "isEphemeral", "setCheck", "addCheck", "timeout",
+            "deadline", "reason", "closeResources", "setUsername", "setAvatarUrl", "createThread", "useComponentsV2",
+            "mentionRepliedUser", "setSuppressedNotifications", "setVoiceMessage", "getCheck", "queueAfter",
+            "submitAfter", "completeAfter", "map", "flatMap", "onSuccess", "onErrorMap", "onErrorFlatMap", "delay",
+            "and", "zip", "mapToResult", "applyData");
+
+    private static final Set<String> TOKEN_METHODS = Set.of(
+            "getHook", "reply", "replyEmbeds", "replyComponents", "replyFiles", "replyFormat", "replyPoll", "deferEdit",
+            "deferReply", "editMessage", "editComponents", "editButton", "editSelectMenu", "editMessageEmbeds",
+            "editMessageFormat", "editMessageAttachments", "replyModal");
+
+    /** Operations that need the interaction token on Discord (emulated by the JDA view for engine answers). */
+    static boolean isTokenOp(String op) {
+        int dot = op.indexOf('.');
+        String owner = op.substring(0, dot), name = op.substring(dot + 1);
+        return owner.equals("InteractionHook")
+                || owner.startsWith("WebhookMessage")
+                || owner.endsWith("CallbackAction")
+                || TOKEN_METHODS.contains(name);
+    }
+
+    static List<HandlerCoverage> sorted(List<HandlerCoverage> l) {
+        List<HandlerCoverage> out = new ArrayList<>(l);
+        out.sort((a, b) -> a.key().compareTo(b.key()));
+        return Collections.unmodifiableList(out);
+    }
+}
