diff --git a/src/main/java/ti4/selfhost/engine/kinds/ActionCardSabotageKind.java b/src/main/java/ti4/selfhost/engine/kinds/ActionCardSabotageKind.java
new file mode 100644
index 0000000..6a4cb6a
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/ActionCardSabotageKind.java
@@ -0,0 +1,181 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+import java.util.Set;
+import java.util.concurrent.ConcurrentHashMap;
+import javax.annotation.Nullable;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.message.GameMessage;
+import ti4.message.GameMessageManager;
+import ti4.selfhost.engine.EngineModels.Decision;
+import ti4.selfhost.engine.EngineModels.Option;
+import ti4.selfhost.engine.EngineModels.ReactionWindow;
+import ti4.selfhost.engine.EngineModels.Target;
+import ti4.selfhost.engine.KindSpec;
+import ti4.service.actioncard.SabotageService;
+
+/**
+ * The table-wide window after an action card is played (ActionCardHelper.playAC): "Cancel Action Card With
+ * Sabotage" (sabotage_ac_&lt;title&gt;_&lt;faction&gt;), "No Sabotage" (no_sabotage) and the player's own "Pause Timer"
+ * (FFCC_&lt;f&gt;_moveAlongAfterAllHaveReactedToAC_&lt;title&gt;). Plus the private offers in a cards-info thread to
+ * cancel with a Watcher / Triune fighters / Instinct Training (sabotage_empy_|sabotage_tf_|sabotage_xxcha_ +
+ * "Delete These Buttons"): those are player-scoped, no window.
+ *
+ * <p>Option value: {action: "cancel"|"pass"|"wait", via: "ac"|"empy"|"tf"|"xxcha"|null, actionCard, cardName,
+ * playedBy (faction)}.
+ *
+ * <p>Window (kind "sabotage"): subject {actionCard, cardName, player (uid), faction}; eligible = every real player but
+ * the one who played the card; responded = those the engine recorded as reacted (GameMessageManager: "No Sabotage"
+ * presses and the automatic passes for players who could not feasibly cancel, SabotageService.couldFeasiblySabotage).
+ * Before the engine registers the message (right after posting) the automatic passes are predicted the same way.
+ * Once the engine forgets the message (everyone passed, or the card was cancelled) every eligible player counts as
+ * responded: the window is over although the Discord message keeps its buttons.
+ */
+public class ActionCardSabotageKind implements KindSpec {
+    private static final String MOVE_ALONG = "moveAlongAfterAllHaveReactedToAC_";
+    /** Messages whose GameMessage we have seen registered: once it disappears again the window is over. */
+    private static final Set<String> registered = ConcurrentHashMap.newKeySet();
+    /** messageId → faction that played the card (from the pause button's owner prefix or the cancel button id). */
+    private static final Map<String, String> playedByMessage = new ConcurrentHashMap<>();
+    /** messageId → card name (title) of the card the window is about. */
+    private static final Map<String, String> cardOfMessage = new ConcurrentHashMap<>();
+
+    @Override
+    public String kind() {
+        return "action_card.sabotage";
+    }
+
+    @Override
+    public int priority() {
+        return 100;
+    }
+
+    @Override
+    public boolean dynamic() {
+        return true;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return handlerId.startsWith("sabotage_") || handlerId.equals("no_sabotage") || handlerId.startsWith(MOVE_ALONG);
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        Map<String, Object> v = new LinkedHashMap<>();
+        String title = null;
+        if (handlerId.equals("no_sabotage")) {
+            v.put("action", "pass");
+            v.put("via", null);
+        } else if (handlerId.startsWith(MOVE_ALONG)) {
+            v.put("action", "wait");
+            v.put("via", null);
+            title = handlerId.substring(MOVE_ALONG.length());
+        } else {
+            // sabotage_<type>_<title>_<faction>; titles are card names (spaces, no '_').
+            String[] parts = handlerId.substring("sabotage_".length()).split("_");
+            v.put("action", "cancel");
+            v.put("via", parts[0]);
+            if (parts.length > 1) title = parts[1];
+            if (parts.length > 2) {
+                String f = canonicalFaction(ctx.game(), parts[2]);
+                if (f != null) playedByMessage.put(ctx.messageId(), f);
+            }
+        }
+        if (title != null) cardOfMessage.putIfAbsent(ctx.messageId(), title);
+        v.put("cardName", title);
+        v.put("actionCard", title == null ? null : CardKinds.acIdByName(ctx.game(), title));
+        v.put("playedBy", playedBy(ctx.game(), ctx.messageId(), null));
+        return v;
+    }
+
+    @Nullable
+    private static String canonicalFaction(Game game, String factionOrColor) {
+        Player p = game.getPlayerFromColorOrFaction(factionOrColor);
+        return p == null ? null : p.getFaction();
+    }
+
+    @Override
+    public Target target(CaptureContext ctx, Target resolved) {
+        if (resolved != null && ("cards_thread".equals(resolved.resolvedBy())
+                || "private_channel".equals(resolved.resolvedBy()))) return resolved;
+        // The generic resolver saw the pause button's owner prefix: that is who played the card.
+        if (resolved != null && "owner_prefix".equals(resolved.resolvedBy()) && resolved.faction() != null)
+            playedByMessage.putIfAbsent(ctx.messageId(), resolved.faction());
+        return new Target(null, null, null, "none");
+    }
+
+    @Override
+    public String scope(CaptureContext ctx) {
+        return ctx.target() != null && ctx.target().userId() != null ? "player" : "table";
+    }
+
+    @Nullable
+    private static String playedBy(Game game, String messageId, @Nullable GameMessage gm) {
+        String f = playedByMessage.get(messageId);
+        if (f != null) return f;
+        // The engine reacts for the player who played the card first (MessageHelper ...FactionReact).
+        if (gm != null && gm.factionsThatReacted() != null && !gm.factionsThatReacted().isEmpty())
+            return gm.factionsThatReacted().getFirst();
+        return null;
+    }
+
+    @Override
+    public ReactionWindow window(CaptureContext ctx) {
+        if (ctx.target() != null && ctx.target().userId() != null) return null; // private offer
+        Game game = ctx.game();
+        String messageId = ctx.messageId();
+        Optional<GameMessage> gm = GameMessageManager.getOne(game.getName(), messageId);
+        boolean over = false;
+        if (gm.isPresent()) registered.add(messageId);
+        else if (registered.contains(messageId)) over = true;
+        String playedBy = playedBy(game, messageId, gm.orElse(null));
+        Player actor = playedBy == null ? null : game.getPlayerFromColorOrFaction(playedBy);
+
+        Set<String> reacted = new LinkedHashSet<>();
+        if (gm.isPresent() && gm.get().factionsThatReacted() != null) reacted.addAll(gm.get().factionsThatReacted());
+        List<String> eligible = new ArrayList<>();
+        List<String> responded = new ArrayList<>();
+        Map<String, String> responses = new LinkedHashMap<>();
+        for (Player p : game.getRealPlayers()) {
+            if (p == actor) continue;
+            eligible.add(p.getUserID());
+            boolean auto = !SabotageService.couldFeasiblySabotage(p, game);
+            boolean done = over || reacted.contains(p.getFaction()) || (gm.isEmpty() && auto);
+            if (!done) continue;
+            responded.add(p.getUserID());
+            responses.put(p.getUserID(), over && !reacted.contains(p.getFaction()) ? "closed" : auto ? "auto_passed" : "passed");
+        }
+        Map<String, Object> subject = new LinkedHashMap<>();
+        String title = cardOfMessage.get(messageId);
+        subject.put("actionCard", title == null ? null : CardKinds.acIdByName(game, title));
+        subject.put("cardName", title);
+        subject.put("faction", playedBy);
+        subject.put("player", actor == null ? null : actor.getUserID());
+        return new ReactionWindow("sabotage", subject, eligible, responded, responses);
+    }
+
+    @Override
+    public String validate(Game game, Player answering, Decision decision, String optionId) {
+        Option opt = null;
+        for (Option o : decision.options()) if (o.id().equals(optionId)) opt = o;
+        if (opt == null || opt.value() == null) return null;
+        String action = String.valueOf(opt.value().get("action"));
+        String playedBy = playedBy(game, decision.source().messageId(), null);
+        boolean mine = answering.getFaction().equals(playedBy);
+        if ("wait".equals(action)) return mine ? null : "Only the player who played the card can pause the timer.";
+        if (mine) return "You cannot cancel your own action card.";
+        if ("cancel".equals(action)
+                && "ac".equals(opt.value().get("via"))
+                && answering.getActionCards().keySet().stream()
+                        .noneMatch(ac -> ac.contains("sabo") || ac.contains("shatter")))
+            return "You have no Sabotage in hand.";
+        return null;
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/ActionCardTargetKind.java b/src/main/java/ti4/selfhost/engine/kinds/ActionCardTargetKind.java
new file mode 100644
index 0000000..b019367
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/ActionCardTargetKind.java
@@ -0,0 +1,97 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+import java.util.Set;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.image.Mapper;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * The target steps of base/PoK/Codex action cards after "Resolve X" (ButtonHelperActionCards): choose a player
+ * (plagueStep2_&lt;faction&gt;), a planet (plagueStep3_&lt;faction&gt;_&lt;planet&gt;), a system (probeStep2_&lt;pos&gt;),
+ * a strategy card (psStep2_&lt;n&gt;). Only the listed step prefixes are ours, and every id token is checked against the
+ * game before it is typed (a token that is no player / planet / system leaves the option untyped).
+ *
+ * <p>Value: {step, player?, planet?, system?, holder?, strategyCard?}. step = the handler prefix without the
+ * trailing '_' (identifies the card and step); player = faction, planet = planet id, system = tile position,
+ * holder = "space" for space-area targets.
+ */
+public class ActionCardTargetKind implements KindSpec {
+
+    static final Set<String> STEPS = Set.of(
+            "absStep2_", "assRepsStep2_", "bountyStep2_", "crippleStep2_", "crippleStep3_", "decoyOperationStep2_",
+            "diplomaticPressureStep2_", "forwardSupplyBaseStep2_", "ghostShipStep2_", "heistStep2_",
+            "infiltrateStep2_", "infiltrateStep3_", "insubStep2_", "micrometeoroidStormStep2_",
+            "micrometeoroidStormStep3_", "plagueStep2_", "plagueStep3_", "probeStep2_", "psStep2_",
+            "psionicHammerStep2_", "psionicHammerStep3_", "reactorMeltdownStep2_", "reactorMeltdownStep3_",
+            "reconstructionStep2_", "reconstructionStep3_", "reparationsStep2_", "reparationsStep3_",
+            "resolveBetrayalStep2_", "resolveBlackMarketRaidStep2_", "resolveCacheStep2_", "resolveCorruptionStep2_",
+            "resolveDecoyOperationStep1_", "resolveEBSStep1_", "resolveFreedomFightersStep2_",
+            "resolveLiberationStep2_", "resolveParleyStep2_", "resolveRefugeesStep2_", "resolveRefugeesStep3_",
+            "salvageStep2_", "seizeArtifactStep2_", "signalJammingStep2_", "signalJammingStep3_",
+            "signalJammingStep4_", "spyStep2_", "spyStep3_", "strandedShipStep2_", "tacticalBombardmentStep2_",
+            "unexpectedSomeoneElseStep2_", "unstableStep2_", "unstableStep3_", "uprisingStep2_", "uprisingStep3_",
+            "resolveBlitz_", "resolveEmergencyRepairs_", "resolveUpgrade_", "salvageOps_");
+
+    @Override
+    public String kind() {
+        return "action_card.target";
+    }
+
+    @Override
+    public int priority() {
+        return 60;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return step(handlerId) != null;
+    }
+
+    private static String step(String handlerId) {
+        int us = handlerId.indexOf('_');
+        if (us < 0) return null;
+        String head = handlerId.substring(0, us + 1);
+        return STEPS.contains(head) ? head : null;
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        String step = step(handlerId);
+        if (step == null) return null;
+        Game game = ctx.game();
+        Map<String, Object> v = new LinkedHashMap<>();
+        v.put("step", step.substring(0, step.length() - 1));
+        String rest = handlerId.substring(step.length());
+        boolean typed = false;
+        for (String tok : rest.split("_")) {
+            if (tok.isEmpty()) continue;
+            if ("psStep2_".equals(step)) {
+                int sc = CardKinds.parseInt(tok, -1);
+                if (sc >= 0 && game.getSCList().contains(sc)) {
+                    v.put("strategyCard", sc);
+                    typed = true;
+                }
+                continue;
+            }
+            if ("space".equals(tok)) {
+                v.put("holder", "space");
+                continue;
+            }
+            Player p = game.getPlayerFromColorOrFaction(tok);
+            if (p != null && !v.containsKey("player")) {
+                v.put("player", p.getFaction());
+                typed = true;
+            } else if (game.getPlanetsInfo().containsKey(tok) || Mapper.isValidPlanet(tok)) {
+                v.put("planet", tok);
+                typed = true;
+            } else if (game.getTileByPosition(tok) != null) {
+                v.put("system", tok);
+                typed = true;
+            }
+        }
+        return typed ? v : null;
+    }
+}
