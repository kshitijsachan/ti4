diff --git a/src/main/java/ti4/helpers/PromptState.java b/src/main/java/ti4/helpers/PromptState.java
new file mode 100644
index 0000000..2205d74
--- /dev/null
+++ b/src/main/java/ti4/helpers/PromptState.java
@@ -0,0 +1,40 @@
+package ti4.helpers;
+
+import javax.annotation.Nullable;
+import ti4.game.Player;
+
+/**
+ * State a multi-step prompt keeps between presses (running totals, "where we started"), held in the player's stored
+ * values so it is saved with the game and restored by undo, instead of being parsed back out of the prompt's own
+ * Discord message text. One slot per (player, name), tagged with the prompt (message) id it belongs to, so a fresh
+ * prompt never sees an older prompt's state and nothing accumulates in the save file.
+ */
+public final class PromptState {
+
+    private static final String PREFIX = "promptState_";
+
+    private PromptState() {}
+
+    public static void put(Player player, String name, @Nullable String promptId, String value) {
+        if (player == null) return;
+        player.setStoredValue(PREFIX + name, (promptId == null ? "" : promptId) + "|" + value);
+    }
+
+    /** The value stored for this prompt, or "" when none (or it belongs to another prompt). */
+    public static String get(Player player, String name, @Nullable String promptId) {
+        if (player == null) return "";
+        String raw = player.getStoredValue(PREFIX + name);
+        String tag = (promptId == null ? "" : promptId) + "|";
+        return raw.startsWith(tag) ? raw.substring(tag.length()) : "";
+    }
+
+    /** Whether a value (possibly "") is stored for this prompt. */
+    public static boolean has(Player player, String name, @Nullable String promptId) {
+        if (player == null) return false;
+        return player.getStoredValue(PREFIX + name).startsWith((promptId == null ? "" : promptId) + "|");
+    }
+
+    public static void clear(Player player, String name) {
+        if (player != null) player.removeStoredValue(PREFIX + name);
+    }
+}
