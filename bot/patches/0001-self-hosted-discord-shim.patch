@@ -0,0 +1,71 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.Map;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.selfhost.engine.EngineModels.Decision;
+import ti4.selfhost.engine.EngineModels.SetupState;
+import ti4.selfhost.engine.EngineModels.Target;
+import ti4.selfhost.engine.KindSpec;
+import ti4.selfhost.engine.SetupStateBuilder;
+
+/**
+ * Table step "Reveal Objectives and Start Strategy Phase" (startOfGameObjReveal, main channel, anyone may press) once
+ * every player kept one secret objective. validate mirrors the handler's own checks (all secrets kept, speaker set)
+ * so an early press is refused with a reason instead of a channel message. value: {}.
+ */
+public class RevealObjectivesKind implements KindSpec {
+
+    @Override
+    public String kind() {
+        return "setup.reveal_objectives";
+    }
+
+    @Override
+    public int priority() {
+        return 100;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return "startOfGameObjReveal".equals(handlerId);
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        return matches(handlerId) ? SetupKindSupport.map() : null;
+    }
+
+    @Override
+    public Target target(CaptureContext ctx, Target resolved) {
+        return null;
+    }
+
+    @Override
+    public String scope(CaptureContext ctx) {
+        return "table";
+    }
+
+    @Override
+    public String validate(Game game, Player answering, Decision decision, String optionId) {
+        if (!matches(SetupKindSupport.handlerOf(decision, optionId))) return null;
+        if (!game.getStoredValue("revealedFlop" + game.getRound()).isEmpty())
+            return "The public objectives were already revealed.";
+        SetupState s = SetupStateBuilder.build(game);
+        if (s != null && "keep_secrets".equals(s.stage()))
+            return "Not every player has kept a secret objective yet.";
+        if (game.getPlayer(game.getSpeakerUserID()) == null) return "No speaker is assigned yet.";
+        return null;
+    }
+
+    @Override
+    public boolean dynamic() {
+        return true;
+    }
+
+    /** Past setup this prompt is a leftover nobody needs (live: hundreds open across games, flooding the web queue). */
+    @Override
+    public boolean obsolete(CaptureContext ctx) {
+        return ti4.selfhost.engine.SetupStateBuilder.pastSetup(ctx.game());
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/SecretObjectiveDiscardKind.java b/src/main/java/ti4/selfhost/engine/kinds/SecretObjectiveDiscardKind.java
new file mode 100644
index 0000000..a9f7f9d
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/SecretObjectiveDiscardKind.java
@@ -0,0 +1,78 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * Discard a secret objective (setup: "keep one of two" = discard the other). discardSecret_&lt;n&gt;[redraw] /
+ * SODISCARD_&lt;n&gt; where n is the player's numeric handle for the card (Player.getSecrets()).
+ */
+public class SecretObjectiveDiscardKind implements KindSpec {
+
+    @Override
+    public String kind() {
+        return "secret_objective.discard";
+    }
+
+    @Override
+    public int priority() {
+        return 50;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return handlerId.startsWith("discardSecret_") || handlerId.startsWith("SODISCARD_");
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        if (!matches(handlerId)) return null;
+        String rest = handlerId.replace("discardSecret_", "").replace("SODISCARD_", "");
+        boolean redraw = rest.endsWith("redraw");
+        rest = rest.replace("redraw", "");
+        Map<String, Object> v = new LinkedHashMap<>();
+        try {
+            int handle = Integer.parseInt(rest);
+            v.put("handle", handle);
+            if (ctx.player() != null) {
+                for (Map.Entry<String, Integer> e : ctx.player().getSecrets().entrySet()) {
+                    if (e.getValue() == handle) v.put("secretObjective", e.getKey());
+                }
+            }
+        } catch (NumberFormatException e) {
+            return null;
+        }
+        v.put("redraw", redraw);
+        return v;
+    }
+
+    @Override
+    public boolean dynamic() {
+        return true;
+    }
+
+    /** Setup: once the player keeps one secret objective, the rest of the discard prompt is a leftover (pbd99). */
+    @Override
+    public boolean obsolete(CaptureContext ctx) {
+        ti4.game.Player p = ctx.player();
+        if (p == null || ti4.selfhost.engine.SetupStateBuilder.build(ctx.game()) == null) return false;
+        return ti4.selfhost.engine.SetupStateBuilder.secretsDealt(ctx.game())
+                && ti4.selfhost.engine.SetupStateBuilder.secretsToDiscard(ctx.game(), p) == 0;
+    }
+
+    /** A handle no longer in hand changes nothing when pressed: refuse it instead of reporting "done". */
+    @Override
+    public String validate(
+            ti4.game.Game game,
+            ti4.game.Player answering,
+            ti4.selfhost.engine.EngineModels.Decision decision,
+            String optionId) {
+        for (ti4.selfhost.engine.EngineModels.Option o : decision.options()) {
+            if (!o.id().equals(optionId) || o.value() == null) continue;
+            if (o.value().get("handle") instanceof Integer h && !answering.getSecrets().containsValue(h))
+                return "That secret objective is no longer in your hand.";
+        }
+        return null;
+    }
+}
