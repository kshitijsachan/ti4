@@ -0,0 +1,51 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.List;
+import java.util.Map;
+import javax.annotation.Nullable;
+import ti4.selfhost.engine.EngineModels.Target;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * faction.ability — faction abilities, faction technologies, faction promissory-note resolutions, mech / flagship
+ * abilities and faction breakthroughs (shared kind; the steps come from {@link FactionSteps} providers, one class
+ * per faction). Value: {source (ability|tech|promissory|mech|flagship|breakthrough), id, faction, step, action
+ * (use|target|skip), optional, + typed fields: target (faction), tile, planet, unit, amount, strategyCard...}.
+ */
+public class FactionAbilityKind implements KindSpec {
+    static final String KIND = "faction.ability";
+
+    @Override
+    public String kind() {
+        return KIND;
+    }
+
+    @Override
+    public int priority() {
+        return 40;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        FactionSteps.Step s = FactionSteps.Registry.find(handlerId, null);
+        return s != null && KIND.equals(s.kind());
+    }
+
+    @Override
+    public boolean classifies(List<String> handlerIds) {
+        return KIND.equals(FactionSteps.Registry.kindOf(handlerIds));
+    }
+
+    @Override
+    @Nullable
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        FactionSteps.Step s = FactionSteps.Registry.find(handlerId, ctx);
+        return s == null || !KIND.equals(s.kind()) ? null : s.value();
+    }
+
+    @Override
+    @Nullable
+    public Target target(CaptureContext ctx, @Nullable Target resolved) {
+        return FactionSteps.Registry.target(ctx, resolved);
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/FactionSteps.java b/src/main/java/ti4/selfhost/engine/kinds/FactionSteps.java
new file mode 100644
index 0000000..fd5a091
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/FactionSteps.java
@@ -0,0 +1,302 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import javax.annotation.Nullable;
+import org.reflections.Reflections;
+import org.reflections.scanners.Scanners;
+import org.reflections.scanners.SubTypesScanner;
+import org.reflections.util.ClasspathHelper;
+import org.reflections.util.ConfigurationBuilder;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.helpers.ButtonHelperAgents;
+import ti4.image.Mapper;
+import ti4.logging.BotLogger;
+import ti4.model.LeaderModel;
+import ti4.selfhost.engine.EngineModels.Target;
+import ti4.selfhost.engine.KindSpec.CaptureContext;
+
+/**
+ * Shared typing of faction-specific prompts for the two shared kinds {@code leader.use} ({@link LeaderUseKind}) and
+ * {@code faction.ability} ({@link FactionAbilityKind}). Each faction area adds ONE class per faction (e.g.
+ * {@code FactionStepsArborec}, or a group rule table such as {@code FactionAbilityRulesGroupC} /
+ * {@code LeaderRulesGroupC}; the class name is free) implementing this interface, with a public no-arg constructor,
+ * in {@code ti4.selfhost.engine.kinds}; it is discovered on the classpath like a KindSpec (no shared file to edit).
+ * Owner of this interface and of the two kinds: c1-factions-a. Providers are asked in class-name order; the first
+ * non-null step wins, so keep id patterns exclusive.
+ *
+ * <p>A provider maps a handler id (custom id without FFCC_/spoof/delete markers) to a {@link Step}: which kind,
+ * which component (leader id / ability, tech, PN, unit id), the step name and typed fields (ids only: planet ids,
+ * tile positions, unit async ids, factions, amounts). {@code step(handlerId, null)} must be pure on the id (it is
+ * used to classify); with a ctx it may resolve per-game facts.
+ *
+ * <p>A message is a faction step only when EVERY option is a faction step or chrome (Decline / Done = deleteButtons*,
+ * UNDO, pagination): menus that mix in other areas' options (turn menu, combat controls, cards-info menu) stay with
+ * their owners.
+ */
+public interface FactionSteps {
+
+    @Nullable
+    Step step(String handlerId, @Nullable CaptureContext ctx);
+
+    /**
+     * One typed option. kind = "leader.use" | "faction.ability". component = leader id (leader.use) or the
+     * ability / tech / promissory note / unit / breakthrough id (faction.ability, with source). faction = the faction
+     * the component belongs to. step = the engine step (the handler prefix, no trailing "_"). action: "use" (start /
+     * accept an optional effect), "target" (a choice inside an effect already under way), "skip" (an in-flow choice
+     * not to do something). optional: the effect may be declined (a Decline/Done option or "skip" is offered).
+     */
+    record Step(
+            String kind,
+            String source,
+            String component,
+            @Nullable String faction,
+            String step,
+            String action,
+            boolean optional,
+            Map<String, Object> fields) {
+
+        static Step leader(String leader, String step, String action, boolean optional, Object... kv) {
+            LeaderModel m = leaderModel(leader);
+            java.util.regex.Matcher id = LEADER_ID.matcher(leader);
+            boolean shaped = id.matches();
+            String source = m != null && m.getType() != null ? m.getType() : shaped ? id.group(2) : "leader";
+            String faction = m != null && m.getFaction() != null ? m.getFaction() : shaped ? id.group(1) : null;
+            return new Step(
+                    "leader.use",
+                    source,
+                    leader,
+                    faction,
+                    step,
+                    action,
+                    optional,
+                    fields(kv));
+        }
+
+        static Step ability(
+                String source, String component, String faction, String step, String action, boolean optional,
+                Object... kv) {
+            return new Step("faction.ability", source, component, faction, step, action, optional, fields(kv));
+        }
+
+        Map<String, Object> value() {
+            Map<String, Object> v = new LinkedHashMap<>();
+            if ("leader.use".equals(kind)) {
+                v.put("leader", component);
+                v.put("leaderType", source);
+            } else {
+                v.put("source", source);
+                v.put("id", component);
+            }
+            v.put("faction", faction);
+            v.put("step", step);
+            v.put("action", action);
+            v.put("optional", optional);
+            v.putAll(fields);
+            return v;
+        }
+
+        private static Map<String, Object> fields(Object... kv) {
+            Map<String, Object> m = new LinkedHashMap<>();
+            for (int i = 0; i + 1 < kv.length; i += 2) if (kv[i + 1] != null) m.put((String) kv[i], kv[i + 1]);
+            return m;
+        }
+    }
+
+    /** Leader ids are "&lt;faction&gt;&lt;agent|commander|hero&gt;[suffix]" (e.g. nomadagentartuno). */
+    java.util.regex.Pattern LEADER_ID =
+            java.util.regex.Pattern.compile("([a-z0-9]+?)(agent|commander|hero)([a-z0-9]*)");
+
+    /** The leader model, or null (unknown id, or model data not loaded: offline replay). */
+    @Nullable
+    static LeaderModel leaderModel(String id) {
+        try {
+            return Mapper.getLeader(id);
+        } catch (RuntimeException | LinkageError e) {
+            return null;
+        }
+    }
+
+    /** A leader id: known to the model data, or (model data not loaded, offline replay) shaped like one. */
+    static boolean isLeader(String id) {
+        if (leaderModel(id) != null) return true;
+        return leaderModel("hacanagent") == null && LEADER_ID.matcher(id).matches();
+    }
+
+    // ---------------------------------------------------------------- registry
+
+    final class Registry {
+        private static volatile List<FactionSteps> providers;
+
+        private Registry() {}
+
+        static List<FactionSteps> all() {
+            List<FactionSteps> p = providers;
+            if (p != null) return p;
+            synchronized (Registry.class) {
+                if (providers != null) return providers;
+                List<FactionSteps> found = new ArrayList<>();
+                try {
+                    Reflections r = new Reflections(new ConfigurationBuilder()
+                            .setUrls(ClasspathHelper.forJavaClassPath())
+                            .setScanners(new SubTypesScanner(false)));
+                    for (Class<?> c : r.get(Scanners.SubTypes.of(Object.class).asClass())) {
+                        if (!FactionSteps.class.isAssignableFrom(c) || c.isInterface()) continue;
+                        if (java.lang.reflect.Modifier.isAbstract(c.getModifiers())) continue;
+                        if (!c.getPackageName().startsWith("ti4.selfhost.engine.kinds")) continue;
+                        try {
+                            found.add((FactionSteps) c.getDeclaredConstructor().newInstance());
+                        } catch (Exception e) {
+                            BotLogger.error("engine: cannot instantiate faction steps " + c.getName(), e);
+                        }
+                    }
+                } catch (Exception e) {
+                    BotLogger.error("engine: faction steps scan failed", e);
+                }
+                found.sort(java.util.Comparator.comparing(x -> x.getClass().getName()));
+                providers = List.copyOf(found);
+                return providers;
+            }
+        }
+
+        @Nullable
+        static Step find(@Nullable String handlerId, @Nullable CaptureContext ctx) {
+            if (handlerId == null) return null;
+            // c9b: an agent target picker's ids carry a "~pick" marker (exhaustAgent_<agent>~pick_<faction>,
+            // exhaustAgent_mentakagent_<faction>~pick): the step is the same, so providers see the id without it.
+            String h = handlerId.replace(ButtonHelperAgents.WHOLE_PROMPT, "");
+            for (FactionSteps p : all()) {
+                try {
+                    Step s = p.step(h, ctx);
+                    if (s != null) return seated(s, ctx);
+                } catch (Exception e) {
+                    if (ctx != null) BotLogger.error("engine: faction steps failed on " + handlerId, e);
+                }
+            }
+            return null;
+        }
+
+        /**
+         * Keleres leaders / abilities are modelled under the drafted faction "keleres"; the seat plays a flavour
+         * (keleresa / keleresm / keleresx), which is the only faction the contract knows (live pbd27: leader.use
+         * kelerescommander carried faction "keleres"). One Keleres seat per game.
+         */
+        static Step seated(Step s, @Nullable CaptureContext ctx) {
+            if (!"keleres".equals(s.faction()) || ctx == null || ctx.game() == null) return s;
+            for (ti4.game.Player p : ctx.game().getRealPlayers()) {
+                String f = p.getFaction();
+                if (f != null && f.startsWith("keleres") && !"keleres".equals(f))
+                    return new Step(s.kind(), s.source(), s.component(), f, s.step(), s.action(), s.optional(), s.fields());
+            }
+            return s;
+        }
+
+        /** Options that never decide the kind of a message: Decline / Done / UNDO / pagination. */
+        static boolean chrome(String h) {
+            return h.startsWith("deleteButtons")
+                    || h.startsWith("ultimateUndo")
+                    || h.startsWith("deleteThis")
+                    || h.equals("deleteMessage")
+                    || h.contains("page");
+        }
+
+        /** The faction-step kind of a whole message, or null (mixed with other areas' options / no step). */
+        @Nullable
+        static String kindOf(List<String> handlerIds) {
+            String kind = null;
+            for (String h : handlerIds) {
+                if (h == null) return null;
+                Step s = find(h, null);
+                if (s == null) {
+                    if (chrome(h)) continue;
+                    return null;
+                }
+                if (kind == null) kind = s.kind();
+            }
+            return kind;
+        }
+
+        /**
+         * Target fallback when the generic resolver found nobody: the seated player who owns the step's faction
+         * component (leader holder, ability owner); else the resolved target unchanged.
+         */
+        @Nullable
+        static Target target(CaptureContext ctx, @Nullable Target resolved) {
+            if (resolved != null && resolved.userId() != null) return resolved;
+            List<String> hs = ctx.handlerIds();
+            Game game = ctx.game();
+            if (hs == null || game == null) return resolved;
+            for (String h : hs) {
+                Step s = find(h, null);
+                if (s == null) continue;
+                Player p = owner(game, s);
+                if (p != null) return new Target(p.getUserID(), p.getFaction(), p.getColor(), "faction_component");
+            }
+            return resolved;
+        }
+
+        @Nullable
+        static Player owner(Game game, Step s) {
+            if ("leader.use".equals(s.kind())) {
+                Player only = null;
+                for (Player p : game.getRealPlayers()) {
+                    if (p.hasLeader(s.component()) || p.getLeader(s.component()).isPresent()) {
+                        if (only != null) return null;
+                        only = p;
+                    }
+                }
+                if (only != null) return only;
+            }
+            switch (s.source()) {
+                case "tech" -> {
+                    for (Player p : game.getRealPlayers()) if (p.hasTech(s.component())) return p;
+                }
+                case "promissory" -> {
+                    for (Player p : game.getRealPlayers())
+                        if (p.getPromissoryNotes().containsKey(s.component())
+                                && !p.getPromissoryNotesOwned().contains(s.component())) return p;
+                }
+                default -> {}
+            }
+            if (s.faction() == null) return null;
+            Player p = game.getPlayerFromColorOrFaction(s.faction());
+            return p != null && p.isRealPlayer() ? p : null;
+        }
+    }
+
+    // ---------------------------------------------------------------- id helpers for providers
+
+    /** Segments after a prefix: "a_b_c" -> [a, b, c] (empty list when nothing follows). */
+    static List<String> args(String handlerId, String prefix) {
+        String rest = handlerId.substring(prefix.length());
+        if (rest.startsWith("_")) rest = rest.substring(1);
+        return rest.isEmpty() ? List.of() : List.of(rest.split("_"));
+    }
+
+    @Nullable
+    static String at(List<String> a, int i) {
+        return i < a.size() && !a.get(i).isEmpty() ? a.get(i) : null;
+    }
+
+    @Nullable
+    static Integer num(@Nullable String s) {
+        if (s == null) return null;
+        try {
+            return Integer.parseInt(s);
+        } catch (NumberFormatException e) {
+            return null;
+        }
+    }
+
+    /** A faction id when the segment names a seated player (faction or colour) in ctx's game; else the raw text. */
+    @Nullable
+    static String faction(@Nullable String seg, @Nullable CaptureContext ctx) {
+        if (seg == null) return null;
+        if (ctx == null || ctx.game() == null) return seg;
+        Player p = ctx.game().getPlayerFromColorOrFaction(seg);
+        return p == null ? seg : p.getFaction();
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/FactionStepsAgentPlanets.java b/src/main/java/ti4/selfhost/engine/kinds/FactionStepsAgentPlanets.java
