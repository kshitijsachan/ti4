@@ -0,0 +1,68 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.selfhost.engine.EngineModels.Decision;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * Politics primary, part 1: give the speaker token to a player (sc_3_assign_speaker_to_&lt;faction&gt;, owner = the
+ * Politics holder; assignSpeaker_&lt;faction&gt; elsewhere). Must happen before the agendas are drawn.
+ * value: {faction, color, self}.
+ */
+public class PoliticsSpeakerKind implements KindSpec {
+    private static final String SC3 = "sc_3_assign_speaker_to_";
+
+    @Override
+    public String kind() {
+        return "strategy_card.politics_speaker";
+    }
+
+    @Override
+    public int priority() {
+        return 90;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return handlerId.startsWith(SC3) || handlerId.startsWith("assignSpeaker_");
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        String faction = handlerId.startsWith(SC3)
+                ? handlerId.substring(SC3.length())
+                : handlerId.substring("assignSpeaker_".length());
+        Player p = ctx.game().getPlayerFromColorOrFaction(faction);
+        Map<String, Object> v = new LinkedHashMap<>();
+        v.put("faction", p == null ? faction : p.getFaction());
+        v.put("color", p == null ? null : p.getColor());
+        v.put("self", p != null && p == ctx.player());
+        return v;
+    }
+
+    @Override
+    public String scope(CaptureContext ctx) {
+        return "player";
+    }
+
+    /** The Politics holder's speaker choice ticks "speaker" on the card's primary checklist. */
+    @Override
+    public void beforeAnswer(Game game, Player answering, Decision decision, String optionId) {
+        String h = StrategyCards.optionHandler(decision, optionId);
+        if (h != null && h.startsWith(SC3)) StrategyCards.recordPrimaryPart(game, answering, "speaker");
+    }
+
+    @Override
+    public String validate(Game game, Player answering, Decision decision, String optionId) {
+        Map<String, Object> v = StrategyCards.optionValue(decision, optionId);
+        if (v == null) return null;
+        Player p = game.getPlayerFromColorOrFaction(String.valueOf(v.get("faction")));
+        if (p == null) return "No such player.";
+        // "Choose a player other than the speaker" (the bot's SpeakerService refuses it too, after the press).
+        if (p.isSpeaker()) return "That player is already the speaker: choose a player other than the speaker.";
+        return null;
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/ProductionPlaceKind.java b/src/main/java/ti4/selfhost/engine/kinds/ProductionPlaceKind.java
new file mode 100644
index 0000000..7c0ec8a
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/ProductionPlaceKind.java
@@ -0,0 +1,84 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.List;
+import java.util.Map;
+import ti4.game.Tile;
+import ti4.helpers.AliasHandler;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * Free unit placements (no production cost): placeOneNDone_&lt;mode&gt;_&lt;unit&gt;_&lt;planet|tile position&gt; built by
+ * Helper.getPlanetPlaceUnitButtons / getTile*PlaceUnitButtons for Mitosis, Parasite, commanders, heroes, action
+ * cards, Construction-like effects (mode "skipbuild" = placed, "dontskip" = produced, "...xxcha", "...orbital"). The
+ * Mitosis status-phase choice (mitosisInf / mitosisMech) is Arborec's faction.ability (FactionStepsArborec). "Done"
+ * (deleteButtons) declines.
+ *
+ * <p>value: {op: "place", unit (async id), count, holder (planet id or "space"), tile (position or null), free} |
+ * {op: "done"}.
+ */
+public class ProductionPlaceKind implements KindSpec {
+
+    @Override
+    public String kind() {
+        return "production.place";
+    }
+
+    @Override
+    public int priority() {
+        return 60;
+    }
+
+    @Override
+    public boolean classifies(List<String> handlerIds) {
+        for (String h : handlerIds) {
+            if (h != null && h.startsWith("placeOneNDone_")) return true;
+        }
+        return false;
+    }
+
+    @Override
+    public boolean matches(String h) {
+        return h.startsWith("placeOneNDone_") || h.equals("deleteButtons");
+    }
+
+    @Override
+    public Map<String, Object> value(String h, CaptureContext ctx) {
+        if (h.equals("deleteButtons")) return SetupKindSupport.map("op", "done");
+        if (!h.startsWith("placeOneNDone_")) return null;
+        String rest = h.substring("placeOneNDone_".length());
+        int a = rest.indexOf('_');
+        if (a < 0) return null;
+        String mode = rest.substring(0, a);
+        rest = rest.substring(a + 1);
+        int b = rest.indexOf('_');
+        if (b < 0) return null;
+        String unitLong = rest.substring(0, b);
+        String where = rest.substring(b + 1);
+        int count = 1;
+        String unitAlias = unitLong;
+        if (unitLong.length() > 1 && Character.isDigit(unitLong.charAt(0))) {
+            count = unitLong.charAt(0) - '0';
+            unitAlias = unitLong.substring(1);
+        }
+        String unit;
+        try {
+            unit = AliasHandler.resolveUnit(unitAlias);
+        } catch (RuntimeException e) {
+            unit = unitAlias;
+        }
+        String holder;
+        String tile;
+        Tile byPos = ctx.game().getTileByPosition(where);
+        if (byPos != null) {
+            tile = where;
+            holder = "space";
+        } else {
+            holder = where;
+            Tile t = ctx.game().getTileFromPlanet(where);
+            tile = t == null ? null : t.getPosition();
+        }
+        return SetupKindSupport.map(
+                "op", "place", "unit", unit, "count", count, "holder", holder, "tile", tile,
+                "free", mode.contains("skipbuild"));
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/ProductionProduceKind.java b/src/main/java/ti4/selfhost/engine/kinds/ProductionProduceKind.java
new file mode 100644
index 0000000..42efba5
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/ProductionProduceKind.java
@@ -0,0 +1,403 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import javax.annotation.Nullable;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.game.Tile;
+import ti4.discord.interactions.buttons.handlers.faction.homebrew.bluereverie.XinTechHandler;
+import ti4.helpers.AliasHandler;
+import ti4.helpers.ButtonHelperModifyUnits;
+import ti4.helpers.DoneRole;
+import ti4.helpers.Helper;
+import ti4.helpers.ProductionCapHelper;
+import ti4.model.UnitModel;
+import ti4.selfhost.engine.DecisionRegistry;
+import ti4.selfhost.engine.EngineModels.Decision;
+import ti4.selfhost.engine.EngineModels.Option;
+import ti4.selfhost.engine.EngineModels.Progress;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * Producing units: the engine's "Produce Units" message (Helper.getPlaceUnitButtons): place_&lt;unit&gt;_&lt;where&gt;
+ * (where = tile position for ships, planet id for ground forces, "space&lt;pos&gt;" for ground forces in space; 2gf/2ff
+ * = two at once), "Done Producing Units" (deleteButtons_&lt;context&gt;_&lt;pos&gt;) and "Reset Build"
+ * (resetProducedThings).
+ *
+ * <p>Answered in ONE action with a payload {units: [{unit, holder?, tile?, count}]} (empty list = build nothing):
+ * checked against the offered options (the production limit is reported, never enforced — like the original), then executed as the place presses + Done. Done opens the payment decision (payment.spend),
+ * returned in the answer's {@code opened}. A capped production (Umbat, Production / Armament Rider, Maximus,
+ * Availyn, Flaah Hyphae — ProductionCapHelper) reports its cap as Done's {@code limit} / progress required.limit and
+ * refuses answers past it (validate for single presses, answerPayload for the whole payload).
+ */
+public class ProductionProduceKind implements KindSpec {
+
+    @Override
+    public String kind() {
+        return "production.produce";
+    }
+
+    @Override
+    public int priority() {
+        return 100;
+    }
+
+    /** Classification: any option of the message claims it (Done buttons never do). */
+    @Override
+    public boolean classifies(List<String> handlerIds) {
+        for (String h : handlerIds) if (h != null && claims(h)) return true;
+        return false;
+    }
+
+    static boolean claims(String h) {
+        return h.startsWith("place_") && !h.startsWith("place_parturitionMonument_");
+    }
+
+    @Override
+    public boolean matches(String h) {
+        return claims(h) || h.equals("resetProducedThings") || isDone(h);
+    }
+
+    static boolean isDone(String h) {
+        // Done Producing Units is deleteButtons_<context>_<pos>~prod (DoneRole.PRODUCE). Untagged ids are prompts
+        // sent before the role was carried in the id: recognised by shape, only typed inside a production message.
+        DoneRole role = DoneRole.of(h);
+        if (role != null) return role == DoneRole.PRODUCE;
+        return h.matches("deleteButtons_[A-Za-z0-9]+_[A-Za-z0-9]+");
+    }
+
+    @Override
+    public Map<String, Object> value(String h, CaptureContext ctx) {
+        Game game = ctx.game();
+        Player player = ctx.player();
+        Map<String, Object> v = new LinkedHashMap<>();
+        if (h.equals("resetProducedThings")) {
+            v.put("action", "reset");
+            return v;
+        }
+        if (h.startsWith("deleteButtons")) {
+            String base = DoneRole.strip(h);
+            String rest = base.startsWith("deleteButtons_") ? base.substring("deleteButtons_".length()) : "";
+            String context = rest;
+            String pos = null;
+            int us = rest.lastIndexOf('_');
+            if (us > 0 && game.getTileByPosition(rest.substring(us + 1)) != null) {
+                context = rest.substring(0, us);
+                pos = rest.substring(us + 1);
+            }
+            v.put("action", "done");
+            v.put("context", context);
+            v.put("tile", pos);
+            if (player != null) {
+                Map<String, Integer> produced = new LinkedHashMap<>();
+                for (Map.Entry<String, Integer> e :
+                        player.getCurrentProducedUnits().entrySet())
+                    produced.merge(e.getKey().split("_")[0], e.getValue(), Integer::sum);
+                v.put("produced", produced);
+                v.put("unitCount", Helper.calculateCostOfProducedUnits(player, game, false));
+                v.put("cost", Helper.calculateCostOfProducedUnits(player, game, true));
+                v.put("productionLimit", productionLimit(game, player, context, pos));
+                v.put("limit", capValue(ProductionCapHelper.get(game, player), pos));
+            }
+            return v;
+        }
+        Placement p = parse(h, game);
+        if (p == null) return null;
+        v.put("unit", p.unit);
+        v.put("count", p.count);
+        v.put("holder", p.holder);
+        v.put("tile", p.tile);
+        Float cost = unitCost(player, p.unit);
+        v.put("cost", cost);
+        // Units of this type left in reinforcements (component limit; null = not limited): none left is refused.
+        v.put("remaining", ti4.helpers.UnitComponentLimit.remaining(game, player, p.unit));
+        // Fleet pool room in the tile for a non-fighter ship (null: not a ship, or no limit known): the web warns when
+        // the build goes over it (allowed: the excess is removed afterwards; playtest 8 pbd469 got no warning).
+        v.put("fleetRoom", fleetRoom(game, player, p.unit, p.tile));
+        return v;
+    }
+
+    @javax.annotation.Nullable
+    static Integer fleetRoom(Game game, Player player, String unit, String tilePos) {
+        if (game == null || player == null || tilePos == null || "ff".equals(unit)) return null;
+        try {
+            ti4.model.UnitModel m = player.getUnitFromAsyncID(unit);
+            if (m == null || !m.getIsShip()) return null;
+            ti4.game.Tile t = game.getTileByPosition(tilePos);
+            if (t == null) return null;
+            ti4.helpers.ButtonHelper.FleetReport r = ti4.helpers.ButtonHelper.fleetReport(player, game, t);
+            return r.fleetLimit() <= 0 ? null : r.fleetLimit() - r.fleetUsed();
+        } catch (Exception e) {
+            return null;
+        }
+    }
+
+    record Placement(String unit, int count, String holder, String tile) {}
+
+    /**
+     * The cap of a capped production (Umbat, riders, Maximus, Availyn, Flaah Hyphae) as {maxUnits, maxEachCost,
+     * maxTotalCost, onlyUnit, source, label}; null when this production has none (or the cap is another system's).
+     */
+    @Nullable
+    static Map<String, Object> capValue(@Nullable ProductionCapHelper.Cap cap, @Nullable String pos) {
+        if (cap == null || (pos != null && !pos.equals(cap.tile()))) return null;
+        Map<String, Object> m = new LinkedHashMap<>();
+        m.put("maxUnits", cap.maxUnits());
+        m.put("maxEachCost", cap.maxEachCost());
+        m.put("maxTotalCost", cap.maxTotalCost());
+        m.put("onlyUnit", cap.onlyUnit());
+        m.put("source", cap.source());
+        m.put("label", cap.label());
+        return m;
+    }
+
+    /** The cap that applies to this decision's production (its Done names the system), or null. */
+    @Nullable
+    private static ProductionCapHelper.Cap capFor(Game game, Player player, Decision d) {
+        ProductionCapHelper.Cap cap = ProductionCapHelper.get(game, player);
+        if (cap == null) return null;
+        Option done = PaymentSupport.firstWith(d, "action", "done");
+        Object tile = done == null || done.value() == null ? null : done.value().get("tile");
+        return tile != null && !cap.tile().equals(String.valueOf(tile)) ? null : cap;
+    }
+
+    /** A single place_ press past a capped production's cap is refused, like the bot's own handler does. */
+    @Override
+    public String validate(Game game, Player answering, Decision decision, String optionId) {
+        if (game == null || answering == null || decision == null) return null;
+        ProductionCapHelper.Cap cap = capFor(game, answering, decision);
+        for (Option o : decision.options()) {
+            if (!o.id().equals(optionId)) continue;
+            Map<String, Object> v = o.value();
+            if (v == null || v.get("unit") == null) return null;
+            // Rules audit (factions): Mitosis — Arborec docks cannot produce infantry.
+            String mitosis = ti4.helpers.MitosisProductionRule.refusal(
+                    game,
+                    answering,
+                    v.get("tile") == null ? null : String.valueOf(v.get("tile")),
+                    String.valueOf(v.get("unit")),
+                    PaymentSupport.intOf(v.get("count"), 1));
+            if (mitosis != null) return mitosis;
+            String limit = ti4.helpers.UnitComponentLimit.refusal(
+                    game, answering, String.valueOf(v.get("unit")), PaymentSupport.intOf(v.get("count"), 1));
+            if (limit != null) return limit;
+            if (cap == null) return null;
+            return ProductionCapHelper.refusal(
+                    game,
+                    answering,
+                    v.get("tile") == null ? null : String.valueOf(v.get("tile")),
+                    String.valueOf(v.get("unit")),
+                    PaymentSupport.intOf(v.get("count"), 1));
+        }
+        return null;
+    }
+
+    /** place_&lt;unitLong&gt;_&lt;where&gt; → async unit id, count, holder ("space" or planet id), tile position. */
+    @Nullable
+    static Placement parse(String h, Game game) {
+        String rest = h.substring(h.indexOf("place_") + "place_".length());
+        if (rest.endsWith(ButtonHelperModifyUnits.CONSTRUCTION_PLACEMENT)) {
+            rest = rest.substring(0, rest.length() - ButtonHelperModifyUnits.CONSTRUCTION_PLACEMENT.length());
+        }
+        int us = rest.indexOf('_');
+        if (us <= 0) return null;
+        String unitLong = rest.substring(0, us);
+        String where = rest.substring(us + 1);
+        int count = unitLong.startsWith("2") ? 2 : 1;
+        String unit = AliasHandler.resolveUnit(unitLong.replace("2", ""));
+        if (where.startsWith("space")) return new Placement(unit, count, "space", where.substring("space".length()));
+        if (game.getTileByPosition(where) != null) return new Placement(unit, count, "space", where);
+        Tile t = game.getTileFromPlanet(where);
+        return new Placement(unit, count, where, t == null ? null : t.getPosition());
+    }
+
+    @Nullable
+    private static Float unitCost(@Nullable Player player, String asyncId) {
+        if (player == null) return null;
+        try {
+            List<UnitModel> models = player.getUnitsByAsyncID(asyncId);
+            return models.isEmpty() ? null : models.getFirst().getCost();
+        } catch (Exception e) {
+            return null;
+        }
+    }
+
+    /** The PRODUCTION limit the engine applies in this context; null where it does not know one. */
+    @Nullable
+    static Integer productionLimit(Game game, Player player, String context, @Nullable String pos) {
+        if ("solBtBuild".equalsIgnoreCase(context)) { // Bellum Gloriosum
+            for (String s : player.getSpentThingsThisWindow()) {
+                String[] a = s.split("_");
+                if (a.length > 2 && "solBtBuild".equalsIgnoreCase(a[0]) && a[2].matches("\\d+"))
+                    return Integer.parseInt(a[2]);
+            }
+            return null;
+        }
+        if (pos == null) return null;
+        Tile tile = game.getTileByPosition(pos);
+        if (tile == null) return null;
+        if ("tacticalAction".equals(context)) return tacticalLimit(game, player, tile);
+        if ("warfare".equals(context)) return Helper.getProductionValue(player, game, tile, true);
+        return null;
+    }
+
+    /**
+     * The PRODUCTION limit Helper.buildProducedUnitsMessage shows for a build in the active system: the larger of the
+     * system's PRODUCTION and Veiled Networking Star, +4 War Machine, -liquidation, +2 Vuil'raith commander; none for
+     * the factions whose units produce anywhere (Arborec, Latani, Deepwrought mech).
+     */
+    @Nullable
+    static Integer tacticalLimit(Game game, Player player, Tile tile) {
+        if (player.hasUnit("arborec_mech")
+                || player.hasUnit("arborec_infantry")
+                || player.hasUnit("tf-lataniwarrior")
+                || player.hasUnit("deepwrought_mech")
+                || player.hasUnit("arborec_infantry2")) return null;
+        int limit = Math.max(
+                Helper.getProductionValue(player, game, tile, false),
+                XinTechHandler.getVeiledNetworkingStarProductionValue(player, game, tile));
+        if (player.getSpentThingsThisWindow().contains("warmachine")) limit += 4;
+        for (String spent : player.getSpentThingsThisWindow())
+            if (spent.startsWith("liquidation") && !spent.replace("liquidation", "").isEmpty())
+                limit -= Integer.parseInt(spent.replace("liquidation", ""));
+        if (game.playerHasLeaderUnlockedOrAlliance(player, "cabalcommander")) limit += 2;
+        return limit;
+    }
+
+    @Override
+    public boolean dynamic() {
+        return true;
+    }
+
+    /**
+     * flow "production": accumulated = units produced so far in this window ({unit: count}, unitCount, cost) from the
+     * player's produced-units record; required = {productionLimit, context, tile}. canCommit always (build nothing is
+     * legal).
+     */
+    @Override
+    public Progress progress(CaptureContext ctx) {
+        Player player = ctx.player();
+        if (player == null) return null;
+        List<String> handlers = ctx.handlerIds();
+        if (handlers == null) {
+            String id = DecisionRegistry.decisionIdForMessage(ctx.messageId());
+            Decision d = id == null ? null : DecisionRegistry.get(id);
+            handlers = d == null
+                    ? List.of()
+                    : d.options().stream().map(Option::handler).toList();
+        }
+        String doneId = null;
+        for (String h : handlers) if (h != null && h.startsWith("deleteButtons_") && matches(h)) doneId = h;
+        Map<String, Object> done = doneId == null ? Map.of() : value(doneId, ctx);
+        Map<String, Object> acc = new LinkedHashMap<>();
+        acc.put("produced", done.get("produced"));
+        acc.put("unitCount", done.get("unitCount"));
+        acc.put("cost", done.get("cost"));
+        Map<String, Object> req = new LinkedHashMap<>();
+        req.put("productionLimit", done.get("productionLimit"));
+        req.put("limit", done.get("limit"));
+        req.put("context", done.get("context"));
+        req.put("tile", done.get("tile"));
+        return new Progress("production", "select_units", acc, req, true);
+    }
+
+    // ------------------------------------------------------------------ atomic production
+
+    @Override
+    public boolean acceptsPayload() {
+        return true;
+    }
+
+    @Override
+    public String answerPayload(PayloadAnswer a, Map<String, Object> payload) throws Exception {
+        Decision d = a.decision();
+        Game game = a.game();
+        Player player = a.player();
+        if (d == null || game == null || player == null) return "That production is no longer open.";
+        Option done = PaymentSupport.firstWith(d, "action", "done");
+        if (done == null) return "This production has no Done button.";
+
+        List<String> presses = new ArrayList<>();
+        ProductionCapHelper.Cap cap = capFor(game, player, d);
+        int capUnits = cap == null ? 0 : ProductionCapHelper.producedCount(player);
+        float capCost = cap == null ? 0 : ProductionCapHelper.producedCost(player);
+        String mitosisTile = ti4.helpers.MitosisProductionRule.limitedTile(game, player);
+        int mitosisInf = mitosisTile == null ? 0 : ti4.helpers.MitosisProductionRule.infantryProduced(player, mitosisTile);
+        Map<String, Integer> perUnit = new LinkedHashMap<>();
+        for (Object o : PaymentSupport.listOf(payload.get("units"))) {
+            if (!(o instanceof Map<?, ?> req)) return "Bad unit entry.";
+            String unit = AliasHandler.resolveUnit(String.valueOf(req.get("unit")));
+            Object holder = req.get("holder");
+            Object tile = req.get("tile");
+            int count = PaymentSupport.intOf(req.get("count"), 1);
+            if (count < 1 || count > 20) return "Bad count for " + unit + ".";
+            // Component limit over the whole payload (2 dreadnoughts with 1 left is refused before anything is placed).
+            int wanted = perUnit.merge(unit, count, Integer::sum);
+            String limit = ti4.helpers.UnitComponentLimit.refusal(game, player, unit, wanted);
+            if (limit != null) return limit;
+            if (mitosisTile != null && "gf".equals(unit)) {
+                String where = tile != null
+                        ? String.valueOf(tile)
+                        : holder == null ? mitosisTile : ProductionCapHelper.tileOf(game, String.valueOf(holder));
+                String why = ti4.helpers.MitosisProductionRule.refusal(game, player, where, unit, count, mitosisInf);
+                if (why != null) return why;
+                if (mitosisTile.equals(where)) mitosisInf += count;
+            }
+            if (cap != null) {
+                // Capped production (Umbat: up to 2 units costing 4 or less each, ...): the whole payload must fit.
+                String where = tile != null
+                        ? String.valueOf(tile)
+                        : holder == null ? cap.tile() : ProductionCapHelper.tileOf(game, String.valueOf(holder));
+                String why = ProductionCapHelper.refusal(cap, player, where, unit, count, capUnits, capCost);
+                if (why != null) return why;
+                capUnits += count;
+                Float each = ProductionCapHelper.unitCost(player, unit);
+                if (each != null) capCost += each * count;
+            }
+            Option one = find(d, unit, 1, holder, tile);
+            Option two = find(d, unit, 2, holder, tile);
+            int left = count;
+            while (left > 0) {
+                if (left >= 2 && two != null) {
+                    presses.add(two.id());
+                    left -= 2;
+                } else if (one != null) {
+                    presses.add(one.id());
+                    left -= 1;
+                } else {
+                    return "Cannot produce " + (left == count ? "" : "that many ") + unit
+                            + (holder == null ? "" : " on " + holder) + " here.";
+                }
+            }
+        }
+        // A capped production's cap (above) IS a rule the bot's place_ handler enforces too. The original code never
+        // refuses a build over the PRODUCTION limit (Helper.buildProducedUnitsMessage only
+        // warns: abilities, cards and homebrew raise it in ways the bot does not track), so neither does the engine;
+        // productionLimit / unitCount in the Done option tell a client where it stands.
+
+        for (String id : presses) a.press(id);
+        Player after = a.player();
+        Game g = a.game();
+        Decision latest = a.decision();
+        if (after != null && g != null && latest != null && !presses.isEmpty())
+            PaymentSupport.syncContent(latest, Helper.buildProducedUnitsMessage(after, g));
+        a.press(done.id());
+        return null;
+    }
+
+    @Nullable
+    private static Option find(Decision d, String unit, int count, Object holder, Object tile) {
+        for (Option o : d.options()) {
+            Map<String, Object> v = o.value();
+            if (v == null || o.disabled() || v.get("unit") == null) continue;
+            if (!unit.equals(v.get("unit")) || PaymentSupport.intOf(v.get("count"), 1) != count) continue;
+            if (holder != null && !String.valueOf(holder).equals(v.get("holder"))) continue;
+            if (tile != null && !String.valueOf(tile).equals(v.get("tile"))) continue;
+            return o;
+        }
+        return null;
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/PromissoryNotePlayKind.java b/src/main/java/ti4/selfhost/engine/kinds/PromissoryNotePlayKind.java
