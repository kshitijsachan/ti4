+package ti4.selfhost.engine.kinds;
+
+import javax.annotation.Nullable;
+import ti4.game.Game;
+import ti4.game.Player;
+
+/**
+ * te.breakthrough — using a Thunder's Edge breakthrough through its prompts (component actions and reactions). Value
+ * {breakthrough (id), faction, step (handler prefix), action (use | target | skip), optional, + fields: tile, to, dir,
+ * planet, target (faction), amount, tech, card, choice, holder, args}.
+ *
+ * <p>Void Tether (empyreanbt: addVoidTetherStep1 → addVoidTetherStep2_/3_, newVoidTether_, placeVoidTether_&lt;pos&gt;_
+ * &lt;dir&gt;, moveVoidTether_&lt;pos&gt;[_&lt;tile&gt;_&lt;dir&gt;], removeVoidTether_), Deorbit Barrage (saarbt:
+ * deorbitBarrageTarget_&lt;faction&gt; → deorbitBarragePlanet_&lt;planet&gt; → deorbitBarrageResource_&lt;planet&gt;_&lt;n&gt;),
+ * Thunder's Paradox (nomadbt: startThundersParadox → useThundersParadox_step2_&lt;leader&gt; → _step3_&lt;faction&gt; →
+ * _step4_&lt;faction&gt;_&lt;leader&gt;), The Sowing (firmamentbt: theSowingAddTg_&lt;n&gt;), The Reaping (obsidianbt:
+ * theReapingAddTg), The Icon (bastionbt: useTheIcon → exhaustTheIcon_&lt;pos&gt;), Data Skimmer (ralnelbt:
+ * dataSkimmer_…, discardDataSkimmer), Mindsieve (naalubt: mindsieveFollow_&lt;sc&gt;_&lt;pn&gt;), Stone Embrace
+ * (stoneEmbraceFollow_&lt;sc&gt;_&lt;planet&gt;), Al'Raith Ix Ianovar (cabalbt: beginCabalBreakthroughMove), Vaults of the
+ * Heir (mahactbt: purgeTechVaults_&lt;tech&gt;), Fealty Uplink (l1z1xbt: fealtyUplink_&lt;planet&gt;), Psychospore
+ * (arborecbt: resolvePsychospore_), Stellar Genesis (muaatbt: placeAvernus_, moveAvernus_&lt;pos&gt;), Valefar
+ * Assimilator Z (nekrobt: valefarZ_&lt;faction&gt;, addNekroToken_ / removeNekroToken_&lt;faction&gt;), Deepgloom
+ * Executable (yssarilbt: startYssarilbt and its access panel), Eidolon Maximum (checkEidolonMaximum,
+ * activateEidolonMaximum_&lt;pos&gt;_&lt;holder&gt;), Slumberstate Computing (titansbt:
+ * addSleeperViaBt_&lt;faction&gt;), Executive Order (useExecutiveOrder_top|bottom). Visionaria Select and
+ * the expedition / fracture prompts are G10's te.* kinds.
+ */
+public class TeBreakthroughKind extends TeTableKind {
+
+    public TeBreakthroughKind() {
+        String bt = "breakthrough";
+        ability("addVoidTetherStep1", bt, "empyreanbt", "empyrean", "use", true);
+        ability("addVoidTetherStep2_", bt, "empyreanbt", "empyrean", "target", false, "tile", "dir");
+        ability("addVoidTetherStep3_", bt, "empyreanbt", "empyrean", "target", false, "tile");
+        ability("newVoidTether_", bt, "empyreanbt", "empyrean", "target", false, "tile");
+        ability("placeVoidTether_", bt, "empyreanbt", "empyrean", "target", false, "tile", "dir");
+        ability("moveVoidTether_", bt, "empyreanbt", "empyrean", "target", false, "tile", "to", "dir");
+        ability("removeVoidTether_", bt, "empyreanbt", "empyrean", "target", false, "tile", "dir");
+
+        ability("deorbitBarrageTarget_", bt, "saarbt", "saar", "target", false, "target");
+        ability("deorbitBarragePlanet_", bt, "saarbt", "saar", "target", false, "planet");
+        ability("deorbitBarrageResource_", bt, "saarbt", "saar", "target", false, "planet", "amount");
+
+        ability("startThundersParadox", bt, "nomadbt", "nomad", "use", true);
+        ability("useThundersParadox_step2_", bt, "nomadbt", "nomad", "target", false, "choice*");
+        ability("useThundersParadox_step3_", bt, "nomadbt", "nomad", "target", false, "target");
+        ability("useThundersParadox_step4_", bt, "nomadbt", "nomad", "target", false, "target", "choice*");
+
+        ability("theSowingAddTg_", bt, "firmamentbt", "firmament", "target", true, "amount");
+        ability("theReapingAddTg", bt, "obsidianbt", "obsidian", "use", true);
+        ability("useTheIcon", bt, "bastionbt", "bastion", "use", true);
+        ability("exhaustTheIcon_", bt, "bastionbt", "bastion", "target", false, "tile");
+        ability("dataSkimmer_", bt, "ralnelbt", "ralnel", "use", true, "choice*");
+        ability("discardDataSkimmer", bt, "ralnelbt", "ralnel", "use", true);
+
+        ability("mindsieveFollow_", bt, "naalubt", "naalu", "use", true, "choice", "card");
+        ability("stoneEmbraceFollow_", bt, "stoneembrace", null, "use", true, "choice", "planet");
+        ability("beginCabalBreakthroughMove", bt, "cabalbt", "cabal", "use", true);
+        ability("purgeTechVaults_", bt, "mahactbt", "mahact", "target", false, "tech");
+        ability("fealtyUplink_", bt, "l1z1xbt", "l1z1x", "target", false, "planet");
+        ability("resolvePsychospore_", bt, "arborecbt", "arborec", "target", false, "choice*");
+        ability("placeAvernus_", bt, "muaatbt", "muaat", "target", false, "tile");
+        ability("moveAvernus_", bt, "muaatbt", "muaat", "target", false, "tile");
+        ability("valefarZ_", bt, "nekrobt", "nekro", "use", true, "target");
+        ability("addNekroToken_", bt, "nekrobt", "nekro", "target", false, "target");
+        ability("removeNekroToken_", bt, "nekrobt", "nekro", "target", false, "target");
+
+        ability("startYssarilbt", bt, "yssarilbt", "yssaril", "use", true);
+        ability("yssarilbtToggleDebt", bt, "yssarilbt", "yssaril", "use", true);
+        ability("yssarilbtIndividualControl", bt, "yssarilbt", "yssaril", "use", true);
+        ability("yssarilbtRevokeAll", bt, "yssarilbt", "yssaril", "use", true);
+        ability("yssarilbtStep2_", bt, "yssarilbt", "yssaril", "target", true, "choice", "target");
+
+        ability("selectPlayerToSleeper", bt, "titansbt", "titans", "use", true);
+        ability("addSleeperViaBt_", bt, "titansbt", "titans", "target", false, "target");
+
+        ability("checkEidolonMaximum", bt, "eidolonmaximum", null, "use", true);
+        ability("activateEidolonMaximum_", bt, "eidolonmaximum", null, "use", true, "tile", "holder");
+        ability("useExecutiveOrder_", bt, "executiveorder", null, "target", false, "choice");
+    }
+
+    @Override
+    public String kind() {
+        return "te.breakthrough";
+    }
+
+    @Override
+    protected String idKey() {
+        return "breakthrough";
+    }
+
+    /** The holder of the breakthrough (copied / stolen ones included), else its faction's player. */
+    @Override
+    @Nullable
+    protected Player owner(Game game, TeStep s) {
+        for (Player p : game.getRealPlayers()) if (p.hasBreakthrough(s.component())) return p;
+        return super.owner(game, s);
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/TeExpeditionKind.java b/src/main/java/ti4/selfhost/engine/kinds/TeExpeditionKind.java
new file mode 100644
index 0000000..a528017
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/TeExpeditionKind.java
@@ -0,0 +1,78 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.selfhost.engine.EngineModels.Decision;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * Thunder's Edge expeditions (Expeditions.getRemainingExpeditionButtons, opened from "Do an Expedition (N
+ * Remaining)" on the end-of-turn / pass menus): FFCC_&lt;f&gt;_TEexpedition_&lt;key&gt; for each open expedition plus
+ * "Delete These Buttons". Completing one marks it with the faction, unlocks the player's breakthroughs, and the
+ * last one lets its completer place Thunder's Edge.
+ *
+ * <p>Keys and costs: techSkip (exhaust 1 technology specialty planet), tradeGoods (spend 3 trade goods; deducted at
+ * once when the player has 3), fiveRes / fiveInf (spend 5 resources / influence via the payment prompt), secret
+ * (discard 1 unscored secret objective), actionCards (discard 2 action cards). value.affordable is the engine's view
+ * at capture time (ready planets + trade goods, cards in hand).
+ */
+public class TeExpeditionKind implements KindSpec {
+
+    @Override
+    public String kind() {
+        return "te.expedition";
+    }
+
+    @Override
+    public int priority() {
+        return 100;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return handlerId.startsWith("TEexpedition_");
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        if (!matches(handlerId)) return null;
+        String key = handlerId.substring("TEexpedition_".length());
+        Map<String, Object> v = new LinkedHashMap<>();
+        v.put("expedition", key);
+        v.put("affordable", affordable(ctx.game(), ctx.player(), key));
+        v.put("unlocksBreakthrough", ctx.player() != null
+                && ctx.player().getBreakthroughIDs().stream().anyMatch(bt -> !ctx.player().isBreakthroughUnlocked(bt)));
+        v.put("remaining", ctx.game().getExpeditions().getRemainingExpeditionCount());
+        return v;
+    }
+
+    static boolean affordable(Game game, Player p, String key) {
+        if (p == null) return false;
+        return switch (key) {
+            case "techSkip" -> TeKinds.hasReadySkipPlanet(game, p);
+            case "tradeGoods" -> p.getTg() >= 3;
+            case "fiveRes" -> TeKinds.readyPlanetValue(game, p, true) + p.getTg() >= 5;
+            case "fiveInf" -> TeKinds.readyPlanetValue(game, p, false) + p.getTg() >= 5;
+            case "secret" -> p.getSecrets().size() > 0;
+            case "actionCards" -> p.getActionCards().size() >= 2;
+            default -> false;
+        };
+    }
+
+    @Override
+    public String scope(CaptureContext ctx) {
+        return "player";
+    }
+
+    @Override
+    public String validate(Game game, Player answering, Decision decision, String optionId) {
+        String err = TeKinds.ownerLockError(answering, optionId);
+        if (err != null) return err;
+        String key = optionId.replaceFirst("^.*TEexpedition_", "");
+        if (optionId.contains("TEexpedition_") && game.getExpeditions().getExpeditionFactions().get(key) != null)
+            return "That expedition is already completed.";
+        return null;
+    }
+}
