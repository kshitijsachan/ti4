+package ti4.selfhost.engine.kinds;
+
+import java.util.List;
+import java.util.Map;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * "Automate the entire ground combat" (StartCombatService, combat thread): automateGroundCombat_&lt;p1&gt;_&lt;p2&gt;_
+ * &lt;planet&gt;_unconfirmed, one per contested planet, on a message of its own (no owner: either combatant votes), and the
+ * opponent's confirmation automateGroundCombat_…_confirmed (owner-prefixed to the opponent, one button). Pressing the
+ * vote asks the opponent; pressing the confirmation (or a vote against a dummy) resolves the whole ground combat.
+ * On the combat controls message the same id is a combat.round option (that kind outranks this one).
+ *
+ * <p>value: {planet, factions: [p1, p2], confirmed}. Vote prompt: table scope, no window (optional; nobody is on the
+ * hook). Confirmation: the opponent's (owner prefix).
+ */
+public class CombatAutomateKind implements KindSpec {
+    private static final Pattern ID = Pattern.compile("^automateGroundCombat_([^_]+)_([^_]+)_(.+)_(confirmed|unconfirmed)$");
+
+    @Override
+    public String kind() {
+        return "combat.automate";
+    }
+
+    @Override
+    public int priority() {
+        return 85;
+    }
+
+    @Override
+    public boolean classifies(List<String> handlerIds) {
+        for (String h : handlerIds) if (h != null && h.startsWith("automateGroundCombat_")) return true;
+        return false;
+    }
+
+    @Override
+    public boolean matches(String h) {
+        return ID.matcher(h).matches();
+    }
+
+    @Override
+    public Map<String, Object> value(String h, CaptureContext ctx) {
+        Matcher m = ID.matcher(h);
+        if (!m.matches()) return null;
+        return SetupKindSupport.map(
+                "planet", m.group(3),
+                "factions", List.of(m.group(1), m.group(2)),
+                "confirmed", "confirmed".equals(m.group(4)));
+    }
+
+    @Override
+    public String scope(CaptureContext ctx) {
+        return ctx.target() == null || ctx.target().userId() == null ? "table" : "player";
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/CombatBombardKind.java b/src/main/java/ti4/selfhost/engine/kinds/CombatBombardKind.java
new file mode 100644
index 0000000..4aebd9d
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/CombatBombardKind.java
@@ -0,0 +1,116 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.helpers.BombardmentAssignment;
+import ti4.selfhost.engine.EngineModels.Progress;
+import ti4.selfhost.engine.EngineModels.Target;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * BOMBARDMENT target step (BombardmentButtonHandler): after "bombardConfirm_" the bombarding player assigns each
+ * bombardment unit (and Plasma Scoring / Argent commander die) to a planet, edited in place, then "Done Assigning"
+ * (combatRoll_&lt;pos&gt;_space_bombardment) rolls. The engine already auto-assigned every unit to a planet when the
+ * prompt opened, so "Done" is always a legal answer. Claims the message ahead of combat.round (which would make the
+ * roll a table window).
+ *
+ * <p>value: assign / unassign {op, source (unit async id | plasmascoring | argentcommander), planet, galvanized,
+ * type: UNIT|TECH|LEADER}; the roll {op: "done", tile}. progress (flow "combat.bombard"): accumulated.assigned =
+ * [{source, planet, galvanized, type}] from the stored value {@code assignedBombardment<faction>}.
+ */
+public class CombatBombardKind implements KindSpec {
+
+    @Override
+    public String kind() {
+        return "combat.bombard";
+    }
+
+    @Override
+    public int priority() {
+        return 95;
+    }
+
+    @Override
+    public boolean classifies(List<String> handlerIds) {
+        for (String h : handlerIds) {
+            if (h != null && (h.startsWith("assignBombardUnit_") || h.startsWith("unassignBombardUnit_"))) return true;
+        }
+        return false;
+    }
+
+    @Override
+    public boolean matches(String h) {
+        return h.startsWith("assignBombardUnit_")
+                || h.startsWith("unassignBombardUnit_")
+                || (h.startsWith("combatRoll_") && h.contains("_bombardment"));
+    }
+
+    @Override
+    public Map<String, Object> value(String h, CaptureContext ctx) {
+        if (h.startsWith("combatRoll_")) {
+            String[] p = h.split("_");
+            return SetupKindSupport.map("op", "done", "tile", p.length > 1 ? p[1] : null);
+        }
+        boolean assign = h.startsWith("assignBombardUnit_");
+        try {
+            BombardmentAssignment a = BombardmentAssignment.decode(h.substring(h.indexOf('_') + 1));
+            Map<String, Object> v = describe(a);
+            v.put("op", assign ? "assign" : "unassign");
+            return v;
+        } catch (RuntimeException e) {
+            return null;
+        }
+    }
+
+    private static Map<String, Object> describe(BombardmentAssignment a) {
+        Map<String, Object> v = new LinkedHashMap<>();
+        v.put("source", a.sourceId());
+        v.put("planet", a.planet());
+        v.put("galvanized", a.galvanized());
+        v.put("type", a.type().name());
+        return v;
+    }
+
+    /** The bombarding player: the active player (bombardment happens in their tactical action). */
+    @Override
+    public Target target(CaptureContext ctx, Target resolved) {
+        Player p = bombarder(ctx.game(), ctx.player());
+        return p == null ? null : new Target(p.getUserID(), p.getFaction(), p.getColor(), "active_player");
+    }
+
+    private static Player bombarder(Game game, Player fallback) {
+        Player active = game.getActivePlayer();
+        return active != null ? active : fallback;
+    }
+
+    @Override
+    public boolean dynamic() {
+        return true;
+    }
+
+    @Override
+    public Progress progress(CaptureContext ctx) {
+        Player p = bombarder(ctx.game(), ctx.player());
+        if (p == null) return null;
+        List<Map<String, Object>> assigned = new ArrayList<>();
+        String json = ctx.game().getStoredValue("assignedBombardment" + p.getFaction());
+        if (json != null && !json.isBlank()) {
+            try {
+                List<BombardmentAssignment> list = new tools.jackson.databind.ObjectMapper()
+                        .readValue(json, new tools.jackson.core.type.TypeReference<List<BombardmentAssignment>>() {});
+                for (BombardmentAssignment a : list) assigned.add(describe(a));
+            } catch (RuntimeException ignored) {
+                // unreadable stored value: no progress detail
+            }
+        }
+        Map<String, Object> acc = new LinkedHashMap<>();
+        acc.put("assigned", assigned);
+        Map<String, Object> req = new LinkedHashMap<>();
+        req.put("tile", ctx.game().getActiveSystem());
+        return new Progress("combat.bombard", "assign", acc, req, true);
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/CombatHitsKind.java b/src/main/java/ti4/selfhost/engine/kinds/CombatHitsKind.java
new file mode 100644
index 0000000..afee157
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/CombatHitsKind.java
@@ -0,0 +1,155 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.List;
+import javax.annotation.Nullable;
+import ti4.game.Game;
+import java.util.Map;
+import ti4.game.Player;
+import ti4.game.Tile;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * Hits a player must assign after a roll: the prompt with autoAssign{Space,Ground,AFB,SpaceCannonOffence}Hits_ (owner =
+ * the player hit), "Manually Assign Hits" (getDamageButtons_), "Cancel a Hit" (cancel*Hits_, an ability) and, on
+ * combat-round prompts, the next round's roll. The auto option's value carries the hits owed and the units they may
+ * land on (count, damaged, can sustain), so a client can plan an assignment and send it in one call
+ * (CombatPlanController) instead of pressing unit buttons one by one.
+ */
+public class CombatHitsKind implements KindSpec {
+
+    @Override
+    public String kind() {
+        return "combat.hits";
+    }
+
+    @Override
+    public int priority() {
+        return 100;
+    }
+
+    @Override
+    public boolean classifies(List<String> handlerIds) {
+        for (String h : handlerIds) if (h != null && h.startsWith("autoAssign") && h.contains("Hits_")) return true;
+        // BOMBARDMENT hits (CombatRollService): the defender's prompt has only "Assign Hits" (pbd161: untyped, the
+        // hit was never assigned before the planet's infantry died in the ground combat).
+        for (String h : handlerIds) if (h != null && isBombardmentAssign(h)) return true;
+        return false;
+    }
+
+    static boolean isBombardmentAssign(String h) {
+        return h.startsWith("getDamageButtons_") && h.endsWith("_bombardment");
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return (handlerId.startsWith("autoAssign") && handlerId.contains("Hits_"))
+                || (handlerId.startsWith("cancel") && handlerId.contains("Hits_"))
+                || handlerId.startsWith("combatRoll_")
+                || handlerId.startsWith("getDamageButtons_");
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        Map<String, Object> v = CombatSupport.value(handlerId, ctx.game());
+        if (v != null && isBombardmentAssign(handlerId)) return bombardment(v, ctx);
+        if (v == null || !"auto".equals(v.get("action"))) return v;
+        Player p = ctx.player();
+        Object pos = v.get("tile");
+        Tile tile = pos == null ? null : ctx.game().getTileByPosition(String.valueOf(pos));
+        v.put(
+                "units",
+                CombatSupport.hittableUnits(
+                        ctx.game(), p, tile, (String) v.get("holder"), (String) v.get("source")));
+        // Non-Euclidean Shielding: each SUSTAIN DAMAGE cancels 2 hits.
+        int cancels = p != null && p.hasTech("nes") ? 2 : 1;
+        v.put("sustainCancels", cancels);
+        CombatSupport.noteOwed(
+                ctx.game(),
+                p,
+                (String) pos,
+                (String) v.get("holder"),
+                (String) v.get("source"),
+                (Integer) v.get("hits"),
+                cancels);
+        return v;
+    }
+
+    /**
+     * The BOMBARDMENT "Assign Hits" option: hits owed (the newest bombardment roll of this activation at that tile),
+     * the bombarded planet (bombardmentTarget of the active player) and the units there that may take them, so a client
+     * can answer with a combat plan (CombatPlanService) like any other hits prompt.
+     */
+    private static Map<String, Object> bombardment(Map<String, Object> v, CaptureContext ctx) {
+        Game game = ctx.game();
+        Player p = ctx.player();
+        String pos = (String) v.get("tile");
+        Tile tile = pos == null ? null : game.getTileByPosition(pos);
+        Integer hits = pos == null ? null : CombatSupport.bombardmentHits(game, pos);
+        String planet = bombardedPlanet(game, tile);
+        v.put("source", "ground");
+        v.put("holder", planet);
+        v.put("hits", hits);
+        if (p != null && tile != null && planet != null) {
+            v.put("units", CombatSupport.hittableUnits(game, p, tile, planet, "ground"));
+            int cancels = p.hasTech("nes") ? 2 : 1;
+            v.put("sustainCancels", cancels);
+            if (hits != null) CombatSupport.noteOwed(game, p, pos, planet, "ground", hits, cancels);
+        }
+        return v;
+    }
+
+    @Nullable
+    static String bombardedPlanet(Game game, @Nullable Tile tile) {
+        if (tile == null) return null;
+        Player active = game.getActivePlayer();
+        String planet = active == null ? "" : game.getStoredValue("bombardmentTarget" + active.getFaction());
+        if (planet != null && !planet.isBlank() && tile.getUnitHolders().containsKey(planet)) return planet;
+        for (var e : game.getStoredValueMap().entrySet()) {
+            if (!e.getKey().startsWith("bombardmentTarget")) continue;
+            if (tile.getUnitHolders().containsKey(e.getValue())) return e.getValue();
+        }
+        return null;
+    }
+
+    @Override
+    public boolean dynamic() {
+        return true;
+    }
+
+    /**
+     * A BOMBARDMENT hits prompt is moot once its planet has no ground forces of the player hit, the ground combat there
+     * has begun, or another system is active (the original message is never removed).
+     */
+    @Override
+    public boolean obsolete(CaptureContext ctx) {
+        List<String> ids = ctx.handlerIds();
+        if (ids == null && ctx.messageId() != null) {
+            String id = ti4.selfhost.engine.DecisionRegistry.decisionIdForMessage(ctx.messageId());
+            ti4.selfhost.engine.EngineModels.Decision d = id == null ? null : ti4.selfhost.engine.DecisionRegistry.get(id);
+            if (d != null)
+                ids = d.options().stream()
+                        .map(o -> ti4.discord.interactions.routing.ComponentIdEnvelope.decode(o.id().split("#")[0]).handlerId())
+                        .toList();
+        }
+        if (ids == null) return false;
+        String bombard = null;
+        for (String h : ids) {
+            if (h == null) continue;
+            if (h.startsWith("autoAssign") && h.contains("Hits_")) return false; // regular hits prompts: unchanged
+            if (isBombardmentAssign(h)) bombard = h;
+        }
+        if (bombard == null) return false;
+        Game game = ctx.game();
+        String pos = bombard.substring("getDamageButtons_".length()).split("_")[0];
+        if (!pos.equals(game.getActiveSystem())) return true;
+        Tile tile = game.getTileByPosition(pos);
+        String planet = bombardedPlanet(game, tile);
+        if (tile == null || planet == null) return true;
+        Player p = ctx.player();
+        if (p != null && CombatSupport.hittableUnits(game, p, tile, planet, "ground").isEmpty()) return true;
+        for (Player x : game.getRealPlayersNNeutral())
+            if (CombatSupport.roundsRolled(game, x, pos, planet) > 0) return true;
+        ti4.selfhost.engine.EngineModels.Progress pr = CombatSupport.assignProgress(game, p);
+        return pr != null && pr.canCommit() && planet.equals(((Map<?, ?>) pr.required()).get("holder"));
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/CombatModifierKind.java b/src/main/java/ti4/selfhost/engine/kinds/CombatModifierKind.java
