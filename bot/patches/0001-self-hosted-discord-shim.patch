+package ti4.selfhost.engine.kinds;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.helpers.Helper;
+import ti4.selfhost.engine.EngineModels.CommandTokens;
+import ti4.selfhost.engine.EngineModels.Decision;
+import ti4.selfhost.engine.EngineModels.Progress;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * The step-by-step command token prompt (CommandCounterButtonHandler.redistributeCCButtons / Leadership / Warfare):
+ * FFCC_&lt;f&gt;_increase_|decrease_&lt;pool&gt;_cc, resetCCs, and a "Done" (deleteButtons, untyped). Edited in place
+ * after every step, so one decision with progress {flow: "command_tokens", step: "adjust", accumulated: current
+ * pools {tactic, fleet, strategy}, required: {status: bool, base?, gain?, maxTotal?}, canCommit: true}.
+ *
+ * <p>value: {pool, delta: +1|-1} or {action: "reset"}. In the status phase the increase options also take the
+ * whole answer as a payload {tactic, fleet, strategy} (same check and handler as status.homework), which replaces
+ * the step-by-step clicking and closes this prompt.
+ */
+public class CommandTokensAdjustKind implements KindSpec {
+
+    @Override
+    public String kind() {
+        return "command_tokens.adjust";
+    }
+
+    @Override
+    public int priority() {
+        return 80;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return handlerId.matches("(increase|decrease)_(tactic|fleet|strategy)_cc") || "resetCCs".equals(handlerId);
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        Map<String, Object> v = new LinkedHashMap<>();
+        if ("resetCCs".equals(handlerId)) {
+            v.put("action", "reset");
+            return v;
+        }
+        String[] a = handlerId.split("_");
+        v.put("action", "adjust");
+        v.put("pool", a[1]);
+        v.put("delta", "increase".equals(a[0]) ? 1 : -1);
+        v.put("payload", StatusPhase.inHomework(ctx.game()));
+        // Outside the status phase the whole answer {tactic, fleet, strategy} is taken too (answerPayload presses the
+        // same +/- steps): the web's one-go token editor for Warfare / Leadership / other redistributions (pt7).
+        v.put("editor", true);
+        return v;
+    }
+
+    @Override
+    public boolean dynamic() {
+        return true;
+    }
+
+    @Override
+    public Progress progress(CaptureContext ctx) {
+        Player p = ctx.player();
+        if (p == null) return null;
+        Game game = ctx.game();
+        CommandTokens cur = StatusPhase.current(p);
+        Map<String, Object> acc = new LinkedHashMap<>();
+        acc.put("tactic", cur.tactic());
+        acc.put("fleet", cur.fleet());
+        acc.put("strategy", cur.strategy());
+        Map<String, Object> req = new LinkedHashMap<>();
+        boolean status = StatusPhase.inHomework(game);
+        req.put("status", status);
+        // The pools when this panel opened (Leadership / Technology / other gains store them): lets a client count
+        // what this panel already gained, across restarts (current - original).
+        String orig = game.getStoredValue("originalCCsFor" + p.getFaction());
+        if (orig != null && orig.matches("\\d+/\\d+/\\d+")) {
+            String[] o = orig.split("/");
+            req.put("original", Map.of(
+                    "tactic", Integer.parseInt(o[0]), "fleet", Integer.parseInt(o[1]), "strategy", Integer.parseInt(o[2])));
+        }
+        // Tokens left in reinforcements (a gain takes one; none left, none gained): absent without the plastic limit.
+        if (game.isCcNPlasticLimit()) {
+            try {
+                req.put("reinforcements", Math.max(0, p.getCommandTokenLimit() - Helper.getCCCount(game, p.getColor())));
+            } catch (RuntimeException ignored) {
+                // best effort
+            }
+        }
+        // The grant of the effect that opened the panel (CcGainCap: Acamar 1, Leadership 3 + influence / 3, …):
+        // {limit, gained, source, label}; increases past it are refused.
+        Integer capLimit = ti4.helpers.CcGainCap.limit(game, p);
+        if (capLimit != null) {
+            ti4.helpers.CcGainCap.Cap cap = ti4.helpers.CcGainCap.get(game, p);
+            Map<String, Object> gc = new LinkedHashMap<>();
+            gc.put("limit", capLimit);
+            gc.put("gained", ti4.helpers.CcGainCap.gained(game, p));
+            gc.put("source", cap == null ? null : cap.source());
+            gc.put("label", cap == null ? null : cap.label());
+            req.put("gainCap", gc);
+        }
+        if (status) {
+            CommandTokens base = StatusPhase.tokensBase(game, p);
+            req.put("base", Map.of("tactic", base.tactic(), "fleet", base.fleet(), "strategy", base.strategy()));
+            req.put("gain", StatusPhase.tokenGain(game, p));
+            req.put("maxTotal", StatusPhase.tokenMaxTotal(game, p, base));
+        }
+        return new Progress("command_tokens", "adjust", acc, req, true);
+    }
+
+    /**
+     * Gaining a token needs one in reinforcements (16, or the player's limit, in pools + on the board), and stays
+     * within the grant of the effect that opened the panel (CcGainCap) or this round's status gain.
+     */
+    @Override
+    public String validate(Game game, Player answering, Decision decision, String optionId) {
+        Map<String, Object> v = StrategyCards.optionValue(decision, optionId);
+        if (v == null || !"adjust".equals(v.get("action")) || StrategyCards.intOf(v.get("delta"), 0) <= 0) return null;
+        // Rules audit: no more than the opening effect grants (CcGainCap) / this round's status gain.
+        String capErr = ti4.helpers.CcGainCap.refuseOneMore(game, answering);
+        if (capErr == null) capErr = StatusPhase.refuseOneMoreToken(game, answering);
+        if (capErr != null) return capErr;
+        // Fleet Regulations (rules audit; the original only reminded after the gain).
+        if ("fleet".equals(v.get("pool"))
+                && ti4.discord.interactions.buttons.handlers.commandcounter.CommandCounterButtonHandler
+                        .exceedsFleetRegulations(game, answering, answering.getFleetCC() + 1))
+            return "Fleet Regulations is in play: you cannot have more than 4 tokens in your fleet pool.";
+        if (!game.isCcNPlasticLimit()) return null;
+        int inPlay = Helper.getCCCount(game, answering.getColor());
+        int limit = answering.getCommandTokenLimit();
+        if (inPlay >= limit)
+            return "You have no command tokens left in your reinforcements (" + inPlay + "/" + limit + " in use).";
+        return null;
+    }
+
+    @Override
+    public boolean acceptsPayload() {
+        return true;
+    }
+
+    @Override
+    public String answerPayload(PayloadAnswer steps, Map<String, Object> payload) throws Exception {
+        Game game = steps.game();
+        Player answering = steps.player();
+        Decision decision = steps.decision();
+        if (game == null || answering == null || decision == null) return "That decision is no longer open.";
+        if (!StatusPhase.inHomework(game)) return applySteps(steps, payload);
+        return StatusHomeworkKind.applyTokens(game, answering, decision, payload, steps);
+    }
+
+    /**
+     * A whole answer outside the status phase: the pools {tactic, fleet, strategy} the player wants, reached with the
+     * panel's own one-token steps (decreases first, so a redistribution never needs a token it lacks). Checked up front
+     * against the effect's grant (CcGainCap) so a refused gain never leaves a half-applied change.
+     */
+    private String applySteps(PayloadAnswer steps, Map<String, Object> payload) throws Exception {
+        Player p = steps.player();
+        Game game = steps.game();
+        int[] want = new int[3];
+        String[] pools = {"tactic", "fleet", "strategy"};
+        for (int i = 0; i < 3; i++) {
+            Object o = payload.get(pools[i]);
+            if (!(o instanceof Number n) || n.intValue() < 0 || n.doubleValue() != Math.floor(n.doubleValue()))
+                return "Give whole numbers (0 or more) for tactic, fleet and strategy.";
+            want[i] = n.intValue();
+        }
+        CommandTokens cur = StatusPhase.current(p);
+        int[] have = {cur.tactic(), cur.fleet(), cur.strategy()};
+        int net = want[0] + want[1] + want[2] - have[0] - have[1] - have[2];
+        Integer limit = ti4.helpers.CcGainCap.limit(game, p);
+        if (net > 0 && limit != null) {
+            int left = Math.max(0, limit - ti4.helpers.CcGainCap.gained(game, p));
+            if (net > left)
+                return "That gains " + net + " token" + (net == 1 ? "" : "s") + "; this effect lets you gain " + left
+                        + " more.";
+        }
+        for (int pass = 0; pass < 2; pass++) {
+            for (int i = 0; i < 3; i++) {
+                int d = want[i] - have[i];
+                if (pass == 0 ? d >= 0 : d <= 0) continue;
+                for (int k = 0; k < Math.abs(d); k++) {
+                    Decision latest = steps.decision();
+                    if (latest == null) return "The command token panel closed before every change was made.";
+                    String opt = stepOption(latest, pools[i], d > 0 ? 1 : -1);
+                    if (opt == null) return "The panel has no " + (d > 0 ? "gain" : "lose") + " " + pools[i] + " step.";
+                    String err = validate(steps.game(), steps.player(), latest, opt);
+                    if (err != null) return err;
+                    steps.press(opt);
+                }
+            }
+        }
+        // Then the panel's own "Done …Command Tokens" closer, as the player would press it (one click on the web).
+        Decision latest = steps.decision();
+        if (latest != null) {
+            for (ti4.selfhost.engine.EngineModels.Option o : latest.options()) {
+                ti4.helpers.DoneRole role = ti4.helpers.DoneRole.of(o.handler());
+                if (role == null) role = ti4.helpers.DoneRole.fromLegacyLabel(o.label());
+                if (role != null && role.isCommandTokens() && !o.disabled()) {
+                    steps.press(o.id());
+                    break;
+                }
+            }
+        }
+        return null;
+    }
+
+    private static String stepOption(Decision d, String pool, int delta) {
+        for (ti4.selfhost.engine.EngineModels.Option o : d.options()) {
+            Map<String, Object> v = o.value();
+            if (v != null && "adjust".equals(v.get("action")) && pool.equals(v.get("pool"))
+                    && StrategyCards.intOf(v.get("delta"), 0) == delta && !o.disabled()) return o.id();
+        }
+        return null;
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/CommoditiesKind.java b/src/main/java/ti4/selfhost/engine/kinds/CommoditiesKind.java
new file mode 100644
