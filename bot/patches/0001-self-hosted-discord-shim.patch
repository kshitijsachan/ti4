@@ -0,0 +1,43 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.List;
+import java.util.Map;
+import ti4.selfhost.engine.EngineModels.Target;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * Base of the generic single-choice kinds (see {@link ChooseSupport}). Low priority: any dedicated kind that claims
+ * the message wins. Target: the certain (owner prefix, cards thread, ...) or mentioned player, else whoever pressed
+ * a button in this channel a moment ago (the step that led here), else the active player.
+ */
+public abstract class ChooseKindBase implements KindSpec {
+
+    /** The rules of this kind. */
+    protected abstract List<ChooseSupport.Rule> rules();
+
+    @Override
+    public int priority() {
+        return 20;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return ChooseSupport.find(rules(), handlerId) != null;
+    }
+
+    /** Only messages made of our options (plus dismiss/decline/undo chrome): never a mixed menu. */
+    @Override
+    public boolean classifies(List<String> handlerIds) {
+        return ChooseSupport.onlyOurs(handlerIds, this::matches);
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        return ChooseSupport.value(rules(), handlerId, ctx);
+    }
+
+    @Override
+    public Target target(CaptureContext ctx, Target resolved) {
+        return ExploreSupport.explorer(ctx, resolved);
+    }
+}
