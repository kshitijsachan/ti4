+package ti4.selfhost.engine.kinds;
+
+import java.util.Map;
+import ti4.selfhost.engine.EngineModels.Target;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * Choose which drawn exploration card to resolve:
+ * <ul>
+ *   <li>resolve_explore_&lt;card&gt;_&lt;planet&gt;[_distantSuns] — Naaz Distant Suns / Bozgarbia (pick 1 of 2–3),
+ *       or a lone "Resolve X" next to an alternative resolution (Arlir mirror, Perfect Architecture);</li>
+ *   <li>resFrontier_&lt;card&gt;_&lt;tile&gt;_&lt;otherCard&gt; — Empyrean Voidsailors (pick 1 of 2 frontier cards, the other
+ *       goes back).</li>
+ * </ul>
+ * value: {card, cardName, cardType, resolution, cardText, planet|null, planetName, tile, rejected|null}.
+ */
+public class ExploreCardPickKind implements KindSpec {
+
+    @Override
+    public String kind() {
+        return "explore.card_pick";
+    }
+
+    @Override
+    public int priority() {
+        return 100;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return handlerId.startsWith("resolve_explore_") || handlerId.startsWith("resFrontier_");
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        if (handlerId.startsWith("resolve_explore_")) {
+            String[] p = handlerId.substring("resolve_explore_".length()).split("_");
+            if (p.length < 2) return null;
+            Map<String, Object> v = ExploreSupport.card(p[0]);
+            ExploreSupport.putPlanet(v, ctx.game(), p[1]);
+            if (!v.containsKey("tile")) v.put("tile", null);
+            v.put("rejected", null);
+            v.put("variant", p.length > 2 ? p[2] : null);
+            return v;
+        }
+        if (handlerId.startsWith("resFrontier_")) {
+            String[] p = handlerId.substring("resFrontier_".length()).split("_");
+            if (p.length < 3) return null;
+            Map<String, Object> v = ExploreSupport.card(p[0]);
+            v.put("planet", null);
+            v.put("tile", p[1]);
+            v.put("rejected", p[2]);
+            v.put("variant", "voidsailors");
+            return v;
+        }
+        return null;
+    }
+
+    @Override
+    public Target target(CaptureContext ctx, Target resolved) {
+        return ExploreSupport.explorer(ctx, resolved);
+    }
+}
