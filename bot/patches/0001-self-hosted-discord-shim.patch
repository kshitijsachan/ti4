+/**
+ * Generic "choose a card" step: value {source, cardType, relic|card|trait|position, ...}. cardType: "relic",
+ * "explore_deck" (a whole exploration deck by trait), "action_card", "card". Add rules here.
+ */
+public class ChooseCardKind extends ChooseKindBase {
+
+    public static final List<ChooseSupport.Rule> RULES = List.of(
+            // Relic draw with advantage (look at the top N, take one): position in the relic deck.
+            rule(
+                    "relic_draw_advantage",
+                    "drawRelicAtPosition_(?<position>\\d+)",
+                    Map.of("cardType", "relic"),
+                    (v, ctx) -> {
+                        Game g = ctx.game();
+                        Object pos = v.get("position");
+                        java.util.List<String> deck = g == null ? null : g.getAllRelics();
+                        if (deck != null && pos instanceof Integer i && i >= 0 && i < deck.size()) {
+                            v.putAll(ExploreSupport.relic(deck.get(i)));
+                        }
+                    }),
+            // Relic swap (hero): first relic, then the one to swap it with ("faction;relic").
+            rule("relic_swap", "relicSwapStep1_(?<faction>[^;]*);(?<relic>.+)", Map.of("cardType", "relic", "step", 1)),
+            rule(
+                    "relic_swap",
+                    "relicSwapStep2;(?<faction>[^;]*);(?<relic>[^;]+);(?<faction2>[^;]*);(?<relic2>.+)",
+                    Map.of("cardType", "relic", "step", 2)),
+            // Steal a relic from a player (hero).
+            rule("steal_relic", "stealRelic_(?<faction>[^_]+)_(?<relic>.+)", Map.of("cardType", "relic")),
+            // Look at / discard the top card of an exploration deck (Exploration Probe, Scepter of Dominion, ...).
+            rule("explore_look_top", "resolveExp_Look_(?<trait>[a-z]+)", Map.of("cardType", "explore_deck")),
+            rule("explore_discard_top", "discardExploreTop_(?<trait>[a-z]+)", Map.of("cardType", "explore_deck")),
+            // The Codex (relic): take one of the action cards from the discard pile.
+            rule("codex", "codexCardPick_(?<position>\\d+)", Map.of("cardType", "action_card")),
+            // Quantum Entangler: which drawn relic the target gets / the owner keeps (index into the drawn relics).
+            rule(
+                    "quantum_entangler",
+                    "quantumEntanglerGiveTarget_(?<faction>[^|]+)\\|(?<position>\\d+)",
+                    Map.of("cardType", "relic", "step", 1)),
+            rule(
+                    "quantum_entangler",
+                    "quantumEntanglerGiveOwner_(?<faction>[^|]+)\\|(?<position>\\d+)",
+                    Map.of("cardType", "relic", "step", 2)),
+            // Neuraloop: replace a just-revealed objective from a deck (step 1), purging one of your relics (step 2).
+            rule(
+                    "neuraloop",
+                    "neuraloopPart1;(?<card>[^;]+);(?<choice>stage1|stage2|secret)",
+                    Map.of("cardType", "objective_deck", "step", 1)),
+            rule(
+                    "neuraloop",
+                    "neuraloopPart2;(?<card>[^;]+);(?<choice>[^;]+);(?<relic>.+)",
+                    Map.of("cardType", "relic", "step", 2)),
+            // Mutagen (relic option).
+            rule("mutagen", "chooseMutagenOption_(?<choice>.+)", Map.of("cardType", "card")),
+            // Return a promissory note from our play area to its owner (a mistake fix from the deal builder).
+            rule(
+                    "return_play_area_pn",
+                    "returnPNInPlayArea_(?<card>.+)",
+                    Map.of("cardType", "promissory_note"),
+                    (v, ctx) -> {
+                        ti4.model.PromissoryNoteModel pn = ti4.image.Mapper.getPromissoryNote((String) v.get("card"));
+                        if (pn != null) v.put("cardName", pn.getName());
+                        Game g = ctx.game();
+                        Player owner = g == null ? null : g.getPNOwner((String) v.get("card"));
+                        if (owner != null) v.put("faction", owner.getFaction());
+                    }));
+
+    @Override
+    public String kind() {
+        return "choose.card";
+    }
+
+    @Override
+    protected List<ChooseSupport.Rule> rules() {
+        return RULES;
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/ChooseConfirmKind.java b/src/main/java/ti4/selfhost/engine/kinds/ChooseConfirmKind.java
new file mode 100644
index 0000000..0d671dd
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/ChooseConfirmKind.java
@@ -0,0 +1,105 @@
+package ti4.selfhost.engine.kinds;
+
+import static ti4.selfhost.engine.kinds.ChooseSupport.rule;
+
+import java.util.List;
+import java.util.Map;
+import ti4.selfhost.engine.EngineModels.Target;
+
+/**
+ * Generic yes/no step: value {source, confirm: true|false, choice?}. confirm=true means "do it" (use the
+ * relic/ability), false means "decline". The prompt's plain decline ("deleteButtons", "No") has value null; a
+ * policy that wants to decline presses that. Add rules here.
+ */
+public class ChooseConfirmKind extends ChooseKindBase {
+
+    public static final List<ChooseSupport.Rule> RULES = List.of(
+            // Crown of Emphidia: explore a planet you control after the tactical action.
+            rule("crownofemphidia", "crownofemphidiaexplore", Map.of("confirm", true)),
+            // Heart of Ixth: decline using it.
+            rule("heartofixth", "declineHeartOfIxth", Map.of("confirm", false)),
+            // The Silver Flame: on a 10 gain 1 VP (Point) or purge it.
+            rule("thesilverflame", "resolveSilverFlame(?<choice>Point|Purge)", Map.of("confirm", true)),
+            // Throne of the False Emperor: score a secret another player scored.
+            rule("throne_of_the_false_emperor", "thronePoint", Map.of("confirm", true)),
+            // The Silver Flame purge cost a home planet: score Become a Martyr now.
+            rule("thesilverflame_bam", "scoreSilverFlameBAM", Map.of("confirm", true)),
+            // JR-XS455-O (relic): the chosen player places a space dock / PDS / monument or gains 1 trade good.
+            rule("jrxs455o", "jrStructure_(?<choice>sd|pds|monument|tg)", Map.of("confirm", true)),
+            // Imperial Arbiter (law, end of the strategy phase): swap strategy cards with someone (then choose.player /
+            // choose.card source imperialarbiter), or decline ("declineArbiter", or "deleteButtons" on the second copy).
+            rule("imperialarbiter", "startArbiter", Map.of("confirm", true)),
+            rule("imperialarbiter", "declineArbiter", Map.of("confirm", false)),
+            // Minister of Peace (law): end the active player's turn after they activate a system with others' units.
+            rule("minister_peace", "ministerOfPeace", Map.of("confirm", true)),
+            // Warfare: "Redistribute (& Gain) Command Tokens" offers outside the status phase (Warfare primary after
+            // removing a token; Thunder's Edge Warfare before / after its tactical action), which open the
+            // command_tokens.adjust panel; Thunder's Edge Warfare's "Perform Tactical Action" (no token placed).
+            rule("warfare", "redistributeCCButtons_", Map.of("confirm", true, "choice", "redistribute")),
+            rule("warfare", "beginTacticalTeWarfare", Map.of("confirm", true, "choice", "tactical")),
+            // Follow a just-played strategy card without a strategy token (PlayStrategyCardService.playSC, cards-info
+            // thread; one shared list, "Delete These Buttons" declines): Mahact agent, Scepter of Emelpar, Cognitive
+            // Parallax Engine.
+            rule("mahactagent", "mahactA_follow_(?<strategyCard>\\d+)", Map.of("confirm", true)),
+            rule("scepter_of_emelpar", "scepterE_follow_(?<strategyCard>\\d+)", Map.of("confirm", true)),
+            rule("cognitive_parallax_engine", "thardentiag_follow_(?<strategyCard>\\d+)", Map.of("confirm", true)),
+            // Ixthian Artifact (agenda, For): the speaker rolls (target = speaker); "roll anyway" for anyone else.
+            rule("ixthian_artifact", "rollIxthian", Map.of("confirm", true)),
+            rule("ixthian_artifact", "rollIxthianIgnoreSpeaker", Map.of("confirm", true, "choice", "ignore_speaker")),
+            // Lead From the Front / Galvanize the People (ObjectiveTokenSpendService): which pools pay the command
+            // tokens, one option per split; objective lead | galvanize, strategy + tactic = the cost.
+            rule(
+                    "spend_objective_tokens",
+                    // _<number>: the objective is scored by this answer (pay first); absent: already scored.
+                    "poTokenSpend_(?<objective>lead|galvanize)_(?<strategy>\\d+)_(?<tactic>\\d+)(?:_(?<number>\\d+))?",
+                    Map.of("confirm", true, "choice", "split"),
+                    (v, ctx) -> {
+                        for (String k : new String[] {"strategy", "tactic", "number"}) {
+                            Object raw = v.get(k);
+                            if (raw instanceof String str) v.put(k, Integer.parseInt(str));
+                        }
+                    }),
+            // Debt reminder (AgendaHelper.pingAboutDebt, agenda phase): pay a creditor 1/3 commodities or trade goods,
+            // or erase 1/3 debt paid elsewhere; "Delete These Buttons" declines. faction = the creditor.
+            rule(
+                    "pay_debt",
+                    "sendTGTo_(?<faction>[^_]+)_(?<choice>comm|tg|debt)(?<amount>3)?",
+                    Map.of("confirm", true),
+                    (v, ctx) -> v.putIfAbsent("amount", 1)));
+
+    @Override
+    public Target target(CaptureContext ctx, Target resolved) {
+        List<String> hs = ctx.handlerIds();
+        if (hs != null && hs.contains("rollIxthian") && ctx.game() != null) {
+            Target s = AgendaSupport.speakerTarget(ctx.game(), "speaker");
+            if (s != null) return s;
+        }
+        return super.target(ctx, resolved);
+    }
+
+    @Override
+    public String kind() {
+        return "choose.confirm";
+    }
+
+    /**
+     * Jae Mir Kan (Mahact agent) follows a strategy card only while readied (rules audit, leaders A–M; mirrored in
+     * ButtonHelperSCs.mahactAndScepterFollow): another card's offer must not reuse an exhausted agent.
+     */
+    @Override
+    public String validate(
+            ti4.game.Game game,
+            ti4.game.Player answering,
+            ti4.selfhost.engine.EngineModels.Decision decision,
+            String optionId) {
+        if (game == null || answering == null || decision == null) return null;
+        Map<String, Object> v = StrategyCards.optionValue(decision, optionId);
+        if (v == null || !"mahactagent".equals(v.get("source"))) return null;
+        return ti4.service.leader.LeaderRuleChecks.agentNotReady(answering, "mahactagent");
+    }
+
+    @Override
+    protected List<ChooseSupport.Rule> rules() {
+        return RULES;
+    }
+}
