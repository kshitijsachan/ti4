diff --git a/src/main/java/ti4/selfhost/engine/kinds/FactionStepsRegex.java b/src/main/java/ti4/selfhost/engine/kinds/FactionStepsRegex.java
new file mode 100644
index 0000000..03ad282
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/FactionStepsRegex.java
@@ -0,0 +1,131 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+import javax.annotation.Nullable;
+import ti4.game.Player;
+import ti4.helpers.Units;
+import ti4.image.Mapper;
+import ti4.model.ActionCardModel;
+import ti4.selfhost.engine.KindSpec.CaptureContext;
+
+/**
+ * Table-driven {@link FactionSteps} provider (abstract: subclasses list rules). A rule is a full-match regex on the
+ * handler id; its named groups become typed fields by name: {@code planet} (planet id), {@code tile} (position),
+ * {@code holder} (unit holder: planet id or "space"), {@code unit} (async unit id, "pds" → "pd"), {@code target}
+ * (faction or colour → faction; "unowned" → target null + unowned true), {@code strategyCard} / {@code handle} /
+ * {@code amount} (ints); any other group verbatim. Used by the group-C factions (Jol-Nar, Winnu, Xxcha, Yin,
+ * Yssaril, Keleres).
+ */
+public abstract class FactionStepsRegex implements FactionSteps {
+
+    interface Extra {
+        void add(Matcher m, @Nullable CaptureContext ctx, Map<String, Object> fields);
+    }
+
+    /**
+     * @param kind "leader.use" or "faction.ability"
+     * @param source leader type is taken from the leader model; for faction.ability: ability|tech|promissory|mech|...
+     */
+    record Rule(
+            String kind,
+            String source,
+            String component,
+            String faction,
+            String step,
+            String action,
+            boolean optional,
+            Pattern pattern,
+            @Nullable Extra extra) {
+
+        Rule extra(Extra e) {
+            return new Rule(kind, source, component, faction, step, action, optional, pattern, e);
+        }
+    }
+
+    static Rule ability(String source, String id, String faction, String action, boolean optional, String regex) {
+        return new Rule("faction.ability", source, id, faction, stepOf(regex), action, optional, Pattern.compile(regex), null);
+    }
+
+    static Rule leader(String leader, String action, boolean optional, String regex) {
+        return new Rule("leader.use", "", leader, null, stepOf(regex), action, optional, Pattern.compile(regex), null);
+    }
+
+    /** The handler prefix (regex up to the first group / special char), no trailing "_". */
+    static String stepOf(String regex) {
+        int i = 0;
+        while (i < regex.length() && (Character.isLetterOrDigit(regex.charAt(i)) || regex.charAt(i) == '_')) i++;
+        String s = regex.substring(0, i);
+        while (s.endsWith("_")) s = s.substring(0, s.length() - 1);
+        return s;
+    }
+
+    protected abstract List<Rule> rules();
+
+    @Override
+    @Nullable
+    public Step step(String handlerId, @Nullable CaptureContext ctx) {
+        for (Rule r : rules()) {
+            Matcher m = r.pattern().matcher(handlerId);
+            if (!m.matches()) continue;
+            Map<String, Object> f = new LinkedHashMap<>();
+            for (String name : m.pattern().namedGroups().keySet()) {
+                String raw = m.group(name);
+                if (raw != null) put(f, name, raw, ctx);
+            }
+            if (r.extra() != null) {
+                try {
+                    r.extra().add(m, ctx, f);
+                } catch (Exception ignored) {
+                    // best effort: keep the fields parsed so far
+                }
+            }
+            Object[] kv = new Object[f.size() * 2];
+            int i = 0;
+            for (Map.Entry<String, Object> e : f.entrySet()) {
+                kv[i++] = e.getKey();
+                kv[i++] = e.getValue();
+            }
+            if ("leader.use".equals(r.kind())) return Step.leader(r.component(), r.step(), r.action(), r.optional(), kv);
+            return Step.ability(r.source(), r.component(), r.faction(), r.step(), r.action(), r.optional(), kv);
+        }
+        return null;
+    }
+
+    static void put(Map<String, Object> f, String name, String raw, @Nullable CaptureContext ctx) {
+        switch (name) {
+            case "strategyCard", "handle", "amount" -> f.put(name, FactionSteps.num(raw));
+            case "unit" -> f.put(name, unitId(raw));
+            case "target" -> {
+                if ("unowned".equalsIgnoreCase(raw)) f.put("unowned", true);
+                else f.put("target", FactionSteps.faction(raw, ctx));
+            }
+            default -> f.put(name, raw);
+        }
+    }
+
+    /** "pds" / "spacedock" / "mech" / "infantry" / "cruiser" / "ca" → async id ("pd", "sd", "mf", "gf", "ca"). */
+    static String unitId(String raw) {
+        try {
+            Units.UnitType t = Units.findUnitType(raw.toLowerCase());
+            if (t != null) return t.getValue();
+        } catch (Exception ignored) {
+            // unknown alias
+        }
+        return raw;
+    }
+
+    /** Card id + name for a hand handle of a player (private: only in that viewer's own prompt). */
+    static void actionCard(Map<String, Object> f, @Nullable Player holder) {
+        if (holder == null || !(f.get("handle") instanceof Integer h)) return;
+        for (Map.Entry<String, Integer> e : holder.getActionCards().entrySet()) {
+            if (e.getValue() != h.intValue()) continue;
+            f.put("actionCard", e.getKey());
+            ActionCardModel m = Mapper.getActionCard(e.getKey());
+            if (m != null) f.put("cardName", m.getName());
+        }
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/FactionStepsRegexPok.java b/src/main/java/ti4/selfhost/engine/kinds/FactionStepsRegexPok.java
new file mode 100644
index 0000000..1b8792a
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/FactionStepsRegexPok.java
@@ -0,0 +1,94 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+import javax.annotation.Nullable;
+import ti4.image.Mapper;
+import ti4.model.LeaderModel;
+import ti4.selfhost.engine.KindSpec.CaptureContext;
+
+/**
+ * A {@link FactionSteps} provider written as a table of regexes over the handler id. Named groups become typed
+ * fields (planet, tile, toTile, unit, color, amount, ...); a group named "target" is normalised to the faction id of
+ * the seated player it names. Abstract: the classpath scan only instantiates the concrete per-faction subclasses.
+ */
+public abstract class FactionStepsRegexPok implements FactionSteps {
+
+    /** One handler-id shape → a Step (kind "leader.use" when source is "leader", else "faction.ability"). */
+    protected record R(
+            Pattern pattern,
+            String source,
+            String component,
+            @Nullable String faction,
+            String step,
+            String action,
+            boolean optional) {}
+
+    protected static R leader(String regex, String leaderId, String step, String action, boolean optional) {
+        return new R(Pattern.compile(regex), "leader", leaderId, null, step, action, optional);
+    }
+
+    protected static R ability(
+            String regex, String source, String component, @Nullable String faction, String step, String action,
+            boolean optional) {
+        return new R(Pattern.compile(regex), source, component, faction, step, action, optional);
+    }
+
+    protected abstract List<R> rules();
+
+    private volatile List<R> cached;
+
+    private List<R> all() {
+        List<R> c = cached;
+        if (c == null) cached = c = List.copyOf(rules());
+        return c;
+    }
+
+    private static final Pattern GROUP = Pattern.compile("\\(\\?<([a-zA-Z][a-zA-Z0-9]*)>");
+
+    @Override
+    @Nullable
+    public Step step(String handlerId, @Nullable CaptureContext ctx) {
+        for (R r : all()) {
+            Matcher m = r.pattern().matcher(handlerId);
+            if (!m.matches()) continue;
+            List<Object> kv = new ArrayList<>();
+            Matcher g = GROUP.matcher(r.pattern().pattern());
+            while (g.find()) {
+                String name = g.group(1);
+                String s = m.group(name);
+                if (s == null || s.isEmpty()) continue;
+                Object v = s;
+                if (name.equals("target")) v = FactionSteps.faction(s, ctx);
+                else if (name.equals("damaged")) v = Boolean.TRUE;
+                else if (name.equals("amount") || name.equals("count")) {
+                    Integer n = FactionSteps.num(s);
+                    if (n != null) v = n;
+                }
+                kv.add(name);
+                kv.add(v);
+            }
+            Object[] fields = kv.toArray();
+            if ("leader".equals(r.source())) {
+                return Step.leader(r.component(), r.step(), r.action(), r.optional(), fields);
+            }
+            return Step.ability(r.source(), r.component(), r.faction(), r.step(), r.action(), r.optional(), fields);
+        }
+        return null;
+    }
+
+    /** The leader's faction (for docs/tests); null when the leader id is unknown. */
+    @Nullable
+    static String leaderFaction(String leaderId) {
+        LeaderModel m = Mapper.getLeader(leaderId);
+        return m == null ? null : m.getFaction();
+    }
+
+    static Map<String, Object> describe(Step s) {
+        return s == null ? new LinkedHashMap<>() : s.value();
+    }
+}
