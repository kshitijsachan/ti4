diff --git a/src/main/java/ti4/selfhost/engine/kinds/GameEndKind.java b/src/main/java/ti4/selfhost/engine/kinds/GameEndKind.java
new file mode 100644
index 0000000..7d890a0
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/GameEndKind.java
@@ -0,0 +1,98 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.selfhost.engine.EngineModels.Decision;
+import ti4.selfhost.engine.EngineModels.Target;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * The end-of-game prompt posted in the actions channel when someone reaches the victory points
+ * (Helper.checkEndGame / checkEndGameCivilizedSociety): "it appears as though X has won the game!" with
+ * {@code gameEnd} ("End Game"), {@code rematch} ("Rematch …") and {@code deleteButtons} ("Mistake, delete these"); in
+ * fog of war {@code gameEndConfirmation} ("End and Delete Game"), whose confirmation prompt carries {@code gameEnd}
+ * again ("Confirm to End and Delete Game").
+ *
+ * <p>value {action: "end" | "rematch" | "end_confirm", deletesChannels} ("end_confirm" asks for the confirmation
+ * prompt; deletesChannels: fog of war, ending deletes the game's channels). The dismiss option has value null.
+ * The status phase's "objectives ran out" prompt keeps its own kind (status.reveal_objective: endGameMostPoints).
+ *
+ * <p>A table prompt with no target (any seated player may press, like the buttons); obsolete once the game has ended
+ * (the invoker refuses every answer on an ended game; Rematch ends the old game too). Bots never answer it.
+ */
+public class GameEndKind implements KindSpec {
+
+    @Override
+    public String kind() {
+        return "game.end";
+    }
+
+    @Override
+    public int priority() {
+        return 100;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return "gameEnd".equals(handlerId) || "rematch".equals(handlerId) || "gameEndConfirmation".equals(handlerId);
+    }
+
+    /** Claimed only by the End Game buttons: a lone "rematch" (next to endGameMostPoints) is the status prompt's. */
+    @Override
+    public boolean classifies(java.util.List<String> handlerIds) {
+        return handlerIds.contains("gameEnd") || handlerIds.contains("gameEndConfirmation");
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        Map<String, Object> v = new LinkedHashMap<>();
+        v.put(
+                "action",
+                switch (handlerId) {
+                    case "rematch" -> "rematch";
+                    case "gameEndConfirmation" -> "end_confirm";
+                    default -> "end";
+                });
+        v.put("deletesChannels", ctx.game() != null && ctx.game().isFowMode() && !"rematch".equals(handlerId));
+        return v;
+    }
+
+    /** Nobody in particular: anyone at the table may end the game. */
+    @Override
+    public Target target(CaptureContext ctx, Target resolved) {
+        return null;
+    }
+
+    @Override
+    public String scope(CaptureContext ctx) {
+        return "table";
+    }
+
+    @Override
+    public boolean dynamic() {
+        return true;
+    }
+
+    /** Ended games take no answers (ActionInvoker), so the prompt is over once the game is (End Game, Rematch). */
+    @Override
+    public boolean obsolete(CaptureContext ctx) {
+        return ctx.game() != null && ctx.game().isHasEnded();
+    }
+
+    /** Rematch leaves its message up (End Game deletes it): the answer settles the decision. */
+    @Override
+    public boolean closesOnAnswer(String handler) {
+        return "rematch".equals(handler) || "gameEnd".equals(handler);
+    }
+
+    @Override
+    public String validate(Game game, Player answering, Decision decision, String optionId) {
+        if (game == null) return null;
+        if (game.isHasEnded()) return "This game has already ended.";
+        String h = StatusScoreKind.handlerOf(decision, optionId);
+        if ("rematch".equals(h) && game.isFowMode()) return "Fog of war games cannot be rematched from here.";
+        return null;
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/GameSettingsKind.java b/src/main/java/ti4/selfhost/engine/kinds/GameSettingsKind.java
new file mode 100644
index 0000000..3658c70
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/GameSettingsKind.java
@@ -0,0 +1,97 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.Map;
+import java.util.regex.Pattern;
+import ti4.selfhost.engine.EngineModels.Target;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * Game creation prompts in the new game's actions channel, before any draft: expansion choice (chooseExp_&lt;x&gt;,
+ * setupBaseGameMode[_confirm]), alternate modes / homebrew menus (offerGameOptionButtons, getHomebrewButtons,
+ * offerTEOptionButtons, startTFGame, frankenSetup, setupHomebrew_…), starting a draft (miltySetup, startDraftSystem)
+ * and the Milty settings pages (jmf&lt;N|A|…&gt;_&lt;menu&gt;_&lt;item&gt;: navigate / act). Any seated player may press
+ * (table). value: {setting: which control family ("expansion"|"base_game"|"game_modes"|"game_options"|"draft_start"|"draft_settings"),
+ * choice: the specific item (expansion id, menu path, "milty", "startMilty", …)}.
+ */
+public class GameSettingsKind implements KindSpec {
+    private static final Pattern MODES = Pattern.compile(
+            "offerGameOptionButtons|getHomebrewButtons|offerTEOptionButtons|startTFGame|frankenSetup|setupHomebrewNone|setupHomebrew_.*");
+    private static final Pattern JMF = Pattern.compile("jmf[A-Za-z]_.*");
+    /** GameOptionService.offerGameOptionButtons: the display toggles it posts (reactions, hex borders, PN area, rule links). */
+    private static final Pattern OPTIONS = Pattern.compile(
+            "enableAidReacts_.*|disableAidReacts|showHexBorders_.*|showOwnedPNsInPlayerArea_.*|injectRulesLinks_.*");
+
+    @Override
+    public String kind() {
+        return "setup.game_settings";
+    }
+
+    @Override
+    public int priority() {
+        return 30;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return handlerId.startsWith("chooseExp_")
+                || handlerId.startsWith("setupBaseGameMode")
+                || "miltySetup".equals(handlerId)
+                || "startDraftSystem".equals(handlerId)
+                || MODES.matcher(handlerId).matches()
+                || JMF.matcher(handlerId).matches()
+                || OPTIONS.matcher(handlerId).matches();
+    }
+
+    /** Official-only (web) games: homebrew / alternate-mode controls are not typed options and are refused. */
+    @Override
+    public boolean typesOption(String handlerId) {
+        return matches(handlerId) && !ti4.selfhost.engine.WebContent.refuses(handlerId);
+    }
+
+    @Override
+    public String validate(
+            ti4.game.Game game,
+            ti4.game.Player answering,
+            ti4.selfhost.engine.EngineModels.Decision decision,
+            String optionId) {
+        return ti4.selfhost.engine.WebContent.refuses(optionId)
+                ? "homebrew and alternate game modes are off on this server (official rules only)"
+                : null;
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        if (!matches(handlerId) || ti4.selfhost.engine.WebContent.refuses(handlerId)) return null;
+        if (handlerId.startsWith("chooseExp_"))
+            return v("expansion", handlerId.substring("chooseExp_".length()));
+        if (handlerId.startsWith("setupBaseGameMode"))
+            return v("base_game", handlerId.endsWith("_confirm") ? "confirm" : "ask");
+        if ("miltySetup".equals(handlerId)) return v("draft_start", "milty");
+        if ("startDraftSystem".equals(handlerId)) return v("draft_start", "draft_system");
+        if (JMF.matcher(handlerId).matches()) return v("draft_settings", handlerId.substring(5));
+        if (OPTIONS.matcher(handlerId).matches()) return v("game_options", handlerId);
+        return v("game_modes", handlerId);
+    }
+
+    private static Map<String, Object> v(String setting, String choice) {
+        return SetupKindSupport.map("setting", setting, "choice", choice);
+    }
+
+    @Override
+    public Target target(CaptureContext ctx, Target resolved) {
+        return "cards_thread".equals(resolved == null ? null : resolved.resolvedBy())
+                ? SetupKindSupport.refresh(ctx, resolved)
+                : null;
+    }
+
+    @Override
+    public boolean dynamic() {
+        return true;
+    }
+
+    /** Past setup this prompt is a leftover nobody needs (live: hundreds open across games, flooding the web queue). */
+    @Override
+    public boolean obsolete(CaptureContext ctx) {
+        return ti4.selfhost.engine.SetupStateBuilder.pastSetup(ctx.game());
+    }
+}
