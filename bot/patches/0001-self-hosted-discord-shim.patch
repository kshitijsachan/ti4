+package ti4.selfhost.engine.kinds;
+
+import java.util.List;
+
+/**
+ * Mahact Gene-Sorcerers (PoK): Imperia / Edict fleet tokens, Starlancer (mech), Jae Mir Kan (agent on
+ * Construction), Airo Shir Aur (hero, Benediction), Genetic Recombination (tech; that prompt goes to the voter).
