diff --git a/src/main/java/ti4/service/leader/LeaderLimitService.java b/src/main/java/ti4/service/leader/LeaderLimitService.java
new file mode 100644
index 0000000..2911928
--- /dev/null
+++ b/src/main/java/ti4/service/leader/LeaderLimitService.java
@@ -0,0 +1,201 @@
+package ti4.service.leader;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+import javax.annotation.Nullable;
+import lombok.experimental.UtilityClass;
+import ti4.game.Game;
+import ti4.game.Player;
+
+/**
+ * Card-text limits on leaders that the original buttons left to the honour system (rules audit, leaders N–Z /
+ * Keleres / Thunder's Edge). Deliberate improvements over the original code; each check is used by the bot handler
+ * (refuses the press) and by the engine's leader.use validate() (refuses the answer before it runs).
+ *
+ * <ul>
+ *   <li>Suffi An (kelerescommander) unlock: "Spend 1 trade good" — the original unlocked it for free at 0 TG.
+ *   <li>Dannel of the Tenth (yinhero): "Commit up to 3 infantry" in total — the original let every invasion land up
+ *       to 3 and offered the start button again.
+ *   <li>Field Marshal Mercer (nomadagentmercer): "remove up to 2 of their ground forces" — uncapped originally.
+ *   <li>G'hom Sek'kus (sardakkcommander): "up to 1 ground force from each planet" — originally a second button from
+ *       the same planet (other destination / other unit type) still moved one more.
+ *   <li>Kan Kip Rel (ralnelagent): give 1 drawn card "to another player" — the original offered yourself.
+ * </ul>
+ * The per-use counters live in stored values and are cleared at the end of the player's turn ({@link #clearTurn}); a
+ * counter that is absent means "not tracked" (e.g. a leader used before this change), which fails open.
+ */
+@UtilityClass
+public class LeaderLimitService {
+
+    public static final int YIN_HERO_INFANTRY = 3;
+    public static final int MERCER_GROUND_FORCES = 2;
+
+    private static String yinKey(Player p) {
+        return "yinHeroInfantryLeft" + p.getFaction();
+    }
+
+    private static String mercerKey(Player p) {
+        return "nomadMercerLeft" + p.getFaction();
+    }
+
+    private static String sardakkKey(Player p) {
+        return "sardakkCommanderFrom" + p.getFaction();
+    }
+
+    // ---------------------------------------------------------------- Suffi An (Keleres commander unlock)
+
+    @Nullable
+    public static String keleresCommanderPayRefusal(Player player) {
+        if (player.getTg() < 1) return "Unleashing Suffi An, the Keleres commander, costs 1 trade good; you have none.";
+        return null;
+    }
+
+    // ---------------------------------------------------------------- Dannel of the Tenth (Yin hero)
+
+    public static void startYinHero(Game game, Player player) {
+        game.setStoredValue(yinKey(player), String.valueOf(YIN_HERO_INFANTRY));
+    }
+
+    /** Infantry the Yin hero may still commit this action, or -1 when not tracked. */
+    public static int yinHeroLeft(Game game, Player player) {
+        String v = game.getStoredValue(yinKey(player));
+        try {
+            return v == null || v.isEmpty() ? -1 : Integer.parseInt(v);
+        } catch (NumberFormatException e) {
+            return -1;
+        }
+    }
+
+    @Nullable
+    public static String yinHeroRefusal(Game game, Player player, int amount) {
+        int left = yinHeroLeft(game, player);
+        if (left < 0) return null;
+        if (left == 0)
+            return "Dannel of the Tenth, the Yin hero, has already committed " + YIN_HERO_INFANTRY + " infantry.";
+        if (amount > left)
+            return "Dannel of the Tenth, the Yin hero, commits up to " + YIN_HERO_INFANTRY + " infantry in total; "
+                    + left + " left.";
+        return null;
+    }
+
+    public static void consumeYinHero(Game game, Player player, int amount) {
+        int left = yinHeroLeft(game, player);
+        if (left < 0) return;
+        game.setStoredValue(yinKey(player), String.valueOf(Math.max(0, left - amount)));
+    }
+
+    // ---------------------------------------------------------------- Field Marshal Mercer (Nomad agent)
+
+    public static void startMercer(Game game, Player player, String planet) {
+        game.setStoredValue(mercerKey(player), planet + "|" + MERCER_GROUND_FORCES);
+    }
+
+    /** Ground forces Mercer may still move onto this planet, or -1 when no Mercer use is tracked for it. */
+    public static int mercerLeft(Game game, Player player, String planet) {
+        String v = game.getStoredValue(mercerKey(player));
+        if (v == null || v.isEmpty()) return -1;
+        String[] parts = v.split("\\|");
+        if (parts.length != 2 || !parts[0].equalsIgnoreCase(planet)) return -1;
+        try {
+            return Integer.parseInt(parts[1]);
+        } catch (NumberFormatException e) {
+            return -1;
+        }
+    }
+
+    @Nullable
+    public static String mercerRefusal(Game game, Player player, String planet) {
+        if (mercerLeft(game, player, planet) == 0)
+            return "Field Marshal Mercer, the Nomad agent, moves up to " + MERCER_GROUND_FORCES
+                    + " ground forces; both have been moved.";
+        return null;
+    }
+
+    /** Records one move; returns the moves left (or -1 when not tracked). */
+    public static int consumeMercer(Game game, Player player, String planet) {
+        int left = mercerLeft(game, player, planet);
+        if (left < 0) return -1;
+        left = Math.max(0, left - 1);
+        game.setStoredValue(mercerKey(player), planet + "|" + left);
+        return left;
+    }
+
+    // ---------------------------------------------------------------- G'hom Sek'kus (Sardakk commander)
+
+    private static List<String> sardakkUsed(Game game, Player player) {
+        String v = game.getStoredValue(sardakkKey(player));
+        String active = String.valueOf(game.getActiveSystem());
+        if (v == null || v.isEmpty()) return new ArrayList<>();
+        String[] parts = v.split("\\|", 2);
+        if (parts.length != 2 || !parts[0].equals(active)) return new ArrayList<>();
+        return new ArrayList<>(Arrays.asList(parts[1].split(",")));
+    }
+
+    @Nullable
+    public static String sardakkCommanderRefusal(Game game, Player player, String fromPlanet) {
+        if (sardakkUsed(game, player).contains(fromPlanet))
+            return "G'hom Sek'kus, the Sardakk commander, commits up to 1 ground force from each planet; one already"
+                    + " came from this planet.";
+        return null;
+    }
+
+    public static void recordSardakkCommander(Game game, Player player, String fromPlanet) {
+        List<String> used = sardakkUsed(game, player);
+        used.add(fromPlanet);
+        game.setStoredValue(sardakkKey(player), String.valueOf(game.getActiveSystem()) + "|" + String.join(",", used));
+    }
+
+    // ---------------------------------------------------------------- Kan Kip Rel (Ral Nel agent)
+
+    @Nullable
+    public static String ralnelAgentRefusal(Player player, @Nullable Player recipient) {
+        if (recipient != null && recipient == player)
+            return "Kan Kip Rel, the Ral Nel agent, gives 1 of the drawn action cards to another player.";
+        return null;
+    }
+
+    // ---------------------------------------------------------------- shared
+
+    /** End of the player's turn: per-use counters end with it. */
+    public static void clearTurn(Game game, Player player) {
+        game.removeStoredValue(yinKey(player));
+        game.removeStoredValue(mercerKey(player));
+        game.removeStoredValue(sardakkKey(player));
+    }
+
+    /**
+     * The refusal for pressing this (FFCC_-stripped) handler id as this player, or null. Used by the engine's
+     * leader.use validate().
+     */
+    @Nullable
+    public static String refusal(Game game, Player player, String handler) {
+        if (game == null || player == null || handler == null) return null;
+        if ("pay1tgforKeleres".equals(handler)) return keleresCommanderPayRefusal(player);
+        if ("yinHeroStart".equals(handler)
+                || handler.startsWith("yinHeroTarget_")
+                || handler.startsWith("yinHeroPlanet_"))
+            return yinHeroLeft(game, player) == 0 ? yinHeroRefusal(game, player, 1) : null;
+        if (handler.startsWith("yinHeroInfantry_")) {
+            String[] a = handler.substring("yinHeroInfantry_".length()).split("_");
+            try {
+                return yinHeroRefusal(game, player, Integer.parseInt(a[a.length - 1]));
+            } catch (NumberFormatException e) {
+                return null;
+            }
+        }
+        if (handler.startsWith("mercerMove_") && !handler.contains("lizhobt")) {
+            String[] a = handler.split("_");
+            return a.length > 1 ? mercerRefusal(game, player, a[1]) : null;
+        }
+        if (handler.startsWith("handleRalNelAgentPt2_")) {
+            String[] a = handler.split("_");
+            return ralnelAgentRefusal(player, game.getPlayerFromColorOrFaction(a[a.length - 1]));
+        }
+        if (handler.startsWith("sardakkcommander_")) {
+            String[] a = handler.split("_");
+            return a.length > 3 ? sardakkCommanderRefusal(game, player, a[3]) : null;
+        }
+        return null;
+    }
+}
diff --git a/src/main/java/ti4/service/leader/LeaderRuleChecks.java b/src/main/java/ti4/service/leader/LeaderRuleChecks.java
new file mode 100644
index 0000000..7133409
--- /dev/null
+++ b/src/main/java/ti4/service/leader/LeaderRuleChecks.java
@@ -0,0 +1,160 @@
+package ti4.service.leader;
+
+import javax.annotation.Nullable;
+import lombok.experimental.UtilityClass;
+import ti4.game.Game;
+import ti4.game.Leader;
+import ti4.game.Player;
+import ti4.game.Tile;
+import ti4.game.UnitHolder;
+import ti4.helpers.ButtonHelper;
+import ti4.helpers.FoWHelper;
+import ti4.helpers.Units.UnitType;
+import ti4.service.unit.CheckUnitContainmentService;
+
+/**
+ * Card-text checks for leaders (agents, commanders, heroes) of the A–M factions that the original button handlers
+ * left to the list of buttons they posted (a stale button, a re-press or a typed answer could get past them). Each
+ * returns a refusal text, or null when the use is legal. Shared by the bot handlers and the engine kind
+ * (selfhost LeaderUseKind / ChooseConfirmKind / CombatRetreatKind validate) so both refuse the same things.
+ *
+ * <p>Deliberate improvements over the original code (rules audit "leaders A–M").
+ */
+@UtilityClass
+public class LeaderRuleChecks {
+
+    /** "Exhaust this card": the agent (or Ssruu standing in for it) must be readied. */
+    @Nullable
+    public static String agentNotReady(@Nullable Player player, @Nullable String agentId) {
+        if (player == null || agentId == null) return null;
+        Leader leader = player.getLeader(agentId).orElse(null);
+        if (leader == null) return null; // the handler already ignores agents the player does not have
+        if (leader.isExhausted()) return "That agent is already exhausted.";
+        return null;
+    }
+
+    /**
+     * Agents whose card names a target in the active system: Evelyn DeLouis (Sol: "choose 1 ground force in the
+     * active system") and Viscount Unlenn (Letnev: "choose 1 ship in the active system").
+     */
+    @Nullable
+    public static String agentTargetInActiveSystem(Game game, String agentId, @Nullable Player target) {
+        if (target == null) return null;
+        boolean sol = "solagent".equals(agentId);
+        boolean letnev = "letnevagent".equals(agentId);
+        if (!sol && !letnev) return null;
+        Tile tile = activeTile(game);
+        if (tile == null) return null;
+        if (letnev && !FoWHelper.playerHasShipsInSystem(target, tile))
+            return "Viscount Unlenn must choose a ship in the active system; that player has none there.";
+        if (sol) {
+            int gf = 0;
+            for (UnitHolder uh : tile.getUnitHolders().values()) gf += ButtonHelper.getNumberOfGroundForces(target, uh);
+            if (gf == 0)
+                return "Evelyn DeLouis must choose a ground force in the active system; that player has none there.";
+        }
+        return null;
+    }
+
+    /** I48S (L1Z1X agent): "replace 1 of their infantry in the active system". */
+    @Nullable
+    public static String l1z1xAgentTile(Game game, @Nullable String pos) {
+        String active = game.getActiveSystem();
+        if (active == null || active.isEmpty() || active.equals(pos)) return null;
+        return "I48S, the L1Z1X agent, can only replace an infantry in the active system.";
+    }
+
+    /** Carth of Golden Sands: "During the action phase". */
+    @Nullable
+    public static String hacanAgentPhase(Game game) {
+        String phase = game.getPhaseOfGame();
+        if (phase == null || phase.isEmpty() || phase.startsWith("action")) return null;
+        return "Carth of Golden Sands can only be used during the action phase.";
+    }
+
+    /**
+     * Riftwalker Meian: any 2 non-Fracture systems that contain wormholes or your units, other than the Creuss
+     * system, the Ahk Creuxx system or the Wormhole Nexus.
+     */
+    @Nullable
+    public static String creussHeroTile(Game game, Player player, @Nullable String pos) {
+        Tile tile = pos == null ? null : game.getTileByPosition(pos);
+        if (tile == null) return "That system is not on the board.";
+        if (tile.isFracture()) return "Riftwalker Meian cannot swap a Fracture system.";
+        String id = tile.getTileID() == null ? "" : tile.getTileID().toLowerCase();
+        if (id.matches("(51|118|82[ab])h?"))
+            return "Riftwalker Meian cannot swap the Creuss system, the Ahk Creuxx system or the Wormhole Nexus.";
+        if (!FoWHelper.doesTileHaveWHs(game, tile.getPosition()) && !FoWHelper.playerHasUnitsInSystem(player, tile))
+            return "Riftwalker Meian can only swap systems that contain wormholes or your units.";
+        return null;
+    }
+
+    /** Mirik Aun Sissiri: destination systems contain 1 of your command tokens and no other players' ships. */
+    @Nullable
+    public static String argentHeroDestination(Game game, Player player, @Nullable String pos) {
+        Tile tile = pos == null ? null : game.getTileByPosition(pos);
+        if (tile == null) return null;
+        if (FoWHelper.otherPlayersHaveShipsInSystem(player, tile, game))
+            return "Mirik Aun Sissiri can only move ships to systems that contain no other players' ships.";
+        return null;
+    }
+
+    /**
+     * Airo Shir Aur: in the space combat it starts "neither player can retreat or resolve abilities that would move
+     * their ships" (the combat in the active system while the hero's target is recorded, cleared at end of turn).
+     */
+    @Nullable
+    public static String benedictionRetreat(Game game, @Nullable String pos) {
+        if (pos == null || game.getStoredValue("mahactHeroTarget").isEmpty()) return null;
+        if (!pos.equals(game.getActiveSystem())) return null;
+        return "Neither player can retreat from a space combat started by Airo Shir Aur, the Mahact hero.";
+    }
+
+    /** S'ula Mentarion: "After you win a space combat" against that player. */
+    @Nullable
+    public static String mentakCommanderWon(Game game, Player mentak, @Nullable Player loser) {
+        Tile tile = activeTile(game);
+        if (tile == null || loser == null) return null;
+        if (FoWHelper.playerHasShipsInSystem(loser, tile) || !FoWHelper.playerHasShipsInSystem(mentak, tile))
+            return "S'ula Mentarion can only be used after you win a space combat against that player.";
+        return null;
+    }
+
+    /**
+     * Adjudicator Ba'al: the hero must be unlocked, and the system a non-home system other than Mecatol Rex (or the
+     * Fracture) that contains your war sun.
+     */
+    @Nullable
+    public static String novaSeed(Game game, Player muaat, @Nullable String pos) {
+        if (!muaat.hasLeaderUnlocked("muaathero")) return "Adjudicator Ba'al is not unlocked (or already purged).";
+        Tile tile = pos == null ? null : game.getTileByPosition(pos);
+        if (tile == null) return "That system is not on the board.";
+        if (!game.isWildWildGalaxyMode() && (tile.isMecatol(game) || tile.isHomeSystem(game)))
+            return "Adjudicator Ba'al cannot be used on a home system or Mecatol Rex.";
+        if (tile.isFracture()) return "Adjudicator Ba'al cannot be used on the Fracture.";
+        if (!CheckUnitContainmentService.getTilesContainingPlayersUnits(game, muaat, UnitType.Warsun)
+                .contains(tile)) return "Adjudicator Ba'al needs one of your war suns in that system.";
+        return null;
+    }
+
+    /**
+     * Sai Seravus: a fighter is placed with a ship that has capacity "if you have unused capacity in the active
+     * system" (only checked where the game tracks capacity).
+     */
+    @Nullable
+    public static String ghostCommanderCapacity(Game game, Player player, @Nullable String pos) {
+        if (player.hasUnit("tk-iffsupportwing") || !game.isCcNPlasticLimit()) return null;
+        Tile tile = pos == null ? null : game.getTileByPosition(pos);
+        if (tile == null) return null;
+        int[] cap = ButtonHelper.checkFleetAndCapacity(player, game, tile, false, false);
+        if (cap.length > 2 && cap[1] >= cap[2])
+            return "Sai Seravus needs unused capacity in that system to place a fighter.";
+        return null;
+    }
+
+    @Nullable
+    private static Tile activeTile(Game game) {
+        String active = game.getActiveSystem();
+        return active == null || active.isEmpty() ? null : game.getTileByPosition(active);
+    }
+}
