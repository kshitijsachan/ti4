+package ti4.selfhost.engine.kinds;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.selfhost.engine.EngineModels.Decision;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * Imperial primary scoring options on the Imperial strategy card prompt: score_imperial (1 VP for controlling Mecatol
+ * Rex) and scoreAnObjective (opens a "score a public objective" list, typed as status.score with an owner). Low
+ * priority on purpose: when the strategy-card area types that prompt (sc_follow_8 …) it owns the message and these
+ * stay untyped there; this kind only applies when no higher kind claims it.
+ *
+ * <p>value {action: "score_imperial", controlsMecatol: [userId]} | {action: "score_public_list"}.
+ */
+public class ImperialScoreKind implements KindSpec {
+
+    @Override
+    public String kind() {
+        return "status.imperial";
+    }
+
+    @Override
+    public int priority() {
+        return 20;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return "score_imperial".equals(handlerId) || "scoreAnObjective".equals(handlerId);
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        Map<String, Object> v = new LinkedHashMap<>();
+        if ("scoreAnObjective".equals(handlerId)) {
+            v.put("action", "score_public_list");
+            return v;
+        }
+        v.put("action", "score_imperial");
+        java.util.List<String> who = new java.util.ArrayList<>();
+        for (Player p : ctx.game().getRealPlayers()) {
+            try {
+                if (p.controlsMecatol(true)) who.add(p.getUserID());
+            } catch (Exception ignored) {
+                // best effort
+            }
+        }
+        v.put("controlsMecatol", who);
+        return v;
+    }
+
+    @Override
+    public String scope(CaptureContext ctx) {
+        return "table";
+    }
+
+    @Override
+    public String validate(Game game, Player answering, Decision decision, String optionId) {
+        String h = StatusScoreKind.handlerOf(decision, optionId);
+        if ("score_imperial".equals(h) && !answering.controlsMecatol(true))
+            return "Only the player who controls Mecatol Rex may score the Imperial point.";
+        return null;
+    }
+}
