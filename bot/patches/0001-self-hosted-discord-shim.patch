@@ -0,0 +1,65 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.Map;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.game.Tile;
+import ti4.helpers.Helper;
+import ti4.helpers.Units.UnitType;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * Thunder's Edge Construction primary, "produce" part (constructionPrimary_produce on the card, a
+ * strategy_card.resolve option): the system whose space dock uses its PRODUCTION, constructionBuild_&lt;pos&gt; (one per
+ * system with the holder's space docks; owner-prefixed, no decline). Pressing it opens the production menu
+ * (production.produce, context "construction").
+ *
+ * <p>value: {tile, home, productionLimit (the PRODUCTION value of one dock there, as the engine applies it),
+ * spaceDocks}.
+ */
+public class ConstructionBuildKind implements KindSpec {
+    private static final String PREFIX = "constructionBuild_";
+
+    @Override
+    public String kind() {
+        return "strategy_card.construction_build";
+    }
+
+    @Override
+    public int priority() {
+        return 100;
+    }
+
+    @Override
+    public boolean matches(String h) {
+        return h.startsWith(PREFIX) && h.length() > PREFIX.length();
+    }
+
+    @Override
+    public Map<String, Object> value(String h, CaptureContext ctx) {
+        String pos = h.substring(PREFIX.length());
+        Game game = ctx.game();
+        Player me = ctx.player();
+        Tile tile = game == null ? null : game.getTileByPosition(pos);
+        Integer limit = null;
+        int docks = 0;
+        if (tile != null && me != null) {
+            try {
+                limit = Helper.getProductionValue(me, game, tile, true);
+            } catch (RuntimeException e) {
+                limit = null;
+            }
+            for (var uh : tile.getUnitHolders().values()) docks += uh.getUnitCount(UnitType.Spacedock, me);
+        }
+        Map<String, Object> v = SetupKindSupport.map("tile", pos);
+        v.put("home", tile != null && me != null && tile == me.getHomeSystemTile());
+        v.put("productionLimit", limit);
+        v.put("spaceDocks", docks);
+        return v;
+    }
+
+    @Override
+    public String scope(CaptureContext ctx) {
+        return "player";
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/ConstructionPlaceKind.java b/src/main/java/ti4/selfhost/engine/kinds/ConstructionPlaceKind.java
