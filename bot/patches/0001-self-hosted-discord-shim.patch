@@ -0,0 +1,78 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.selfhost.engine.EngineModels.Decision;
+import ti4.selfhost.engine.EngineModels.Target;
+import ti4.selfhost.engine.KindSpec;
+import ti4.service.milty.MiltyDraftManager;
+
+/**
+ * Milty draft pick: milty_&lt;category&gt;_&lt;value&gt; on the shared draft board in the main channel. The board is
+ * not addressed to anyone; the target is the draft's current player (re-resolved on every state change).
+ */
+public class MiltyDraftPickKind implements KindSpec {
+
+    @Override
+    public String kind() {
+        return "draft.milty.pick";
+    }
+
+    @Override
+    public int priority() {
+        return 100;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return handlerId.startsWith("milty_");
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        if (!matches(handlerId)) return null;
+        String rest = handlerId.substring("milty_".length());
+        int us = rest.indexOf('_');
+        Map<String, Object> v = new LinkedHashMap<>();
+        // categories seen: slice, faction, order
+        v.put("category", us < 0 ? rest : rest.substring(0, us));
+        v.put("pick", us < 0 ? "" : rest.substring(us + 1));
+        return v;
+    }
+
+    @Override
+    public Target target(CaptureContext ctx, Target resolved) {
+        return currentDrafter(ctx.game());
+    }
+
+    @Override
+    public boolean dynamicTarget() {
+        return true;
+    }
+
+    @Override
+    public String scope(CaptureContext ctx) {
+        return "player";
+    }
+
+    @Override
+    public String validate(Game game, Player answering, Decision decision, String optionId) {
+        MiltyDraftManager m = game.getMiltyDraftManager();
+        Player cur = m == null ? null : m.getCurrentDraftPlayer(game);
+        if (cur == null || cur != answering) return "It is not your turn to draft.";
+        return null;
+    }
+
+    public static Target currentDrafter(Game game) {
+        try {
+            MiltyDraftManager m = game.getMiltyDraftManager();
+            Player p = m == null ? null : m.getCurrentDraftPlayer(game);
+            if (p == null) return new Target(null, null, null, "draft_turn");
+            return new Target(p.getUserID(), p.getFaction(), p.getColor(), "draft_turn");
+        } catch (Exception e) {
+            return new Target(null, null, null, "draft_turn");
+        }
+    }
+}
