@@ -0,0 +1,67 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.selfhost.engine.EngineModels.Decision;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * Politics primary, parts 2–3: look at the top 2 agendas (drawAgenda_2, after the speaker is assigned), then put each
+ * on the top or bottom of the deck (topAgenda_&lt;handle&gt; / bottomAgenda_&lt;handle&gt; / discardAgenda_&lt;handle&gt;, one
+ * message per agenda in the holder's cards-info thread). The handle is resolved to the agenda id.
+ * value: {action:"draw", count} | {action:"top"|"bottom"|"discard", handle, agenda, placedThisRound}.
+ */
+public class PoliticsAgendaKind implements KindSpec {
+
+    @Override
+    public String kind() {
+        return "strategy_card.politics_agenda";
+    }
+
+    @Override
+    public int priority() {
+        return 90;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return "drawAgenda_2".equals(handlerId) || handlerId.matches("(top|bottom|discard)Agenda_\\d+");
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        Map<String, Object> v = new LinkedHashMap<>();
+        Game game = ctx.game();
+        if ("drawAgenda_2".equals(handlerId)) {
+            v.put("action", "draw");
+            v.put("count", 2);
+            return v;
+        }
+        int us = handlerId.indexOf("Agenda_");
+        int handle = Integer.parseInt(handlerId.substring(us + "Agenda_".length()));
+        v.put("action", handlerId.substring(0, us));
+        v.put("handle", handle);
+        String agenda = null;
+        for (Map.Entry<String, Integer> e : game.getSentAgendas().entrySet())
+            if (e.getValue() != null && e.getValue() == handle) agenda = e.getKey();
+        v.put("agenda", agenda);
+        String placed = game.getStoredValue("round" + game.getRound() + "AgendaPlacement");
+        v.put("placedThisRound", placed.isEmpty() ? 0 : placed.split("_").length);
+        return v;
+    }
+
+    @Override
+    public String scope(CaptureContext ctx) {
+        return "player";
+    }
+
+    @Override
+    public String validate(Game game, Player answering, Decision decision, String optionId) {
+        Map<String, Object> v = StrategyCards.optionValue(decision, optionId);
+        if (v != null && "draw".equals(v.get("action")) && !game.getStoredValue("hasntSetSpeaker").isEmpty())
+            return "Assign the speaker token before looking at the agendas.";
+        return null;
+    }
+}
