+package ti4.selfhost.engine;
+
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import javax.annotation.Nullable;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.helpers.Constants;
+import ti4.selfhost.engine.EngineModels.BreakthroughState;
+import ti4.selfhost.engine.EngineModels.ThundersEdgeState;
+import ti4.service.map.FractureService;
+
+/** The Thunder's Edge part of {@link EngineModels.GameState} (G10). Null for games without Thunder's Edge. */
+public final class ThundersEdgeStateBuilder {
+    private ThundersEdgeStateBuilder() {}
+
+    @Nullable
+    public static ThundersEdgeState build(Game game) {
+        try {
+            if (!game.isThundersEdge()) return null;
+            Map<String, String> expeditions = new LinkedHashMap<>(game.getExpeditions().getExpeditionFactions());
+            Map<String, List<BreakthroughState>> bts = new LinkedHashMap<>();
+            for (Player p : game.getRealPlayers()) {
+                if (p.getFaction() == null || p.getBreakthroughIDs().isEmpty()) continue;
+                List<BreakthroughState> list = new ArrayList<>();
+                for (String bt : p.getBreakthroughIDs()) {
+                    list.add(new BreakthroughState(
+                            bt,
+                            p.isBreakthroughUnlocked(bt),
+                            p.isBreakthroughExhausted(bt),
+                            p.isBreakthroughActive(bt),
+                            p.getBreakthroughTGs(bt)));
+                }
+                bts.put(p.getFaction(), list);
+            }
+            return new ThundersEdgeState(
+                    FractureService.isFractureInPlay(game),
+                    game.getTileFromPlanet(Constants.THUNDERSEDGE) != null,
+                    expeditions,
+                    bts);
+        } catch (Exception e) {
+            return null;
+        }
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/TradeActionController.java b/src/main/java/ti4/selfhost/engine/TradeActionController.java
new file mode 100644
index 0000000..6d4295a
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/TradeActionController.java
@@ -0,0 +1,67 @@
+package ti4.selfhost.engine;
+
+import java.util.Map;
+import org.springframework.http.CacheControl;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.security.access.prepost.PreAuthorize;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestHeader;
+import org.springframework.web.bind.annotation.RestController;
+import ti4.spring.api.selfhost.TradeModels.ProposeRequest;
+import ti4.spring.api.selfhost.TradeModels.TradeSide;
+import ti4.spring.context.RequestContext;
+import ti4.spring.context.SetupRequestContext;
+
+/**
+ * Typed action {@code trade.propose}: send a transaction offer (the receiver gets a {@code trade.offer} decision).
+ * Proposing again to the same player replaces the open offer (the bot only accepts the newest).
+ * <ul>
+ *   <li>{@code POST /api/public/selfhost/engine/{game}/actions/trade.propose} — Bot token, body
+ *   {@code {userId, to, give, receive, note}} (the shim, for autopilot seats)</li>
+ *   <li>{@code POST /api/game/{gameName}/engine/actions/trade.propose} — seat Bearer, body {@code {to, give, receive,
+ *   note}} (lock + save by the request interceptor)</li>
+ * </ul>
+ */
+@RestController
+public class TradeActionController {
+
+    public record ProposeBody(String userId, String to, TradeSide give, TradeSide receive, String note) {
+        ProposeRequest request() {
+            return new ProposeRequest(to, give, receive, note);
+        }
+    }
+
+    @PostMapping("/api/public/selfhost/engine/{game}/actions/trade.propose")
+    public ResponseEntity<?> proposeAs(
+            @PathVariable String game,
+            @RequestBody ProposeBody body,
+            @RequestHeader(value = "Authorization", required = false) String auth) {
+        if (!EngineController.trusted(auth))
+            return ResponseEntity.status(HttpStatus.UNAUTHORIZED).body(Map.of("error", "bot token required"));
+        if (body == null || body.userId() == null)
+            return ResponseEntity.badRequest().body(Map.of("error", "userId required"));
+        return respond(TradeEngine.propose(game, body.userId(), body.request()));
+    }
+
+    @PostMapping("/api/game/{gameName}/engine/actions/trade.propose")
+    @PreAuthorize("@security.canAccessGame(#gameName)")
+    // Same path as the bot route (own lock + save, then capture reads the saved game); no request-scoped copy.
+    @SetupRequestContext(false)
+    public ResponseEntity<?> propose(@PathVariable String gameName, @RequestBody ProposeBody body) {
+        return respond(TradeEngine.propose(gameName, RequestContext.getUserId(), body.request()));
+    }
+
+    private static ResponseEntity<?> respond(TradeEngine.ProposeResult r) {
+        HttpStatus status = switch (r.status()) {
+            case "done" -> HttpStatus.OK;
+            case "forbidden" -> HttpStatus.FORBIDDEN;
+            case "not_found" -> HttpStatus.NOT_FOUND;
+            case "error" -> HttpStatus.INTERNAL_SERVER_ERROR;
+            default -> HttpStatus.UNPROCESSABLE_ENTITY;
+        };
+        return ResponseEntity.status(status).cacheControl(CacheControl.noStore()).body(r);
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/TradeEngine.java b/src/main/java/ti4/selfhost/engine/TradeEngine.java
new file mode 100644
index 0000000..f9e2a0c
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/TradeEngine.java
@@ -0,0 +1,223 @@
+package ti4.selfhost.engine;
+
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.concurrent.ConcurrentHashMap;
+import javax.annotation.Nullable;
+import ti4.executors.ExecutionLockManager;
+import ti4.executors.ExecutionLockType;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.game.persistence.GameManager;
+import ti4.game.persistence.ManagedGame;
+import ti4.logging.BotLogger;
+import ti4.selfhost.engine.EngineModels.Decision;
+import ti4.selfhost.engine.EngineModels.Option;
+import ti4.spring.api.selfhost.TradeModels.ProposeRequest;
+import ti4.spring.api.selfhost.TradeModels.ProposeResponse;
+import ti4.spring.api.selfhost.TradeModels.TradeCounterparty;
+import ti4.spring.api.selfhost.TradeModels.TradeItem;
+import ti4.spring.api.selfhost.TradeModels.TradeOptions;
+import ti4.spring.api.selfhost.TradeModels.TradeSelf;
+import ti4.spring.api.selfhost.TradeService;
+
+/**
+ * Transactions in the engine API: the viewer's {@link TradeState} (part of {@link EngineModels.GameState}) and the
+ * typed {@code trade.propose} action. Offers themselves are bot transactions ({@link TradeService#propose} writes the
+ * transaction items and calls the bot's own sendOffer), answered through the {@code trade.offer} decision.
+ *
+ * <p>Rule (LRR 94): players transact only with neighbours, except in the agenda phase (anyone) and with an ability
+ * that lifts it (Hacan Guild Ships, Trade Convoys in play, both own a space station, Age of Commerce). The bot's own
+ * check is looser outside the action phase; {@link TradeState#mayTransactWith} is the strict one and
+ * {@code trade.propose} enforces it.
+ */
+public final class TradeEngine {
+    private TradeEngine() {}
+
+    private static final TradeService SERVICE = new TradeService();
+    private static final List<String> CONVOYS = List.of("convoys", "sigma_trade_convoys", "viability_trade_convoys");
+
+    /**
+     * The viewer's trade view.
+     *
+     * @param blockedReason     non-null when the viewer cannot propose anything now (fog of war, old transaction
+     *                          model, Hidden Agenda in the agenda phase, Policy - The People: Control)
+     * @param me                what the viewer could put into an offer (own PNs / action cards: private)
+     * @param partners          every other player: public counts, requestable PNs, the bot's {@code canTrade}
+     * @param mayTransactWith   factions the viewer may transact with now under the strict neighbour rule
+     * @param incoming          open, current offers to the viewer (answer via the trade.offer decision)
+     * @param outgoing          open, current offers from the viewer
+     */
+    public record TradeState(
+            String phase,
+            String blockedReason,
+            boolean newTransactionModel,
+            TradeSelf me,
+            List<TradeCounterparty> partners,
+            List<String> mayTransactWith,
+            List<OpenOffer> incoming,
+            List<OpenOffer> outgoing) {}
+
+    /** decisionId: the receiver's trade.offer decision (private to them). */
+    public record OpenOffer(String from, String to, int offerNumber, List<TradeItem> items, String decisionId) {}
+
+    public record ProposeResult(
+            boolean ok,
+            String status,
+            String error,
+            Integer offerNumber,
+            String to,
+            List<TradeItem> items,
+            long seq,
+            long stateVersion) {}
+
+    private record Cached(long version, TradeOptions options, List<String> may) {}
+
+    /** (game|viewer) → options at a state version: neighbour checks are not cheap and /state is read often. */
+    private static final Map<String, Cached> cache = new ConcurrentHashMap<>();
+
+    // ------------------------------------------------------------------ state
+
+    @Nullable
+    public static TradeState state(Game game, @Nullable String viewerUserId) {
+        if (viewerUserId == null) return null;
+        Player me = game.getPlayer(viewerUserId);
+        if (me == null || !me.isRealPlayer()) return null;
+        try {
+            String key = game.getName() + "|" + viewerUserId;
+            Cached c = cache.get(key);
+            if (c == null || c.version() != game.getLastModifiedDate()) {
+                TradeOptions o = SERVICE.options(game, me);
+                List<String> may = new ArrayList<>();
+                for (TradeCounterparty cp : o.counterparties()) {
+                    Player p = game.getPlayerFromColorOrFaction(cp.faction());
+                    if (p != null && cp.canTrade() && (cp.neighbor() || ruleExempt(game, me, p))) may.add(cp.faction());
+                }
+                c = new Cached(game.getLastModifiedDate(), o, may);
+                cache.put(key, c);
+            }
+            List<OpenOffer> in = new ArrayList<>();
+            List<OpenOffer> out = new ArrayList<>();
+            for (OpenOffer offer : openOffers(game)) {
+                if (offer.to().equals(me.getFaction())) in.add(offer);
+                if (offer.from().equals(me.getFaction())) out.add(offer);
+            }
+            TradeOptions o = c.options();
+            return new TradeState(
+                    game.getPhaseOfGame(),
+                    o.blockedReason(),
+                    o.newTransactionModel(),
+                    o.me(),
+                    o.counterparties(),
+                    c.may(),
+                    in,
+                    out);
+        } catch (Exception e) {
+            BotLogger.error("engine: trade state for " + game.getName() + " failed", e);
+            return null;
+        }
+    }
+
+    /** Neighbour rule exceptions (LRR 94 + the abilities the bot knows). */
+    static boolean ruleExempt(Game game, Player a, Player b) {
+        String phase = game.getPhaseOfGame() == null ? "" : game.getPhaseOfGame().toLowerCase(Locale.ROOT);
+        if (phase.contains("agenda")) return true;
+        if (game.isAgeOfCommerceMode()) return true;
+        if (a.hasSpaceStation() && b.hasSpaceStation()) return true;
+        for (Player p : List.of(a, b)) {
+            if (p.hasAbility("guild_ships")) return true;
+            for (String pn : CONVOYS) if (p.getPromissoryNotesInPlayArea().contains(pn)) return true;
+        }
+        return false;
+    }
+
+    /** Current offers with an open trade.offer decision, newest per sender → receiver pair. */
+    static List<OpenOffer> openOffers(Game game) {
+        Map<String, OpenOffer> byPair = new LinkedHashMap<>();
+        for (Decision d : DecisionRegistry.openDecisions(game.getName())) {
+            if (!"trade.offer".equals(d.kind()) || d.target() == null) continue;
+            Map<String, Object> v = null;
+            for (Option o : d.options()) if (o.value() != null && "accept".equals(o.value().get("action"))) v = o.value();
+            if (v == null) continue;
+            Player from = game.getPlayerFromColorOrFaction(String.valueOf(v.get("from")));
+            Player to = d.target().userId() == null ? null : game.getPlayer(d.target().userId());
+            Integer n = v.get("offerNumber") instanceof Integer i ? i : null;
+            if (from == null || to == null || !isCurrent(game, from, to, n)) continue;
+            byPair.put(from.getFaction() + ">" + to.getFaction(),
+                    new OpenOffer(from.getFaction(), to.getFaction(), n == null ? latest(game, from, to) : n,
+                            items(game, from, to), d.id()));
+        }
+        return new ArrayList<>(byPair.values());
+    }
+
+    /** The sender's transaction items with the receiver, decoded (empty once accepted or rescinded). */
+    public static List<TradeItem> items(Game game, Player from, Player to) {
+        return TradeService.decode(game, from.getTransactionItemsWithPlayer(to));
+    }
+
+    /** The bot accepts only the newest offer from a sender, and only while its items are still there. */
+    public static boolean isCurrent(Game game, Player from, Player to, @Nullable Integer offerNumber) {
+        if (from.getTransactionItemsWithPlayer(to).isEmpty()) return false;
+        return offerNumber == null || offerNumber == latest(game, from, to);
+    }
+
+    private static int latest(Game game, Player from, Player to) {
+        try {
+            return Integer.parseInt(game.getStoredValue("offerFrom" + from.getFaction() + "To" + to.getFaction()));
+        } catch (NumberFormatException e) {
+            return -1;
+        }
+    }
+
+    // ------------------------------------------------------------------ action: trade.propose
+
+    /**
+     * Proposes an offer as {@code userId}: takes the game's write lock, enforces the strict neighbour rule, writes the
+     * transaction and sends it (receiver gets a trade.offer decision), saves.
+     */
+    public static ProposeResult propose(String gameName, String userId, ProposeRequest req) {
+        ManagedGame mg = GameManager.isValid(gameName) ? GameManager.getManagedGame(gameName) : null;
+        if (mg == null || mg.getGame() == null) return fail("not_found", "No such game.");
+        ExecutionLockManager.lock(gameName, ExecutionLockType.WRITE);
+        try {
+            Game game = mg.getGame();
+            Player me = game.getPlayer(userId);
+            if (me == null || !me.isRealPlayer()) return fail("forbidden", "You are not a player of this game.");
+            ProposeResult r = proposeLocked(game, me, req);
+            if (r.ok()) GameManager.save(game, me.getUserName() + " proposed a transaction (engine)");
+            return r.ok()
+                    ? new ProposeResult(true, "done", null, r.offerNumber(), r.to(), r.items(),
+                            DecisionRegistry.currentSeq(), game.getLastModifiedDate())
+                    : r;
+        } finally {
+            ExecutionLockManager.unlock(gameName, ExecutionLockType.WRITE);
+        }
+    }
+
+    /** Caller holds the game's write lock and saves afterwards. */
+    public static ProposeResult proposeLocked(Game game, Player me, ProposeRequest req) {
+        if (req == null || req.to() == null || req.to().isBlank()) return fail("refused", "Missing 'to'.");
+        Player them = game.getPlayerFromColorOrFaction(req.to().toLowerCase(Locale.ROOT));
+        if (them == null) them = game.getPlayer(req.to());
+        if (them == null || them == me || !them.isRealPlayer()) return fail("refused", "Unknown trade partner: " + req.to());
+        if (!me.isNeighboursWith(them) && !ruleExempt(game, me, them))
+            return fail("refused", "You may only transact with neighbours outside the agenda phase.");
+        try {
+            ProposeResponse res = SERVICE.propose(game, me, req);
+            return new ProposeResult(true, "done", null, res.offerNumber(), res.to(), res.items(),
+                    DecisionRegistry.currentSeq(), game.getLastModifiedDate());
+        } catch (TradeService.TradeException e) {
+            return fail("refused", e.getMessage());
+        } catch (Exception e) {
+            BotLogger.error("engine: trade.propose in " + game.getName() + " failed", e);
+            return fail("error", String.valueOf(e.getMessage()));
+        }
+    }
+
+    private static ProposeResult fail(String status, String error) {
+        return new ProposeResult(false, status, error, null, null, List.of(), DecisionRegistry.currentSeq(), 0);
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/UndoGroup.java b/src/main/java/ti4/selfhost/engine/UndoGroup.java
new file mode 100644
index 0000000..89ef450
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/UndoGroup.java
@@ -0,0 +1,69 @@
+package ti4.selfhost.engine;
+
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.StandardCopyOption;
+import java.util.List;
+import ti4.helpers.Constants;
+import ti4.helpers.Storage;
+import ti4.logging.BotLogger;
+import ti4.service.game.GameUndoNameService;
+
+/**
+ * One undo step per engine answer. A payload answer (payment, production, agenda vote, token split…) makes several
+ * presses, and the bot saves an undo snapshot after each ({@code <game>_N.txt}). Once the answer is done we collapse
+ * them: the last snapshot becomes {@code before + 1} and the intermediate ones go, so the UNDO button, {@code /game
+ * undo} and the web undo / rewind take the whole answer back in one step (the web's flow grouping is not needed for
+ * engine answers). Callers hold the game's WRITE lock, so no other save interleaves.
+ */
+final class UndoGroup {
+    private UndoGroup() {}
+
+    /** The latest undo snapshot number now (-1 when none). */
+    static int latest(String gameName) {
+        try {
+            return GameUndoNameService.getLatestUndoNumber(gameName);
+        } catch (Exception e) {
+            return -1;
+        }
+    }
+
+    /**
+     * Collapses the snapshots made after {@code before} into one, labelled {@code label} as pressed by {@code by}.
+     * No-op when the answer made fewer than two snapshots or the numbering is not contiguous.
+     */
+    static void collapse(String gameName, int before, String by, String label) {
+        if (before < 0) return;
+        try {
+            List<Integer> numbers = GameUndoNameService.getSortedUndoNumbers(gameName);
+            if (numbers.isEmpty()) return;
+            int last = numbers.getLast();
+            if (last - before < 2) return;
+            for (int i = before + 1; i <= last; i++) if (!numbers.contains(i)) return;
+            Path target = file(gameName, before + 1);
+            Files.move(file(gameName, last), target, StandardCopyOption.REPLACE_EXISTING);
+            for (int i = before + 2; i < last; i++) Files.deleteIfExists(file(gameName, i));
+            relabel(target, by + " pressed button: " + label + " (engine answer)");
+            EngineMetrics.count("answer.undo_collapsed");
+        } catch (Exception e) {
+            BotLogger.error("engine: could not group the undo snapshots of an answer in " + gameName, e);
+        }
+    }
+
+    private static Path file(String gameName, int index) {
+        return Storage.getGameUndo(gameName, gameName + "_" + index + Constants.TXT);
+    }
+
+    /** Rewrites the snapshot's {@code latest_command} line (what the undo list shows for it). */
+    private static void relabel(Path snapshot, String command) throws Exception {
+        List<String> lines = Files.readAllLines(snapshot, StandardCharsets.UTF_8);
+        for (int i = 0; i < lines.size(); i++) {
+            if (lines.get(i).startsWith("latest_command ")) {
+                lines.set(i, "latest_command " + command.replace('\n', ' '));
+                Files.write(snapshot, lines, StandardCharsets.UTF_8);
+                return;
+            }
+        }
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/WebContent.java b/src/main/java/ti4/selfhost/engine/WebContent.java
new file mode 100644
index 0000000..093681c
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/WebContent.java
@@ -0,0 +1,209 @@
+package ti4.selfhost.engine;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+import java.util.Set;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.regex.Pattern;
+import ti4.discord.interactions.routing.ComponentIdEnvelope;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.image.Mapper;
+import ti4.logging.BotLogger;
+import ti4.model.DeckModel;
+import ti4.model.FactionModel;
+import ti4.model.LeaderModel;
+import ti4.selfhost.SelfHosted;
+
+/**
+ * Homebrew is OFF for games on the self-hosted (web) server: the web client, the lobby / solo steward and the bot
+ * autopilot only support the official game (base + Prophecy of Kings + Thunder's Edge, codices). Two layers:
+ *
+ * <ol>
+ *   <li>{@link #refuses(String)}: the game-creation controls that switch homebrew content on (Supported Homebrew,
+ *       Galactic Events / Dane modes, Twilight's Fall, Franken, TK Nova / Twilight DS setups, the Nucleus / new draft
+ *       system (startDraftSystem), homebrew sources in the Milty settings) are not offered ({@code CreateGameService}) and refused when pressed ({@code
+ *       ButtonProcessor}, one-line hooks).
+ *   <li>{@link #violations(Game)}: the invariant — the list of homebrew modes / unofficial components a game has.
+ *       {@link #check(Game)} runs it after every save of a self-hosted game and logs an error (+ metric
+ *       {@code invariant.homebrew}) once per game when it is not empty. tests/engine invariants check the save file
+ *       for the same flags ({@code content.no-homebrew}).
+ * </ol>
+ *
+ * This is what lets the legacy-deletion work ignore homebrew / Discordant Stars / Twilight's Fall / Monuments /
+ * fog-of-war handlers: a web game can never reach them.
+ */
+public final class WebContent {
+    private WebContent() {}
+
+    public static final String REFUSED_HANDLER_ID = "selfhost.homebrew_off";
+
+    /** Handler ids (after the owner envelope) that turn homebrew content on. */
+    private static final Pattern HOMEBREW_CONTROLS = Pattern.compile(
+            "getHomebrewButtons|offerGameHomebrewButtons|setupHomebrew_.*|enableDaneMode_.*_enable"
+                    + "|offerTEOptionButtons|startTFGame|startTFDraft.*|editTFHomebrew|toggleTfHomebrew_.*"
+                    + "|frankenSetup|tkNovaSetup_.*|twilightDSSetup_.*|oplusplusSetup_.*"
+                    // The new draft system (DraftManager, jwds_ buttons): only Nucleus setups start it; the official
+                    // Milty draft runs on MiltyService (miltySetup / jmfA_ settings).
+                    + "|startDraftSystem.*"
+                    // Milty / draft settings: homebrew sources, DS/BR-only factions, Alliance.
+                    + "|jmfA_.*_tog(Beta|DiscoStars|UnchartSpace|BlueReverie|Absol|Ignis\\w*|Eronous|WhispersVoid"
+                    + "|DeepReaches|LostLegacies|Monuments|EchoesOfYggdrasil|ActionCardDeck2|DsBrFactionsOnly|Alliance)");
+
+    /**
+     * Official-only gate: on for the self-hosted (web) server unless {@code TI4_OFFICIAL_ONLY=off} (also honoured as a
+     * JVM property {@code ti4.officialOnly=false}).
+     */
+    public static boolean homebrewOff() {
+        String env = System.getenv("TI4_OFFICIAL_ONLY");
+        String prop = System.getProperty("ti4.officialOnly");
+        if ("off".equalsIgnoreCase(env) || "false".equalsIgnoreCase(env) || "false".equalsIgnoreCase(prop)) return false;
+        return SelfHosted.isEnabled() || "on".equalsIgnoreCase(env) || "true".equalsIgnoreCase(prop);
+    }
+
+    /**
+     * The game uses only official content (base, PoK, Thunder's Edge, codices) and no alternate mode. Unlike
+     * {@code Game.hasHomebrew()} this ignores the player count (that one is true below 3 or above 8 players).
+     */
+    public static boolean officialOnly(Game game) {
+        return violations(game).isEmpty();
+    }
+
+    /** Is this (raw or decoded) component id a control that would switch homebrew on, and homebrew is off? */
+    public static boolean refuses(String componentId) {
+        if (componentId == null || !homebrewOff()) return false;
+        String h;
+        try {
+            h = ComponentIdEnvelope.decode(componentId).handlerId();
+        } catch (RuntimeException e) {
+            h = componentId;
+        }
+        return h != null && HOMEBREW_CONTROLS.matcher(h).matches();
+    }
+
+    /**
+     * Button pre-dispatch hook: refuses a homebrew control with an ephemeral note; true = do not run the handler.
+     */
+    public static boolean refuse(ti4.discord.interactions.listeners.context.ButtonContext context) {
+        if (!refuses(context.getButtonID())) return false;
+        context.setShouldSave(false);
+        ti4.message.MessageHelper.sendEphemeralMessageToEventChannel(
+                context.getEvent(),
+                "Homebrew and alternate game modes are not available on this server: games use the official rules"
+                        + " (base game, Prophecy of Kings, Thunder's Edge).");
+        EngineMetricsBridge.count("homebrew.refused");
+        return true;
+    }
+
+    /** Homebrew modes and unofficial components this game has (empty = official game). Player count is not checked. */
+    public static List<String> violations(Game g) {
+        List<String> v = new ArrayList<>();
+        if (g == null) return v;
+        flag(v, "homebrew", g.isHomebrew());
+        flag(v, "extra_secret", g.isExtraSecretMode());
+        flag(v, "fow", g.isFowMode());
+        flag(v, "facilities", g.isFacilitiesMode());
+        flag(v, "light_fog", g.isLightFogMode());
+        flag(v, "red_tape", g.isRedTapeMode());
+        flag(v, "discordant_stars", g.isDiscordantStarsMode());
+        flag(v, "blue_reverie", g.isBlueReverieMode());
+        flag(v, "uncharted_space", g.isUnchartedSpaceStuff());
+        flag(v, "franken", g.isFrankenGame());
+        flag(v, "miltymod", g.isMiltyModMode());
+        flag(v, "twilight_kart", g.isTwilightKart() || g.isTkDestroyerCup() || g.isTkNovaCup());
+        flag(v, "tf_br", g.isTfBr());
+        flag(v, "twilight_ds", g.isTwilightDS());
+        flag(v, "twilights_fall", g.isTwilightsFallMode());
+        flag(v, "monuments", g.isMonumentsMode() || g.isMonumentToTheAgesMode());
+        flag(v, "muaat_mania", g.isMuaatManiaMode());
+        flag(v, "cosmic_convergence", g.isCosmicConvergenceMode());
+        flag(v, "liberation", g.isLiberationC4Mode());
+        flag(v, "erwans_gambit", g.isErwansGambitMode());
+        flag(v, "ordinian", g.isOrdinianC1Mode());
+        flag(v, "absol", g.isAbsolMode());
+        flag(v, "votc", g.isVotcMode());
+        flag(v, "omega_phase", g.isOmegaPhaseMode());
+        flag(v, "promises_promises", g.isPromisesPromisesMode());
+        flag(v, "flagshipping", g.isFlagshippingMode());
+        flag(v, "spin", g.getSpinMode() != null && !"OFF".equalsIgnoreCase(g.getSpinMode()));
+        flag(v, "homebrew_sc", g.isHomebrewSCMode());
+        flag(v, "community", g.isCommunityMode());
+        flag(v, "alliance", g.isAllianceMode());
+        flag(v, "acd2", g.isAcd2());
+        // Galactic events / Dane modes.
+        flag(v, "minor_factions", g.isMinorFactionsMode());
+        flag(v, "age_of_exploration", g.isAgeOfExplorationMode());
+        flag(v, "hidden_agenda", g.isHiddenAgendaMode());
+        flag(v, "total_war", g.isTotalWarMode());
+        flag(v, "dangerous_wilds", g.isDangerousWildsMode());
+        flag(v, "stellar_atomics", g.isStellarAtomicsMode());
+        flag(v, "civilized_society", g.isCivilizedSocietyMode());
+        flag(v, "age_of_fighters", g.isAgeOfFightersMode());
+        flag(v, "advent_of_the_warsun", g.isAdventOfTheWarsunMode());
+        flag(v, "cultural_exchange", g.isCulturalExchangeProgramMode());
+        flag(v, "conventions_abandoned", g.isConventionsOfWarAbandonedMode());
+        flag(v, "rapid_mobilization", g.isRapidMobilizationMode());
+        flag(v, "weird_wormholes", g.isWeirdWormholesMode());
+        flag(v, "cosmic_phenomenae", g.isCosmicPhenomenaeMode());
+        flag(v, "wild_wild_galaxy", g.isWildWildGalaxyMode());
+        flag(v, "zealous_orthodoxy", g.isZealousOrthodoxyMode());
+        flag(v, "mercenaries_for_hire", g.isMercenariesForHireMode());
+        flag(v, "age_of_commerce", g.isAgeOfCommerceMode());
+        for (String deck : new String[] {
+            g.getAcDeckID(), g.getSoDeckID(), g.getStage1PublicDeckID(), g.getStage2PublicDeckID(),
+            g.getRelicDeckID(), g.getAgendaDeckID(), g.getExplorationDeckID(), g.getTechnologyDeckID()
+        }) {
+            if (deck == null || "null".equals(deck) || deck.isBlank()) continue;
+            DeckModel m = Mapper.getDeck(deck);
+            if (m != null && m.getSource() != null && !m.getSource().isOfficial()) v.add("deck:" + deck);
+        }
+        for (Player p : g.getRealAndEliminatedAndDummyPlayers()) {
+            FactionModel f = p.getFaction() == null ? null : Mapper.getFaction(p.getFaction());
+            if (f != null && f.getSource() != null && !f.getSource().isOfficial()) v.add("faction:" + p.getFaction());
+            for (String id : p.getLeaderIDs()) {
+                LeaderModel l = Mapper.getLeader(id);
+                if (l != null && l.getSource() != null && !l.getSource().isOfficial()) v.add("leader:" + id);
+            }
+        }
+        return v;
+    }
+
+    private static void flag(List<String> v, String name, boolean on) {
+        if (on) v.add(name);
+    }
+
+    private static final Map<String, String> REPORTED = new ConcurrentHashMap<>();
+
+    /** Invariant: a self-hosted (web) game has no homebrew. Logs once per game and violation set. */
+    public static void check(Game game) {
+        if (game == null || !homebrewOff()) return;
+        List<String> v;
+        try {
+            v = violations(game);
+        } catch (RuntimeException e) {
+            return;
+        }
+        if (v.isEmpty()) return;
+        String key = String.join(",", v);
+        if (Objects.equals(REPORTED.put(game.getName(), key), key)) return;
+        EngineMetricsBridge.count("invariant.homebrew");
+        BotLogger.error("invariant: web game " + game.getName() + " has homebrew content: " + key);
+    }
+
+    /** Setup controls kept out of new games' "alternate game modes" menu when homebrew is off. */
+    public static final Set<String> CREATION_MENU = Set.of(
+            "getHomebrewButtons", "offerTEOptionButtons", "startTFGame", "frankenSetup");
+
+    /** Indirection so this class does not depend on the engine package being enabled. */
+    private static final class EngineMetricsBridge {
+        static void count(String name) {
+            try {
+                ti4.selfhost.engine.EngineMetrics.count(name);
+            } catch (RuntimeException | LinkageError ignored) {
+                // metrics are best effort
+            }
+        }
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/WindowResponses.java b/src/main/java/ti4/selfhost/engine/WindowResponses.java
new file mode 100644
index 0000000..778c13d
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/WindowResponses.java
@@ -0,0 +1,53 @@
+package ti4.selfhost.engine;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.LinkedHashMap;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import javax.annotation.Nullable;
+import ti4.selfhost.engine.EngineModels.ReactionWindow;
+
+/**
+ * Engine-side record of who answered a reaction window, for kinds whose own record is unreliable
+ * ({@link KindSpec#recordsResponses()}: e.g. agenda shenanigans, whose persistent-react entry is not always kept). A
+ * successful engine answer by an eligible player marks them responded on that message, so the window closes over for
+ * them (ActionInvoker then answers 409 "already responded" instead of pressing again).
+ */
+final class WindowResponses {
+    private static final int MAX_MESSAGES = 2000;
+    private static final Map<String, Set<String>> byMessage = Collections.synchronizedMap(
+            new LinkedHashMap<>(256, 0.75f, true) {
+                @Override
+                protected boolean removeEldestEntry(Map.Entry<String, Set<String>> e) {
+                    return size() > MAX_MESSAGES;
+                }
+            });
+
+    private WindowResponses() {}
+
+    static void record(String messageId, String userId) {
+        byMessage.computeIfAbsent(messageId, k -> Collections.synchronizedSet(new LinkedHashSet<>())).add(userId);
+    }
+
+    /** The kind's window plus the responses the engine recorded for this message. */
+    @Nullable
+    static ReactionWindow merge(String messageId, @Nullable ReactionWindow w) {
+        if (w == null) return null;
+        Set<String> recorded = byMessage.get(messageId);
+        if (recorded == null || recorded.isEmpty()) return w;
+        List<String> responded = new ArrayList<>(w.responded());
+        Map<String, String> responses = new LinkedHashMap<>(w.responses());
+        synchronized (recorded) {
+            for (String uid : recorded) {
+                if (!w.eligible().contains(uid) || responded.contains(uid)) continue;
+                responded.add(uid);
+                responses.putIfAbsent(uid, "answered");
+            }
+        }
+        if (responded.size() == w.responded().size()) return w;
+        return new ReactionWindow(w.kind(), w.subject(), w.eligible(), responded, responses);
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/interaction/EngineInteraction.java b/src/main/java/ti4/selfhost/engine/interaction/EngineInteraction.java
