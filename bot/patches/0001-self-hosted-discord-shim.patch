+package ti4.selfhost.engine.kinds;
+
+import java.util.Map;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * Open technology choice by type: acquireAFreeTech ("Get a Technology", e.g. a faction whose starting technology is
+ * any one) and getAllTechOfType_&lt;type&gt;[_noPay] (the list of that type follows as tech.gain). value: {techType:
+ * "propulsion"|"biotic"|"cybernetic"|"warfare"|"unitupgrade"|"allTechResearchable"|null (acquireAFreeTech: type not
+ * chosen yet), free}.
+ */
+public class TechTypeChoiceKind implements KindSpec {
+
+    @Override
+    public String kind() {
+        return "tech.choose_type";
+    }
+
+    @Override
+    public int priority() {
+        return 45;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return "acquireAFreeTech".equals(handlerId) || handlerId.startsWith("getAllTechOfType_");
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        if ("acquireAFreeTech".equals(handlerId)) return SetupKindSupport.map("techType", null, "free", true);
+        if (!matches(handlerId)) return null;
+        String rest = handlerId.substring("getAllTechOfType_".length());
+        boolean free = rest.contains("_noPay");
+        String type = rest.replace("_noPay", "");
+        int us = type.indexOf('_');
+        if (us >= 0) type = type.substring(0, us);
+        return SetupKindSupport.map("techType", type, "free", free);
+    }
+
+    /** Setup: faction / colour are picked after capture; re-resolve the target on every state change. */
+    @Override
+    public boolean dynamic() {
+        return true;
+    }
+
+    @Override
+    public ti4.selfhost.engine.EngineModels.Target target(
+            CaptureContext ctx, ti4.selfhost.engine.EngineModels.Target resolved) {
+        return SetupKindSupport.refresh(ctx, resolved);
+    }
+}
