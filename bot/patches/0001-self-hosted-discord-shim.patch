+package ti4.selfhost.engine.kinds;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.selfhost.engine.EngineModels.Decision;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * Strategy phase, before your turn: queue a strategy-card pick (queueScPick_&lt;n&gt;) in your cards-info thread; the
+ * engine picks the first still-available queued card when your turn comes. restartSCQueue clears the queue.
+ * value: {strategyCard, name, card, tradeGoods, queued:[n…]} or {restart:true, queued:[…]}.
+ */
+public class StrategyCardQueuePickKind implements KindSpec {
+
+    @Override
+    public String kind() {
+        return "strategy_card.queue_pick";
+    }
+
+    @Override
+    public int priority() {
+        return 100;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return handlerId.matches("queueScPick_\\d+") || "restartSCQueue".equals(handlerId);
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        Map<String, Object> v = new LinkedHashMap<>();
+        if ("restartSCQueue".equals(handlerId)) {
+            v.put("restart", true);
+        } else {
+            int sc = Integer.parseInt(handlerId.substring("queueScPick_".length()));
+            v.put("strategyCard", sc);
+            v.put("name", StrategyCards.name(ctx.game(), sc));
+            v.put("card", StrategyCards.automation(ctx.game(), sc));
+            Integer tg = ctx.game().getScTradeGoods().get(sc);
+            v.put("tradeGoods", tg == null ? 0 : tg);
+        }
+        v.put("queued", StrategyCards.queued(ctx.game(), ctx.player()));
+        return v;
+    }
+
+    @Override
+    public String scope(CaptureContext ctx) {
+        return "player";
+    }
+
+    @Override
+    public String validate(Game game, Player answering, Decision decision, String optionId) {
+        Map<String, Object> v = StrategyCards.optionValue(decision, optionId);
+        if (v == null || !(v.get("strategyCard") instanceof Number n)) return null;
+        if (StrategyCards.queued(game, answering).contains(n.intValue())) return "That card is already queued.";
+        if (StrategyCards.holder(game, n.intValue()) != null) return "That strategy card is already taken.";
+        return null;
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/StrategyCardResolveKind.java b/src/main/java/ti4/selfhost/engine/kinds/StrategyCardResolveKind.java
new file mode 100644
index 0000000..d27a5f6
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/StrategyCardResolveKind.java
@@ -0,0 +1,235 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.ConcurrentHashMap;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.selfhost.engine.EngineModels.Decision;
+import ti4.selfhost.engine.EngineModels.ReactionWindow;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * A played strategy card (PlayStrategyCardService.playSC): ONE table-wide message carrying the holder's primary
+ * buttons and everyone else's follow / secondary / decline buttons (plus a copy of the same buttons posted in the
+ * card's thread: value.copy = true; answer either, never both).
+ *
+ * <p>Every typed option says who may press it ({@code who}: holder | others | anyone), what it does ({@code action}),
+ * whether a non-holder pays a strategy token for it ({@code spendsToken}), and which part of the holder's primary it
+ * is ({@code part}). {@code primaryParts} lists the whole primary checklist of the card, so a client resolves every
+ * part (Diplomacy: system + ready planets; Construction: two structures; Imperial: public + Mecatol point or secret).
+ * The per-player reaction (holder / pending / followed / declined, and why someone can't follow) is in
+ * GameState.strategyCards[].reactions.
+ *
+ * <p>validate() refuses: the holder following / declining their own card, others pressing a primary-only button,
+ * answering twice, using a secondary after declining or with no strategy token, the Imperial point without Mecatol
+ * Rex, a secret instead of the Imperial point while holding Mecatol Rex.
+ */
+public class StrategyCardResolveKind implements KindSpec {
+
+    /** message id → strategy card, learnt while typing the options (window() has no options). */
+    private static final Map<String, Integer> cardOfMessage = new ConcurrentHashMap<>();
+
+    private static final String HOLDER = "holder";
+    private static final String OTHERS = "others";
+    private static final String ANYONE = "anyone";
+
+    /** handler → [action, who, spendsToken, part, automations…] */
+    private record Spec(String action, String who, boolean spendsToken, String part, String... automations) {}
+
+    private static final String[] LEADERSHIP = {"pok1leadership", "anarchy1", "luminous1"};
+    private static final String[] DIPLOMACY = {"pok2diplomacy", "anarchy2", "anarchy3", "luminous2"};
+    private static final String[] POLITICS = {"pok3politics", "cryypter_3", "evenfall3"};
+    private static final String[] CONSTRUCTION = {
+        "pok4construction", "te4construction", "monuments4construction", "monumentstf4"
+    };
+    private static final String[] TRADE = {"pok5trade"};
+    private static final String[] WARFARE = {"pok6warfare", "te6warfare", "anarchy7", "anarchy8", "luminous7", "tf6"};
+    private static final String[] TECHNOLOGY = {"pok7technology"};
+    private static final String[] IMPERIAL = {"pok8imperial", "tf8", "anarchy10", "anarchy11", "luminous9"};
+
+    private static Spec spec(String h) {
+        if (h.matches("sc_follow_\\d+")) return new Spec("follow", OTHERS, true, null);
+        if ("sc_trade_follow".equals(h) || "sc_follow_trade".equals(h))
+            return new Spec("follow", OTHERS, true, null, TRADE);
+        if (h.matches("sc_no_follow_\\d+")) return new Spec("decline", OTHERS, false, null);
+        if (h.matches("requestAllFollow_\\d+")) return new Spec("request_all", HOLDER, false, null);
+        return switch (h) {
+            case "leadershipGenerateCCButtons" -> new Spec("leadership_tokens", ANYONE, false, "tokens", LEADERSHIP);
+            case "diploSystem" -> new Spec("diplomacy_system", HOLDER, false, "system", DIPLOMACY);
+            case "diploRefresh2" -> new Spec("ready_planets", ANYONE, true, "ready_planets", DIPLOMACY);
+            case "sc_ac_draw" -> new Spec("draw_action_cards", ANYONE, true, "action_cards", POLITICS);
+            case "construction_spacedock", "construction_pds", "construction_facility", "construction_monument",
+                    "construction_agesmonument" -> new Spec("construction_structure", ANYONE, true, "structure",
+                    CONSTRUCTION);
+            case "constructionPrimary_produce" -> new Spec("construction_produce", HOLDER, false, "produce",
+                    CONSTRUCTION);
+            case "sc_refresh" -> new Spec("replenish_free", OTHERS, false, null, TRADE);
+            case "sc_refresh_and_wash" -> new Spec("replenish_and_wash_free", OTHERS, false, null, TRADE);
+            case "primaryOfWarfare", "primaryOfTeWarfare" -> new Spec("warfare_primary", HOLDER, false,
+                    "warfare_primary", WARFARE);
+            case "warfareBuild", "warfareTeBuild" -> new Spec("warfare_produce", OTHERS, true, null, WARFARE);
+            case "acquireATechWithSC_first" -> new Spec("research", ANYONE, true, "research", TECHNOLOGY);
+            case "sc_draw_so" -> new Spec("draw_secret", ANYONE, true, "imperial", IMPERIAL);
+            case "score_imperial" -> new Spec("score_imperial", HOLDER, false, "imperial", IMPERIAL);
+            case "scoreAnObjective" -> new Spec("score_public", HOLDER, false, "score_public", IMPERIAL);
+            default -> null;
+        };
+    }
+
+    /** The holder's primary checklist per card automation (empty: nothing to resolve by hand, or not typed). */
+    public static List<String> primaryParts(String automation) {
+        if (automation == null) return List.of();
+        return switch (automation) {
+            case "pok1leadership" -> List.of("tokens");
+            case "pok2diplomacy" -> List.of("system", "ready_planets");
+            case "pok3politics" -> List.of("speaker", "action_cards", "agendas");
+            // Thunder's Edge: part 1 may instead be the PRODUCTION of one space dock (constructionPrimary_produce).
+            case "pok4construction", "te4construction", "monuments4construction", "monumentstf4" ->
+                List.of("structure", "structure");
+            case "pok6warfare" -> List.of("warfare_primary");
+            case "pok7technology" -> List.of("research");
+            case "pok8imperial" -> List.of("score_public", "imperial");
+            default -> List.of();
+        };
+    }
+
+    @Override
+    public String kind() {
+        return "strategy_card.resolve";
+    }
+
+    @Override
+    public int priority() {
+        return 90;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return spec(handlerId) != null;
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        Spec s = spec(handlerId);
+        if (s == null) return null;
+        Game game = ctx.game();
+        int sc;
+        if (handlerId.matches(".*_\\d+$") && s.automations().length == 0) {
+            sc = Integer.parseInt(handlerId.substring(handlerId.lastIndexOf('_') + 1));
+        } else {
+            sc = StrategyCards.byAutomation(game, s.automations());
+        }
+        if (sc < 0) return null;
+        if (cardOfMessage.size() > 2000) cardOfMessage.clear();
+        if (s.automations().length == 0 || !cardOfMessage.containsKey(ctx.messageId()))
+            cardOfMessage.put(ctx.messageId(), sc);
+        String automation = StrategyCards.automation(game, sc);
+        Player holder = StrategyCards.holder(game, sc);
+        Map<String, Object> v = new LinkedHashMap<>();
+        v.put("strategyCard", sc);
+        v.put("name", StrategyCards.name(game, sc));
+        v.put("card", automation);
+        v.put("holder", holder == null ? null : holder.getFaction());
+        v.put("action", s.action());
+        v.put("who", s.who());
+        v.put("spendsToken", s.spendsToken());
+        v.put("part", s.part());
+        if ("construction_structure".equals(s.action())) v.put("unit", handlerId.substring("construction_".length()));
+        if ("research".equals(s.action())) v.put("followCost", 4);
+        v.put("primaryParts", primaryParts(automation));
+        v.put("copy", ctx.content() != null && ctx.content().startsWith("These buttons will work inside the thread"));
+        return v;
+    }
+
+    @Override
+    public String scope(CaptureContext ctx) {
+        return "table";
+    }
+
+    @Override
+    public boolean dynamic() {
+        return true;
+    }
+
+    /**
+     * The follow window. kind "strategy_card"; subject {strategyCard, name, card, holder}. eligible: every seated
+     * player — the holder too, because the holder's primary buttons are on the same message. responded: players who
+     * declined (certainly done). Players who followed stay eligible: they may still press the card's secondary
+     * button. responses: userId → holder | pending | followed | declined (pending = still to choose follow or not).
+     */
+    @Override
+    public ReactionWindow window(CaptureContext ctx) {
+        Integer sc = cardOfMessage.get(ctx.messageId());
+        if (sc == null) return null;
+        Game game = ctx.game();
+        Player holder = StrategyCards.holder(game, sc);
+        Map<String, Object> subject = new LinkedHashMap<>();
+        subject.put("strategyCard", sc);
+        subject.put("name", StrategyCards.name(game, sc));
+        subject.put("card", StrategyCards.automation(game, sc));
+        subject.put("holder", holder == null ? null : holder.getFaction());
+        List<String> eligible = new ArrayList<>();
+        List<String> responded = new ArrayList<>();
+        Map<String, String> responses = new LinkedHashMap<>();
+        for (Player p : game.getRealPlayers()) {
+            String status = StrategyCards.status(game, p, sc);
+            responses.put(p.getUserID(), status);
+            // The holder resolves the primary (answersOutsideWindow); the window is about who follows.
+            if ("holder".equals(status) || p == holder) continue;
+            eligible.add(p.getUserID());
+            if ("declined".equals(status) || "followed".equals(status)) responded.add(p.getUserID());
+        }
+        return new ReactionWindow("strategy_card", subject, eligible, responded, responses);
+    }
+
+    /** Nobody holds the card any more (a previous round's prompt, live pbd97): never answerable, close it. */
+    @Override
+    public boolean obsolete(CaptureContext ctx) {
+        Integer sc = cardOfMessage.get(ctx.messageId());
+        return sc != null && StrategyCards.holder(ctx.game(), sc) == null;
+    }
+
+    /** The card's holder answers its primary on this message without being in the follow window. */
+    @Override
+    public boolean answersOutsideWindow(Game game, Player answering, Decision decision) {
+        Object sc = decision.window() == null ? null : decision.window().subject().get("strategyCard");
+        int n = StrategyCards.intOf(sc, -1);
+        return n >= 0 && answering.getSCs() != null && answering.getSCs().contains(n);
+    }
+
+    @Override
+    public String validate(Game game, Player answering, Decision decision, String optionId) {
+        Map<String, Object> v = StrategyCards.optionValue(decision, optionId);
+        if (v == null) return null;
+        int sc = StrategyCards.intOf(v.get("strategyCard"), -1);
+        if (sc < 0) return null;
+        String action = String.valueOf(v.get("action"));
+        String who = String.valueOf(v.get("who"));
+        boolean isHolder = answering.getSCs() != null && answering.getSCs().contains(sc);
+        String name = StrategyCards.name(game, sc);
+        if (HOLDER.equals(who) && !isHolder) return "Only the player who played " + name + " may do that.";
+        if (OTHERS.equals(who) && isHolder)
+            return "You played " + name + ": resolve its primary; you do not follow your own card.";
+        if (isHolder) {
+            if ("score_imperial".equals(action) && !answering.controlsMecatol(true))
+                return "You do not control Mecatol Rex: draw a secret objective instead.";
+            if ("draw_secret".equals(action) && answering.controlsMecatol(true))
+                return "You control Mecatol Rex: score the Imperial point instead of drawing a secret objective.";
+            return null;
+        }
+        String status = StrategyCards.status(game, answering, sc);
+        if ("decline".equals(action) && !"pending".equals(status))
+            return "You already " + status + " " + name + ".";
+        if ("follow".equals(action) && "followed".equals(status)) return "You already follow " + name + ".";
+        if ("declined".equals(status) && (Boolean.TRUE.equals(v.get("spendsToken")) || "follow".equals(action)))
+            return "You declined " + name + ".";
+        if ("pending".equals(status) && Boolean.TRUE.equals(v.get("spendsToken"))) {
+            String reason = StrategyCards.cantFollowReason(game, answering, sc);
+            if ("no_strategy_token".equals(reason)) return "You have no strategy token to follow " + name + ".";
+        }
+        return null;
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/StrategyCards.java b/src/main/java/ti4/selfhost/engine/kinds/StrategyCards.java
new file mode 100644
index 0000000..4c4c337
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/StrategyCards.java
@@ -0,0 +1,146 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+import javax.annotation.Nullable;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.helpers.Units;
+import ti4.model.StrategyCardModel;
+import ti4.selfhost.engine.EngineModels.ScReaction;
+import ti4.selfhost.engine.EngineModels.StrategyCardState;
+import ti4.service.strategycard.PlayStrategyCardService;
+import ti4.service.unit.CheckUnitContainmentService;
+
+/**
+ * Strategy-card facts shared by the G2 kinds and the state snapshot: card identity (number, name, automation id),
+ * holder, and every player's reaction to a played card. Not a KindSpec (the scan only instantiates KindSpecs).
+ */
+public final class StrategyCards {
+    private StrategyCards() {}
+
+    @Nullable
+    public static StrategyCardModel model(Game game, int sc) {
+        try {
+            return game.getStrategyCardModelByInitiative(sc).orElse(null);
+        } catch (Exception e) {
+            return null;
+        }
+    }
+
+    /** The automation id the engine resolves the card as ("pok1leadership" … "pok8imperial", "te4construction"…). */
+    @Nullable
+    public static String automation(Game game, int sc) {
+        StrategyCardModel m = model(game, sc);
+        return m == null ? null : m.getBotSCAutomationID();
+    }
+
+    public static String name(Game game, int sc) {
+        StrategyCardModel m = model(game, sc);
+        return m == null ? String.valueOf(sc) : m.getName();
+    }
+
+    @Nullable
+    public static Player holder(Game game, int sc) {
+        for (Player p : game.getRealPlayers()) if (p.getSCs() != null && p.getSCs().contains(sc)) return p;
+        return null;
+    }
+
+    /**
+     * The card a non-numbered button (diploRefresh2, construction_pds, sc_draw_so …) belongs to: the played card with
+     * one of these automation ids, else any card of the set with it. -1 when the set has none.
+     */
+    public static int byAutomation(Game game, String... automations) {
+        int fallback = -1;
+        for (Integer sc : game.getSCList()) {
+            if (sc == null) continue;
+            String a = automation(game, sc);
+            if (a == null) continue;
+            for (String want : automations) {
+                if (!a.equals(want)) continue;
+                if (game.getPlayedSCs().contains(sc)) return sc;
+                if (fallback < 0) fallback = sc;
+            }
+        }
+        return fallback;
+    }
+
+    /** holder | followed | declined | pending (only meaningful once the card is played). */
+    public static String status(Game game, Player p, int sc) {
+        if (p.getSCs() != null && p.getSCs().contains(sc)) return "holder";
+        if (!p.hasFollowedSC(sc)) return "pending";
+        String followed = game.getStoredValue("followedSC" + sc + "_" + game.getRound());
+        return followed != null && followed.contains(p.getFaction()) ? "followed" : "declined";
+    }
+
+    /** Why this pending player cannot use the secondary, or null if they can (best effort, mirrors the engine). */
+    @Nullable
+    public static String cantFollowReason(Game game, Player p, int sc) {
+        StrategyCardModel m = model(game, sc);
+        Player holder = holder(game, sc);
+        if (m == null || holder == null) return null;
+        try {
+            if (PlayStrategyCardService.lacksStrategyTokensToFollow(game, holder, p, sc, m)) return "no_strategy_token";
+        } catch (Exception ignored) {
+            // best effort
+        }
+        String a = m.getBotSCAutomationID();
+        if ("pok6warfare".equals(a)
+                && !p.hasUnit("ghoti_flagship")
+                && !game.isTwilightsFallMode()
+                && p.getHomeSystemTile() != null
+                && !CheckUnitContainmentService.getTilesContainingPlayersUnits(game, p, Units.UnitType.Spacedock)
+                        .contains(p.getHomeSystemTile())) return "no_home_space_dock";
+        if ("pok8imperial".equals(a) && p.getSoScored() == p.getMaxSOCount() && !game.isTwilightsFallMode())
+            return "all_secrets_scored";
+        return null;
+    }
+
+    public static StrategyCardState state(Game game, int sc, String holderUserId, int tg, boolean played) {
+        Player holder = holder(game, sc);
+        List<ScReaction> reactions = new ArrayList<>();
+        if (played) {
+            for (Player p : game.getRealPlayers()) {
+                String status = status(game, p, sc);
+                String reason = "pending".equals(status) ? cantFollowReason(game, p, sc) : null;
+                reactions.add(new ScReaction(p.getFaction(), status, "pending".equals(status) && reason == null, reason));
+            }
+        }
+        return new StrategyCardState(
+                sc,
+                holderUserId,
+                tg,
+                played,
+                name(game, sc),
+                automation(game, sc),
+                holder == null ? null : holder.getFaction(),
+                reactions);
+    }
+
+    /** The player's queued strategy-card picks (stored "&lt;faction&gt;scpickqueue" = "4_7_"). */
+    public static List<Integer> queued(Game game, @Nullable Player p) {
+        List<Integer> out = new ArrayList<>();
+        if (p == null) return out;
+        for (String s : game.getStoredValue(p.getFaction() + "scpickqueue").split("_")) {
+            try {
+                if (!s.isBlank()) out.add(Integer.parseInt(s.trim()));
+            } catch (NumberFormatException ignored) {
+                // skip
+            }
+        }
+        return out;
+    }
+
+    /** The value of the option with this id in a decision, or null. */
+    @Nullable
+    public static Map<String, Object> optionValue(
+            ti4.selfhost.engine.EngineModels.Decision d, String optionId) {
+        for (var o : d.options()) if (o.id().equals(optionId)) return o.value();
+        return null;
+    }
+
+    static int intOf(@Nullable Object o, int dflt) {
+        return o instanceof Number n ? n.intValue() : dflt;
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/TacticalActivateKind.java b/src/main/java/ti4/selfhost/engine/kinds/TacticalActivateKind.java
new file mode 100644
