+        // Self-host repair: a game rewound before this fix still has its channels archived (pbd303, pbd346).
+        if (!ti4.selfhost.SelfHosted.isEnabled()) return false;
+        for (String id : channelIds(after)) {
+            TextChannel ch = JdaService.jda == null ? null : JdaService.jda.getTextChannelById(id);
+            if (ch == null || inLimbo(ch)) return true;
+        }
+        return false;
+    }
+
+    static void restore(Game game) {
+        Guild guild = guild(game);
+        if (guild == null) return;
+        Category category = gameCategory(game, guild);
+        if (category == null) {
+            BotLogger.warning(new LogOrigin(game), "Rewind un-ended " + game.getName() + " but found no category for it");
+            return;
+        }
+        List<TextChannel> channels = new ArrayList<>();
+        for (String id : channelIds(game)) {
+            TextChannel cached = guild.getTextChannelById(id);
+            if (cached != null && !inLimbo(cached)) {
+                channels.add(cached);
+                continue;
+            }
+            // Raw PATCH: an archived channel is not in the bot's cache on the self-hosted shim (it is on Discord).
+            try {
+                new RestActionImpl<Void>(
+                                guild.getJDA(),
+                                Route.Channels.MODIFY_CHANNEL.compile(id),
+                                DataObject.empty().put("parent_id", category.getId()))
+                        .complete();
+            } catch (Exception e) {
+                BotLogger.error(new LogOrigin(game), "Could not move " + id + " of " + game.getName() + " back", e);
+                continue;
+            }
+            TextChannel back = awaitChannel(guild, id);
+            if (back != null) channels.add(back);
+        }
+        restoreRole(game, guild, channels);
+        BotLogger.info("Rewind un-ended " + game.getName() + ": restored " + channels.size() + " channel(s) to "
+                + category.getName());
+    }
+
+    private static void restoreRole(Game game, Guild guild, List<TextChannel> channels) {
+        boolean exists = guild.getRoles().stream().anyMatch(r -> game.getName().equalsIgnoreCase(r.getName()));
+        if (exists || channels.isEmpty()) return;
+        Role role = guild.createRole().setName(game.getName()).setMentionable(true).complete();
+        for (Player player : game.getRealPlayers()) {
+            Member member = guild.getMemberById(player.getUserID());
+            if (member != null) guild.addRoleToMember(member, role).complete();
+        }
+        Set<Permission> allow = EnumSet.of(Permission.PIN_MESSAGES, Permission.VIEW_CHANNEL);
+        for (TextChannel ch : channels) {
+            ch.getManager().putRolePermissionOverride(role.getIdLong(), allow, null).complete();
+        }
+    }
+
+    /** The gateway's CHANNEL_CREATE follows the PATCH reply: wait (briefly) for the channel to be cached again. */
+    private static TextChannel awaitChannel(Guild guild, String id) {
+        for (int i = 0; i < 50; i++) {
+            TextChannel ch = guild.getTextChannelById(id);
+            if (ch != null && !inLimbo(ch)) return ch;
+            try {
+                Thread.sleep(100);
+            } catch (InterruptedException e) {
+                Thread.currentThread().interrupt();
+                break;
+            }
+        }
+        return guild.getTextChannelById(id);
+    }
+
+    private static Category gameCategory(Game game, Guild guild) {
+        String name = CreateGameService.getCategoryNameForGame(game.getName());
+        if (name == null) return null;
+        List<Category> found = guild.getCategoriesByName(name, true);
+        if (!found.isEmpty()) return found.getFirst();
+        return guild.createCategory(name).complete();
+    }
+
+    private static Guild guild(Game game) {
+        if (JdaService.jda == null) return null;
+        if (StringUtils.isNumeric(game.getGuildID())) {
+            Guild g = JdaService.jda.getGuildById(game.getGuildID());
+            if (g != null) return g;
+        }
+        return JdaService.guildPrimary;
+    }
+
+    private static List<String> channelIds(Game game) {
+        return java.util.stream.Stream.of(game.getMainChannelID(), game.getTableTalkChannelID())
+                .filter(Objects::nonNull)
+                .filter(StringUtils::isNumeric)
+                .toList();
+    }
+
+    private static boolean inLimbo(TextChannel ch) {
+        Category parent = ch.getParentCategory();
+        return parent != null && LIMBO.equalsIgnoreCase(parent.getName());
+    }
+}
