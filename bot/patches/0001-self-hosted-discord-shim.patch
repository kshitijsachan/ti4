diff --git a/src/main/java/ti4/selfhost/engine/kinds/TurnActionKind.java b/src/main/java/ti4/selfhost/engine/kinds/TurnActionKind.java
new file mode 100644
index 0000000..288484d
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/TurnActionKind.java
@@ -0,0 +1,88 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.selfhost.engine.EngineModels.Decision;
+import ti4.selfhost.engine.EngineModels.Option;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * The action-phase turn menu (StartTurnService.getStartOfTurnButtons, also after an action: "end turn or do another
+ * action"), the pass-with-abilities menu and the end-of-turn-abilities menu. Typed options:
+ * tacticalAction, componentAction, strategicAction_&lt;sc&gt;, passForRound, passingAbilities, endOfTurnAbilities,
+ * turnEnd. Faction abilities on the same menu stay untyped (value null). Priority 110 so the menu stays this kind
+ * even when another area types one of its buttons (e.g. strategicAction_).
+ */
+public class TurnActionKind implements KindSpec {
+    private static final Pattern ID = Pattern.compile(
+            "^(tacticalAction|componentAction|strategicAction_(\\d+)|passForRound|passingAbilities|endOfTurnAbilities|turnEnd)$");
+
+    @Override
+    public String kind() {
+        return "turn.action";
+    }
+
+    @Override
+    public int priority() {
+        return 110;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return ID.matcher(handlerId).matches();
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        Matcher m = ID.matcher(handlerId);
+        if (!m.matches()) return null;
+        Map<String, Object> v = new LinkedHashMap<>();
+        Player p = ctx.player();
+        switch (m.group(1)) {
+            case "tacticalAction" -> {
+                v.put("action", "tactical");
+                v.put("tacticTokens", p == null ? null : p.getTacticalCC());
+            }
+            case "componentAction" -> v.put("action", "component");
+            case "passForRound" -> {
+                v.put("action", "pass");
+                v.put("abilities", false);
+            }
+            case "passingAbilities" -> {
+                v.put("action", "pass");
+                v.put("abilities", true);
+            }
+            case "endOfTurnAbilities" -> {
+                v.put("action", "end_turn");
+                v.put("abilities", true);
+            }
+            case "turnEnd" -> {
+                v.put("action", "end_turn");
+                v.put("abilities", false);
+            }
+            default -> {
+                v.put("action", "strategic");
+                v.put("strategyCard", Integer.parseInt(m.group(2)));
+            }
+        }
+        return v;
+    }
+
+    @Override
+    public String validate(Game game, Player answering, Decision decision, String optionId) {
+        for (Option o : decision.options()) {
+            if (!o.id().equals(optionId) || o.value() == null) continue;
+            Object action = o.value().get("action");
+            if ("end_turn".equals(action)) return null;
+            Player active = game.getActivePlayer();
+            if (active != null && active != answering && !game.isNaaluAgent()) return "It is not your turn.";
+            if ("tactical".equals(action) && answering.getTacticalCC() < 1)
+                return "You have no command tokens in your tactic pool.";
+        }
+        return null;
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/tactical/TacticalFacts.java b/src/main/java/ti4/selfhost/engine/tactical/TacticalFacts.java
new file mode 100644
index 0000000..769ca2a
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/tactical/TacticalFacts.java
@@ -0,0 +1,198 @@
+package ti4.selfhost.engine.tactical;
+
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+import ti4.game.Game;
+import ti4.game.Planet;
+import ti4.game.Player;
+import ti4.game.Tile;
+import ti4.game.UnitHolder;
+import ti4.helpers.ButtonHelper;
+import ti4.helpers.CheckDistanceHelper;
+import ti4.helpers.CommandCounterHelper;
+import ti4.helpers.Constants;
+import ti4.helpers.Units.UnitKey;
+import ti4.helpers.Units.UnitState;
+import ti4.helpers.Units.UnitType;
+import ti4.image.Mapper;
+import ti4.model.UnitModel;
+
+/**
+ * Facts about the active player's tactical action, read straight from {@link Game} for the tactical decision kinds
+ * and the direct move / land actions. Everything is ids and numbers (positions, planet ids, async unit ids, colours).
+ */
+public final class TacticalFacts {
+    private TacticalFacts() {}
+
+    /** Ships, fighters and ground forces of this player in space, and ground forces on planets (what can move). */
+    public static List<Map<String, Object>> movableUnits(Game game, Player player, Tile tile) {
+        List<Map<String, Object>> out = new ArrayList<>();
+        Tile nebulaCheck = tile;
+        boolean nebula = false;
+        try {
+            nebula = nebulaCheck.isNebula(game);
+        } catch (Exception ignored) {
+            // homebrew tiles without a model
+        }
+        for (UnitHolder uh : tile.getUnitHolders().values()) {
+            boolean space = !(uh instanceof Planet);
+            for (Map.Entry<UnitKey, List<Integer>> e :
+                    uh.getUnitsByStateForPlayer(player).entrySet()) {
+                UnitKey key = e.getKey();
+                UnitModel model = player.getUnitFromUnitKey(key);
+                if (model == null) continue;
+                UnitType type = key.unitType();
+                boolean ground = type == UnitType.Infantry || type == UnitType.Mech;
+                if (model.getIsStructure() && type != UnitType.Fighter && !ground) continue;
+                if (!space && !ground) continue;
+                List<Integer> s = e.getValue();
+                int count = sum(s);
+                if (count < 1) continue;
+                int damaged = at(s, UnitState.dmg) + at(s, UnitState.dmg_glv);
+                int move = model.getMoveValue();
+                if (nebula && move > 0) move = 1;
+                Map<String, Object> u = new LinkedHashMap<>();
+                u.put("holder", space ? "space" : uh.getName());
+                u.put("unit", key.asyncID());
+                u.put("color", player.getColor());
+                u.put("count", count);
+                u.put("damaged", damaged);
+                u.put("move", move);
+                u.put("capacity", model.getCapacityValue());
+                u.put("ship", model.getIsShip());
+                out.add(u);
+            }
+        }
+        return out;
+    }
+
+    /** Whether units may leave this system now (no own command token there, or an ability lets them). */
+    public static boolean canLeave(Game game, Player player, Tile tile) {
+        return tile.getPosition().equalsIgnoreCase(game.getActiveSystem())
+                || !CommandCounterHelper.hasCC(null, player.getColor(), tile)
+                || ButtonHelper.canMoveOutOfLockedSystems(player, game);
+    }
+
+    /** Every system the player's units could move from into the active system, with distances (rift-aware). */
+    public static List<Map<String, Object>> origins(Game game, Player player) {
+        List<Map<String, Object>> out = new ArrayList<>();
+        String active = game.getActiveSystem();
+        if (active == null || active.isBlank()) return out;
+        for (Tile tile : new ArrayList<>(game.getTileMap().values())) {
+            if (tile.getPosition().equalsIgnoreCase(active)) continue;
+            if (!tile.containsPlayersUnits(player) || !canLeave(game, player, tile)) continue;
+            List<Map<String, Object>> units = movableUnits(game, player, tile);
+            if (units.isEmpty()) continue;
+            Map<String, Object> o = new LinkedHashMap<>();
+            o.put("position", tile.getPosition());
+            o.put("tileId", tile.getTileID());
+            int distance = safeDistance(game, player, tile.getPosition(), active, true);
+            int rift = safeDistance(game, player, tile.getPosition(), active, false);
+            o.put("distance", distance);
+            o.put("riftDistance", rift);
+            o.put("units", units);
+            out.add(o);
+        }
+        out.sort((a, b) -> Integer.compare((int) a.get("distance"), (int) b.get("distance")));
+        return out;
+    }
+
+    private static int safeDistance(Game game, Player player, String from, String to, boolean riftsNormal) {
+        try {
+            return CheckDistanceHelper.getDistanceBetweenTwoTiles(game, player, from, to, riftsNormal);
+        } catch (Exception e) {
+            return 100;
+        }
+    }
+
+    /** What is staged to move into the active system: [{from, holder, unit, color, count, damaged}]. */
+    public static List<Map<String, Object>> staged(Game game) {
+        List<Map<String, Object>> out = new ArrayList<>();
+        for (Map.Entry<String, Map<UnitKey, List<Integer>>> e :
+                game.getTacticalActionDisplacement().entrySet()) {
+            String k = e.getKey();
+            int dash = k == null ? -1 : k.indexOf('-');
+            if (dash <= 0 || e.getValue() == null) continue;
+            for (Map.Entry<UnitKey, List<Integer>> u : e.getValue().entrySet()) {
+                int count = sum(u.getValue());
+                if (count < 1) continue;
+                Map<String, Object> m = new LinkedHashMap<>();
+                m.put("from", k.substring(0, dash));
+                m.put("holder", k.substring(dash + 1));
+                m.put("unit", u.getKey().asyncID());
+                m.put("color", u.getKey().getColor());
+                m.put("count", count);
+                m.put("damaged", at(u.getValue(), UnitState.dmg) + at(u.getValue(), UnitState.dmg_glv));
+                out.add(m);
+            }
+        }
+        return out;
+    }
+
+    /**
+     * Movement bonuses the player may apply this tactical action (the engine does not enforce move values; these
+     * tell planners and the UI what is legal): [{source, amount, appliesTo: "one_ship" | "all_ships"}].
+     */
+    public static List<Map<String, Object>> bonuses(Game game, Player player) {
+        List<Map<String, Object>> out = new ArrayList<>();
+        if (player.hasTech("gd")) out.add(bonus("gravity_drive", 1, "one_ship"));
+        if (player.hasTech("baldrick_gd") || !game.getStoredValue("baldrickGDboost").isEmpty())
+            out.add(bonus("baldrick_gravity_drive", 1, "all_ships"));
+        if (!game.getStoredValue("flankspeedBoost").isEmpty())
+            out.add(bonus("flank_speed", game.isWildWildGalaxyMode() ? 2 : 1, "all_ships"));
+        if (!game.getStoredValue("crucibleBoost").isEmpty()) out.add(bonus("crucible", 1, "all_ships"));
+        if (player.getTechs().contains("dsgledb")) out.add(bonus("lightning_drives", 1, "ships_not_transporting"));
+        return out;
+    }
+
+    private static Map<String, Object> bonus(String source, int amount, String appliesTo) {
+        Map<String, Object> m = new LinkedHashMap<>();
+        m.put("source", source);
+        m.put("amount", amount);
+        m.put("appliesTo", appliesTo);
+        return m;
+    }
+
+    /** Concluding the action in this system explores its frontier token (Dark Energy Tap and friends). */
+    public static boolean frontierExplore(Game game, Player player, Tile tile) {
+        if (tile == null || player == null) return false;
+        if (!(player.hasTech("det") || game.isCptiExploreMode() || player.hasTech("antimatter"))) return false;
+        UnitHolder space = tile.getSpaceUnitHolder();
+        return space != null && space.getTokenList().contains(Mapper.getTokenID(Constants.FRONTIER));
+    }
+
+    /** Planets of the system with their controller and units (for landing). */
+    public static List<Map<String, Object>> planets(Game game, Tile tile) {
+        List<Map<String, Object>> out = new ArrayList<>();
+        if (tile == null) return out;
+        for (Planet p : tile.getPlanetUnitHolders()) {
+            Map<String, Object> m = new LinkedHashMap<>();
+            m.put("planet", p.getName());
+            Player owner = null;
+            for (Player pl : game.getRealPlayers()) if (pl.getPlanets().contains(p.getName())) owner = pl;
+            m.put("controller", owner == null ? null : owner.getFaction());
+            out.add(m);
+        }
+        return out;
+    }
+
+    /** Progress.flow of one tactical action: "tactical:&lt;uid&gt;:r&lt;round&gt;:&lt;active system&gt;". */
+    public static String flow(Game game, Player player) {
+        return "tactical:" + (player == null ? "?" : player.getUserID()) + ":r" + game.getRound() + ":"
+                + game.getActiveSystem();
+    }
+
+    static int sum(List<Integer> s) {
+        int n = 0;
+        if (s != null) for (Integer i : s) n += Objects.requireNonNullElse(i, 0);
+        return n;
+    }
+
+    static int at(List<Integer> s, UnitState state) {
+        if (s == null || s.size() <= state.ordinal()) return 0;
+        return Objects.requireNonNullElse(s.get(state.ordinal()), 0);
+    }
+}
