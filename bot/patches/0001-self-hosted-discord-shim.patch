new file mode 100644
index 0000000..9cbf38d
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/Engine.java
@@ -0,0 +1,58 @@
+package ti4.selfhost.engine;
+
+import java.util.Objects;
+import net.dv8tion.jda.api.JDA;
+import ti4.game.Game;
+import ti4.logging.BotLogger;
+import ti4.selfhost.SelfHosted;
+import ti4.selfhost.engine.EngineModels.Decision;
+import ti4.selfhost.engine.EngineModels.Target;
+
+/**
+ * Entry points the (tiny) patches into upstream code call. Enabled when self-hosted unless TI4_ENGINE=off.
+ * Capture is passive; nothing changes for Discord-style play when no client uses the engine API.
+ */
+public final class Engine {
+    private static final boolean ENABLED =
+            SelfHosted.isEnabled() && !"off".equalsIgnoreCase(System.getenv().getOrDefault("TI4_ENGINE", "on"));
+
+    private Engine() {}
+
+    public static boolean enabled() {
+        return ENABLED;
+    }
+
+    /** JdaService: after build(). */
+    public static void registerListeners(JDA jda) {
+        if (!ENABLED) return;
+        jda.addEventListener(new InteractionTracker());
+        BotLogger.info("engine: decision capture on (" + DecisionKinds.all().size() + " typed kinds)");
+    }
+
+    /** GameWebStatePipeline.queue: every save and every undo. */
+    public static void onStateChanged(Game game) {
+        if (!ENABLED || game == null) return;
+        try {
+            DecisionRegistry.stateChanged(game.getName(), game.getLastModifiedDate());
+            retarget(game);
+        } catch (Exception e) {
+            BotLogger.error("engine: state change hook failed for " + game.getName(), e);
+        }
+    }
+
+    /** Kinds with a dynamic target (e.g. draft turn) are re-resolved after each state change. */
+    private static void retarget(Game game) {
+        for (Decision d : DecisionRegistry.openDecisions(game.getName())) {
+            KindSpec spec = DecisionKinds.byKind(d.kind());
+            if (spec == null || !spec.dynamicTarget()) continue;
+            KindSpec.CaptureContext ctx = new KindSpec.CaptureContext(
+                    game, d.source().channelId(), d.source().messageId(), d.prompt(), d.source().ephemeral(),
+                    d.target(), null);
+            Target t = spec.target(ctx, d.target());
+            if (Objects.equals(t, d.target())) continue;
+            DecisionRegistry.update(new Decision(
+                    d.id(), d.game(), d.kind(), 0, game.getLastModifiedDate(), t, d.scope(), d.visibility(),
+                    d.prompt(), d.options(), d.source(), d.createdAt()));
+        }
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/EngineController.java b/src/main/java/ti4/selfhost/engine/EngineController.java
new file mode 100644
index 0000000..e424c03
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/EngineController.java
@@ -0,0 +1,215 @@
+package ti4.selfhost.engine;
+
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.LinkedBlockingQueue;
+import java.util.concurrent.TimeUnit;
+import org.springframework.http.CacheControl;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.MediaType;
+import org.springframework.http.ResponseEntity;
+import org.springframework.security.access.prepost.PreAuthorize;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestHeader;
+import org.springframework.web.bind.annotation.RequestParam;
+import org.springframework.web.bind.annotation.RestController;
+import org.springframework.web.servlet.mvc.method.annotation.SseEmitter;
+import ti4.discord.JdaService;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.game.persistence.GameManager;
+import ti4.game.persistence.ManagedGame;
+import ti4.selfhost.engine.EngineModels.AnswerRequest;
+import ti4.selfhost.engine.EngineModels.AnswerResult;
+import ti4.selfhost.engine.EngineModels.Decision;
+import ti4.selfhost.engine.EngineModels.EngineEvent;
+import ti4.spring.context.RequestContext;
+
+/**
+ * Engine API. Two audiences:
+ * <ul>
+ *   <li>The shim (trusted; {@code Authorization: Bot <bot token>}, i.e. the shim's own state.bot_token), under
+ *   /api/public/selfhost/engine/** — full state with any viewer's hand, every decision, answer as any seated user,
+ *   and the SSE firehose. The shim fans out to browsers and drives autopilot seats.</li>
+ *   <li>A seat ({@code Authorization: Bearer <seat token>}) under /api/game/{game}/engine/** — own view only.</li>
+ * </ul>
+ */
+@RestController
+public class EngineController {
+
+    // ------------------------------------------------------------------ trusted (shim)
+
+    @GetMapping("/api/public/selfhost/engine/{game}/state")
+    public ResponseEntity<?> state(
+            @PathVariable String game,
+            @RequestParam(required = false) String viewer,
+            @RequestHeader(value = "Authorization", required = false) String auth) {
+        Game g = game(game);
+        if (g == null) return notFound();
+        String v = trusted(auth) ? viewer : null; // without the bot token: public view (no hand)
+        return ok(StateSnapshotBuilder.build(g, v));
+    }
+
+    @GetMapping("/api/public/selfhost/engine/{game}/decisions")
+    public ResponseEntity<?> decisions(
+            @PathVariable String game, @RequestHeader(value = "Authorization", required = false) String auth) {
+        if (!trusted(auth)) return unauthorized();
+        return ok(Map.of("seq", DecisionRegistry.currentSeq(), "decisions", DecisionRegistry.openDecisions(game)));
+    }
+
+    @PostMapping("/api/public/selfhost/engine/{game}/decisions/{id}/answer")
+    public ResponseEntity<?> answerAs(
+            @PathVariable String game,
+            @PathVariable String id,
+            @RequestBody AnswerRequest req,
+            @RequestHeader(value = "Authorization", required = false) String auth) {
+        if (!trusted(auth)) return unauthorized();
+        if (req.userId() == null) return ResponseEntity.badRequest().body(Map.of("error", "userId required"));
+        return answerResponse(ActionInvoker.answer(game, id, req.userId(), req));
+    }
+
+    /**
+     * Server-sent events, one per EngineEvent (event name = type, id = seq, data = EngineEvent JSON). Resume with
+     * ?after=&lt;seq&gt; (or the Last-Event-ID header). If the buffer no longer covers `after`, a "reset" event
+     * tells the client to re-read state + decisions and continue from the seq given there.
+     */
+    @GetMapping(value = "/api/public/selfhost/engine/stream", produces = MediaType.TEXT_EVENT_STREAM_VALUE)
+    public Object stream(
+            @RequestParam(required = false) Long after,
+            @RequestParam(required = false) String game,
+            @RequestHeader(value = "Last-Event-ID", required = false) String lastEventId,
+            @RequestHeader(value = "Authorization", required = false) String auth) {
+        if (!trusted(auth)) return unauthorized();
+        long from = after != null ? after : lastEventId != null ? parse(lastEventId) : DecisionRegistry.currentSeq();
+        SseEmitter emitter = new SseEmitter(0L);
+        LinkedBlockingQueue<EngineEvent> queue = new LinkedBlockingQueue<>();
+        Runnable unsubscribe = DecisionRegistry.subscribe(e -> {
+            if (game == null || game.equals(e.game())) queue.add(e);
+        });
+        List<EngineEvent> backlog = DecisionRegistry.since(from, game);
+        Thread.ofVirtual().name("engine-sse").start(() -> {
+            try {
+                long sent = from;
+                if (backlog == null) {
+                    emitter.send(SseEmitter.event()
+                            .name("reset")
+                            .data(Map.of("seq", DecisionRegistry.currentSeq()), MediaType.APPLICATION_JSON));
+                    sent = DecisionRegistry.currentSeq();
+                } else {
+                    for (EngineEvent e : backlog) {
+                        send(emitter, e);
+                        sent = e.seq();
+                    }
+                }
+                while (true) {
+                    EngineEvent e = queue.poll(15, TimeUnit.SECONDS);
+                    if (e == null) {
+                        emitter.send(SseEmitter.event().comment("ping"));
+                        continue;
+                    }
+                    if (e.seq() <= sent) continue; // already in the backlog
+                    send(emitter, e);
+                    sent = e.seq();
+                }
+            } catch (Exception closed) {
+                // client went away
+            } finally {
+                unsubscribe.run();
+                emitter.complete();
+            }
+        });
+        emitter.onCompletion(unsubscribe);
+        emitter.onTimeout(unsubscribe);
+        emitter.onError(t -> unsubscribe.run());
+        return emitter;
+    }
+
+    // ------------------------------------------------------------------ seat (own view)
+
+    @GetMapping("/api/game/{gameName}/engine/state")
+    @PreAuthorize("@security.canAccessGame(#gameName)")
+    public ResponseEntity<?> myState(@PathVariable String gameName) {
+        Player me = RequestContext.getPlayer();
+        return ok(StateSnapshotBuilder.build(RequestContext.getGame(), me == null ? null : me.getUserID()));
+    }
+
+    @GetMapping("/api/game/{gameName}/engine/decisions")
+    @PreAuthorize("@security.canAccessGame(#gameName)")
+    public ResponseEntity<?> myDecisions(@PathVariable String gameName) {
+        Player me = RequestContext.getPlayer();
+        List<Decision> out = new ArrayList<>();
+        for (Decision d : DecisionRegistry.openDecisions(gameName)) if (visibleTo(d, me)) out.add(d);
+        return ok(Map.of("seq", DecisionRegistry.currentSeq(), "decisions", out));
+    }
+
+    @PostMapping("/api/game/{gameName}/engine/decisions/{id}/answer")
+    @PreAuthorize("@security.canAccessGame(#gameName)")
+    public ResponseEntity<?> answer(@PathVariable String gameName, @PathVariable String id, @RequestBody AnswerRequest req) {
+        Player me = RequestContext.getPlayer();
+        if (me == null) return ResponseEntity.status(HttpStatus.FORBIDDEN).body(Map.of("error", "not a player"));
+        return answerResponse(ActionInvoker.answer(gameName, id, me.getUserID(), req));
+    }
+
+    // ------------------------------------------------------------------ helpers
+
+    public static boolean visibleTo(Decision d, Player me) {
+        if (me == null) return "public".equals(d.visibility());
+        if ("private".equals(d.visibility()))
+            return d.target() != null && me.getUserID().equals(d.target().userId());
+        return true;
+    }
+
+    private static void send(SseEmitter emitter, EngineEvent e) throws IOException {
+        emitter.send(SseEmitter.event().id(String.valueOf(e.seq())).name(e.type()).data(e, MediaType.APPLICATION_JSON));
+    }
+
+    private static long parse(String s) {
+        try {
+            return Long.parseLong(s.trim());
+        } catch (Exception e) {
+            return 0;
+        }
+    }
+
+    private static ResponseEntity<?> answerResponse(AnswerResult r) {
+        HttpStatus status = switch (r.status()) {
+            case "done" -> HttpStatus.OK;
+            case "stale", "busy" -> HttpStatus.CONFLICT;
+            case "forbidden" -> HttpStatus.FORBIDDEN;
+            case "not_found" -> HttpStatus.NOT_FOUND;
+            case "error" -> HttpStatus.INTERNAL_SERVER_ERROR;
+            default -> HttpStatus.UNPROCESSABLE_ENTITY;
+        };
+        return ResponseEntity.status(status).cacheControl(CacheControl.noStore()).body(r);
+    }
+
+    static boolean trusted(String auth) {
+        if (auth == null || JdaService.jda == null) return false;
+        String token = JdaService.jda.getToken();
+        String bare = token.startsWith("Bot ") ? token.substring(4) : token;
+        return auth.equals("Bot " + bare);
+    }
+
+    private static Game game(String name) {
+        if (!GameManager.isValid(name)) return null;
+        ManagedGame mg = GameManager.getManagedGame(name);
+        return mg == null ? null : mg.getGame();
+    }
+
+    private static ResponseEntity<?> ok(Object body) {
+        return ResponseEntity.ok().cacheControl(CacheControl.noStore()).body(body);
+    }
+
+    private static ResponseEntity<?> notFound() {
+        return ResponseEntity.status(HttpStatus.NOT_FOUND).body(Map.of("error", "no such game"));
+    }
+
+    private static ResponseEntity<?> unauthorized() {
+        return ResponseEntity.status(HttpStatus.UNAUTHORIZED).body(Map.of("error", "bot token required"));
+    }
+}
