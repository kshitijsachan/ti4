+package ti4.selfhost.engine.kinds;
+
+import java.util.List;
+import javax.annotation.Nullable;
+import ti4.selfhost.engine.KindSpec.CaptureContext;
+
+/**
+ * Embers of Muaat: Star Forge (starforgeTile_&lt;pos&gt; / starforgeTileFree_&lt;pos&gt; -&gt;
+ * starforge[Free]_&lt;destroyer|fighters&gt;_&lt;pos&gt;), agent Umbat (umbatTile_&lt;pos&gt;: build in that system), hero
+ * Adjudicator Ba'al (novaSeed_&lt;pos&gt;), commander Magmus (gain1tgFromMuaatCommander).
+ */
+public class FactionStepsMuaat implements FactionSteps {
+    private static final String F = "muaat";
+
+    @Override
+    @Nullable
+    public Step step(String h, @Nullable CaptureContext ctx) {
+        if (h.startsWith("starforgeTileFree_"))
+            return Step.ability(
+                    "ability", "star_forge", F, "starforgeTile", "target", false,
+                    "tile", h.substring("starforgeTileFree_".length()),
+                    "free", true);
+        if (h.startsWith("starforgeTile_"))
+            return Step.ability(
+                    "ability", "star_forge", F, "starforgeTile", "target", false,
+                    "tile", h.substring("starforgeTile_".length()),
+                    "free", false);
+        boolean free = h.startsWith("starforgeFree_");
+        if (free || h.startsWith("starforge_")) {
+            List<String> a = FactionSteps.args(h, free ? "starforgeFree_" : "starforge_");
+            String u = FactionSteps.at(a, 0);
+            return Step.ability(
+                    "ability", "star_forge", F, "starforge", "target", false,
+                    "unit", "fighters".equals(u) ? "ff" : "destroyer".equals(u) ? "dd" : u,
+                    "count", "fighters".equals(u) ? 2 : 1,
+                    "tile", FactionSteps.at(a, 1),
+                    "free", free);
+        }
+        if (h.startsWith("umbatTile_"))
+            return Step.leader("muaatagent", "umbatTile", "target", false, "tile", h.substring("umbatTile_".length()));
+        if (h.startsWith("novaSeed_"))
+            return Step.leader(
+                    "muaathero", "novaSeed", "use", true, "tile", FactionSteps.at(FactionSteps.args(h, "novaSeed_"), 0));
+        if (h.equals("gain1tgFromMuaatCommander"))
+            return Step.leader("muaatcommander", "gain1tgFromMuaatCommander", "use", true, "amount", 1);
+        return null;
+    }
+}
