index 0000000..9712c94
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/DecisionKinds.java
@@ -0,0 +1,63 @@
+package ti4.selfhost.engine;
+
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.List;
+import org.reflections.Reflections;
+import org.reflections.util.ClasspathHelper;
+import org.reflections.util.ConfigurationBuilder;
+import ti4.logging.BotLogger;
+
+/** All {@link KindSpec}s under ti4.selfhost.engine.kinds, highest priority first. */
+public final class DecisionKinds {
+    public static final String LEGACY = "legacy";
+
+    private static volatile List<KindSpec> specs;
+
+    private DecisionKinds() {}
+
+    public static List<KindSpec> all() {
+        List<KindSpec> s = specs;
+        if (s != null) return s;
+        synchronized (DecisionKinds.class) {
+            if (specs != null) return specs;
+            List<KindSpec> found = new ArrayList<>();
+            try {
+                Reflections r = new Reflections(new ConfigurationBuilder()
+                        .setUrls(ClasspathHelper.forPackage("ti4.selfhost.engine.kinds"))
+                        .forPackages("ti4.selfhost.engine.kinds"));
+                for (Class<? extends KindSpec> c : r.getSubTypesOf(KindSpec.class)) {
+                    if (c.isInterface() || java.lang.reflect.Modifier.isAbstract(c.getModifiers())) continue;
+                    if (!c.getPackageName().startsWith("ti4.selfhost.engine.kinds")) continue;
+                    try {
+                        found.add(c.getDeclaredConstructor().newInstance());
+                    } catch (Exception e) {
+                        BotLogger.error("engine: cannot instantiate decision kind " + c.getName(), e);
+                    }
+                }
+            } catch (Exception e) {
+                BotLogger.error("engine: decision kind scan failed", e);
+            }
+            found.sort(Comparator.comparingInt(KindSpec::priority).reversed().thenComparing(KindSpec::kind));
+            specs = List.copyOf(found);
+            BotLogger.info("engine: " + specs.size() + " decision kinds: "
+                    + specs.stream().map(KindSpec::kind).toList());
+            return specs;
+        }
+    }
+
+    public static KindSpec byKind(String kind) {
+        for (KindSpec k : all()) if (k.kind().equals(kind)) return k;
+        return null;
+    }
+
+    /** The kind for a message given its options' handler ids; null = legacy. */
+    public static KindSpec classify(List<String> handlerIds) {
+        for (KindSpec k : all()) {
+            for (String h : handlerIds) {
+                if (h != null && k.matches(h)) return k;
+            }
+        }
+        return null;
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/DecisionRegistry.java b/src/main/java/ti4/selfhost/engine/DecisionRegistry.java
new file mode 100644
index 0000000..a1cb5ca
--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/DecisionRegistry.java
@@ -0,0 +1,146 @@
+package ti4.selfhost.engine;
+
+import java.util.ArrayDeque;
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.Deque;
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.CopyOnWriteArrayList;
+import java.util.function.Consumer;
+import ti4.selfhost.engine.EngineModels.Decision;
+import ti4.selfhost.engine.EngineModels.EngineEvent;
+
+/**
+ * Open decisions per game plus the ordered event log (ring buffer) that the stream endpoint replays. One global seq
+ * orders every event of every game. In memory only: after a bot restart clients re-read the snapshot (the bot re-sends
+ * no buttons on restart, so decisions opened before a restart reappear only when the engine re-asks; see ENGINE.md).
+ */
+public final class DecisionRegistry {
+    private static final int LOG_SIZE = 5000;
+
+    private static long seq;
+    private static final Deque<EngineEvent> log = new ArrayDeque<>();
+    /** game -> decision id -> decision */
+    private static final Map<String, Map<String, Decision>> open = new ConcurrentHashMap<>();
+    /** message id -> decision id (one open revision per message) */
+    private static final Map<String, String> byMessage = new ConcurrentHashMap<>();
+    private static final Map<String, String> gameOfDecision = new ConcurrentHashMap<>();
+    private static final List<Consumer<EngineEvent>> listeners = new CopyOnWriteArrayList<>();
+
+    private DecisionRegistry() {}
+
+    public static synchronized long currentSeq() {
+        return seq;
+    }
+
+    /** Opens (or replaces the open revision on the same message with) a decision. Returns the stored decision. */
+    // Listeners are called under the registry lock so they see events in seq order; they must not block
+    // (the stream endpoint only enqueues).
+    public static synchronized Decision open(Decision d) {
+        String prev = byMessage.get(d.source().messageId());
+        if (prev != null) closeLocked(prev, "replaced");
+        d = new Decision(d.id(), d.game(), d.kind(), ++seq, d.stateVersion(), d.target(), d.scope(), d.visibility(),
+                d.prompt(), d.options(), d.source(), d.createdAt());
+        open.computeIfAbsent(d.game(), g -> new ConcurrentHashMap<>()).put(d.id(), d);
+        byMessage.put(d.source().messageId(), d.id());
+        gameOfDecision.put(d.id(), d.game());
+        fire(append(new EngineEvent(d.seq(), "decision.opened", d.game(), d.stateVersion(), d, null)));
+        return d;
+    }
+
+    /** Replaces an open decision in place (same id), e.g. a new target; emits decision.updated. */
+    public static synchronized Decision update(Decision d) {
+        Map<String, Decision> m = open.get(d.game());
+        if (m == null || !m.containsKey(d.id())) return null;
+        d = new Decision(d.id(), d.game(), d.kind(), ++seq, d.stateVersion(), d.target(), d.scope(), d.visibility(),
+                d.prompt(), d.options(), d.source(), d.createdAt());
+        m.put(d.id(), d);
+        fire(append(new EngineEvent(d.seq(), "decision.updated", d.game(), d.stateVersion(), d, null)));
+        return d;
+    }
+
+    public static synchronized void closeByMessage(String messageId, String reason) {
+        String id = byMessage.get(messageId);
+        if (id != null) closeLocked(id, reason);
+    }
+
+    public static synchronized void close(String decisionId, String reason) {
+        closeLocked(decisionId, reason);
+    }
+
+    private static EngineEvent closeLocked(String decisionId, String reason) {
+        String game = gameOfDecision.remove(decisionId);
+        if (game == null) return null;
+        Map<String, Decision> m = open.get(game);
+        Decision d = m == null ? null : m.remove(decisionId);
+        if (d == null) return null;
+        byMessage.remove(d.source().messageId(), decisionId);
+        EngineEvent ev = append(new EngineEvent(++seq, "decision.closed", game, d.stateVersion(), d, reason));
+        fire(ev);
+        return ev;
+    }
+
+    public static synchronized void stateChanged(String game, long stateVersion) {
+        fire(append(new EngineEvent(++seq, "state.changed", game, stateVersion, null, null)));
+    }
+
+    public static Decision get(String decisionId) {
+        String game = gameOfDecision.get(decisionId);
+        if (game == null) return null;
+        Map<String, Decision> m = open.get(game);
+        return m == null ? null : m.get(decisionId);
+    }
+
+    public static String decisionIdForMessage(String messageId) {
+        return byMessage.get(messageId);
+    }
+
+    public static List<Decision> openDecisions(String game) {
+        Map<String, Decision> m = open.get(game);
+        if (m == null) return List.of();
+        List<Decision> out = new ArrayList<>(m.values());
+        out.sort((a, b) -> Long.compare(a.seq(), b.seq()));
+        return out;
+    }
+
+    /** Events with seq > after (optionally one game). null when `after` is older than the buffer: re-snapshot. */
+    public static synchronized List<EngineEvent> since(long after, String game) {
+        if (!log.isEmpty() && after < log.peekFirst().seq() - 1 && after < seq) return null;
+        List<EngineEvent> out = new ArrayList<>();
+        for (EngineEvent e : log) if (e.seq() > after && (game == null || game.equals(e.game()))) out.add(e);
+        return out;
+    }
+
+    public static List<Decision> openedAfter(String game, long after) {
+        List<Decision> out = new ArrayList<>();
+        for (Decision d : openDecisions(game)) if (d.seq() > after) out.add(d);
+        return out;
+    }
+
+    public static Runnable subscribe(Consumer<EngineEvent> l) {
+        listeners.add(l);
+        return () -> listeners.remove(l);
+    }
+
+    public static Collection<String> games() {
+        return open.keySet();
+    }
+
+    private static EngineEvent append(EngineEvent e) {
+        log.addLast(e);
+        while (log.size() > LOG_SIZE) log.removeFirst();
+        return e;
+    }
+
+    private static void fire(EngineEvent e) {
+        for (Consumer<EngineEvent> l : listeners) {
+            try {
+                l.accept(e);
+            } catch (Exception ignored) {
+                // a broken subscriber must not break the engine
+            }
+        }
+    }
+}
