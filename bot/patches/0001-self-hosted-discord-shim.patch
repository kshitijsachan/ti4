diff --git a/src/main/java/ti4/helpers/CcGainCap.java b/src/main/java/ti4/helpers/CcGainCap.java
new file mode 100644
index 0000000..176b82f
--- /dev/null
+++ b/src/main/java/ti4/helpers/CcGainCap.java
@@ -0,0 +1,155 @@
+package ti4.helpers;
+
+import javax.annotation.Nullable;
+import lombok.experimental.UtilityClass;
+import ti4.game.Game;
+import ti4.game.Player;
+
+/**
+ * How many command tokens the effect that opened the shared "gain command tokens" panel grants (rules audit,
+ * leaders A–M: deliberate improvement over the original bot, whose panel let a player gain any number).
+ *
+ * <p>The panel's increase_*_cc buttons stay until Done, so the effect records its grant here right after opening the
+ * panel (ButtonHelper.getGainCCButtons(player, grant, source); Acamar 1, Leadership 3 + 1 per 3 influence, …). The
+ * cap belongs to that panel only: an uncapped getGainCCButtons clears it, any panel recording other starting pools
+ * (Game.setStoredValue on "originalCCsFor&lt;faction&gt;") clears it, and Done clears it. Status homework uses the round's own gain (StatusPhase). A panel without a
+ * recorded cap stays uncapped, as before. Enforced in CommandCounterButtonHandler (increase_*_cc) and the engine's
+ * command_tokens.adjust validate; the engine reports it as progress required.gainCap.
+ */
+@UtilityClass
+public class CcGainCap {
+
+    public static final String KEY = "ccGainCap_";
+    public static final String INF_KEY = "ccGainCapInf_";
+    /** Label marker of Predictive Intelligence's redistribute button (redistribute only: net 0). */
+    public static final String PI_LABEL = "Predictive Intelligence";
+
+    /**
+     * @param base tokens granted outright
+     * @param perThreeInfluence also 1 token per 3 influence spent (Leadership)
+     * @param source what grants it (empyreanagent, leadership_primary, leadership_secondary, …)
+     */
+    public record Cap(String source, int base, boolean perThreeInfluence) {
+        public String label() {
+            return switch (source) {
+                case "empyreanagent" -> "Acamar (Empyrean agent)";
+                case "leadership_primary" -> "Leadership primary";
+                case "leadership_secondary" -> "Leadership secondary";
+                case "status" -> "Status phase";
+                case "summit" -> "Summit";
+                case "propagation" -> "Propagation";
+                case "keleres_xxcha_hero" -> "Odlynn Myrr (Keleres hero)";
+                case "leadership_rider" -> "Leadership Rider";
+                case "blackops" -> "Black Ops";
+                case "volatile_fuel_source" -> "Volatile Fuel Source";
+                case "explore" -> "Exploration card";
+                case "custodia_vigilia" -> "Custodia Vigilia";
+                case "gain_cc" -> "This effect";
+                case "redistribute" -> "Redistribution (no gain)";
+                case "warfare" -> "Warfare primary";
+                case "starlancer" -> "Starlancer (Mahact mech)";
+                case "call_of_the_void" -> "Call of the Void";
+                case "ordinian" -> "Ordinian";
+                default -> source;
+            };
+        }
+    }
+
+    /** Call right after the panel recorded originalCCsFor (any later panel clears it). */
+    public static void set(Game game, Player player, String source, int base, boolean perThreeInfluence) {
+        String orig = game.getStoredValue("originalCCsFor" + player.getFaction());
+        game.setStoredValue(
+                KEY + player.getFaction(),
+                source + ";" + base + ";" + (perThreeInfluence ? 1 : 0) + ";" + (orig == null ? "" : orig));
+    }
+
+    /** Game.setStoredValue hook: a panel recording other starting pools drops the previous panel's grant. */
+    public static boolean keepsCap(@Nullable String storedCap, @Nullable String newOriginal) {
+        if (storedCap == null || storedCap.isEmpty()) return false;
+        String[] p = storedCap.split(";", -1);
+        return p.length > 3 && p[3].equals(newOriginal);
+    }
+
+    public static void clear(Game game, Player player) {
+        game.removeStoredValue(KEY + player.getFaction());
+        game.removeStoredValue(INF_KEY + player.getFaction());
+    }
+
+    /** Called by Game.setStoredValue when a panel records new starting pools. */
+    public static boolean isPanelStartKey(String key) {
+        return key != null && key.startsWith("originalCCsFor");
+    }
+
+    @Nullable
+    public static Cap get(Game game, Player player) {
+        String v = game.getStoredValue(KEY + player.getFaction());
+        if (v == null || v.isEmpty()) return null;
+        String[] p = v.split(";");
+        try {
+            return new Cap(p[0], Integer.parseInt(p[1]), p.length > 2 && "1".equals(p[2]));
+        } catch (RuntimeException e) {
+            return null;
+        }
+    }
+
+    /** Leadership: the influence of a finished payment window counts towards the panel's tokens. */
+    public static void bankInfluence(Game game, Player player) {
+        Cap cap = get(game, player);
+        if (cap == null || !cap.perThreeInfluence()) return;
+        int inf = currentInfluence(game, player);
+        if (inf <= 0) return;
+        game.setStoredValue(INF_KEY + player.getFaction(), String.valueOf(bankedInfluence(game, player) + inf));
+    }
+
+    static int bankedInfluence(Game game, Player player) {
+        try {
+            String v = game.getStoredValue(INF_KEY + player.getFaction());
+            return v == null || v.isEmpty() ? 0 : Integer.parseInt(v);
+        } catch (NumberFormatException e) {
+            return 0;
+        }
+    }
+
+    /**
+     * Influence spent in the open payment window: the planets exhausted and trade goods spent on it, counted as the
+     * payment summary counts them (Helper.spentTotals), not read back from the summary's text. The same for the
+     * legacy presses and the engine's payment.spend (which presses the same buttons, then Done).
+     */
+    static int currentInfluence(Game game, Player player) {
+        if (player.getSpentThingsThisWindow().isEmpty()) return 0;
+        try {
+            return Math.max(0, Helper.spentTotals(player, game, "inf").influence());
+        } catch (RuntimeException e) {
+            return 0;
+        }
+    }
+
+    /** Tokens the panel's effect grants in all, or null when uncapped. */
+    @Nullable
+    public static Integer limit(Game game, Player player) {
+        Cap cap = get(game, player);
+        if (cap == null) return null;
+        int n = cap.base();
+        if (cap.perThreeInfluence()) n += (bankedInfluence(game, player) + currentInfluence(game, player)) / 3;
+        return n;
+    }
+
+    /** Net tokens gained on the panel so far (current pools minus the pools it opened with). */
+    public static int gained(Game game, Player player) {
+        String orig = game.getStoredValue("originalCCsFor" + player.getFaction());
+        if (orig == null || !orig.matches("\\d+/\\d+/\\d+.*")) return 0;
+        return ButtonHelper.checkNetGain(player, orig);
+    }
+
+    /** A refusal text when one more token would exceed the panel's grant, else null. */
+    @Nullable
+    public static String refuseOneMore(Game game, Player player) {
+        Integer limit = limit(game, player);
+        if (limit == null) return null;
+        int gained = gained(game, player);
+        if (gained + 1 <= limit) return null;
+        Cap cap = get(game, player);
+        return (cap == null ? "This effect" : cap.label()) + " grants " + limit + " command token"
+                + (limit == 1 ? "" : "s") + " and you have gained " + gained + ".";
+    }
+}
diff --git a/src/main/java/ti4/helpers/DoneRole.java b/src/main/java/ti4/helpers/DoneRole.java
new file mode 100644
index 0000000..ee14482
--- /dev/null
+++ b/src/main/java/ti4/helpers/DoneRole.java
@@ -0,0 +1,92 @@
+package ti4.helpers;
+
+import javax.annotation.Nullable;
+
+/**
+ * What a "deleteButtons" closer button finishes (paying, producing, adjusting command tokens), carried in the button id
+ * instead of being read back from the button's label. The role is a trailing {@code ~<token>} on the id, so the
+ * id still starts with {@code deleteButtons} / {@code deleteButtons_<context>} and existing prefix matches still hold:
+ * {@code deleteButtons_tacticalAction_37~prod}, {@code FFCC_xxcha_deleteButtons~ccgain}, {@code deleteButtons~pay}.
+ * An untagged deleteButtons id (a plain Done/Decline/Cancel) only dismisses the prompt.
+ */
+public enum DoneRole {
+    /** "Done Producing Units": bills the production (deleteButtons_&lt;context&gt;_&lt;pos&gt;). */
+    PRODUCE("prod"),
+    /** "Done Exhausting Planets": closes a payment (deleteButtons[_&lt;context&gt;]). */
+    PAY("pay"),
+    /** "Done Gaining Command Tokens". */
+    CC_GAIN("ccgain"),
+    /** "Done Redistributing Command Tokens". */
+    CC_REDISTRIBUTE("ccredist"),
+    /** "Done Losing Command Tokens". */
+    CC_LOSE("cclose"),
+    /** "Done Losing Fleet Tokens". */
+    FLEET_LOSE("fleetlose");
+
+    public static final char SEPARATOR = '~';
+
+    private final String token;
+
+    DoneRole(String token) {
+        this.token = token;
+    }
+
+    public String token() {
+        return token;
+    }
+
+    /** The id with this role appended. */
+    public String tag(String id) {
+        return id + SEPARATOR + token;
+    }
+
+    public boolean isCommandTokens() {
+        return this == CC_GAIN || this == CC_REDISTRIBUTE || this == CC_LOSE || this == FLEET_LOSE;
+    }
+
+    public static String produce(String id) {
+        return PRODUCE.tag(id);
+    }
+
+    public static String pay(String id) {
+        return PAY.tag(id);
+    }
+
+    public static String ccGain(String id) {
+        return CC_GAIN.tag(id);
+    }
+
+    /** The role a button id carries, or null for an untagged id (a plain Done/Decline, or a pre-tagging prompt). */
+    @Nullable
+    public static DoneRole of(@Nullable String id) {
+        if (id == null) return null;
+        int at = id.lastIndexOf(SEPARATOR);
+        if (at < 0) return null;
+        String token = id.substring(at + 1);
+        for (DoneRole role : values()) {
+            if (role.token.equals(token)) return role;
+        }
+        return null;
+    }
+
+    /** The id without its role tag (unchanged when it has none). */
+    /** The role an untagged closer had by its label (the rule before roles were carried in the id). */
+    @Nullable
+    public static DoneRole fromLegacyLabel(@Nullable String label) {
+        if (label == null) return null;
+        return switch (label.trim()) {
+            case "Done Producing Units" -> PRODUCE;
+            case "Done Exhausting Planets" -> PAY;
+            case "Done Gaining Command Tokens" -> CC_GAIN;
+            case "Done Redistributing Command Tokens" -> CC_REDISTRIBUTE;
+            case "Done Losing Command Tokens" -> CC_LOSE;
+            case "Done Losing Fleet Tokens" -> FLEET_LOSE;
+            default -> null;
+        };
+    }
+
+    public static String strip(@Nullable String id) {
+        if (id == null) return null;
+        return of(id) == null ? id : id.substring(0, id.lastIndexOf(SEPARATOR));
+    }
+}
