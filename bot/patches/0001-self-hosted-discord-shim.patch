--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/ActionCardDiscardKind.java
@@ -0,0 +1,100 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.helpers.ButtonHelper;
+import ti4.selfhost.engine.EngineModels.Decision;
+import ti4.selfhost.engine.EngineModels.Option;
+import ti4.selfhost.engine.EngineModels.Progress;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * Discard an action card: ac_discard_from_hand_&lt;handle&gt;[stall|redraw|retain|arvaxicommander]
+ * (ActionCardHelper.getDiscardActionCardButtonsWithSuffix, posted in the cards-info thread).
+ *
+ * <p>Value: {handle, actionCard, mode, overLimit, handLimit, reason}. mode is the suffix ("" plain, "stall" = discard
+ * as your action, "redraw" = draw a replacement, "retain" = keep the other buttons). overLimit / handLimit are as
+ * of capture; compare handLimit with the live PlayerState.actionCardCount to know whether a discard is still owed.
+ * reason: "scheming" for the Yssaril Scheming discard (a required discard that is not about the hand limit), else
+ * "hand" (hand limit or any other discard request).
+ *
+ * <p>progress (dynamic, from the live hand): {flow: "discard_action_cards", step: "choose", accumulated: {handSize},
+ * required: {handLimit, overLimit}, canCommit: overLimit == 0}; overLimit &gt; 0 = that many discards still owed.
+ */
+public class ActionCardDiscardKind implements KindSpec {
+    static final String PREFIX = "ac_discard_from_hand_";
+    private static final Pattern ID = Pattern.compile("ac_discard_from_hand_(\\d+)(stall|redraw|retain|arvaxicommander)?");
+
+    @Override
+    public String kind() {
+        return "action_card.discard";
+    }
+
+    @Override
+    public int priority() {
+        return 80;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return handlerId.startsWith(PREFIX);
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        Matcher m = ID.matcher(handlerId);
+        if (!m.matches()) return null;
+        int handle = Integer.parseInt(m.group(1));
+        Player p = ctx.player() != null ? ctx.player() : CardKinds.holderOfHandle(ctx.game(), handle);
+        String ac = CardKinds.acIdForHandle(p, handle);
+        if (ac == null) return null;
+        Map<String, Object> v = new LinkedHashMap<>();
+        v.put("handle", handle);
+        v.put("actionCard", ac);
+        v.put("mode", m.group(2) == null ? "" : m.group(2));
+        limits(ctx.game(), p, v);
+        // The one discard prompt the engine words differently (ActionCardHelper.sendSchemingDiscardButtons).
+        String content = ctx.content() == null ? "" : ctx.content();
+        v.put("reason", p.hasAbility("scheming") && content.contains("**Scheming**") ? "scheming" : "hand");
+        return v;
+    }
+
+    private static void limits(Game game, Player p, Map<String, Object> v) {
+        v.put("overLimit", ButtonHelper.isPlayerOverLimit(game, p));
+        v.put("handLimit", ButtonHelper.getACLimit(game, p));
+    }
+
+    @Override
+    public boolean dynamic() {
+        return true;
+    }
+
+    @Override
+    public Progress progress(CaptureContext ctx) {
+        Player p = ctx.player();
+        if (p == null) return null;
+        int limit = ButtonHelper.getACLimit(ctx.game(), p);
+        int size = p.getActionCards().size();
+        int over = p.hasAbility("crafty") ? 0 : Math.max(0, size - limit);
+        return new Progress(
+                "discard_action_cards",
+                "choose",
+                Map.of("handSize", size),
+                Map.of("handLimit", limit, "overLimit", over),
+                over == 0);
+    }
+
+    @Override
+    public String validate(Game game, Player answering, Decision decision, String optionId) {
+        for (Option o : decision.options()) {
+            if (!o.id().equals(optionId) || o.value() == null) continue;
+            if (o.value().get("handle") instanceof Integer h && !answering.getActionCards().containsValue(h))
+                return "That action card is no longer in your hand.";
+        }
+        return null;
+    }
+}
