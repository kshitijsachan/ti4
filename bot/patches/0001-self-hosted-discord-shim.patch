@@ -0,0 +1,394 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.ArrayList;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.Set;
+import javax.annotation.Nullable;
+import ti4.game.Game;
+import ti4.game.Player;
+import ti4.image.Mapper;
+import ti4.model.ActionCardModel;
+
+/**
+ * Which action card a resolution step belongs to (C7). Not a kind itself.
+ *
+ * <p>RESOLVE_AUTOMATION is harvested from ActionCardHelper.playAC (the "Resolve X" button each card's automationID
+ * posts; ids ending in '_' are prefixes). A step is mapped to cards through the automation ids, then to the card in
+ * this game: the most recently discarded card with that automation (the one being resolved), else the first card in
+ * the catalogue with it. Follow-up steps (plagueStep2_, scuttleOn_, ...) are mapped through their "family" (the
+ * step name without resolve/start/StepN), falling back to the most recently discarded action card.
+ */
+final class CardSteps {
+    private CardSteps() {}
+
+    static final Map<String, List<String>> RESOLVE_AUTOMATION = Map.ofEntries(
+            Map.entry("allianceRiderRandomAlly", List.of("alliance_rider")),
+            Map.entry("brutalOccupation", List.of("brutal_occupation")),
+            Map.entry("courageousStarter", List.of("courageous")),
+            Map.entry("drawParadigmAC", List.of("tf-elevate")),
+            Map.entry("economicInitiative", List.of("economic_initiative")),
+            Map.entry("fighterConscription", List.of("f_conscription", "tf-rise")),
+            Map.entry("focusedResearch", List.of("f_researched")),
+            Map.entry("forwardSupplyBase", List.of("fsb")),
+            Map.entry("getDivertFundingButtons", List.of("divert_funding")),
+            Map.entry("getPlagiarizeButtons", List.of("plagiarize")),
+            Map.entry("getRepealLawButtons", List.of("repeal")),
