--- /dev/null
+++ b/src/main/java/ti4/selfhost/engine/kinds/CombatHitsKind.java
@@ -0,0 +1,66 @@
+package ti4.selfhost.engine.kinds;
+
+import java.util.List;
+import java.util.Map;
+import ti4.game.Player;
+import ti4.game.Tile;
+import ti4.selfhost.engine.KindSpec;
+
+/**
+ * Hits a player must assign after a roll: the prompt with autoAssign{Space,Ground,AFB,SpaceCannonOffence}Hits_ (owner =
+ * the player hit), "Manually Assign Hits" (getDamageButtons_), "Cancel a Hit" (cancel*Hits_, an ability) and, on
+ * combat-round prompts, the next round's roll. The auto option's value carries the hits owed and the units they may
+ * land on (count, damaged, can sustain), so a client can plan an assignment and send it in one call
+ * (CombatPlanController) instead of pressing unit buttons one by one.
+ */
+public class CombatHitsKind implements KindSpec {
+
+    @Override
+    public String kind() {
+        return "combat.hits";
+    }
+
+    @Override
+    public int priority() {
+        return 100;
+    }
+
+    @Override
+    public boolean classifies(List<String> handlerIds) {
+        for (String h : handlerIds) if (h != null && h.startsWith("autoAssign") && h.contains("Hits_")) return true;
+        return false;
+    }
+
+    @Override
+    public boolean matches(String handlerId) {
+        return (handlerId.startsWith("autoAssign") && handlerId.contains("Hits_"))
+                || (handlerId.startsWith("cancel") && handlerId.contains("Hits_"))
+                || handlerId.startsWith("combatRoll_")
+                || handlerId.startsWith("getDamageButtons_");
+    }
+
+    @Override
+    public Map<String, Object> value(String handlerId, CaptureContext ctx) {
+        Map<String, Object> v = CombatSupport.value(handlerId, ctx.game());
+        if (v == null || !"auto".equals(v.get("action"))) return v;
+        Player p = ctx.player();
+        Object pos = v.get("tile");
+        Tile tile = pos == null ? null : ctx.game().getTileByPosition(String.valueOf(pos));
+        v.put(
+                "units",
+                CombatSupport.hittableUnits(
+                        ctx.game(), p, tile, (String) v.get("holder"), (String) v.get("source")));
+        // Non-Euclidean Shielding: each SUSTAIN DAMAGE cancels 2 hits.
+        int cancels = p != null && p.hasTech("nes") ? 2 : 1;
+        v.put("sustainCancels", cancels);
+        CombatSupport.noteOwed(
+                ctx.game(),
+                p,
+                (String) pos,
+                (String) v.get("holder"),
+                (String) v.get("source"),
+                (Integer) v.get("hits"),
+                cancels);
+        return v;
+    }
+}
diff --git a/src/main/java/ti4/selfhost/engine/kinds/CombatPlanController.java b/src/main/java/ti4/selfhost/engine/kinds/CombatPlanController.java
new file mode 100644
